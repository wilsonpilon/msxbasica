  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL AUDREG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Music)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL AUDREG( register, data )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This command writes data directly into the registers of the FM-chip. register is the")
  SoftwareHelp_L("register-number. Valid values are 0 to 7, 14 to 24, 32 to 40 and 48 to 56. data is the")
  SoftwareHelp_L("data of 8 bit size and has a valid range from 0 to 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL AUDREG(3, 15)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SOUND (MSX-Basic),")
  SoftwareHelp_L("CALL MUSIC")
  SoftwareHelp_Commit("CALL AUDREG", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL BPRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Chakkari Copy)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL BPRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints a hardcopy of the screen contents in all MSX1 screen modes (0-3).")
  SoftwareHelp_L("")
  SoftwareHelp_L("It's the same operation as pressing the COPY button on the Chakkari Copy cartridge.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: if the screen mode cannot be auto-detected Chakkari Copy must be started")
  SoftwareHelp_L("with pressed COPY button. In this case all screen-parameters for later capture can be entered")
  SoftwareHelp_L("manually.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL BPRINT")
  SoftwareHelp_Commit("CALL BPRINT", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL BC")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Firmware)")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function is available in the Sanyo MSX 2+ only!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL BC")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This command turn on the BASIC COMPILER options.")
  SoftwareHelp_L("X-BASIC must first initialized with CALL BC before using CALL RUN.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("Turbo-Basic compiler")
  SoftwareHelp_Commit("CALL BC", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL BGM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Music)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL BGM( number )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Specifies, if music should be played in foreground- or background-mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The Extended MSX-Basic makes it possible to play music, while other Basic-commands are about to be processed. If n is 0, then it's not possible to execute other Basic-commands while music is played. But using 1 (default) this is enabled.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplos:**")
  SoftwareHelp_L("10 CALL MUSIC(0, 0, 1)")
  SoftwareHelp_L("20 CALL BGM(1)")
  SoftwareHelp_L("30 PLAY #2," + Chr(34) + "CDEFGAB" + Chr(34))
  SoftwareHelp_L("40 PRINT " + Chr(34) + "BASIC is ready" + Chr(34))
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 CALL MUSIC(0, 0, 1)")
  SoftwareHelp_L("20 CALL BGM(0)")
  SoftwareHelp_L("30 PLAY #2," + Chr(34) + "CDEFGAB" + Chr(34))
  SoftwareHelp_L("40 PRINT " + Chr(34) + "BASIC is ready now" + Chr(34))
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL MUSIC, PLAY (MSX-Music)")
  SoftwareHelp_Commit("CALL BGM", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL CALENDAR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL CALENDAR", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL CHCOPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL CHCOPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints a hardcopy")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL CHCOPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL OPTIONS, CALL HCOPY")
  SoftwareHelp_Commit("CALL CHCOPY", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL CLS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Kanji-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Delete all the contents in the screen during Japanese input mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL CLS")
  SoftwareHelp_L("")
  SoftwareHelp_L("_CLS")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("You must use this command to clear away the screen once you enter Japanese input mode by using CALL KANJI command.")
  SoftwareHelp_L("")
  SoftwareHelp_L("CLS statement may not wok properly in Japanese input mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("CALL CLS", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COM([<n>:],GOSUB <line number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Set up a line number for BASIC to trap when a character is received on the communication channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("When a trap occurs an automatic CALL COMSTOP is executed so further reception traps can not take place. The RETURN from the trap routine will automatically do a CALL COMON, unless an explicit CALL COMOFF has been performed inside the trap routine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Even trapping only takes place when BASIC is executing a program. When an error trap (resulting from an ON ERROR statement) occurs, this automatically disables all trapping (including ERROR, STRIG, STOP, SPRITE, INTERVAL and KEY).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RETURN, CALL COMON, CALL COMOFF, CALL COMSTOP")
  SoftwareHelp_Commit("CALL COM", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMBREAK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMBREAK([" + Chr(34) + "<n>:" + Chr(34) + "],<expression>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Send break characters specified by <expression> to the channel specified by <n>. The range of the <expression> should be between 0 and 32767. If 0 is specified, a long break is sent (forever).")
  SoftwareHelp_L("")
  SoftwareHelp_L("An OPEN must be executed before this statement. The default channel number is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("CALL COMBREAK", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMDTR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMDTR([" + Chr(34) + "<n>:" + Chr(34) + "],<expression>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Turn off DTR signal when the <expression> is zero, otherwise turn on the DTR signal.")
  SoftwareHelp_L("")
  SoftwareHelp_L("An OPEN must be executed before this statement. The default channel number is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: DTR signal is affected by CALL COMDTR and CALL COMINI statements.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN, CALL COMINI")
  SoftwareHelp_Commit("CALL COMDTR", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMHELP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMHELP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints out a brief description of the parameters set by the COMINI statement on the screen.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL COMHELP")
  SoftwareHelp_L("Initialize statement options:")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL COMINI (" + Chr(34))
  SoftwareHelp_L("<device# {0,1,2...9}>:")
  SoftwareHelp_L("<character length {5,6,7,8}>")
  SoftwareHelp_L("<parity {E,O,I,N}>")
  SoftwareHelp_L("<stop bits {1,2,3}>")
  SoftwareHelp_L("<XON/XOFF {X,N}>")
  SoftwareHelp_L("<CTS hand-shake {H,N}>")
  SoftwareHelp_L("<auto LF on receive {A,N}>")
  SoftwareHelp_L("<auto LF on transmit {A,N}>")
  SoftwareHelp_L("<SI/SO {S,N}>" + Chr(34))
  SoftwareHelp_L(",<receiver baud rate>")
  SoftwareHelp_L(",<transmitter baud rate>")
  SoftwareHelp_L(",<time out count>")
  SoftwareHelp_L("                          )")
  SoftwareHelp_L("Default:")
  SoftwareHelp_L(" CALL COMINI(" + Chr(34) + "0:8N1XHNNN" + Chr(34) + ",1200,1200,0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL COMINI")
  SoftwareHelp_Commit("CALL COMHELP", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMINI")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMINI [([<string exp.>][,[<Rx baud rate>][,[<Tx baud rate>][,[<timeout>]]]])]")
  SoftwareHelp_L("")
  SoftwareHelp_L("<string exp.>")
  SoftwareHelp_L("")
  SoftwareHelp_L("A string specifies the channel control parameters as described below:")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "[0:][8[N[1[X[H[N[N[N]]]]]]]]" + Chr(34))
  SoftwareHelp_L("  |   | | | | | | | |")
  SoftwareHelp_L("  +----------------------- Channel no.")
  SoftwareHelp_L("      | | | | | | | |        When there is more than one")
  SoftwareHelp_L("      | | | | | | | |        channel, this parameter specifies")
  SoftwareHelp_L("      | | | | | | | |        the channel number. May be omitted")
  SoftwareHelp_L("      | | | | | | | |        if the system has only one channel.")
  SoftwareHelp_L("      | | | | | | | |        The default value is " + Chr(34) + "0" + Chr(34) + ".")
  SoftwareHelp_L("      +------------------- Character length")
  SoftwareHelp_L("        | | | | | | |        " + Chr(34) + "5" + Chr(34) + " - 5 bits")
  SoftwareHelp_L("        | | | | | | |        " + Chr(34) + "6" + Chr(34) + " - 6 bits")
  SoftwareHelp_L("        | | | | | | |        " + Chr(34) + "7" + Chr(34) + " - 7 bits")
  SoftwareHelp_L("        | | | | | | |        " + Chr(34) + "8" + Chr(34) + " - 8 bits")
  SoftwareHelp_L("        +----------------- Parity flag")
  SoftwareHelp_L("          | | | | | |        " + Chr(34) + "E" + Chr(34) + " - Even parity")
  SoftwareHelp_L("          | | | | | |        " + Chr(34) + "O" + Chr(34) + " - Odd parity")
  SoftwareHelp_L("          | | | | | |        " + Chr(34) + "I" + Chr(34) + " - Ignore")
  SoftwareHelp_L("          | | | | | |        " + Chr(34) + "N" + Chr(34) + " - No parity")
  SoftwareHelp_L("          +--------------- Stop bits length")
  SoftwareHelp_L("            | | | | |        " + Chr(34) + "1" + Chr(34) + " - 1 bit")
  SoftwareHelp_L("            | | | | |        " + Chr(34) + "2" + Chr(34) + " - 1.5 bits")
  SoftwareHelp_L("            | | | | |        " + Chr(34) + "3" + Chr(34) + " - 2 bits")
  SoftwareHelp_L("            +------------- XON/XOFF control")
  SoftwareHelp_L("              | | | |        " + Chr(34) + "X" + Chr(34) + " - do control")
  SoftwareHelp_L("              | | | |        " + Chr(34) + "N" + Chr(34) + " - do not control")
  SoftwareHelp_L("              +----------- XTS/RTS handshake")
  SoftwareHelp_L("                | | |        " + Chr(34) + "H" + Chr(34) + " - do handshake")
  SoftwareHelp_L("                | | |        " + Chr(34) + "N" + Chr(34) + " - do not handshake")
  SoftwareHelp_L("                +--------- Automatic Line Feed (Rx)")
  SoftwareHelp_L("                  | |        Insert LF after CR received")
  SoftwareHelp_L("                  | |        " + Chr(34) + "A" + Chr(34) + " - insert Line Feed in buffer")
  SoftwareHelp_L("                  | |        " + Chr(34) + "N" + Chr(34) + " - do not insert Line Feed")
  SoftwareHelp_L("                  +------- Automatic Line Feed (Tx)")
  SoftwareHelp_L("                    |        Insert LF after CR transmitted")
  SoftwareHelp_L("                    |        " + Chr(34) + "A" + Chr(34) + " - insert Line Feed")
  SoftwareHelp_L("                    |        " + Chr(34) + "N" + Chr(34) + " - do not insert Line Feed")
  SoftwareHelp_L("                    +----- Shift-in/Shift-out control")
  SoftwareHelp_L("                             Illegal when data length is other")
  SoftwareHelp_L("                             than 7 bits.")
  SoftwareHelp_L("                             " + Chr(34) + "S" + Chr(34) + " - do control")
  SoftwareHelp_L("                             " + Chr(34) + "N" + Chr(34) + " - do not control")
  SoftwareHelp_L("")
  SoftwareHelp_L("<baud rate>")
  SoftwareHelp_L("")
  SoftwareHelp_L("It is possible to set different baud rates for transmitter and receiver. The eighteen values for the baud rate are as follows:")
  SoftwareHelp_L("")
  SoftwareHelp_L("50 75 110 134 150 300 600 1050 1200 1800 2000 2400 3600 4800 7200 9600 19200 38400")
  SoftwareHelp_L("")
  SoftwareHelp_L("Baud rate 134 is actually 134.5. When only the receiver baud rate is specified, the baud rate for the transmitter takes the same speed as the receiver. When only the transmitter baud rate is specified, the baud rate for the receiver takes the default value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("<time out>")
  SoftwareHelp_L("")
  SoftwareHelp_L("If CTS-RTS handshake is selected, the device driver will wait for CTS (Clear To Send) and DCD signals before sending the character. If XON/XOFF protocol is selected and an XOFF has been received, the device driver will wait for XON before sending the character (unless the character is XON/XOFF - hex 11 or hex 13). The waiting time is specified in increments of 10ms. If the time elapses, an error is returned. If the time is specified as 0, the driver waits until the correct signals are received, or <CTRL+STOP> keys are pressed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Setup communication parameters.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL COMINI(" + Chr(34) + "0:7E1XHNNN" + Chr(34) + ", 600,1200,30)")
  SoftwareHelp_L("CALL COMINI(" + Chr(34) + "8N1" + Chr(34) + ",9600)")
  SoftwareHelp_L("")
  SoftwareHelp_L("The fixed default values for initialisation are as follows:")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL COMINI(" + Chr(34) + "0:8E3XHNNN" + Chr(34) + ",1200,1200,0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN, CLOSE, INPUT, LINE INPUT, SAVE, LOAD, MERGE, RUN, EOF, LOC, LOF, VARPTR")
  SoftwareHelp_Commit("CALL COMINI", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMOFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMOFF(" + Chr(34) + "[<n>:]" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Disable event trapping caused by an incoming character on the communication channel. The communication buffer is flushed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL COM, CALL COMON, CALL COMSTOP")
  SoftwareHelp_Commit("CALL COMOFF", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMON")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMON(" + Chr(34) + "[<n>:]" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Enable event trapping caused by an incoming character on the communication channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL COM, CALL COMOFF, CALL COMSTOP")
  SoftwareHelp_Commit("CALL COMON", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMPRESS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL COMPRESS", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMSTAT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMSTAT([" + Chr(34) + "<n>:" + Chr(34) + "],<name of variable>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Read the status of the communication channel. The status returned is assigned to the varaible. Bits 0 to 7 represent the current channel status and bits 8 to 15 represent the status of the last character read from the buffer. The assignment of each of the bits is as follows:")
  SoftwareHelp_L("Bit no. | Description")
  SoftwareHelp_L("15 | Receive buffer overflow error 0 - no buffer overflow 1 - buffer overflow ... lost character")
  SoftwareHelp_L("14 | Time out error 0 - no time out error 1 - time out error ... no character")
  SoftwareHelp_L("13 | Framing error 0 - no framing error 1 - framing error ... bad character")
  SoftwareHelp_L("12 | Overrun error 0 - no overrun error 1 - overrung error ... lost character")
  SoftwareHelp_L("11 | Parity error 0 - no parity error 1 - parity error ... bad character")
  SoftwareHelp_L("10 | <CTRL+STOP> keys 0 - keys were not pressed 1 - keys were pressed ... no character")
  SoftwareHelp_L("9 | Not used, reserved")
  SoftwareHelp_L("8 | Not used, reserved")
  SoftwareHelp_L("7 | Clear To Send 0 - can send 1 - cannot send")
  SoftwareHelp_L("6 | Rx XON/XOFF control 0 - XON 1 - XOFF")
  SoftwareHelp_L("5 | Tx XON/XOFF control 0 - XON 1 - XOFF")
  SoftwareHelp_L("4 | Not used, reverved")
  SoftwareHelp_L("3 | Data Set Ready 0 - ready 1 - not ready")
  SoftwareHelp_L("2 | Break detect 0 - not detected 1 - detected")
  SoftwareHelp_L("1 | Ring indicator 0 - ringing 1 - not ringing")
  SoftwareHelp_L("0 | Carrier detect 0 - detected 1 - not detected")
  SoftwareHelp_L("An OPEN must be executed before this statement. The default channel number is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("CALL COMSTAT", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMSTOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMSTOP(" + Chr(34) + "[<n>:]" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Suspend event trapping caused by an incoming character on the communication channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL COM, CALL COMON, CALL COMOFF")
  SoftwareHelp_Commit("CALL COMSTOP", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL COMTERM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL COMTERM[(" + Chr(34) + "<n>:" + Chr(34) + ")]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Enter terminal emulator mode. The channel should be closed when this statement is invoked.")
  SoftwareHelp_L("The following function keys have a special function in the terminal mode:")
  SoftwareHelp_L("")
  SoftwareHelp_L("F-6: Turn on/off literal mode. In the literal mode, control characters are displayed")
  SoftwareHelp_L("with upper arrow and the character offset by #40H. For example character whose code is 01H is")
  SoftwareHelp_L("displayed as " + Chr(34) + "A" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("Initial mode: Literal mode off.")
  SoftwareHelp_L("")
  SoftwareHelp_L("F-7: Toggle Half/Full duplex mode. In the Half duplex mode, characters keyed in are")
  SoftwareHelp_L("echoed to the screen as well as sent to the communication channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Initial mode: Full duplex.")
  SoftwareHelp_L("")
  SoftwareHelp_L("F-8: Turn on/off printer echo. When the printer echo is on, all the characters sent")
  SoftwareHelp_L("")
  SoftwareHelp_L("to the screen are also sent to the printer.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Initial mode: Printer echo off.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The terminal emulator supports the MSX VT52 protocol subset.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Intel hexfiles can be downloaded with the terminal emulator. This mode is entered by two")
  SoftwareHelp_L("successive <ESCAPE> characters. The file format and handshaking follow the rules for")
  SoftwareHelp_L("these files. The machine code will be placed in memory at the addresses specified in the")
  SoftwareHelp_L("hexfile. In general, only download hexfiles that will be placed at addresses between hex 8000")
  SoftwareHelp_L("and BASIC's top of memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To exit terminal emulator mode, press <CTRL+STOP> keys.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL COMTERM")
  SoftwareHelp_Commit("CALL COMTERM", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL DCOLOR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL DCOLOR", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL ENGL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL ENGL", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL ESTR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL ESTR", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL FMPAC")
  SoftwareHelp_L("")
  SoftwareHelp_L("FM-PAC is produced by Yamaha.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Overview")
  SoftwareHelp_L("")
  SoftwareHelp_L("Internal file management software of FMPAC is called Pac Commander. To boot the software, insert FMPAC into MSX, turn on the power, then type in CALL FMPAC from BASIC.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Messages in Pac Commander assumes that MSX is a wizard who is managing FM-PAC. Sections names in the initial menu screen are called " + Chr(34) + "spells" + Chr(34) + ". Takamichi's comments are enclosed by [].")
  SoftwareHelp_L("")
  SoftwareHelp_L("Decision; SPACE = yes, ESC = no.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Also, a dialogue window on upper-right shows " + Chr(34) + "Yes" + Chr(34) + " and " + Chr(34) + "no" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("Use cursor key to select, and then SPACE.")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "PAC" + Chr(34) + " might be either a FMPAC, or PAC without FM module. Slot spell is invalid if anything other than one single FMPAC is inserted to MSX, though.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Slot no. that Pac Commander indicates may be different with actual slot no. of your MSX. This is why Slot spell is necessary. Pac Commander always uses slot no. shown with slot spell.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Change spell swaps entire contents of two PACs.")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell menu")
  SoftwareHelp_L("  Clear")
  SoftwareHelp_L("  Copy")
  SoftwareHelp_L("  Change")
  SoftwareHelp_L("  Delete File")
  SoftwareHelp_L("  Slot")
  SoftwareHelp_L("  Background Music")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 1: Clear")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "Password and data at Slot n disappear. OK?" + Chr(34))
  SoftwareHelp_L("  [n stands for slot no. which FM-PAC is inserted in]")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("  MSX used Clear magic.")
  SoftwareHelp_L("  Poooof.....")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 2: Copy")
  SoftwareHelp_L("  PAC -> PAC")
  SoftwareHelp_L("  PAC -> Disk")
  SoftwareHelp_L("  Disk -> PAC")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --PAC -> PAC")
  SoftwareHelp_L("")
  SoftwareHelp_L("  What is PAC you copy from?")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Choose a PAC you want to copy from.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [If 3 or more PAC are present]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  What is PAC you copy to?")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [choose a PAC you want to copy to.]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "Password and data at destination (n) disappear. OK?" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("  [n stands for slot no. where destination PAC is inserted in]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX used Copy magic.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  Pipipipi, copy")
  SoftwareHelp_L("")
  SoftwareHelp_L("  ")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --PAC -> Disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [Prompt for file name appears]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  Destination file:")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Input file name; use BS key to delete a character")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX used Copy magic.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  Pipipipi, copy")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --If there are already existing data, their list appears.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Overwrite; move cursor to the file you want to overwrite and press SPACE.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "Overwrite xxxxxxxx. OK?" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("  [xxxxxxxx = file name.]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  ")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Disk -> PAC")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [PAC can use only drive a:]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [A list of data files appear]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  [Move cursor to file name you want to copy from]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  Original file:")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "Password and data at destination (n) disappear. OK?" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("  [n stands for slot no. where destination PAC is inserted in]")
  SoftwareHelp_L("")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("")
  SoftwareHelp_L("  MSX used Copy magic.")
  SoftwareHelp_L("")
  SoftwareHelp_L("  Pipipipi, copy")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 3: Change")
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("  [Valid only if there are two PACs]")
  SoftwareHelp_L("  MSX used Change magic.")
  SoftwareHelp_L("  Chachacha, change!!")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 4: Delete file")
  SoftwareHelp_L("  [List of files appears]")
  SoftwareHelp_L("  [Move cursor to the  file you want to delete]")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "Delete xxxxxxxx. OK?" + Chr(34))
  SoftwareHelp_L("  --Press SPACE")
  SoftwareHelp_L("  MSX used Delete File magic.")
  SoftwareHelp_L("  Dee, lee, tee!!")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 5: Slot")
  SoftwareHelp_L("  [Invalid if there are more than one FMPAC]")
  SoftwareHelp_L("  MSX used Slot magic.")
  SoftwareHelp_L("  MSX said, " + Chr(34) + "PAC is in slot (n). Did you write it down?" + Chr(34))
  SoftwareHelp_L("  [n stands for slot no. where your FMPAC is inserted in]")
  SoftwareHelp_L("")
  SoftwareHelp_L("---Spell 6: Background Music")
  SoftwareHelp_L("  Sample 1")
  SoftwareHelp_L("  Sample 2")
  SoftwareHelp_L("  Sample 3")
  SoftwareHelp_L("  Sample 4")
  SoftwareHelp_L("  Sample 5")
  SoftwareHelp_L("  Stop")
  SoftwareHelp_L("  [Choose a music and press SPACE to change music.]")
  SoftwareHelp_L("")
  SoftwareHelp_L("Error messages")
  SoftwareHelp_L("")
  SoftwareHelp_L("Error messages are always shown in yellow box.")
  SoftwareHelp_L("")
  SoftwareHelp_L("(1) | Hmm, write protected!!")
  SoftwareHelp_L("  Try again?")
  SoftwareHelp_L("  [Reason: Disk is write protected.]")
  SoftwareHelp_L("(2) | Disk is not set!!")
  SoftwareHelp_L("  Try again?")
  SoftwareHelp_L("  [Reason: Disk is not set.]")
  SoftwareHelp_L("  [Reason: Disk is in a drive other than a:]")
  SoftwareHelp_L("  [Reason: Disk is not formatted.]")
  SoftwareHelp_L("(3) | MSX said, " + Chr(34) + "file not found." + Chr(34))
  SoftwareHelp_L("  [Reason: You chose wrong file name.]")
  SoftwareHelp_L("  MSX cannot use this disk!!")
  SoftwareHelp_L("  Try again?")
  SoftwareHelp_L("  [Reason: Disk is not of a format usable with MSX.]")
  SoftwareHelp_L("  [Reason: Disk is broken.]")
  SoftwareHelp_L("(4) | This disk seems broken!!")
  SoftwareHelp_L("  Try again?")
  SoftwareHelp_L("  [same as (3)]")
  SoftwareHelp_L("(5) | MSX said, " + Chr(34) + "this spell requires a disk drive")
  SoftwareHelp_L("  or one more PAC." + Chr(34))
  SoftwareHelp_L("  [Reason: No disk drive nor second PAC is connected.]")
  SoftwareHelp_L("(6) | MSX said, " + Chr(34) + "this spell requires a disk drive." + Chr(34))
  SoftwareHelp_L("  [Reason: Disk drive is not connected.]")
  SoftwareHelp_L("(7) | MSX said, " + Chr(34) + "this spell requires one more PAC." + Chr(34))
  SoftwareHelp_L("  [Reason: Second PAC is not connected.]")
  SoftwareHelp_L("(8) | 2 or more PACs!")
  SoftwareHelp_L("  Shutdown the power, and boot again with one PAC.")
  SoftwareHelp_L("  [Reason: Two or more PACs/FMPACs are inserted.]")
  SoftwareHelp_L("(9) | MSX said, " + Chr(34) + "insufficient empty disk space." + Chr(34))
  SoftwareHelp_L("  [Reason: Disk is full.]")
  SoftwareHelp_L("(10) | MSX said, " + Chr(34) + "format of the file is wrong." + Chr(34))
  SoftwareHelp_L("  [Reason: you specified a file that is not a PAC data.]")
  SoftwareHelp_L("(11) | Not enough memory.")
  SoftwareHelp_L("  [Reason: MSX does not have 32 KB or more RAM.]")
  SoftwareHelp_L("  [Reason: Insufficient memory due to connected external devices.]")
  SoftwareHelp_L("")
  SoftwareHelp_L("Translations of Messages shown by FMPAC")
  SoftwareHelp_L("")
  SoftwareHelp_L("July 26, 1998 by Takamichi")
  SoftwareHelp_Commit("CALL FMPAC", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL FMPAK")
  SoftwareHelp_L("")
  SoftwareHelp_L("The FM STEREO PAK firmware can be invoked with CALL FMPAK.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Even if the FM-Basic can be used with any MSX Computer the CALL FMPAK")
  SoftwareHelp_L("statement requires at least an MSX 2 system.")
  SoftwareHelp_L("Due to some restrictions Disk Basic must be enabled, otherwise the CALL FMPAK statement would")
  SoftwareHelp_L("cause unpredictable results.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The firmware program can be controlled with the cursor keys, joystick in port 1 or mouse in port 2.")
  SoftwareHelp_L("As you know the MSX video supports a refresh rate of 50Hz and 60Hz. The program uses the mode")
  SoftwareHelp_L("that is active at start-time. If the SHIFT key is pressed while confirming CALL FMPAC command")
  SoftwareHelp_L("with Enter the mode is toggled. After startup the FM STEREO PAK logo appears.")
  SoftwareHelp_L("Pushing the space key or fire button leaves this screen. An amplifier appears in the above half of the")
  SoftwareHelp_L("screen. It can be controlled with the arrow. Firstly the amplifier must be powered on. To do so push")
  SoftwareHelp_L("the POWER button. Then you can choose between:")
  SoftwareHelp_L("")
  SoftwareHelp_L("MUSIC mode")
  SoftwareHelp_L("Keyboard mode")
  SoftwareHelp_L("")
  SoftwareHelp_L("After powering on the amplifier is in MUSIC mode. This is also visible in the display. In this mode")
  SoftwareHelp_L("4 pre-programmed songs can be played, which are selectable on the screen. The 2 TRACK buttons can be")
  SoftwareHelp_L("used to select a song. The song starts playing immediately after the selection. While the music is")
  SoftwareHelp_L("playing every voice-beat is displayed on the screen. The selection of TRACK 00 stops playing.")
  SoftwareHelp_L("You can use the 2 VOL buttons so change the volume, which is also displayed on the screen. The KEYBOARD button")
  SoftwareHelp_L("switches to the second mode. Here the keyboard is changed to a polyphonic keyboard which is displayed")
  SoftwareHelp_L("in the lower half of the screen. It is connected to the amplifier to enable volume control in this")
  SoftwareHelp_L("mode too. The two INSTR buttons enable the selection of an instrument.")
  SoftwareHelp_L("")
  SoftwareHelp_L("You can select from a set of 15 different instruments. The selected instrument is displayed on the")
  SoftwareHelp_L("screen. The keyboard has approximately 3 octaves. You cannot play more than 6 sounds simultaneously.")
  SoftwareHelp_L("You can play the music with the computer keyboard; which key is assigned to a specific note is")
  SoftwareHelp_L("shown in the INFO-screen, which can be displayed by pressing the INFO button.")
  SoftwareHelp_L("Beside the picture of a computer, PAK and a hifi-system you can also see 5 different drums, which")
  SoftwareHelp_L("can be controlled with the cursor keys (return by pressing the fire button). The program supports")
  SoftwareHelp_L("5 different drums with the shortcuts:")
  SoftwareHelp_L("")
  SoftwareHelp_L(" F1 | HH | Hi Hat")
  SoftwareHelp_L("F2 | CIM | Cimbal")
  SoftwareHelp_L("F3 | TOM | Tom Tom")
  SoftwareHelp_L("F4 | SD | Snare drum")
  SoftwareHelp_L("F5 | BD | Bass drum")
  SoftwareHelp_L("You can not return from PAK to BASIC. The only way to do this is to reset the MSX.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Technical information:")
  SoftwareHelp_L("The FM STEREO PAK contains a 64KB ROM in range from &H0000-&HFFFF (no memory mapper).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL FMPAC")
  SoftwareHelp_Commit("CALL FMPAK", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL FNKEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL FNKEY", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL GPRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL GPRINT( <arg1> [, <arg2> [, ...]] )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints specified argument(s) in graphic mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 5")
  SoftwareHelp_L("20 CALL GPRINT( " + Chr(34) + "Sqrt of 27 is" + Chr(34) + ", SQR(27) )")
  SoftwareHelp_Commit("CALL GPRINT", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL GREG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL GREG( <string-variable> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("GET DATE D$")
  SoftwareHelp_L("PRINT D$")
  SoftwareHelp_L("12/31/99")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL DATE(D$)")
  SoftwareHelp_L("PRINT D$")
  SoftwareHelp_L("31/12/1999.5")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GET DATE")
  SoftwareHelp_Commit("CALL GREG", "MSX-BASIC - CALL (extensoes de firmware)")

