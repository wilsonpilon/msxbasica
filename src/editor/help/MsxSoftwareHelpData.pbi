  SoftwareHelp_Begin()
  SoftwareHelp_L("## CIRCLE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CIRCLE [STEP](<x,y>),<radius> [,<color> [,<start>,<end> [,<proportion>]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This command draws an ellipse on the screen.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x, y are coordinates of the center,")
  SoftwareHelp_L("")
  SoftwareHelp_L("radius is the radius of the biggest main-axis")
  SoftwareHelp_L("")
  SoftwareHelp_L("These values must be specified. Optional arguments are the")
  SoftwareHelp_L("")
  SoftwareHelp_L("color of the line (see color-table)")
  SoftwareHelp_L("")
  SoftwareHelp_L("start and end of the line (multiple of PI) and")
  SoftwareHelp_L("")
  SoftwareHelp_L("proportion the aspect-ratio* of the x- and y-axis")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplos:**")
  SoftwareHelp_L("10 SCREEN 2")
  SoftwareHelp_L("20 CIRCLE(100,100),40,1")
  SoftwareHelp_L("30 GOTO 30")
  SoftwareHelp_L("")
  SoftwareHelp_L("Draws an ellipse in the center of the screen. With")
  SoftwareHelp_L("")
  SoftwareHelp_L("20 CIRCLE(100,100),40,,,1.4")
  SoftwareHelp_L("")
  SoftwareHelp_L("you'll draw a circle")
  SoftwareHelp_L("")
  SoftwareHelp_L("*note: On a real msx the results of " + Chr(34) + "aspect-ratio" + Chr(34) + " will be different depending on")
  SoftwareHelp_L("your screens refresh-frequency, this example assumes 50 Hz (PAL) but when in 60 Hz (NTSC)")
  SoftwareHelp_L("specifing no aspect-ratio will result in a circle.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("CIRCLE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CLEAR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CLEAR [<stringsize> [,<adress>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This command clears the contents of all variables and all dimensions of arrays.")
  SoftwareHelp_L("The optional stringsize reserves additional memory on top of memory.")
  SoftwareHelp_L("Initially there are 200 Bytes reserved - for use in character-strings.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If adress is specified, this is the maximum address of BASIC-memory.")
  SoftwareHelp_L("This command can also be used if arrays must be dimensioned dynamically.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 CLEAR")
  SoftwareHelp_L("20 INPUT " + Chr(34) + "N=" + Chr(34) + ";N")
  SoftwareHelp_L("30 DIMA(N)")
  SoftwareHelp_L("40 GOTO 10")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ERASE,")
  SoftwareHelp_L("DIM,")
  SoftwareHelp_L("FRE,")
  SoftwareHelp_L("MAXFILES,")
  SoftwareHelp_L("DEF FN")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: do not confuse with CLS")
  SoftwareHelp_Commit("CLEAR", "MSX-BASIC 1 (MSX)")

