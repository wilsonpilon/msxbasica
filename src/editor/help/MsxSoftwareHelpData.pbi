  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL HIRO")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Firmware)")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL HIRO boots up the Word Processor in the MSX A1-ST (Turbo-R).")
  SoftwareHelp_L("")
  SoftwareHelp_L("This is similar to CALL MWP in the A1-GT. In case of A1-WX/WSX machines")
  SoftwareHelp_L("the corresponding command is CALL MENU.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Takamichi Suzukawa: These CALL commands are not written in any manual, but were notified in a")
  SoftwareHelp_L("magazine (MSX-FAN) as late as in 1994.")
  SoftwareHelp_Commit("CALL HIRO", "MSX-BASIC - CALL (extensoes de firmware)")

