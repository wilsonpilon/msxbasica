  SoftwareHelp_Begin()
  SoftwareHelp_L("## MSX-Audio (Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("The MSX-Audio is a rarely sold cartrige, which was replaced by MSX-Music (lower quality). The Philips Music Module is hardware-compatible to the MSX-Audio, but has no MSX-Audio basic (the Music Module uses a separate firmware ROM).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The firmware of both cartridges (MSX-Audio and Music-Module) can be bypassed by pressing ESC during startup.")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL AUDIO")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("MSX-Music,")
  SoftwareHelp_L("CALL MUSICBOX")
  SoftwareHelp_Commit("MSX-Audio (Basic)", "MSX-BASIC - Referencia")

