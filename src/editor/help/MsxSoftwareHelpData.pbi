  SoftwareHelp_Begin()
  SoftwareHelp_L("## BLOAD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("BLOAD " + Chr(34) + "<name>" + Chr(34) + "[,R[,<offset>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("BLOAD " + Chr(34) + "<name>" + Chr(34) + "[,S]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Binary LOAD:")
  SoftwareHelp_L("")
  SoftwareHelp_L("The binary file (often a assembly language program) name will be loaded at the beginaddress that was specified during BSAVE. If the option ',R' is added, the program will be started automatically. If there was no startadress  specified for BSAVE, the program begins it's execution on beginadress.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If an offset is specified the program will be loaded at beginaddres+offset.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If 'S' is specified this contents are loaded to VRAM from disk files. This can done in any screen mode, note, however, that ")
  SoftwareHelp_L("only the active pages are valid when the screen mode is from 5 to 8. No ")
  SoftwareHelp_L("cassette tapes can be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("BLOAD " + Chr(34) + "TEST.BIN" + Chr(34) + ",R")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("CLOAD,")
  SoftwareHelp_L("DEFUSR,")
  SoftwareHelp_L("SET PAGE,")
  SoftwareHelp_L("BSAVE")
  SoftwareHelp_Commit("BLOAD", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## BSAVE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("BSAVE " + Chr(34) + "<name>" + Chr(34) + "[,<beginadress>,<endadress>[,<startadress>][,2]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("BSAVE " + Chr(34) + "<name>" + Chr(34) + "[,<beginadress>,<endadress>][,S]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Saves the memory-contents from beginadress to endadress with name on the device. If a startadress is specified the machine-code program will be started on this address if it is loaded using BLOAD with the ',R' option. When no startaddress is specified the beginaddress will be used as startaddess.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the tape-device is used the ',2' option causes the recording speed to be set to 2400 baud in stead of the normal 1200 baud.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If 'S' is specified VRAM contents are saved to disk. This can be done for any screen mode, note, however, that ")
  SoftwareHelp_L("only the active pages are valid when the screen mode is from 5 to 8. No ")
  SoftwareHelp_L("cassette tapes can be used. Valid value range of address is from -32768 to ")
  SoftwareHelp_L("-2, or from 0 to 65534 (&HFFFE).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("BSAVE " + Chr(34) + "TEST.BIN" + Chr(34) + ",&H9000,&H92FF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SAVE,")
  SoftwareHelp_L("CSAVE,")
  SoftwareHelp_L("SET PAGE,")
  SoftwareHelp_L("BLOAD")
  SoftwareHelp_Commit("BSAVE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL <extended statement name>[(<arguments>)]")
  SoftwareHelp_L("")
  SoftwareHelp_L("_ <extended statement name>[(<arguments>)]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Executes a extended BASIC-command stored in an extension ROM.")
  SoftwareHelp_L("Instead of the keyword CALL you can also use a _ (underscore).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplos:**")
  SoftwareHelp_L("CALL SYSTEM")
  SoftwareHelp_L("CALL KANJI")
  SoftwareHelp_L("CALL ANK")
  SoftwareHelp_L("CALL TURBO ON")
  SoftwareHelp_L("CALL TURBO OFF")
  SoftwareHelp_L("CALL PAUSE(100)")
  SoftwareHelp_Commit("CALL", "MSX-BASIC 1 (MSX)")

