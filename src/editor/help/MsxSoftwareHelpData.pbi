  SoftwareHelp_L("## CALL TOGREG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL TOGREG", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL TOHIJRI")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL TOHIJRI", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL TRANSPOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Music)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL TRANSPOSE( number )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Will tranpose in units of half tones 1/100 units.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number can have values from -12799 to 12799 or a variable.")
  SoftwareHelp_L("However, some voices have a limited setting even through within the +-12799 range.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Default setting is 0")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplos:**")
  SoftwareHelp_L("CALL TRANSPOSE (100)")
  SoftwareHelp_L("")
  SoftwareHelp_L("tranposes a half tone.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL MUSIC")
  SoftwareHelp_Commit("CALL TRANSPOSE", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL TURBO OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Turbo-Basic compiler)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL TURBO OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("The end of a turbo-block started with CALL TURBO ON.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 SCREEN 8:DEFINT A-Z")
  SoftwareHelp_L("110 BLOAD" + Chr(34) + "PICTURE" + Chr(34) + ",S")
  SoftwareHelp_L("120 _TURBO ON")
  SoftwareHelp_L("130 FOR X=0 TO 255")
  SoftwareHelp_L("140 LINE(X,0)-(X,211),0")
  SoftwareHelp_L("150 NEXT X")
  SoftwareHelp_L("160 _TURBO OFF")
  SoftwareHelp_L("170 GOTO 170")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL TURBO ON, CALL RUN")
  SoftwareHelp_Commit("CALL TURBO OFF", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL TURBO ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Turbo-Basic compiler)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL TURBO ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Defines the beginning of the turbo block. ")
  SoftwareHelp_L("The turbo block is the part of the program you want to execute fast. When the ")
  SoftwareHelp_L("entire program contains some uncompilable statements, you can define the ")
  SoftwareHelp_L("block to be compiled using this set.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The following statements, commands and functions that can not be compiled:")
  SoftwareHelp_L("")
  SoftwareHelp_L("AUTO, BASE, BLOAD, BSAVE, CALL, CDBL, CINT, CLEAR, CLOAD, CLOAD?, CLOSE, ")
  SoftwareHelp_L("CONT, CSAVE, CSNG, CVD, CVI, CVS, DEFFN, DELETE, DRAW, DSKF, EOF, ERASE, ERL, ")
  SoftwareHelp_L("ERR, ERROR, EQV, FIELD, FILES, FPOS, FRE, GET, IMP, INPUT#, KEY LIST, LFILES, ")
  SoftwareHelp_L("LINEINPUT#, LIST, LLIST, LOAD, LOC, LOF, LPRINT USING, LSET, MAXFILES, MERGE, ")
  SoftwareHelp_L("MOTOR, MKD$, MKI$, MKS$, NAME, NEW, ON ERROR GOTO, ON INTERVAL GOSUB (due to ")
  SoftwareHelp_L("a bug), OPEN, PLAY, PRINT#, PRINT USING, PUT KANJI, RENUM, RESUME, RSET, ")
  SoftwareHelp_L("SAVE, SPC, TAB, TRON, TROFF, WIDTH.")
  SoftwareHelp_L("")
  SoftwareHelp_L("List of those with limits.")
  SoftwareHelp_L("")
  SoftwareHelp_L("CIRCLE: Start, end angles and aspect ratio can't be specified.")
  SoftwareHelp_L("")
  SoftwareHelp_L("COPY: Only graphic COPY is available.")
  SoftwareHelp_L("")
  SoftwareHelp_L("DEFDBL: Same as DEFSNG.")
  SoftwareHelp_L("")
  SoftwareHelp_L("DIM: Must come first in the program or in the turbo block.")
  SoftwareHelp_L("")
  SoftwareHelp_L("INPUT: Can handle only one variable at the time.")
  SoftwareHelp_L("")
  SoftwareHelp_L("KEY: ON KEY GOSUB, KEY(n) ON/OFF only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LOCATE: x,y must be given in as a set. No cursor switch parameter.")
  SoftwareHelp_L("")
  SoftwareHelp_L("NEXT: Variable names after the NEXT can not be omitted.")
  SoftwareHelp_L("")
  SoftwareHelp_L("ON: ON STOP GOSUB, ON INTERVAL GOSUB not available.")
  SoftwareHelp_L("")
  SoftwareHelp_L("PRINT: Commas work in a different way. No wrapping for digits.")
  SoftwareHelp_L("")
  SoftwareHelp_L("PUT: PUT SPRITE only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("RUN: Variables won't be initialized.")
  SoftwareHelp_L("")
  SoftwareHelp_L("SCREEN: Screen mode and sprite size only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("SET: SET PAGE only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("STOP: Same as END.")
  SoftwareHelp_L("")
  SoftwareHelp_L("USR: Parameter type must be integer only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("VARPTR: File number can not be given as the parameter.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Otherwise there is no significant difference.")
  SoftwareHelp_L("")
  SoftwareHelp_L("In general, I/O commands & functions, and editing commands can not be ")
  SoftwareHelp_L("compiled. Of course they are available in the direct mode, and outside of the ")
  SoftwareHelp_L("turbo block. You can edit, debug and save a program in MSX-BASIC and execute ")
  SoftwareHelp_L("it by _RUN.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If you want to use PRINT# to write characters on GRP:, use it outside of ")
  SoftwareHelp_L("turbo block. Otherwise study the sample, " + Chr(34) + "PRINT.TRB" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("If you want to use PLAY, use BGM compiler, and get the sound by USR(n).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 SCREEN 8:DEFINT A-Z")
  SoftwareHelp_L("110 BLOAD" + Chr(34) + "PICTURE" + Chr(34) + ",S")
  SoftwareHelp_L("120 _TURBO ON")
  SoftwareHelp_L("130 FOR X=0 TO 255")
  SoftwareHelp_L("140 LINE(X,0)-(X,211),0")
  SoftwareHelp_L("150 NEXT X")
  SoftwareHelp_L("160 _TURBO OFF")
  SoftwareHelp_L("170 GOTO 170")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL TURBO OFF, CALL RUN")
  SoftwareHelp_Commit("CALL TURBO ON", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL VOICE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Music)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL VOICE( [@n1], [@n2], ..., [@n9] )")
  SoftwareHelp_L("")
  SoftwareHelp_L("n1-n9 can be values from 0-63 (voice nr) or variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Default setting is @0")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Stes  what  instrument  is to be played by  the  FM ")
  SoftwareHelp_L("sound channels.  However,  values without * mark and array ")
  SoftwareHelp_L("values (refer to MSX-Music Voices) are limited to 2")
  SoftwareHelp_L("when used together.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: The voice number can be selected from the table MSX-Music Voices table of voices numbers.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL VOICE(@0,@31,@32)")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL VOICE(@0,@6,@25,@24)")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL VOICE(,,@48)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL VOICE COPY,")
  SoftwareHelp_L("CALL MUSIC")
  SoftwareHelp_Commit("CALL VOICE", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL VOICE COPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Music)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL VOICE COPY( @n1, @n2 )")
  SoftwareHelp_L("")
  SoftwareHelp_L("n1 can be voices from 0-63 that have no * mark or array variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("n2 can be 63 or an array variable name.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This   command  copies the voice data to number 63  or  an ")
  SoftwareHelp_L("array variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: choose the voice from the table MSX-Music Voices.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DIM A%(16)")
  SoftwareHelp_L("CALL VOICE COPY (@7,A%)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Pipe organ 1 is copied to array variable A.")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 CALL MUSIC")
  SoftwareHelp_L("20 DIM K(15)")
  SoftwareHelp_L("30 CALL VOICE COPY(@31, K)")
  SoftwareHelp_L("40 CALL VOICE COPY(K, @63)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Copies the software-instrument BASSDRUM from the ROM into free space.")
  SoftwareHelp_L("On first view this does not have any useful effect. It is also possible to use CALL VOICE")
  SoftwareHelp_L("to copy instrument 31 from the computer directly.")
  SoftwareHelp_L("")
  SoftwareHelp_L("More interesting is the possibility to manipulate data in the array K,")
  SoftwareHelp_L("which enables creation of new instruments.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL VOICE,")
  SoftwareHelp_L("CALL MUSIC")
  SoftwareHelp_Commit("CALL VOICE COPY", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL VPRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Arabic-Basic)")
  SoftwareHelp_Commit("CALL VPRINT", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ATTR$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("This keyword is reserved for future use.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("Reserved keywords")
  SoftwareHelp_Commit("ATTR$", "MSX-BASIC (outros)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CMD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("This keyword is reserved for future use.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("Reserved keywords")
  SoftwareHelp_Commit("CMD", "MSX-BASIC (outros)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COPY (X1,Y1) - (X2,Y2)[, <source page>] TO (X3,Y3)[, <destination page>")
  SoftwareHelp_L("     [, <logical operation>]]")
  SoftwareHelp_L("COPY (X1,Y1) - (X2,Y2)[, <source page>] TO {<array variable name> |")
  SoftwareHelp_L("     <filename>}")
  SoftwareHelp_L("COPY {<array variable name> | <filename>}[, <direction>] TO (X3,Y3)")
  SoftwareHelp_L("     [, <destination page>[, <logical operation>]]")
  SoftwareHelp_L("COPY <filename> TO <array variable name>")
  SoftwareHelp_L("COPY <array variable name> TO <filename>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COPY (Disk-Basic), COPY SCREEN, SET PAGE")
  SoftwareHelp_Commit("COPY", "MSX-BASIC (outros)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COPY SCREEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COPY SCREEN [<mode>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This instruction is used to specify that a general signal must be digitized.")
  SoftwareHelp_L("mode indicates the mode of digitization.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This statement is used for writing data from the colour bus to VRAM, for ")
  SoftwareHelp_L("example, after digitising. This is valid for screen modes 5 to 8.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Attention: This statement is for the superimposer or the digitiser which are optional, ")
  SoftwareHelp_L("so it can be used only for machines which are equipped with this the 'superimpose' capability.")
  SoftwareHelp_L("")
  SoftwareHelp_L("In mode 0, one field of signals [=1 frame] is digitised and written to the display page")
  SoftwareHelp_L("(that is the page reproduced on screen).")
  SoftwareHelp_L(" ")
  SoftwareHelp_L("In mode 1, two successive fields (that is, one frame) of signals [=2 frames] are written ")
  SoftwareHelp_L("to (display page - 1)th page and the display page, so the display page should ")
  SoftwareHelp_L("be an odd page when the mode is 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The default mode is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("COPY SCREEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("COPY SCREEN 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("110 ON STOP GOSUB 210")
  SoftwareHelp_L("120 STOP ON")
  SoftwareHelp_L("130 SCREEN 8")
  SoftwareHelp_L("140 COLOR,,255")
  SoftwareHelp_L("150 SET VIDEO 1")
  SoftwareHelp_L("160 COPY SCREEN")
  SoftwareHelp_L("170 TIME=0")
  SoftwareHelp_L("180 IF INKEY$=" + Chr(34) + Chr(34) + " GOTO160")
  SoftwareHelp_L("190 IF TIME<4 GOTO 190")
  SoftwareHelp_L("200 IF INKEY$=" + Chr(34) + Chr(34) + " GOTO 200 ELSE 140")
  SoftwareHelp_L("210 '**STOP**")
  SoftwareHelp_L("220 SET VIDEO 0,0")
  SoftwareHelp_L("230 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("This program requires to push 'audio/video' button on the MSX-console.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET VIDEO,")
  SoftwareHelp_L("SET PAGE,")
  SoftwareHelp_L("COPY (MSX2-Basic),")
  SoftwareHelp_L("COPY (Disk-Basic)")
  SoftwareHelp_Commit("COPY SCREEN", "MSX-BASIC (outros)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FPOS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("This keyword is reserved for future use.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FPOS( channel )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("Reserved keywords,")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("CLOSE")
  SoftwareHelp_Commit("FPOS", "MSX-BASIC (outros)")

