  SoftwareHelp_Commit("CALL INDNUM", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL INDVAL")
  SoftwareHelp_L("")
