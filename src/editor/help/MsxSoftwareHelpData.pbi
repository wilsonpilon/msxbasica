; Auto-gerado por convert_software.py (descartavel, nao versionado) a partir de
; help/SOFTWARE.CHM (RuMSX, Lex Lechz - lexlechz.at): comandos MSX-Basic, MSX-DOS
; e CP/M. Conteudo reproduzido como no original (Windows-1252 -> UTF-8, tags HTML
; removidas), so os rotulos de secao (Sintaxe/Funcao/Exemplo/Veja tambem/...)
; foram traduzidos - a prosa em si nao foi reescrita.

Structure SoftwareHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList SoftwareHelp_Topics.SoftwareHelpTopic()
Global SoftwareHelp_DataBuilt.b = #False
Global NewList SoftwareHelp_Scratch.s()

Procedure SoftwareHelp_Begin()
  ClearList(SoftwareHelp_Scratch())
EndProcedure

Procedure SoftwareHelp_L(Line.s)
  AddElement(SoftwareHelp_Scratch())
  SoftwareHelp_Scratch() = Line
EndProcedure

Procedure SoftwareHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach SoftwareHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + SoftwareHelp_Scratch()
    First = #False
  Next
  AddElement(SoftwareHelp_Topics())
  SoftwareHelp_Topics()\Titulo = Titulo
  SoftwareHelp_Topics()\Grupo = Grupo
  SoftwareHelp_Topics()\Corpo = Body
EndProcedure

Procedure SoftwareHelp_BuildData()
  If SoftwareHelp_DataBuilt
    ProcedureReturn
  EndIf
  SoftwareHelp_DataBuilt = #True

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ABS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ABS(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Generates the absolute-value (unsigned) of the specified number.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT ABS(-10)")
  SoftwareHelp_L(" 10")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SGN")
  SoftwareHelp_Commit("ABS", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## AND")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("<number1> AND <number2>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Performs a bitwise AND-operation:")
  SoftwareHelp_L("0 AND 0 | = | 0")
  SoftwareHelp_L("0 AND 1 | = | 0")
  SoftwareHelp_L("1 AND 0 | = | 0")
  SoftwareHelp_L("1 AND 1 | = | 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("The AND-operation is often used to " + Chr(34) + "mask" + Chr(34) + " one or more bits.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT 15 AND 11       1111B")
  SoftwareHelp_L(" 11                   1011B AND ")
  SoftwareHelp_L("Ok                    -----")
  SoftwareHelp_L("                      1011B   ")
  SoftwareHelp_L("")
  SoftwareHelp_L("PRINT 6 AND 13        0110B ")
  SoftwareHelp_L(" 4                    1101B AND")
  SoftwareHelp_L("Ok                    -----")
  SoftwareHelp_L("                      0100B")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
