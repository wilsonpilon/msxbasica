  SoftwareHelp_Begin()
  SoftwareHelp_L("## MSX-Music Voices")
  SoftwareHelp_L("")
  SoftwareHelp_L("This is a list of the voices available for use with Voice command or the ")
  SoftwareHelp_L(" MML @ statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Voice No. | Name | Voice No. | Name")
  SoftwareHelp_L("0 * | Piano 1 | 32 | Piano 3")
  SoftwareHelp_L("1 | Piano 2 | 33 * | Wood Bass")
  SoftwareHelp_L("2 * | Violin | 34 | Santule 2")
  SoftwareHelp_L("3 * | Flute 1 | 35 | Brass")
  SoftwareHelp_L("4 * | Clarinet | 36 | Flute 2")
  SoftwareHelp_L("5 * | Oboe | 37 | Clavicord 2")
  SoftwareHelp_L("6 * | Trumpet | 38 | Clavicord 3")
  SoftwareHelp_L("7 | Pipe Organ | 39 | Koto 2")
  SoftwareHelp_L("8 | Xylophone | 40 | Pipe Organ 2")
  SoftwareHelp_L("9 * | Organ | 41 | P0hdsPLA")
  SoftwareHelp_L("10 * | Guitar | 42 | P0hdsPRA")
  SoftwareHelp_L("11 | Santule 1 | 43 | Church Organ L")
  SoftwareHelp_L("12 * | Electric bass | 44 | Church Organ R")
  SoftwareHelp_L("13 | Clavicord 1 | 45 | Synth Violin")
  SoftwareHelp_L("14 * | Hapsicord | 46 | Synth Organ")
  SoftwareHelp_L("15 | Hapsicord | 47 | Synth Brass")
  SoftwareHelp_L("16 * | Vibraphone | 48 * | Horn")
  SoftwareHelp_L("17 | Koto 1 | 49 | Shamisen")
  SoftwareHelp_L("18 | Taiko | 50 | Magical")
  SoftwareHelp_L("19 | Engine 1 | 51 | Fuwawa")
  SoftwareHelp_L("20 | UFO | 52 | Wonderflat")
  SoftwareHelp_L("21 | Synth Bell | 53 | Hard Rock")
  SoftwareHelp_L("22 | Chime | 54 | Machine")
  SoftwareHelp_L("23 * | Synth Bass | 55 | Machine V")
  SoftwareHelp_L("24 * | Synthesizer | 56 | Comic")
  SoftwareHelp_L("25 | Synth drum | 57 | SE comic")
  SoftwareHelp_L("26 | Synth rhythm | 58 | SE laser")
  SoftwareHelp_L("27 | Harmo drum | 59 | SE noise")
  SoftwareHelp_L("28 | Cow Bell | 60 | SE star 1")
  SoftwareHelp_L("29 | Hi Hat | 61 | SE star 2")
  SoftwareHelp_L("30 | Snare drum | 62 | Engine 2")
  SoftwareHelp_L("31 | Bass drum | 63 | no sound")
  SoftwareHelp_L("* are sounds that are build in the FM sound chip.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL VOICE,")
  SoftwareHelp_L("CALL VOICE COPY,")
  SoftwareHelp_L("PLAY (MSX-Music)")
  SoftwareHelp_Commit("MSX-Music Voices", "MSX-BASIC - Referencia")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## Screen-modes")
  SoftwareHelp_L("")
  SoftwareHelp_L("Correspondances of BASIC screen (SCREEN) modes and VDP screen modes")
  SoftwareHelp_L("")
  SoftwareHelp_L("BASICmode | VDPmode | Meaning")
  SoftwareHelp_L("Dots or characters | Display colours at a time | Screen format")
  SoftwareHelp_L("SCREEN 0 (1) | TEXT 1 | 40 x 24 chars | 2 from 512 | Text")
  SoftwareHelp_L("SCREEN 0 (2) | TEXT 2 | 80 x 24 chars | 2 from 512 | Text")
  SoftwareHelp_L("SCREEN 1 | GRAPHIC 1 | 32 x 24 chars | 16 from 512 | Text")
  SoftwareHelp_L("SCREEN 2 | GRAPHIC 2 | 256 x 192 dots | 16 from 512 | High res. graphics")
  SoftwareHelp_L("SCREEN 3 | MULTICOLOUR | 64 x 48 dots | 16 from 512 | Low res. graphics")
  SoftwareHelp_L("SCREEN 4 | GRAPHIC 3 | 256 x 192 dots | 16 from 512 | High res. graphics")
  SoftwareHelp_L("SCREEN 5 | GRAPHIC 4 | 256 x 212 dots | 16 from 512 | Bit map graphics")
  SoftwareHelp_L("SCREEN 6 | GRAPHIC 5 | 512 x 212 dots | 4 from 512 | Bit map graphics")
  SoftwareHelp_L("SCREEN 7 | GRAPHIC 6 | 512 x 212 dots | 16 from 512 | Bit map graphics")
  SoftwareHelp_L("SCREEN 8 | GRAPHIC 7 | 256 x 212 dots | 256 | Bit map graphics")
  SoftwareHelp_L("SCREEN 9* | GRAPHIC 5 | 80 x 24 chars | 4 from 512 | Text")
  SoftwareHelp_L("SCREEN 10 | Graphic 8 | 256 x 212 dots | A lot + 16 from 512 | Bit map graphics")
  SoftwareHelp_L("SCREEN 11 | Graphic 8 | 256 x 212 dots | A lot + 16 from 512 | Bit map graphics")
  SoftwareHelp_L("SCREEN 12 | Graphic 9 | 256 x 212 dots | 19268 | Bit map graphics")
  SoftwareHelp_L("")
  SoftwareHelp_L("*SCREEN 9: only implemented in Korean MSX2 computers to display Korean KANJI characters.")
  SoftwareHelp_L("This mode is not implemented in the normal MSX-BIOS but part of the Hangul-ROM.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This screen-mode is quite curious, but available in the normal MSX2 Video-processor (V9938) too.")
  SoftwareHelp_L("The effective VDP-mode is GRAPHIC 5 (SCREEN 6) with some specific settings (see table below).")
  SoftwareHelp_L("The only difference to other MSX-machines is the support of this mode by BIOS routines.")
  SoftwareHelp_L("In fact SCREEN 9 has the following properties:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Property | Value | Notes")
  SoftwareHelp_L("Resolution | 80 x 24 characters | can be adjusted by the WIDTH statement")
  SoftwareHelp_L("512 x 384 dots | interlaced (2*192 lines)")
  SoftwareHelp_L("Characters | 6*16 pixels | are read from the Kanji-ROM, which (may?) need to be present")
  SoftwareHelp_L("Text color | green (3) | Text color is effectively set to 15 (white), but GRAPHIC 5 mode uses only the")
  SoftwareHelp_L("        lower 2 bits therefore the value of the displayed color is 3.")
  SoftwareHelp_L("Background color | black (1)")
  SoftwareHelp_L("Border color | black (1)")
  SoftwareHelp_L("Sprites | disabled")
  SoftwareHelp_L("Note: when activating SCREEN 9 the system automatically changes the used colors. When leaving SCREEN 9 and")
  SoftwareHelp_L("returning to another screen-mode the changed colors remain valid.")
  SoftwareHelp_Commit("Screen-modes", "MSX-BASIC - Referencia")

