  SoftwareHelp_Begin()
  SoftwareHelp_L("## RAMDISK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-DOS 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Formato:**")
  SoftwareHelp_L("RAMDISK [number[K]] [/D]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Finalidade:**")
  SoftwareHelp_L("Displays or sets the RAM disk size.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Uso:**")
  SoftwareHelp_L("   If  no parameters  are given, then the current RAMDISK size is displayed ")
  SoftwareHelp_L("as the number of kilobytes.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     The  number, if  given, specifies the maximum size for the new RAM disk, ")
  SoftwareHelp_L("and is  specified in kilobytes. The range is 0 to 4064. If the number is 0 or ")
  SoftwareHelp_L("only  /D is  specified, the  RAM disk  will be  deleted. This  number will be ")
  SoftwareHelp_L("rounded up  to the  nearest multiple  of 16K  since the  RAM disk is always a ")
  SoftwareHelp_L("multiple  of 16K.  A RAM  disk smaller then the specified maximum size may be ")
  SoftwareHelp_L("created if there is not enough free memory for the full size, although a 'not ")
  SoftwareHelp_L("enough memory' error will be given if there is no memory at all available for ")
  SoftwareHelp_L("the RAM  disk. Note that the number specified is the maximum amount of RAM to ")
  SoftwareHelp_L("use  for the  RAM disk,  which is  not the same as the maximum amount of free ")
  SoftwareHelp_L("space available  on the  newly-created RAM disk since the system needs to use ")
  SoftwareHelp_L("some for FAT or directories.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     On MSX machines with 128K RAM, the maximum amount of RAM disk is 32K.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     If  a  RAM  disk already  exists before  a new  one is  created, then  a ")
  SoftwareHelp_L("'Destroy  all data  on RAM disk (Y/N)?' prompt is printed to avoid accidental ")
  SoftwareHelp_L("loss of  data. /D  can be  given which will automatically delete any existing ")
  SoftwareHelp_L("RAM disk first, thus suppressing the prompt.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     Having created a RAM disk, it can be referred to as drive H:.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     The RAMDISK command is normally only used in an AUTOEXEC.BAT batch file, ")
  SoftwareHelp_L("with a  large number  specified so  that as  large a  RAMDISK as  possible is ")
  SoftwareHelp_L("created.  It is  not advisable  to keep  any data  on a RAM disk except for a ")
  SoftwareHelp_L("short length of time that is not also kept on a floppy disk, since it will be ")
  SoftwareHelp_L("lost if, for example, the power to the computer fails.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplos:**")
  SoftwareHelp_L("RAMDISK")
  SoftwareHelp_L("RAMDISK=160K")
  SoftwareHelp_L("")
  SoftwareHelp_L("No parameters  were given,  so the current size is printed, in this case  160K.")
  SoftwareHelp_L("")
  SoftwareHelp_L("RAMDISK")
  SoftwareHelp_L("*** RAM disk does not exist")
  SoftwareHelp_L("")
  SoftwareHelp_L("No  parameters were given but no RAM disk has been created, so the error is given.")
  SoftwareHelp_L("")
  SoftwareHelp_L("RAMDISK = 300")
  SoftwareHelp_L("Destroy all data on RAM disk (Y/N)? y")
  SoftwareHelp_L("")
  SoftwareHelp_L("A RAM disk already existed, so the prompt was printed. In this case, the ")
  SoftwareHelp_L("reply was 'y' so the current RAM disk was deleted and the new one set up with ")
  SoftwareHelp_L("a maximum size of 300K.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL RAMDISK,")
  SoftwareHelp_L("RAM-Disk in MSX-Basic 2,")
  SoftwareHelp_L("RAM-Disk in Disk-Basic 2,")
  SoftwareHelp_L("RAM-Disk in MSX-DOS 2")
  SoftwareHelp_Commit("RAMDISK", "MSX-DOS")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CP/M")
  SoftwareHelp_L("")
  SoftwareHelp_L("The CP/M operating system is optional (in most cases extra sold).")
  SoftwareHelp_L("")
  SoftwareHelp_L("1976: Gary Kildall developed CP/M, an operating system for personal computers.")
  SoftwareHelp_L("Widely adopted, CP/M made it possible for one version of a program to run on a")
  SoftwareHelp_L("variety of computers built around eight-bit microprocessors.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Internal commands:")
  SoftwareHelp_L("")
  SoftwareHelp_L("DIR filespec")
  SoftwareHelp_L("")
  SoftwareHelp_L("displays filenames from disk-device")
  SoftwareHelp_L("")
  SoftwareHelp_L("ERA filespec")
  SoftwareHelp_L("")
  SoftwareHelp_L("deletes file(s)")
  SoftwareHelp_L("")
  SoftwareHelp_L("PIP newname=oldname")
  SoftwareHelp_L("")
  SoftwareHelp_L("renames file(s)")
  SoftwareHelp_L("")
  SoftwareHelp_L("SAVE size filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("Copies memory-contents starting from 0100H (256*size bytes) into filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("TYPE filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("displays file-contents on the screen")
  SoftwareHelp_L("")
  SoftwareHelp_L("USER number")
  SoftwareHelp_L("")
  SoftwareHelp_L("changes the user-area on disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("External commands:")
  SoftwareHelp_L("")
  SoftwareHelp_L("ASM filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("8080 assembler")
  SoftwareHelp_L("")
  SoftwareHelp_L("DDT filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("debugger/editor for machine-code programs")
  SoftwareHelp_L("")
  SoftwareHelp_L("ED filename")
  SoftwareHelp_L("")
  SoftwareHelp_L("text-editor")
  SoftwareHelp_L("")
  SoftwareHelp_L("FORMAT")
  SoftwareHelp_L("")
  SoftwareHelp_L("formats a disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("MOVCPM")
  SoftwareHelp_L("")
  SoftwareHelp_L("configures CP/M for a different memory-size. Is not used by normal users and therefore")
  SoftwareHelp_L("not delivered in many cases.")
  SoftwareHelp_L("")
  SoftwareHelp_L("PIP targetfile=sourcefile")
  SoftwareHelp_L("")
  SoftwareHelp_L("copies file(s)")
  SoftwareHelp_L("")
  SoftwareHelp_L("STAT filespec")
  SoftwareHelp_L("")
  SoftwareHelp_L("STAT options")
  SoftwareHelp_L("")
  SoftwareHelp_L("display directory-contents including filesize and attributes,")
  SoftwareHelp_L("sets and resets file-attributes,")
  SoftwareHelp_L("changes and displays Iobytes")
  SoftwareHelp_L("")
  SoftwareHelp_L("SUBMIT filename parameter")
  SoftwareHelp_L("")
  SoftwareHelp_L("starts a batch-file")
  SoftwareHelp_L("")
  SoftwareHelp_L("SYSGEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("copies the bootstrap-loader and operating-system onto another disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("XSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("help-program for batch-processing")
  SoftwareHelp_Commit("CP/M", "CP/M")

EndProcedure
