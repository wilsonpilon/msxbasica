  SoftwareHelp_Begin()
  SoftwareHelp_L("## BASE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("BASE(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the base-address of a video-processor register. Where number is a number between 0 and 12 and has following meaning:")
  SoftwareHelp_L("")
  SoftwareHelp_L("(*) = Added for MSX2")
  SoftwareHelp_L("")
  SoftwareHelp_L("Mode-name: | Screen-mode: | Table: | Name:")
  SoftwareHelp_L("Text 1 | Screen 0, width 40 | pt | pattern-table")
  SoftwareHelp_L("*Text 2 | Screen 0, width 80 | spt | sprite-pattern-table")
  SoftwareHelp_L("Mutli-color | Screen 3 | spat | sprite-attribute-table")
  SoftwareHelp_L("Graphics 1 | Screen 1 | ct | color-table")
  SoftwareHelp_L("Graphics 2 | Screen 2 | nt | name-table")
  SoftwareHelp_L("*Graphics 3 | Screen 4")
  SoftwareHelp_L("*Graphics 4 | Screen 5")
  SoftwareHelp_L("*Graphics 5 | Screen 6")
  SoftwareHelp_L("*Graphics 6 | Screen 7")
  SoftwareHelp_L("*Graphics 7 | Screen 8")
  SoftwareHelp_L("")
  SoftwareHelp_L("Base: | Table: | Mode-name: | Init:")
  SoftwareHelp_L("0 | nt | Text 1 | $0000")
  SoftwareHelp_L("2 | pt | Text 1 | $0800")
  SoftwareHelp_L("5 | nt | Text 2 | $1800")
  SoftwareHelp_L("6 | ct | Text 2 | $2000")
  SoftwareHelp_L("7 | pt | Text 2 | $0000")
  SoftwareHelp_L("10 | nt | Graphics 1 | $1800")
  SoftwareHelp_L("11 | ct | Graphics 1 | $2000")
  SoftwareHelp_L("12 | pt | Graphics 1 | $0000")
  SoftwareHelp_L("13 | spat | Graphics 1 | $1B00")
  SoftwareHelp_L("14 | spt | Graphics 1 | $3800")
  SoftwareHelp_L("15 | nt | Graphics 2 | $0800")
  SoftwareHelp_L("16 | pt | Graphics 2 | $0000")
  SoftwareHelp_L("18 | spat | Graphics 2 | $1B00")
  SoftwareHelp_L("19 | spt | Graphics 2 | $3800")
  SoftwareHelp_L("20 | nt | Graphics 3 | $1800")
  SoftwareHelp_L("21 | ct | Graphics 3 | $2000")
  SoftwareHelp_L("22 | pt | Graphics 3 | $0000")
  SoftwareHelp_L("23 | spat | Graphics 3 | $1E00")
  SoftwareHelp_L("24 | spt | Graphics 3 | $3800")
  SoftwareHelp_L("25 | nt | Graphics 4 | $0000")
  SoftwareHelp_L("28 | spat | Graphics 4 | $7600")
  SoftwareHelp_L("29 | spt | Graphics 4 | $7800")
  SoftwareHelp_L("30 | nt | Graphics 5 | $0000")
  SoftwareHelp_L("33 | spat | Graphics 5 | $7600")
  SoftwareHelp_L("34 | spt | Graphics 5 | $7800")
  SoftwareHelp_L("35 | nt | Graphics 6 | $0000")
  SoftwareHelp_L("38 | spat | Graphics 6 | $FA00")
  SoftwareHelp_L("39 | spt | Graphics 6 | $F000")
  SoftwareHelp_L("40 | nt | Graphics 7 | $0000")
  SoftwareHelp_L("43 | spat | Graphics 7 | $FA00")
  SoftwareHelp_L("44 | spt | Graphics 7 | $F000")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT BASE(2)")
  SoftwareHelp_L(" 2048")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("VDP")
