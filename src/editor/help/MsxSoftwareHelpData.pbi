  SoftwareHelp_L("Closes a file, if no filenumber is specified all open files will be closed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("RS232: If the channel was opened in output mode, the EOF character is sent.")
  SoftwareHelp_L("Note that the file buffer allocated by BASIC following the FCB is not actually used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 MAXFILES=1")
  SoftwareHelp_L("20 OPEN " + Chr(34) + "TEST" + Chr(34) + " FOR OUTPUT AS#1")
  SoftwareHelp_L("30 A$=" + Chr(34) + "MSX" + Chr(34))
  SoftwareHelp_L("40 PRINT #1,A$")
  SoftwareHelp_L("50 CLOSE #1")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN, EOF, LOC, LOF")
  SoftwareHelp_Commit("CLOSE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CLS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CLS")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Clears the screen (as well in text as in graphics modes).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("-")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL CLS,")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("SCREEN")
  SoftwareHelp_Commit("CLS", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR [<foreground>][,<background>][,<border>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("COLOR modifies the color of the foreground (active drawing), background and border.")
  SoftwareHelp_L("Possible values and differences in various screen-modes can be found in the color-table.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("1000 COLOR 15,1,1:SCREEN 2")
  SoftwareHelp_L("1010 OPEN " + Chr(34) + "GRP:" + Chr(34) + " FOR OUTPUT AS #1")
  SoftwareHelp_L("1020 PRESET (10,5)")
  SoftwareHelp_L("1030 PRINT #1, " + Chr(34) + "A WELL TUNED TV-SET" + Chr(34))
  SoftwareHelp_L("1040 PRESET (10,15)")
  SoftwareHelp_L("1050 PRINT #1, " + Chr(34) + "SHOWS 15 COLORS AND BLACK" + Chr(34))
  SoftwareHelp_L("1060 CLOSE #1")
  SoftwareHelp_L("1070 FOR G=2 TO 15")
  SoftwareHelp_L("1080 COLOR G")
  SoftwareHelp_L("1090 LINE (G*16-15,30)-(G*16,184),,BF")
  SoftwareHelp_L("1100 NEXT G")
  SoftwareHelp_L("1110 GOTO 1110")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COLOR SPRITE")
  SoftwareHelp_L("COLOR SPRITE$")
  SoftwareHelp_L("COLOR=,")
  SoftwareHelp_L("COLOR=RESTORE,")
  SoftwareHelp_L("COLOR=NEW,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT")
  SoftwareHelp_Commit("COLOR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CONT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CONT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("CONT continues a program, which was halted with CTRL/STOP or the STOP or END instruction.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Test line 1" + Chr(34))
  SoftwareHelp_L("20 END")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "Test line 2" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("Test line 1")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("CONT")
  SoftwareHelp_L("Test line 2")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RUN,")
  SoftwareHelp_L("END,")
  SoftwareHelp_L("STOP")
  SoftwareHelp_Commit("CONT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COS(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calculates the cosine of the specified number.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT COS(100)")
  SoftwareHelp_L(" .86231887228917")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ATN,")
  SoftwareHelp_L("SIN,")
  SoftwareHelp_L("TAN")
  SoftwareHelp_Commit("COS", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CSAVE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CSAVE " + Chr(34) + "<name>" + Chr(34) + " [,2]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Cassette Save, stores a basic program on tape.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the ',2' option is added the recording speed is set to 2400 baud in stead of the normal 1200 baud.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: CSAVE is no longer supported and will generate a " + Chr(34) + "syntax error" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CSAVE " + Chr(34) + "TEST" + Chr(34) + ",2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLOAD?, CLOAD, SAVE, BSAVE")
  SoftwareHelp_Commit("CSAVE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CSNG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CSNG(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts number into a single-precision value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("-")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CDBL,")
  SoftwareHelp_L("CINT")
  SoftwareHelp_Commit("CSNG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CSRLIN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CSRLIN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the current Y-position of the cursor.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LOCATE 0,5:PRINT CSRLIN ")
  SoftwareHelp_L(" 5")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LOCATE,")
  SoftwareHelp_L("POS")
  SoftwareHelp_Commit("CSRLIN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DATA")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DATA <value>[,<value2> [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("With this instruction a set of elements can be added a program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("These elements can be either numbers or strings, they can be accessed")
  SoftwareHelp_L("one by one using the READ instruction and are always separated by")
  SoftwareHelp_L("comma's. Strings are also placed between quotation marks.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 READ A$")
  SoftwareHelp_L("20 PRINT A$")
  SoftwareHelp_L("30 READ A,B")
  SoftwareHelp_L("40 PRINT A")
  SoftwareHelp_L("50 PRINT B")
  SoftwareHelp_L("60 DATA " + Chr(34) + "TEST" + Chr(34) + ",10,20")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("READ,")
  SoftwareHelp_L("RESTORE")
  SoftwareHelp_Commit("DATA", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEF FN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEF FN <functionname>[(<arguments>)]=<function definition>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("With this instruction one can create his own functions.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DEF FN TEST$(E)=" + Chr(34) + "And the character is: " + Chr(34) + "+CHR$(E)")
  SoftwareHelp_L("20 PRINT FN TEST$(65)")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L(Chr(34) + "And the character is: A" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DEF FN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEFUSR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEFUSR[<number>] = <address>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Specifies the starting address of a machine-language program,")
  SoftwareHelp_L("the program can be executed by using the USR function.")
  SoftwareHelp_L("number can be 0-9, if no number is specified 0 is assumed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF USR1=&H156:A=USR1(0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("USR,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("POKE,")
  SoftwareHelp_L("VARPTR")
  SoftwareHelp_Commit("DEFUSR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEFDBL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEFDBL <letter>[-<lastletter>] [<letter2> [,-<lastletter2>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Defines all variables starting with the specified letter(s) as double-precision variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF DBL A-E")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DEFINT,")
  SoftwareHelp_L("DEFSNG,")
  SoftwareHelp_L("DEFSTR,")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DEFDBL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEFINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEFINT <letter>[-<lastletter>] [<letter2> [,-<lastletter2>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Defines all variables starting with the specified letter(s) as integer variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF INT G")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DEFDBL,")
  SoftwareHelp_L("DEFSNG,")
  SoftwareHelp_L("DEFSTR,")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DEFINT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEFSNG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEFSNG <letter>[-<lastletter>] [<letter2> [,-<lastletter2>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Defines all variables starting with the specified letter(s) as single-precision variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF SGN A")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DEFDBL,")
  SoftwareHelp_L("DEFINT,")
  SoftwareHelp_L("DEFSTR,")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DEFSNG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DEFSTR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DEFSTR <letter>[-<lastletter>] [<letter2> [,-<lastletter2>]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Defines all variables starting with the specified letter(s) as string variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF STR A")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DEFDBL,")
  SoftwareHelp_L("DEFINT,")
  SoftwareHelp_L("DEFSNG,")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DEFSTR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DELETE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DELETE <line> [-<line2>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Deletes program-lines, if this command is executed")
  SoftwareHelp_L("within a program the program will terminate after this command.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DELETE 10-40")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("MERGE,")
  SoftwareHelp_L("RENUM")
  SoftwareHelp_Commit("DELETE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DIM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DIM <array-name>(<maximun index>)[,<array-name>...]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Reserves memory for the specified variables and intitializes the array.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If if an array is referred to when not first created with a DIM instruction,")
  SoftwareHelp_L("a maximum index of 10 is assumed. The first index is always 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DIM M(25)")
  SoftwareHelp_L("20 FOR A=0 TO 25:M(A)=3*A:NEXT")
  SoftwareHelp_L("30 FOR A=0 TO 25")
  SoftwareHelp_L("40 PRINT " + Chr(34) + "3 times " + Chr(34) + ";A;" + Chr(34) + " is " + Chr(34) + ";M(A)")
  SoftwareHelp_L("50 NEXT A")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("DIM", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DRAW")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DRAW " + Chr(34) + "<string>" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("With this function strait lines can easily be drawn by using simple codes.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The following codes can be used:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Code | Function")
  SoftwareHelp_L("S | Scale")
  SoftwareHelp_L("Ax | Rotates the coordinate system in steps of 90 degrees. x can be 0-3.")
  SoftwareHelp_L("Cxx | Active drawing color, xx can be 0-15.")
  SoftwareHelp_L("Mqq,zz | Move, draws a line from the last known coordinates (x,y) to (x+qq,y+zz) qq en zz can also be negative.")
  SoftwareHelp_L("BMqq,zz | Blank move, moves the (x,y) coordinates without ectually drawing a line.")
  SoftwareHelp_L("Uxx | Up, draws a line xx pixels up.")
  SoftwareHelp_L("Dxx | Down, draws a line xx pixels down")
  SoftwareHelp_L("Rxx | Right, draws a line xx pixels to the right.")
  SoftwareHelp_L("Lxx | Left, draws a line xx pixels to the left.")
  SoftwareHelp_L("Exx | Draws a line xx pixels up-right.")
  SoftwareHelp_L("Fxx | Draws a line xx pixels down-right.")
  SoftwareHelp_L("Gxx | Draws a line xx pixels up-left.")
  SoftwareHelp_L("Hxx | Draws a line xx pixels down-left.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Variables can also be used within draw-instructions, the '=' symbol can be used to allow interger-variables. If a string-variable is used a X should be prefixed and all variables should be closed by a ';'.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 5")
  SoftwareHelp_L("20 A$=" + Chr(34) + "C15BM50,50" + Chr(34))
  SoftwareHelp_L("30 S=50")
  SoftwareHelp_L("40 DRAW " + Chr(34) + "XA$;D=B;R=B;U=B;L=B;" + Chr(34))
  SoftwareHelp_L("50 A$=INPUT$(1)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("DRAW", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## END")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Terminates a programs execution. When the interpreter reaches the last line of the program,")
  SoftwareHelp_L("it is automaticly terminated, END is not necessary there.")
  SoftwareHelp_L("After END a CONT instruction can continue the program execution on the next line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR A=1 TO 10")
  SoftwareHelp_L("20 PRINT A")
  SoftwareHelp_L("20 IF A=5 THEN END")
  SoftwareHelp_L("30 NEXT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("STOP,")
  SoftwareHelp_L("RUN,")
  SoftwareHelp_L("CONT")
  SoftwareHelp_Commit("END", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## EOF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("EOF(<filenumber>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("EOF is zero while the end of the open file in not reached.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 IF EOF(2) THEN CLOSE#2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("CLOSE,")
  SoftwareHelp_L("LOC,")
  SoftwareHelp_L("LOF")
  SoftwareHelp_Commit("EOF", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## EQV")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("number1 EQV number2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Logical equivalence.")
  SoftwareHelp_L("0 EQV 0 | = | 1")
  SoftwareHelp_L("0 EQV 1 | = | 0")
  SoftwareHelp_L("1 EQV 0 | = | 0")
  SoftwareHelp_L("1 EQV 1 | = | 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("EQV", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ERASE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ERASE <array-name>[,<array-name>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("ERASE frees up the memory used by array's previously allocated by a DIM instruction.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DIM A(100),X$(60)")
  SoftwareHelp_L("...")
  SoftwareHelp_L("500 ERASE A,X$")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLEAR,")
  SoftwareHelp_L("DIM")
  SoftwareHelp_Commit("ERASE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ERL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ERL")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the line-number where the last error occured.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See ERR")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ERR,")
  SoftwareHelp_L("ERROR,")
  SoftwareHelp_L("ON ERROR GOTO,")
  SoftwareHelp_L("RESUME")
  SoftwareHelp_Commit("ERL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ERR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ERR")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the number of the last error that occurred. The error-number can be found in the error-table.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 ON ERROR GOTO 50")
  SoftwareHelp_L("20 A=25: PRINT A")
  SoftwareHelp_L("30 B=A/0")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("50 PRINT " + Chr(34) + "Error number " + Chr(34) + ";ERR;" + Chr(34) + " occured in line " + Chr(34) + ";ERL")
  SoftwareHelp_L("60 RESUME NEXT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ERL,")
  SoftwareHelp_L("ERROR,")
  SoftwareHelp_L("ON ERROR GOTO,")
  SoftwareHelp_L("RESUME")
  SoftwareHelp_Commit("ERR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ERROR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ERROR <number>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Displays the error-message that belongs to the error-number.")
  SoftwareHelp_L("The error-number can be found in the error-table.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("ERROR 64")
  SoftwareHelp_L("File still open")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ERR,")
  SoftwareHelp_L("ERL,")
  SoftwareHelp_L("ON ERROR GOTO,")
  SoftwareHelp_L("RESUME")
  SoftwareHelp_Commit("ERROR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## EXP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("EXP(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calculates the power of e for number (base is e=2.718281884588).")
  SoftwareHelp_L("")
  SoftwareHelp_L("number must be less or equal 145.06286058562.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT EXP(10)")
  SoftwareHelp_L(" 22026.4657948")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LOG")
  SoftwareHelp_Commit("EXP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FIX")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FIX(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Return the integer part of number. This function is identical to")
  SoftwareHelp_L("")
  SoftwareHelp_L("SGN(<number>)*INT(ABS(<number>)).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The difference between " + Chr(34) + "FIX" + Chr(34) + " and " + Chr(34) + "INT" + Chr(34) + " is that negative values are not rounded to the")
  SoftwareHelp_L("next lower value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT FIX(1.7)")
  SoftwareHelp_L(" 1")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INT,")
  SoftwareHelp_L("SGN,")
  SoftwareHelp_L("ABS")
  SoftwareHelp_Commit("FIX", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FOR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FOR <variable>=<number> TO <number2> [STEP <number3>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("NEXT [<variable> [,<variable2>][, ...]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This instruction forms a program loop that looks like:")
  SoftwareHelp_L("")
  SoftwareHelp_L("FOR <variable>=X TO Y [STEP Z]")
  SoftwareHelp_L("")
  SoftwareHelp_L(".")
  SoftwareHelp_L("")
  SoftwareHelp_L(".   Instructions")
  SoftwareHelp_L("")
  SoftwareHelp_L(".")
  SoftwareHelp_L("")
  SoftwareHelp_L("NEXT <variable>")
  SoftwareHelp_L("")
  SoftwareHelp_L("The instructions between FOR and NEXT are executed with values from")
  SoftwareHelp_L("X to Y. If STEP Z is not specified a step-width")
  SoftwareHelp_L("of 1 is used. Within a loop another loop can be implemented,")
  SoftwareHelp_L("so loops can be nested.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Every loop will be executed at least once because the termination-condition")
  SoftwareHelp_L("is checked in the NEXT statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 4")
  SoftwareHelp_L("20 PRINT I;")
  SoftwareHelp_L("30 NEXT:PRINT")
  SoftwareHelp_L("40 FOR I=0 TO 5 STEP 5")
  SoftwareHelp_L("50 FOR J=0 TO I+2")
  SoftwareHelp_L("60 PRINT J")
  SoftwareHelp_L("70 NEXT J,I:PRINT")
  SoftwareHelp_L("80 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL PAUSE")
  SoftwareHelp_Commit("FOR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FRE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FRE(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("FRE(string)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("FRE(number) returns the free memory available to Basic programs, where ")
  SoftwareHelp_L("FRE(string) returns the free memory for strings.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("NEW")
  SoftwareHelp_L("PRINT FRE(0)")
  SoftwareHelp_L("28815")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("PRINT FRE(" + Chr(34) + Chr(34) + ")")
  SoftwareHelp_L("200")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLEAR,")
  SoftwareHelp_L("ERASE,")
  SoftwareHelp_L("DIM,")
  SoftwareHelp_L("MAXFILES")
  SoftwareHelp_Commit("FRE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("GOSUB line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement jumps to a subroutine.")
  SoftwareHelp_L("The program can return from this routine by using the RETURN statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 PRINT " + Chr(34) + "Hello" + Chr(34))
  SoftwareHelp_L("110 GOSUB 200")
  SoftwareHelp_L("120 GOSUB 300")
  SoftwareHelp_L("130 END")
  SoftwareHelp_L("200 PRINT " + Chr(34) + "Here am I" + Chr(34))
  SoftwareHelp_L("210 RETURN")
  SoftwareHelp_L("300 PRINT " + Chr(34) + "End" + Chr(34))
  SoftwareHelp_L("310 RETURN")
  SoftwareHelp_L("")
  SoftwareHelp_L("Outputs the following text:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Hello")
  SoftwareHelp_L("Here am I")
  SoftwareHelp_L("End")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RETURN,")
  SoftwareHelp_L("ON GOSUB,")
  SoftwareHelp_L("GOTO")
  SoftwareHelp_Commit("GOSUB", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## GOTO")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("GOTO line")
  SoftwareHelp_L("")
  SoftwareHelp_L("GO TO line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Unconditional jump-statement. The program continues at the specified line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("-")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON GOTO,")
  SoftwareHelp_L("GOSUB")
  SoftwareHelp_Commit("GOTO", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## HEX$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("HEX$(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts the specified number into a hexadecimal value.")
  SoftwareHelp_L("A hexadecimal-number consists of digits 0 to 9 and the characters A to F.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT HEX$(1023)")
  SoftwareHelp_L("3FF")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BIN$,")
  SoftwareHelp_L("OCT$,")
  SoftwareHelp_L("STR$,")
  SoftwareHelp_L("VAL")
  SoftwareHelp_Commit("HEX$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## IF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("IF expression THEN <StatementsA> [ELSE <StatementsB>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("If the condition is met StatementsA are executed.")
  SoftwareHelp_L("After this the program continues with the next program line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the condition is not met then StatementsB after the ELSE")
  SoftwareHelp_L("are executed. After this the program continues with the next program line too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 INPUT " + Chr(34) + "A=" + Chr(34) + ";A")
  SoftwareHelp_L("110 IF A>=0 THEN PRINT " + Chr(34) + "positive" + Chr(34) + " ELSE PRINT " + Chr(34) + "negative" + Chr(34))
  SoftwareHelp_L("120 INPUT " + Chr(34) + "Again ( /N)" + Chr(34) + ";A$")
  SoftwareHelp_L("130 IF A$<>" + Chr(34) + "N" + Chr(34) + " GOTO 100 ELSE END")
  SoftwareHelp_L("")
  SoftwareHelp_L("Is the condition A>=0 in line 110 met then " + Chr(34) + "positive" + Chr(34) + " is printed.")
  SoftwareHelp_L("As line 130 indicates the THEN can be replaced by GOTO.")
  SoftwareHelp_L("On the other hand the GOTO after THEN is not necessary.")
  SoftwareHelp_L("Line 130 can also look like:")
  SoftwareHelp_L("")
  SoftwareHelp_L("130 IF A$<>" + Chr(34) + "N" + Chr(34) + " THEN 100 ELSE END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GOTO")
  SoftwareHelp_Commit("IF", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## IMP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("number1 IMP number2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Logical implication.")
  SoftwareHelp_L("0 IMP 0 | = | 1")
  SoftwareHelp_L("0 IMP 1 | = | 1")
  SoftwareHelp_L("1 IMP 0 | = | 0")
  SoftwareHelp_L("1 IMP 1 | = | 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("IMP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INKEY$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INKEY$")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("The function INKEY$ scans the keyboard for a pushed key.")
  SoftwareHelp_L("The returned string is empty if no key is pressed or")
  SoftwareHelp_L("the ASCII character of the pressed key.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Please press any key" + Chr(34))
  SoftwareHelp_L("20 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 20")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "Continuing..." + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("If the key-input should result in a more detailed evaluation")
  SoftwareHelp_L("it should be stored in a string-variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Please press any key" + Chr(34))
  SoftwareHelp_L("20 A$=INKEY$:IF A$=" + Chr(34) + Chr(34) + " THEN 20")
  SoftwareHelp_L("30 IF ASC(A$)=13 THEN 10")
  SoftwareHelp_L("")
  SoftwareHelp_L("If ENTER/RETURN is pressed in line 20 the program restarts in line 10.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INPUT$,")
  SoftwareHelp_L("STICK,")
  SoftwareHelp_L("STRIG")
  SoftwareHelp_Commit("INKEY$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INP(port)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Reads the content of the specified input-port (0-255).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The statement " + Chr(34) + "OUT" + Chr(34) + " can be used to write a byte to an output-port.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A=INP(&HA8)")
  SoftwareHelp_L("20 A$=" + Chr(34) + "00000000" + Chr(34) + "+BIN$(A)")
  SoftwareHelp_L("30 PRINT RIGHT$(A$,8)")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OUT,")
  SoftwareHelp_L("WAIT")
  SoftwareHelp_Commit("INP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INPUT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INPUT [" + Chr(34) + "prompt" + Chr(34) + ";] variable [,variable2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("INPUT#channel, variable [,variable2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Retrieves a number or string from the keyboard and assignes it to a variable.")
  SoftwareHelp_L("The input is finished with the Return/Enter key.")
  SoftwareHelp_L("A prompt can be printed before the input starts.")
  SoftwareHelp_L("A " + Chr(34) + "?" + Chr(34) + " sign is also printed to indicate the input.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The INPUT# statement reads data from a sequential file opened as #channel")
  SoftwareHelp_L("and assigns it to the listed variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Special: If a string already has a value and the new input is empty")
  SoftwareHelp_L("(only Return/Enter pushed) then the old value remains unchanged.")
  SoftwareHelp_L("In other Basic dialects the value will be cleared. This is also")
  SoftwareHelp_L("valid for the input of numbers (not only strings).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 INPUT " + Chr(34) + "Length of the page" + Chr(34) + ";L")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LINE INPUT,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("INPUT$,")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("PRINT[#]")
  SoftwareHelp_Commit("INPUT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INPUT$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INPUT$(number [#channel])")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This function reads number characters from the keyboard")
  SoftwareHelp_L("or a file opened as #channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The INPUT$ function can also recognize control-sequences,")
  SoftwareHelp_L("which cannot be entered using the INPUT statement. Therefore")
  SoftwareHelp_L("INPUT$ is useful for data-transfer from other machines.")
  SoftwareHelp_L("In such transmissions all characters might be important.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "C continues, E ends the program" + Chr(34))
  SoftwareHelp_L("20 A$=INPUT$(1)")
  SoftwareHelp_L("30 IF A$=" + Chr(34) + "E" + Chr(34) + " THEN END")
  SoftwareHelp_L("40 IF A$=" + Chr(34) + "C" + Chr(34) + " THEN GOTO 60")
  SoftwareHelp_L("50 GOTO 10")
  SoftwareHelp_L("60 REM code continues here")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INKEY$")
  SoftwareHelp_Commit("INPUT$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INSTR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INSTR([position,] string, substring)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This function looks for the 1st occurence of the substring in the specified string")
  SoftwareHelp_L("and returns the start-position. In addition a position (0-255) can be specified,")
  SoftwareHelp_L("which indicates where the search should start.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the substring is not found, or position is larger as the length of the string")
  SoftwareHelp_L("or the string is empty then INSTR returns 0. If substring is empty INSTR returns 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + "Merry Christmas" + Chr(34))
  SoftwareHelp_L("20 PRINT INSTR(A$, " + Chr(34) + "ist" + Chr(34) + ")")
  SoftwareHelp_L("30 PRINT INSTR(A$, " + Chr(34) + "IST" + Chr(34) + ")")
  SoftwareHelp_L("40 PRINT INSTR(5, A$, " + Chr(34) + "r" + Chr(34) + ")")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("10")
  SoftwareHelp_L("0")
  SoftwareHelp_L("9")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LEN,")
  SoftwareHelp_L("MID$")
  SoftwareHelp_Commit("INSTR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INT(<number>)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the integer-part of <number>.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A=-2.7")
  SoftwareHelp_L("20 PRINT INT(A)")
  SoftwareHelp_L("30 A=2.7")
  SoftwareHelp_L("40 PRINT INT(A)")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("-2")
  SoftwareHelp_L("2")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FIX,")
  SoftwareHelp_L("SGN,")
  SoftwareHelp_L("ABS")
  SoftwareHelp_Commit("INT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## INTERVAL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("INTERVAL ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("INTERVAL OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("INTERVAL STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("After " + Chr(34) + "INTERVAL ON" + Chr(34) + " the program checks if a specified time-interval")
  SoftwareHelp_L("has been elapsed. If so MSX-Basic calls the subroutine that was")
  SoftwareHelp_L("specified with the " + Chr(34) + "ON INTERVAL GOSUB" + Chr(34) + " statement.")
  SoftwareHelp_L("After the " + Chr(34) + "INTERVAL OFF" + Chr(34) + " statement no checking is performed. After")
  SoftwareHelp_L(Chr(34) + "INTERVAL STOP" + Chr(34) + " MSX-Basic still checks if the interval has been")
  SoftwareHelp_L("elapsed, but calls the subroutine only after the next call of")
  SoftwareHelp_L(Chr(34) + "INTERVAL ON" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: ON INTERVAL GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON INTERVAL GOSUB")
  SoftwareHelp_Commit("INTERVAL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## KEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("KEY ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("KEY OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L(Chr(34) + "KEY ON" + Chr(34) + " enables and " + Chr(34) + "KEY OFF" + Chr(34) + " disables the display of the function-key assignment in line 25")
  SoftwareHelp_L("(only in textmodes 1 and 2).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("KEY OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("KEY (assignment),")
  SoftwareHelp_L("KEY LIST")
  SoftwareHelp_Commit("KEY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## KEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("KEY number, string")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Associates the function key identified by number (1-10) with a string.")
  SoftwareHelp_L("The string can have up to a maximum of 15 characters.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + "CLOAD" + Chr(34))
  SoftwareHelp_L("20 KEY 1,A$+CHR$(13)")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("KEY LIST,")
  SoftwareHelp_L("KEY ON/OFF")
  SoftwareHelp_Commit("KEY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## KEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("KEY(number) ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("KEY(number) OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("KEY(number) STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("number specifies a function-key number (1-10).")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "KEY(number) ON" + Chr(34) + " statement MSX-Basic checks if the specified")
  SoftwareHelp_L("function-key was pressed. If so MSX-Basic calls the subroutine, that was")
  SoftwareHelp_L("defined by the " + Chr(34) + "ON KEY GOSUB" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the statement " + Chr(34) + "KEY(number) STOP" + Chr(34) + " MSX-Basic checks if the specified")
  SoftwareHelp_L("function-key was pressed, but does not call the defined subroutine until the")
  SoftwareHelp_L("next invocation " + Chr(34) + "KEY(number) ON" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: ON KEY GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON KEY GOSUB")
  SoftwareHelp_Commit("KEY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## KEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("KEY LIST")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Lists the assignment of the function-keys (F1-F10).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("KEY LIST")
  SoftwareHelp_L("color")
  SoftwareHelp_L("auto")
  SoftwareHelp_L("goto")
  SoftwareHelp_L("list")
  SoftwareHelp_L("run")
  SoftwareHelp_L("color 15,4,4")
  SoftwareHelp_L("cload" + Chr(34))
  SoftwareHelp_L("cont")
  SoftwareHelp_L("list.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("KEY (assignment),")
  SoftwareHelp_L("KEY ON/OFF")
  SoftwareHelp_Commit("KEY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LEFT$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LEFT$(string, number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the first number (0-255) characters from the specified string.")
  SoftwareHelp_L("If number is larger than the string the whole string is returned.")
  SoftwareHelp_L("If number is 0 an empty string is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + "MSX-Computer" + Chr(34))
  SoftwareHelp_L("20 FOR I=1 TO LEN(A$)")
  SoftwareHelp_L("30 PRINT LEFT$(A$,I)")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("M")
  SoftwareHelp_L("MS")
  SoftwareHelp_L("MSX")
  SoftwareHelp_L("MSX-")
  SoftwareHelp_L("MSX-C")
  SoftwareHelp_L("MSX-Co")
  SoftwareHelp_L("MSX-Com")
  SoftwareHelp_L("MSX-Comp")
  SoftwareHelp_L("MSX-Compu")
  SoftwareHelp_L("MSX-Comput")
  SoftwareHelp_L("MSX-Compute")
  SoftwareHelp_L("MSX-Computer")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("MID$,")
  SoftwareHelp_L("RIGHT$")
  SoftwareHelp_Commit("LEFT$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LEN(string)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the number of characters in the string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT LEN(" + Chr(34) + "BASIC" + Chr(34) + ")")
  SoftwareHelp_L("5")
  SoftwareHelp_Commit("LEN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("[LET] variable=value")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Assigns a value to the specified variable.")
  SoftwareHelp_L("The LET statement itself is optional and can be skipped.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LET A=10")
  SoftwareHelp_L("LET B$=" + Chr(34) + "Hello" + Chr(34))
  SoftwareHelp_L("C=20")
  SoftwareHelp_L("D$=" + Chr(34) + "World" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SWAP")
  SoftwareHelp_Commit("LET", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LINE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LINE[[STEP](x1,y1)]-[STEP](x2,y2)[,color [,B[F]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Draws a line from x1,y1 to x2,y2, which can be absolute or relative")
  SoftwareHelp_L("(" + Chr(34) + "STEP" + Chr(34) + " keyword) coordinates.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the word " + Chr(34) + "STEP" + Chr(34) + " is used x1 and y1 are interpreted relative to the")
  SoftwareHelp_L("current cursor-position. In this case the values can also be negative.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x2 and y2 are the coordinates of the line-endpoint. If the word " + Chr(34) + "STEP" + Chr(34) + " is")
  SoftwareHelp_L("specified these are also relative to the cursor-position.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color is the line-color to be used for drawing")
  SoftwareHelp_L("(see color-table).")
  SoftwareHelp_L("If color is not specified the current foreground-color is used.")
  SoftwareHelp_L("If " + Chr(34) + "B" + Chr(34) + " is specified a rectangle is drawn, where the current line is used as diagonal.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If " + Chr(34) + "F" + Chr(34) + " after " + Chr(34) + "B" + Chr(34) + " is specified the rectangle is filled with the given color.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2")
  SoftwareHelp_L("20 FOR I=0 TO 95 STEP 2")
  SoftwareHelp_L("30 LINE (128-I,95-I)-(128+I,95+I),1,B")
  SoftwareHelp_L("40 NEXT")
  SoftwareHelp_L("50 FOR K=0 TO 2000:NEXT")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("LINE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LINE INPUT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LINE INPUT [" + Chr(34) + "prompt" + Chr(34) + ";] stringvariable")
  SoftwareHelp_L("")
  SoftwareHelp_L("LINE INPUT #channel, stringvariable")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Retrieves a whole line, up to 254 characters, from the keyboard")
  SoftwareHelp_L("into the specified stringvariable.")
  SoftwareHelp_L("A given prompt (if any) is printed first.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The LINE INPUT# statement is used to read a complete record")
  SoftwareHelp_L("from a sequential file (opened as #channel), which")
  SoftwareHelp_L("must have been opened for " + Chr(34) + "INPUT" + Chr(34) + ". The " + Chr(34) + "LINE INPUT" + Chr(34) + " statement")
  SoftwareHelp_L("is often used to read a MSX-Basic program as datafile, if it")
  SoftwareHelp_L("was saved (by using the " + Chr(34) + "SAVE" + Chr(34) + " statement) in ASCII format.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 LINE INPUT " + Chr(34) + "TEXT" + Chr(34) + ";A$")
  SoftwareHelp_L("20 PRINT A$")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("TEXT")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INPUT,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("LINE INPUT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LIST")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LIST [[startline] [-[endline]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Lists a whole or part of the Basic-program from memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If only startline is given this line is listed only.")
  SoftwareHelp_L("If startline and endline are specified all lines within this range are listed.")
  SoftwareHelp_L("If only endline is given all lines from the beginning to this line are listed.")
  SoftwareHelp_L("If neither startline nor endline are given the whole program is listed.")
  SoftwareHelp_L("If startline and " + Chr(34) + "-" + Chr(34) + " are given then this line and all followings are listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LIST 10")
  SoftwareHelp_L("")
  SoftwareHelp_L("Program line 10 is listed only.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LIST 50-100")
  SoftwareHelp_L("")
  SoftwareHelp_L("Program lines 50 to 100 are listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LIST -100")
  SoftwareHelp_L("")
  SoftwareHelp_L("All program lines from 0 to 100 are listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LIST")
  SoftwareHelp_L("")
  SoftwareHelp_L("All program lines are listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LIST .")
  SoftwareHelp_L("")
  SoftwareHelp_L("The last maintained line is listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LLIST")
  SoftwareHelp_Commit("LIST", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LLIST")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LLIST [[startline] [-[endline]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("A complete program or part of it is printed.")
  SoftwareHelp_L("The statement works in the same way as " + Chr(34) + "LIST" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See LIST")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LIST")
  SoftwareHelp_Commit("LLIST", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LOAD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LOAD " + Chr(34) + "devicename:filename" + Chr(34) + " [,R]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Loads a program from a device into the computer-memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Devicenames can be, e.g.: CAS:, A: or B:")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "SAVE" + Chr(34) + " statement must have been used to store the program in ASCII format (on tape or disk).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The filename is an alphanumerical constant, that has been specified while the program was")
  SoftwareHelp_L("stored using the " + Chr(34) + "SAVE" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Disk-Basic: if " + Chr(34) + ",R" + Chr(34) + " is specified the programm is started immediately,")
  SoftwareHelp_L("after the load-operation is finished.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LOAD " + Chr(34) + "CAS:DEMO" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "LOAD CAS:" + Chr(34) + " can only be used if a tape-recorder is connected to the MSX-Computer.")
  SoftwareHelp_L("")
  SoftwareHelp_L("LOAD " + Chr(34) + "A:DEMO" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "LOAD A:" + Chr(34) + " or " + Chr(34) + "LOAD B:" + Chr(34) + " can only be used if a disk-drive is connected to the MSX-Computer.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("CALL MFILES,")
  SoftwareHelp_L("CLOAD,")
  SoftwareHelp_L("FILES,")
  SoftwareHelp_L("MERGE,")
  SoftwareHelp_L("RUN,")
  SoftwareHelp_L("SAVE")
  SoftwareHelp_Commit("LOAD", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LOCATE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LOCATE line, column [,cursoronoff]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Places the cursor to the position specified by line and column,")
  SoftwareHelp_L("where 0,0 is the upper left corner.")
  SoftwareHelp_L("Option cursoronoff toggles the cursor on/off. Usually the cursor is")
  SoftwareHelp_L("only visible during input, but")
  SoftwareHelp_L("")
  SoftwareHelp_L("  LOCATE,,1")
  SoftwareHelp_L("")
  SoftwareHelp_L("can enable it at any time.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 KEY OFF")
  SoftwareHelp_L("20 LOCATE 1,23")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "A" + Chr(34))
  SoftwareHelp_L("40 LOCATE,,1")
  SoftwareHelp_L("50 GOTO 50")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CRSLIN,")
  SoftwareHelp_L("POS,")
  SoftwareHelp_L("PRINT")
  SoftwareHelp_Commit("LOCATE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LOG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LOG(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calculates the natural logarithm (base e=2.718281884588).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT LOG(10)")
  SoftwareHelp_L(" 2.302585092994")
  SoftwareHelp_L("PRINT LOG(100)/LOG(10)")
  SoftwareHelp_L(" 2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("EXP")
  SoftwareHelp_Commit("LOG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LPOS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LPOS(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the position in the printer-buffer. The result is not necessarily")
  SoftwareHelp_L("the physical position of the printhead.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 1000")
  SoftwareHelp_L("20 LPRINT " + Chr(34) + "Hello" + Chr(34) + ";")
  SoftwareHelp_L("30 IF LPOS(0)>38 THEN LPRINT CHR$(13)")
  SoftwareHelp_L("40 NEXT")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LPRINT")
  SoftwareHelp_Commit("LPOS", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LPRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LPRINT [USING " + Chr(34) + "format" + Chr(34) + ";] [value [,value2 [,...]]] [;]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints information on the printer. The statement works in the same way as " + Chr(34) + "PRINT" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See PRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("TAB,")
  SoftwareHelp_L("SPC,")
  SoftwareHelp_L("LPOS")
  SoftwareHelp_Commit("LPRINT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MAXFILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MAXFILES=number")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Specifies the maximum number of files, that can be simultaneously open.")
  SoftwareHelp_L("number can be in range from 0-15.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Technote: the MAXFILES statement is built by 2 basic tokens (MAX FILES)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 MAXFILES=2")
  SoftwareHelp_L("20 OPEN " + Chr(34) + "CAS:DEMO" + Chr(34) + " FOR INPUT AS #1")
  SoftwareHelp_L("30 OPEN " + Chr(34) + "LPT:" + Chr(34) + " FOR OUTPUT AS #2")
  SoftwareHelp_L("40 INPUT #1,A$")
  SoftwareHelp_L("50 PRINT #2,A$")
  SoftwareHelp_L("60 CLOSE")
  SoftwareHelp_L("70 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLEAR,")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("MAXFILES", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MERGE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MERGE " + Chr(34) + "[device:]filename" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Merges a program in memory with another from tape or disk.")
  SoftwareHelp_L("The lines to be merged must be saved in ASCII by using the " + Chr(34) + "SAVE" + Chr(34) + " statement.")
  SoftwareHelp_L("If some new lines have the same numbers as in memory the")
  SoftwareHelp_L("already existing lines will be replaced.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("MERGE " + Chr(34) + "CAS:DEMO" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("SAVE")
  SoftwareHelp_Commit("MERGE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MID$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MID$( string, position [,characters])")
  SoftwareHelp_L("")
  SoftwareHelp_L("MID$( string, position [,characters])=string2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("(1) An alphanumerical expression consisting of characters number of characters")
  SoftwareHelp_L("(or up to the string-end) beginning by position will be returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If characters is not specified or there are no more characters to the right")
  SoftwareHelp_L("of position then all remaining characters is returned. If position")
  SoftwareHelp_L("if larger than LEN(string) then an empty string is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("(2) Replaces parts of string by string2.")
  SoftwareHelp_L("Characters in string, beginning on position are replaced by string2.")
  SoftwareHelp_L("If characters is not specified all characters of string2 are used,")
  SoftwareHelp_L("as long as enabled by the length of string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Disk-Basic: in addition to LSET and RSET also MID$ can be used")
  SoftwareHelp_L("to format strings, declared in the FIELD statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + "Basic MSX Computer" + Chr(34))
  SoftwareHelp_L("20 PRINT MID$(A$,7,3)")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("MSX")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 A$=" + Chr(34) + "ABCDEFG" + Chr(34))
  SoftwareHelp_L("20 PRINT A$")
  SoftwareHelp_L("30 MID$(A$,4)=" + Chr(34) + "XYZ" + Chr(34))
  SoftwareHelp_L("40 PRINT A$")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("ABCDEFG")
  SoftwareHelp_L("ABCXYZG")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LEFT$,")
  SoftwareHelp_L("RIGHT$,")
  SoftwareHelp_L("INSTR,")
  SoftwareHelp_L("LSET,")
  SoftwareHelp_L("RSET")
  SoftwareHelp_Commit("MID$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MOD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("number MOD number2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calculates the dividend of an integer division.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT 5 MOD 3")
  SoftwareHelp_L(" 2")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("PRINT 5 MOD 5")
  SoftwareHelp_L(" 0")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("MOD", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MOTOR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MOTOR ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("MOTOR OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Turns the motor of the tape-recorder on or off.")
  SoftwareHelp_L("If " + Chr(34) + "ON" + Chr(34) + " or " + Chr(34) + "OFF" + Chr(34) + " is specified the motor is toggled. This means that a")
  SoftwareHelp_L("switched on motor is turned off and a switched off motor is turned on.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Setting " + Chr(34) + "ON" + Chr(34) + " turns the motor on, setting " + Chr(34) + "OFF" + Chr(34) + " turns the motor off.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: MOTOR is no longer supported and will generate a " + Chr(34) + "syntax error" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 10")
  SoftwareHelp_L("20 MOTOR")
  SoftwareHelp_L("30 FOR J=1 TO 500:NEXT J")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLOAD,")
  SoftwareHelp_L("CLOAD?,")
  SoftwareHelp_L("CSAVE")
  SoftwareHelp_Commit("MOTOR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## NEW")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("NEW")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Erases the Basic program in memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "NEW" + Chr(34) + " is usually used to delete the computer memory")
  SoftwareHelp_L("before starting with a new Basic program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("NEW")
  SoftwareHelp_Commit("NEW", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## NOT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("NOT expression")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Logical complement.")
  SoftwareHelp_L("NOT 0 | = | 1")
  SoftwareHelp_L("NOT 1 | = | 0")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT HEX$(NOT &H7FFF)")
  SoftwareHelp_L("8000")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("100 INPUT " + Chr(34) + "Y/N" + Chr(34) + ";A$")
  SoftwareHelp_L("120 IF NOT A$=" + Chr(34) + "N" + Chr(34) + " THEN PRINT " + Chr(34) + "Yes" + Chr(34) + " ELSE PRINT " + Chr(34) + "No" + Chr(34))
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("(Y/N)?N")
  SoftwareHelp_L("No")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("NOT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## OCT$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("OCT$(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts the specified number into an octal value. An octal number consists of")
  SoftwareHelp_L("the digits 0 to 7.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PRINT OCT$(1023)")
  SoftwareHelp_L("1777")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BIN$,")
  SoftwareHelp_L("HEX$,")
  SoftwareHelp_L("STR$,")
  SoftwareHelp_L("VAL")
  SoftwareHelp_Commit("OCT$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON ERROR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON ERROR GOTO line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("line is the 1st line of an error-handling routine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If " + Chr(34) + "ON ERROR GOTO" + Chr(34) + " statement is set MSX-Basic jumps to the specified line")
  SoftwareHelp_L("of the error-handler routine, whenever an error occurs.")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "ERR" + Chr(34) + " returns the corresponding errorcode and " + Chr(34) + "ERL" + Chr(34) + " returns the line-number")
  SoftwareHelp_L("where the error occured.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the statement " + Chr(34) + "ON ERROR GOTO 0" + Chr(34) + " is set MSX-Basic does not jump to a")
  SoftwareHelp_L("specific line. In this case the normal error-handler takes place,")
  SoftwareHelp_L("stops the program and prints the error-message. Its recommended to use")
  SoftwareHelp_L(Chr(34) + "ON ERROR GOTO 0" + Chr(34) + " for errors, which are not handled by another error-handling")
  SoftwareHelp_L("routine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If MSX-Basic recognizes an error while the error-handling routine is")
  SoftwareHelp_L("executed the common error is displayed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "RESUME" + Chr(34) + " statement returns from the error-handling routine to the")
  SoftwareHelp_L("program location where the error occured.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See ERR")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RESUME,")
  SoftwareHelp_L("ERL,")
  SoftwareHelp_L("ERROR,")
  SoftwareHelp_L("ERR")
  SoftwareHelp_Commit("ON ERROR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON value GOSUB line [,line2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("line1 respectively line2 are the 1st program-line of a subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The value determines, which subroutine MSX-Basic executes.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If, for example value is 3 a jump to the 3rd subroutine is performed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If value is no integer it will be rounded down.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The value cannot be greater than 255 or negative.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 3")
  SoftwareHelp_L("20 ON I GOSUB 50,70,90")
  SoftwareHelp_L("30 NEXT I")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("50 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "subroutine line 50" + Chr(34))
  SoftwareHelp_L("60 RETURN")
  SoftwareHelp_L("70 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "subroutine line 70" + Chr(34))
  SoftwareHelp_L("80 RETURN")
  SoftwareHelp_L("90 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "subroutine line 90" + Chr(34))
  SoftwareHelp_L("100 RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("I= 1 subroutine line 50")
  SoftwareHelp_L("I= 2 subroutine line 70")
  SoftwareHelp_L("I= 3 subroutine line 90")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GOSUB")
  SoftwareHelp_Commit("ON GOSUB", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON GOTO")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON value GOTO line [,line2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("line1 and line2 are program line-numbers.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The value determines to which line number MSX-Basic jumps")
  SoftwareHelp_L("and where the program continues.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If, for example value is 3 a jump to the 3rd routine is performed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If value is no integer it will be rounded down.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The value cannot be greater than 255 or negative. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 3")
  SoftwareHelp_L("20 ON I GOTO 50,70,90")
  SoftwareHelp_L("30 NEXT I")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("50 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "line 50" + Chr(34))
  SoftwareHelp_L("60 GOTO 30")
  SoftwareHelp_L("70 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "line 70" + Chr(34))
  SoftwareHelp_L("80 GOTO 30")
  SoftwareHelp_L("90 PRINT " + Chr(34) + "I=" + Chr(34) + ";I;" + Chr(34) + "line 90" + Chr(34))
  SoftwareHelp_L("100 GOTO 30")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("I= 1 line 50")
  SoftwareHelp_L("I= 2 line 70")
  SoftwareHelp_L("I= 3 line 90")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GOTO")
  SoftwareHelp_Commit("ON GOTO", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON INTERVAL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON INTERVAL=number GOSUB line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calls a subroutine after the specified timeout has been elapsed.")
  SoftwareHelp_L("The timeout is number*1/60 (or number*1/50) seconds.")
  SoftwareHelp_L("After this statement MSX-Basic automatically calls the subroutine")
  SoftwareHelp_L("in line in the number of intervals.")
  SoftwareHelp_L("")
  SoftwareHelp_L("During the processing of an errorhandler MSX-Basic automatically")
  SoftwareHelp_L("performs the " + Chr(34) + "INTERVAL OFF" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 ON INTERVAL=300 GOSUB 60")
  SoftwareHelp_L("20 INTERVAL ON")
  SoftwareHelp_L("30 FOR I=1 TO 10000:NEXT I")
  SoftwareHelp_L("40 INTERVAL OFF")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("60 K=K+6:PRINT K;" + Chr(34) + "seconds" + Chr(34))
  SoftwareHelp_L("70 RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("6 seconds")
  SoftwareHelp_L("12 seconds")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INTERVAL ON/OFF/STOP")
  SoftwareHelp_Commit("ON INTERVAL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON KEY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON KEY GOSUB line [,line2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("line, line2, ... are the first line number of the corresponding subroutine.")
  SoftwareHelp_L("line substitutes the linenumber of the subroutine, which is called after the")
  SoftwareHelp_L("function-key 1 (F1) has been pressed, line2 references F2, and so on...")
  SoftwareHelp_L("")
  SoftwareHelp_L("Before a subroutine can be called the " + Chr(34) + "KEY(number) ON" + Chr(34) + " statement must be executed.")
  SoftwareHelp_L("After doing so MSX-Basic automatically checks if the corresponding function-key was")
  SoftwareHelp_L("pressed and calls the associated subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("During the processing of an errorhandler MSX-Basic automatically performs the " + Chr(34) + "KEY(number) OFF" + Chr(34) + " statement. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 KEY OFF")
  SoftwareHelp_L("20 ON KEY GOSUB 70, 80, 90")
  SoftwareHelp_L("30 KEY(1) ON:KEY(2) ON:KEY(3) ON")
  SoftwareHelp_L("40 GOTO 60")
  SoftwareHelp_L("50 PRINT " + Chr(34) + " pressed" + Chr(34))
  SoftwareHelp_L("60 GOTO 60")
  SoftwareHelp_L("70 PRINT " + Chr(34) + "F1" + Chr(34) + ";:RETURN 50")
  SoftwareHelp_L("80 PRINT " + Chr(34) + "F2" + Chr(34) + ";:RETURN 50")
  SoftwareHelp_L("90 PRINT " + Chr(34) + "F3" + Chr(34) + ";:RETURN 50")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("KEY ON/OFF/STOP")
  SoftwareHelp_Commit("ON KEY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON SPRITE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON SPRITE GOSUB line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calls a subroutine in line if two sprites are colliding.")
  SoftwareHelp_L("line is the first line of the subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The subroutine can only be called after the " + Chr(34) + "SPRITE ON" + Chr(34) + " statement has been executed.")
  SoftwareHelp_L("After this statement MSX-Basic automatically calls this subroutine when two sprites")
  SoftwareHelp_L("are colliding.")
  SoftwareHelp_L("")
  SoftwareHelp_L("During the processing of an errorhandler MSX-Basic automatically performs the")
  SoftwareHelp_L(Chr(34) + "SPRITE OFF" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DATA 60,66,165,129,165,153,66,60")
  SoftwareHelp_L("20 DATA 60,126,219,255,255,219,102,60")
  SoftwareHelp_L("30 A$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("40 FOR I=1 TO 8")
  SoftwareHelp_L("50 READ A:A$=A$+CHR$(A)")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 B$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("80 FOR I=1 TO 8")
  SoftwareHelp_L("90 READ A:B$=B$+CHR$(A)")
  SoftwareHelp_L("100 NEXT I")
  SoftwareHelp_L("110 SCREEN 2,1:COLOR 15,4,1")
  SoftwareHelp_L("120 ON SPRITE GOSUB 210")
  SoftwareHelp_L("130 SPRITE$(0)=A$:SPRITE$(1)=B$")
  SoftwareHelp_L("140 SPRITE ON")
  SoftwareHelp_L("150 A=INT(RND(1)*256)")
  SoftwareHelp_L("160 B=INT(RND(1)*256)")
  SoftwareHelp_L("170 FOR I=0 TO 191")
  SoftwareHelp_L("180 PUT SPRITE 0,(A,I),1")
  SoftwareHelp_L("190 PUT SPRITE 1,(B,191-I),15")
  SoftwareHelp_L("200 NEXT I:GOTO 140")
  SoftwareHelp_L("210 SPRITE OFF")
  SoftwareHelp_L("220 PLAY " + Chr(34) + "L4CDEFEDCREFGAGFER" + Chr(34))
  SoftwareHelp_L("230 PUT SPRITE 0,(0,208)")
  SoftwareHelp_L("240 PUT SPRITE 1,(0,208)")
  SoftwareHelp_L("250 I=191:RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SPRITE ON/OFF/STOP,")
  SoftwareHelp_L("GOSUB")
  SoftwareHelp_Commit("ON SPRITE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON STOP GOSUB line")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Calls a subroutine in CTRL+STOP keys are pressed simultaneously.")
  SoftwareHelp_L("line is the first line of the subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The subroutine cann only be called after the " + Chr(34) + "STOP ON" + Chr(34) + " statement.")
  SoftwareHelp_L("After this instruction MSX-Basic automically calls the subroutine")
  SoftwareHelp_L("when CTRL- and STOP keys are pressed simultaneously.")
  SoftwareHelp_L("")
  SoftwareHelp_L("During the processing of an errorhandler MSX-Basic automatically")
  SoftwareHelp_L("performs the " + Chr(34) + "STOP OFF" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 ON STOP GOSUB 50")
  SoftwareHelp_L("20 STOP ON")
  SoftwareHelp_L("30 INPUT A$")
  SoftwareHelp_L("40 IF A$=" + Chr(34) + "END" + Chr(34) + " THEN STOP OFF:END ELSE GOTO 30")
  SoftwareHelp_L("50 PRINT " + Chr(34) + "Enter END and press Return" + Chr(34) + ":RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("END")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("STOP ON/OFF/STOP")
  SoftwareHelp_Commit("ON STOP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## ON STRIG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("ON STRIG(stick) GOSUB line, line2, ...")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Pressing a " + Chr(34) + "fire-button" + Chr(34) + " calls a subroutine.")
  SoftwareHelp_L("line respectively line2 is the first line of the")
  SoftwareHelp_L("corresponding subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("line corresponds to the first line number of the subroutine")
  SoftwareHelp_L("which is called if the Space key is pressed, where line2 is")
  SoftwareHelp_L("the line-number to be called if the key on Joystick 1 is pressed,")
  SoftwareHelp_L("and so on.")
  SoftwareHelp_L("The subroutine can only be called after the " + Chr(34) + "STRIG(stick) ON" + Chr(34))
  SoftwareHelp_L("statement. After this instruction MSX-Basic automically calls the")
  SoftwareHelp_L("subroutine when a fire-button is pressed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("During the processing of an errorhandler MSX-Basic automatically performs")
  SoftwareHelp_L("the " + Chr(34) + "STRIG(stick) OFF" + Chr(34) + " statement. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 CLS")
  SoftwareHelp_L("20 ON STRIG(X) GOSUB 50")
  SoftwareHelp_L("30 STRIG(0) ON")
  SoftwareHelp_L("40 GOTO 40")
  SoftwareHelp_L("50 LOCATE 5,5")
  SoftwareHelp_L("60 PRINT " + Chr(34) + "SPACE key pressed" + Chr(34))
  SoftwareHelp_L("70 FOR I=1 TO 300:NEXT I")
  SoftwareHelp_L("80 LOCATE 5,5:PRINT SPC$(17)")
  SoftwareHelp_L("90 RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("STRIG ON/OFF/STOP")
  SoftwareHelp_Commit("ON STRIG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## OPEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic, RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("OPEN " + Chr(34) + "device:filename" + Chr(34) + " [FOR direction] AS #channel [LEN=recordlength]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Opens an input- or output-channel from or to the specified device.")
  SoftwareHelp_L("")
  SoftwareHelp_L("device-name for MSX-Basic can be (for example):")
  SoftwareHelp_L("")
  SoftwareHelp_L("Device name | device type")
  SoftwareHelp_L("CRT: | screen (text-mode)")
  SoftwareHelp_L("GRP: | screen (graphic-mode)")
  SoftwareHelp_L("LPT: | printer")
  SoftwareHelp_L("CAS: | tape (not supported on MSX Turbo-R)")
  SoftwareHelp_L("A: | Disk drive")
  SoftwareHelp_L("B: | Disk drive")
  SoftwareHelp_L("COM: | RS232 (serial interface)")
  SoftwareHelp_L("MEM: | MSX2 RAM-Disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("filename is the name of the file, which is about to be opened. The filename")
  SoftwareHelp_L("must not specified for screen-modes and printer.")
  SoftwareHelp_L("")
  SoftwareHelp_L("direction indicates if the file is to be read into the buffer,")
  SoftwareHelp_L("or the buffer should be written to the file. The following keywords can be specified:")
  SoftwareHelp_L("")
  SoftwareHelp_L("  INPUT = sequential read")
  SoftwareHelp_L("")
  SoftwareHelp_L("  OUTPUT = sequential write")
  SoftwareHelp_L("")
  SoftwareHelp_L("  APPEND = sequential write to the end of an existing file")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the FOR direction is not specified MSX-Basic assumes that")
  SoftwareHelp_L("the file is a random file. In this case a file is created, if not")
  SoftwareHelp_L("found on the disk of a disk-drive.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Not every direction can be used for all device names.")
  SoftwareHelp_L("Allowed combinations are as following:")
  SoftwareHelp_L("Device name | OUTPUT | INPUT | APPEND")
  SoftwareHelp_L("CRT: | X | - | -")
  SoftwareHelp_L("GRP: | X | - | -")
  SoftwareHelp_L("LPT: | X | - | -")
  SoftwareHelp_L("CAS: | X | X | -")
  SoftwareHelp_L("A: | X | X | X")
  SoftwareHelp_L("B: | X | X | X")
  SoftwareHelp_L("COM: | X | X | -")
  SoftwareHelp_L("MEM: | X | X | X")
  SoftwareHelp_L("")
  SoftwareHelp_L("RS232: Note that random access to a channel is illegal. Only sequential accesses")
  SoftwareHelp_L("are logically possible.")
  SoftwareHelp_L("")
  SoftwareHelp_L("channel is the file-number, as long as the file is opened.")
  SoftwareHelp_L("This number is used to operate with Input/Output instructions")
  SoftwareHelp_L("(such as " + Chr(34) + "INPUT#" + Chr(34) + ", " + Chr(34) + "PRINT#" + Chr(34) + ", " + Chr(34) + "CLOSE#" + Chr(34) + ") on the file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("recordlength is an integer. If set it specifies the record-length")
  SoftwareHelp_L("of a random-file. The default-value is 256.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Before an I/O operation is performed the file has to be opened first.")
  SoftwareHelp_L("The maximum number of simultaneously opene files can be specified by")
  SoftwareHelp_L("the " + Chr(34) + "MAXFILES" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("OPEN " + Chr(34) + "CAS:TEST" + Chr(34) + " FOR OUTPUT AS #1")
  SoftwareHelp_L("PRINT #1,X")
  SoftwareHelp_L("")
  SoftwareHelp_L("The value of X is saved in a file named " + Chr(34) + "TEST" + Chr(34) + " (on tape). I.e. it's possible to read the stored value using:")
  SoftwareHelp_L("")
  SoftwareHelp_L("OPEN " + Chr(34) + "CAS:TEST" + Chr(34) + " FOR INPUT AS #2")
  SoftwareHelp_L("INPUT #2,X")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 SCREEN 2:COLOR 15,4,7")
  SoftwareHelp_L("20 OPEN " + Chr(34) + "GRP:" + Chr(34) + " FOR OUTPUT AS #1")
  SoftwareHelp_L("30 LINE (32,32)-(120,120),6,B")
  SoftwareHelp_L("40 CIRCLE (120,120),56,1")
  SoftwareHelp_L("50 PRESET (40,8)")
  SoftwareHelp_L("60 PRINT #1," + Chr(34) + "Text in graphic screen" + Chr(34))
  SoftwareHelp_L("70 FOR I=1 TO 2000: NEXT I")
  SoftwareHelp_L("80 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CLOSE,")
  SoftwareHelp_L("INPUT#,")
  SoftwareHelp_L("PRINT#,")
  SoftwareHelp_L("EOF,")
  SoftwareHelp_L("LOC,")
  SoftwareHelp_L("LOF,")
  SoftwareHelp_L("MAXFILES,")
  SoftwareHelp_L("RAM-Disk in MSX-Basic 2")
  SoftwareHelp_Commit("OPEN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## OR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("number1 OR number2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Logical inclusive or.")
  SoftwareHelp_L("0 OR 0 | = | 0")
  SoftwareHelp_L("0 OR 1 | = | 1")
  SoftwareHelp_L("1 OR 0 | = | 1")
  SoftwareHelp_L("1 OR 1 | = | 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("OR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## OUT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("OUT port,value")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Writes a value to an output-port.")
  SoftwareHelp_L("value and port must be in range from 0 to 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To read a byte from an input-port the function " + Chr(34) + "INP" + Chr(34) + " must be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INP,")
  SoftwareHelp_L("WAIT")
  SoftwareHelp_Commit("OUT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PAD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PAD( <number> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the position on the touchpad. One or more touchpads can be connected on the joystick-port(s).")
  SoftwareHelp_L("")
  SoftwareHelp_L("<number> is an integer between 0 and 7. If <number> has a value between 0 and 3 it's assumed that the touchpad is connected to port 1. If <number> has a value between 4 and 7 the touchpad is connected to port 2.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 0 or 4 the state of the touchpad is returned. The function returns -1, if the pad is touched and 0 if not.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 1 or 5 the X-coordinate is returned, if <number> is 2 or 6 the Y-coordinate is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 3 or 7 the state of the button on the touchpad is returned. This function returns -1 if the button is pressed and 0 is not.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2 and MSX 2+:")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is in range from 8 to 11 PAD is used to retrieve the state of a lightpen.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: this support is removed at the MSX Turbo-R, therefore such computers will return 0 in this case.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2 and higher:")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 12 the X/Y-offset of the mouse in port 1 is retrieved and can be queried by using PAD(13) and PAD(14). The return-value of PAD(12) is always -1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 13 the X-offset of the mouse in port 1 is returned (-128 to +127)")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 14 the Y-offset of the mouse in port 1 is returned (-128 to +127)")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 15 the return-value is 0 (reserved for mouse in port 1).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 16 the X/Y-offset of the mouse in port 2 is retrieved and can be queried by using PAD(17) and PAD(18). The return-value of PAD(16) is always -1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 17 the X-offset of the mouse in port 2 is returned (-128 to +127)")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 18 the Y-offset of the mouse in port 2 is returned (-128 to +127)")
  SoftwareHelp_L("")
  SoftwareHelp_L("If <number> is 19 the return-value is 0 (reserved for mouse in port 2).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Please note that the button-state of the mouse must be retrieved with the STRIG-function.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2")
  SoftwareHelp_L("20 A=0")
  SoftwareHelp_L("30 IF PAD(0)=0 THEN 20")
  SoftwareHelp_L("40 X=PAD(1):Y=PAD(2)")
  SoftwareHelp_L("50 IF A=0 THEN PSET(X,Y) ELSE LINE-(X,Y)")
  SoftwareHelp_L("60 A=1")
  SoftwareHelp_L("70 GOTO 30")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PDL,")
  SoftwareHelp_L("STICK,")
  SoftwareHelp_L("STRIG")
  SoftwareHelp_Commit("PAD", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PAINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PAINT [STEP](x,y)[,color][,bordercolor]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Fills a drawing in graphics mode with the specified color.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x is the X-coordinate of the starting point and must be an integer between 0 and 255 (or 511).")
  SoftwareHelp_L("")
  SoftwareHelp_L("y is the Y-coordinate of the starting point and must be an integer between 0 and 191 (or 211).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the word " + Chr(34) + "STEP" + Chr(34) + " is used the values of x and y are depending on the")
  SoftwareHelp_L("current cursor-position. In this case x and y can be negative too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color is the color-number to be used for filling.")
  SoftwareHelp_L("")
  SoftwareHelp_L("bordercolor is the color-number of the border-line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("In graphic-mode 1 the fill-color must be equal to the border-color.")
  SoftwareHelp_L("In this case bordercolor does not need to be specified.")
  SoftwareHelp_L("In graphic-mode 2 (and higher) fill-color and border-color can be different.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color and bordercolor must be integers between 0 and 15.")
  SoftwareHelp_L("See: color-table")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2:COLOR 15,4,7")
  SoftwareHelp_L("20 CIRCLE (80,80),20,8")
  SoftwareHelp_L("30 PAINT (80,80),8")
  SoftwareHelp_L("40 FOR I=1 TO 2000:NEXT I")
  SoftwareHelp_L("50 SCREEN 3:COLOR 15,4,7")
  SoftwareHelp_L("60 LINE (10,10)-(100,100),8,B")
  SoftwareHelp_L("70 PAINT (45,45),2,8")
  SoftwareHelp_L("80 FOR I=1 TO 2000:NEXT I")
  SoftwareHelp_L("90 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("PAINT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PDL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PDL( <number> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the position of a paddle. One or two paddles can be connected to the joystick-port(s).")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function returns a value between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("<number> is a number from 1 to 12.")
  SoftwareHelp_L("If <number> is 1, 3, 5, 7, 9 or 11 so the paddle is connected to port 1.")
  SoftwareHelp_L("If <number> is 2, 4, 6, 8, 10 or 12 the paddle is connected to port 2.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 CLS")
  SoftwareHelp_L("20 FOR I=1 TO 500")
  SoftwareHelp_L("30 LOCATE 10,5:PRINT PDL(1),PDL(2)")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PAD,")
  SoftwareHelp_L("STICK,")
  SoftwareHelp_L("STRIG")
  SoftwareHelp_Commit("PDL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PEEK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PEEK(address)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns a memory-byte.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function returns the decimal-value of a memory-address")
  SoftwareHelp_L("and therefore results in a value between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("address is the memory-address and must be in range")
  SoftwareHelp_L("between -32768 and 65535.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If address is negative the binary complement is used.")
  SoftwareHelp_L("This means PEEK(-1)=PEEK(65536-1)=PEEK(65535).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "POKE" + Chr(34) + "statement is used to write a byte to a specific")
  SoftwareHelp_L("memory-address.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A=PEEK(65535)")
  SoftwareHelp_L("20 A$=" + Chr(34) + "00" + Chr(34) + "+HEX$(A)")
  SoftwareHelp_L("30 PRINT RIGHT$(A$,2)")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("F0")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("POKE,")
  SoftwareHelp_L("VPEEK,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("BSAVE,")
  SoftwareHelp_L("VARPTR")
  SoftwareHelp_Commit("PEEK", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PLAY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PLAY " + Chr(34) + "string" + Chr(34) + " [," + Chr(34) + "string2" + Chr(34) + "[," + Chr(34) + "string3" + Chr(34) + "]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This functions plays the notes specified in string.")
  SoftwareHelp_L("In this string you can also specify the pitch, duration, tempo and pause.")
  SoftwareHelp_L("")
  SoftwareHelp_L("string, string2 and string3 are sub-commands built by")
  SoftwareHelp_L("alphanumeric constants. string corresponds to voice 1, string2 to")
  SoftwareHelp_L("voice 2 and string3 to voice 3.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To play a note from the scale: the following sub-commands are creating a")
  SoftwareHelp_L("note from the scale: A, B, C, D, E, F and G. A " + Chr(34) + "+" + Chr(34) + " or " + Chr(34) + "#" + Chr(34) + " after a note are indicating")
  SoftwareHelp_L("an -is (increased by a halftone) where A " + Chr(34) + "-" + Chr(34) + " indicates an -es (decreased by a halftone.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To set an octave: the sub-command " + Chr(34) + "Onumber" + Chr(34) + " sets the octave-number,")
  SoftwareHelp_L("which should be played. number is an integer from 1 to 8.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If no octave is specified the last used octave is used. The default value is 4.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To play a note-number: instead of playing an octave-number and a note-number")
  SoftwareHelp_L("music-note-numbers can be specified also. The sub-command " + Chr(34) + "Nnumber" + Chr(34) + " is used")
  SoftwareHelp_L("to specify a note-number. number is an integer between 0 and 95. If number")
  SoftwareHelp_L("is 0 no sound is generated. In this case a short pause is played before the remaining part.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To specify a note-length: the note-length is specified by the sub-command")
  SoftwareHelp_L(Chr(34) + "Lnumber" + Chr(34) + ". number is an integer between 1 and 64 and has the following meaning:")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 = full note")
  SoftwareHelp_L("")
  SoftwareHelp_L("2 = half note")
  SoftwareHelp_L("")
  SoftwareHelp_L("3 = third note")
  SoftwareHelp_L("")
  SoftwareHelp_L("4 = quarter note")
  SoftwareHelp_L("")
  SoftwareHelp_L("and so on.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If no length is specifed the last used note is used. The default value is 4.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To change a note-length: by adding a dot (.) direct after specifying a note the length")
  SoftwareHelp_L("is multiplied by 1/2. You can also add multiple dots; e.g. " + Chr(34) + "..." + Chr(34) + " means the note is played in")
  SoftwareHelp_L("15/8 times the speed of its original length.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To set a pause: the sub-command " + Chr(34) + "Rnumber" + Chr(34) + " is used to set a pause.")
  SoftwareHelp_L("number is an integer between 1 and 64 and has the following meaning:")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 = full pause")
  SoftwareHelp_L("")
  SoftwareHelp_L("2 = half pause")
  SoftwareHelp_L("")
  SoftwareHelp_L("3 = third pause")
  SoftwareHelp_L("")
  SoftwareHelp_L("4 = quarter pause")
  SoftwareHelp_L("")
  SoftwareHelp_L("and so on.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To set a tempo: the tempo is set with the sub-command " + Chr(34) + "Tnumber" + Chr(34) + ".")
  SoftwareHelp_L("number is an integer from 32 to 255 and indicates the number of quarter")
  SoftwareHelp_L("notes per minute. If no tempo is set the last tempo will be used. The default value is 120.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To set an envelope: the envelope is set with the sub-command " + Chr(34) + "Snumber" + Chr(34) + ".")
  SoftwareHelp_L("number is an integer from 0 to 15.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If no envelope is specified the last set value will be used. The default value is 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Sound modulation: the sound-period is specified with the sub-command " + Chr(34) + "Mnumber" + Chr(34) + ".")
  SoftwareHelp_L("number is an integer from 1 to 65536 and sets the sound-period.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If no modulation is specified the last set modulation will be used.")
  SoftwareHelp_L("The default value is 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To start execution: The music instructions in an alphanumeric variable can be")
  SoftwareHelp_L("executed with the sub-command " + Chr(34) + "XA$;" + Chr(34) + " (don't forget the semicolon!).")
  SoftwareHelp_L("")
  SoftwareHelp_L("A$ is the name of the variable that contains the musical sub-commands.")
  SoftwareHelp_L("Numeric variables can be used instead of numeric values in sub-commands.")
  SoftwareHelp_L("In this case an equal sign (=) has to be specified before these numeric variables")
  SoftwareHelp_L("and they have to be terminated with a semicolon (;), e.g.: AB=10:PLAY " + Chr(34) + "N=AB;" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("If MSX-Basic generates a beep-sound all values of the sub-commands will be reset")
  SoftwareHelp_L("to their default values!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("PLAY " + Chr(34) + "O5CDEFGABO6C" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("10 A$=" + Chr(34) + "T128" + Chr(34))
  SoftwareHelp_L("20 B$=" + Chr(34) + "L4CCFGL2AL8FEL4D.L8B-L4B" + Chr(34))
  SoftwareHelp_L("30 PLAY " + Chr(34) + "XA$;" + Chr(34))
  SoftwareHelp_L("40 PLAY " + Chr(34) + "XB$;" + Chr(34))
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BEEP,")
  SoftwareHelp_L("PLAY(),")
  SoftwareHelp_L("PLAY (MSX-Music)")
  SoftwareHelp_Commit("PLAY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PLAY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PLAY(voice)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the state of playing music.")
  SoftwareHelp_L("")
  SoftwareHelp_L("voice has the following meaning:")
  SoftwareHelp_L("0 = voice1, voice 2 and voice 3")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 = voice 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("2 = voice 2")
  SoftwareHelp_L("")
  SoftwareHelp_L("3 = voice 3")
  SoftwareHelp_L("")
  SoftwareHelp_L("The function returns -1 if the selected voice is playing.")
  SoftwareHelp_L("If playing has ended the function returns 0 again.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the function is called immediately after the " + Chr(34) + "PLAY" + Chr(34))
  SoftwareHelp_L("statement the value -1 is persistent.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + Chr(34) + ":BEEP")
  SoftwareHelp_L("20 FOR I=1 TO 6")
  SoftwareHelp_L("30 READ AA$:A$=A$+AA$")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("50 PLAY " + Chr(34) + "XA$;" + Chr(34))
  SoftwareHelp_L("60 SCREEN 0:WIDTH 35:CLS")
  SoftwareHelp_L("70 IF PLAY(0)=-1 THEN PRINT " + Chr(34) + "The music is playing" + Chr(34) + ":GOTO 70")
  SoftwareHelp_L("80 PRINT " + Chr(34) + "The music has ended" + Chr(34))
  SoftwareHelp_L("90 END")
  SoftwareHelp_L("100 DATA CCGGAAGR")
  SoftwareHelp_L("110 DATA FFEEDDCR")
  SoftwareHelp_L("120 DATA GGFFEEDR")
  SoftwareHelp_L("130 DATA GGFFEEDR")
  SoftwareHelp_L("140 DATA CCGGAAGR")
  SoftwareHelp_L("150 DATA FFEEDDCR")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PLAY")
  SoftwareHelp_Commit("PLAY", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## POINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("POINT(x,y)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the color-number of the specified point in graphics-mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x is the X-coordinate and must be an integer between 0 and 255 (or 0 and 511).")
  SoftwareHelp_L("")
  SoftwareHelp_L("y is the Y-coordinate and must be an integer between 0 and 191 (or 0 and 211).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2:COLOR 15,1,7")
  SoftwareHelp_L("20 OPEN " + Chr(34) + "GRP:" + Chr(34) + " FOR OUTPUT AS #1")
  SoftwareHelp_L("30 FOR I=1 TO 10")
  SoftwareHelp_L("40 PRESET(I*16,8)")
  SoftwareHelp_L("50 C=INT(RND(1)*13)+2")
  SoftwareHelp_L("60 COLOR C")
  SoftwareHelp_L("70 PRINT #1,CHR$(1)+CHR$(66)")
  SoftwareHelp_L("80 NEXT I")
  SoftwareHelp_L("90 COLOR 15")
  SoftwareHelp_L("100 PRESET (40,24)")
  SoftwareHelp_L("110 PRINT #1," + Chr(34) + "Color numbers" + Chr(34))
  SoftwareHelp_L("120 FOR I=1 TO 20")
  SoftwareHelp_L("130 C=POINT(I*16+4,12)")
  SoftwareHelp_L("140 PRESET(I*16,I*8+56),4")
  SoftwareHelp_L("150 PRINT#1,USING " + Chr(34) + "##" + Chr(34) + ";C")
  SoftwareHelp_L("160 NEXT I")
  SoftwareHelp_L("170 FOR I=1 TO 2000:NEXT I")
  SoftwareHelp_L("180 COLOR 15,4,7")
  SoftwareHelp_L("190 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PSET")
  SoftwareHelp_Commit("POINT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## POKE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("POKE adress,value")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Fills a byte in memory adress with a byte of value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("address is the memory-address and must be in range")
  SoftwareHelp_L("between -32768 and 65535.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If address is negative the binary complement is used.")
  SoftwareHelp_L("This means POKE-1,0=POKE(65536-1),0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function is used to change the value of a specific byte in memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 POKE 65534,PEEK(65534)")
  SoftwareHelp_L("20 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PEEK,")
  SoftwareHelp_L("VPOKE,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("BSAVE,")
  SoftwareHelp_L("DEFUSR,")
  SoftwareHelp_L("VARPTR")
  SoftwareHelp_Commit("POKE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## POS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("POS(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Gives the X-coordinate (column-number) of the cursor.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function returns a number between 0 and 39 (or 0 and 79).")
  SoftwareHelp_L("The most left column is 0. This function can only be used in text mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 0")
  SoftwareHelp_L("20 LOCATE 10,20")
  SoftwareHelp_L("30 PRINT POS(0)")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("10")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CSRLIN,")
  SoftwareHelp_L("LOCATE")
  SoftwareHelp_Commit("POS", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PRESET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PRESET [STEP](x,y)[,color]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Sets a color into the specified point at x,y in graphics mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x is the X-coordinate of the point and must be an integer between 0 and 255 (or 0 and 511).")
  SoftwareHelp_L("")
  SoftwareHelp_L("y is the Y-coordinate of the point and must be an integer between 0 and 191 (or 0 and 211).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the word " + Chr(34) + "STEP" + Chr(34) + " is used values for x and y are relative to the current")
  SoftwareHelp_L("cursor-position. In this case x and y can be negative too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color is the color-number and must be an integer between 0 and 15")
  SoftwareHelp_L("(see: color-table).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If color is not set the last used background-color will be assumed.")
  SoftwareHelp_L("The default-value of color is 4.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2:COLOR 15,4,7")
  SoftwareHelp_L("20 LINE (40,40)-(215,151),15,BF")
  SoftwareHelp_L("30 FOR I=0 TO 1000")
  SoftwareHelp_L("40 A=INT(RND(1)*173)+41")
  SoftwareHelp_L("50 B=INT(RND(1)*109)+41")
  SoftwareHelp_L("60 PRESET(A,B)")
  SoftwareHelp_L("70 FOR K=0 TO 300:NEXT K")
  SoftwareHelp_L("80 NEXT I")
  SoftwareHelp_L("90 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("PRESET", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PRINT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PRINT [USING " + Chr(34) + "format" + Chr(34) + ";] [value [,value2 [,...]]] [;]")
  SoftwareHelp_L("")
  SoftwareHelp_L("PRINT #channel, [USING " + Chr(34) + "format" + Chr(34) + ";] variable")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("The first format is used to display data on the screen. If the word PRINT is used without")
  SoftwareHelp_L("suffix MSX-Basic generates an empty line. If an expression is added it's value is displayed")
  SoftwareHelp_L("on the screen. The expression can be of numeric or alphanumeric type. In case of alphanumeric")
  SoftwareHelp_L("constants these have to be quoted (e.g. 10 PRINT " + Chr(34) + "Hello" + Chr(34) + ").")
  SoftwareHelp_L("")
  SoftwareHelp_L("Print position: The position where the printout appears on the screen")
  SoftwareHelp_L("depends on the punctation between different values (expressions). MSX-Basic separates each")
  SoftwareHelp_L("screen-line into zones of 14 positions. If a value is followed by a colon (,) the next")
  SoftwareHelp_L("output appears in the next zone. If the value is followed by a semicolon (;) the next")
  SoftwareHelp_L("output appears immediately behind the last value. If a " + Chr(34) + "PRINT" + Chr(34) + " statement ends with a colon (,)")
  SoftwareHelp_L("or a semicolon (;) the output of the next " + Chr(34) + "PRINT" + Chr(34) + " statement appears on the same screen-line.")
  SoftwareHelp_L("If a " + Chr(34) + "PRINT" + Chr(34) + " statement does not end with a colon (,) or a semicolon (;) the output of the")
  SoftwareHelp_L("next " + Chr(34) + "PRINT" + Chr(34) + " statement appears in the next line. If the number of positions in the printout")
  SoftwareHelp_L("is larger than the number of positions per screen-line (defined by the " + Chr(34) + "WIDTH" + Chr(34) + " statement)")
  SoftwareHelp_L("MSX-Basic automatically continues in the next line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Numbers: Behind each number, that is displayed on the screen, is always")
  SoftwareHelp_L("a space. In front of positive numbers is a space, in front of negative numbers a minus (-).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The 2nd format of the " + Chr(34) + "PRINT" + Chr(34) + " statement is used to write data into a sequential file (opened")
  SoftwareHelp_L("as #channel) opened for OUTPUT. After every " + Chr(34) + "PRINT" + Chr(34) + " statement a 'CR' and 'LF' character")
  SoftwareHelp_L("is written into the file. MSX-Basic automatically places a colon " + Chr(34) + "," + Chr(34) + " between numerical")
  SoftwareHelp_L("expressions in a simple " + Chr(34) + "PRINT" + Chr(34) + " statement as well as a hyphen if printing goes to a file.")
  SoftwareHelp_L("Alphanumerical expressions have to be separated by a colon and a hyphen. To read data from")
  SoftwareHelp_L("a file with uniform records the statement " + Chr(34) + "INPUT#" + Chr(34) + " can be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Printing formats: printout can be formatted, if preceded by " + Chr(34) + "USING" + Chr(34) + ".")
  SoftwareHelp_L("Possible syntax of the specified format is documented in the chapter " + Chr(34) + "USING" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("Instead of the keyword " + Chr(34) + "PRINT" + Chr(34) + " also a question mark (?) can be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("? " + Chr(34) + "Hello" + Chr(34))
  SoftwareHelp_L("Hello")
  SoftwareHelp_L("")
  SoftwareHelp_L("PRINT " + Chr(34) + "World" + Chr(34))
  SoftwareHelp_L("World")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 CLS")
  SoftwareHelp_L("20 FOR I=1 TO 5")
  SoftwareHelp_L("30 ? USING " + Chr(34) + "Number is #.#-" + Chr(34) + ";I")
  SoftwareHelp_L("40 NEXT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LPRINT,")
  SoftwareHelp_L("TAB,")
  SoftwareHelp_L("SPC,")
  SoftwareHelp_L("PUT,")
  SoftwareHelp_L("INPUT,")
  SoftwareHelp_L("CLS,")
  SoftwareHelp_L("WIDTH,")
  SoftwareHelp_L("LOCATE,")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("INPUT[#]")
  SoftwareHelp_Commit("PRINT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PSET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PSET [STEP](x,y)[,color]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Sets a color into the specified point at x,y in graphics mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x is the X-coordinate of the point and must be an integer between 0 and 255 (or 0 and 511).")
  SoftwareHelp_L("")
  SoftwareHelp_L("y is the Y-coordinate of the point and must be an integer between 0 and 191 (or 0 and 211).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the word " + Chr(34) + "STEP" + Chr(34) + " is used values for x and y are relative to the current")
  SoftwareHelp_L("cursor-position. In this case x and y can be negative too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color is the color-number and must be an integer between 0 and 15")
  SoftwareHelp_L("(see: color-table).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If color is not set the last used foreground-color will be assumed.")
  SoftwareHelp_L("The default-value of color is 15.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2:COLOR 15,4,7")
  SoftwareHelp_L("20 LINE (40,40)-(215,151),15,B")
  SoftwareHelp_L("30 FOR I=0 TO 1000")
  SoftwareHelp_L("40 A=INT(RND(1)*173)+41")
  SoftwareHelp_L("50 B=INT(RND(1)*109)+41")
  SoftwareHelp_L("60 PSET(A,B)")
  SoftwareHelp_L("70 FOR K=0 TO 300:NEXT K")
  SoftwareHelp_L("80 NEXT I")
  SoftwareHelp_L("90 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PRESET,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("POINT,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("CLS")
  SoftwareHelp_Commit("PSET", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PUT SPRITE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PUT SPRITE priority, [STEP](x,y), color, number")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Put a defined sprite in graphics mode on the screen.")
  SoftwareHelp_L("")
  SoftwareHelp_L("priority specifies the priority of the sprite and must be an integer between 0 and 31.")
  SoftwareHelp_L("")
  SoftwareHelp_L("x is the X-coordinate of the sprite and must be an integer between -32 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("y is the Y-coordinate of the sprite and must be an integer between -32 and 191 or ")
  SoftwareHelp_L("208 or 209.")
  SoftwareHelp_L("If y is 208 all sprites with a lower priority will disappear from the screen.")
  SoftwareHelp_L("If y is 209 only this sprite will disappear from the screen.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the word " + Chr(34) + "STEP" + Chr(34) + " is specified the values x and y are relative to the current")
  SoftwareHelp_L("screen-position. In this case x and y can be negative too. If x and y")
  SoftwareHelp_L("are not specified the actual coordinate remains unchanged.")
  SoftwareHelp_L("")
  SoftwareHelp_L("color is the color-number of the sprite and must be an integer between 0 and 15")
  SoftwareHelp_L("(see: color-table).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If color is not set the last foreground-color will be used. The default-value is 15.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number is the number of the sprite, as used in SPRITE$(number).")
  SoftwareHelp_L("If number is not specified its equal to the priority.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: ON SPRITE GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SPRITE$,")
  SoftwareHelp_L("ON SPRITE GOSUB,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("COLOR SPRITE,")
  SoftwareHelp_L("COLOR SPRITE$")
  SoftwareHelp_Commit("PUT SPRITE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## READ")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("READ variable [,variable2 [,...]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Reads a constant from the " + Chr(34) + "DATA" + Chr(34) + " statement and assigns it to a variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "READ" + Chr(34) + " statement can only be used with a " + Chr(34) + "DATA" + Chr(34) + " statement.")
  SoftwareHelp_L("The " + Chr(34) + "READ" + Chr(34) + " statement gives access to the data, listed after the " + Chr(34) + "DATA" + Chr(34) + " statement and")
  SoftwareHelp_L("in order of the line-numbers.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The variable in the " + Chr(34) + "READ" + Chr(34) + " statement can be numeric or alphanumeric.")
  SoftwareHelp_L("The type of the variable must match with the corresponding constant")
  SoftwareHelp_L("in the " + Chr(34) + "DATA" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("A single " + Chr(34) + "READ" + Chr(34) + " statement can give access to one or more " + Chr(34) + "DATA" + Chr(34) + " statements.")
  SoftwareHelp_L("Its also possible to access the data of a single " + Chr(34) + "DATA" + Chr(34) + " statement with multiple")
  SoftwareHelp_L(Chr(34) + "READ" + Chr(34) + " statements.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the number of variables in the " + Chr(34) + "READ" + Chr(34) + " statement is larger than the number")
  SoftwareHelp_L("of constants in the " + Chr(34) + "DATA" + Chr(34) + " statement MSX-Basic generates an " + Chr(34) + "Out of data" + Chr(34) + " error.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the number of variables in the " + Chr(34) + "READ" + Chr(34) + " statement is smaller than the number")
  SoftwareHelp_L("of constants in the " + Chr(34) + "DATA" + Chr(34) + " statement  the next " + Chr(34) + "READ" + Chr(34) + " statement continues")
  SoftwareHelp_L("with the remaining constants. If no more " + Chr(34) + "READ" + Chr(34) + " statements are executed")
  SoftwareHelp_L("the remaining constants are ignored.")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "DATA" + Chr(34) + " statements can be specified since the program-start, or explicitly")
  SoftwareHelp_L("selected with a line-number in the " + Chr(34) + "RESTORE" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: DATA")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DATA,")
  SoftwareHelp_L("RESTORE")
  SoftwareHelp_Commit("READ", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## REM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("REM")
  SoftwareHelp_L("")
  SoftwareHelp_L("'")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Inserts a remark into the program text.")
  SoftwareHelp_L("")
  SoftwareHelp_L(Chr(34) + "REM" + Chr(34) + " statements are not executed when the program runs, but printed if")
  SoftwareHelp_L("the program is listed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The program use " + Chr(34) + "GOTO" + Chr(34) + " and " + Chr(34) + "GOSUB" + Chr(34) + " to link to a " + Chr(34) + "REM" + Chr(34) + " statement.")
  SoftwareHelp_L("In this case the program execution continues at the statement behind")
  SoftwareHelp_L("the " + Chr(34) + "REM" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("Instead of the keyword " + Chr(34) + "REM" + Chr(34) + " also a single apostroph (') can be used.")
  SoftwareHelp_L("Do not use this keyword within a " + Chr(34) + "DATA" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 REM Calculation")
  SoftwareHelp_L("20 FOR I=1 TO 10")
  SoftwareHelp_L("30 SUM=SUM+I")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("50 SUM=SUM/10")
  SoftwareHelp_L("")
  SoftwareHelp_L("or")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 FOR I=1 TO 10 'Calculation")
  SoftwareHelp_L("20 SUM=SUM+I")
  SoftwareHelp_L("30 NEXT I")
  SoftwareHelp_L("40 SUM=SUM/10")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DATA")
  SoftwareHelp_Commit("REM", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RENUM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RENUM [line] [,line2 [,increment]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Renumbers program lines.")
  SoftwareHelp_L("")
  SoftwareHelp_L("line is the first program-line, which is used in the new order.")
  SoftwareHelp_L("If line is not specified the order starts in line 10.")
  SoftwareHelp_L("")
  SoftwareHelp_L("line2 is the existing program-line where the re-ordering should start.")
  SoftwareHelp_L("If line2 is not specified the order starts in the 1st program-line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("increment is the step-width of the new order.")
  SoftwareHelp_L("If increment is not specified MSX-Basic uses 10.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The statement " + Chr(34) + "RENUM" + Chr(34) + " renumbers also the line-numbers after the statements")
  SoftwareHelp_L(Chr(34) + "GOTO" + Chr(34) + ", " + Chr(34) + "GOSUB" + Chr(34) + ", " + Chr(34) + "IF THEN ELSE" + Chr(34) + ", " + Chr(34) + "ON GOTO" + Chr(34) + " and " + Chr(34) + "ON GOSUB" + Chr(34) + ". The renumbered")
  SoftwareHelp_L("value is based on the new line-number which has been changed due to the re-ordering.")
  SoftwareHelp_L("If a non-existing line-number is recognized the error " + Chr(34) + "Undefined line XX in YY" + Chr(34))
  SoftwareHelp_L("is raised.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The statement " + Chr(34) + "RENUM" + Chr(34) + " can not be used to change the order of line-numbers.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("RENUM")
  SoftwareHelp_L("")
  SoftwareHelp_L("This statement renumbers all program lines, beginning at the first line.")
  SoftwareHelp_L("The first line gots the number 10. Subsequent line-numbers are increased by 10.")
  SoftwareHelp_L("")
  SoftwareHelp_L("RENUM 1000,900,50")
  SoftwareHelp_L("")
  SoftwareHelp_L("(new value=1000, previously 900, increment by 50)")
  SoftwareHelp_L("")
  SoftwareHelp_L("This statement renumbers all program lines, beginning on line 900.")
  SoftwareHelp_L("Line 900 becomes line 1000 ands ubsequent line-numbers are increased by 50.")
  SoftwareHelp_L("")
  SoftwareHelp_L("900 FOR I=1 TO 10")
  SoftwareHelp_L("910 PRINT I;")
  SoftwareHelp_L("920 IF I<10 THEN 930 ELSE 940")
  SoftwareHelp_L("930 NEXT")
  SoftwareHelp_L("940 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("1000 FOR I=1 TO 10")
  SoftwareHelp_L("1050 PRINT I;")
  SoftwareHelp_L("1100 IF I<10 THEN 1150 ELSE 1200")
  SoftwareHelp_L("1150 NEXT")
  SoftwareHelp_L("1200 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AUTO")
  SoftwareHelp_Commit("RENUM", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RESTORE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RESTORE [line]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("The " + Chr(34) + "RESTORE" + Chr(34) + " statement sets the data-pointer to the first element")
  SoftwareHelp_L("of the " + Chr(34) + "DATA" + Chr(34) + " statement to line of the program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("line is the line-number of a " + Chr(34) + "DATA" + Chr(34) + " statement.")
  SoftwareHelp_L("After a " + Chr(34) + "RESTORE" + Chr(34) + " is performed the first constant of a " + Chr(34) + "DATA" + Chr(34) + " statement")
  SoftwareHelp_L("is returned by the " + Chr(34) + "READ" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If line is not specified the " + Chr(34) + "READ" + Chr(34) + " statement returns the")
  SoftwareHelp_L("1st constant of the 1st " + Chr(34) + "DATA" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DATA 123,ABC,48.5")
  SoftwareHelp_L("20 READ A%,A$,A!")
  SoftwareHelp_L("30 PRINT A%;A$;A!")
  SoftwareHelp_L("40 RESTORE")
  SoftwareHelp_L("50 READ A%:PRINT A%")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DATA,")
  SoftwareHelp_L("READ")
  SoftwareHelp_Commit("RESTORE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RESUME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RESUME [line]")
  SoftwareHelp_L("")
  SoftwareHelp_L("RESUME 0")
  SoftwareHelp_L("")
  SoftwareHelp_L("RESUME NEXT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("line is the line-number of the program, in which")
  SoftwareHelp_L("- after execution of the error-handling routine specified by")
  SoftwareHelp_L(Chr(34) + "ON ERROR GOTO" + Chr(34) + " - the program will be resumed. If line")
  SoftwareHelp_L("is not specified or 0 the program will be continued on the")
  SoftwareHelp_L("location where the error was detected.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the keyword " + Chr(34) + "NEXT" + Chr(34) + " is used (instead of line) the")
  SoftwareHelp_L("program execution is resumed on the statement immediately")
  SoftwareHelp_L("following the error-location.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See ERR")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON ERROR GOTO,")
  SoftwareHelp_L("ERL,")
  SoftwareHelp_L("ERROR,")
  SoftwareHelp_L("ERR")
  SoftwareHelp_Commit("RESUME", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RETURN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RETURN [linenumber]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns from a subroutine that was invoked by GOSUB.")
  SoftwareHelp_L("")
  SoftwareHelp_L("In contrast to other Basic dialects the RETURN statement can specify")
  SoftwareHelp_L("an explicit line-number where the program can return to.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 PRINT " + Chr(34) + "Hello" + Chr(34))
  SoftwareHelp_L("110 GOSUB 200")
  SoftwareHelp_L("120 END")
  SoftwareHelp_L("200 PRINT " + Chr(34) + "Here am I" + Chr(34))
  SoftwareHelp_L("210 RETURN 110")
  SoftwareHelp_L("")
  SoftwareHelp_L("Generates an infinite loop because the subroutine always returns")
  SoftwareHelp_L("to it's invocation point:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Hello")
  SoftwareHelp_L("Here am I")
  SoftwareHelp_L("Here am I")
  SoftwareHelp_L("...")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GOSUB")
  SoftwareHelp_Commit("RETURN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RIGHT$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RIGHT$(string, number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the last number (0-255) characters from the right end of the specified string.")
  SoftwareHelp_L("If number is larger than the string the whole string is returned.")
  SoftwareHelp_L("If number is 0 an empty string is returned. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A$=" + Chr(34) + "Basic" + Chr(34))
  SoftwareHelp_L("20 FOR I=1 TO LEN(A$)")
  SoftwareHelp_L("30 PRINT RIGHT$(A$,I)")
  SoftwareHelp_L("40 NEXT")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("c")
  SoftwareHelp_L("ic")
  SoftwareHelp_L("sic")
  SoftwareHelp_L("asic")
  SoftwareHelp_L("Basic")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LEFT$,")
  SoftwareHelp_L("MID$")
  SoftwareHelp_Commit("RIGHT$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RND")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RND(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Generates a random-number between 0 and 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Whenever a program is started with " + Chr(34) + "RUN" + Chr(34) + " the same sequence of random-numbers is generated.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If number is greater than 0 the next random-value of the sequence is returned.")
  SoftwareHelp_L("If number is equal to 0 the last random-value of the sequence is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If number is less than 0 the sequence of random-numbers is rebuilt based on the")
  SoftwareHelp_L("negative number.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To generate a real random-number the generator must always select a new sequence")
  SoftwareHelp_L("after the program has been started. This can be ensured by using the variable " + Chr(34) + "TIME" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 R=RND(TIME)")
  SoftwareHelp_L("20 FOR I=1 TO 10")
  SoftwareHelp_L("30 SCREEN 2:COLOR 15,4,7")
  SoftwareHelp_L("40 C=INT(RND(1)*15+1)")
  SoftwareHelp_L("50 IF C=4 GOTO 40")
  SoftwareHelp_L("60 CIRCLE (80,80),20,C")
  SoftwareHelp_L("70 PAINT (80,80),C")
  SoftwareHelp_L("90 NEXT I")
  SoftwareHelp_L("100 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("TIME")
  SoftwareHelp_Commit("RND", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RUN [line]")
  SoftwareHelp_L("")
  SoftwareHelp_L("RUN " + Chr(34) + "devicename:filename" + Chr(34) + " [,line]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Starts the execution of a program, which is stored in the computer-memory")
  SoftwareHelp_L("or a device.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Devicenames can be, e.g.: CAS:, A: or B:")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "SAVE" + Chr(34) + " statement must have been used to store the program in ASCII format (on tape or disk).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The filename is an alphanumerical constant, that has been specified while the program was")
  SoftwareHelp_L("stored using the " + Chr(34) + "SAVE" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If devicename and filename are not specified the program in memory will be executed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("line corresponds to the program line-number.")
  SoftwareHelp_L("If line is specified the program starts in this line.")
  SoftwareHelp_L("If line is not specified the program starts in the first line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("RUN 100")
  SoftwareHelp_L("")
  SoftwareHelp_L("(in this case the program execution starts in line 100)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("CALL RUN,")
  SoftwareHelp_L("END,")
  SoftwareHelp_L("STOP,")
  SoftwareHelp_L("CONT")
  SoftwareHelp_Commit("RUN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SAVE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SAVE " + Chr(34) + "devicename:filename" + Chr(34) + " [,A]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Stores a program of the computer-memory onto a device (tape or disk).")
  SoftwareHelp_L("")
  SoftwareHelp_L("If a program is saved to a tape (" + Chr(34) + "CAS:" + Chr(34) + ") it can be restored with the " + Chr(34) + "LOAD" + Chr(34) + " and " + Chr(34) + "MERGE" + Chr(34) + " statements.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Reminder:")
  SoftwareHelp_L("")
  SoftwareHelp_L("CSAVE saves in binary format")
  SoftwareHelp_L("")
  SoftwareHelp_L("SAVE " + Chr(34) + "CAS:" + Chr(34) + " saves in ASCII format onto tape")
  SoftwareHelp_L("")
  SoftwareHelp_L("SAVE saves binary and SAVE...,A in ASCII code onto disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("Devicenames can be, e.g.: CAS:, A: or B:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the " + Chr(34) + "CAS:" + Chr(34) + " device is no longer supported!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SAVE " + Chr(34) + "CAS:DEMO" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BSAVE,")
  SoftwareHelp_L("CSAVE,")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("MERGE")
  SoftwareHelp_Commit("SAVE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SCREEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SCREEN screenmode [,spritesize, keyclick, baudrate, printertype, interlacemode]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Specifies the screenmode, spritesize, sound on keypress, baudrate for the data-recorder")
  SoftwareHelp_L("and the used printer-type.")
  SoftwareHelp_L("")
  SoftwareHelp_L("screenmode may be specified from 0 to 3. When specifying a screen mode,")
  SoftwareHelp_L("in BASIC it is called " + Chr(34) + "SCREEN MODE" + Chr(34) + ", which is somewhat different from " + Chr(34) + "screen mode" + Chr(34) + " which is used by VDP internally.")
  SoftwareHelp_L("The Screen-modes table shows these correspondences and meanings.")
  SoftwareHelp_L("The difference between screen modes 2 and 4 is only in the sprite display functions.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If screenmode is not specified the last used screenmode remains unchanged.")
  SoftwareHelp_L("The default-value is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The graphic-operations " + Chr(34) + "PUT SPRITE" + Chr(34) + ", " + Chr(34) + "CIRCLE" + Chr(34) + ", " + Chr(34) + "DRAW" + Chr(34) + ", " + Chr(34) + "LINE" + Chr(34) + ", " + Chr(34) + "PAINT" + Chr(34) + ", " + Chr(34) + "PSET" + Chr(34) + ", " + Chr(34) + "PRESET" + Chr(34) + ",")
  SoftwareHelp_L(Chr(34) + "ON SPRITE GOSUB" + Chr(34) + ", " + Chr(34) + "SPRITE ON/OFF/STOP" + Chr(34) + " and " + Chr(34) + "POINT" + Chr(34) + " can only be used in graphics-mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2: adds screenmodes 4-8.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Korean MSX 2: supports screenmode 9 too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2+: adds screenmodes 10-12.")
  SoftwareHelp_L("")
  SoftwareHelp_L("spritesize specifies the sprite-size.")
  SoftwareHelp_L("")
  SoftwareHelp_L("0 | small sprites (8x8 dots)")
  SoftwareHelp_L("1 | small sprites (enlarged to 16x16 dots)")
  SoftwareHelp_L("2 | large sprites (16x16 dots)")
  SoftwareHelp_L("3 | large sprites (enlarged to 32x32 dots)")
  SoftwareHelp_L("If spritesize is not specified the last value remains unchanged.")
  SoftwareHelp_L("The default-value is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("keyclick specifies if a sound is generated when a key is pressed.")
  SoftwareHelp_L("The value should be 0 or 1 and has the following meaning:")
  SoftwareHelp_L("0 | no sound")
  SoftwareHelp_L("1 | sound (key click)")
  SoftwareHelp_L("If keyclick is not specified the last value remains unchanged.")
  SoftwareHelp_L("The default value is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("baudrate specifies the baud-rate of the data-recorder.")
  SoftwareHelp_L("The value must be 1 or 2 and has the following meaning:")
  SoftwareHelp_L("1 | 1200 baud")
  SoftwareHelp_L("2 | 2400 baud")
  SoftwareHelp_L("If baudrate is not specified the last value remains unchanged.")
  SoftwareHelp_L("The default value is 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("printertype indicates if an MSX-Printer is used.")
  SoftwareHelp_L("The value should be 0 or 1 and has the following meaning:")
  SoftwareHelp_L("0 | MSX-Printer")
  SoftwareHelp_L("1 | no MSX-Printer (e.g. Epson compatible)")
  SoftwareHelp_L("If printertype is not specified the last value remains unchanged.")
  SoftwareHelp_L("The default value is 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("interlacemode enables to set the interlace functions of VDP (see Interlace mode).")
  SoftwareHelp_L("In the alternate screen display mode, the display page specified in " + Chr(34) + "SET PAGE" + Chr(34) + " must be odd.")
  SoftwareHelp_L("In this case the display page and the page of which the number is smaller by one is displayed alternately.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If interlacemode is not specified the last value remains unchanged.")
  SoftwareHelp_L("The default value is 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2: adds screenmodes 4-8, interlacemode is added too.")
  SoftwareHelp_L("The values of the last used text screenmode (0 or 1), keyclick,")
  SoftwareHelp_L("baudrate and printertype can be saved by using " + Chr(34) + "SET SCREEN" + Chr(34) + " statement")
  SoftwareHelp_L("and will be restored from the CMOS on power-up.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Korean MSX 2: adds screenmode 9.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX 2+: adds screenmodes 10-12 (mode 9 is supported on Korean computers only).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Turbo-R: the baudrate setting is ignored.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=2 TO 3")
  SoftwareHelp_L("20 SCREEN I:COLOR 15,4,7")
  SoftwareHelp_L("30 LINE (32,32)-(200,132),6")
  SoftwareHelp_L("40 FOR K=0 TO 3000:NEXT")
  SoftwareHelp_L("50 NEXT I")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("INPUT,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("PAINT,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PRESET,")
  SoftwareHelp_L("WIDTH,")
  SoftwareHelp_L("CLS,")
  SoftwareHelp_L("CALL CLS,")
  SoftwareHelp_L("CALL KANJI,")
  SoftwareHelp_L("CALL ANK,")
  SoftwareHelp_L("SET PAGE,")
  SoftwareHelp_L("SET SCREEN")
  SoftwareHelp_Commit("SCREEN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SGN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SGN(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the value 1 if number is > 0,")
  SoftwareHelp_L("returns the value 0 if number is = 0 and")
  SoftwareHelp_L("returns the value -1 if number is < 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 INPUT " + Chr(34) + "Number" + Chr(34) + ";N")
  SoftwareHelp_L("20 IF N1 THEN GOTO 10")
  SoftwareHelp_L("30 H=SGN(N):H=H+2")
  SoftwareHelp_L("40 ON H GOSUB 70,80,90")
  SoftwareHelp_L("50 PRINT B$")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("70 B$=" + Chr(34) + "Number is negative" + Chr(34) + ":RETURN")
  SoftwareHelp_L("80 B$=" + Chr(34) + "Number is zero" + Chr(34) + ":RETURN")
  SoftwareHelp_L("90 B$=" + Chr(34) + "Number is positive" + Chr(34) + ":RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ABS")
  SoftwareHelp_Commit("SGN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SIN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SIN(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the sinus of the specified number in radians. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 X=5")
  SoftwareHelp_L("20 PRINT SIN(X)")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ATN,")
  SoftwareHelp_L("COS,")
  SoftwareHelp_L("TAN")
  SoftwareHelp_Commit("SIN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SOUND")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SOUND register, value")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Writes a value into the PSG register.")
  SoftwareHelp_L("")
  SoftwareHelp_L("register is the register-number and must be an integer betwenn 0 and 15.")
  SoftwareHelp_L("")
  SoftwareHelp_L("value is the value to be written into the register.")
  SoftwareHelp_L("This must be an integer between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("USE THIS STATEMENT ONLY IF YOU ARE FAMILIAR WITH THE PSG")
  SoftwareHelp_L("(PROGRAMMABLE SOUND GENERATOR).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=0 TO 13")
  SoftwareHelp_L("20 SOUND I,0")
  SoftwareHelp_L("30 NEXT I")
  SoftwareHelp_L("40 SOUND 7,62:SOUND 8,15")
  SoftwareHelp_L("50 FOR I=0 TO 255")
  SoftwareHelp_L("60 SOUND 0,I")
  SoftwareHelp_L("70 NEXT I")
  SoftwareHelp_L("80 SOUND 8,0")
  SoftwareHelp_L("90 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PLAY,")
  SoftwareHelp_L("BEEP,")
  SoftwareHelp_L("CALL AUDREG (MSX-Music)")
  SoftwareHelp_Commit("SOUND", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SPACE$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SPACE$(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Generates an alphanumeric string with number of spaces.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number must be an integer between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=0 TO 5")
  SoftwareHelp_L("20 A$=SPACE$(I)")
  SoftwareHelp_L("30 PRINT A$;I")
  SoftwareHelp_L("40 NEXT I")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L(" 1")
  SoftwareHelp_L("  2")
  SoftwareHelp_L("   3")
  SoftwareHelp_L("    4")
  SoftwareHelp_L("     5")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("STRING$,")
  SoftwareHelp_L("TAB,")
  SoftwareHelp_L("SPC")
  SoftwareHelp_Commit("SPACE$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SPC")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SPC(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints number of characters.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function can only be used with " + Chr(34) + "PRINT" + Chr(34) + " and " + Chr(34) + "LPRINT" + Chr(34) + " statements.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number must be an integer between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("LPRINT,")
  SoftwareHelp_L("TAB,")
  SoftwareHelp_L("SPACE$,")
  SoftwareHelp_L("STRING$")
  SoftwareHelp_Commit("SPC", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SPRITE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SPRITE ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("SPRITE OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("SPRITE STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Checks for sprite-collisions.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "SPRITE ON" + Chr(34) + " statement MSX-Basic checks with every statement")
  SoftwareHelp_L("if two sprites are overlapping. If so MSX-Basic calls the subroutine,")
  SoftwareHelp_L("that was specified in the " + Chr(34) + "ON SPRITE GOSUB" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the " + Chr(34) + "SPRITE OFF" + Chr(34) + " statement is set, MSX-Basic does no longer check")
  SoftwareHelp_L("for collisions.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "SPRITE STOP" + Chr(34) + " statement MSX-Basic checks for collisions,")
  SoftwareHelp_L("but does not call the subroutine that was specified in the " + Chr(34) + "ON SPRITE GOSUB" + Chr(34))
  SoftwareHelp_L("statement. But collisions are remembered. In this case the subroutine")
  SoftwareHelp_L("is immediately called after the " + Chr(34) + "SPRITE ON" + Chr(34) + " statement is executed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 DATA 60,66,165,129,165,153,66,60")
  SoftwareHelp_L("20 DATA 60,126,219,255,255,219,102,60")
  SoftwareHelp_L("30 A$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("40 FOR I=1 TO 8")
  SoftwareHelp_L("50 READ A:A$=A$+CHR$(A)")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 B$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("80 FOR I=1 TO 8")
  SoftwareHelp_L("90 READ A:B$=B$+CHR$(A)")
  SoftwareHelp_L("100 NEXT I")
  SoftwareHelp_L("110 SCREEN 2,1:COLOR 15,4,1")
  SoftwareHelp_L("120 ON SPRITE GOSUB 210")
  SoftwareHelp_L("130 SPRITE$(0)=A$:SPRITE$(1)=B$")
  SoftwareHelp_L("140 SPRITE ON")
  SoftwareHelp_L("150 A=INT(RND(1)*256)")
  SoftwareHelp_L("160 B=INT(RND(1)*256)")
  SoftwareHelp_L("170 FOR I=0 TO 191")
  SoftwareHelp_L("180 PUT SPRITE 0,(A,I),1")
  SoftwareHelp_L("190 PUT SPRITE 1,(B,191-I),15")
  SoftwareHelp_L("200 NEXT I:GOTO 140")
  SoftwareHelp_L("210 SPRITE OFF")
  SoftwareHelp_L("220 PLAY " + Chr(34) + "L4CDEFEDCREFGAGFER" + Chr(34))
  SoftwareHelp_L("230 PUT SPRITE 0,(0,208)")
  SoftwareHelp_L("240 PUT SPRITE 1,(0,208)")
  SoftwareHelp_L("250 I=191:RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON SPRITE GOSUB")
  SoftwareHelp_Commit("SPRITE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SPRITE$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SPRITE$(number)=string")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Contains the definition of sprites in graphic mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number stays for the number of sprites. If the sprite-size has been specified")
  SoftwareHelp_L("with 0 or 1 (by using the " + Chr(34) + "SCREEN" + Chr(34) + " statement), then number must be an integer")
  SoftwareHelp_L("between 0 and 255.")
  SoftwareHelp_L("If the sprite-size has been specified with 2 or 3, then number must be an integer")
  SoftwareHelp_L("between 0 and 63.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The contents of the variable " + Chr(34) + "SPRITE$" + Chr(34) + " can be a binary, a hexadecimal or decimal value")
  SoftwareHelp_L("- as down in the following example:")
  SoftwareHelp_L("Binary | Hexadecimal | Decimal")
  SoftwareHelp_L("█ | █ | &B00011000 | &H18 | 24")
  SoftwareHelp_L("█ | █ | █ | █ | &B00111100 | &H3C | 60")
  SoftwareHelp_L("█ | █ | █ | █ | █ | █ | &B01111110 | &H7E | 126")
  SoftwareHelp_L("█ | █ | █ | █ | █ | █ | █ | █ | &B11111111 | &HFF | 255")
  SoftwareHelp_L("█ | █ | &B00100100 | &H24 | 36")
  SoftwareHelp_L("█ | █ | &B00100100 | &H24 | 36")
  SoftwareHelp_L("█ | █ | &B01000010 | &H42 | 66")
  SoftwareHelp_L("█ | █ | &B10000001 | &H81 | 129")
  SoftwareHelp_L("Binary definition:")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 SCREEN 2,0")
  SoftwareHelp_L("20 Y=1")
  SoftwareHelp_L("30 B$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("40 FOR I=1 TO 8")
  SoftwareHelp_L("50 READ A$:B$=B$+CHR$(VAL(" + Chr(34) + "&B" + Chr(34) + "+A$))")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 SPRITE$(0)=B$")
  SoftwareHelp_L("80 FOR X=1 TO 200")
  SoftwareHelp_L("90 Y=Y+1")
  SoftwareHelp_L("100 PUT SPRITE 0,(X,Y)")
  SoftwareHelp_L("110 NEXT X")
  SoftwareHelp_L("120 END")
  SoftwareHelp_L("130 DATA 00011000,00111100,01111110,11111111,00100100,00100100,010000010,10000001")
  SoftwareHelp_L("")
  SoftwareHelp_L("Hexadecimal definition:")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 SCREEN 2,0")
  SoftwareHelp_L("20 Y=1")
  SoftwareHelp_L("30 B$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("40 FOR I=1 TO 8")
  SoftwareHelp_L("50 READ A$:B$=B$+CHR$(VAL(" + Chr(34) + "&H" + Chr(34) + "+A$))")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 SPRITE$(0)=B$")
  SoftwareHelp_L("80 FOR X=1 TO 200")
  SoftwareHelp_L("90 Y=Y+1")
  SoftwareHelp_L("100 PUT SPRITE 0,(X,Y)")
  SoftwareHelp_L("110 NEXT X")
  SoftwareHelp_L("120 END")
  SoftwareHelp_L("130 DATA 18,3C,7E,FF,24,24,42,81")
  SoftwareHelp_L("")
  SoftwareHelp_L("Decimal definition:")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 SCREEN 2,0")
  SoftwareHelp_L("20 Y=1")
  SoftwareHelp_L("30 B$=" + Chr(34) + Chr(34))
  SoftwareHelp_L("40 FOR I=1 TO 8")
  SoftwareHelp_L("50 READ A$:B$=B$+CHR$(VAL(A$))")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 SPRITE$(0)=B$")
  SoftwareHelp_L("80 FOR X=1 TO 200")
  SoftwareHelp_L("90 Y=Y+1")
  SoftwareHelp_L("100 PUT SPRITE 0,(X,Y)")
  SoftwareHelp_L("110 NEXT X")
  SoftwareHelp_L("120 END")
  SoftwareHelp_L("130 DATA 24,60,126,255,36,36,66,129")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: ON SPRITE GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PUT SPRITE,")
  SoftwareHelp_L("ON SPRITE GOSUB")
  SoftwareHelp_Commit("SPRITE$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SQR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SQR(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the square-root of the specified number. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 X=10:Y!=SQR(X)")
  SoftwareHelp_L("20 PRINT Y!")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L(" 3.16228")
  SoftwareHelp_L("Ok")
  SoftwareHelp_Commit("SQR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STICK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STICK(sticknumber)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This function returns the direction of the joystick. The meaning of the returnvalue")
  SoftwareHelp_L("is as following:")
  SoftwareHelp_L("8 | 1 | 2")
  SoftwareHelp_L("7 | 0 | 3")
  SoftwareHelp_L("6 | 5 | 4")
  SoftwareHelp_L("")
  SoftwareHelp_L("The sticknumber can have the following values:")
  SoftwareHelp_L("")
  SoftwareHelp_L("0 = Cursor-keys (space is trigger)")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 = Joystick on port 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("2 = Joystick on port 2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Press the cursor-keys" + Chr(34))
  SoftwareHelp_L("20 PRINT STICK(0)")
  SoftwareHelp_L("30 FOR I=0 TO 300:NEXT I")
  SoftwareHelp_L("40 GOTO 20")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PAD,")
  SoftwareHelp_L("PDL,")
  SoftwareHelp_L("STRIG,")
  SoftwareHelp_L("INKEY$,")
  SoftwareHelp_L("ON GOSUB,")
  SoftwareHelp_L("ON GOTO")
  SoftwareHelp_Commit("STICK", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Terminates a programs execution. When the interpreter reaches the last line of the program,")
  SoftwareHelp_L("it is automaticly terminated, STOP is not necessary there. After STOP a CONT instruction")
  SoftwareHelp_L("can continue the program execution on the next line. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Test" + Chr(34))
  SoftwareHelp_L("20 STOP")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "CONT was used" + Chr(34))
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("END,")
  SoftwareHelp_L("RUN,")
  SoftwareHelp_L("CONT")
  SoftwareHelp_Commit("STOP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STOP ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("STOP OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("STOP STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Checks if the CTRL and STOP keys are pressed simultaneously.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "STOP" + Chr(34) + " stamement MSX_Basic checks with every statement if the CTRL+STOP")
  SoftwareHelp_L("keys are pressed simultaneously. If so the MSX-Basic program calls the subroutine")
  SoftwareHelp_L("that was specified in the " + Chr(34) + "ON STOP GOSUB" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "STOP OFF" + Chr(34) + " statement MSX-Basic does no no longer check if CTRL+STOP")
  SoftwareHelp_L("keys are pressed simultaneously.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "STOP STOP" + Chr(34) + " statement MSX-Basic checks if CTRL+STOP are pressed")
  SoftwareHelp_L("simultaneously, but does not call the subroutine that was specified in the")
  SoftwareHelp_L(Chr(34) + "ON STOP GOSUB" + Chr(34) + " statement. But the state is remembered. In this case the")
  SoftwareHelp_L("subroutine is immediately called after the " + Chr(34) + "STOP ON" + Chr(34) + " statement is executed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 ON STOP GOSUB 50")
  SoftwareHelp_L("20 STOP ON")
  SoftwareHelp_L("30 INPUT A$")
  SoftwareHelp_L("40 IF A$=" + Chr(34) + "END" + Chr(34) + " THEN STOP OFF:END ELSE GOTO 30")
  SoftwareHelp_L("50 PRINT " + Chr(34) + "Enter END and press Return" + Chr(34) + ":RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("END")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON STOP GOSUB")
  SoftwareHelp_Commit("STOP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STR$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STR$(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Creates the alpanumeric representation of the numeric expression in number.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Use the " + Chr(34) + "VAL" + Chr(34) + " function to get the numeric representation of the alphanumeric expression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 AMOUNT=12.34216:PRINT AMOUNT")
  SoftwareHelp_L("20 A$=STR$(AMOUNT)")
  SoftwareHelp_L("30 H%=INSTR(A$," + Chr(34) + "." + Chr(34) + ")")
  SoftwareHelp_L("40 IF H%=<1 GOTO 80")
  SoftwareHelp_L("50 MID$(A$,H%,1)=" + Chr(34) + "," + Chr(34))
  SoftwareHelp_L("60 H$=LEFT$(A$,H%+2)")
  SoftwareHelp_L("70 PRINT H$")
  SoftwareHelp_L("80 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("12.34216")
  SoftwareHelp_L("12,34")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BIN$,")
  SoftwareHelp_L("HEX$,")
  SoftwareHelp_L("OCT$,")
  SoftwareHelp_L("VAL")
  SoftwareHelp_Commit("STR$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STRIG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STRIG(sticknumber)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the state of the Joysticks or space key.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number is a number between 0 and 4 and has the following meaning:")
  SoftwareHelp_L("0 | Space key")
  SoftwareHelp_L("1 | Joystick in connector 1")
  SoftwareHelp_L("2 | Joystick in connector 2")
  SoftwareHelp_L("3 | Joystick in connector 1")
  SoftwareHelp_L("4 | Joystick in connector 2")
  SoftwareHelp_L("If the joystick or space key are activated the function returns -1.")
  SoftwareHelp_L("If not 0 is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "Hit the space key" + Chr(34))
  SoftwareHelp_L("20 P=STRIG(0)")
  SoftwareHelp_L("30 IF P=-1 THEN BEEP")
  SoftwareHelp_L("40 GOTO 20")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PAD,")
  SoftwareHelp_L("PDL,")
  SoftwareHelp_L("STICK,")
  SoftwareHelp_L("INKEY$")
  SoftwareHelp_Commit("STRIG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STRIG")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STRIG(number) ON")
  SoftwareHelp_L("")
  SoftwareHelp_L("STRIG(number) OFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("STRIG(number) STOP")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Checks the status if the joystick or space key.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number is a number between 0 and 4 and has the following meaning:")
  SoftwareHelp_L("0 | Space key")
  SoftwareHelp_L("1 | Joystick in connector 1")
  SoftwareHelp_L("2 | Joystick in connector 2")
  SoftwareHelp_L("3 | Joystick in connector 1")
  SoftwareHelp_L("4 | Joystick in connector 2")
  SoftwareHelp_L("After the " + Chr(34) + "STRIG(number) ON" + Chr(34) + " statement MSX-Basic checks with every statement")
  SoftwareHelp_L("if the specified joystick button is pressed. If so MSX-Basic calls the subroutine,")
  SoftwareHelp_L("that was specified in the " + Chr(34) + "ON STRIG GOSUB" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "STRIG(number) OFF" + Chr(34) + " statement MSX-Basic no longer checks, if the")
  SoftwareHelp_L("specified joystick button is pressed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "STRIG(number) STOP" + Chr(34) + " statement MSX-Basic checks if the specified")
  SoftwareHelp_L("joystick button is pressed, but does not call the subroutine that was specified")
  SoftwareHelp_L("in the " + Chr(34) + "ON STRIG GOSUB" + Chr(34) + " statement. But the state is remembered and the subroutine")
  SoftwareHelp_L("is automatically called after the " + Chr(34) + "STRIG(number) ON" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: ON STRIG GOSUB")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ON STRIG GOSUB")
  SoftwareHelp_Commit("STRIG", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## STRING$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("STRING$(length, character)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Creates a string with length characters, which consists only")
  SoftwareHelp_L("of characters that was specified in character.")
  SoftwareHelp_L("")
  SoftwareHelp_L("length is the length of the alpanumeric value and must be")
  SoftwareHelp_L("an integer in range between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("character is the code of the character and must be an integer")
  SoftwareHelp_L("between 32 and 255, or the corresponding character (string) directly.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 1:COLOR 15,4,7")
  SoftwareHelp_L("20 A$=CHR$(42)")
  SoftwareHelp_L("30 FOR K=1 TO 22")
  SoftwareHelp_L("40 C=INT(RND(1)*20)")
  SoftwareHelp_L("50 LOCATE 3,K")
  SoftwareHelp_L("60 PRINT USING " + Chr(34) + "##" + Chr(34) + ";C")
  SoftwareHelp_L("70 LOCATE 6,K")
  SoftwareHelp_L("80 PRINT STRING$(C,A$)")
  SoftwareHelp_L("90 NEXT K")
  SoftwareHelp_L("100 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SPACE$,")
  SoftwareHelp_L("SPC,")
  SoftwareHelp_L("TAB")
  SoftwareHelp_Commit("STRING$", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SWAP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SWAP variable, variable2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Exchanges the contents of two variables.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Every type of variable (integer, single precision, double precision, alphanumeric)")
  SoftwareHelp_L("can be used. The only restriction is that both variables are of the same type.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 X=3:Y=7")
  SoftwareHelp_L("20 GOSUB 60")
  SoftwareHelp_L("30 SWAP X,Y")
  SoftwareHelp_L("40 GOSUB 60")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("60 PRINT " + Chr(34) + "X=" + Chr(34) + ";X;" + Chr(34) + "Y=" + Chr(34) + ";Y")
  SoftwareHelp_L("70 RETURN")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LET")
  SoftwareHelp_Commit("SWAP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## TAB")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("TAB(position)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Sets a tabulator. The cursor jumps to a pre-defined position in the same line.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This function can only be used with " + Chr(34) + "PRINT" + Chr(34) + " and " + Chr(34) + "LPRINT" + Chr(34) + " statements.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number must be an integer between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the cursor has already reached the specified position the function is ignored.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 PRINT " + Chr(34) + "0" + Chr(34) + ";TAB(9);" + Chr(34) + "9" + Chr(34))
  SoftwareHelp_L("20 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PRINT,")
  SoftwareHelp_L("LPRINT,")
  SoftwareHelp_L("SPC,")
  SoftwareHelp_L("SPACE$,")
  SoftwareHelp_L("STRING$")
  SoftwareHelp_Commit("TAB", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## TAN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("TAN(number)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the tangent of the specified number in radians. ")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 X=5")
  SoftwareHelp_L("20 PRINT TAN(X)")
  SoftwareHelp_L("30 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L(" -3.3805150062446")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ATN,")
  SoftwareHelp_L("COS,")
  SoftwareHelp_L("SIN")
  SoftwareHelp_Commit("TAN", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## TIME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("TIME")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Contains the internal system-time.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Every time the video display processor creates an interrupt (every 1/60s or 1/50s),")
  SoftwareHelp_L("the variable " + Chr(34) + "TIME" + Chr(34) + " is incremented by 1.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If no interrupt is generated (e.g. while saving a program to tape or loading from tape)")
  SoftwareHelp_L("the " + Chr(34) + "TIME" + Chr(34) + " variable remains unchanged.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 CLS")
  SoftwareHelp_L("20 LOCATE 10,6")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "HH:MM:SS START" + Chr(34))
  SoftwareHelp_L("40 TIME=0")
  SoftwareHelp_L("50 T=TIME")
  SoftwareHelp_L("60 H=INT(T/180000)")
  SoftwareHelp_L("70 T=T-(H*180000)")
  SoftwareHelp_L("80 M=INT(T/3000)")
  SoftwareHelp_L("90 T=T-(M*3000)")
  SoftwareHelp_L("100 S=INT(T/50)")
  SoftwareHelp_L("110 LOCATE 10,8")
  SoftwareHelp_L("120 PRINT USING " + Chr(34) + "##:##:##" + Chr(34) + ";H;M;S")
  SoftwareHelp_L("130 GOTO 50")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RND,")
  SoftwareHelp_L("GET TIME")
  SoftwareHelp_Commit("TIME", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## TROFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("TROFF")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Disable tracing of the program execution.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The trace function is enabled with the " + Chr(34) + "TRON" + Chr(34) + " statement.")
  SoftwareHelp_L("The trace function can also be disabled with the " + Chr(34) + "NEW" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: TRON")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("TRON,")
  SoftwareHelp_L("NEW")
  SoftwareHelp_Commit("TROFF", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## TRON")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("TRON")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Enables the trace function.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After the " + Chr(34) + "TRON" + Chr(34) + " statement MSX-Basic prints all program-lines")
  SoftwareHelp_L("(that are executed during the program flow) in brackets.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=1 TO 3")
  SoftwareHelp_L("20 PRINT I")
  SoftwareHelp_L("30 NEXT")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("TRON")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("[10][20] 1")
  SoftwareHelp_L("[30][20] 2")
  SoftwareHelp_L("[30][20] 3")
  SoftwareHelp_L("[30][40]")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("TROFF")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("TROFF")
  SoftwareHelp_Commit("TRON", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## USR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("USR[<number>] (argument)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Starts a machine-language program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("number is an integer between 0 and 9. If number is not specified 0 will be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The start-address of the machine-language program must be specified by using the DEF USR statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("argument is the value, that is passed to the machine-language subroutine.")
  SoftwareHelp_L("It can be passed in the following ways:")
  SoftwareHelp_L("")
  SoftwareHelp_L("For alphanumeric values")
  SoftwareHelp_L("")
  SoftwareHelp_L("Memory address &HF663 contains the value 3.")
  SoftwareHelp_L("Memory address &HF7F8 and &HF7F9 contains the address of the type of the alphanumeric value.")
  SoftwareHelp_L("The type contains 3 bytes. The first byte is the length of the alphanumeric value, the second and")
  SoftwareHelp_L("third contains the memory-address of the alphanumeric value.")
  SoftwareHelp_L("For integer values")
  SoftwareHelp_L("")
  SoftwareHelp_L("The memory address &HF663 contains the value 2.")
  SoftwareHelp_L("Memory address &HF7F8 and &HF7F9 contains the value of the integer.")
  SoftwareHelp_L("For single precision values")
  SoftwareHelp_L("")
  SoftwareHelp_L("The memory address &HF663 contains the value 4.")
  SoftwareHelp_L("Memory address &HF7F6 to &HF7F9 contains the single precision value.")
  SoftwareHelp_L("For double precision values")
  SoftwareHelp_L("")
  SoftwareHelp_L("The memory address &HF663 contains the value 8.")
  SoftwareHelp_L("Memory address &HF7F6 to &HF7FD contains the double precision value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Values that are returned from the machine-language to MSX-Basic have to be provided in")
  SoftwareHelp_L("the same way from the machine-language program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Use the " + Chr(34) + "CLEAR" + Chr(34) + " statement to reserve the necessary memory for the machine-language program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("DEF USR1=&H156:A=USR1(0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 CLEAR 200,&HEFFF")
  SoftwareHelp_L("20 AB=&HF000")
  SoftwareHelp_L("30 FOR I=AB TO AB+9")
  SoftwareHelp_L("40 READ A$:A=VAL(" + Chr(34) + "&H" + Chr(34) + "+A$)")
  SoftwareHelp_L("50 POKE I,A")
  SoftwareHelp_L("60 NEXT I")
  SoftwareHelp_L("70 DEFUSR=&HF000")
  SoftwareHelp_L("80 INPUT " + Chr(34) + "Enter an integer" + Chr(34) + ";A%")
  SoftwareHelp_L("90 PRINT " + Chr(34) + "The integer is" + Chr(34) + ";A%")
  SoftwareHelp_L("100 R=USR(A%)")
  SoftwareHelp_L("110 PRINT " + Chr(34) + "Result is the integer plus 1" + Chr(34) + ";R")
  SoftwareHelp_L("120 END")
  SoftwareHelp_L("130 DATA 23,23,4E,23,46,03,70,2B,71,C9")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DEFUSR,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("POKE,")
  SoftwareHelp_L("VARPTR,")
  SoftwareHelp_L("CLEAR")
  SoftwareHelp_Commit("USR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## VAL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("VAL(string)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the value of the alphanumeric expression in string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The function ignores spaces and control-characters in the expression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "STR$" + Chr(34) + " function can be used to get an alphanumeric representation of a numeric expression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 AMOUNT=12.34216:PRINT AMOUNT")
  SoftwareHelp_L("20 A$=STR$(AMOUNT)")
  SoftwareHelp_L("30 H%=INSTR(A$," + Chr(34) + "." + Chr(34) + ")")
  SoftwareHelp_L("40 IF H%=<1 GOTO 80")
  SoftwareHelp_L("50 H%=H%+2")
  SoftwareHelp_L("60 B$=LEFT$(A$,H%)")
  SoftwareHelp_L("70 AMOUNT=VAL(B$):PRINT AMOUNT")
  SoftwareHelp_L("80 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("12.34216")
  SoftwareHelp_L("12.34")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BIN$,")
  SoftwareHelp_L("HEX$,")
  SoftwareHelp_L("OCT$,")
  SoftwareHelp_L("STR$")
  SoftwareHelp_Commit("VAL", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## VARPTR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic, RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("VARPTR(variable)")
  SoftwareHelp_L("")
  SoftwareHelp_L("VARPTR(#channel)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the memory-address of the first byte of a variable")
  SoftwareHelp_L("or the first byte of a file-control-block (of an open file).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The first format returns the memory-address of a variable. This variable")
  SoftwareHelp_L("must be already initialized with a value, otherwise an " + Chr(34) + "Illegal function call" + Chr(34) + " will be generated.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Every type of variable (integer, single precision, double precision, alphanumeric)")
  SoftwareHelp_L("and dimensioned variables (defined by the " + Chr(34) + "DIM" + Chr(34) + " statement) can be used with the")
  SoftwareHelp_L(Chr(34) + "VARPTR" + Chr(34) + " function.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Before the address of a dimensioned variable can be accessed its necessary to assign")
  SoftwareHelp_L("a value to all non-dimensioned variables. This is required because adresses of")
  SoftwareHelp_L("dimensioned variables will change if new not-dimensioned variables are used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The function " + Chr(34) + "VARPTR" + Chr(34) + " is most recently used to get the memory-address of a variable,")
  SoftwareHelp_L("which should be passed to an assembly-language subroutine.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The second format returns the first address of the file-control-block of a file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("channel is the file-number of the file, which was opened with the " + Chr(34) + "OPEN" + Chr(34) + " statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The " + Chr(34) + "VARPTR" + Chr(34) + " function returns a value between -32768 and 32767. If a negative value is")
  SoftwareHelp_L("given 65536 is added first to get the actual address.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A=10")
  SoftwareHelp_L("20 B=VARPTR(A)")
  SoftwareHelp_L("30 IF B<0 THEN B=B+65536")
  SoftwareHelp_L("40 C$=" + Chr(34) + "0000" + Chr(34) + "+HEX$(B)")
  SoftwareHelp_L("50 PRINT RIGHT$(C$,4)")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("C059")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("PEEK,")
  SoftwareHelp_L("POKE,")
  SoftwareHelp_L("DEFUSR,")
  SoftwareHelp_L("USR,")
  SoftwareHelp_L("DIM,")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("VARPTR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## VDP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("VDP(register)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Contains the value of the specified VDP register (video display processor).")
  SoftwareHelp_L("")
  SoftwareHelp_L("register is the register number and must be an integer between 0 and 8.")
  SoftwareHelp_L("The content of register 8 is read-only and cannot be changed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX2: registers 9 to 24 and 33 to 47 are added.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX2+ registers 26-28 are added.")
  SoftwareHelp_L("")
  SoftwareHelp_L("USE THIS VARIABLE ONLY IF YOU ARE FAMILIAR WITH THE VDP (VIDEO DISPLAY PROCESSOR).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 FOR I=0 TO 8")
  SoftwareHelp_L("20 A=VDP(I)")
  SoftwareHelp_L("30 B$=" + Chr(34) + "00000000" + Chr(34) + "+BIN$(A)")
  SoftwareHelp_L("40 PRINT RIGHT$(B$,8)")
  SoftwareHelp_L("50 NEXT I")
  SoftwareHelp_L("60 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BASE")
  SoftwareHelp_Commit("VDP", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## VPEEK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("VPEEK(adress)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the value of a byte within the video-memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The function returns a byte-value for the specified address and is")
  SoftwareHelp_L("therefore in range between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("address is the address within the video-memory and must be in range between 0 and 16383")
  SoftwareHelp_L("(or -32768 and 32767).")
  SoftwareHelp_L("")
  SoftwareHelp_L("The statement " + Chr(34) + "VPOKE" + Chr(34) + " can be used to write a byte into the video memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX2: the size of video-memory has been increased from 16KB to 64KB and more,")
  SoftwareHelp_L("therefore address can be in range from -32768 to 32767.")
  SoftwareHelp_L("")
  SoftwareHelp_L("USE THIS FUNCTION ONLY IF YOU ARE FAMILIAR WITH THE VDP (VIDEO DISPLAY PROCESSOR)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 A=VPEEK(0)")
  SoftwareHelp_L("20 A$=" + Chr(34) + "00" + Chr(34) + "+HEX$(A)")
  SoftwareHelp_L("30 PRINT RIGHT$(A$,2)")
  SoftwareHelp_L("40 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("1000 REM ********************")
  SoftwareHelp_L("1010 REM Hardcopy of screen 0")
  SoftwareHelp_L("1020 REM ********************")
  SoftwareHelp_L("1030 LPRINT CHR$(13):FOR I=0 TO 959")
  SoftwareHelp_L("1040 LPRINT CHR$(VPEEK(I));")
  SoftwareHelp_L("1050 IF I>0 AND (I+1)/40=INT((I+1)/40) THEN LPRINT CHR$(13);")
  SoftwareHelp_L("1060 NEXT I")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("VPOKE,")
  SoftwareHelp_L("PEEK,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("SET PAGE")
  SoftwareHelp_Commit("VPEEK", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## VPOKE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("VPOKE adress,value")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Writes a byte into the video-memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("address is the address within the video-memory and must be")
  SoftwareHelp_L("in range between 0 and 16383 (or -32768 and 32767).")
  SoftwareHelp_L("")
  SoftwareHelp_L("value is the byte value and must be between 0 and 255.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The function " + Chr(34) + "VPEEK" + Chr(34) + " can be used to read a byte from video-memory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX2: the size of video-memory has been increased from 16KB to 64KB and more,")
  SoftwareHelp_L("therefore address can be in range from -32768 to 32767.")
  SoftwareHelp_L("")
  SoftwareHelp_L("USE THIS FUNCTION ONLY IF YOU ARE FAMILIAR WITH THE VDP (VIDEO DISPLAY PROCESSOR)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 VPOKE 0,(VPEEK(0))")
  SoftwareHelp_L("20 END")
  SoftwareHelp_L("RUN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("VPEEK,")
  SoftwareHelp_L("POKE,")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("SET PAGE")
  SoftwareHelp_Commit("VPOKE", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## WAIT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("WAIT port, xormask[, andmask]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Monitors the status of a machine input-port port.")
  SoftwareHelp_L("")
  SoftwareHelp_L("While this statement is executed data from the port is read")
  SoftwareHelp_L("and compared with xormask (on XOR base) and andmask")
  SoftwareHelp_L(" (on AND base)")
  SoftwareHelp_L(".")
  SoftwareHelp_L("If the result of this comparison is 0, then MSX-Basic reads the port")
  SoftwareHelp_L("again and compares the data. In all other cases the program will be continued.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If andmask is not specified the value 0 will be assumed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("See: INP and OUT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("INP,")
  SoftwareHelp_L("OUT,")
  SoftwareHelp_L("XOR,")
  SoftwareHelp_L("AND")
  SoftwareHelp_Commit("WAIT", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## WIDTH")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("WIDTH textwidth")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Specifies the number of positions in a single screenline for textmode 1 and 2.")
  SoftwareHelp_L("")
  SoftwareHelp_L("textwidth is the number of positions per line and must be an integer between 1 and 40")
  SoftwareHelp_L("(or 1 and 80) in textmode 1 and an integer between 1 and 32 in textmode 2.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If MSX-Basic starts Textmode 1 uses " + Chr(34) + "WIDTH 37" + Chr(34) + " and textmode 2 uses " + Chr(34) + "WIDTH 19" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("MSX2: the textmode 1 can now have up to 80 characters, therefore the textwidth")
  SoftwareHelp_L("can be in range between 1 and 80. If textwidth is > 40 the 80 character mode is")
  SoftwareHelp_L("activated, if textwidth is <= 40 the 40 character mode is activated.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The width can also be saved by using the " + Chr(34) + "SET SCREEN" + Chr(34) + " statement, so the system will restore")
  SoftwareHelp_L("the changed defaults on power-up.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("5 SCREEN 0")
  SoftwareHelp_L("10 FOR I=37 TO 10 STEP -1")
  SoftwareHelp_L("15 WIDTH I")
  SoftwareHelp_L("20 PRINT " + Chr(34) + "This is a line of text on the screen" + Chr(34))
  SoftwareHelp_L("25 FOR X=1 TO 300:NEXT")
  SoftwareHelp_L("30 REM line 25 is a time-delay")
  SoftwareHelp_L("35 NEXT I")
  SoftwareHelp_L("40 WIDTH 40")
  SoftwareHelp_L("45 REM line 40 restores the old format again")
  SoftwareHelp_L("50 END")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("SET SCREEN,")
  SoftwareHelp_L("CALL KANJI")
  SoftwareHelp_Commit("WIDTH", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## XOR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("number1 XOR number2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Logical exclusive or.")
  SoftwareHelp_L("0 XOR 0 | = | 0")
  SoftwareHelp_L("0 XOR 1 | = | 1")
  SoftwareHelp_L("1 XOR 0 | = | 1")
  SoftwareHelp_L("1 XOR 1 | = | 0")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("AND,")
  SoftwareHelp_L("EQV,")
  SoftwareHelp_L("IMP,")
  SoftwareHelp_L("MOD,")
  SoftwareHelp_L("NOT,")
  SoftwareHelp_L("OR,")
  SoftwareHelp_L("MSX-Basic operators")
  SoftwareHelp_Commit("XOR", "MSX-BASIC 1 (MSX)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL MNAME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL MNAME (" + Chr(34) + "old filename" + Chr(34) + " AS " + Chr(34) + "new filename" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement renames the specified file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("NAME,")
  SoftwareHelp_L("CALL MKILL")
  SoftwareHelp_Commit("CALL MNAME", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL MEMINI")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL MEMINI [(size)]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement specifies the amount of memory to be used as a RAM disk, initialises the RAM disk, and deletes all files. When the RAM disk is to be used, this statement should always be executed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Size is " + Chr(34) + "the amount of memory to be used as RAM disk minus 1" + Chr(34) + ". By default, the maximum size is allocated for RAM disk. " + Chr(34) + "CALL MEMINI(0)" + Chr(34) + " causes the RAM disk feature to be disabled.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL MEMINI(&H3FFF)")
  SoftwareHelp_L("")
  SoftwareHelp_L("See also:")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL MFILES,")
  SoftwareHelp_L("CALL RAMDISK")
  SoftwareHelp_L("RAM-Disk in MSX-Basic 2,")
  SoftwareHelp_L("RAM-Disk in Disk-Basic 2,")
  SoftwareHelp_L("RAM-Disk in MSX-DOS 2")
  SoftwareHelp_Commit("CALL MEMINI", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL MFILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL MFILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement displays file names on the RAM disk.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FILES,")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("CALL MEMINI")
  SoftwareHelp_Commit("CALL MFILES", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL MKILL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL MKILL(" + Chr(34) + "filename" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement deletes the specified file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("KILL,")
  SoftwareHelp_L("CALL MNAME")
  SoftwareHelp_Commit("CALL MKILL", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR=")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR=(palette no., red luminance, green lumincane, blue luminance)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Palette no. Condition: when screen mode is 0 to 7 or 10: 0 to 15. Numerical constant variable, array variable or expression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Red/green/blue luminance: 0 to 7. Integer constant")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("You can express 512 kind of colors by combining red, green and blue luminance. If you do not execute this command to a palette no, it's color stays default.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: use CALL PALETTE statement to specify palette color under Japanese input mode. If you try to use this COLOR statement during Japanese input mode, you will get " + Chr(34) + "Illegal function call" + Chr(34) + ". (Same is true with COLOR=NEW and COLOR=RESTORE statements).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 SCREEN 5")
  SoftwareHelp_L("110 FOR I=7 to 0 STEP -1")
  SoftwareHelp_L("120 CIRCLE(120,100),I*10+5,I")
  SoftwareHelp_L("130 PAINT(120,100),I,1")
  SoftwareHelp_L("140 NEXT I")
  SoftwareHelp_L("150 J=(J+1) MOD 8")
  SoftwareHelp_L("160 FOR I=0 to 7")
  SoftwareHelp_L("170 COLOR=(I,0,J,0)")
  SoftwareHelp_L("180 J=(J+1) MOD 8")
  SoftwareHelp_L("190 NEXT I")
  SoftwareHelp_L("200 GOTO 150")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL PALETTE,")
  SoftwareHelp_L("COLOR=RESTORE,")
  SoftwareHelp_L("COLOR=NEW,")
  SoftwareHelp_L("DRAW,")
  SoftwareHelp_L("LINE,")
  SoftwareHelp_L("CIRCLE,")
  SoftwareHelp_L("PSET,")
  SoftwareHelp_L("PAINT")
  SoftwareHelp_Commit("COLOR=", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR=NEW")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR=NEW")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement initialises the colour palette to the same state")
  SoftwareHelp_L("as when the power of the computer is turned on (see Color-table).")
  SoftwareHelp_L("It is a good idea to place this statement at the beginning and the end of the program.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("COLOR=NEW")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COLOR=,")
  SoftwareHelp_L("COLOR,")
  SoftwareHelp_L("COLOR=RESTORE")
  SoftwareHelp_Commit("COLOR=NEW", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR=RESTORE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR=RESTORE")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This commands substitues contents of " + Chr(34) + "Color Lookup Table" + Chr(34) + " inside VRAM, into VDP color palette registers.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Usage:")
  SoftwareHelp_L("")
  SoftwareHelp_L("COLOR=RESTORE (no options whatsoever; just this form)")
  SoftwareHelp_L("")
  SoftwareHelp_L("How it works, and how you use this:")
  SoftwareHelp_L("")
  SoftwareHelp_L("If you BSAVE with ,S option, you can save the contents of VIDEO RAM to the disk along with color palette infos. If you BLOAD with ,S option, you can load such palette data to VRAM. However, such color palette info is only set into lookup table, and do not make any changes to the actually displayed colors. If you execute COLOR=RESTORE, then you can set the info inside lookup table as color palette, and you can display the picture in the same color at the time you saved with BSAVE,S.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 SCREEN 2")
  SoftwareHelp_L("20 BLOAD " + Chr(34) + "BOX" + Chr(34) + ",S")
  SoftwareHelp_L("30 COLOR=RESTORE")
  SoftwareHelp_L("40 GOTO 40")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COLOR=,")
  SoftwareHelp_L("COLOR,")
  SoftwareHelp_L("COLOR=NEW")
  SoftwareHelp_Commit("COLOR=RESTORE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR SPRITE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR SPRITE(<plane>)=color")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Sets the color to the sprite of plane to the specified color.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This statement sets the whole sprite of the specified plane to the ")
  SoftwareHelp_L("color, this uses color for color specification. The format of ")
  SoftwareHelp_L("the color specification is valid for screen mode 4 through 8 (respectively 12).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Bitwise meanings of color:")
  SoftwareHelp_L("Bit 7 | Not used (disabled).")
  SoftwareHelp_L("Bit 6 | If 1, move the sprites of the successive planes together.")
  SoftwareHelp_L("                  The priority and conflict of sprites are ignored, and when")
  SoftwareHelp_L("                  sprites are piled up, they are displayed in the color")
  SoftwareHelp_L("                  which is OR-ed with their color numbers.")
  SoftwareHelp_L("                  For example, assuming that bit 6 of sprite plane 1 is " + Chr(34) + "0" + Chr(34) + " and bit 6 of ")
  SoftwareHelp_L("                  sprite plane 2 is " + Chr(34) + "1" + Chr(34) + ", only by moving sprite plane 1, will sprite plane 2 be ")
  SoftwareHelp_L("                  displayed displayed to be piled at the same location.")
  SoftwareHelp_L("Bit 5 | If 1, the conflict of sprites are ignored.")
  SoftwareHelp_L("Bit 4 | Unused.")
  SoftwareHelp_L("Bits 0-3 | Palette number (see color-table).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("COLOR SPRITE(0)=15")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COLOR,")
  SoftwareHelp_L("COLOR SPRITE$,")
  SoftwareHelp_L("PUT SPRITE")
  SoftwareHelp_Commit("COLOR SPRITE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COLOR SPRITE$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COLOR SPRITE$(<plane>)=string")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Sets the colour of each horizontal line of the sprite using string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("string consists of one to sixteen characters. Bits 0 throgh 3 of ")
  SoftwareHelp_L("the character's ASCII code are used for the colour specification, and bits 4 ")
  SoftwareHelp_L("through 7 are used to specify each function of the sprite.")
  SoftwareHelp_L(" ")
  SoftwareHelp_L("These specifications are valid only for screen modes 4 through 8 (respectively 12).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Bitwise meanings of string expression:")
  SoftwareHelp_L("Bit 7 | If 1, move the sprite to left by 32 dots.")
  SoftwareHelp_L("Bit 6 | If 1, move the sprites of the successive planes together.")
  SoftwareHelp_L("                  The priority and conflict of sprites are ignored, and when")
  SoftwareHelp_L("                  sprites are piled up, they are displayed in the color")
  SoftwareHelp_L("                  which is OR-ed with their color numbers.")
  SoftwareHelp_L("                  For example, assuming that bit 6 of sprite plane 1 is " + Chr(34) + "0" + Chr(34) + " and bit 6 of ")
  SoftwareHelp_L("                  sprite plane 2 is " + Chr(34) + "1" + Chr(34) + ", only by moving sprite plane 1, will sprite plane 2 be ")
  SoftwareHelp_L("                  displayed displayed to be piled at the same location.")
  SoftwareHelp_L("Bit 5 | If 1, the conflict of sprites are ignored.")
  SoftwareHelp_L("Bit 4 | Unused.")
  SoftwareHelp_L("Bits 0-3 | Palette number (see color-table).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Relation of the sprite and string:")
  SoftwareHelp_L("")
  SoftwareHelp_L("COLOR SPRITE$ = CHR$ (color of the first line) + CHR$ (color of the second ")
  SoftwareHelp_L("line) + ...... + CHR$ (color of the eight line)")
  SoftwareHelp_L("")
  SoftwareHelp_L("	   ---------------------------------")
  SoftwareHelp_L("Line 1 --> | * |   |   | * | * |   |   | * |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("Line 2 --> | * | * |   |   |   |   | * | * |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("	   |   |   |   |   |   |   |   |   |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("	   | * | * |   |   |   |   | * | * |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("	   |   |   | * |   |   | * |   |   |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("	   | * |   |   | * | * |   |   | * |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("	   | * | * |   |   |   |   | * | * |")
  SoftwareHelp_L("	   |---+---+---+---+---+---+---+---|")
  SoftwareHelp_L("Line 8 --> |   |   | * | * | * | * |   |   | The color for each line")
  SoftwareHelp_L("	   --------------------------------- can be set.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("COLOR SPRITE$(0)=STRING$(16,&HFF)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COLOR,")
  SoftwareHelp_L("COLOR SPRITE,")
  SoftwareHelp_L("PUT SPRITE")
  SoftwareHelp_Commit("COLOR SPRITE$", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## GET DATE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("GET DATE string-variable [,A]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement is for reading the date from the timer and assigning it to the string variable.")
  SoftwareHelp_L("The format of date to be read is as follows:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Japanese: | YY/MM/DD | (YY = lower two digits of year, MM = month, DD = day)")
  SoftwareHelp_L("      e.g. 85/03/23 (March 23, 1985)")
  SoftwareHelp_L("International: | MM/DD/YY | (YY = lower two digits of year, MM = month, DD = day)")
  SoftwareHelp_L("      e.g. 03/23/85 (March 23, 1985)")
  SoftwareHelp_L("Korean: | DD/MM/YY | (YY = lower two digits of year, MM = month, DD = day)")
  SoftwareHelp_L("      e.g. 23/03/85 (March 23, 1985)")
  SoftwareHelp_L("")
  SoftwareHelp_L("When option A is specified, the alarm date is read.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("GET DATE D$")
  SoftwareHelp_L("PRINT D$")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GET TIME,")
  SoftwareHelp_L("SET DATE,")
  SoftwareHelp_L("CALL GREG")
  SoftwareHelp_Commit("GET DATE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## GET TIME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("GET TIME string-variable [,A]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement is for reading time from the timer and assigning it to a string variable.")
  SoftwareHelp_L("The form of time to be read is as follows:")
  SoftwareHelp_L("")
  SoftwareHelp_L("HH:MM:SS(HH = hour, MM = minute, SS = second)")
  SoftwareHelp_L("")
  SoftwareHelp_L("e.g. 22:15:00(22 hours 15 minutes 0 seconds)")
  SoftwareHelp_L("")
  SoftwareHelp_L("When A is specified, the time for the alarm time is read.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("GET TIME T$")
  SoftwareHelp_L("PRINT T$")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GET DATE,")
  SoftwareHelp_L("SET TIME,")
  SoftwareHelp_L("TIME,")
  SoftwareHelp_L("CALL TIME")
  SoftwareHelp_Commit("GET TIME", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET ADJUST")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET ADJUST(x,y)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets the location to display on the screen.")
  SoftwareHelp_L("The coordinate offset is from -7 to 8.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET ADJUST(0,0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET SCROLL")
  SoftwareHelp_Commit("SET ADJUST", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET BEEP")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET BEEP timbre, volume")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets BEEP sound. Timbre and volume are from 1 to 4.")
  SoftwareHelp_L("The table below shows the correspondance of timbre and to the actual sound.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Timbre | Sound")
  SoftwareHelp_L("1 | High tone beep (same as MSX1)")
  SoftwareHelp_L("2 | Low tone beep")
  SoftwareHelp_L("3 | 2 - tone beep")
  SoftwareHelp_L("4 | 3 - tone beep")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BEEP")
  SoftwareHelp_Commit("SET BEEP", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET DATE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET DATE " + Chr(34) + "date" + Chr(34) + " [,A]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets date to timer. The form of parameter and option is the same as")
  SoftwareHelp_L(Chr(34) + "GET DATE" + Chr(34) + ". When option A is specified, the alarm date is set.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET DATE " + Chr(34) + "85/03/23" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("GET DATE,")
  SoftwareHelp_L("SET TIME")
  SoftwareHelp_Commit("SET DATE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET PAGE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET PAGE [visible][,work]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement allows users to set the page to display and the page to read and write data to.")
  SoftwareHelp_L("This is valid when the screen mode is greater than 4, and the value specified depends on the")
  SoftwareHelp_L("VRAM capacity and the screen mode:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Screen mode | VRAM 64K | VRAM 128K")
  SoftwareHelp_L("SCREEN 5 | 0 to 1 | 0 to 3")
  SoftwareHelp_L("SCREEN 6 | 0 to 1 | 0 to 3")
  SoftwareHelp_L("SCREEN 7 | Unusable | 0 to 1")
  SoftwareHelp_L("SCREEN 8 | Unusable | 0 to 1")
  SoftwareHelp_L("SCREEN 10 | Unusable | 0 to 1")
  SoftwareHelp_L("SCREEN 11 | Unusable | 0 to 1")
  SoftwareHelp_L("SCREEN 12 | Unusable | 0 to 1")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("BSAVE,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("COPY,")
  SoftwareHelp_L("SCREEN")
  SoftwareHelp_Commit("SET PAGE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET PASSWORD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET PASSWORD " + Chr(34) + "password" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets a system password.")
  SoftwareHelp_L("Password is a string expression up to 255 characters.")
  SoftwareHelp_L("Once this statement is done, input of the password is requested for invoking the system.")
  SoftwareHelp_L("When the correct password is given, the system is normally invoked;")
  SoftwareHelp_L("otherwise, correct password input is requested. When the system is invoked by")
  SoftwareHelp_L("pressing both graphic key and stop key, no password input is requested")
  SoftwareHelp_L("(in this case, the password setting has been done by the key cartridge;")
  SoftwareHelp_L("however, password input is always required for system startup).")
  SoftwareHelp_L("The password is disabled by specifying a null character in SET TITLE.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET TITLE,")
  SoftwareHelp_L("SET PROMPT")
  SoftwareHelp_Commit("SET PASSWORD", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET PROMPT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET PROMPT " + Chr(34) + "prompt" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets the prompt. Prompt can have up to 6 characters.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET PROMPT " + Chr(34) + "Ready" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET PASSWORD,")
  SoftwareHelp_L("SET TITLE")
  SoftwareHelp_Commit("SET PROMPT", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET SCREEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET SCREEN")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement records the current parameters of the " + Chr(34) + "SCREEN" + Chr(34) + " statement.")
  SoftwareHelp_L("At the system startup, they are automatically set.")
  SoftwareHelp_L("Items to be recorded are the following:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Screen number of text mode")
  SoftwareHelp_L("Key click switch")
  SoftwareHelp_L("Screen width of text mode")
  SoftwareHelp_L("Printer option")
  SoftwareHelp_L("Foreground, background, and border colours")
  SoftwareHelp_L("Cassette baud rate")
  SoftwareHelp_L("Function key switch")
  SoftwareHelp_L("Display mode")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SCREEN,")
  SoftwareHelp_L("WIDTH")
  SoftwareHelp_Commit("SET SCREEN", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET TIME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET TIME " + Chr(34) + "time" + Chr(34) + " [,A]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement sets the time to the timer.")
  SoftwareHelp_L("The form of parameter and option is the same as " + Chr(34) + "GET TIME" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("e.g.) SET TIME " + Chr(34) + "22:15:00" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("When option A is specified, the alarm time is set.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET DATE,")
  SoftwareHelp_L("GET TIME")
  SoftwareHelp_Commit("SET TIME", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET TITLE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET TITLE " + Chr(34) + "greeting" + Chr(34) + " [, color]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("This statement specifies the title and the colour of the initial screen at system startup.")
  SoftwareHelp_L("The title is set by a string of up to 6 characters and color is one of the values")
  SoftwareHelp_L("listed below. When title is 6 characters, keyboard input is awaited just after the")
  SoftwareHelp_L("title screen is displayed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Color | Screen color")
  SoftwareHelp_L("1 | Blue")
  SoftwareHelp_L("2 | Green")
  SoftwareHelp_L("3 | Red")
  SoftwareHelp_L("4 | Orange")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET TITLE " + Chr(34) + "Hello" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET PROMPT,")
  SoftwareHelp_L("SET PASSWORD")
  SoftwareHelp_Commit("SET TITLE", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET VIDEO")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET VIDEO [mode[, Ym[, CB[, sync[, voice[, video input[, AV control]]]]]]]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("With this instruction is possible to define the so called 'superimpose mode'.")
  SoftwareHelp_L("Superimpose means that images could mix together (one on another).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Attention: This statement is for the superimposer or the digitiser which are optional, ")
  SoftwareHelp_L("so it can be used only for machines which are equipped with this the 'superimpose' capability.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Mode sets the superimposing mode and can be set to the value listed in ")
  SoftwareHelp_L("the following table. This indicates where the image comes from:")
  SoftwareHelp_L("Mode | S1 | S2 | TP | Display screen")
  SoftwareHelp_L("0 | 0 | 0 | 0 | Computer")
  SoftwareHelp_L("1 | 0 | 1 | 1 | Computer")
  SoftwareHelp_L("2 | 0 | 1 | 0 | Superimpose (together with another image, one on the other)")
  SoftwareHelp_L("3 | 1 | 0 | 0 | Television (from the input of the video)")
  SoftwareHelp_L("Note: In the case of mode 0, external sync cannot be used. In other modes the ")
  SoftwareHelp_L("compoalte output of VDP is not available. S1, S0, and TP are the names of ")
  SoftwareHelp_L("flags in the VDP register.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Ym specified the intensity (brightness) of the television.")
  SoftwareHelp_L("If not specified the value defaults to 0.")
  SoftwareHelp_L("Ym | brightness")
  SoftwareHelp_L("0 | half")
  SoftwareHelp_L("1 | full")
  SoftwareHelp_L("")
  SoftwareHelp_L("When CB is 1, the colour bus of VDP is prepared for input, and, when 0, it ")
  SoftwareHelp_L("is prepared for output. If not specified the value defaults to 0.")
  SoftwareHelp_L("CB | color-control")
  SoftwareHelp_L("0 | only for output")
  SoftwareHelp_L("1 | only for input")
  SoftwareHelp_L("")
  SoftwareHelp_L("When sync is 1, " + Chr(34) + "external sync" + Chr(34) + " is selected, and, when 0, " + Chr(34) + "internal sync" + Chr(34) + " ")
  SoftwareHelp_L("is selected. If not specified the value defaults to 0.")
  SoftwareHelp_L("sync | synchronisation")
  SoftwareHelp_L("0 | internal")
  SoftwareHelp_L("1 | external")
  SoftwareHelp_L("")
  SoftwareHelp_L("Voice specifies whether to mix external signal for output, and values are ")
  SoftwareHelp_L("listed in the following table. If not specified the value defaults to 0.")
  SoftwareHelp_L("Voice | Function for external voice signal")
  SoftwareHelp_L("0 | No mixing")
  SoftwareHelp_L("1 | Right channel mixed")
  SoftwareHelp_L("2 | Left channel mixed")
  SoftwareHelp_L("3 | Both channels mixed")
  SoftwareHelp_L("")
  SoftwareHelp_L("Video input is used to alternate the input of external video signals. When ")
  SoftwareHelp_L("it is 0, the RGB multiconnector is selected; when it is 1, external video ")
  SoftwareHelp_L("signal connector is selected. If not specified the value defaults to 0.")
  SoftwareHelp_L("Video input | external input")
  SoftwareHelp_L("0 | Euroconnector RGB (SCART)")
  SoftwareHelp_L("1 | Connector TV")
  SoftwareHelp_L("")
  SoftwareHelp_L("AV control specifies AV control terminal output of the RGB multiconnector. ")
  SoftwareHelp_L("When it is 0, the output is OFF; when it is 1, the output is ON.")
  SoftwareHelp_L("If not specified the value defaults to 0.")
  SoftwareHelp_L("AV control | audio/video output of the euroconnector RGB (SCART)")
  SoftwareHelp_L("0 | not selected")
  SoftwareHelp_L("1 | selected")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET VIDEO 2")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COPY SCREEN")
  SoftwareHelp_Commit("SET VIDEO", "MSX-BASIC 2 (MSX2)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## SET SCROLL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 3)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("SET SCROLL [x ] [,y]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Performs horizontal and vertical scrolling of the screen-contents in graphic-mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("This is a MSX2+ only command and supports the hard scroll of the V9958. <X coordinate> is between 0 and 511, <Y coordinate> is between 0 and 255.")
  SoftwareHelp_L("Leftmost 8 dots part of the screen is not displayed if the <left mask> is 1, displayed if this value is 0. If the <2 page sequential> is 1,")
  SoftwareHelp_L("two sequential pages (for instance 0 and 1) are treated as a horizontally connected page or if this value is 0, the scroll takes place only in a single page.")
  SoftwareHelp_L("To execute 2 page sequential display, the display page must be a odd numbered page. The hard scroll can be done only with SCREEN 1 and later, and 2 page")
  SoftwareHelp_L("sequential display can be done only with SCREEN 5 and later.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Notes:")
  SoftwareHelp_L("")
  SoftwareHelp_L("Under screen 0 mode 0-7 is specifyable as X-distance. If 0 (or omitted), horizontal scroll does not happen. If a value between 1 and 7 is specified, 1 causes 7 pixels, 2 causes 6 pixels, ... 7 causes 1 pixel of scroll to right.")
  SoftwareHelp_L("")
  SoftwareHelp_L("0 to 7 is specifiyable as Y-distance. If 0 (or omitted), vertical scroll does not happen. If a value between  and 7 is specified, 1 causes 1 pixel, 2 causes pixels, ... 7 causes 7 pixels of scroll to up. " + Chr(34) + "Vertical scroll" + Chr(34) + " does not move displayed characters themselves, but instead causes scrolling inside each of the horizontal character rows.")
  SoftwareHelp_L("")
  SoftwareHelp_L("After scrolling, (if horizontal scroll was specified) entire displayed screen is displaced to X-axial direction and (if vertical scroll was) character patterns are scrolled Y-axially inside each of the rows. Scrolled positions return to initial conditions if you re-set the screen mode by using SCREEN statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("SET SCROLL ,1")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("SET ADJUST")
  SoftwareHelp_Commit("SET SCROLL", "MSX-BASIC 2+ (MSX2+)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL PAUSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 4)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL PAUSE(time)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Stops execution of BASIC program for the specified time. The unit of the pause time is millisecond.")
  SoftwareHelp_L("When the CALL PAUSE is being executed, interrupt is enabled. Even when the CALL PAUSE is being executed,")
  SoftwareHelp_L("you can quit the program by the CTRL + STOP keys. This command is used when you want to take a timing")
  SoftwareHelp_L("without being affected by the CPU execution speed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL PAUSE(1000)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Nota:**")
  SoftwareHelp_L("the Chakkari Copy cartridge provides also a CALL PAUSE statement, which performs a different function.")
  SoftwareHelp_Commit("CALL PAUSE", "MSX-BASIC Turbo-R")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL PCMPLAY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 4)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL PCMPLAY(@startaddr, endaddr, samplerate, ramtype [,S])")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMPLAY(arrayname, [length], samplerate)")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMPLAY(@start address, end address, sampling rate)")
  SoftwareHelp_L("for playing from the main RAM")
  SoftwareHelp_L("CALL PCMPLAY(@start address, end address, sampling rate,S)")
  SoftwareHelp_L("for playing from the VRAM")
  SoftwareHelp_L("CALL PCMPLAY(array variable name, [length], sampling rate)")
  SoftwareHelp_L("for playing from array variables")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Play a PCM sound.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Treats the contents of either the main RAM or the VRAM as a PCM data and plays it by the specified sampling frequency.")
  SoftwareHelp_L("")
  SoftwareHelp_L("- Sampling rate")
  SoftwareHelp_L("")
  SoftwareHelp_L("Specifies the sampling rate.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Sampling rate | Meaning (KHz)")
  SoftwareHelp_L("0 | 15.75")
  SoftwareHelp_L("1 | 7.875")
  SoftwareHelp_L("2 | 5.25")
  SoftwareHelp_L("3 | 3.9375")
  SoftwareHelp_L("")
  SoftwareHelp_L("- Length")
  SoftwareHelp_L("")
  SoftwareHelp_L("You can omit this. If you omit, all of the contents of the array variable is played.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The format of the data is absolute binary and 1 to 255 is a normal data. 0 is a special data and causes 0 level (127) to be outputted by a number of the cycles specified by 1 byte proceeding the 0.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Caution")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the mode is Z80 mode, the mode is automatically switched to the R800 mode before the execution, and after finishing the Z80 mode is restored. If the STOP key is pushed during the playing, the program execution is quit and returns to BASIC.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Be careful that in the MSX-BASIC, the hexadecimal number you can express with &H is a four digit number between &H000 and &HFFFF and that &H8000 to &HFFFF are the negative numbers. This does not cause any problem when main RAM is specified but requires caution when VRAM is specified. For instance, to play 64KB part in the latter half of the VRAM, you must specify like,")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMPLAY(@65536,131071,2,S)")
  SoftwareHelp_L("")
  SoftwareHelp_L("(131071=65536x2-1). If you specify like,")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMPLAY(@&H10000,&H1FFFF,2,S)")
  SoftwareHelp_L("")
  SoftwareHelp_L("this results in " + Chr(34) + "Overflow" + Chr(34) + " error. On the other hand,")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMPLAY(&HFFFF+1,&1FFFFx2+1,2,S)")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Translator's note: This is obviously typo of CALL PCMPLAY(&HFFFF+1,&1FFFF*2+1,2,S) )")
  SoftwareHelp_L("")
  SoftwareHelp_L("results same with CALL PCMPLAY(@0,&HFFFF,2,S) since &HFFFF+1=-1+1=0 and &HFFFx2+1=-1x2+1=&HFFFF .")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL PCMPLAY(@&HB000,&HDFFF,1)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL PCMREC")
  SoftwareHelp_Commit("CALL PCMPLAY", "MSX-BASIC Turbo-R")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL PCMREC")
  SoftwareHelp_L("")
  SoftwareHelp_L("(MSX-Basic 4)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL PCMREC(@start address, end address, sampling rate,[,[trigger level][,compression switch]])")
  SoftwareHelp_L("")
  SoftwareHelp_L("for recording to the main RAM")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMREC(@start address, end address, sampling rate, [trigger level], [compression switch],S)")
  SoftwareHelp_L("")
  SoftwareHelp_L("for recording to the VRAM")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL PCMREC(array variable name, [length],sampling rate[,[trigger level][, compression switch]])")
  SoftwareHelp_L("")
  SoftwareHelp_L("for recording to array variables")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Records sounds as PCM.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Samples sound by the PCM method and by the specified frequency, and records in either main RAM, VRAM or array variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("- Sampling rate")
  SoftwareHelp_L("")
  SoftwareHelp_L("Specifies the sampling rate.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Sampling rate | Meaning (KHz)")
  SoftwareHelp_L("0 | 15.75")
  SoftwareHelp_L("1 | 7.875")
  SoftwareHelp_L("2 | 5.25")
  SoftwareHelp_L("3 | 3.9375")
  SoftwareHelp_L("")
  SoftwareHelp_L("- Trigger level")
  SoftwareHelp_L("")
  SoftwareHelp_L("Specifies the input level when starting the recording. The range of this value is 0 to 127. If this is omitted or is 0, the recording is started immediately.")
  SoftwareHelp_L("")
  SoftwareHelp_L("- Compression switch")
  SoftwareHelp_L("")
  SoftwareHelp_L("Specifies whether or not to execute the silent data compression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Value | Meaning")
  SoftwareHelp_L("Omitted | Does not compress")
  SoftwareHelp_L("0 | Does not compress")
  SoftwareHelp_L("1 | Compress")
  SoftwareHelp_L("")
  SoftwareHelp_L("The format of the data is absolutely binary and 1 to 255 is normal data. When two or more data near the 0 level (126 to 128) are consecutive, the data can be compressed by recording a 0 and count of the consecutive data. This compression is called silent data compression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Caution")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the mode is Z80 mode, the mode is automatically switched to the R800 mode before the execution, and after finishing the Z80 mode is restored.")
  SoftwareHelp_L("If you specify the sampling rate to 15.75 KHz under Z80 mode or R800 ROM mode, you get " + Chr(34) + "Illegal function call" + Chr(34) + " error. Note if the STOP key is pushed during the playing, the program execution is quit and returns to BASIC.")
  SoftwareHelp_L("When recording to the VRAM, be careful with the address you specify, in the same way with CALL PCMPLAY.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CLEAR 300,&HB000")
  SoftwareHelp_L("CALL PCMREC(@HB000,&HDFFF,1,32,1)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL PCMPLAY")
  SoftwareHelp_Commit("CALL PCMREC", "MSX-BASIC Turbo-R")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL CHDIR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL CHDIR(" + Chr(34) + "[drive+]path" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Set current directory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Each drive has it's own current directory. This remains at the directory ")
  SoftwareHelp_L("specified  by the last CHDIR command for that drive (or at the root directory ")
  SoftwareHelp_L("initially) until  another CHDIR command is given or it cannot be found on the ")
  SoftwareHelp_L("disk when it is accessed (because the disk has been changed, for example). It ")
  SoftwareHelp_L("is then returned to the root directory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL CHDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL MKDIR,")
  SoftwareHelp_L("CALL RMDIR,")
  SoftwareHelp_L("CALL CHDRV")
  SoftwareHelp_Commit("CALL CHDIR", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL CHDRV")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL CHDRV(" + Chr(34) + "driveletter" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Switch default drive.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL CHDRV(" + Chr(34) + "H:" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL CHDIR")
  SoftwareHelp_Commit("CALL CHDRV", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL FORMAT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL FORMAT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Formats a disk. The CALL FORMAT statement prompts for the drive,")
  SoftwareHelp_L("that contains the disk to be formatted.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If the disk-drive supports multiple disk formats the CALL FORMAT")
  SoftwareHelp_L("statement pompts for the disk-format to be choosen (can be e.g.")
  SoftwareHelp_L("single sided or double-sided disk).")
  SoftwareHelp_L("")
  SoftwareHelp_L("Notes:")
  SoftwareHelp_L("")
  SoftwareHelp_L("A disk must be formatted before it can be used")
  SoftwareHelp_L("Formatting irreversibly destroys prior contents of the disk")
  SoftwareHelp_L("")
  SoftwareHelp_L("Harddisk: CALL FORMAT write-protects and write-enables the selected")
  SoftwareHelp_L("partition of a harddisk. To create/delete and format partitions the")
  SoftwareHelp_L("corresponding FDISK utility (on MSX-DOS disk) has to be used.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL FORMAT")
  SoftwareHelp_L("Drive name? (A,B) a")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 - Single sided, 9 sectors")
  SoftwareHelp_L("2 - Double sided, 9 sectors")
  SoftwareHelp_L("")
  SoftwareHelp_L("? 1")
  SoftwareHelp_L("Strike a key when ready")
  SoftwareHelp_L("Format complete")
  SoftwareHelp_L("Ok")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: the printed prompts might be different, depending on the used")
  SoftwareHelp_L("disk-controller and connected drives.")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL FORMAT")
  SoftwareHelp_L("Drive name? (A,B,C) A")
  SoftwareHelp_L("")
  SoftwareHelp_L("1 - Write protect partition")
  SoftwareHelp_L("2 - Write enable partition")
  SoftwareHelp_L("")
  SoftwareHelp_L("?")
  SoftwareHelp_Commit("CALL FORMAT", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL MKDIR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL MKDIR(" + Chr(34) + "[drive+]path" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Create new subdirectory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The  last item in the path is the name of the new sub-directory which is ")
  SoftwareHelp_L("to be  created on  the current  or specified  drive. Thus if this is the only ")
  SoftwareHelp_L("item  in the  path, the new directory is created in the current directory.")
  SoftwareHelp_L("")
  SoftwareHelp_L("     When a  new directory  is created,  it is  empty except  for two special ")
  SoftwareHelp_L("sub-directories  called '.'  and '..'. These are automatically created in the ")
  SoftwareHelp_L("directory and  it is  these that allow '.' and '..' to be given in path names ")
  SoftwareHelp_L("to  signify the current and parent directories respectively (see chapter 3 on ")
  SoftwareHelp_L("Notation for a description of paths).")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL MKDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL CHDIR,")
  SoftwareHelp_L("CALL RMDIR")
  SoftwareHelp_Commit("CALL MKDIR", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL RAMDISK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL RAMDISK[([number][, variable name])]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Set size of RAM disk or assign it into a variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("The  number, if  given, specifies the maximum size for the new RAM disk, ")
  SoftwareHelp_L("and is  specified in kilobytes. The range is 0 to 4064. If the number is 0 the")
  SoftwareHelp_L("RAM disk  will be  deleted. This  number will be ")
  SoftwareHelp_L("rounded up  to the  nearest multiple  of 16K  since the  RAM disk is always a ")
  SoftwareHelp_L("multiple  of 16K.  A RAM  disk smaller then the specified maximum size may be ")
  SoftwareHelp_L("created if there is not enough free memory for the full size, although a 'not ")
  SoftwareHelp_L("enough memory' error will be given if there is no memory at all available for ")
  SoftwareHelp_L("the RAM  disk. Note that the number specified is the maximum amount of RAM to ")
  SoftwareHelp_L("use  for the  RAM disk,  which is  not the same as the maximum amount of free ")
  SoftwareHelp_L("space available  on the  newly-created RAM disk since the system needs to use ")
  SoftwareHelp_L("some for FAT or directories.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Having created a RAM disk, it can be referred to as drive H:.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL RAMDISK(32)")
  SoftwareHelp_L("CALL RAMDISK(1000, A)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL MEMINI")
  SoftwareHelp_Commit("CALL RAMDISK", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL RMDIR")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL RMDIR(" + Chr(34) + "[drive+]path" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Remove one or more subdirectories.")
  SoftwareHelp_L("")
  SoftwareHelp_L(" In  order to delete a directory, it must contain no other files or other ")
  SoftwareHelp_L("directories except  for the special '.' and '..' directories which are always ")
  SoftwareHelp_L("contained in a directory. These are put in a new directory when it is created ")
  SoftwareHelp_L("and cannot be removed. It is these that allow '.' and '..' to be used in path ")
  SoftwareHelp_L("names to specify the current and parent directories respectively.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL RMDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL CHDIR,")
  SoftwareHelp_L("CALL MKDIR,")
  SoftwareHelp_L("CALL MKILL")
  SoftwareHelp_Commit("CALL RMDIR", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL SYSTEM")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL SYSTEM")
  SoftwareHelp_L("")
  SoftwareHelp_L("CALL SYSTEM[(" + Chr(34) + "DOS command name" + Chr(34) + ")]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("CALL SYSTEM  passes the  control back to MSX-DOS. The command ")
  SoftwareHelp_L("name  may be  given to  specify the  operation to be executed ")
  SoftwareHelp_L("after  the  control returns  to DOS.")
  SoftwareHelp_L("MSX-DOS 2: If no  command name  is specified,")
  SoftwareHelp_L("REBOOT.BAT  in  the  root directory  on the  boot drive,")
  SoftwareHelp_L("if any, will be executed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: this command is only available if the computer was")
  SoftwareHelp_L("started in MSX-DOS mode and MSX-Basic has been entered with the")
  SoftwareHelp_L("BASIC command.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL SYSTEM")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("MSX-DOS")
  SoftwareHelp_Commit("CALL SYSTEM", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## COPY")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("COPY <sourcefile> [TO <targetfile>]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("COPY duplicates a file, which can also be created on a different disk.")
  SoftwareHelp_L("")
  SoftwareHelp_L("If targetfile is not specified the sourcefile is copied to")
  SoftwareHelp_L("the default-drive, where the filename is not changed.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Users of a single floppy-disk drive cannot take full advantage")
  SoftwareHelp_L("because the COPY operation copies files sector by sector. This means that")
  SoftwareHelp_L("a sector on the source-disk is read, the user is prompted for a disk-change,")
  SoftwareHelp_L("the sector on the target-disk is written, the user is prompted again, ...")
  SoftwareHelp_L("")
  SoftwareHelp_L("Also interesting for single users is the possibility to use pseudo-files")
  SoftwareHelp_L("such as " + Chr(34) + "CON" + Chr(34) + " and " + Chr(34) + "PRN" + Chr(34) + ".")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("COPY " + Chr(34) + "TEST.BAS" + Chr(34) + " TO " + Chr(34) + "TEST.$$$" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("COPY " + Chr(34) + "*.*" + Chr(34) + " TO " + Chr(34) + "B:" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("COPY " + Chr(34) + "B:*.*" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("COPY " + Chr(34) + "TEST.TXT" + Chr(34) + " TO " + Chr(34) + "PRN" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("COPY (MSX2-Basic), COPY SCREEN, KILL, NAME")
  SoftwareHelp_Commit("COPY", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CVD( <string> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts a 8 Byte string into a double-precision value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("D=CVD(D$)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVI,")
  SoftwareHelp_L("CVS,")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKI$,")
  SoftwareHelp_L("MKS$,")
  SoftwareHelp_L("MKD$")
  SoftwareHelp_Commit("CVD", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CVI")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CVI( <string> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts a 2 Byte string into an integer value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("I=CVI(I$)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVS,")
  SoftwareHelp_L("CVD,")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKI$,")
  SoftwareHelp_L("MKS$,")
  SoftwareHelp_L("MKD$")
  SoftwareHelp_Commit("CVI", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CVS")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CVS( <string> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts a 4 Byte string into a single-precision value.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("S=CVS(S$)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVI,")
  SoftwareHelp_L("CVD,")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKI$,")
  SoftwareHelp_L("MKS$,")
  SoftwareHelp_L("MKD$")
  SoftwareHelp_Commit("CVS", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DSKF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DSKF( drivenumber )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("DSKF returns the number of free clusters on the specified drivenumber,")
  SoftwareHelp_L("where 1=A:, 2=B:, 3=C: and so on.")
  SoftwareHelp_L("If 0 is specified the free space on the default-drive is returned.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("? DSKF(0)")
  SoftwareHelp_L("")
  SoftwareHelp_L("IF DSKF(1)<100 THEN PRINT " + Chr(34) + "Please insert a new disk!" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FILES,")
  SoftwareHelp_L("LFILES")
  SoftwareHelp_Commit("DSKF", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DSKI$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("<stringvar> = DSKI$( <drivenumber>, <sectornumber> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("DSKI$ reads the sector sectornumber from the disk-drive specified in")
  SoftwareHelp_L("drivenumber (0=default, 1=A:, 2=B:, ...).")
  SoftwareHelp_L("")
  SoftwareHelp_L("DSKI$ returns an empty string (which is historical, because sector-sizes were")
  SoftwareHelp_L("smaller in the past and really returned the read sector). In MSX-Basic the")
  SoftwareHelp_L("bytes of the read sector can be found on address:")
  SoftwareHelp_L("")
  SoftwareHelp_L("  PEEK(&HF351) + PEEK(&HF352)*256")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: the contents of this buffer are lost as soon as another command")
  SoftwareHelp_L("accesses the disk again.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 X$ = DSKI$(0,0)")
  SoftwareHelp_L("20 AD = PEEK(&HF351)+PEEK(&HF352)*256")
  SoftwareHelp_L("30 FOR I=0 TO 511:PRINT PEEK(AD+I);:NEXT")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DSKO$")
  SoftwareHelp_Commit("DSKI$", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## DSKO$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("DSKO$( <drivenumber>, <sectornumber> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("DSKO$ writes the sector sectornumber on the disk-drive specified in")
  SoftwareHelp_L("drivenumber (0=default, 1=A:, 2=B:, ...).")
  SoftwareHelp_L("The sector data to be written is located on:")
  SoftwareHelp_L("")
  SoftwareHelp_L("  PEEK(&HF351) + PEEK(&HF352)*256")
  SoftwareHelp_L("")
  SoftwareHelp_L("Note: the contents of this buffer are lost as soon as another command")
  SoftwareHelp_L("accesses the disk again.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Important: because DSKO$ modifies sectors on the physical disk")
  SoftwareHelp_L("this command should be used very careful!")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("DSKI$")
  SoftwareHelp_Commit("DSKO$", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FIELD")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FIELD #channel, length AS stringvariable,")
  SoftwareHelp_L("length2 AS stringvariable2, ...")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("After a file is opened and the recordlength has been specified FIELD can be used")
  SoftwareHelp_L("how a record is separated into single fields. Every datafield requires one entry")
  SoftwareHelp_L("specifying length and the name of a stringvariable.")
  SoftwareHelp_L("The number of fields is not limited but must not exceed the recordlength as")
  SoftwareHelp_L("specified in the OPEN statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("FIELD #1, 15 AS NA$, 15 AS ST$, 20 AS OT$, 16 AS TE$")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LSET,")
  SoftwareHelp_L("RSET,")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("PUT")
  SoftwareHelp_Commit("FIELD", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## FILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("FILES [" + Chr(34) + "pattern" + Chr(34) + "][,L]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Lists the contents of (the current directory on) the diskette.")
  SoftwareHelp_L("If the disk is empty or the pattern does not match any existing file")
  SoftwareHelp_L("a " + Chr(34) + "File not found error" + Chr(34) + " is generated.")
  SoftwareHelp_L("")
  SoftwareHelp_L("All files in the file-listing are using 8 characters for the filename,")
  SoftwareHelp_L("a dot (.) and 3 characters for the extension.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Disk-Basic 2: the Parameter " + Chr(34) + "L" + Chr(34) + " can be added")
  SoftwareHelp_L("to display the list of files in long format.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("FILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("Shows all files on the standard-drive (usually A:)")
  SoftwareHelp_L("")
  SoftwareHelp_L("FILES " + Chr(34) + "B:" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Shows all files on drive B:")
  SoftwareHelp_L("")
  SoftwareHelp_L("FILES " + Chr(34) + "*.BAS" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Shows all files with the extension " + Chr(34) + ".BAS" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("FILES " + Chr(34) + "*.*" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Works as FILES without pattern.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LFILES,")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("CALL MFILES,")
  SoftwareHelp_L("DSKF")
  SoftwareHelp_Commit("FILES", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## GET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("GET #channel [, recordnumber]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Reads a record from a file. If recordnumber is not specified GET")
  SoftwareHelp_L("reads the next one from the file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 OPEN " + Chr(34) + "ADRESS.DAT" + Chr(34) + " AS #1 LEN=66")
  SoftwareHelp_L("110 FIELD #1, 15 AS NA$, 15 AS ST$, 20 AS OT$, 16 AS TE$")
  SoftwareHelp_L("120 SN=LOF(1)/66")
  SoftwareHelp_L("130 FOR I=1 TO SN")
  SoftwareHelp_L("140 GET #1")
  SoftwareHelp_L("150 PRINT")
  SoftwareHelp_L("160 PRINT TAB(5);NA$")
  SoftwareHelp_L("170 PRINT TAB(5);ST$")
  SoftwareHelp_L("180 PRINT TAB(5);OT$")
  SoftwareHelp_L("190 NEXT")
  SoftwareHelp_L("200 PRINT " + Chr(34) + "Finished" + Chr(34))
  SoftwareHelp_L("210 CLOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FIELD,")
  SoftwareHelp_L("PUT,")
  SoftwareHelp_L("LSET,")
  SoftwareHelp_L("RSET,")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("GET", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## KILL")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("KILL <pattern>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Deletes the file(s) specified in pattern.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("KILL " + Chr(34) + "TEST.$$$")
  SoftwareHelp_L("")
  SoftwareHelp_L("KILL " + Chr(34) + "*.$$$" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("KILL " + Chr(34) + "B:*.BAK" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL RMDIR,")
  SoftwareHelp_L("CALL MKILL,")
  SoftwareHelp_L("COPY,")
  SoftwareHelp_L("NAME")
  SoftwareHelp_Commit("KILL", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LFILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LFILES [" + Chr(34) + "pattern" + Chr(34) + "][,L]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Prints the contents of (the current directory on) the diskette.")
  SoftwareHelp_L("If the disk is empty or the pattern does not match any existing file")
  SoftwareHelp_L("a " + Chr(34) + "File not found error" + Chr(34) + " is generated.")
  SoftwareHelp_L("")
  SoftwareHelp_L("All files in the file-listing are using 8 characters for the filename,")
  SoftwareHelp_L("a dot (.) and 3 characters for the extension.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Disk-Basic 2: the Parameter " + Chr(34) + "L" + Chr(34) + " can be added")
  SoftwareHelp_L("to print the list of files in long format.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LFILES")
  SoftwareHelp_L("")
  SoftwareHelp_L("Prints all files on the standard-drive (usually A:)")
  SoftwareHelp_L("")
  SoftwareHelp_L("LFILES " + Chr(34) + "B:" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Prints all files on drive B:")
  SoftwareHelp_L("")
  SoftwareHelp_L("LFILES " + Chr(34) + "*.BAS" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Prints all files with the extension " + Chr(34) + ".BAS" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("LFILES " + Chr(34) + "*.*" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("Works as LFILES without pattern.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FILES,")
  SoftwareHelp_L("LOAD,")
  SoftwareHelp_L("BLOAD,")
  SoftwareHelp_L("CALL MFILES,")
  SoftwareHelp_L("DSKF")
  SoftwareHelp_Commit("LFILES", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LOC")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic, RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LOC( channel )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Returns the current recordnumber in the opened file as #channel.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("100 OPEN " + Chr(34) + "ADRESS.DAT" + Chr(34) + " AS #1 LEN=66")
  SoftwareHelp_L("110 FIELD #1, 15 AS NA$, 15 AS ST$, 20 AS OT$, 16 AS TE$")
  SoftwareHelp_L("120 SN=LOF(1)/66")
  SoftwareHelp_L("130 FOR I=1 TO SN")
  SoftwareHelp_L("140 GET #1")
  SoftwareHelp_L("150 PRINT " + Chr(34) + "Record" + Chr(34) + ";LOC(1)")
  SoftwareHelp_L("160 PRINT TAB(5);NA$")
  SoftwareHelp_L("170 PRINT TAB(5);ST$")
  SoftwareHelp_L("180 PRINT TAB(5);OT$")
  SoftwareHelp_L("190 NEXT")
  SoftwareHelp_L("200 PRINT " + Chr(34) + "Finished" + Chr(34))
  SoftwareHelp_L("210 CLOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FIELD,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("PUT,")
  SoftwareHelp_L("OPEN,")
  SoftwareHelp_L("CLOSE,")
  SoftwareHelp_L("EOF,")
  SoftwareHelp_L("LOF")
  SoftwareHelp_Commit("LOC", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LOF")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic, RS232-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LOF( <filenumber> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("LOF returns the filesize (LengthOfFile) in bytes.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 INPUT " + Chr(34) + "Filename: " + Chr(34) + "; FI$")
  SoftwareHelp_L("20 OPEN FI$ FOR INPUT AS #1")
  SoftwareHelp_L("30 PRINT LOF(1) " + Chr(34) + "Bytes" + Chr(34))
  SoftwareHelp_L("40 CLOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("OPEN, CLOSE, EOF, LOC")
  SoftwareHelp_Commit("LOF", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## LSET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("LSET <stringvariable> = <string-expression>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Assigns a value to a variable, which is defined by the FIELD statement.")
  SoftwareHelp_L("Is the result of the string-expression shorter as specified in the FIELD statement")
  SoftwareHelp_L("the string will be stored left-aligned, the rest is filled with spaces. If the result is")
  SoftwareHelp_L("larger only the number of fitting characters is saved.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Peter Pan" + Chr(34) + "             ->  " + Chr(34) + "Peter Pan      " + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Peter Pan" + Chr(34) + "             ->  " + Chr(34) + "      Peter Pan" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Carlo Kautschuk" + Chr(34) + "       ->  " + Chr(34) + "Carlo Kautschuk" + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Carlo Kautschuk" + Chr(34) + "       ->  " + Chr(34) + "Carlo Kautschuk" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Ludwig van Beethoven" + Chr(34) + "  ->  " + Chr(34) + "Ludwig van Beet" + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Ludwig van Beethoven" + Chr(34) + "  ->  " + Chr(34) + "Ludwig van Beet" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("RSET,")
  SoftwareHelp_L("MID$,")
  SoftwareHelp_L("FIELD,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("PUT")
  SoftwareHelp_Commit("LSET", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MKD$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MKD$( <number> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts a double-precision value into a 8 Byte string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LSET MKD$(D)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKI$,")
  SoftwareHelp_L("MKS$,")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVI,")
  SoftwareHelp_L("CVS,")
  SoftwareHelp_L("CVD")
  SoftwareHelp_Commit("MKD$", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MKI$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MKI$( <number> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts an integer value into a 2 Byte string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LSET MKI$(I)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKS$,")
  SoftwareHelp_L("MKD$,")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVI,")
  SoftwareHelp_L("CVS,")
  SoftwareHelp_L("CVD")
  SoftwareHelp_Commit("MKI$", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## MKS$")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("MKS$( <number> )")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Converts a single-precision value into a 4 Byte string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("Type | Length | -> String | -> Number")
  SoftwareHelp_L("0...255 | 1 | CHR$() | ASC")
  SoftwareHelp_L("INT | 2 | MKI$() | CVI")
  SoftwareHelp_L("SNG | 4 | MKS$() | CVS")
  SoftwareHelp_L("DBL | 8 | MKD$() | CVD")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LSET MKS$(S)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CHR$,")
  SoftwareHelp_L("MKI$,")
  SoftwareHelp_L("MKD$,")
  SoftwareHelp_L("ASC,")
  SoftwareHelp_L("CVI,")
  SoftwareHelp_L("CVS,")
  SoftwareHelp_L("CVD")
  SoftwareHelp_Commit("MKS$", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## NAME")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("NAME " + Chr(34) + "oldname" + Chr(34) + " AS " + Chr(34) + "newname" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Renames the file named oldname to newname.")
  SoftwareHelp_L("If a file named newname already exists a " + Chr(34) + "File already exists" + Chr(34) + " error occurs.")
  SoftwareHelp_L("")
  SoftwareHelp_L("oldname and newname can be fully qualified filenames,")
  SoftwareHelp_L("including drive-letter. Wildcards can be included too.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("NAME " + Chr(34) + "TEST.BAS" + Chr(34) + " AS " + Chr(34) + "TEST.BAK" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL MNAME, COPY, KILL")
  SoftwareHelp_Commit("NAME", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## PUT")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("PUT #channel [, recordnumber]")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Writes a record into a file. If recordnumber is not specified PUT writes the next one into the file.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("10 OPEN SUPERDAT.DAT" + Chr(34) + " as #1 LEN=66")
  SoftwareHelp_L("20 PUT#1, 2000")
  SoftwareHelp_L("30 PRINT " + Chr(34) + "The file has now a size of" + Chr(34) + ";LOF(1);" + Chr(34) + "Bytes" + Chr(34))
  SoftwareHelp_L("40 CLOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("These records can be read with GET, even if no data was inserted.")
  SoftwareHelp_L("Which bytes are really read depends on the history of the disk.")
  SoftwareHelp_L("Unused records on new formatted disks are filled with CHR$(229).")
  SoftwareHelp_L("They may also contain parts of already deleted files.")
  SoftwareHelp_L("")
  SoftwareHelp_L("To initialize all records the following code is recommended:")
  SoftwareHelp_L("")
  SoftwareHelp_L("10 OPEN " + Chr(34) + "SUPERDAT.DAT" + Chr(34) + " AS #1 LEN=66")
  SoftwareHelp_L("20 FIELD #1, 66 AS X$")
  SoftwareHelp_L("30 LSET X$=STRING$(66,229)")
  SoftwareHelp_L("50 FOR I=1 TO 2000")
  SoftwareHelp_L("60  PUT #1, I")
  SoftwareHelp_L("70 NEXT")
  SoftwareHelp_L("80 CLOSE")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("FIELD,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("LSET,")
  SoftwareHelp_L("RSET,")
  SoftwareHelp_L("OPEN")
  SoftwareHelp_Commit("PUT", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## RSET")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Disk-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("RSET <stringvariable> = <string-expression>")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Assigns a value to a variable, which is defined by the FIELD statement.")
  SoftwareHelp_L("Is the result of the string-expression shorter as specified in the FIELD statement")
  SoftwareHelp_L("the string will be stored right-aligned, the rest is filled with spaces. If the result is")
  SoftwareHelp_L("larger only the number of fitting characters is saved.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Peter Pan" + Chr(34) + "             ->  " + Chr(34) + "Peter Pan      " + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Peter Pan" + Chr(34) + "             ->  " + Chr(34) + "      Peter Pan" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Carlo Kautschuk" + Chr(34) + "       ->  " + Chr(34) + "Carlo Kautschuk" + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Carlo Kautschuk" + Chr(34) + "       ->  " + Chr(34) + "Carlo Kautschuk" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("LSET NA$ = " + Chr(34) + "Ludwig van Beethoven" + Chr(34) + "  ->  " + Chr(34) + "Ludwig van Beet" + Chr(34))
  SoftwareHelp_L("RSET NA$ = " + Chr(34) + "Ludwig van Beethoven" + Chr(34) + "  ->  " + Chr(34) + "Ludwig van Beet" + Chr(34))
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("LSET,")
  SoftwareHelp_L("MID$,")
  SoftwareHelp_L("FIELD,")
  SoftwareHelp_L("GET,")
  SoftwareHelp_L("PUT")
  SoftwareHelp_Commit("RSET", "MSX-BASIC - Disk-BASIC")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL ADJUST")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Hangul-Basic 2)")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL ADJUST")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("CALL HANON, CALL HANOFF")
  SoftwareHelp_Commit("CALL ADJUST", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL AKCNV")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Kanji-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Convert all character data to zenkaku characters, and substitue them into a character string.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL AKCNV(character variable,X$)")
  SoftwareHelp_L("")
  SoftwareHelp_L("_ AKCNV(character variable,X$)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Character variable: Variable of character type.")
  SoftwareHelp_L("")
  SoftwareHelp_L("X$: Character constant, variable, array variable or expression.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("If any characters which are not zenkaku are containted in X$, this command converts them into zenkaku characters, and substitute the whole string into a character variable.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Exemplo:**")
  SoftwareHelp_L("CALL AKCNV(A$," + Chr(34) + "ABCŠ¿Žš±²³´µ" + Chr(34) + "):PRINT A$")
  SoftwareHelp_L("‚`‚a‚bŠ¿ŽšƒAƒCƒEƒGƒI")
  SoftwareHelp_L("")
  SoftwareHelp_L("Among the character string given to this CALL AKCNV statement, " + Chr(34) + "ABC" + Chr(34) + " and " + Chr(34) + "±²³´µ" + Chr(34) + " were converted, since they were hankaku.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("Zenkaku and Hankaku")
  SoftwareHelp_Commit("CALL AKCNV", "MSX-BASIC - CALL (extensoes de firmware)")

  SoftwareHelp_Begin()
  SoftwareHelp_L("## CALL ANK")
  SoftwareHelp_L("")
  SoftwareHelp_L("(Kanji-Basic)")
  SoftwareHelp_L("")
  SoftwareHelp_L("Quit Japanese input mode.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Sintaxe:**")
  SoftwareHelp_L("CALL ANK")
  SoftwareHelp_L("")
  SoftwareHelp_L("_ ANK")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Funcao:**")
  SoftwareHelp_L("Deactivates the Kanji text-mode activated by CALL KANJI.")
  SoftwareHelp_L("However, execution of this command does not release memory which was allocated for kanji driver through CALL KANJI statement.")
  SoftwareHelp_L("")
  SoftwareHelp_L("**Veja tambem:**")
  SoftwareHelp_L("MSX-JE")
  SoftwareHelp_Commit("CALL ANK", "MSX-BASIC - CALL (extensoes de firmware)")

