  HardwareHelp_L(" . |	   .						|   |")
  HardwareHelp_L("   |----------------------------------------------------|   |")
  HardwareHelp_L("11 |  Lo 6 --+--- 6th character of the title		|   |")
  HardwareHelp_L("   |	     |						|   |")
  HardwareHelp_L("12 |  Hi 6 --+						|   |")
  HardwareHelp_L("   ------------------------------------------------------ --+")
  HardwareHelp_L("")
