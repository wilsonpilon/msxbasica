  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#18 | R512 |R256 |  0  |SCAY12|SCAY11|SCAY10|SCAY9|SCAY8|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#19 |  0   |  0  |  0  |  0   |  0   |SCAX2 |SCAX1|SCAX0|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#20 |SCAX10|SCAX9|SCAX8|SCAX7 |SCAX6 |SCAX5 |SCAX4|SCAX3|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#21 | SCBY7|SCBY6|SCBY5| SCBY4| SCBY3| SCBY2|SCBY1|SCBY0|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#22 |DisB  |DisA |  0  |  0   |  0   |  0   |  0  |SCBY8|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#23 |  0   |  0  |  0  |  0   |  0   |SCBX2 |SCBX1|SCBX0|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("R#24 |  0   |  0  |SCBX8|SCBX7 |SCBX6 |SCBX5 |SCBX4|SCBX3|")
  HardwareHelp_L("     +------+-----+-----+------+------+------+-----+-----+")
  HardwareHelp_L("SCAY12-0        As display start coordinates for screen " + Chr(34) + "A" + Chr(34) + " of P1 mode and")
  HardwareHelp_L("SCAX10-0        screens of other modes, X-Y coordinates in the image space")
  HardwareHelp_L("                are specified by dots. (When 16 bit/dot is used in B2 and B3")
  HardwareHelp_L("                modes, however, SCAX0 is ignored and X coordinate is specified")
  HardwareHelp_L("                by 2 dot unit.)")
  HardwareHelp_L("")
  HardwareHelp_L("SCBY8-0         For screen " + Chr(34) + "B" + Chr(34) + " of P1 mode, X-Y coordinates are specified in")
  HardwareHelp_L("SCBX8-0         the same way as for screen " + Chr(34) + "A" + Chr(34) + ".")
  HardwareHelp_L("")
  HardwareHelp_L("R512 R256       Number of roll page line in Y direction is specified.")
  HardwareHelp_L("  1    0        Displayed page is rolled by 512 lines.")
  HardwareHelp_L("  0    1        Displayed page is rolled by 256 lines.")
  HardwareHelp_L("  0    0        Rolling by image space size takes place.")
  HardwareHelp_L("")
  HardwareHelp_L("DisB            Disable display of screen " + Chr(34) + "B" + Chr(34))
  HardwareHelp_L("  1             Screen " + Chr(34) + "B" + Chr(34) + " is disabled")
  HardwareHelp_L("  0             Screen " + Chr(34) + "B" + Chr(34) + " is enabled")
  HardwareHelp_L("")
  HardwareHelp_L("DisA            Disable display of screen " + Chr(34) + "A" + Chr(34))
  HardwareHelp_L("  1             Screen " + Chr(34) + "A" + Chr(34) + " is disabled")
  HardwareHelp_L("  0             Screen " + Chr(34) + "A" + Chr(34) + " is enabled")
  HardwareHelp_L("")
  HardwareHelp_L("SPRITE PATTERN GENERATOR TABLE BASE ADDRESS (Read/Write)")
  HardwareHelp_L("========================================================")
  HardwareHelp_L("       b7  b6  b5  b4   b3     b2     b1     b0")
  HardwareHelp_L("     +---+---+---+---+------+------+------+------+")
  HardwareHelp_L("R#25 | 0 | 0 | 0 | 0 |SGBA17|SGBA16|SGBA15|  0   |  P1 mode!")
  HardwareHelp_L("     +---+---+---+---+------+------+------+------+")
  HardwareHelp_L("R#25 | 0 | 0 | 0 | 0 |SGBA18|SGBA17|SGBA16|SGBA15|  P2 mode!")
  HardwareHelp_L("     +---+---+---+---+------+------+------+------+")
  HardwareHelp_L("SGBA18-15       Base address of P1 and P2 mode sprite pattern generator.")
  HardwareHelp_L("")
  HardwareHelp_L("LCD CONTROL (Read/Write)")
  HardwareHelp_L("========================")
  HardwareHelp_L("       b7  b6  b5  b4  b3   b2   b1   b0")
  HardwareHelp_L("     +---+---+---+---+----+----+-----+----+")
  HardwareHelp_L("R#26 | 0 | 0 | 0 |VRI|PNSL|PLV0|PDUAL|PNEN|")
  HardwareHelp_L("     +---+---+---+---+----+----+-----+----+")
  HardwareHelp_L("VRI     Selection of number of lines during vertical retrace line interval")
  HardwareHelp_L("        when in panel mode")
  HardwareHelp_L("  1     1 line (Frame frequency increases)")
  HardwareHelp_L("  0     Same as CRT mode")
  HardwareHelp_L("")
  HardwareHelp_L("PNSL    Selection of number of vertical direction dot in panel")
  HardwareHelp_L("  1     480 dots")
  HardwareHelp_L("  0     400 dots")
  HardwareHelp_L("")
  HardwareHelp_L("PLV0    Selection of Gray Scaling")
  HardwareHelp_L("  1     Display data is output at color codes to terminals of CB7 to 0.")
  HardwareHelp_L("  0     Binary converted data is output to terminals of D3 to 0.")
  HardwareHelp_L("")
  HardwareHelp_L("PDUAL   Selection of panal type")
  HardwareHelp_L("  1     2 screen panel (single drive type)")
  HardwareHelp_L("  0     1 screen panel")
  HardwareHelp_L("")
  HardwareHelp_L("PNEN    Selection of panel display mode")
  HardwareHelp_L("  1     Display cycle and terminal function used for panel")
  HardwareHelp_L("  0     Display cycle and terminal function used for CRT")
  HardwareHelp_L("")
  HardwareHelp_L("PRIORITY CONTROL (Read/Write)")
  HardwareHelp_L("=============================")
  HardwareHelp_L("      b7  b6  b5  b4  b3   b2   b1   b0")
  HardwareHelp_L("    +---+---+---+---+----+----+----+----+")
  HardwareHelp_L("R#27| 0 | 0 | 0 | 0 |PRY1|PRY0|PRX1|PRX0|")
  HardwareHelp_L("    +---+---+---+---+----+----+----+----+")
  HardwareHelp_L("PRY1,0  When in P1 mode, the display Y coordinate to exchange display priority")
  HardwareHelp_L("        order between screens " + Chr(34) + "A" + Chr(34) + " and " + Chr(34) + "B" + Chr(34) + " is specified.")
  HardwareHelp_L("        A unit of 64 lines is used and in the range lower than the specified")
  HardwareHelp_L("        line (including that line), screen " + Chr(34) + "B" + Chr(34) + " has a priority. At " + Chr(34) + "00" + Chr(34) + ", screen")
  HardwareHelp_L("        " + Chr(34) + "A" + Chr(34) + " has a priority throughout the range.")
  HardwareHelp_L("PRX1,0  When in P1 mode, the display X coordinate to exchange display priority")
  HardwareHelp_L("        order between screens " + Chr(34) + "A" + Chr(34) + " and " + Chr(34) + "B" + Chr(34) + " is specified.")
  HardwareHelp_L("        A unit of 64 dots is used and in that range to the right of the")
  HardwareHelp_L("        specified dot (including that dot), screen " + Chr(34) + "B" + Chr(34) + " has a priority.")
  HardwareHelp_L("        At " + Chr(34) + "00" + Chr(34) + ", screen " + Chr(34) + "A" + Chr(34) + " has a priority throughout the range.")
  HardwareHelp_L("")
  HardwareHelp_L("SPRITE PALETTE CONTROL (Write only)")
