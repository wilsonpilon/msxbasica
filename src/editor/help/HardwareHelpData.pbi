; Auto-gerado por convert_msxbios.py (descartavel, nao versionado) a partir de
; help/MSXBIOS.CHM (RuMSX, Lex Lechz - lexlechz.at), secao "HARDWARE Topics":
; chips/perifericos do MSX (PSG/SCC/VDP/V9990/teclado/portas I/O/etc.). Conteudo
; reproduzido como no original.

Structure HardwareHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList HardwareHelp_Topics.HardwareHelpTopic()
Global HardwareHelp_DataBuilt.b = #False
Global NewList HardwareHelp_Scratch.s()

Procedure HardwareHelp_Begin()
  ClearList(HardwareHelp_Scratch())
EndProcedure

Procedure HardwareHelp_L(Line.s)
  AddElement(HardwareHelp_Scratch())
  HardwareHelp_Scratch() = Line
EndProcedure

Procedure HardwareHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach HardwareHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + HardwareHelp_Scratch()
    First = #False
  Next
  AddElement(HardwareHelp_Topics())
  HardwareHelp_Topics()\Titulo = Titulo
  HardwareHelp_Topics()\Grupo = Grupo
  HardwareHelp_Topics()\Corpo = Body
EndProcedure

Procedure HardwareHelp_BuildData()
  If HardwareHelp_DataBuilt
    ProcedureReturn
  EndIf
  HardwareHelp_DataBuilt = #True

  HardwareHelp_Begin()
  HardwareHelp_L("MSX2 uses a CLOCK-IC to for its timer function. Since this IC is ")
  HardwareHelp_L("battery-powered, it remains active even after MSX2 is turned off. MSX2 uses a ")
  HardwareHelp_L("small amount of RAM inside to set the PASSWORD or to set the screen mode at ")
  HardwareHelp_L("startup automatically, in addition to the CLOCK functions.")
  HardwareHelp_L("")
  HardwareHelp_L("1. CLOCK-IC Functions")
  HardwareHelp_L("")
  HardwareHelp_L("This IC has the following three functions:")
  HardwareHelp_L("")
  HardwareHelp_L("CLOCK function")
  HardwareHelp_L("")
  HardwareHelp_L("set/read the settings of " + Chr(34) + "year, month, day, day of week, hour, minute, second" + Chr(34))
  HardwareHelp_L("for the expression of time, 24-hour clock/12-hour clock available")
  HardwareHelp_L("for months, months of 31 days and of 30 days are distinguished")
  HardwareHelp_L("(leap years are also recognised)")
  HardwareHelp_L("")
  HardwareHelp_L("Alarm function")
  HardwareHelp_L("")
  HardwareHelp_L("when the time for alarm is set, CLOCK generates signals at that time.")
  HardwareHelp_L("the time for alarm is set as " + Chr(34) + "XXday XXhour XXminute" + Chr(34) + ".")
  HardwareHelp_L("")
  HardwareHelp_L("Battery-powered memory function")
  HardwareHelp_L("")
  HardwareHelp_L("has 26 sets of 4-bit memory, and can be battery-powered.")
  HardwareHelp_L("MSX2 stores the following data in this memory:")
  HardwareHelp_L("")
  HardwareHelp_L("	1. adjustment value of CRT display width and height")
  HardwareHelp_L("")
  HardwareHelp_L("	2. initial values of SCREEN, WIDTH, colour")
  HardwareHelp_L("")
  HardwareHelp_L("	3. BEEP tone and volume")
  HardwareHelp_L("")
  HardwareHelp_L("	4. title screen colour")
  HardwareHelp_L("")
  HardwareHelp_L("	5. country code")
  HardwareHelp_L("")
  HardwareHelp_L("	6. password      --+")
  HardwareHelp_L("")
  HardwareHelp_L("	7. BASIC prompt    | (one of 6 to 8)")
  HardwareHelp_L("")
  HardwareHelp_L("	8. title caption      --+")
  HardwareHelp_L("")
  HardwareHelp_L("2. Structure of the CLOCK-IC")
  HardwareHelp_L("")
  HardwareHelp_L("The CLOCK-IC has four blocks inside as shown in Figure 1. Each block ")
  HardwareHelp_L("consists of 13 sets of 4-bit registers, which are specified by addresses from ")
  HardwareHelp_L("0 to 12. In addition, it has three 4-bit registers for selecting the block or ")
  HardwareHelp_L("controlling functions; they are specified by the addresses from 13 to 15.")
  HardwareHelp_L("")
  HardwareHelp_L("The registers inside the block (#0 to #12) and the MODE register (#13) can be ")
  HardwareHelp_L("read from and written to. The TEST register (#14) and RESET register (#15) ")
  HardwareHelp_L("can only be written to.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 1	Clock IC structure")
  HardwareHelp_L("")
  HardwareHelp_L("       BLOCK 0		  BLOCK 1	     BLOCK 2		BLOCK 2")
  HardwareHelp_L("       (CLOCK)		  (ALARM)	     (RAM-1)		(RAM-2)")
  HardwareHelp_L("   ----------------   ----------------	 ----------------   ----------------")
  HardwareHelp_L("   | Seconds (the |   | 	     |	 |		|   |		   |")
  HardwareHelp_L(" 0 | 1st decimal  |   |   ________   |	 |		|   |		   |")
  HardwareHelp_L("   | place)	  |   | 	     |	 |		|   |		   |")
  HardwareHelp_L("   |--------------|   |--------------|	 |-	       -|   |-		  -|")
  HardwareHelp_L("   | Seconds (the |   | 	     |	 |		|   |		   |")
  HardwareHelp_L(" 1 | 2nd decimal  |   |   ________   |	 |		|   |		   |")
  HardwareHelp_L("   | place)	  |   | 	     |	 |		|   |		   |")
  HardwareHelp_L("   |--------------|   |--------------|	 |-	       -|   |-		  -|")
  HardwareHelp_L(" . |	  .	  |   |      .	     |	 |   Any data	|   |	Any data   |")
  HardwareHelp_L(" . |	  .	  |   |      .	     |	 |		|   |		   |")
  HardwareHelp_L(" . |	  .	  |   |      .	     |	 |		|   |		   |")
  HardwareHelp_L(" . |	  .	  |   |      .	     |	 |		|   |		   |")
  HardwareHelp_L(" . |	  .	  |   |      .	     |	 |		|   |		   |")
  HardwareHelp_L("   |--------------|   |--------------|	 |-	       -|   |-		  -|")
  HardwareHelp_L("   | Year (the	  |   | 	     |	 |		|   |		   |")
  HardwareHelp_L(" 12| 2nd decimal  |   |   ________   |	 |		|   |		   |")
  HardwareHelp_L("   | place)	  |   | 	     |	 |		|   |		   |")
  HardwareHelp_L("   ----------------   ----------------	 ----------------   ----------------")
  HardwareHelp_L("   ::   ::	 ::   ::")
  HardwareHelp_L("")
  HardwareHelp_L("   ----------------")
  HardwareHelp_L("13 |	 MODE	  |")
  HardwareHelp_L("   |--------------| --+")
  HardwareHelp_L("14 |	 TEST	  |   |")
  HardwareHelp_L("   |--------------|   |-- Write only")
  HardwareHelp_L("15 |	 RESET	  |   |")
  HardwareHelp_L("   ---------------- --+")
  HardwareHelp_L("   ::")
  HardwareHelp_L("")
  HardwareHelp_L("3. MODE Register Functions")
  HardwareHelp_L("")
  HardwareHelp_L("The MODE register has the following 3 functions:")
  HardwareHelp_L("")
  HardwareHelp_L("Selecting block")
  HardwareHelp_L("")
  HardwareHelp_L("To read from or write to registers from #0 to #12, select the block to be ")
  HardwareHelp_L("used and then access the objective address. The 2 low order bits of the MODE ")
  HardwareHelp_L("register are used to select the block.")
  HardwareHelp_L("")
  HardwareHelp_L("Registers from #13 to #15 are accessible whichever block is selected.")
  HardwareHelp_L("")
  HardwareHelp_L("Alarm output ON/OFF")
  HardwareHelp_L("")
  HardwareHelp_L("To switch the alarm input ON/OFF, use bit 2 of the MODE register. Since the ")
  HardwareHelp_L("standard MSX2 does not support the alarm, modifying this bit causes nothing ")
  HardwareHelp_L("to happen in general.")
  HardwareHelp_L("")
  HardwareHelp_L("Terminating CLOCK count")
  HardwareHelp_L("")
  HardwareHelp_L("By writing " + Chr(34) + "0" + Chr(34) + " in bit 3 of the MODE register, the count in seconds is stopped ")
  HardwareHelp_L("(the stages before the seconds are not stopped) and the clock function is ")
  HardwareHelp_L("terminated. By writing " + Chr(34) + "1" + Chr(34) + " in bit 3, the count is resumed.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 2	MODE register functions")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("| TE | AE | M1 : M0 |  MODE register (#13)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("  |    |       |       00: select block 0")
  HardwareHelp_L("  |    |       |       01: select block 1")
  HardwareHelp_L("  |    |       +---->  10: select block 2")
  HardwareHelp_L("  |    |	       11: select block 3")
  HardwareHelp_L("  |    |")
  HardwareHelp_L("  |    +------------>  0:  alarm output OFF")
  HardwareHelp_L("  |		       1:  alarm output ON")
  HardwareHelp_L("  |")
  HardwareHelp_L("  +----------------->  0:  CLOCK count stop (in seconds)")
  HardwareHelp_L("		       1:  CLOCK count start")
  HardwareHelp_L("")
  HardwareHelp_L("4. TEST Register functions")
  HardwareHelp_L("")
  HardwareHelp_L("The TEST register (#14) is used to increment the upper counter quickly and to ")
  HardwareHelp_L("confirm that date and time carries are done correctly. Setting " + Chr(34) + "1" + Chr(34) + " in each ")
  HardwareHelp_L("bit of the register, the pulse of 2^14 (=16384)[Hz] is directly set in day, ")
  HardwareHelp_L("hour, minute, and second counters.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 3	TEST register functions")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("| T3 | T2 | T1 | T0 |  TEST register (#14)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("  |    |    |	 |")
  HardwareHelp_L("  |  Hours  |  Seconds ........ the location for the pulse to be placed")
  HardwareHelp_L(" Day	  Minutes")
  HardwareHelp_L("")
  HardwareHelp_L("5. RESET Register Functions")
  HardwareHelp_L("")
  HardwareHelp_L("The RESET register (#15) has the following functions:")
  HardwareHelp_L("")
  HardwareHelp_L("Resetting the alarm")
  HardwareHelp_L("")
  HardwareHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 0 causes all alarm registers to be reset to 0.")
  HardwareHelp_L("")
  HardwareHelp_L("Setting the seconds")
  HardwareHelp_L("")
  HardwareHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 1 causes the stage before the seconds to be reset. Use ")
  HardwareHelp_L("this function to set the seconds correctly.")
  HardwareHelp_L("")
  HardwareHelp_L("Clock pulse ON/OFF")
  HardwareHelp_L("")
  HardwareHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 2 turns the 16Hz clock pulse output ON, and setting " + Chr(34) + "0" + Chr(34) + " in ")
  HardwareHelp_L("bit 3 turns the 1Hz clock pulse output ON. Note that both are not supported ")
  HardwareHelp_L("by the MSX2 standard.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 4	RESET register function")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("| C1 | C16| CR | AR |  RESET register (#15)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("  |    |    |	 |")
  HardwareHelp_L("  |    |    |	 +-->  When " + Chr(34) + "1" + Chr(34) + ", all alarm registers are reset")
  HardwareHelp_L("  |    |    +------->  When " + Chr(34) + "1" + Chr(34) + ", fractions smaller than a second are reset")
  HardwareHelp_L("  |    +------------>  When " + Chr(34) + "0" + Chr(34) + ", 16[Hz] clock pulse is ON")
  HardwareHelp_L("  +----------------->  When " + Chr(34) + "0" + Chr(34) + ", 1[Hz] clock pulse is ON")
  HardwareHelp_L("")
  HardwareHelp_L("6. Setting the Clock and Alarm")
  HardwareHelp_L("")
  HardwareHelp_L("Setting date and time")
  HardwareHelp_L("")
  HardwareHelp_L("Block 0 is used to set the clock. Selecting block 0 in the MODE register ")
  HardwareHelp_L("and writing data in the objective register causes the date and the time to be ")
  HardwareHelp_L("set. The current time is acquired by reading the contents of the register. ")
  HardwareHelp_L("See Figure 5 for the meaning of the register and its address.")
  HardwareHelp_L("")
  HardwareHelp_L("Block 1 is used to set the alarm. Note that the time of the alarm can be set ")
  HardwareHelp_L("only in days, hours, and minutes. Nothing happens, in general, when the time ")
  HardwareHelp_L("of the clock meets the time of the alarm.")
  HardwareHelp_L("")
  HardwareHelp_L("In the clock, the year is represented by 2 digits (registers #11 and #12). In ")
  HardwareHelp_L("MSX-BASIC, the 2 low order digits of the year is represented by adding the ")
  HardwareHelp_L("offset 80 to this value. For example, after setting register #11 to 0 and ")
  HardwareHelp_L("register #12 to 0, the year would be 80, as " + Chr(34) + "80/XX/XX" + Chr(34) + ", when the date is read ")
  HardwareHelp_L("by using the GET DATE instruction of BASIC.")
  HardwareHelp_L("")
  HardwareHelp_L("The day of the week is represented by 0 to 6. This is only a mod 7 counter ")
  HardwareHelp_L("which is renewed alomg with the date, and the correspondence between the ")
  HardwareHelp_L("actual day of the week and the number value 0 to 6 is not defined.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 5	Setting the CLOCK and ALARM")
  HardwareHelp_L("")
  HardwareHelp_L("		       block 0 : CLOCK")
  HardwareHelp_L("   ---------------------------------------------------------")
  HardwareHelp_L("   |			       |  B3  |  B2  |	B1  |  B0  |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 0 |  Seconds		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 1 |  Seconds		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 2 |  Minutes		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 3 |  Minutes		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 4 |  Hours		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 5 |  Hours		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 .	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 6 |  Day of		       |			   |")
  HardwareHelp_L("   |  the week		       |  .	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 7 |  Day		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 8 |  Day		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 .	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 9 |  Month		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("10 |  Month		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 .	.      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("11 |  Year		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("12 |  Year		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   ---------------------------------------------------------")
  HardwareHelp_L("")
  HardwareHelp_L("		       block 1 : ALARM")
  HardwareHelp_L("   ---------------------------------------------------------")
  HardwareHelp_L("   |			       |  B3  |  B2  |	B1  |  B0  |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 0 |	 _________________     |			   |")
  HardwareHelp_L("   |			       |  .	 .	.      .   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 1 |	 _________________     |			   |")
  HardwareHelp_L("   |			       |  .	 .	.      .   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 2 |  Minutes		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 3 |  Minutes		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 4 |  Hours		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 5 |  Hours		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 .	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 6 |  Day of		       |			   |")
  HardwareHelp_L("   |  the week		       |  .	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 7 |  Day		       |			   |")
  HardwareHelp_L("   |  (the 1st decimal place)  |  X	 X	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 8 |  Day		       |			   |")
  HardwareHelp_L("   |  (the 2nd decimal place)  |  .	 .	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L(" 9 |	 _________________     |			   |")
  HardwareHelp_L("   |			       |  .	 .	.      .   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("10 |  12 or		       |			   |")
  HardwareHelp_L("   |  24 hours		       |  .	 .	.      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("11 |  Leap year 	       |			   |")
  HardwareHelp_L("   |  counter		       |  .	 .	X      X   |")
  HardwareHelp_L("   |---------------------------+---------------------------|")
  HardwareHelp_L("12 |	 _________________     |			   |")
  HardwareHelp_L("   |			       |  .	 .	.      .   |")
  HardwareHelp_L("   ---------------------------------------------------------")
  HardwareHelp_L("")
  HardwareHelp_L("    Bits indicated by an " + Chr(34) + "." + Chr(34) + " are always 0 and cannot be modified.")
  HardwareHelp_L("")
  HardwareHelp_L("Selecting 12-hour clock/24-hour clock")
  HardwareHelp_L("")
  HardwareHelp_L("Two clocks can be selected; one is a 24-hour clock which represents one ")
  HardwareHelp_L("o'clock in the afternoon as 13 o'clock, and the other is a 12-hour clock ")
  HardwareHelp_L("which represents it as 1 p.m. Register #10 is used to select between them. As ")
  HardwareHelp_L("shown in Figure 6, the 12-hour clock is selected when B0 is " + Chr(34) + "0" + Chr(34) + " and the ")
  HardwareHelp_L("24-hour clock when B0 is " + Chr(34) + "1" + Chr(34) + ".")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 6	Selecting 12-hour clock/24-hour clock")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("|  . |	. |  . | B0 |  Register #10 (block 1)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("		 |")
  HardwareHelp_L("		 +-->  0: 12-hour clock")
  HardwareHelp_L("		       1: 24-hour clock")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 7	Morning/afternoon flag for 12-hour clock")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("|  . |	. | B1 |  X |  register #5 (block 0)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("	    |")
  HardwareHelp_L("	    +------->  0: before noon")
  HardwareHelp_L("		       1: after noon")
  HardwareHelp_L("")
  HardwareHelp_L("Leap year counter")
  HardwareHelp_L("")
  HardwareHelp_L("Register #11 of block 1 is a mod 4 counter which is renewed along with the ")
  HardwareHelp_L("count of the year. When the 2 low order bits of this register are 00H, that ")
  HardwareHelp_L("is considered as a leap year and 29 days are counted in February.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 8	Leap year determination")
  HardwareHelp_L("")
  HardwareHelp_L("  B3   B2   B1	 B0")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("|  . |	. | B1 | B0 |  Register #11 (block 1)")
  HardwareHelp_L("---------------------")
  HardwareHelp_L("	    |	 |")
  HardwareHelp_L("	    +----+-->  Both bits 0 represents leap year.")
  HardwareHelp_L("")
  HardwareHelp_L("7. Contents of the Battery-powered Memory")
  HardwareHelp_L("")
  HardwareHelp_L("Blocks 2 and 3 of the CLOCK-IC are used as the battery-powered 4-bit x 13 ")
  HardwareHelp_L("memory blocks. MSX2 uses this area as shown below.")
  HardwareHelp_L("")
  HardwareHelp_L("Contents of block 2")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 9	Contents of block 2")
  HardwareHelp_L("")
  HardwareHelp_L("   |	   B3	    |	    B2	     |	     B1       |       B0       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 0 |				     ID 			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 1 |			    Adjust X (-8 to +7) 		       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 2 |			    Adjust Y (-8 to +7) 		       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 3 |   __________   |	__________   | Interlace mode |  Screen mode   |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 4 |			     WIDTH value (Lo)			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 5 |			     WIDTH value (Hi)			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 6 |			     Foreground color			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 7 |			     Background color			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 8 |			       Border color			       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L(" 9 | Cassette speed |  Printer mode  |	 Key click    |   Key ON/OFF   |")
  HardwareHelp_L("   |---------------------------------+---------------------------------|")
  HardwareHelp_L("10 |		BEEP tone	     |		 BEEP volume	       |")
  HardwareHelp_L("   |---------------------------------+---------------------------------|")
  HardwareHelp_L("11 |   __________   |	__________   |		 Title colour	       |")
  HardwareHelp_L("   |-------------------------------------------------------------------|")
  HardwareHelp_L("12 |				Native code			       |")
  HardwareHelp_L("   ---------------------------------------------------------------------")
  HardwareHelp_L("")
  HardwareHelp_L("Contents of block 3")
  HardwareHelp_L("")
  HardwareHelp_L("Block 3 has three functions, depending on the contents of the ID value ")
  HardwareHelp_L("(register #0). Figure 10 shows the functions.")
  HardwareHelp_L("")
  HardwareHelp_L("   Figure 10	Contents of block 3")
  HardwareHelp_L("")
  HardwareHelp_L("ID=0: displays the title (within 6 characters) on the initial screen")
  HardwareHelp_L("   ------------------------------------------------------")
  HardwareHelp_L(" 0 |  0 						|")
  HardwareHelp_L("   |----------------------------------------------------| --+")
  HardwareHelp_L(" 1 |  Lo 1 --+--- 1st character of the title		|   |")
  HardwareHelp_L("   |	     |						|   |")
  HardwareHelp_L(" 2 |  Hi 1 --+						|   |")
