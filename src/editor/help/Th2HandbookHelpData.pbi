  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`HEX$ (<expression>)`  |  Function  |  Converts the value of `<expression>` to a string of hexadecimal expression, then returns its result.")
  Th2HandbookHelp_Commit("--- H ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#h", 43)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`IF <condition> THEN {<statement> \  |  <linenumber>} [ELSE {<statement> \  |  <linenumber>}]`  |  Statement  |  Judges the condition. If `<condition>` is not zero, it is true.")
  Th2HandbookHelp_L("`IF <condition> GOTO <linenumber> [ELSE {<statement> \  |  <linenumber>}]`  |  Statement  |  Judges the condition. If `<condition>` is not zero, it is true.")
  Th2HandbookHelp_L("`INKEY$`  |  Function  |  Returns a character when a key is being pressed, or when not, returns null string.")
  Th2HandbookHelp_L("`INP (<port number>)`  |  Function  |  Reads the port specified by `<port number>` and returns its result.")
  Th2HandbookHelp_L("`INPUT [" + Chr(34) + "<prompt statement>" + Chr(34) + ";]<variable name>[, <variable name>...]`  |  Statement  |  Assigns data input from keyboard into the specified variable(s).")
  Th2HandbookHelp_L("`INPUT #<filenumber>, <variable name>[, <variable name>...]`  |  Statement  |  Reads data from the file and assigns the data into the specified variable(s).")
  Th2HandbookHelp_L("`INPUT$ (<number of characters>[, [#]<filenumber>])`  |  Function  |  Reads the specified size of string from the keyboard or file.")
  Th2HandbookHelp_L("`INSTR ([<expression>,]<string expression 1>,<string expression 2>)`  |  Function  |  Searches `<string expression 2>` from the left of `<string expression 1>`, and returns its location if found, otherwise zero. `<Expression>` is the character location to start searching.")
  Th2HandbookHelp_L("`INT (<expression>)`  |  Function  |  Returns the largest integer less than `<expression>`.")
  Th2HandbookHelp_L("`INTERVAL {ON \  |  OFF \  |  STOP}`  |  Statement  |  Allows, suppresses, or suspends the timer interrupt.")
  Th2HandbookHelp_Commit("--- I ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#i", 44)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`KEY <key number>,<string>`  |  Command  |  Redefines a function key.")
  Th2HandbookHelp_L("`KEY LIST`  |  Command  |  Displays the contents of function keys.")
  Th2HandbookHelp_L("`KEY (<key number>){ON \  |  OFF \  |  STOP}`  |  Statement  |  Allows, supresses, os suspends the function key interrupt.")
  Th2HandbookHelp_L("`KEY {ON \  |  OFF}`  |  Statement  |  Specifies whethter to display the contents of function keys at the bottom of the screen.")
  Th2HandbookHelp_Commit("--- K ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#k", 45)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`LEFT$ (<string expression>,<expression>)`  |  Function  |  Gets `<expression>` characters from the left of `<string expression>`.")
  Th2HandbookHelp_L("`LEN (<string expression>)`  |  Function  |  Returns the number of characters of `<string expression>`.")
  Th2HandbookHelp_L("`[LET] <variable name> = <expression>`  |  Statement  |  Assigns the value of `<expression>` to the variable.")
  Th2HandbookHelp_L("**`* LINE [{(X1,Y1) \  |  STEP(X1,Y1)}] - {(X2,Y2) \  |  STEP(X2,Y2)}[, <colour> [, {B\  |  BF}[, <logical operation>]]]`**  |  Statement  |  Draws a line or a rectangle on the screen.")
  Th2HandbookHelp_L("`LINE INPUT [" + Chr(34) + "<prompt statement>" + Chr(34) + ";]<string variable name>`  |  Statement  |  Assigns a whole line of string data from the keyboard into the string variable.")
  Th2HandbookHelp_L("`LINE INPUT# <filenumber>, <string variable name>`  |  Statement  |  Reads data in lines from the file and assigns the data into the string variable.")
  Th2HandbookHelp_L("`LIST [[<linenumber>] - [<linenumber>]]`  |  Command  |  Displays the program in memory on the screen.")
  Th2HandbookHelp_L("`LLIST [[<linenumber>] - [<linenumber>]]`  |  Command  |  Sends the program in memory to the printer.")
  Th2HandbookHelp_L("`LOAD " + Chr(34) + "<filename>" + Chr(34) + " [,R]`  |  Command  |  Loads a program saved in ASCII format.")
  Th2HandbookHelp_L("**`* LOCATE [<X-coordinate>[, <Y-coordinate>[, <cursor switch>]]]`**  |  Statement  |  Locates the cursor on the text screen.")
  Th2HandbookHelp_L("`LOG (<expression>)`  |  Function  |  Returns the natural logarithm of `<expression>`.")
  Th2HandbookHelp_L("`LPOS (<expression>)`  |  System variable  |  Contains the location of the printer head. No assignment is allowed.")
  Th2HandbookHelp_L("`LPRINT [<expression>[{; \  |  ,}<express]ion>...]`  |  Statement  |  Outputs characters or numerical values to the printer.")
  Th2HandbookHelp_L("`LPRINT USING <form>; <expression>[{; \  |  ,}<expression>...]`  |  Statement  |  Outputs characters or numerical values through the printer according to `<form>`.")
  Th2HandbookHelp_Commit("--- L ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#l", 46)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`MAXFILES = <number of files>`  |  Statement  |  Sets the number of files to be opened.")
  Th2HandbookHelp_L("`MERGE " + Chr(34) + "<filename>" + Chr(34) + "`  |  Command  |  Merges the program in memory with the program saved in ASCII format (in external storage device).")
  Th2HandbookHelp_L("`MID$ (<string expression>, <expression 1>[, <expression 2>])`  |  Function  |  Returns `<expression 2>` character(s) starting from the `<expression 1>`th position of `<string expression>`.")
  Th2HandbookHelp_L("`MID$ (<string variable name>, <expression 1>[, <expression 2>]) = <string expression>`  |  Statement  |  Defines `<string expression>` using `<expression 2>` character(s) from the `<expression 1>`th position of `<string variable name>`.")
  Th2HandbookHelp_L("`MOTOR [{ON \  |  OFF}]`  |  Statement  |  Turns the motor of cassette ON and OFF.")
  Th2HandbookHelp_Commit("--- M ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#m", 47)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`NEW`  |  Command  |  Deletes the program in meory and clears variables.")
  Th2HandbookHelp_L("`NEXT [<variable name>[, <variable name>...]]`  |  Statement  |  Indicates the end of FOR statement.")
  Th2HandbookHelp_Commit("--- N ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#n", 48)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`OCT$ (<expression>)`  |  Function  |  Converts the value of `<expression>` to the string of octal expression and returns its result.")
  Th2HandbookHelp_L("`ON ERROR GOTO <linenumber>`  |  Statement  |  Defines the line to begin the error handling routine.")
  Th2HandbookHelp_L("`ON <expression> GOSUB <linenumber>[, <linenumber>...]`  |  Statement  |  Executes the subroutine at `<linenumber>` according to `<expression>`.")
  Th2HandbookHelp_L("`ON <expression> GOTO <linenumber>[, <linenumber>...]`  |  Statement  |  Jumps to `<linenumber>` according to `<expression>`.")
  Th2HandbookHelp_L("`ON INTERVAL = <time> GOSUB <linenumber>`  |  Statement  |  Defines the timer interrupt interval and the line to begin the interrupt handling routine.")
  Th2HandbookHelp_L("`ON KEY GOSUB <linenumber>[, <linenumber>...]`  |  Statament  |  Defines the line to begin the function key interrupt handling routine.")
  Th2HandbookHelp_L("`ON SPRITE GOSUB <linenumber>`  |  Statement  |  Defines the line to begin the piled-sprite interrupt handling routine.")
  Th2HandbookHelp_L("`ON STOP GOSUB <linenumber>`  |  Statament  |  Defines the line to begin the CTRL+STOP key interrupt handling routine.")
  Th2HandbookHelp_L("`ON STRING GOSUB <linenumber>[, <linenumber>...]`  |  Statement  |  Defines the line to begin the trigger button interrupt handling routine.")
  Th2HandbookHelp_L("`OPEN " + Chr(34) + "<filename>" + Chr(34) + " [FOR <mode>] AS #<filenumber>`  |  Statement  |  Opens the file in the specified mode.")
  Th2HandbookHelp_L("`OUT <port number>,<expression>`  |  Statement  |  Sends data to the output port specified by `<port number>`.")
  Th2HandbookHelp_Commit("--- O ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#o", 49)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("**`* PAD (<expression>)`**  |  Function  |  Examines the state of tablet, mouse, light pen, or track ball specified by `<expression>`, then returns its result.")
  Th2HandbookHelp_L("**`* PAINT {(X,Y) \  |  STEP(X,Y)}[, <colour>[, <border colour>]]`**  |  Statement  |  Paints the area surrounded by specified `<border colour>` using `<colour>`.")
  Th2HandbookHelp_L("`PDL (<paddle number>)`  |  Function  |  Returns the state of the paddle which has the specified number.")
  Th2HandbookHelp_L("`PEEK (<address>)`  |  Function  |  Returns the contents of one byte of the memory specified by `<address>`.")
  Th2HandbookHelp_L("`PLAY <string expression 1>[, <string expression 2>[, <string expression 3>]]`  |  Statement  |  Plays the music by `<string expression (music macro)>`.")
  Th2HandbookHelp_L("`PLAY (<voice channel>)`  |  Function  |  Examines whethter the music is being played and returns its result (if in play, -1 is returned).")
  Th2HandbookHelp_L("`POINT (X,Y)`  |  Function  |  Returns the colour of the dot specified by coordinate (X,Y).")
  Th2HandbookHelp_L("`POKE <address>,<data>`  |  Statement  |  Writes one byte of `<data>` into the memory specified by `<address>`.")
  Th2HandbookHelp_L("`POS (<expression>)`  |  System variable  |  Contains the horizontal location of the cursor on the text screen. No assignment is allowed.")
  Th2HandbookHelp_L("**`* PRESET {(X,Y) \  |  STEP(X,Y)}[, <colour>[, <logical operation>]]`**  |  Statement  |  Erases the dot specified by coordinate (X,Y) on the graphic screen")
  Th2HandbookHelp_L("`PRINT [<expression [{; \  |  ,}<expression>...]`  |  Statement  |  Displays characters of numbers on the screen.")
  Th2HandbookHelp_L("`PRINT USING <form>; <expression>[{; \  |  ,}<expression>...]`  |  Statement  |  Displays characters or numbers on the screen according to `<form>`.")
  Th2HandbookHelp_L("`PRINT #<filenumber>, [<expression>[{; \  |  ,}<expression>...]]`  |  Statement  |  Writes characters or numbers to the file specified by `<file number>`.")
  Th2HandbookHelp_L("`PRINT #<filenumber>, USING <form>; <expression>[{; \  |  ,}<expression>...]`  |  Statement  |  Writes characters or numbers to the file specified by `<file number>` according to `<form>`.")
  Th2HandbookHelp_L("`PSET {(X,Y) \  |  STEP(X,Y)}[, <colour>[, <logical operation>]]`  |  Statement  |  Draws the dot in the coordinate specified by (X,Y) on the graphic screen.")
  Th2HandbookHelp_L("**`* PUT KANJI [(X,Y)],<JIS kanji code>[, <colour>[, <logical operation> [, <mode>]]]`**  |  Statement  |  Displays the kanji on the screen (KANJI ROM is required).")
  Th2HandbookHelp_L("**`* PUT SPRITE <sprite plane number>[, {(X,Y) \  |  STEP(X,Y)}[, <colour>[, <sprite pattern number>]]]`**  |  Statement  |  Displays the sprite pattern.")
  Th2HandbookHelp_Commit("--- P ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#p", 50)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`READ <variable name>[, <variable name>...]`  |  Statement  |  Reads data from DATA statement(s) and assigns the data to the variable(s).")
  Th2HandbookHelp_L("`REM [<comment>]`  |  Statement  |  Puts the comment in the program.")
  Th2HandbookHelp_L("`RENUM [<new linenumber>[, <old linenumber>[, <increment>]]]`  |  Command  |  Renumbers the line numbers.")
  Th2HandbookHelp_L("`RESTORE [<linenumber>]`  |  Statement  |  Specifies the line to begin reading DATA by READ statement.")
  Th2HandbookHelp_L("`RESUME {[0] \  |  NEXT \  |  <linenumber>}`  |  Statement  |  Ends the error recovery routine and resumes execution of the program.")
  Th2HandbookHelp_L("`RETURN [<linenumber>]`  |  Statement  |  Returns from a subroutine.")
  Th2HandbookHelp_L("`RIGHT$ (<string expression>, <expression>)`  |  Function  |  Gets `<expression>` characters from the right of `<string expression>`.")
  Th2HandbookHelp_L("`RND [(<expression>)]`  |  Function  |  Returns a random number between 0 and 1.")
  Th2HandbookHelp_L("`RUN [<linenumber>]`  |  Command  |  Executes the program from `<linenumber>`.")
  Th2HandbookHelp_Commit("--- R ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#r", 51)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`SAVE " + Chr(34) + "<filename>" + Chr(34) + "`  |  Command  |  Saves the program in ASCII format.")
  Th2HandbookHelp_L("**`* SCREEN <screen mode>[, <sprite size>[, <key click switch>[, <cassette baud rate>[, <printer option>[, <interlace mode>]]]]]`**  |  Statement  |  Sets the screen mode and so on.")
  Th2HandbookHelp_L("**`* SET ADJUST (<X-coordinate offset>, <Y-coordinate offset>)`**  |  statement  |  Changes the display location of the screen. Ranges from -7 to 8.")
  Th2HandbookHelp_L("**`* SET BEEP <timbre>, <volume>`**  |  Statement  |  Selects the BEEP tone. Ranges from 1 to 4.")
  Th2HandbookHelp_L("**`* SET DATE <strign expression>[, A]`**  |  Statement  |  Sets a date. " + Chr(34) + "A" + Chr(34) + " is the specification of alarm.")
  Th2HandbookHelp_L("**`* SET PAGE <display page>, <active page>`**  |  Statement  |  Specifies the page to display and the page to read and write data to.")
  Th2HandbookHelp_L("**`* SET PASSWORD <string expression>`**  |  Statement  |  Sets a password.")
  Th2HandbookHelp_L("**`* SET PROMPT <string expression>`**  |  Statement  |  Sets a prompt (up to 8 characters).")
  Th2HandbookHelp_L("**`* SET SCREEN`**  |  Statement  |  Reserves the parameters of the current settings of SCREEN statement.")
  Th2HandbookHelp_L("**`* SET TIME <string expression>[, A]`**  |  Statement  |  Sets time. " + Chr(34) + "A" + Chr(34) + " is the alarm specification.")
  Th2HandbookHelp_L("**`* SET VIDEO [<mode>[, <Ym>[, <CB>[, <sync>[, <voice>[, <video input>[, <AV control>]]]]]]]`**  |  Statement  |  Sets superimposing and other modes (optional).")
  Th2HandbookHelp_L("`SGN (<expression>)`  |  Function  |  Examines the sign of `<expression>` and returns its result (positive=1, zero=0, negative=-1).")
  Th2HandbookHelp_L("`SIN (<expression>)`  |  Function  |  Returns the sine of `<expression>` in radians.")
  Th2HandbookHelp_L("`SOUND <register number>,<data>`  |  Statement  |  Writes data to the register of PSG.")
  Th2HandbookHelp_L("`SPACE$ (<expression>)`  |  Function  |  Returns a string containing `<expression>` spaces.")
  Th2HandbookHelp_L("`SPC (<expression>)`  |  Function  |  Produces `<expression>` spaces; used in the instructions of PRINT family.")
  Th2HandbookHelp_L("`SPRITE {ON \  |  OFF \  |  STOP}`  |  Statement  |  Allows, supresses, or suspends the piled-sprite interrupt.")
  Th2HandbookHelp_L("`SPRITE$ (<sprite pattern number>)`  |  System variable  |  Contains the sprite pattern.")
  Th2HandbookHelp_L("`SQR (<expression>)`  |  Function  |  Returns the square root of `<expression>`.")
  Th2HandbookHelp_L("`STICK (<joystick number>)`  |  Function  |  Examines the direction of the joystick and returns its result.")
  Th2HandbookHelp_L("`STOP`  |  Statement  |  Stops the execution of the program.")
  Th2HandbookHelp_L("`STRIG (<joystick number>)`  |  Function  |  Examines the state of the trigger button and returns its result.")
  Th2HandbookHelp_L("`STRIG (<joystick number>) {ON \  |  OFF \  |  STOP}`  |  Statement  |  Allows, supresses, or suspends interrupts from the trigger button.")
  Th2HandbookHelp_L("`STR$ (<expression>)`  |  Function  |  Converts the value of `<expression>` to a string decimal expression and returns its result.")
  Th2HandbookHelp_L("`STRING$ (<expression 1>, {<string expression> \  |  <expression 2>}`  |  Function  |  Converts the leading character of `<string expression>` or the character containing the code `<expression 2>` to a string whose length is `<expression 1>`, and returns the string.")
  Th2HandbookHelp_L("`SWAP <variable name>, <variable name>`  |  Statement  |  Exchanges the value of two variables.")
  Th2HandbookHelp_Commit("--- S ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#s", 52)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`TAB (<expression>)`  |  Function  |  Produces the specified spaces in PRINT instructions.")
  Th2HandbookHelp_L("`TAN (<expression>)`  |  Function  |  Returns the tangent of `<expression>` in radians.")
  Th2HandbookHelp_L("`TIME`  |  System variable  |  Contains the value of the interval timer.")
  Th2HandbookHelp_L("`TRON`  |  Command  |  Keeps displaying the line numbers of the program currently being executed.")
  Th2HandbookHelp_L("`TROFF`  |  Command  |  Cancels TRON and stops displaying the line numbers.")
  Th2HandbookHelp_Commit("--- T ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#t", 53)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`USR [<number](<argument>)`  |  Function  |  Calls the assembly language routine.")
  Th2HandbookHelp_Commit("--- U ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#u", 54)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`VAL (<string expression>)`  |  Function  |  Converts `<string expression>` to a numerical value and returns its result.")
  Th2HandbookHelp_L("`VARPTR (<variable name>)`  |  Function  |  Returns the address containing the variable.")
  Th2HandbookHelp_L("`VARPTR (#<filenumber>)`  |  Function  |  Returns the starting address of the file control block.")
  Th2HandbookHelp_L("**`* VDP (<register number>)`**  |  System variable  |  Writes/reads data to/from the VDP registers.")
  Th2HandbookHelp_L("**`* VPEEK (<address>)`**  |  Function  |  Reads data from `<address>` in VRAM.")
  Th2HandbookHelp_L("**`* VPOKE (<address>)`**  |  Statement  |  Writes data to `<address>` in VRAM.")
  Th2HandbookHelp_Commit("--- V ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#v", 55)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`WAIT <port number>, <expression 1>[, <expression 2>]`  |  Statement  |  Stops the execution until data of the input port grows to the specified value.")
  Th2HandbookHelp_L("**`* WIDTH <number>`**  |  Statement  |  Specifies the number of characters per line in the display screen.")
  Th2HandbookHelp_Commit("--- W ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#w", 56)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("**Note:** Instructions marked with **" + Chr(34) + "*\*" + Chr(34) + "** have been added to version 2 of MSX DISK-BASIC and are not available in version 1.")
  Th2HandbookHelp_Commit("1.2 Instructions of MSX DISK-BASIC", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#12-instructions-of-msx-disk-basic", 57)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("**`* BLOAD " + Chr(34) + "<filename>" + Chr(34) + "[{[, R] \  |  [, S]}[, <offset>]]`**  |  Command  |  Loads the assembly language program or screen data from a file.")
  Th2HandbookHelp_L("**`* BSAVE " + Chr(34) + "<filename>" + Chr(34) + ", <start address>, <end address>[, {<execution address> \  |  S}]`**  |  Command  |  Saves the assembly language program or screen data in a file.")
  Th2HandbookHelp_Commit("--- B ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#b-1", 58)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`CLOSE [[#]<filenumber>[, [#]<filenumber>...]]`  |  Statement  |  Closes the file specified by `<filenumber>`.")
  Th2HandbookHelp_L("**`** CALL CHDRV (" + Chr(34) + "<drive name>:" + Chr(34) + ")`**  |  Command  |  Sets the drive specified by `<drive name>` as the default drive.")
  Th2HandbookHelp_L("**`** CALL CHDIR (" + Chr(34) + "<directory path>" + Chr(34) + ")`**  |  Command  |  Changes to the directory specified by `<directory path>`.")
  Th2HandbookHelp_L("`CALL FORMAT`  |  Command  |  Formats the floppy disk.")
  Th2HandbookHelp_L("**`** CALL MKDIR (" + Chr(34) + "<directory name>" + Chr(34) + ")`**  |  Command  |  Creates the directory with the name specified in `<directory name>` in the current directory.")
  Th2HandbookHelp_L("**`** CALL RAMDISK (<size in kilobytes>[, <variable name>])`**  |  Command  |  Tries to crate the DOS 2 RAM disk of the specified size, and returns in the variable (if specified) the actual size of the RAM disk created.")
  Th2HandbookHelp_L("**`** CALL RMDIR (" + Chr(34) + "<directory name>" + Chr(34) + ")`**  |  Command  |  Deletes the directory specified in `<directory name>`. If the directory is not empty, " + Chr(34) + "File already exists" + Chr(34) + " error will be returned.")
  Th2HandbookHelp_L("`CALL SYSTEM`  |  Command  |  Returns to MSX-DOS.")
  Th2HandbookHelp_L("**`** CALL SYSTEM [(" + Chr(34) + "<filename>" + Chr(34) + ")]`**  |  Command  |  Returns to MSX-DOS and executes the DOS command `<filename>` if it is specified.")
  Th2HandbookHelp_L("`COPY " + Chr(34) + "<filename 1>" + Chr(34) + "[ TO " + Chr(34) + "<filename 2>" + Chr(34) + "]`  |  Command  |  Copies the contents of `<filename 1>` to the file specified by `<filename 2>`.")
  Th2HandbookHelp_L("`CVD (<8-byte string>)`  |  Function  |  Converts the string to the double precision real value and returns its result.")
  Th2HandbookHelp_L("`CVI (<2-byte string>)`  |  Function  |  Converts the string to the integer value and returns its result.")
  Th2HandbookHelp_L("`CVS (<4-byte string>)`  |  Function  |  Converts the string to the single precision real value and returns its result.")
  Th2HandbookHelp_Commit("--- C ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#c-1", 59)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`DSKF (<drive number>)`  |  Function  |  Returns the unused portions of the disk in clusters.")
  Th2HandbookHelp_L("`DSKI$ (<drive number>, <sector number>)`  |  Function  |  Reads the specified sector of the specified drive to the memory area indicated by address &HF351, and returns a null string.")
  Th2HandbookHelp_L("`DSKO$ (<drive number>, <sector number>)`  |  Statement  |  Writes 512 bytes starting from address indicated by &HF351 to the specified sector of the specified drive.")
  Th2HandbookHelp_Commit("--- D ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#d-1", 60)

  Th2HandbookHelp_Begin()
