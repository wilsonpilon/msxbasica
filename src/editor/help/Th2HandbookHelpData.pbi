  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("  * **contents**:")
  Th2HandbookHelp_L("@@@* 1200 baud:")
  Th2HandbookHelp_L("@@@  * 83 (LOW01): Low width representing bit 0")
  Th2HandbookHelp_L("@@@  * 92 (HIGH01): High width representing bit 0")
  Th2HandbookHelp_L("@@@  * 38 (LOW11): Low width representing bit 1")
  Th2HandbookHelp_L("@@@  * 45 (HIGH11): High width representing bit 1")
  Th2HandbookHelp_L("@@@  * HEADLEN * 2/256: High bytes (HEDLEN = 2000) of header bits for short header")
