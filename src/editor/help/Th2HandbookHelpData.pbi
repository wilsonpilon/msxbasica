  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("A point is drawn at any coordinate in VRAM (see figure 4.99).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.100|||Chapter4b#figure-4100--register-settings-of-pset-command]]], writing 5XH (X means a logical operation) in R#46 causes the command to be executed. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed. [[[List 4.20|||Chapter4b#list-420--example-of-pset-command-execution]]] shows an example of using PSET.")
  Th2HandbookHelp_Commit("6.5.11 PSET (drawing a point)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#6511-pset-drawing-a-point", 548)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|              (DX,DY)                            |")
  Th2HandbookHelp_L("@@@|                 x                               |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: memory selection                   0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX: origin X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@DY: origin Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
