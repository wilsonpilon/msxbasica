  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the value of the specified line from the keyboard matrix")
  Th2HandbookHelp_L("* **Input**: A for the specified line")
  Th2HandbookHelp_L("* **Output**: A for data (the bit corresponding to the pressed key will be 0)")
  Th2HandbookHelp_L("* **Registers**: AF, C")
  Th2HandbookHelp_Commit("SNSMAT (0141H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#snsmat-0141h-1", 840)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: Physical input/output for disk devices")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * A for the drive number (0 = A:, 1 = B:,...)")
  Th2HandbookHelp_L("  * B for the number of sector to be read from or written to ")
  Th2HandbookHelp_L("  * C for the media ID DE for the first sector number to be read rom or written to")
  Th2HandbookHelp_L("  * HL for the startinga address of the RAM buffer to be read from or written to specified sectors")
  Th2HandbookHelp_L("  * CY set for sector writing; reset for sector reading")
  Th2HandbookHelp_L("* **Output**: ")
  Th2HandbookHelp_L("  * CY set if failed ")
  Th2HandbookHelp_L("  * B for the number of sectors actually read or written")
  Th2HandbookHelp_L("  * A for the error code (only if CY set):")
  Th2HandbookHelp_L("@@@* 0 = Write protected ")
  Th2HandbookHelp_L("@@@* 2 = Not ready")
  Th2HandbookHelp_L("@@@* 4 = Data error ")
  Th2HandbookHelp_L("@@@* 6 = Seek error ")
  Th2HandbookHelp_L("@@@* 8 = Record not found")
  Th2HandbookHelp_L("@@@* 10 = Write error")
  Th2HandbookHelp_L("@@@* 12 = Bad parameter ")
  Th2HandbookHelp_L("@@@* 14 = Out of memory ")
  Th2HandbookHelp_L("@@@* 16 = Other error")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("PHYDIO (0144H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#phydio-0144h", 841)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: tests whether the device is active")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: ")
  Th2HandbookHelp_L("  * A = 0 ⟶ active ")
  Th2HandbookHelp_L("  * A <>0 ⟶ inactive")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("ISFLIO (014AH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#isflio-014ah-1", 842)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: printer output. Different from [[[LPTOUT|||Appendix1#lptout-00a5h-1]]] in the following points:")
  Th2HandbookHelp_L("1. TAB is expanded to spaces")
  Th2HandbookHelp_L("2. For non-MSX printers, hiragana is transformed to katakana and graphic characters are transformed to 1-byte characters.")
  Th2HandbookHelp_L("3. If failed, device I/O error occurs.")
  Th2HandbookHelp_L("* **Input**: A for data")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("OUTDLP (014DH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#outdlp-014dh-1", 843)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: clears the keyboard buffer")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: HL")
  Th2HandbookHelp_Commit("KILBUF (0156H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#kilbuf-0156h-1", 844)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: executes inter-slot call to the routine in BASIC interpreter")
  Th2HandbookHelp_L("* **Input**: IX for the calling address")
  Th2HandbookHelp_L("* **Output**: depends on the called routine")
  Th2HandbookHelp_L("* **Registers**: depends on the called routine")
  Th2HandbookHelp_Commit("CALBAS (0159H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#calbas-0159h-1", 845)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: executes inter-slot call to SUB-ROM")
  Th2HandbookHelp_L("* **Input**: IX for the calling address and, at the same time, pushes IX on the stack")
  Th2HandbookHelp_L("* **Output**: depends on the called routine")
  Th2HandbookHelp_L("* **Registers**: background registers and IY are reserved")
  Th2HandbookHelp_Commit("SUBROM (015CH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#subrom-015ch", 846)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: executes inter-slot call to SUB-ROM")
  Th2HandbookHelp_L("* **Input**: IX for the calling address")
  Th2HandbookHelp_L("* **Output**: depends on the called routine")
  Th2HandbookHelp_L("* **Registers**: background registers and IY are reserved")
  Th2HandbookHelp_Commit("EXTROM (015FH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#extrom-015fh", 847)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: deletes to the end of the line")
  Th2HandbookHelp_L("* **Input**: H for X-coordinate of the cursor, L for Y-coordinate")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("EOL (0168H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#eol-0168h", 848)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: same function as [[[FILVRM|||Appendix1#filvrm-0056h-4]]]. Differences are as follows: ")
  Th2HandbookHelp_L("  * In [[[FILVRM|||Appendix1#filvrm-0056h-4]]], it is tested whether the screen mode is 0 to 3. If so, it treats VDP as the one which has only 16K bytes VRAM (for the compatibility with MSX1). ")
  Th2HandbookHelp_L("  * In [[[BIGFIL|||Appendix1#bigfil-016bh]]], the mode is not tested and actions are carried out by the given parameters.")
  Th2HandbookHelp_L("* **Input**: same as [[[FILVRM|||Appendix1#filvrm-0056h-4]]]")
  Th2HandbookHelp_L("* **Output**: same as [[[FILVRM|||Appendix1#filvrm-0056h-4]]]")
  Th2HandbookHelp_L("* **Registers**: same as [[[FILVRM|||Appendix1#filvrm-0056h-4]]]")
  Th2HandbookHelp_Commit("BIGFIL (016BH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#bigfil-016bh", 849)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: enables VRAM to be read by setting the address")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("NSETRD (016EH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nsetrd-016eh", 850)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: enables VRAM to be written by setting the address")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("NSTWRT (0171H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nstwrt-0171h", 851)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the contents of VRAM")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address to be read")
  Th2HandbookHelp_L("* **Output**: A for the value which was read")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("NRDVRM (0174H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nrdvrm-0174h", 852)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes data in VRAM")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address, A for data")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("NWRVRM (0177H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nwrvrm-0177h", 853)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The calling sequence of SUB-ROM is as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@        LD      IX, INIPLT")
  Th2HandbookHelp_L("@@@                         ; Set BIOS entry address")
  Th2HandbookHelp_L("@@@        CALL    EXTROM")
  Th2HandbookHelp_L("@@@                         ; Returns here")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the contents of IX should not be destroyed, use the call as shown below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@INIPAL: PUSH    IX")
  Th2HandbookHelp_L("@@@                         ; Save IX")
  Th2HandbookHelp_L("@@@        LD      IX, INIPLT")
  Th2HandbookHelp_L("@@@                         ; Set BIOS entry address")
  Th2HandbookHelp_L("@@@        JP      SUBROM")
  Th2HandbookHelp_L("@@@                         ;Returns caller of INIPAL")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("SUB-ROM", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#sub-rom", 854)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: one character output to the graphic screen (active only in screen modes 5 to 8)")
  Th2HandbookHelp_L("* **Input**: A for the character code")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("GRPRT (0089H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#grprt-0089h", 855)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: draws a box")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * start point: BC for X-coordinate, DE for Y-coordinate ")
  Th2HandbookHelp_L("  * end point:")
  Th2HandbookHelp_L("@@@* GXPOS (FCB3H) for X-coordinate")
  Th2HandbookHelp_L("@@@* GYPOS (FCB5H) for Y-coordinate ")
  Th2HandbookHelp_L("  * colour: ATRBYT (F3F3H) for the attribute")
  Th2HandbookHelp_L("  * logical operation code: LOGOPR (FB02H)")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("NVBXLN (00C9H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nvbxln-00c9h", 856)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: draws a painted box")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * start point: BC for X-coordinate, DE for Y-coordinate ")
  Th2HandbookHelp_L("  * end point:")
  Th2HandbookHelp_L("@@@* GXPOS (FCB3H) for X-coordinate")
  Th2HandbookHelp_L("@@@* GYPOS (FCB5H) for Y-coordinate")
  Th2HandbookHelp_L("  * colour: ATRBYT (F3F3H) for the attribute ")
  Th2HandbookHelp_L("  * logical operation code: LOGOPR (FB02H)")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("NVBXFL (00CDH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nvbxfl-00cdh", 857)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: changes the screen mode")
  Th2HandbookHelp_L("* **Input**: A for the screen mode (0 to 8)")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHGMOD (00D1H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chgmod-00d1h", 858)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to TEXT1 mode (40 x 24)")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * TXTNAM (F3B3H) for the pattern name table")
  Th2HandbookHelp_L("  * TXTCGP (F3B7H) for the pattern generator table ")
  Th2HandbookHelp_L("  * LINL40 (F3AEH) for the length of one line")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INITXT (00D5H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#initxt-00d5h", 859)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to GRAPHIC1 mode (32x24)")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * T32NAM (F3BDH) for the pattern name table")
  Th2HandbookHelp_L("  * T32COL (F3BFH) for the colour table")
  Th2HandbookHelp_L("  * T32CGP (F3C1H) for the pattern generator table")
  Th2HandbookHelp_L("  * T32ATR (F3C3H) for the sprite attribute table")
  Th2HandbookHelp_L("  * T32PAT (F3C5H) for the sprite generator table")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INIT32 (00D9H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#init32-00d9h", 860)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to the high-resolution graphics mode")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * GRPNAM (F3C7H) for the pattern name table ")
  Th2HandbookHelp_L("  * GRPCOL (F3C9H) for the colour table ")
  Th2HandbookHelp_L("  * GRPCGP (F3CBH) for the pattern generator table ")
  Th2HandbookHelp_L("  * GRPATR (F3CDH) for the sprite attribute table ")
  Th2HandbookHelp_L("  * GRPPAT (F3CFH) for the sprite generator table")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INIGRP (00DDH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#inigrp-00ddh", 861)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to MULTI colour mode")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * MLTNAM (F3D1H) for the pattern name table ")
  Th2HandbookHelp_L("  * MLTCOL (F3D3H) for the colour table")
  Th2HandbookHelp_L("  * MLTCGP (F3D5H) for the pattern generator table ")
  Th2HandbookHelp_L("  * MLTATR (F3D7H) for the sprite attribute table ")
  Th2HandbookHelp_L("  * MLTPAT (F3D9H) for the sprite generator table")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INIMLT (00E1H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#inimlt-00e1h", 862)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets VDP in the text mode (40x24)")
  Th2HandbookHelp_L("* **Input**: same as [[[INITXT|||Appendix1#initxt-00d5h]]]")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("SETTXT (00E5H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#settxt-00e5h", 863)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: ses VDP in the text mode (32x24)")
  Th2HandbookHelp_L("* **Input**: same as [[[INIT32|||Appendix1#init32-00d9h]]]")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("SETT32 (00E9H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#sett32-00e9h", 864)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets VDP in the high-resolution mode")
  Th2HandbookHelp_L("* **Input**: same as [[[INIGRP|||Appendix1#inigrp-00ddh]]]")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("SETGRP (00EDH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setgrp-00edh", 865)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets VDP in MULTI COLOUR mode")
  Th2HandbookHelp_L("* **Input**: same as [[[INIMLT|||Appendix1#inimlt-00e1h]]]")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("SETMLT (00F1H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setmlt-00f1h", 866)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises all sprites. The sprite pattern is set to null, sprite number to sprite plane number, and sprite colour to the foreground colour. The vertical location of the sprite is set to 217.")
  Th2HandbookHelp_L("* **Input**: SCRMOD (FCAFH) for the screen mode")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CLRSPR (00F5H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#clrspr-00f5h", 867)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the address of the sprite generator table (this routine is the same as [[[CALPAT|||Appendix1#calpat-0084h-1]]] in MAIN-ROM)")
  Th2HandbookHelp_L("* **Input**: A for the sprite number")
  Th2HandbookHelp_L("* **Output**: HL for the address")
  Th2HandbookHelp_L("* **Registers**: AF, DE, HL")
  Th2HandbookHelp_Commit("CALPAT (00F9H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#calpat-00f9h", 868)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the address of the sprite attribute table (this routine is the same as [[[CALATR|||Appendix1#calatr-0087h-1]]] in MAIN-ROM)")
  Th2HandbookHelp_L("* **Input**: A for the sprite number")
  Th2HandbookHelp_L("* **Output**: HL for the address")
  Th2HandbookHelp_L("* **Registers**: AF, DE, HL")
  Th2HandbookHelp_Commit("CALATR (00FDH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#calatr-00fdh", 869)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the current sprite size (this routine is the same as [[[GSPSIZ|||Appendix1#gspsiz-008ah-1]]] in MAIN-ROM)")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: A for the sprite size. The CY flag is set only for the size 16 x 16.")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("GSPSIZ (0101H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#gspsiz-0101h", 870)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the character pattern")
  Th2HandbookHelp_L("* **Input**: A for the character code")
  Th2HandbookHelp_L("* **Output**: PATWRK (FC40H) for the character pattern")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("GETPAT (0105H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#getpat-0105h", 871)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes data in VRAM")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address (0 TO FFFFH), A for data")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("WRTVRM (0109H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtvrm-0109h", 872)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the contents of VRAM")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address (0 TO FFFFH) to be read")
  Th2HandbookHelp_L("* **Output**: A for the value which was read")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("RDVRM (010DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rdvrm-010dh", 873)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: changes the screen colour")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * A for the mode ")
  Th2HandbookHelp_L("  * FORCLR (F3E9H) for the foreground color")
  Th2HandbookHelp_L("  * BAKCLR (F3EAH) for the background color")
  Th2HandbookHelp_L("  * BDRCLR (F3EBH) for the border colour")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHGCLR (0111H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chgclr-0111h", 874)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: clears the screen")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CLSSUB (0115H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#clssub-0115h", 875)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: displays the function keys")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("DSPFNK (011DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#dspfnk-011dh", 876)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes data in the VDP register")
  Th2HandbookHelp_L("* **Input**: C for the register number, B for data")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC")
  Th2HandbookHelp_Commit("WRTVDP (012DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtvdp-012dh", 877)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the VDP register")
  Th2HandbookHelp_L("* **Input**: A for the register number (0 to 9)")
  Th2HandbookHelp_L("* **Output**: A for data")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("VDPSTA (0131H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#vdpsta-0131h", 878)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: switches the page")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * DPPAGE (FAF5H) for the display page number ")
  Th2HandbookHelp_L("  * ACPAGE (FAF6H) for the active page number")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("SETPAG (013DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setpag-013dh", 879)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the palette (the current palette is saved in VRAM)")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC, DE")
  Th2HandbookHelp_Commit("INIPLT (0141H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#iniplt-0141h", 880)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: restores the palette from VRAM")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC, DE")
  Th2HandbookHelp_Commit("RSTPLT (0145H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rstplt-0145h", 881)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: obtains the colour code from the palette")
  Th2HandbookHelp_L("* **Input**: A for the palette number (0 to 15)")
  Th2HandbookHelp_L("* **Output**: ")
  Th2HandbookHelp_L("  * 4 high order bits of B for red code ")
  Th2HandbookHelp_L("  * 4 low order bits of B for blue code")
  Th2HandbookHelp_L("  * 4 low order bits of C for green code")
  Th2HandbookHelp_L("* **Registers**: AF, DE")
  Th2HandbookHelp_Commit("GETPLT (0149H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#getplt-0149h", 882)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets the colour code to the palette")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * D for the palette number (0 to 15)")
  Th2HandbookHelp_L("  * 4 high order bits of A for red code")
  Th2HandbookHelp_L("  * 4 low order bits of A for blue code ")
  Th2HandbookHelp_L("  * 4 low order bits of E for green code")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("SETPLT (014DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setplt-014dh", 883)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: generates BEEP")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BEEP (017DH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#beep-017dh", 884)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: displays the prompt")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("PROMPT (0181H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#prompt-0181h", 885)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the status of mouse or light pen")
  Th2HandbookHelp_L("* **Input**: call with setting the following data in A; descriptions in parenthesis are return values.")
  Th2HandbookHelp_L("  * 8: light pen check (valid at 0FFH)")
  Th2HandbookHelp_L("  * 9: returns X-coordinate ")
  Th2HandbookHelp_L("  * 10: returns Y-coordinate ")
  Th2HandbookHelp_L("  * 11: returns the light pen switch status (0FFH, when pressed)")
  Th2HandbookHelp_L("  * 12: whether the mouse is connected to the port 1 (valid at 0FFH) ")
  Th2HandbookHelp_L("  * 13: returns the offset in X direction")
  Th2HandbookHelp_L("  * 14: returns the offset in Y direction ")
  Th2HandbookHelp_L("  * 15: (always 0)")
  Th2HandbookHelp_L("  * 16: whether the mouse is connected to the port 2 (valid at 0FFH)")
  Th2HandbookHelp_L("  * 17: returns the offset in X direction ")
  Th2HandbookHelp_L("  * 18: returns the offset in Y direction")
  Th2HandbookHelp_L("  * 19: (always 0)")
  Th2HandbookHelp_L("* **Output**: A")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("NEWPAD (01ADH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#newpad-01adh", 886)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: changes VDP mode. The palette is initialised.")
  Th2HandbookHelp_L("* **Input**: A for the screen mode (0 to 8)")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHGMDP (01B5H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chgmdp-01b5h", 887)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sends a kanki to the graphic screen (modes 5 to 8)")
  Th2HandbookHelp_L("* **Input**: BC for JIS kanji code, A for the display mode. The display mode has the following meaning, similar to the PUT KANJI command of BASIC.")
  Th2HandbookHelp_L("  * 0: display in 16 x 16 dot ")
  Th2HandbookHelp_L("  * 1: display even dots ")
  Th2HandbookHelp_L("  * 2: display odd dots")
  Th2HandbookHelp_Commit("KNJPRT (01BDH)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#knjprt-01bdh", 888)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the clock data")
  Th2HandbookHelp_L("* **Input**: C for RAM address of the clock")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  00MMAAAA")
  Th2HandbookHelp_L("@@@    ------")
  Th2HandbookHelp_L("@@@    ||++++--- Address (0 to 15)")
  Th2HandbookHelp_L("@@@    ++------- Mode (0 to 3)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Output**: A for the data which were read (only 4 low order bits are valid)")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("REDCLK (01F5H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#redclk-01f5h", 889)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes the clock data")
  Th2HandbookHelp_L("* **Input**: A for the data to be written, C for RAM address of the clock")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("WRTCLK (01F9H)", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtclk-01f9h", 890)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- In description of [[[ENASLT|||Appendix1#enaslt-0024h-1]]], the needed input in HL has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of [[[GETYPR|||Appendix1#getypr-0028h-1]]], the Input field has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of [[[INITXT|||Appendix1#initxt-006ch-3]]] (MAIN), the reference to " + Chr(34) + "INIPLOT" + Chr(34) + " has been corrected to " + Chr(34) + "[[[INIPLT|||Appendix1#iniplt-0141h]]]" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of [[[SUBROM|||Appendix1#subrom-015ch]]] routine, the mark " + Chr(34) + "*1" + Chr(34) + " has been erased.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of [[[INITXT|||Appendix1#initxt-006ch-3]]] (SUB), the needed input in LINL40 has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- Description of [[[PHYDIO|||Appendix1#phydio-0144h]]] routine has been added.")
  Th2HandbookHelp_Commit("Changes from the original", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#changes-from-the-original", 891)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The Math-Pack is the core for the mathematical routines of MSX-BASIC and, by calling these routines from an assembly language program, floating-point operations and trigonometrical functions are available.")
  Th2HandbookHelp_Commit("APPENDIX 2 - MATH-PACK", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#appendix-2---math-pack", 892)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[Math-Pack work area|||Appendix2#math-pack-work-area]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Basic operation|||Appendix2#basic-operation]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Function 1|||Appendix2#function-1]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Function 2|||Appendix2#function-2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Movement|||Appendix2#movement]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Comparison|||Appendix2#comparison]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Floating-point input/output|||Appendix2#floating-point-inputoutput]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Type conversion|||Appendix2#type-conversion]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Integer operation|||Appendix2#integer-operation]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Power|||Appendix2#power]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Changes from the original|||Appendix2#changes-from-the-original]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Any operations involving real numbers in Math-Pack are done in BCD (Binary Coded Decimal). There are two ways of expressing a real number, " + Chr(34) + "single precision" + Chr(34) + " and " + Chr(34) + "double precision" + Chr(34) + "; a single precision real number (6 digits) is expressed by 4 bytes and a double precision real number (14 digits) by 8 bytes (see [[[Figure A.1|||Appendix2#figure-a1--bcd-format-for-expressing-real-numbers]]] and [[[Figure A.2|||Appendix2#figure-a2--examples-of-expressions-for-real-numbers]]]).")
  Th2HandbookHelp_Commit("Index", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#index", 893)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                     MSB   7     6     5     4     3     2     1     0   LSB")
  Th2HandbookHelp_L("@@@  ---          ---      -------------------------------------------------")
  Th2HandbookHelp_L("@@@   ^            ^       |sign |                exponent                 |  0")
  Th2HandbookHelp_L("@@@   |            |       -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |            |       -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |            |       |  mantissa 1st place   |  mantissa 2nd place   |  1")
  Th2HandbookHelp_L("@@@   |          single    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |         precision  -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |            |       |  mantissa 3rd place   |  mantissa 4th place   |  2")
  Th2HandbookHelp_L("@@@   |            |       -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |            |       -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |            V       |  mantissa 5th place   |  mantissa 6th place   |  3")
  Th2HandbookHelp_L("@@@ double        ---      -------------------------------------------------")
  Th2HandbookHelp_L("@@@precision               -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    |  mantissa 7th place   |  mantissa 8th place   |  4")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    |  mantissa 9th place   |  mantissa 10th place  |  5")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    |  mantissa 11th place  |  mantissa 12th place  |  6")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@   V                    |  mantissa 13th place  |  mantissa 14th place  |  7")
  Th2HandbookHelp_L("@@@  ---                   -------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure A.1  BCD format for expressing real numbers_", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#_figure-a1-bcd-format-for-expressing-real-numbers_", 894)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        Example of the single precision expression")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         123456 --> 0.123456 E+6")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                       1     2     3     4")
  Th2HandbookHelp_L("@@@                    -------------------------")
  Th2HandbookHelp_L("@@@                DAC |  46 |  12 |  34 |  56 |")
  Th2HandbookHelp_L("@@@                    -------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        Example of the double precision expression")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         123456.78901234 --> 0.12345678901234 E+6")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                       1     2     3     4     5     6     7     8")
  Th2HandbookHelp_L("@@@                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@                DAC |  46 |  12 |  34 |  56 |  78 |  90 |  12 |  34 |")
  Th2HandbookHelp_L("@@@                    -------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("A real number consists of a sign, an exponent, and a mantissa. The sign represents the sign of the mantissa; 0 for positive, 1 for negative. The exponent is a binary expression and can be expressed as a power from +63 to -63, with an excess of 64 (see [[[Figure A.3|||Appendix2#figure-a3--exponent-format]]]). [[[Figure A.4|||Appendix2#figure-a4--valid-range-for-double-precision-real-numbers]]] shows the valid range of double precision real numbers.")
  Th2HandbookHelp_Commit("_Figure A.2  Examples of expressions for real numbers_", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#_figure-a2-examples-of-expressions-for-real-numbers_", 895)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@|sign |<--------------- exponent -------------->|       meaning")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|  0  |  0     0     0     0     0     0     0  | ..... 0")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|  1  |  0     0     0     0     0     0     0  | ..... undefined (-0?)")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|  x  |  0     0     0     0     0     0     1  | ..... -63rd power of 10")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|  x  |  1     0     0     0     0     0     0  | ..... 0th power of 10")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|  x  |  1     1     1     1     1     1     1  | ..... +63rd power of 10")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** " + Chr(34) + "x" + Chr(34) + " is 1 or 0, both of which are allowed.")
  Th2HandbookHelp_Commit("_Figure A.3  Exponent format_", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#_figure-a3-exponent-format_", 896)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@       7     6     5     4     3     2     1     0     (byte)")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@DAC |  FF |  99 |  99 |  99 |  99 |  99 |  99 |  99 |  -0.99999999999999 E+63")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    |  81 |  10 |  00 |  00 |  00 |  00 |  00 |  00 |  -0.10000000000000 E-63")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    |  00 |  x  |  x  |  x  |  x  |  x  |  x  |  x  |   0")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    |  01 |  10 |  00 |  00 |  00 |  00 |  00 |  00 |  +0.10000000000000 E-63")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@                            .")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@    |  7F |  99 |  99 |  99 |  99 |  99 |  99 |  99 |  +0.99999999999999 E+63")
  Th2HandbookHelp_L("@@@    -------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In Math-Pack, the memory is predefined for operation. This memory area is called " + Chr(34) + "DAC (Decimal ACumulator (F7F6H)" + Chr(34) + " and the area which reserves the numerical value to be operated is called " + Chr(34) + "ARG (F847H)" + Chr(34) + ". For example, in multiplication, the product of the numbers in DAC and ARG is calculated and the result is returned in the DAC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In the DAC, single precision real numbers, double precision real numbers, and two-byte integers can be stored. In order to distinguish them, " + Chr(34) + "VALTYP (F663H)" + Chr(34) + " is used and its value is 4 for single precision real numbers, 8 for double precision real numbers, and 2 for two-byte integers.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Single and double precision numbers must be stored from the top of the DAC. For two-byte integers, the low and high bytes should be stored in DAC + 2 and DAC + 3.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since Math-Pack is an internal routine of BASIC, when an error occurs (such as division by 0 or overflow), control automatically jumps to the corresponding error routine, then returns to BASIC command level. To prevent this, change H.ERRO (FFB1H).")
  Th2HandbookHelp_Commit("_Figure A.4  Valid range for double precision real numbers_", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#_figure-a4-valid-range-for-double-precision-real-numbers_", 897)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |  Size  |                 Meaning                  |")
  Th2HandbookHelp_L("@@@|-----------+-----------+--------+------------------------------------------|")
  Th2HandbookHelp_L("@@@|  VALTYP   |   F663H   |    1   | format of the number in DAC              |")
  Th2HandbookHelp_L("@@@|  DAC      |   F7F6H   |   16   | floating point accumulator in BCD format |")
  Th2HandbookHelp_L("@@@|  ARG      |   F847H   |   16   | argument of DAC                          |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("Math-Pack work area", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#math-pack-work-area", 898)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |       Function        |")
  Th2HandbookHelp_L("@@@|-----------+-----------+-----------------------|")
  Th2HandbookHelp_L("@@@|  DECSUB   |   268CH   |   DAC <-- DAC - ARG   |")
  Th2HandbookHelp_L("@@@|  DECADD   |   269AH   |   DAC <-- DAC + ARG   |")
  Th2HandbookHelp_L("@@@|  DECNRM   |   26FAH   |   normalises DAC (*1) |")
  Th2HandbookHelp_L("@@@|  DECROU   |   273CH   |   rounds DAC          |")
  Th2HandbookHelp_L("@@@|  DECMUL   |   27E6H   |   DAC <-- DAC * ARG   |")
  Th2HandbookHelp_L("@@@|  DECDIV   |   289FH   |   DAC <-- DAC / ARG   |")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** These operations treat numbers in DAC and ARG as the double precision number. Registers are not preserved.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**\*1** Excessive zeros in mantissa are removed. (0.00123 ⟶ 0.123 E-2)")
  Th2HandbookHelp_Commit("Basic operation", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#basic-operation", 899)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |       Function       |  Register modified  |")
  Th2HandbookHelp_L("@@@|-----------+-----------+----------------------+---------------------|")
  Th2HandbookHelp_L("@@@|   COS     |   2993H   |   DAC <-- COS(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   SIN     |   29ACH   |   DAC <-- SIN(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   TAN     |   29FBH   |   DAC <-- TAN(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   ATN     |   2A14H   |   DAC <-- ATN(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   LOG     |   2A72H   |   DAC <-- LOG(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   SQR     |   2AFFH   |   DAC <-- SQR(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   EXP     |   2B4AH   |   DAC <-- EXP(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   RND     |   2BDFH   |   DAC <-- RND(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** These processing routines all have the same function names as those in BASIC. " + Chr(34) + "All" + Chr(34) + " registers are A, B, C, D, E, H, and L.")
  Th2HandbookHelp_Commit("Function 1", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#function-1", 900)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |       Function       |  Register modified  |")
  Th2HandbookHelp_L("@@@|-----------+-----------+----------------------+---------------------|")
  Th2HandbookHelp_L("@@@|   SIGN    |   2E71H   |   A <-- sign of DAC  |          A          |")
  Th2HandbookHelp_L("@@@|   ABSFN   |   2E82H   |   DAC <-- ABS(DAC)   |         all         |")
  Th2HandbookHelp_L("@@@|   NEG     |   2E8DH   |   DAC <-- NEG(DAC)   |         A,HL        |")
  Th2HandbookHelp_L("@@@|   SGN     |   2E97H   |   DAC <-- SGN(DAC)   |         A,HL        |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** Except for SIGN, these processing routines all have the same function names as those in BASIC. Registers are A, B, C, D, E, H, and L. Note that for SGN, the result is represented as a 2-byte integer.")
  Th2HandbookHelp_Commit("Function 2", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#function-2", 901)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |      Function       |    Object    |  Reg. mod.  |")
  Th2HandbookHelp_L("@@@|-----------+-----------+---------------------+--------------+-------------|")
  Th2HandbookHelp_L("@@@|   MAF     |   2C4DH   |   ARG <-- DAC       | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MAM     |   2C50H   |   ARG <-- (HL)      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOV8DH  |   2C53H   |   (DE) <-- (HL)     | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MFA     |   2C59H   |   DAC <-- ARG       | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MFM     |   2C5CH   |   DAC <-- (HL)      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MMF     |   2C67H   |   (HL) <-- DAC      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOV8HD  |   2C6AH   |   (HL) <-- (DE)     | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   XTF     |   2C6FH   |   (SP) <--> DAC     | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   PHA     |   2CC7H   |   ARG <-- (SP)      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   PHF     |   2CCCH   |   DAC <-- (SP)      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   PPA     |   2CDCH   |   (SP) <-- ARG      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   PPF     |   2CE1H   |   (SP) <-- DAC      | double prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   PUSHF   |   2EB1H   |   DAC <-- (SP)      | single prec. | D,E         |")
  Th2HandbookHelp_L("@@@|   MOVFM   |   2EBEH   |   DAC <-- (HL)      | single prec. | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVFR   |   2EC1H   |   DAC <-- (CBED)    | single prec. | D,E         |")
  Th2HandbookHelp_L("@@@|   MOVRF   |   2ECCH   |   (CBED) <-- DAC    | single prec. | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVRMI  |   2ED6H   |   (CBED) <-- (HL)   | single prec. | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVRM   |   2EDFH   |   (BCDE) <-- (HL)   | single prec. | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVMF   |   2EE8H   |   (HL) <-- DAC      | single prec. | A,B,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVE    |   2EEBH   |   (HL) <-- (DE)     | single prec. | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVAM  |   2EEFH   |   ARG <-- (HL)      | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   MOVVFM  |   2EF2H   |   (DE) <-- (HL)     | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVE   |   2EF3H   |   (HL) <-- (DE)     | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVFA  |   2F05H   |   DAC <-- ARG       | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVFM  |   2F08H   |   DAC <-- (HL)      | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVAF  |   2F0DH   |   ARG <-- DAC       | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@|   VMOVMF  |   2F10H   |   (HL) <-- DAC      | VALTYP       | B,C,D,E,H,L |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** (HL), (DE) means the values in memory pointed to by HL or DE. Four")
  Th2HandbookHelp_L("@@@  register names in the parentheses are the single precision real numbers")
  Th2HandbookHelp_L("@@@  which indicate (sign + exponent), (mantissa 1st and 2nd places),")
  Th2HandbookHelp_L("@@@  (mantissa 3th and 4th places), (mantissa 5th and 6th places) from left")
  Th2HandbookHelp_L("@@@  to right. Where the object is VALTYP, the movement (2, 4, 8 bytes) is")
  Th2HandbookHelp_L("@@@  according to the type indicated in VALTYP (F663H).")
  Th2HandbookHelp_Commit("Movement", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#movement", 902)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |      Object              | Left | Right |Reg. mod.|")
  Th2HandbookHelp_L("@@@|-----------+-----------+--------------------------+------+-------+---------|")
  Th2HandbookHelp_L("@@@|   FCOMP   |   2F21H   | single prec. real number | CBED |  DAC  |    HL   |")
  Th2HandbookHelp_L("@@@|   ICOMP   |   2F4DH   | 2-byte integer           | DE   |  HL   |    HL   |")
  Th2HandbookHelp_L("@@@|   XDCOMP  |   2F5CH   | double prec. real number | ARG  |  DAC  |    all  |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** Results will be in A register. Meanings of A register are:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* A = 1 ⟶ left < right")
  Th2HandbookHelp_L("* A = 0 ⟶ left = right")
  Th2HandbookHelp_L("* A = -1 ⟶ left > right")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In the comparison of single precision real numbers, CBED means that each register has single precision (sign + exponent),v      (mantissa 1st and 2nd places), (mantissa 3th and 4th places), and (mantissa 5th and 6th places).")
  Th2HandbookHelp_Commit("Comparison", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#comparison", 903)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |                     Function                      |")
  Th2HandbookHelp_L("@@@|-----------+-----------+---------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   FIN     |   3299H   |  Stores a string representing the floating-point  |")
  Th2HandbookHelp_L("@@@|           |           |  number in DAC, converting it in real.            |")
  Th2HandbookHelp_L("@@@|---------------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|  Entry condition    HL  <--  Starting address of the string               |")
  Th2HandbookHelp_L("@@@|                     A   <--  First character of the string                |")
  Th2HandbookHelp_L("@@@|  Return condition   DAC <--  Real number                                  |")
  Th2HandbookHelp_L("@@@|                     C   <--  FFH: without a decimal point                 |")
  Th2HandbookHelp_L("@@@|                              0:   with a decimal point                    |")
  Th2HandbookHelp_L("@@@|                     B   <--  Number of places after the decimal point     |")
  Th2HandbookHelp_L("@@@|                     D   <--  Number of digits                             |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |                     Function                      |")
  Th2HandbookHelp_L("@@@|-----------+-----------+---------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   FOUT    |   3425H   |  Converts the real number in DAC to the string    |")
  Th2HandbookHelp_L("@@@|           |           |    (unformatted)                                  |")
  Th2HandbookHelp_L("@@@|   PUFOUT  |   3426H   |  Converts the real number in DAC to the string    |")
  Th2HandbookHelp_L("@@@|           |           |    (formatted)                                    |")
  Th2HandbookHelp_L("@@@|---------------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   Entry condition   A   <-- format                                        |")
  Th2HandbookHelp_L("@@@|     bit 7   0: unformatted     1: formatted                               |")
  Th2HandbookHelp_L("@@@|     bit 6   0: without commas  1: with commas every three digits          |")
  Th2HandbookHelp_L("@@@|     bit 5   0: meaningless     1: leading spaces are padded with " + Chr(34) + "." + Chr(34) + "      |")
  Th2HandbookHelp_L("@@@|     bit 4   0: meaningless     1: " + Chr(34) + "$" + Chr(34) + " is added before the numerical value |")
  Th2HandbookHelp_L("@@@|     bit 3   0: meaningless     1: " + Chr(34) + "+" + Chr(34) + " is added even for positive values   |")
  Th2HandbookHelp_L("@@@|     bit 2   0: meaningless     1: the sign comes after the value          |")
  Th2HandbookHelp_L("@@@|     bit 1   unused                                                        |")
  Th2HandbookHelp_L("@@@|     bit 0:  0: fixed point     1: floating-point                          |")
  Th2HandbookHelp_L("@@@|       B <-- number of digits before and not including the decimal point   |")
  Th2HandbookHelp_L("@@@|       C <-- number of digits after and including the decimal point        |")
  Th2HandbookHelp_L("@@@|   Return condition  HL <-- starting address of the string                 |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |                     Function                      |")
  Th2HandbookHelp_L("@@@|-----------+-----------+---------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   FOUTB   |   371AH   | Converts 2-byte integer in DAC+2, 3 to a          |")
  Th2HandbookHelp_L("@@@|           |           |   binary expression string.                       |")
  Th2HandbookHelp_L("@@@|   FOUTO   |   371EH   | Converts 2-byte integer in DAC+2, 3 to an         |")
  Th2HandbookHelp_L("@@@|           |           |   octal expression string.                        |")
  Th2HandbookHelp_L("@@@|   FOUTH   |   3722H   | Converts 2-byte integer in DAC+2, 3 to a          |")
  Th2HandbookHelp_L("@@@|           |           |   hexadecimal expression string.                  |")
  Th2HandbookHelp_L("@@@|---------------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   Entry condition    DAC + 2  <-- 2-byte integer                          |")
  Th2HandbookHelp_L("@@@|                      VALTYP   <-- 2                                       |")
  Th2HandbookHelp_L("@@@|   Return condition   HL       <-- starting address of the string          |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** no strings are reserved. The starting address of the string in the")
  Th2HandbookHelp_L("@@@  output routine is normally in FBUFFR (from F7C5H). In some cases it")
  Th2HandbookHelp_L("@@@  may differ slightly. For the integer in DAC + 2, VALTYP (F663H) must")
  Th2HandbookHelp_L("@@@  be 2, even in cases other than FOUTB, FOUTO and FOUTH.")
  Th2HandbookHelp_Commit("Floating-point input/output", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#floating-point-inputoutput", 904)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |                     Function                      |")
  Th2HandbookHelp_L("@@@|-----------+-----------+---------------------------------------------------|")
  Th2HandbookHelp_L("@@@|   FRCINT  |   2F8AH   | Converts DAC to a 2-byte integer (DAC + 2, 3)     |")
  Th2HandbookHelp_L("@@@|   FRCSNG  |   2FB2H   | Converts DAC to a single precision real number    |")
  Th2HandbookHelp_L("@@@|   FRCDBL  |   303AH   | Converts DAC to a double precision real number    |")
  Th2HandbookHelp_L("@@@|   FIXER   |   30BEH   | DAC <-- SGN(DAC) * INT(ABS(DAC))                  |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** after execution, VALTYP (F663H) will contain the number (2, 4 or 8) representing DAC type. No registers are reserved.")
  Th2HandbookHelp_Commit("Type conversion", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#type-conversion", 905)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |       Function       |  Registers modified  |")
  Th2HandbookHelp_L("@@@|-----------+-----------+----------------------+----------------------|")
  Th2HandbookHelp_L("@@@|   UMULT   |   314AH   |    DE <-- BC * DE    |    A, B, C, D, E     |")
  Th2HandbookHelp_L("@@@|   ISUB    |   3167H   |    HL <-- DE - HL    |         all          |")
  Th2HandbookHelp_L("@@@|   IADD    |   3172H   |    HL <-- DE + HL    |         all          |")
  Th2HandbookHelp_L("@@@|   IMULT   |   3193H   |    HL <-- DE * HL    |         all          |")
  Th2HandbookHelp_L("@@@|   IDIV    |   31E6H   |    HL <-- DE / HL    |         all          |")
  Th2HandbookHelp_L("@@@|   IMOD    |   323AH   |    HL <-- DE mod HL  |         alle         |")
  Th2HandbookHelp_L("@@@|           |           |    (DE <-- DE/HL)    |                      |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("Integer operation", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#integer-operation", 906)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|   Label   |  Address  |    Function                | Base | Exp. | Result |")
  Th2HandbookHelp_L("@@@|-----------+-----------+----------------------------+------+------+--------|")
  Th2HandbookHelp_L("@@@|   SGNEXP  |   37C8H   | power of single-prec. real | DAC  | ARG  |  DAC   |")
  Th2HandbookHelp_L("@@@|   DBLEXP  |   37D7H   | power of double-prec. real | DAC  | ARG  |  DAC   |")
  Th2HandbookHelp_L("@@@|   INTEXP  |   383FH   | power of 2-byte integer    | DE   | HL   |  DAC   |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** No registers are reserved.")
  Th2HandbookHelp_Commit("Power", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#power", 907)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- In the explanation before [[[Figure A.3|||Appendix2#figure-a3--exponent-format]]], the indication about the excess 64 method has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure A.3|||Appendix2#figure-a3--exponent-format]]], in the third byte, " + Chr(34) + "63rd power of 10" + Chr(34) + " has been corrected to " + Chr(34) + "-63rd power of 10" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In the explanation before [[[Figure A.3|||Appendix2#figure-a3--exponent-format]]], the indication about the excess 64 method has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure A.3|||Appendix2#figure-a3--exponent-format]]], in the third byte, " + Chr(34) + "63rd power of 10" + Chr(34) + " has been corrected to " + Chr(34) + "-63rd power of 10" + Chr(34) + ".")
  Th2HandbookHelp_Commit("Changes from the original", "Appendix 2: MATH-PACK")
  Th2HandbookHelp_AddAnchor("Appendix2#changes-from-the-original", 908)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The bit block transfer corresponds to the COPY command in BASIC and is used to transfer data from RAM, VRAM, and the disk. It is easily executed by the routine in expansion ROM and available from the assembly language program. Since it is in expansion ROM, use SUBROM or EXTROM of BIOS for this routine.")
  Th2HandbookHelp_Commit("APPENDIX 3 - BIT BLOCK TRANSFER", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#appendix-3---bit-block-transfer", 909)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[1. Transferring in VRAM|||Appendix3#1-transferring-in-vram]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2. Transferring data between RAM and VRAM|||Appendix3#2-transferring-data-between-ram-and-vram]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[3. Transferring between the disk and RAM or VRAM|||Appendix3#3-transferring-between-the-disk-and-ram-or-vram]]]")
  Th2HandbookHelp_Commit("Index", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#index", 910)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: transfers data in VRAM area")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* SX (F562H, 2): X-coordinate of the source")
  Th2HandbookHelp_L("@@@* SY (F564H, 2): Y-coordinate of the source")
  Th2HandbookHelp_L("@@@* DX (F566H, 2): X-coordinate of the destination")
  Th2HandbookHelp_L("@@@* DY (F568H, 2): Y-coordinate of the destination")
  Th2HandbookHelp_L("@@@* NX (F56AH, 2): number of dots in the X direction")
  Th2HandbookHelp_L("@@@* NY (F56CH, 2): number of dots in the Y direction")
  Th2HandbookHelp_L("@@@* CDUMMY (F56EH, 1): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* ARG (F56FH, 1): selects the direction and expansion RAM (same as VDP R#45)")
  Th2HandbookHelp_L("@@@* LOGOP (F570H, 1): logical operation code (same as the logical operation code of VDP)")
  Th2HandbookHelp_L("* **Output**: the CY flag is reset")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTVV (0191H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltvv-0191hsub", 911)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To use the routines below, the following memory space should be allocated as graphic area for screen modes.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **screen mode 6:** number of dots in X direction times number of dots in Y direction/4 + 4")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **screen mode 5 or 7:** number of dots in X direction times number of dots in Y direction/2 + 4")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **screen mode 8:** number of dots in X direction times number of dots in Y direction/2 + 4")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Note to raise fractions.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("For disk or RAM, data to indicate the size is added as the array data. The first two bytes of data indicate the number of dots in X direction; the next two bytes indicate the number of dots in the Y direction.")
  Th2HandbookHelp_Commit("2. Transferring data between RAM and VRAM", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#2-transferring-data-between-ram-and-vram", 912)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: transfers the array to VRAM")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* DPTR (F562H, 2): source address of memory")
  Th2HandbookHelp_L("@@@* DUMMY (F564H, 2): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* DX (F566H, 2): X-coordinate of the destination")
  Th2HandbookHelp_L("@@@* DY (F568H, 2): Y-coordinate of the destination")
  Th2HandbookHelp_L("@@@* NX (F56AH, 2): number of dots in the X direction (not required to be set; this is already in the top of data to be transferred)")
  Th2HandbookHelp_L("@@@* NY (F56CH, 2): number of dots in the Y direction (not required to be set; this is already in the top of data to be transferred)")
  Th2HandbookHelp_L("@@@* CDUMMY (F56EH, 1): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* ARG (F56FH, 1): selects the direction and expansion RAM (same as VDP R#45)")
  Th2HandbookHelp_L("@@@* LOGOP (F570H, 1): logical operation code (same as the logical operation code of VDP)")
  Th2HandbookHelp_L("* **Output**: the CY flag is set when the number of data bytes to be transferred is incorrect")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTVM (0195H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltvm-0195hsub", 913)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: transfers to the array from VRAM")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* SX (F562H, 2): X-coordinate of the source")
  Th2HandbookHelp_L("@@@* SY (F564H, 2): Y-coordinate of the source")
  Th2HandbookHelp_L("@@@* DPTR (F566H, 2): destination address of memory")
  Th2HandbookHelp_L("@@@* DUMMY (F568H, 2): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* NX (F56AH, 2): number of dots in the X direction")
  Th2HandbookHelp_L("@@@* NY (F56CH, 2): number of dots in the Y direction")
  Th2HandbookHelp_L("@@@* CDUMMY (F56EH, 1): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* ARG (F56FH, 1): selects the direction and expansion RAM (same as VDP R#45)")
  Th2HandbookHelp_L("* **Output**:   the CY flag is reset")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTMV (0199H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltmv-0199hsub", 914)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The filename should be set first to use the disk (specify the filename as BASIC). The following is an example:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@        LD      HL,FNAME                ; Get pointer to file name")
  Th2HandbookHelp_L("@@@        LD      (FNPTR),HL              ; Set it to parameter area")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@                .")
  Th2HandbookHelp_L("@@@FNAME:  DB 22H," + Chr(34) + "B:TEST.PIC" + Chr(34) + ",22H,0       ; " + Chr(34) + "TEST.PIC" + Chr(34) + ", end mark")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When an error occurs, control jumps to the error handler of the BASIC interpreter. Set the hook to handle the error in the user program or to call this routine from MSX-DOS or a ROM cartridge. This hook is H.ERRO (FFB1H).")
  Th2HandbookHelp_Commit("3. Transferring between the disk and RAM or VRAM", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#3-transferring-between-the-disk-and-ram-or-vram", 915)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: transfers from disk to VRAM")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* FNPTR (F562H, 2): address of the filename")
  Th2HandbookHelp_L("@@@* DUMMY (F564H, 2): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* DX (F566H, 2): X-coordinate of the destination")
  Th2HandbookHelp_L("@@@* DY (F568H, 2): Y-coordinate of the destination")
  Th2HandbookHelp_L("@@@* NX (F56AH, 2): number of dots in the X direction (not required to be set; this is already in the top of data to be transferred)")
  Th2HandbookHelp_L("@@@* NY (F56CH, 2): number of dots in the Y direction (not required to be set; this is already in the top of data to be transferred)")
  Th2HandbookHelp_L("@@@* CDUMMY (F56EH, 1): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* ARG (F56FH, 1): selects the direction and expansion RAM (same as VDP R#45)")
  Th2HandbookHelp_L("@@@* LOGOP (F570H, 1): logical operation code (same as the logical operation code of VDP)")
  Th2HandbookHelp_L("* **Output**:   the CY flag is set when there is an error in the parameter")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTVD (019DH/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltvd-019dhsub", 916)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: transfers from VRAM to disk")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* SX (F562H, 2): X-coordinate of the source")
  Th2HandbookHelp_L("@@@* SY (F564H, 2): Y-coordinate of the source")
  Th2HandbookHelp_L("@@@* FNPTR (F566H, 2): address of the filename")
  Th2HandbookHelp_L("@@@* DUMMY (F568H, 2): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* NX (F56AH, 2): number of dots in the X direction")
  Th2HandbookHelp_L("@@@* NY (F56CH, 2): number of dots in the Y direction")
  Th2HandbookHelp_L("@@@* CDUMMY (F56EH, 1): dummy (not required to be set)")
  Th2HandbookHelp_L("* **Output**: the CY flag is reset")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTDV (01A1H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltdv-01a1hsub", 917)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: loads array data from disk")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* FNPTR (F562H, 2): address of the filename")
  Th2HandbookHelp_L("@@@* SY (F564H, 2): dummy (not required to be set)")
  Th2HandbookHelp_L("@@@* SPTR (F566H, 2): the starting address for loading")
  Th2HandbookHelp_L("@@@* EPTR (F568H, 2): the end address for loading")
  Th2HandbookHelp_L("* **Output**: the CY flag is reset")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTMD (01A5H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltmd-01a5hsub", 918)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: saves array data to disk")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL register ⟵ F562H")
  Th2HandbookHelp_L("  * The following parameters should be set:")
  Th2HandbookHelp_L("@@@* SPTR (F562H, 2): the starting address for saving")
  Th2HandbookHelp_L("@@@* EPTR (F564H, 2): the end address for saving")
  Th2HandbookHelp_L("@@@* FNPTR (F566H, 2): address of the filename")
  Th2HandbookHelp_L("* **Output**: the CY flag is reset")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("BLTDM (01A9H/SUB)", "Appendix 3: Bit block transfer")
  Th2HandbookHelp_AddAnchor("Appendix3#bltdm-01a9hsub", 919)

