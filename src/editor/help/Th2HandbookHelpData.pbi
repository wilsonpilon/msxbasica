  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Bits indicated by an " + Chr(34) + "." + Chr(34) + " are always 0 and cannot be modified.")
  Th2HandbookHelp_Commit("_Figure 5.29  Setting the CLOCK and ALARM_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-529-setting-the-clock-and-alarm_", 688)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Two clocks can be selected; one is a 24-hour clock which represents one o'clock in the afternoon as 13 o'clock, and the other is a 12-hour clock which represents it as 1 p.m. Register #10 is used to select between them. As shown in [[[Figure 5.30|||Chapter5a#figure-530--selecting-12-hour-clock24-hour-clock]]], the 12-hour clock is selected when B0 is " + Chr(34) + "0" + Chr(34) + " and the 24-hour clock when B0 is " + Chr(34) + "1" + Chr(34) + ".")
  Th2HandbookHelp_Commit("Selecting 12-hour clock/24-hour clock", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#selecting-12-hour-clock24-hour-clock", 689)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@|  . |  . |  . | B0 |  Register #10 (block 1)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@                 |")
  Th2HandbookHelp_L("@@@                 +-->  0: 12-hour clock")
  Th2HandbookHelp_L("@@@                       1: 24-hour clock")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.30  Selecting 12-hour clock/24-hour clock_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-530-selecting-12-hour-clock24-hour-clock_", 690)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@|  . |  . | B1 |  X |  register #5 (block 0)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@            |")
  Th2HandbookHelp_L("@@@            +------->  0: before noon")
  Th2HandbookHelp_L("@@@                       1: after noon")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.31  Morning/afternoon flag for 12-hour clock_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-531-morningafternoon-flag-for-12-hour-clock_", 691)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Register #11 of block 1 is a mod 4 counter which is renewed along with the count of the year. When the 2 low order bits of this register are 00H, that is considered as a leap year and 29 days are counted in February.")
  Th2HandbookHelp_Commit("Leap year counter", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#leap-year-counter", 692)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@|  . |  . | B1 | B0 |  Register #11 (block 1)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@            |    |")
  Th2HandbookHelp_L("@@@            +----+-->  Both bits 0 represents leap year.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.32  Leap year determination_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-532-leap-year-determination_", 693)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Blocks 2 and 3 of the CLOCK-IC are used as the battery-powered 4-bit x 13 memory blocks. MSX2 uses this area as shown below.")
  Th2HandbookHelp_Commit("6.7 Contents of the Battery-powered Memory", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#67-contents-of-the-battery-powered-memory", 694)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
