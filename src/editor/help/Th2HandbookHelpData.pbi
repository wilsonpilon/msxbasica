  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When VDP commands are executed, the location of the source and destination points are represented as (X, Y) coordinates as shown in [[[Figure 4.72|||Chapter4b#figure-472--coordinate-system-of-vram]]]. When commands are executed, there is no page division and the entire 128K bytes VRAM is placed in a large coordinate system.")
  Th2HandbookHelp_Commit("6.1 Coordinate System of VDP Commands", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#61-coordinate-system-of-vdp-commands", 491)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    GRAPHIC 4  (SCREEN 5)                       GRAPHIC 5  (SCREEN 6)")
  Th2HandbookHelp_L("@@@------------------------------    00000H    ------------------------------")
  Th2HandbookHelp_L("@@@| (0,0)              (255,0) |      |       | (0,0)              (511,0) |")
  Th2HandbookHelp_L("@@@|           Page 0           |      |       |           Page 0           |")
  Th2HandbookHelp_L("@@@| (0,255)          (255,255) |      |       | (0,255)          (511,255) |")
  Th2HandbookHelp_L("@@@|----------------------------|    08000H    |----------------------------|")
  Th2HandbookHelp_L("@@@| (0,256)          (255,256) |      |       | (0,256)          (511,256) |")
  Th2HandbookHelp_L("@@@|           Page 1           |      |       |           Page 1           |")
  Th2HandbookHelp_L("@@@| (0,511)          (255,511) |      |       | (0,511)          (511,511) |")
  Th2HandbookHelp_L("@@@|----------------------------|    10000H    |----------------------------|")
  Th2HandbookHelp_L("@@@| (0,512)          (255,512) |      |       | (0,512)          (511,512) |")
  Th2HandbookHelp_L("@@@|           Page 2           |      |       |           Page 2           |")
  Th2HandbookHelp_L("@@@| (0,767)          (255,767) |      |       | (0,767)          (511,767) |")
  Th2HandbookHelp_L("@@@|----------------------------|    18000H    |----------------------------|")
  Th2HandbookHelp_L("@@@| (0,768)          (255,768) |      |       | (0,768)          (511,768) |")
  Th2HandbookHelp_L("@@@|           Page 3           |      |       |           Page 3           |")
  Th2HandbookHelp_L("@@@| (0,1023)        (255,1023) |      |       | (0,1023)        (511,1023) |")
  Th2HandbookHelp_L("@@@------------------------------    1FFFFH    ------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    GRAPHIC 7  (SCREEN 8)                       GRAPHIC 6  (SCREEN 7)")
  Th2HandbookHelp_L("@@@------------------------------    00000H    ------------------------------")
  Th2HandbookHelp_L("@@@| (0,0)              (255,0) |      |       | (0,0)              (511,0) |")
  Th2HandbookHelp_L("@@@|           Page 0           |      |       |           Page 0           |")
  Th2HandbookHelp_L("@@@| (0,255)          (255,255) |      |       | (0,255)          (511,255) |")
  Th2HandbookHelp_L("@@@|----------------------------|    10000H    |----------------------------|")
  Th2HandbookHelp_L("@@@| (0,256)          (255,256) |      |       | (0,256)          (511,256) |")
  Th2HandbookHelp_L("@@@|           Page 1           |      |       |           Page 1           |")
  Th2HandbookHelp_L("@@@| (0,511)          (255,511) |      |       | (0,511)          (511,511) |")
  Th2HandbookHelp_L("@@@------------------------------    1FFFFH    ------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.72  Coordinate system of VRAM_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-472-coordinate-system-of-vram_", 492)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are 12 types of VDP commands which can be executed by MSX-VIDEO. These are shown in [[[Table 4.5|||Chapter4b#table-45--list-of-vdp-commands]]].")
  Th2HandbookHelp_Commit("6.2 VDP Commands", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#62-vdp-commands", 493)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Command name | Destination | Source | Units | Mnemonic | R#46 (4 hi ord) |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@|              |    VRAM     |  CPU   | bytes |   HMMC   |  1   1   1   1  |")
  Th2HandbookHelp_L("@@@| High speed   |    VRAM     |  VRAM  | bytes |   YMMM   |  1   1   1   0  |")
  Th2HandbookHelp_L("@@@| move         |    VRAM     |  VRAM  | bytes |   HMMM   |  1   1   0   1  |")
  Th2HandbookHelp_L("@@@|              |    VRAM     |  VDP   | bytes |   HMMV   |  1   1   0   0  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@|              |    VRAM     |  CPU   | dots  |   LMMC   |  1   0   1   1  |")
  Th2HandbookHelp_L("@@@| Logical      |    CPU      |  VRAM  | dots  |   LMCM   |  1   0   1   0  |")
  Th2HandbookHelp_L("@@@| move         |    VRAM     |  VRAM  | dots  |   LMMM   |  1   0   0   1  |")
  Th2HandbookHelp_L("@@@|              |    VRAM     |  VDP   | dots  |   LMMV   |  1   0   0   0  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@| Line         |    VRAM     |  VDP   | dots  |   LINE   |  0   1   1   1  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@| Search       |    VRAM     |  VDP   | dots  |   SRCH   |  0   1   1   0  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@| Pset         |    VRAM     |  VDP   | dots  |   PSET   |  0   1   0   1  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@| Point        |    VDP      |  VRAM  | dots  |   POINT  |  0   1   0   0  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@|              |    ----     |  ----  | ----- |   ----   |  0   0   1   1  |")
  Th2HandbookHelp_L("@@@| Reserved     |    ----     |  ----  | ----- |   ----   |  0   0   1   0  |")
  Th2HandbookHelp_L("@@@|              |    ----     |  ----  | ----- |   ----   |  0   0   0   1  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+--------+-------+----------+-----------------|")
  Th2HandbookHelp_L("@@@| Stop         |    ----     |  ----  | ----- |   ----   |  0   0   0   0  |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* When data is written in R#46 (Command register), MSX-VIDEO begins to execute the command after setting 1 to bit 0 (CE/Command Execute) of the status register S#2. Necessary parameters should be set in register R#32 to R#45 before the command is executed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* When the execution of the command ends, CE becomes 0.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* To stop the execution of the command, execute STOP command.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Actions of the commands are guaranteed only in the bitmap modes (GRAPHIC 4 to GRAPHIC 7).")
  Th2HandbookHelp_Commit("_Table 4.5  List of VDP commands_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_table-45-list-of-vdp-commands_", 494)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When commands are executed, various logical operations can be done between data in VRAM and the specified data. Each operation will be done according to the rules listed in [[[Table 4.6|||Chapter4b#table-46--list-of-logical-operations]]].")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In the table, SC represents the source color and DC represents the destination colour. IMP, AND, OR, EOR and NOT write the result of each operation to the destination. In operations whose names are preceded by " + Chr(34) + "T" + Chr(34) + ", dots which correspond with SC=0 are not the objects of the operations and remains as DC. Using these operations enables only colour portions of two figures to be overlapped, so they are especially effective for animations.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[List 4.7|||Chapter4b#list-47--example-of-the-logical-operation-with-t]]] shows an example of these operations.")
  Th2HandbookHelp_Commit("6.3 Logical Operations", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#63-logical-operations", 495)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Logical name |                                        |L03 L02 L01 L00|")
  Th2HandbookHelp_L("@@@|--------------+----------------------------------------+---------------|")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     IMP      | DC=SC                                  | 0   0   0   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     AND      | DC=SCxDC                               | 0   0   0   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     OR       | DC=SC+DC                               | 0   0   1   0 |")
  Th2HandbookHelp_L("@@@|              |    __       __                         |               |")
  Th2HandbookHelp_L("@@@|     EOR      | DC=SCxDC+SCxDC                         | 0   0   1   1 |")
  Th2HandbookHelp_L("@@@|              |    __                                  |               |")
  Th2HandbookHelp_L("@@@|     NOT      | DC=SC                                  | 0   1   0   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 0   1   0   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 0   1   1   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 0   1   1   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|--------------+----------------------------------------+---------------|")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     TIMP     | if SC=0 then DC=DC else DC=SC          | 1   0   0   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     TAND     | if SC=0 then DC=DC else DC=SCxDC       | 1   0   0   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     TOR      | if SC=0 then DC=DC else DC=SC+DC       | 1   0   1   0 |")
  Th2HandbookHelp_L("@@@|              |                            __       __ |               |")
  Th2HandbookHelp_L("@@@|     TEOR     | if SC=0 then DC=DC else DC=SCxDC+SCxDC | 1   0   1   1 |")
  Th2HandbookHelp_L("@@@|              |                            __          |               |")
  Th2HandbookHelp_L("@@@|     TNOT     | if SC=0 then DC=DC else DC=SC          | 1   1   0   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 1   1   0   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 1   1   1   0 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@|     ----     |                                        | 1   1   1   1 |")
  Th2HandbookHelp_L("@@@|              |                                        |               |")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* SC  = Source colour code")
  Th2HandbookHelp_L("* DC  = Destination colour code")
  Th2HandbookHelp_L("* EOR = Exclusive OR")
  Th2HandbookHelp_Commit("_Table 4.6  List of logical operations_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_table-46-list-of-logical-operations_", 496)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '***********************************************************")
  Th2HandbookHelp_L("@@@1010 '  List 4.7   logical operation with T")
  Th2HandbookHelp_L("@@@1020 '***********************************************************")
  Th2HandbookHelp_L("@@@1030 '")
  Th2HandbookHelp_L("@@@1040 SCREEN8 : COLOR 15,0,0 : CLS")
  Th2HandbookHelp_L("@@@1050 DIM A%(3587)")
  Th2HandbookHelp_L("@@@1060 '")
  Th2HandbookHelp_L("@@@1070 LINE (50,50)-(60,100),48,B : PAINT (51,51),156,48")
  Th2HandbookHelp_L("@@@1080 CIRCLE (55,30),30,255 : PAINT (55,30),240,255")
  Th2HandbookHelp_L("@@@1090 COPY(20,0)-(90,100) TO A%")
  Th2HandbookHelp_L("@@@1100 CLS")
  Th2HandbookHelp_L("@@@1110 '")
  Th2HandbookHelp_L("@@@1120 R=RND(-TIME)")
  Th2HandbookHelp_L("@@@1130 FOR Y=0 TO 100 STEP 3")
  Th2HandbookHelp_L("@@@1140   X=INT(RND(1)*186)")
  Th2HandbookHelp_L("@@@1150   COPY A% TO (X,Y),,TPSET")
  Th2HandbookHelp_L("@@@1160 NEXT")
  Th2HandbookHelp_L("@@@1170 '")
  Th2HandbookHelp_L("@@@1180 GOTO 1180")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.7  Example of the logical operation with T_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-47-example-of-the-logical-operation-with-t_", 497)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("AREA-MOVE commands are for transferring screen data inside areas surrounded by a rectangle. The area to be transferred is specified by one vertex and the length of each side of the rectangle as shown in [[[Figure 4.73|||Chapter4b#figure-473--area-specification]]]. SX and SY represent the basic point of the rectangle to be transferred and NX and NY represent the lengt of each side in dots. The two bits, DIX and DIY, are for the direction of transferring data (the meaning of DIX and DIY depends on the type of command). The point where the area is to be transferred is specified in DX and DY.")
  Th2HandbookHelp_Commit("6.4 Area Specification", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#64-area-specification", 498)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@|     (SX,SY)                                                  |")
  Th2HandbookHelp_L("@@@|       x----------------- -->                                 |")
  Th2HandbookHelp_L("@@@|       |                | DIX                                 |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       ------------------  --+                                |")
  Th2HandbookHelp_L("@@@|       | DIY                 |                                |")
  Th2HandbookHelp_L("@@@|       V                     |                                |")
  Th2HandbookHelp_L("@@@|                             |      (DX,DY)                   |")
  Th2HandbookHelp_L("@@@|                             +->  x-----------------          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  ------------------          |")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.73  Area specification_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-473-area-specification_", 499)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Commands are clasified into three types, high-speed transfer commands, logical transfer commands, and drawing commands. This section describes the commands and their use.")
  Th2HandbookHelp_Commit("6.5 Use of Each Command", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#65-use-of-each-command", 500)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data is transferred into the specified area of VRAM from the CPU (see [[[Figure 4.74|||Chapter4b#figure-474--action-of-hmmc-command]]]). Logical operations cannot be specified. Data is transferred in bytes in high-speed transfer commands such as HMMC. Note that the low order bit of the X-coordinate is not referred to in GRAPHIC 4, or 6 modes. The two low order bits are not referred to in GRAPHIC 5 mode (see [[[Figure 4.75|||Chapter4b#figure-475--dots-not-to-be-referred-to]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Set the parameters as shown in [[[Figure 4.76|||Chapter4b#figure-476--register-settings-of-hmmc-command]]] to the appropriate registers. At this point, write only the first byte of data to be transferred from the CPU in R#44. Writing the command code F0H in R#46 causes the command to be executed, and UMSX-VIDEO receives data from R#44 and writes it to VRAM, then waits for data from the CPU.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The CPU writes data after the second byte in R#44. Note that data should be transferred after MSX-VIDEO can receive data (in the case that TR bit is " + Chr(34) + "1" + Chr(34) + "), referring to TR bit of S#2. When the CE bit of S#2 is " + Chr(34) + "0" + Chr(34) + ", this means that all data has been transferred (see figure 4.77). [[[List 4.8|||Chapter4b#list-48--example-of-hmmc-command-execution]]] shows an example of using HMMC.")
  Th2HandbookHelp_Commit("6.5.1 HMMC (CPU -> VRAM high-speed transfer)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#651-hmmc-cpu---vram-high-speed-transfer", 501)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |   MSX-VIDEO      CPU")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|    (DX,DY)                                      |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       x------------------------ --> DIX         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       |          NX           |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | NY                    |<----------------+----|     |-----|     |")
  Th2HandbookHelp_L("@@@|       |                       |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       -------------------------                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | DIY                                     |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       V                                         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select the destination memory      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be transferred in X direction (0 to 511)*")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  destination origin  X-coordinate (0 to 511)*")
  Th2HandbookHelp_L("@@@DY:  destination origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  1st byte of data to be transferred")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* The one low-order bit for GRAPHIC 4 and 6 modes, ")
  Th2HandbookHelp_L("@@@  or two low-order bits for GRAPHIC 5 mode of the DX and NX registers are ignored.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.74  Action of HMMC command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-474-action-of-hmmc-command_", 502)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@       MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@GRAPHIC 4  |    :    :    :    |    :    :    :    |")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@                    (1)                 (2)")
  Th2HandbookHelp_L("@@@Since 1 VRAM byte represents 2 dots, 1 low order bit of X-coordinate is not referred to.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@       MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@GRAPHIC 5  |    :    |    :    |    :    |    :    |")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@               (1)       (2)       (3)       (4)")
  Th2HandbookHelp_L("@@@Since 1 VRAM byte represents 4 dots, 2 low order bits of X-coordinate are not referred to.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@       MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@GRAPHIC 6  |    :    :    :    |    :    :    :    |")
  Th2HandbookHelp_L("@@@           -----------------------------------------")
  Th2HandbookHelp_L("@@@                    (1)                 (2)")
  Th2HandbookHelp_L("@@@Since 1 VRAM byte represents 2 dots, 1 low order bit of X-coordinate is not referred to.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.75  Dots not to be referred to_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-475-dots-not-to-be-referred-to_", 503)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMC register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | destination origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        ----------------------------------------- DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- NX ⟶ Number of dots in X direction to be transferred")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- NY ⟶ Number of dots in Y direction to be transferred")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        |                   |                   |                       |")
  Th2HandbookHelp_L("@@@        +-------------------+-------------------+                       |")
  Th2HandbookHelp_L("@@@                X=2N               X=2N+1         (N=0, 1, ..., 127)    |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 5)       | data to be transferred")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        |         |         |         |         |                       |")
  Th2HandbookHelp_L("@@@        +---------+---------+---------+---------+                       |")
  Th2HandbookHelp_L("@@@           X=4N     X=4N+1    X=4N+2    X=4N+3    (N=0, 1, ..., 127)    |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@                      1 byte per dot")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |   direction (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> direction (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> select destination memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMC command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 1  | 1  | 1  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.76  Register settings of HMMC command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-476-register-settings-of-hmmc-command_", 504)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        /-------------------\")
  Th2HandbookHelp_L("@@@        |     HMMC start    |")
  Th2HandbookHelp_L("@@@        \-------------------/")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        |   register setup  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        | command execution |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@+---------------->|")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | Read status register #2 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\ Yes (CE bit = 0)")
  Th2HandbookHelp_L("@@@|       |   command end?    |-------------------+")
  Th2HandbookHelp_L("@@@|       \\\\\\\\\\+//////////                   |")
  Th2HandbookHelp_L("@@@|                 | No (CE bit = 1)             |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\                   |")
  Th2HandbookHelp_L("@@@|<------|     transfer?     |                   |")
  Th2HandbookHelp_L("@@@| No    \\\\\\\\\\+//////////                   |")
  Th2HandbookHelp_L("@@@| (TR bit=0)      | Yes (TR bit = 1)            |")
  Th2HandbookHelp_L("@@@|       ---------------------                   |")
  Th2HandbookHelp_L("@@@|       |   transfer data   |                   |")
  Th2HandbookHelp_L("@@@|       ---------------------                   |")
  Th2HandbookHelp_L("@@@|                 |                             |")
  Th2HandbookHelp_L("@@@+-----------------+                             |")
  Th2HandbookHelp_L("@@@                                                |")
  Th2HandbookHelp_L("@@@                  +-----------------------------+")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@                  V")
  Th2HandbookHelp_L("@@@        /--------------------\")
  Th2HandbookHelp_L("@@@        |      HMMC end      |")
  Th2HandbookHelp_L("@@@        \--------------------/")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.77  HMMC command execution flow chart_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-477-hmmc-command-execution-flow-chart_", 505)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.8   HMMC sample")
  Th2HandbookHelp_L("@@@;               to use, set H, L, D, E, IX and go")
  Th2HandbookHelp_L("@@@;               RAM (IX) ⟶ VRAM (H,L)-(D,E)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HMMC:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,17+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 36")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JR      NC,HMMC1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMC1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JR      NC,HMMC2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMC2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      H,(IX+0)")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;first DATA")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@        LD      A,0F0H")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;HMMC command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A                     ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        LD      A,44+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,17+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LOOP:   LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        BIT     0,A                     ;check CE bit")
  Th2HandbookHelp_L("@@@        JR      Z,EXIT")
  Th2HandbookHelp_L("@@@        BIT     7,A                     ;check TR bit")
  Th2HandbookHelp_L("@@@        JR      Z,LOOP")
  Th2HandbookHelp_L("@@@        INC     IX")
  Th2HandbookHelp_L("@@@        LD      A,(IX+0)")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        JR      LOOP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@EXIT:   LD      A,0")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS              ;when exit, you must select S#0")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:                             ;read status register specified by A")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:                               ;wait VDP ready")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JR      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.8  Example of HMMC command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-48-example-of-hmmc-command-execution_", 506)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data from a specified VRAM area is transferred into another area in VRAM. Note that transfers using this command can only be done in the Y direction (see [[[Figure 4.78|||Chapter4b#figure-478--actions-of-ymmm-command]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the data as shown in [[[Figure 4.79|||Chapter4b#figure-479--register-settings-of-ymmm-command]]] in the proper registers, writing command code E0H in R#46 causes the command to be executed. When the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", it indicates that the command is currently being executed. [[[List 4.9|||Chapter4b#list-49--example-of-ymmm-command-execution]]] shows an example of using YMMM.")
  Th2HandbookHelp_Commit("6.5.2 YMMM (high-speed transfer between VRAM in Y direction)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#652-ymmm-high-speed-transfer-between-vram-in-y-direction", 507)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                (DX,DY)                          |")
  Th2HandbookHelp_L("@@@|                        x------------------------|")
  Th2HandbookHelp_L("@@@|                        |                        |")
  Th2HandbookHelp_L("@@@|                        |                        |")
  Th2HandbookHelp_L("@@@|                        |                        |")
  Th2HandbookHelp_L("@@@|                        -------------------------|")
  Th2HandbookHelp_L("@@@|                                    ^            |")
  Th2HandbookHelp_L("@@@|                                    |            |")
  Th2HandbookHelp_L("@@@|                                    |            |")
  Th2HandbookHelp_L("@@@|                (DX,SY)                          |")
  Th2HandbookHelp_L("@@@|                        x------------------------| ⟶ DIX")
  Th2HandbookHelp_L("@@@|                        |                        |")
  Th2HandbookHelp_L("@@@|                        | NY                     |")
  Th2HandbookHelp_L("@@@|                        |                        |")
  Th2HandbookHelp_L("@@@|                        -------------------------|")
  Th2HandbookHelp_L("@@@|                        | DIY                    |")
  Th2HandbookHelp_L("@@@|                        V                        |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select the destination memory      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SY:  source origin Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: set which to be transferred, to te right end or to the left end of the")
  Th2HandbookHelp_L("@@@     screen from the source origin      0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  destination origin  X-coordinate (0 to 511)*")
  Th2HandbookHelp_L("@@@DY:  destination origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* The one low-order bit for GRAPHIC 4 and 6 modes, ")
  Th2HandbookHelp_L("@@@  or two low-order bits for GRAPHIC 5 mode of the DX register are ignored.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.78  Actions of YMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-478-actions-of-ymmm-command_", 508)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> YMMM register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- SY ⟶ source origin")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- DX ⟶ destination and source origin")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- DY ⟶ destination origin")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- NY ⟶ number of dots to be transferred in Y direction")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |   direction (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> direction (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> select destination memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> YMMM command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 1  | 1  | 0  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.79  Register settings of YMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-479-register-settings-of-ymmm-command_", 509)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.9   YMMM sample")
  Th2HandbookHelp_L("@@@;               to use, set L, E, B, C, D(bit 2) and go")
  Th2HandbookHelp_L("@@@;               VRAM (B,L)-(*,E) ⟶ VRAM (B,C)")
  Th2HandbookHelp_L("@@@;               DIX must be set in D(bit 2)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@YMMM:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    BC                      ;save destination")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,34")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,17+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 34")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;SY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make NY and DIY")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,YMMM1")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@YMMM1:  LD      L,A                     ;L := NY , D := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        POP     DE                      ;restore DX,DY")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save DIX,DIY")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),D                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),E                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@        LD      A,11100000B             ;YMMM command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.9  Example of YMMM command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-49-example-of-ymmm-command-execution_", 510)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data of specified VRAM area is transferred into another area in VRAM (see [[[Figure 4.80|||Chapter4b#figure-480--actions-of-hmmm-command]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.81|||Chapter4b#figure-481--register-settings-of-hmmm-command]]], writing D0H in R#46 causes the command to be executed. While the command is being executed, CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ". [[[List 4.10|||Chapter4b#list-410--example-of-hmmm-command-execution]]] shows an example of using HMMM.")
  Th2HandbookHelp_Commit("6.5.3  HMMM (high-speed transfer between VRAM)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#653-hmmm-high-speed-transfer-between-vram", 511)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                    VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@|     (SX,SY)                                                  |")
  Th2HandbookHelp_L("@@@|       ------------------ -->                                 |")
  Th2HandbookHelp_L("@@@|       |       NX       | DIX                                 |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       | NY             |                                     |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       ------------------  --+                                |")
  Th2HandbookHelp_L("@@@|       | DIY                 |                                |")
  Th2HandbookHelp_L("@@@|       V                     |                                |")
  Th2HandbookHelp_L("@@@|                             |      (DX,DY)                   |")
  Th2HandbookHelp_L("@@@|                             +->  ------------------          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  ------------------          |")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXS: select the source memory           0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@MXD: select the destination memory      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SX:  source origin X-coordinate (0 to 511)*")
  Th2HandbookHelp_L("@@@SY:  source origin Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be transferred in X direction (0 to 511)*")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  destination origin  X-coordinate (0 to 511)*")
  Th2HandbookHelp_L("@@@DY:  destination origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* The one low-order bit for GRAPHIC 4 and 6 modes,")
  Th2HandbookHelp_L("@@@ or two low-order bits for GRAPHIC 5 mode of the SX, DX, and NX register are ignored.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.80  Actions of HMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-480-actions-of-hmmm-command_", 512)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMM register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#32    | SX7| SX6| SX5| SX4| SX3| SX2| SX1| SX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SX ---+")
  Th2HandbookHelp_L("@@@R#33    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | SX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | source origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SY ---+")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | destination origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ Number of dots in X direction to be transferred")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ Number of dots in Y direction to be transferred")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| MXS| DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |    |    |   direction (X)")
  Th2HandbookHelp_L("@@@                     |    |    |")
  Th2HandbookHelp_L("@@@                     |    |    +-> direction (Y)")
  Th2HandbookHelp_L("@@@                     |    |")
  Th2HandbookHelp_L("@@@                     |    +------> select source memory")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> select destination memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMM command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 1  | 0  | 1  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.81  Register settings of HMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-481-register-settings-of-hmmm-command_", 513)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.10   HMMM sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, D, E, B, C and go")
  Th2HandbookHelp_L("@@@;                VRAM (H,L)-(D,E) ⟶ VRAM (B,C)")
  Th2HandbookHelp_L("@@@;                DIX must be set in D(bit 2)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HMMM:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    BC                      ;save destination")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,32")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 32")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;SX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;SY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JP      NC,HMMM1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMM1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make NY and DIY")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,HMMM2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMM2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        POP     DE                      ;restore DX,DY")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save DIX,DIY")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),D                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),E                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,11010000B             ;HMMM command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.10  Example of HMMM command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-410-example-of-hmmm-command-execution_", 514)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Each byte of data in the specified VRAM area is painted by the specified colour code (see [[[Figure 4.82|||Chapter4b#figure-482--actions-of-hmmc-command]]])")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.83|||Chapter4b#figure-483--register-settings-of-hmmv-command]]], writing C0H in R#46 causes the command to be executed. While the command is being executed, the CE bit of S#2 is 1. [[[List 4.11|||Chapter4b#list-411--example-of-hmmv-command-execution]]] shows an example of using HMMV.")
  Th2HandbookHelp_Commit("6.5.4 HMMV (painting the rectangle in high speed)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#654-hmmv-painting-the-rectangle-in-high-speed", 515)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |   MSX-VIDEO")
  Th2HandbookHelp_L("@@@|                                                 |    -------")
  Th2HandbookHelp_L("@@@|    (DX,DY)                                      |    |     |")
  Th2HandbookHelp_L("@@@|       x------------------------ --> DIX         |    |     |")
  Th2HandbookHelp_L("@@@|       |          NX           |                 |    |     |")
  Th2HandbookHelp_L("@@@|       | NY                    |<----------------+----|     |")
  Th2HandbookHelp_L("@@@|       |                       |                 |    |     |")
  Th2HandbookHelp_L("@@@|       -------------------------                 |    |     |")
  Th2HandbookHelp_L("@@@|       | DIY                                     |    |     |")
  Th2HandbookHelp_L("@@@|       V                                         |    |     |")
  Th2HandbookHelp_L("@@@|                                                 |    -------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select memory                      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be painted in X direction (0 to 511)*")
  Th2HandbookHelp_L("@@@NY:  number of dots to be painted in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  origin  X-coordinate (0 to 511)*")
  Th2HandbookHelp_L("@@@DY:  origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  Painted data")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* The one low-order bit for GRAPHIC 4 and 6 modes,")
  Th2HandbookHelp_L("@@@  or two low-order bits for GRAPHIC 5 mode of the DX and NX registers are ignored.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.82  Actions of HMMC command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-482-actions-of-hmmc-command_", 516)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMV register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ number of dots in X direction to be painted")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ number of dots inY direction to be painted")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        |                   |                   |                       |")
  Th2HandbookHelp_L("@@@        +-------------------+-------------------+                       |")
  Th2HandbookHelp_L("@@@                X=2N               X=2N+1         (N=0, 1, ..., 127)    |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 5)       | data to be painted")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        |         |         |         |         |                       |")
  Th2HandbookHelp_L("@@@        +---------+---------+---------+---------+                       |")
  Th2HandbookHelp_L("@@@           X=4N     X=4N+1    X=4N+2    X=4N+3    (N=0, 1, ..., 127)    |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@                      1 byte / dot                                       ")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |   painting direction (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> painting direction (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> memory selection")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> HMMV command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 1  | 0  | 0  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.83  Register settings of HMMV command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-483-register-settings-of-hmmv-command_", 517)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.11   HMMV sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, D, E, B and go")
  Th2HandbookHelp_L("@@@;                B ⟶ VRAM (H,L)-(D,E) fill")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HMMV:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 36")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JP      NC,HMMV1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMV1:  LD      H,A                     ;H := NX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make NY and DIY")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,HMMV2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@HMMV2:  OUT     (C),H")
  Th2HandbookHelp_L("@@@        LD      H,A                     ;H := NY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),B                   ;fill data")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OR      D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,11000000B             ;HMMV command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.11  Example of HMMV command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-411-example-of-hmmv-command-execution_", 518)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data is transferred from the CPU to thespecified VRAM area in dots (see [[[Figure 4.84|||Chapter4b#figure-484--action-of-lmmc-command]]]). Logical operations with the source can be specified. In the logical transfer commands, such as LMMC, data is transfered in dots and one byte is required for the information of one pixel in all screen modes.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the data as shown in [[[Figure 4.85|||Chapter4b#figure-485--register-settings-of-lmmc-command]]], write command code B0H in R#46. At this point, logical operations can be specified by using the 4 low order bits of the command register. Data is transferred with reference to the TR and CE bit of S#2, as in HMMC (see [[[Figure 4.86|||Chapter4b#figure-486--lmmc-command-execution-flow-chart]]]). [[[List 4.12|||Chapter4b#list-412--example-of-lmmc-command-execution]]] shows an example of using LMMC.")
  Th2HandbookHelp_Commit("6.5.5 LMMC (CPU -> VRAM logical transfer)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#655-lmmc-cpu---vram-logical-transfer", 519)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |   MSX-VIDEO      CPU")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|    (DX,DY)                                      |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       x------------------------ --> DIX         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       |          NX           |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | NY                    |<----------------+----|     |-----|     |")
  Th2HandbookHelp_L("@@@|       |                       |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       -------------------------                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | DIY                                     |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       V                                         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select destination memory          0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be transferred in X direction (0 to 511)")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  destination origin  X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@DY:  destination origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  1st byte of data to be transferred")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.84  Action of LMMC command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-484-action-of-lmmc-command_", 520)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMC register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | destination origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ Number of dots in X direction to be transferred")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ Number of dots in Y direction to be transferred")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                  --+")
  Th2HandbookHelp_L("@@@R#44    | -- | -- | -- | -- | CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    |")
  Th2HandbookHelp_L("@@@                                                                     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    |")
  Th2HandbookHelp_L("@@@        | -- | -- | -- | -- | -- | -- | CR1| CR0| CLR (GRAPHIC 5)    | data to be transferred")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    |")
  Th2HandbookHelp_L("@@@                                                                     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)    |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                  --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |   direction (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> direction (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> select destination memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMC command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 0  | 1  | 1  | L03| L02| L01| L00| CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                            |                   |")
  Th2HandbookHelp_L("@@@                            +-------------------+")
  Th2HandbookHelp_L("@@@                              Logical operation")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.85  Register settings of LMMC command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-485-register-settings-of-lmmc-command_", 521)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        /-------------------\")
  Th2HandbookHelp_L("@@@        |     LMMC start    |")
  Th2HandbookHelp_L("@@@        \-------------------/")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        |   register setup  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        | command execution |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@+---------------->|")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | read status register #2 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\ Yes (CE bit = 0)")
  Th2HandbookHelp_L("@@@|       |   command end?    |-------------------+")
  Th2HandbookHelp_L("@@@|       \\\\\\\\\\+//////////                   |")
  Th2HandbookHelp_L("@@@|                 | No (CE bit = 1)             |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\                   |")
  Th2HandbookHelp_L("@@@|<------|     transfer?     |                   |")
  Th2HandbookHelp_L("@@@| No    \\\\\\\\\\+//////////                   |")
  Th2HandbookHelp_L("@@@| (TR bit=0)      | Yes (TR bit = 1)            |")
  Th2HandbookHelp_L("@@@|       ---------------------                   |")
  Th2HandbookHelp_L("@@@|       |   transfer data   |                   |")
  Th2HandbookHelp_L("@@@|       ---------------------                   |")
  Th2HandbookHelp_L("@@@|                 |                             |")
  Th2HandbookHelp_L("@@@+-----------------+                             |")
  Th2HandbookHelp_L("@@@                                                |")
  Th2HandbookHelp_L("@@@                  +-----------------------------+")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@                  V")
  Th2HandbookHelp_L("@@@        /--------------------\")
  Th2HandbookHelp_L("@@@        |      LMMC end      |")
  Th2HandbookHelp_L("@@@        \--------------------/")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.86  LMMC command execution flow chart_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-486-lmmc-command-execution-flow-chart_", 522)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.12    LMMC sample")
  Th2HandbookHelp_L("@@@;                 to use, set H, L, D, E, IX, A and go")
  Th2HandbookHelp_L("@@@;                 RAM (IX) ⟶ VRAM (H,L)-(D,E) (logi-OP : A)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LMMC:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        LD      B,A                     ;B := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 36")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JR      NC,LMMC1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMC1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JR      NC,LMMC2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMC2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,(IX+0)")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;first DATA")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,B                     ;A := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        OR      10110000B               ;LMMC command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        DEC     C")
  Th2HandbookHelp_L("@@@        DEC     C")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LOOP:   LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        BIT     0,A                     ;check CE bit")
  Th2HandbookHelp_L("@@@        JP      Z,EXIT")
  Th2HandbookHelp_L("@@@        BIT     7,A                     ;check TR bit")
  Th2HandbookHelp_L("@@@        JP      Z,LOOP")
  Th2HandbookHelp_L("@@@        INC     IX")
  Th2HandbookHelp_L("@@@        LD      A,(IX+0)")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        JR      LOOP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@EXIT:   LD      A,0")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JR      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.12  Example of LMMC command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-412-example-of-lmmc-command-execution_", 523)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data is transferred from the specified VRAM area to CPU in dots (see [[[Figure 4.87|||Chapter4b#figure-487--action-of-lmcm-command]]])")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.88|||Chapter4b#figure-488--register-settings-of-lmcm-command]]], writing command code A0H in R#46 causes the command to be executed and data to be transferred from MSX-VIDEO. The CPU refers to the TR bit of S#2 and, since data of MSX-VIDEO has been prepared if this bit is " + Chr(34) + "1" + Chr(34) + ", the CPU reads data from S#7. When CE bit of S#2 is " + Chr(34) + "0" + Chr(34) + ", data comes to the end (see [[[Figure 4.89|||Chapter4b#figure-489--lmcm-command-execution-flow-chart]]]). [[[List 4.13|||Chapter4b#list-413--example-of-lmcm-command-execution]]] shows an example of using LMCM.")
  Th2HandbookHelp_Commit("6.5.6 LMCM (VRAM - CPU logical transfer)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#656-lmcm-vram---cpu-logical-transfer", 524)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |   MSX-VIDEO      CPU")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|    (SX,SY)                                      |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       x------------------------ --> DIX         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       |          NX           |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | NY                    |-----------------+--->|     |---->|     |")
  Th2HandbookHelp_L("@@@|       |                       |                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       -------------------------                 |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       | DIY                                     |    |     |     |     |")
  Th2HandbookHelp_L("@@@|       V                                         |    |     |     |     |")
  Th2HandbookHelp_L("@@@|                                                 |    -------     -------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXS: select source memory               0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SX:  source origin  X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@SY:  source origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be transferred in X direction (0 to 511)")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.87  Action of LMCM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-487-action-of-lmcm-command_", 525)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMCM register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#32    | SX7| SX6| SX5| SX4| SX3| SX2| SX1| SX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SX ---+")
  Th2HandbookHelp_L("@@@R#33    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | SX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | source origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SY ---+")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ Number of dots in X direction to be transferred")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ Number of dots in Y direction to be transferred")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | -- | MXS| DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                          |    |   direction (X)")
  Th2HandbookHelp_L("@@@                          |    |")
  Th2HandbookHelp_L("@@@                          |    +-> direction (Y)")
  Th2HandbookHelp_L("@@@                          |")
  Th2HandbookHelp_L("@@@                          +------> select source memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMCM command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 0  | 1  | 0  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#7     | 0  | 0  | 0  | 0  | C3 | C2 | C1 | C0 | status register(GRAPHIC4,6)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#7     | 0  | 0  | 0  | 0  | 0  | 0  | C1 | C0 | status register (GRAPHIC 5)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#7     | C7 | C6 | C5 | C4 | C3 | C2 | C1 | C0 | status register (GRAPHIC 7)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.88  Register settings of LMCM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-488-register-settings-of-lmcm-command_", 526)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        /-------------------\")
  Th2HandbookHelp_L("@@@        |     LMCM start    |")
  Th2HandbookHelp_L("@@@        \-------------------/")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        |   register setup  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        | command execution |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@+---------------->|")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | read status register #2 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\ No (TR bit = 0)")
  Th2HandbookHelp_L("@@@|       |  data prepared?   |-------------------+")
  Th2HandbookHelp_L("@@@|       \\\\\\\\\\+//////////                   |")
  Th2HandbookHelp_L("@@@|                 | Yes (TR bit = 1)            |")
  Th2HandbookHelp_L("@@@|                 |                             |")
  Th2HandbookHelp_L("@@@|    ---------------------------                |")
  Th2HandbookHelp_L("@@@|    | read status register #7 |                |")
  Th2HandbookHelp_L("@@@|    ---------------------------                |")
  Th2HandbookHelp_L("@@@|                 |                             |")
  Th2HandbookHelp_L("@@@|                 |<----------------------------+")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\")
  Th2HandbookHelp_L("@@@+-------|   command end?    |")
  Th2HandbookHelp_L("@@@  No    \\\\\\\\\\+//////////")
  Th2HandbookHelp_L("@@@  (CE bit=1)      | Yes (CE bit = 0)")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@                  V")
  Th2HandbookHelp_L("@@@        /--------------------\")
  Th2HandbookHelp_L("@@@        |      LMCM end      |")
  Th2HandbookHelp_L("@@@        \--------------------/")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 1:** Read status register #7 in " + Chr(34) + "register setup" + Chr(34) + ", since TR bit should be reset before the command execution.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 2:** Though last data was set in register #7 and TR bit was 1, the command would end inside of the MSX-VIDEO and CE would be zero.")
  Th2HandbookHelp_Commit("_Figure 4.89  LMCM command execution flow chart_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-489-lmcm-command-execution-flow-chart_", 527)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.13   LMCM sample")
  Th2HandbookHelp_L("@@@;                 to use, set H, L, D, E, IX, A and go")
  Th2HandbookHelp_L("@@@;                 VRAM (H,L)-(D,E) ⟶ RAM (IX)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LMCM:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        LD      B,A                     ;B := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,32")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 32")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;SX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;SY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JR      NC,LMCM1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMCM1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JR      NC,LMCM2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMCM2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,(IX+0)")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@        LD      A,7")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        LD      A,B                     ;A := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        OR      10100000B               ;LMCM command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,(RDVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A                     ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@LOOP:   LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        BIT     0,A                     ;check CE bit")
  Th2HandbookHelp_L("@@@        JP      Z,EXIT")
  Th2HandbookHelp_L("@@@        BIT     7,A                     ;check TR bit")
  Th2HandbookHelp_L("@@@        JP      Z,LOOP")
  Th2HandbookHelp_L("@@@        LD      A,7")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        LD      (IX+0),A")
  Th2HandbookHelp_L("@@@        INC     IX")
  Th2HandbookHelp_L("@@@        JR      LOOP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@EXIT:   LD      A,0")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JR      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.13  Example of LMCM command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-413-example-of-lmcm-command-execution_", 528)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Data of the specified VRAM area is transferred into another VRAM area in dots (see figure 4.9)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.91|||Chapter4b#figure-491--register-settings-of-lmmm-command]]], writing command code 9XH (X means a logical operation) in R#46 causes the command to be executed. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed. [[[List 4.14|||Chapter4b#list-414--example-of-lmmm-command-execution]]] shows an example of using LMMM.")
  Th2HandbookHelp_Commit("6.5.7. LMMM (VRAM->VRAM logical transfer)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#657-lmmm-vram-vram-logical-transfer", 529)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                    VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@|     (SX,SY)                                                  |")
  Th2HandbookHelp_L("@@@|       ------------------ -->                                 |")
  Th2HandbookHelp_L("@@@|       |       NX       | DIX                                 |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       | NY             |                                     |")
  Th2HandbookHelp_L("@@@|       |                |                                     |")
  Th2HandbookHelp_L("@@@|       ------------------  --+                                |")
  Th2HandbookHelp_L("@@@|       | DIY                 |                                |")
  Th2HandbookHelp_L("@@@|       V                     |                                |")
  Th2HandbookHelp_L("@@@|                             |      (DX,DY)                   |")
  Th2HandbookHelp_L("@@@|                             +->  ------------------          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  |                |          |")
  Th2HandbookHelp_L("@@@|                                  ------------------          |")
  Th2HandbookHelp_L("@@@|                                                              |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXS: select the source memory           0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@MXD: select the destination memory      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SX:  source origin X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@SY:  source origin Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be transferred in X direction (0 to 511)")
  Th2HandbookHelp_L("@@@NY:  number of dots to be transferred in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  destination origin  X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@DY:  destination origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.90  Actions of LMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-490-actions-of-lmmm-command_", 530)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMM register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#32    | SX7| SX6| SX5| SX4| SX3| SX2| SX1| SX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SX ---+")
  Th2HandbookHelp_L("@@@R#33    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | SX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | source origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SY ---+")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | destination origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|         Number of dots in")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ X direction to be")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|         transferred")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|         Number of dots in")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ Y direction to be")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|         transferred")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| MXS| DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |    |    |   direction (X)")
  Th2HandbookHelp_L("@@@                     |    |    |")
  Th2HandbookHelp_L("@@@                     |    |    +-> direction (Y)")
  Th2HandbookHelp_L("@@@                     |    |")
  Th2HandbookHelp_L("@@@                     |    +------> select source memory")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> select destination memory")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMM command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 0  | 0  | 1  | L03| L02| L01| L00| CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                            |                   |")
  Th2HandbookHelp_L("@@@                            +-------------------+")
  Th2HandbookHelp_L("@@@                              Logical operation")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.91  Register settings of LMMM command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-491-register-settings-of-lmmm-command_", 531)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.14   LMMM sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, D, E, B, C, A and go")
  Th2HandbookHelp_L("@@@;                VRAM (H,L)-(D,E) ⟶ VRAM (B,C) (logi-OP : A)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LMMM:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        PUSH    BC                      ;save DESTINATION")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,32")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 32")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;SX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;SY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JP      NC,LMMM1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMM1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make NY and DIY")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,LMMM2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMM2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        POP     DE                      ;restore DX,DY")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save DIX,DIY")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),D                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),E                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;dummy")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        POP     AF                      ;A := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        OR      10010000B               ;LMMM command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.14  Example of LMMM command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-414-example-of-lmmm-command-execution_", 532)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The specified VRAM area is painted by the colour code in dots (see [[[Figure 4.92|||Chapter4b#figure-492--actions-of-lmmv-command]]]). Logical operations between data in VRAM and the specified data are allowed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.93|||Chapter4b#figure-493--register-settings-of-lmmv-command]]], writing command code 8Xh (X means a logical operation) in R#46 causes the command to be executed. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed. [[[List 4.15|||Chapter4b#list-415--example-of-lmmv-command-execution]]] shows an example of using LMMV.")
  Th2HandbookHelp_Commit("6.5.8 LMMV (VRAM logical paint)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#658-lmmv-vram-logical-paint", 533)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |   MSX-VIDEO")
  Th2HandbookHelp_L("@@@|                                                 |    -------")
  Th2HandbookHelp_L("@@@|    (DX,DY)                                      |    |     |")
  Th2HandbookHelp_L("@@@|       x------------------------ --> DIX         |    |     |")
  Th2HandbookHelp_L("@@@|       |          NX           |                 |    |     |")
  Th2HandbookHelp_L("@@@|       | NY                    |<----------------+----|     |")
  Th2HandbookHelp_L("@@@|       |                       |                 |    |     |")
  Th2HandbookHelp_L("@@@|       -------------------------                 |    |     |")
  Th2HandbookHelp_L("@@@|       | DIY                                     |    |     |")
  Th2HandbookHelp_L("@@@|       V                                         |    |     |")
  Th2HandbookHelp_L("@@@|                                                 |    -------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select memory                      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@NX:  number of dots to be painted in X direction (0 to 511)")
  Th2HandbookHelp_L("@@@NY:  number of dots to be painted in Y direction (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of NX from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of NY from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  origin  X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@DY:  origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  Painted data")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.92  Actions of LMMV command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-492-actions-of-lmmv-command_", 534)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMV register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NX ⟶ number of dots in X direction to be painted")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| NY ⟶ number of dots in Y direction to be painted")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | 0  | 0  | 0  | 0  | CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | 0  | 0  | 0  | 0  | 0  | 0  | CR1| CR0| CLR (GRAPHIC 5)       | data to be transferred")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |   painting direction (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> painting direction (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> memory selection")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LMMV command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 1  | 0  | 0  | 0  | L03| L03| L01| L00| CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                            |                   |")
  Th2HandbookHelp_L("@@@                            +-------------------+")
  Th2HandbookHelp_L("@@@                              Logical operation")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.93  Register settings of LMMV command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-493-register-settings-of-lmmv-command_", 535)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.15   LMMV sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, D, E, B, A and go")
  Th2HandbookHelp_L("@@@;                data B ⟶ fill VRAM (H,L)-(D,E) (logi-op : A)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LMMV:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        PUSH    BC                      ;save FILL DATA")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 36")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make NX and DIX")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JP      NC,LMMV1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMV1:  LD      H,A                     ;H := NX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make NY and DIY")
  Th2HandbookHelp_L("@@@        SUB     A")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,LMMV2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LMMV2:  LD      L,A                     ;L := NY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;FILL DATA")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;DIX and DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        POP     AF                      ;restore LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        OR      A,10000000B             ;LMMV command")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.15  Example of LMMV command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-415-example-of-lmmv-command-execution_", 536)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Lines can be drawn between any coordinates in VRAM. The parameters to be specified include the (X,Y) coordinates of the starting point and the X and Y lengths in units to the ending point (see [[[Figure 4.94|||Chapter4b#figure-494--actions-of-line-command]]]). Logical operations between data in VRAM and the specified data are allowed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.94|||Chapter4b#figure-494--actions-of-line-command]]], writing command code 7XH (X means a logical operation) in R#46 causes the command to be executed. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed. [[[List 4.16|||Chapter4b#list-416--example-of-line-command-execution]]] shows an example of using LINE.")
  Th2HandbookHelp_Commit("6.5.9 LINE (drawing a line)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#659-line-drawing-a-line", 537)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                           / :  ^                |")
  Th2HandbookHelp_L("@@@|                         /   :  |                |")
  Th2HandbookHelp_L("@@@|                       /     : DIY               |")
  Th2HandbookHelp_L("@@@|                     /       :                   |")
  Th2HandbookHelp_L("@@@|                   /     Min :                   |")
  Th2HandbookHelp_L("@@@|                 /           :                   |")
  Th2HandbookHelp_L("@@@|               /             :                   |")
  Th2HandbookHelp_L("@@@|             /     Maj       :                   |")
  Th2HandbookHelp_L("@@@|            x................. -> DIX            |")
  Th2HandbookHelp_L("@@@|         (DX,DY)                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: select memory                      0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Maj: number of dots of major side (0 to 1023)")
  Th2HandbookHelp_L("@@@Maj: number of dots of minor side (0 to 512)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MAJ: 0 = The major side is parallel to X axis")
  Th2HandbookHelp_L("@@@MAJ: 1 = The major side is parallel to Y axis,")
  Th2HandbookHelp_L("@@@         or the major side = the minor side")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction of the end from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@DIY: direction of the end from the origin    0 = below, 1 = above")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DX:  origin  X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@DY:  origin  Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  Line colour data")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.94  Actions of LINE command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-494-actions-of-line-command_", 538)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LINE register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#40    | NX7| NX6| NX5| NX4| NX3| NX2| NX1| NX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| Maj (NX) -> number of dots of the major side")
  Th2HandbookHelp_L("@@@R#41    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | NX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#42    | NY7| NY6| NY5| NY4| NY3| NY2| NY1| NY0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| Min (NY) -> number of dots of the minor side")
  Th2HandbookHelp_L("@@@R#43    | 0  | 0  | 0  | 0  | 0  | 0  | NY9| NY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | 0  | 0  | 0  | 0  | CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | 0  | 0  | 0  | 0  | 0  | 0  | CR1| CR0| CLR (GRAPHIC 5)       | colour code data")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    |  0 | -- | MXD| -- | DIY| DIX| -- | MAJ| ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |         |    |        major side selection")
  Th2HandbookHelp_L("@@@                     |         |    V")
  Th2HandbookHelp_L("@@@                     |         |   direction to the end (X)")
  Th2HandbookHelp_L("@@@                     |         |")
  Th2HandbookHelp_L("@@@                     |         +-> direction to the end (Y)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> memory selection")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> LINE command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 0  | 1  | 1  | 1  | L03| L03| L01| L00| CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                            |                   |")
  Th2HandbookHelp_L("@@@                            +-------------------+")
  Th2HandbookHelp_L("@@@                              Logical operation")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.95  Register settings of LINE command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-495-register-settings-of-line-command_", 539)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.16   LINE sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, D, E, B, A and go")
  Th2HandbookHelp_L("@@@;                draw LINE (H,L)-(D,E) with color B, log-op A")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LINE:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        PUSH    BC                      ;save COLOR")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP                ;wait end of command")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#17 := 36")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#3's address")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;DX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;DY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,H                     ;make DX and DIX")
  Th2HandbookHelp_L("@@@        SUB     D")
  Th2HandbookHelp_L("@@@        LD      D,00000100B")
  Th2HandbookHelp_L("@@@        JP      NC,LINE1")
  Th2HandbookHelp_L("@@@        LD      D,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LINE1:  LD      H,A                     ;H := DX , D := DIX")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,L                     ;make DY and DIY")
  Th2HandbookHelp_L("@@@        SUB     E")
  Th2HandbookHelp_L("@@@        LD      E,00001000B")
  Th2HandbookHelp_L("@@@        JP      NC,LINE2")
  Th2HandbookHelp_L("@@@        LD      E,00000000B")
  Th2HandbookHelp_L("@@@        NEG")
  Th2HandbookHelp_L("@@@LINE2:  LD      L,A                     ;L := DY , E := DIY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CP      H                       ;make Maj and Min")
  Th2HandbookHelp_L("@@@        JP      C,LINE3")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;long side")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;short side")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,00000001B             ;MAJ := 1")
  Th2HandbookHelp_L("@@@        JP      LINE4")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LINE3:  XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H                   ;NX")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L                   ;NY")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,00000000B             ;MAJ := 0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LINE4:  OR      D")
  Th2HandbookHelp_L("@@@        OR      E                       ;A := DIX , DIY , MAJ")
  Th2HandbookHelp_L("@@@        POP     HL                      ;H := COLOR")
  Th2HandbookHelp_L("@@@        OUT     (C),H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        POP     AF                      ;A := LOGICAL OPERATION")
  Th2HandbookHelp_L("@@@        OR      01110000B")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.16  Example of LINE command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-416-example-of-line-command-execution_", 540)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("SRCH searches for the existence of the specified colour from any coordinate on VRAM to the right or the left (see figure 4.96). This is very useful for paint routines.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.97|||Chapter4b#figure-497--register-settings-of-srch-command]]], writing 60H in R#46 causes the command to be executed. The command terminates when the objective colour is found or when it cannot be found after searching for it to the screen edge. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed (see [[[Figure 4.98|||Chapter4b#figure-498--srch-command-execution-flowchart]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After the command ends, the objective colour code is stored in S#8 and S#9. [[[List 4.17|||Chapter4b#list-417--example-of-srch-command-execution]]] shows an example of using SRCH.")
  Th2HandbookHelp_Commit("6.5.10 SRCH (colour code search)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#6510-srch-colour-code-search", 541)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|           (SX,SY)      DIX                      |")
  Th2HandbookHelp_L("@@@|              x......................>x          |")
  Th2HandbookHelp_L("@@@|                                   Border        |")
  Th2HandbookHelp_L("@@@|                                   colour        |")
  Th2HandbookHelp_L("@@@|                                   point         |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: memory selection for the seacrh    0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SX: search origin X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@SY: search origin Y-coordinate (0 to 1023)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DIX: direction for the search from the origin    0 = right, 1 = left")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@EQ:  0 = ends the execution when the border colour is found")
  Th2HandbookHelp_L("@@@     1 = ends the execution when the colour is found other than the")
  Th2HandbookHelp_L("@@@         border colour")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CLR (R#44:Colour register):  border colour")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.96  Actions of SRCH command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-496-actions-of-srch-command_", 542)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> SRCH register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#32    | SX7| SX6| SX5| SX4| SX3| SX2| SX1| SX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SX ---+")
  Th2HandbookHelp_L("@@@R#33    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | SX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | search origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SY ---+")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | 0  | 0  | 0  | 0  | CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | 0  | 0  | 0  | 0  | 0  | 0  | CR1| CR0| CLR (GRAPHIC 5)       | border colour")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    | -- | -- | MXD| -- | -- | DIX| EQ | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |              |   the condition for terminating")
  Th2HandbookHelp_L("@@@                     |              |   the execution")
  Th2HandbookHelp_L("@@@                     |              V")
  Th2HandbookHelp_L("@@@                     |             search direction (X)")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> memory selection for the search")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> SRCH command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 0  | 1  | 1  | 0  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#2     | -- | -- | -- | BO | -- | -- | -- | CE | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                         |                   when the command ends : 0")
  Th2HandbookHelp_L("@@@                         |")
  Th2HandbookHelp_L("@@@                         +-------> when the border colour is found : 1")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#8     | BX7| BX6| BX5| BX4| BX3| BX2| BX1| BX0|")
  Th2HandbookHelp_L("@@@        ----------------------------------------- X-coordinate when the border colour is found")
  Th2HandbookHelp_L("@@@S#9     | 1  | 1  | 1  | 1  | 1  | 1  | 1  | BX8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.97  Register settings of SRCH command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-497-register-settings-of-srch-command_", 543)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        /-------------------\")
  Th2HandbookHelp_L("@@@        |     SRCH start    |")
  Th2HandbookHelp_L("@@@        \-------------------/")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        |   register setup  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@        | command execution |")
  Th2HandbookHelp_L("@@@        ---------------------")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@+---------------->|")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | Read status register #2 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|       //////////+\\\\\\\\\\")
  Th2HandbookHelp_L("@@@+-------|   command end?    |")
  Th2HandbookHelp_L("@@@   No   \\\\\\\\\\+//////////")
  Th2HandbookHelp_L("@@@(CE bit = 1)      |")
  Th2HandbookHelp_L("@@@                  | Yes (CE bit = 0)")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@     /////////////+\\\\\\\\\\\\\")
  Th2HandbookHelp_L("@@@+----| Is border colour found? |")
  Th2HandbookHelp_L("@@@|    \\\\\\\\\\\\\+/////////////")
  Th2HandbookHelp_L("@@@| No              |")
  Th2HandbookHelp_L("@@@| (BO bit = 0)    | Yes (BO bit = 1)")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | Read status register #8 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|    | Read status register #2 |")
  Th2HandbookHelp_L("@@@|    ---------------------------")
  Th2HandbookHelp_L("@@@|                 |")
  Th2HandbookHelp_L("@@@+---------------->|")
  Th2HandbookHelp_L("@@@                  |")
  Th2HandbookHelp_L("@@@                  V")
  Th2HandbookHelp_L("@@@        /--------------------\")
  Th2HandbookHelp_L("@@@        |      SRCH end      |")
  Th2HandbookHelp_L("@@@        \--------------------/")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.98  SRCH command execution flowchart_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-498-srch-command-execution-flowchart_", 544)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.17   SRCH sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, E, A as follows")
  Th2HandbookHelp_L("@@@;                srch (x:H, y:L, color:E, arg(reg#45) : A)")
  Th2HandbookHelp_L("@@@;                returns: Z  (not found)")
  Th2HandbookHelp_L("@@@;                         NZ (A := X)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SRCH:   DI                              ;disable interrupt")
  Th2HandbookHelp_L("@@@        PUSH    AF                      ;save arg")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     C                       ;C := PORT#1's address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      D,0")
  Th2HandbookHelp_L("@@@        LD      A,32+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),H")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#32 := H")
  Th2HandbookHelp_L("@@@        INC     A")
  Th2HandbookHelp_L("@@@        OUT     (C),D")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#33 := 0")
  Th2HandbookHelp_L("@@@        INC     A")
  Th2HandbookHelp_L("@@@        OUT     (C),L")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#34 := L")
  Th2HandbookHelp_L("@@@        INC     A")
  Th2HandbookHelp_L("@@@        OUT     (C),D")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#35 := 0")
  Th2HandbookHelp_L("@@@        LD      A,44+80H")
  Th2HandbookHelp_L("@@@        OUT     (C),E")
  Th2HandbookHelp_L("@@@        OUT     (C),A                   ;R#44 := E")
  Th2HandbookHelp_L("@@@        INC     A")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        POP     AF                      ;A := ARG")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),E                   ;R#45 := A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,01100000B")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        INC     E")
  Th2HandbookHelp_L("@@@        OUT     (C),E                   ;R#46 := SRCH command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LOOP:   LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        BIT     0,A")
  Th2HandbookHelp_L("@@@        JP      NZ,LOOP")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        LD      A,8")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        LD      D,A")
  Th2HandbookHelp_L("@@@        LD      A,9")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        LD      A,D")
  Th2HandbookHelp_L("@@@        BIT     4,E")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.17  Example of SRCH command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-417-example-of-srch-command-execution_", 545)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.18   SRCH and LINE sample")
  Th2HandbookHelp_L("@@@;                search color to right and left,")
  Th2HandbookHelp_L("@@@;                then draw line between the two points")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        EXTRN   SRCH")
  Th2HandbookHelp_L("@@@        EXTRN   LINE")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Y       EQU     0A800H")
  Th2HandbookHelp_L("@@@X       EQU     0A801H")
  Th2HandbookHelp_L("@@@COL     EQU     0A802H")
  Th2HandbookHelp_L("@@@ARG     EQU     0A803H")
  Th2HandbookHelp_L("@@@PCOL    EQU     0A804H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MAIN:   LD      (STK),SP")
  Th2HandbookHelp_L("@@@        LD      SP,AREA")
  Th2HandbookHelp_L("@@@        LD      HL,(Y)")
  Th2HandbookHelp_L("@@@        LD      A,(COL)")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        LD      A,(ARG)")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        SET     2,A")
  Th2HandbookHelp_L("@@@        CALL    SRCH")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        JP      NZ,S1")
  Th2HandbookHelp_L("@@@        LD      A,(X)")
  Th2HandbookHelp_L("@@@        DEC     A")
  Th2HandbookHelp_L("@@@S1:     INC     A")
  Th2HandbookHelp_L("@@@        PUSH    AF")
  Th2HandbookHelp_L("@@@        LD      A,(ARG)")
  Th2HandbookHelp_L("@@@        RES     2,A")
  Th2HandbookHelp_L("@@@        CALL    SRCH")
  Th2HandbookHelp_L("@@@        JP      NZ,S2")
  Th2HandbookHelp_L("@@@        LD      A,(X)")
  Th2HandbookHelp_L("@@@        INC     A")
  Th2HandbookHelp_L("@@@S2:     DEC     A")
  Th2HandbookHelp_L("@@@        LD      D,A")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        LD      H,A")
  Th2HandbookHelp_L("@@@        LD      A,(Y)")
  Th2HandbookHelp_L("@@@        LD      L,A")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        LD      A,(PCOL)")
  Th2HandbookHelp_L("@@@        LD      B,A")
  Th2HandbookHelp_L("@@@        LD      A,0                     ;PSET")
  Th2HandbookHelp_L("@@@        CALL    LINE")
  Th2HandbookHelp_L("@@@        LD      SP,(STK)")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- work area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@STK:    DS      2")
  Th2HandbookHelp_L("@@@        DS      200")
  Th2HandbookHelp_L("@@@AREA:   $")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.18  Simple PAINT routine using SRCH and LINE_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-418-simple-paint-routine-using-srch-and-line_", 546)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '***********************************************")
  Th2HandbookHelp_L("@@@1010 ' List 4.19   SRCH and LINE sample")
  Th2HandbookHelp_L("@@@1020 ' Operate cursor while holding down the space bar.")
  Th2HandbookHelp_L("@@@1030 '***********************************************")
  Th2HandbookHelp_L("@@@1040 '")
  Th2HandbookHelp_L("@@@1050 SCREEN 5")
  Th2HandbookHelp_L("@@@1060 FOR I=0 TO 50:LINE -(RND(1)*255,RND(1)*211),15:NEXT")
  Th2HandbookHelp_L("@@@1070 I=&HA000 :DEF USR=I")
  Th2HandbookHelp_L("@@@1080 READ A$")
  Th2HandbookHelp_L("@@@1090 IF  A$=" + Chr(34) + "END" + Chr(34) + " THEN 1130")
  Th2HandbookHelp_L("@@@1100   POKE I,VAL(" + Chr(34) + "&H" + Chr(34) + "+A$):I=I+1")
  Th2HandbookHelp_L("@@@1110   READ A$")
  Th2HandbookHelp_L("@@@1120 GOTO 1090")
  Th2HandbookHelp_L("@@@1130 X=128:Y=100:COL=15:PCOL=2:ARG=0")
  Th2HandbookHelp_L("@@@1140 CURS=0")
  Th2HandbookHelp_L("@@@1150 A=STICK(0)")
  Th2HandbookHelp_L("@@@1160 CURS=(CURS+1) AND 1")
  Th2HandbookHelp_L("@@@1170 LINE (X-5,I)-(X+5,I),15,,XOR")
  Th2HandbookHelp_L("@@@1180 LINE (X,Y-5)-(X,Y+5),15,,XOR")
  Th2HandbookHelp_L("@@@1190 IF CURS=1 THEN 1290")
  Th2HandbookHelp_L("@@@1200 IF A=1 THEN Y=Y-1")
  Th2HandbookHelp_L("@@@1210 IF A=2 THEN Y=Y-1:X=X+1")
  Th2HandbookHelp_L("@@@1220 IF A=3 THEN X=X+1")
  Th2HandbookHelp_L("@@@1230 IF A=4 THEN X=X+1:Y=Y+1")
  Th2HandbookHelp_L("@@@1240 IF A=5 THEN Y=Y+1")
  Th2HandbookHelp_L("@@@1250 IF A=6 THEN Y=Y+1:X=X-1")
  Th2HandbookHelp_L("@@@1260 IF A=7 THEN X=X-1")
  Th2HandbookHelp_L("@@@1270 IF A=8 THEN X=X-1:Y=Y-1")
  Th2HandbookHelp_L("@@@1280 IF STRIG(9) THEN GOSUB 1300")
  Th2HandbookHelp_L("@@@1290 GOTO 1150")
  Th2HandbookHelp_L("@@@1300 POKE &HA800,Y")
  Th2HandbookHelp_L("@@@1310 POKE &HA801,X")
  Th2HandbookHelp_L("@@@1320 POKE &HA802,COL")
  Th2HandbookHelp_L("@@@1330 POKE &HA803,ARG")
  Th2HandbookHelp_L("@@@1340 POKE &HA804,PCOL")
  Th2HandbookHelp_L("@@@1350 A=USR(0)")
  Th2HandbookHelp_L("@@@1360 RETURN")
  Th2HandbookHelp_L("@@@1370 DATA ED,73,80,A8,31,4A,A9,2A,00,A8,3A,02")
  Th2HandbookHelp_L("@@@1380 DATA A8,5F,3A,03,A8,E5,D5,CB,D7,CD,AD")
  Th2HandbookHelp_L("@@@1390 DATA A0,D1,E1,C2,21,A0,3A,01,A8")
  Th2HandbookHelp_L("@@@1400 DATA 3D,3C,F5,3A,03,A8,CB,97,CD,AD,A0,C2")
  Th2HandbookHelp_L("@@@1410 DATA 32,A0,3A,01,AB,3C,3D,57,F1,67,3A")
  Th2HandbookHelp_L("@@@1420 DATA 00,A8,6F,5F,3A,04,A8,47,3E")
  Th2HandbookHelp_L("@@@1430 DATA 00,CD,49,A0,ED,7B,80,A8,C9,F3,F5,CD")
  Th2HandbookHelp_L("@@@1440 DATA 0D,A1,C5,3A,06,00,4F,0C,3E,24,ED")
  Th2HandbookHelp_L("@@@1450 DATA 79,3E,91,ED,79,0C,0C,AF,ED")
