  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("WRTPSG (0093H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtpsg-0093h-1", 804)

