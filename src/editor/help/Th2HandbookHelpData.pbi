  Th2HandbookHelp_AddAnchor("Chapter2#k-1", 65)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`LFILES [" + Chr(34) + "<filename>" + Chr(34) + "]`  |  Command  |  Sends the name of the file matched with `<filename>` to the printer.")
  Th2HandbookHelp_L("**`** LFILES [" + Chr(34) + "<filename>" + Chr(34) + "][,L]`**  |  Command  |  Sends the name of the file matched with `<filename>` to the printer, and also the attributes and the size of the file if " + Chr(34) + "L" + Chr(34) + " is specified.")
  Th2HandbookHelp_L("`LINE INPUT #<file number>, <string variable name>`  |  Statement  |  Reads lines of data from the file to the string variable.")
  Th2HandbookHelp_L("`LOAD " + Chr(34) + "<filename>" + Chr(34) + "[, R]`  |  Command  |  Loads the program into memory.")
  Th2HandbookHelp_L("`LOC (<filenumber>)`  |  Function  |  Returns the record number of the most recently accessed location of the file.")
  Th2HandbookHelp_L("`LOF (<filenumber>)`  |  Function  |  Returns the size of the specified file in bytes.")
  Th2HandbookHelp_L("`LSET <string variable name>=<string expression>`  |  Statement  |  Stores data padded on the left in the random input/output buffer.")
  Th2HandbookHelp_Commit("--- L ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#l-1", 66)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`MAXFILES = <the number of files>`  |  Statement  |  Declares the maximum number of files that can be opened.")
  Th2HandbookHelp_L("`MERGE " + Chr(34) + "<filename>" + Chr(34) + "`  |  Command  |  Merges the program in memory with the program saved in ASCII format.")
  Th2HandbookHelp_L("`MKD$ (<double precision real value>)`  |  Function  |  Converts the double precision real value to the character code corresponding to the internal expression.")
  Th2HandbookHelp_L("`MKI$ (<integer value>)`  |  Function  |  Converts the integer value to the character code corresponding to the internal expression.")
  Th2HandbookHelp_L("`MKS$ (<single precision real value>)`  |  Function  |  Converts the single precision real value to the character code corresponding to the internal expression.")
  Th2HandbookHelp_Commit("--- M ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#m-1", 67)

  Th2HandbookHelp_Begin()
