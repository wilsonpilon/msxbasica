  Th2HandbookHelp_AddAnchor("Chapter2#i-1", 64)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`KILL " + Chr(34) + "<filename>" + Chr(34) + "`  |  Command  |  Delets the file specified by `<filename>`.")
