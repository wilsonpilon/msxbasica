  Th2HandbookHelp_L("@@@   |  (the 2nd decimal place)  |  .      .      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 6 |  Day of                   |                           |")
  Th2HandbookHelp_L("@@@   |  the week                 |  .      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 7 |  Day                      |                           |")
  Th2HandbookHelp_L("@@@   |  (the 1st decimal place)  |  X      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 8 |  Day                      |                           |")
  Th2HandbookHelp_L("@@@   |  (the 2nd decimal place)  |  .      .      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
