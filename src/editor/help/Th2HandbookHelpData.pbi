  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **contents**: mode switch for VRAM size")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        (0000WVV0)")
  Th2HandbookHelp_L("@@@             ---")
  Th2HandbookHelp_L("@@@             |||")
  Th2HandbookHelp_L("@@@             |++--- 00 = 16K VRAM")
  Th2HandbookHelp_L("@@@             |      01 = 64K VRAM")
  Th2HandbookHelp_L("@@@             |      11 = 128K VRAM")
  Th2HandbookHelp_L("@@@             |")
  Th2HandbookHelp_L("@@@             +----- 1 = mask, 0 = no mask")
  Th2HandbookHelp_L("@@@                    Flags whether to specify VRAM address")
  Th2HandbookHelp_L("@@@                    ANDed with 3FFFH in SCREEN 0 to 3;")
  Th2HandbookHelp_L("@@@                    in SCREEN 4 to 8, never masked")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("MODE (FAFCH, 1)", "Appendix 4: Work area listing")
  Th2HandbookHelp_AddAnchor("Appendix4#mode-fafch-1", 1115)

