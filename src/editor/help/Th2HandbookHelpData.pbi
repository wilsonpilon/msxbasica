  Th2HandbookHelp_Commit("_Figure 5.17B  MSX European version key matrix_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-517b-msx-european-version-key-matrix_", 624)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;  List 5.4   scan key-matrix and display it")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHPUT   EQU     00A2H")
  Th2HandbookHelp_L("@@@BREAKX  EQU     00B7H")
  Th2HandbookHelp_L("@@@POSIT   EQU     00C6H")
  Th2HandbookHelp_L("@@@SNSMAT  EQU     0141H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----      Note:  read key matrix and display key")
  Th2HandbookHelp_L("@@@                                       pattern.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SCAN:   LD      C,0             ;C := line of key matrix")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SC1:    LD      A,C")
  Th2HandbookHelp_L("@@@        CALL    SNSMAT          ;Read key matrix")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      B,8")
  Th2HandbookHelp_L("@@@        LD      HL,BUF          ;HL : = buffer address")
  Th2HandbookHelp_L("@@@SC2:    LD      D,'.'")
  Th2HandbookHelp_L("@@@        RLA                     ;Check bit")
  Th2HandbookHelp_L("@@@        JR      C,SC3")
  Th2HandbookHelp_L("@@@        LD      D,'#'")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SC3:    LD      (HL),D          ;store '.' or '#' to buffer")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        DJNZ    SC2")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      H,05H           ;x := 5")
  Th2HandbookHelp_L("@@@        LD      L,C             ;y := C+1")
  Th2HandbookHelp_L("@@@        INC     L")
  Th2HandbookHelp_L("@@@        CALL    POSIT           ;set cursor position")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      B,8             ;put out bit patterns to CRT")
  Th2HandbookHelp_L("@@@        LD      HL,BUF")
  Th2HandbookHelp_L("@@@SC4:    LD      A,(HL)")
  Th2HandbookHelp_L("@@@        CALL    CHPUT")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        DJNZ    SC4")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    BREAKX          ;check Ctrl-STOP")
  Th2HandbookHelp_L("@@@        RET     C")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C               ;line No. increment")
  Th2HandbookHelp_L("@@@        LD      A,C")
  Th2HandbookHelp_L("@@@        CP      09")
  Th2HandbookHelp_L("@@@        JR      NZ,SC1")
  Th2HandbookHelp_L("@@@        JR      SCAN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- work area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BUF:    DS      8")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.4  Use of the key scanning routine_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-54-use-of-the-key-scanning-routine_", 625)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX scans the key matrix every 1/60 second using the timer interrupt and, when a key is pressed, stores the character code in the keyboard buffer as shown in [[[Figure 5.18|||Chapter5a#figure-518--keyboard-ring-buffer]]]. Key input to MSX is generally done by reading this keyboard buffer.")
  Th2HandbookHelp_Commit("3.2 Character Input", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#32-character-input", 626)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@+----------------------------------<----------------------------------------+")
  Th2HandbookHelp_L("@@@|                             KEYBUF (FBF0H, 40)                            |")
  Th2HandbookHelp_L("@@@| --------------------------------------/ /-------------------------------- |")
  Th2HandbookHelp_L("@@@+>|  D  |  E  |  F  |  G  |     |     | \ \ |     |     |  A  |  B  |  C  |-+")
  Th2HandbookHelp_L("@@@  --------------------------------------/ /--------------------------------")
  Th2HandbookHelp_L("@@@                             ^                             ^")
  Th2HandbookHelp_L("@@@                             |                             |")
  Th2HandbookHelp_L("@@@                          [PUTPNT]                      [GETPNT]")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("GETPNT (F3FAH, 2) points to the next character to be obtained in CHGET routine.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("PUTPNT (F3F8H, 2) points to the next location for the character to be put when the keyboard is pressed next time.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("BIOS routines having functions for key input using this keyboard buffer and functions related to it are described below. Inhibiting the timer interrupt renders them useless, of course.")
  Th2HandbookHelp_Commit("_Figure 5.18  Keyboard ring buffer_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-518-keyboard-ring-buffer_", 627)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: Z flag = ON when the buffer is empty")
  Th2HandbookHelp_L("* **Function**: examines whether any characters remain in the keyboard buffer and sets the Z flag when the buffer is empty.")
  Th2HandbookHelp_Commit("CHSNS (009CH/MAIN) - checks the keyboard buffer", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#chsns-009chmain---checks-the-keyboard-buffer", 628)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: A ⟵ character code")
  Th2HandbookHelp_L("* **Function**: reads one character from the keyboard buffer and stores it in the A register. When the buffer is empty, it displays the cursor and waits for a key input. While a key input is waited for, the CAPS lock, KANA lock, and Roman-to-kana translation lock are valid. The related work area is listed below. In the list, since SCNCNT and REPCNT are initialised after the execution of CHGET routine, this area should be set at each CHGET call to change the interval of the auto-repeat.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Work area:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **CLIKSW (F3DBH, 1)**: key click sound (0 = OFF, others = ON)")
  Th2HandbookHelp_L("* **SCNCNT (F3F6H, 1)**: key scanning interval (1, normally)")
  Th2HandbookHelp_L("* **REPCNT (F3F7H, 1)**: delay until beginning auto-repeat (50, normally)")
  Th2HandbookHelp_L("* **CSTYLE (FCAAH, 1)**: figure of the cursor (0 = block, others = underline)")
  Th2HandbookHelp_L("* **CAPST  (FCABH, 1)**: CAPS lock (0 = OFF, others = ON)")
  Th2HandbookHelp_L("* **DEADST (FCACH, 1)**: dead key lock")
  Th2HandbookHelp_L("  * 0 = on preceding dead key")
  Th2HandbookHelp_L("  * 1 = dead key")
  Th2HandbookHelp_L("  * 2 = shifted dead key")
  Th2HandbookHelp_L("  * 3 = code dead key")
  Th2HandbookHelp_L("  * 4 = code shift dead key")
  Th2HandbookHelp_Commit("CHGET (009FH/MAIN) - one character input from the keyboard buffer", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#chget-009fhmain---one-character-input-from-the-keyboard-buffer", 629)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Function**: empties the keyboard buffer.")
  Th2HandbookHelp_Commit("KILBUF (0156H/MAIN) - empty the keyboard buffer", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#kilbuf-0156hmain---empty-the-keyboard-buffer", 630)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;   List 5.5    get key code")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;               this routine doesn't wait for key hit")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHSNS   EQU     009CH           ;check keyboard buffer")
  Th2HandbookHelp_L("@@@CHGET   EQU     009FH           ;get a character from buffer")
  Th2HandbookHelp_L("@@@CHPUT   EQU     00A2H           ;put a character to screen")
  Th2HandbookHelp_L("@@@BREAKX  EQU     00B7H           ;check Ctrl-STOP")
  Th2HandbookHelp_L("@@@KILBUF  EQU     0156H           ;clear keyboard buffer")
  Th2HandbookHelp_L("@@@REPCNT  EQU     0F3F7H          ;time interval until key-repeat")
  Th2HandbookHelp_L("@@@KEYBUF  EQU     0FBF0H          ;keyboard buffer address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- prgram start -----       Note:  Real-time input using CHGET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@KEY:    CALL    CHSNS           ;check keyboard buffer")
  Th2HandbookHelp_L("@@@        JR      C,KEY1")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,1")
  Th2HandbookHelp_L("@@@        LD      (REPCNT),A      ;not to wait until repeat")
  Th2HandbookHelp_L("@@@        CALL    CHGET           ;get a character (if exists)")
  Th2HandbookHelp_L("@@@        JR      KEY2")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@KEY1:   LD      A,'-'           ;A := '-'")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@KEY2:   CALL    CHPUT           ;put the character")
  Th2HandbookHelp_L("@@@        CALL    KILBUF          ;clear keyboard buffer")
  Th2HandbookHelp_L("@@@        CALL    BREAKX          ;check Ctrl-STOP")
  Th2HandbookHelp_L("@@@        JR      NC,KEY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.5  Use of one character input routine_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-55-use-of-one-character-input-routine_", 631)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A ⟵ character code")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * A ⟵ translated graphic character (normal characters are not translated)")
  Th2HandbookHelp_L("  * CY flag = OFF (input was the graphic header byte 01H)")
  Th2HandbookHelp_L("  * CY flag = ON, Z flag = ON  (input was the graphic character and was translated)")
  Th2HandbookHelp_L("  * CY flag = ON, Z flag = OFF (input was the normal character and was not translated)")
  Th2HandbookHelp_L("* **Function**: executing CNVCHR after CHGET causes the graphic character to be translated to one byte code as shown in [[[Figure 5.19|||Chapter5a#figure-519--graphic-character-translation-chart]]] and causes other character not to be translated and to be returned. Since the graphic character is represented by irregular 2-byte code with the graphic header byte (01H), annoying procedures are required for the character operations; this routine makes it somewhat easy.")
  Th2HandbookHelp_Commit("CNVRCHR (00AB/MAIN) - graphic character operation", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#cnvrchr-00abmain---graphic-character-operation", 632)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|    Before    |    After     |    Before    |    After     |")
  Th2HandbookHelp_L("@@@|  conversion  |  conversion  |  conversion  |  conversion  |")
  Th2HandbookHelp_L("@@@|-----------------------------+-----------------------------|")
  Th2HandbookHelp_L("@@@|                             |    0150H    -->     50H     |")
  Th2HandbookHelp_L("@@@|    0141H    -->     41H     |    0151H    -->     51H     |")
  Th2HandbookHelp_L("@@@|    0142H    -->     42H     |    0152H    -->     52H     |")
  Th2HandbookHelp_L("@@@|    0143H    -->     43H     |    0153H    -->     53H     |")
  Th2HandbookHelp_L("@@@|    0144H    -->     44H     |    0154H    -->     54H     |")
  Th2HandbookHelp_L("@@@|    0145H    -->     45H     |    0155H    -->     55H     |")
  Th2HandbookHelp_L("@@@|    0146H    -->     46H     |    0156H    -->     56H     |")
  Th2HandbookHelp_L("@@@|    0147H    -->     47H     |    0157H    -->     57H     |")
  Th2HandbookHelp_L("@@@|    0148H    -->     48H     |    0158H    -->     58H     |")
  Th2HandbookHelp_L("@@@|    0149H    -->     49H     |    0159H    -->     59H     |")
  Th2HandbookHelp_L("@@@|    014AH    -->     4AH     |    015AH    -->     5AH     |")
  Th2HandbookHelp_L("@@@|    014BH    -->     4BH     |    015BH    -->     5BH     |")
  Th2HandbookHelp_L("@@@|    014CH    -->     4CH     |    015CH    -->     5CH     |")
  Th2HandbookHelp_L("@@@|    014DH    -->     4DH     |    015DH    -->     5DH     |")
  Th2HandbookHelp_L("@@@|    014EH    -->     4EH     |    015EH    -->     5EH     |")
  Th2HandbookHelp_L("@@@|    014FH    -->     4FH     |    015FH    -->     5FH     |")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.19  Graphic character translation chart_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-519-graphic-character-translation-chart_", 633)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: ")
  Th2HandbookHelp_L("  * HL ⟵ F55DH")
  Th2HandbookHelp_L("  * [F55EH] ⟵ input string (the end of te line is represented by 00H)")
  Th2HandbookHelp_L("  * CY flag ⟵ terminated by STOP=ON, terminated by RETURN=OFF")
  Th2HandbookHelp_L("* **Function**: stores input string in the line buffer BUF (F55EH). All functions of the screen editing are available at the string input. Pressing RETURN or STOP causes the input to be finished. The work area is listed below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Work area:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **BUF (F55EH, 258)**: the line buffer where the string is stored")
  Th2HandbookHelp_L("* **LINTTB (FBB2H, 24)**: 00H when the one physiscal line is the succession of the line above")
  Th2HandbookHelp_Commit("PINLIN (00AEH/MAIN) - one line input", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#pinlin-00aehmain---one-line-input", 634)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: same as PINLIN")
  Th2HandbookHelp_L("* **Function**: stores input string in the line buffer BUF (F55EH), as PINLIN routine. Note that the portion before the cursor location at the time when the routine begins to execute is not received. [[[List 5.6|||Chapter5a#list-56--difference-between-inlin-and-pinlin]]] shows the difference between PINLIN and INLIN.")
  Th2HandbookHelp_Commit("INLIN (00B1H/MAIN) - one line input (prompt available)", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#inlin-00b1hmain---one-line-input-prompt-available", 635)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;  List 5.6   INLIN and PINLIN")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHPUT   EQU     00A2H")
  Th2HandbookHelp_L("@@@INLIN   EQU     00B1H")
  Th2HandbookHelp_L("@@@PINLIN  EQU     00AEH")
  Th2HandbookHelp_L("@@@KILBUF  EQU     0156H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BUF     EQU     F55EH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      HL,PRMPT1")
  Th2HandbookHelp_L("@@@        CALL    PUTMSG          ;put prompt message")
  Th2HandbookHelp_L("@@@        CALL    INLIN           ;use INLIN routine")
  Th2HandbookHelp_L("@@@        LD      HL,BUF")
  Th2HandbookHelp_L("@@@        CALL    PUTMSG")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      HL,PRMPT2")
  Th2HandbookHelp_L("@@@        CALL    PUTMSG          ;put prompt message")
  Th2HandbookHelp_L("@@@        CALL    PINLIN          ;use PINLIN routine")
  Th2HandbookHelp_L("@@@        LD      HL,BUF")
  Th2HandbookHelp_L("@@@        CALL    PUTMSG")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- put a string -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PUTMSG: LD      A,(HL)")
  Th2HandbookHelp_L("@@@        CP      '$'")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        CALL    CHPUT")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        JR      PUTMSG")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- string data -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PRMPT1: DB      0DH,0AH,'INLIN:$'")
  Th2HandbookHelp_L("@@@PRMPT2: DB      0DH,0AH,'PINLIN:$'")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.6  Difference between INLIN and PINLIN_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-56-difference-between-inlin-and-pinlin_", 636)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX has ten function keys, which can be defined by the user at will. A 16 byte work area is allocated for the definition of each key. The following list shows their addresses.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **FNKSTR (F87FH, 16)**: F1 key definition address")
  Th2HandbookHelp_L("* **+ 10H  (F88FH, 16)**: F2 key definition address")
  Th2HandbookHelp_L("* **+ 20H  (F89FH, 16)**: F3 key definition address")
  Th2HandbookHelp_L("* **+ 30H  (F8AFH, 16)**: F4 key definition address")
  Th2HandbookHelp_L("* **+ 40H  (F8BFH, 16)**: F5 key definition address")
  Th2HandbookHelp_L("* **+ 50H  (F8CFH, 16)**: F6 key definition address")
  Th2HandbookHelp_L("* **+ 60H  (F8DFH, 16)**: F7 key definition address")
  Th2HandbookHelp_L("* **+ 70H  (F8EFH, 16)**: F8 key definition address")
  Th2HandbookHelp_L("* **+ 80H  (F8FFH, 16)**: F9 key definition address")
  Th2HandbookHelp_L("* **+ 90H  (F90FH, 16)**: F10 key definition address")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Pressing a function key causes the string defined in that key to be stored in [KEYBUF]. The end of the string is indicated by 00H and a maximum of 15 keystrokes can be defined for one function key (definitions longer than 16 keystrokes are defined over more than one function key definition area). To restore the initial settings of the function keys, use the following BIOS routine.")
  Th2HandbookHelp_Commit("3.3 Function Keys", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#33-function-keys", 637)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Function**: restores the function key definition to the setting when BASIC starts.")
  Th2HandbookHelp_Commit("INIFNK (003EH/MAIN) - initialize function keys", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#inifnk-003ehmain---initialize-function-keys", 638)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("CHGET, the one-character input routine described in 3.3, determines the pressed key in the timer interrupt routine. Thus, when the timer interrupt is inhibited, such as during cassette data I/O, pressed keys cannot be detected. By using the BIOS routine described below, the CTRL key + STOP key combination can be detected even when interrupts are inhibited.")
  Th2HandbookHelp_Commit("3.4 STOP Key During Interrupts", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#34-stop-key-during-interrupts", 639)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: CY flag = ON, when CTRL + STOP is pressed")
  Th2HandbookHelp_L("* **Function**: scans keys and decides whether CTRL key and STOP key are pressed at the same time. When both are pressed, this routine sets " + Chr(34) + "1" + Chr(34) + " to the CY flag and returns. Otherwise, it resets " + Chr(34) + "0" + Chr(34) + " to the CY flag and returns. This routine is available while interrupts are inhibited.")
  Th2HandbookHelp_Commit("BREAKX (00B7H/MAIN) - CTRL + STOP detection", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#breakx-00b7hmain---ctrl-stop-detection", 640)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This section describes how to access the MSX printer interface from assembly language. The information described here is helpful if the printer is going to be used to print bit image graphics.")
  Th2HandbookHelp_Commit("4. PRINTER INTERFACE", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#4-printer-interface", 641)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The printer interface is supported by BIOS and BASIC. MSX drives the printer through an 8-bit parallel output port and uses a handshaking method with BUSY and STROBE signals. The standard connector is also defined (Amphenol 14-pin, female side to the machine). [[[Figure 5.20|||Chapter5a#figure-520--printer-interface]]] shows the signal lines.")
  Th2HandbookHelp_Commit("4.1 Print Interface Overview", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#41-print-interface-overview", 642)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                 Printer interface pin connections")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@ \          -------------------------------------------          /")
  Th2HandbookHelp_L("@@@  \         | (7) | (6) | (5) | (4) | (3) | (2) | (1) |         /")
  Th2HandbookHelp_L("@@@   \    ---------------------------------------------------    /")
  Th2HandbookHelp_L("@@@    \   |                                                 |   /")
  Th2HandbookHelp_L("@@@     \  ---------------------------------------------------  /")
  Th2HandbookHelp_L("@@@      \     | (14)| (13)| (12)| (11)| (11)| (10)| (9) |     /")
  Th2HandbookHelp_L("@@@       \    -------------------------------------------    /")
  Th2HandbookHelp_L("@@@        ---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@(1) ........... STROBE*")
  Th2HandbookHelp_L("@@@(2) to (9) .... Data (b0 to b7)")
  Th2HandbookHelp_L("@@@(11) .......... BUSY")
  Th2HandbookHelp_L("@@@(14) .......... BGND")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@I/O port (91H)              |  X  |  X  |  X  |  X  |  X  |  X  |  X  |  X  |")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@                                                   Data")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@I/O port (90H; at WRITE)    |  .  |  .  |  .  |  .  |  .  |  .  |  .  |  X  |")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@                                                                         ^")
  Th2HandbookHelp_L("@@@                                                                         |")
  Th2HandbookHelp_L("@@@                                        STROBE* (send data when " + Chr(34) + "0" + Chr(34) + ") ----+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@I/O port (90H; at READ)     |  .  |  .  |  .  |  .  |  .  |  .  |  X  |  .  |")
  Th2HandbookHelp_L("@@@                            -------------------------------------------------")
  Th2HandbookHelp_L("@@@                                                                   ^")
  Th2HandbookHelp_L("@@@                                               0: Printer READY    |")
  Th2HandbookHelp_L("@@@                                                                ---+")
  Th2HandbookHelp_L("@@@                                               1: Printer BUSY")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.20  Printer interface_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-520-printer-interface_", 643)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("If data is sent from MSX to the printer, the action depends on whether the printer receiving the data is of the MSX standard. The use of MSX standard printers is described in this section. Descriptions about other printers are in the next section.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("An MSX standard printer can print any character that can be displayed on the screen. Special graphic characters corresponding to character codes n = 01H to 1FH can be also printed by sending the code 40H + n after the graphic character header (01H). In addition to these, the control codes shown in [[[Table 5.4|||Chapter5a#table-54--control-codes-of-the-printer]]] can be used with MSX standard printers (see the manual of the printer for controlling a printer which has other functions such as printing Chinese characters).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("To feed lines in MSX standard printers, send 0DH and 0AH successively. To print the bit image, send nnnn bytes data, where nnnn means four decimal figures, after the escape sequence ESC + " + Chr(34) + "Snnnn" + Chr(34) + ". Note that, MSX has a function to transform the tab code (09H) to the adequate number of space codes (20H) for printers not having a tab function. This transformation is normally done. To print a bit image which includes the value 09H correctly, change the following work area.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **RAWPRT (F418H, 1)**: replaces a tab by spaces when the contents are 00H, otherwise not.")
  Th2HandbookHelp_Commit("4.2 Output to the MSX Standard Printer", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#42-output-to-the-msx-standard-printer", 644)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|      code       |                        function                         |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| 0AH             |  line feed                                              |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| 0CH             |  form feed                                              |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| 0DH             |  carriage return                                        |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| ESC + " + Chr(34) + "A" + Chr(34) + "       |  normal line spacing                                    |")
  Th2HandbookHelp_L("@@@|                 |  (spaces between lines; characters are read easily)     |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| ESC + " + Chr(34) + "B" + Chr(34) + "       |  line spacing for graphics (no space between lines)     |")
  Th2HandbookHelp_L("@@@|-----------------+---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| ESC + " + Chr(34) + "Snnnn" + Chr(34) + "   |  bit image printing                                     |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 5.4  Control codes of the printer_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_table-54-control-codes-of-the-printer_", 645)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To send output to the printer, the following BIOS routines are offered.")
  Th2HandbookHelp_Commit("4.3 Access to the printer", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#43-access-to-the-printer", 646)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A register ⟵ character code")
  Th2HandbookHelp_L("* **Output**: CY flag = ON at abnormal termination")
  Th2HandbookHelp_L("* **Function**: sends a character specified by the A register to the printer.")
  Th2HandbookHelp_Commit("LPTOUT (00A5H/MAIN)", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#lptout-00a5hmain", 647)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: A register ⟵ printer status")
  Th2HandbookHelp_L("* **Function**: examines the current printer status. After calling this routine, the printer can be used when the A register is 255 and the Z flag is 0; when the A register is 0 and the Z flag is 1, the printer cannot be used.")
  Th2HandbookHelp_Commit("LPTSTT (00A8/MAIN)", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#lptstt-00a8main", 648)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A register ⟵ character code")
  Th2HandbookHelp_L("* **Output**: CY flag = ON at abnormal termination")
  Th2HandbookHelp_L("* **Function**: sends a character specified by the A register to the printer. Differences between this routine and LPTOUT routine is as following: ")
  Th2HandbookHelp_L("  * prints corresponding number of spaces for TAB code ")
  Th2HandbookHelp_L("  * transforms hiragana to katakana for printers other than MSX standard")
  Th2HandbookHelp_L("  * returns Device I/O error at abnormal termination")
  Th2HandbookHelp_Commit("OUTDLP (014DH,MAIN)", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#outdlp-014dhmain", 649)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("As described in section 1, the PSG used by MSX has two 8-bit I/O ports, port A and port B, in addition to the sound output function. In MSX, these two ports are connected to the universal I/O interface (joystick port) and are used to exchange data with the joystick or the paddle (see [[[Figure 5.21|||Chapter5a#figure-521--universal-io-interface]]]). Various devices to be connected to this universal I/O interface have the necessary BIOS routine in ROM, so they are easily accessbile.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In this section, the funtion of each I/O device and the method for accessing with BIOS routines are described.")
  Th2HandbookHelp_Commit("5. UNIVERSAL I/O INTERFACE", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#5-universal-io-interface", 650)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@   Universal input/output interface -1")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|                                       |")
  Th2HandbookHelp_L("@@@|  (1)     (2)     (3)     (4)     (5) -+- +5V         Switching signal <---+")
  Th2HandbookHelp_L("@@@|   |  (6)  |  (7)  |  (8)  |  (9) -----+- GND          (to port B:b6)      |")
  Th2HandbookHelp_L("@@@|   |   |   |   |   |   |   |           |                                   |")
  Th2HandbookHelp_L("@@@----:---:---:---:---:---:---:------------                                   |")
  Th2HandbookHelp_L("@@@    |   |   |   |   |   |   |                                               |")
  Th2HandbookHelp_L("@@@    |   |   |   |   |   +---:--> To port B:b4    -------------------------  |")
  Th2HandbookHelp_L("@@@    |   |   |   |   |       |                    |                       |  |")
  Th2HandbookHelp_L("@@@    +---+---+---+---+-------+--------------------|                       |  |")
  Th2HandbookHelp_L("@@@                                                 |       Switcher        |--+")
  Th2HandbookHelp_L("@@@    +---+---+---+---+-------+--------------------|                       |")
  Th2HandbookHelp_L("@@@    |   |   |   |   |       |                    |                       |")
  Th2HandbookHelp_L("@@@    |   |   |   |   |   +---:--> To port B:b5    -------------------------")
  Th2HandbookHelp_L("@@@    |   |   |   |   |   |   |                      |   |   |   |   |   |")
  Th2HandbookHelp_L("@@@----:---:---:---:---:---:---:------------         (1) (2) (3) (4) (6) (7)")
  Th2HandbookHelp_L("@@@|   |   |   |   |   |   |   |           |       |  |   |   |   |   |   |  |")
  Th2HandbookHelp_L("@@@|  (1)     (2)     (3)     (4)     (5) -+- +5V  +-------------------------+")
  Th2HandbookHelp_L("@@@|      (6)     (7)     (8)     (9) -----+- GND               |")
  Th2HandbookHelp_L("@@@|                                       |                    V")
  Th2HandbookHelp_L("@@@-----------------------------------------            To port A:b0 to b5")
  Th2HandbookHelp_L("@@@   Universal input/output interface -2")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.21  Universal I/O interface_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-521-universal-io-interface_", 651)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Two I/O ports of PSG are used as shown in [[[Figure 5.22|||Chapter5a#figure-522-a--functions-of-psg-port-a]]].")
  Th2HandbookHelp_Commit("5.1 Functions of the Ports", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#51-functions-of-the-ports", 652)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Port A (PSG#14)")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@| b7  |  .  | b5  : b4  : b3  : b2  : b1  : b0  |")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@   |           |     |     |     |     |     |                 --+")
  Th2HandbookHelp_L("@@@   |           |     |     |     |     |     +--> 1st terminal   | connected")
  Th2HandbookHelp_L("@@@   |           |     |     |     |     +--------> 2nd terminal   |    to")
  Th2HandbookHelp_L("@@@   |           |     |     |     +--------------> 3rd terminal   | universal")
  Th2HandbookHelp_L("@@@   |           |     |     +--------------------> 4th terminal   |    I/O")
  Th2HandbookHelp_L("@@@   |           |     +--------------------------> 6th terminal   | interface")
  Th2HandbookHelp_L("@@@   |           +--------------------------------> 7th terminal   |")
  Th2HandbookHelp_L("@@@   |                                                           --+")
  Th2HandbookHelp_L("@@@   +-----------------------------------> Data input from the cassette tape")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.22 (A)  Functions of PSG port A_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-522-a-functions-of-psg-port-a_", 653)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Port B (PSG#15)")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@| b7  | b6  | b5  | b4  | b3  | b2  | b1  | b0  |")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@   |     |     |     |     |     |     |     |")
  Th2HandbookHelp_L("@@@   |     |     |     |     +-----+-----+-----+--> Unused")
  Th2HandbookHelp_L("@@@   |     |     |     |")
  Th2HandbookHelp_L("@@@   |     |     |     +---> Connected to 8th terminal of univ. I/O interface 1")
  Th2HandbookHelp_L("@@@   |     |     +---------> Connected to 8th terminal of univ. I/O interface 2")
  Th2HandbookHelp_L("@@@   |     |")
  Th2HandbookHelp_L("@@@   |     +---> 0: b0-b5 of port A to be connected to univ. I/O interface 1")
  Th2HandbookHelp_L("@@@   |           1: b0-b5 of port A to be connected to univ. I/O interface 2")
  Th2HandbookHelp_L("@@@   |")
  Th2HandbookHelp_L("@@@   +---------> 0: Arabic or kana mode display lamp on")
  Th2HandbookHelp_L("@@@               1: Arabic or kana mode display lamp off")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.22 (B)  Functions of PSG port B_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-522-b-functions-of-psg-port-b_", 654)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Figure 5.23 shows the joystick circuit. As the circuit shows, sending " + Chr(34) + "0" + Chr(34) + " to the 8th terminal and reading the 1st to 4th and 6th to 7th terminals enable information about the stick and the trigger buttons to be obtained. However, it is advisable to use BIOS for accessing the joystick, in order to give portability to the program.")
  Th2HandbookHelp_Commit("5.2 Joystick Use", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#52-joystick-use", 655)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                          \")
  Th2HandbookHelp_L("@@@(1)     O---------------o  o------------+ ............. Front")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                          \             |")
  Th2HandbookHelp_L("@@@(2)     O---------------o  o------------+ ............. Back")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                          \             |")
  Th2HandbookHelp_L("@@@(3)     O---------------o  o------------+ ............. Left")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                          \             |")
  Th2HandbookHelp_L("@@@(4)     O---------------o  o------------+ ............. Right")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                          \             |")
  Th2HandbookHelp_L("@@@(6)     O---------------o  o------------+ ............. Trigger A")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                          \             |")
  Th2HandbookHelp_L("@@@(7)     O---------------o  o------------+ ............. Trigger B")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@(8)     O-------------------------------+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The following BIOS routines are offered for accessing the joystick. These routines have similar functions to the STICK function and STRIG function of BASIC. The status of the cursor keys or the space bar, in addition to the joystick, can be read in real time.")
  Th2HandbookHelp_Commit("_Figure 5.23  Joystick circuit_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-523-joystick-circuit_", 656)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A ⟵ joystick number (0 = cursor key, 1 and 2 = joystick)")
  Th2HandbookHelp_L("* **Output**: A ⟵ direction of joystick or cursor key")
  Th2HandbookHelp_L("* **Function**: returns the current status of the joystick or the cursor keys in the A register. The value is the same as the STICK function in BASIC.")
  Th2HandbookHelp_Commit("GTSTCK (00D5H/MAIN) - read joystick", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#gtstck-00d5hmain---read-joystick", 657)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A ⟵ trigger button number (0 = space bar, 1 and 2 = trigger button A, 3 and 4 = trigger button B)")
  Th2HandbookHelp_L("* **Output**: A ⟵ status of trigger button or space bar (0FFH = pressed, 00H = released)")
  Th2HandbookHelp_L("* **Function**: returns the current status of the trigger buttons or the space bar in the A register. The value is 0FFH when the trigger is pressed, otherwise it is 0.")
  Th2HandbookHelp_Commit("GTTRIG (00D8H/MAIN) - read trigger button", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#gttrig-00d8hmain---read-trigger-button", 658)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@; List 5.7  Joystick and trigger access")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHPUT   EQU     00A2H")
  Th2HandbookHelp_L("@@@BREAKX  EQU     00B7H")
  Th2HandbookHelp_L("@@@GTSTCK  EQU     00D5H")
  Th2HandbookHelp_L("@@@GTTRIG  EQU     00D8H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0D00H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----      Note: display joystick status")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@STICK:  LD      A,1             ;choose joystick 1")
  Th2HandbookHelp_L("@@@        CALL    GTSTCK          ;read joystick status")
  Th2HandbookHelp_L("@@@        LD      (WK1),A")
  Th2HandbookHelp_L("@@@        LD      A,1             ;choose joystick 1")
  Th2HandbookHelp_L("@@@        CALL    GTTRIG          ;read trigger status")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        JR      Z,STCK1")
  Th2HandbookHelp_L("@@@        LD      HL,WDON         ;trigger ON")
  Th2HandbookHelp_L("@@@        JR      STCK2")
  Th2HandbookHelp_L("@@@STCK1:  LD      HL,WDOFF        ;trigger OFF")
  Th2HandbookHelp_L("@@@STCK2:  CALL    PUTSTR")
  Th2HandbookHelp_L("@@@        LD      A,(WK1)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        JR      Z,BRKCH0        ;do not use joystick")
  Th2HandbookHelp_L("@@@        LD      C,0")
  Th2HandbookHelp_L("@@@STCK3:  DEC     A")
  Th2HandbookHelp_L("@@@        JR      NZ,STCK4")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        JR      STCK3")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@STCK4:  SLA     C               ;C := C*16")
  Th2HandbookHelp_L("@@@        SLA     C")
  Th2HandbookHelp_L("@@@        SLA     C")
  Th2HandbookHelp_L("@@@        SLA     C")
  Th2HandbookHelp_L("@@@        LD      B,0             ;Accounting Strings data address")
  Th2HandbookHelp_L("@@@        LD      HL,WDSTK")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        CALL    PUTSTR")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BRKCH0: LD      A,0DH           ;put carriage return")
  Th2HandbookHelp_L("@@@        CALL    CHPUT           ;code := 0DH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BRKCHK: CALL    BREAKX          ;break check")
  Th2HandbookHelp_L("@@@        RET     C")
  Th2HandbookHelp_L("@@@        JR      STICK")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- put strings to screen -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PUTSTR: LD      A,(HL)")
  Th2HandbookHelp_L("@@@        CP      '$'")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        CALL    CHPUT")
  Th2HandbookHelp_L("@@@        JR      PUTSTR")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- string area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WDON:   DB      'Trigger ON:  $'")
  Th2HandbookHelp_L("@@@WDOFF:  DB      'Trigger OFF: $'")
  Th2HandbookHelp_L("@@@WDSTK:  DB      'UP only      ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Up and Right ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Right only   ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Right & Down ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Down only    ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Down and Left',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Left only    ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@        DB      'Left and Up  ',0DH,0AH,'$'")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WK1:    DW      0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.7  Joystick use_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-57-joystick-use_", 659)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Figure 5.24 shows the paddle circuit. Sending a pulse to the 8th terminal causes the single stable multi-vibrator to generate a pulse with a specified interval. This interval depends on the value of the variable register which can range from 10 to 3000 microseconds (0.01 to 3.00 ms). Measuring the pulse length enables the value in the variable register and the turning angle to be obtained.")
  Th2HandbookHelp_Commit("5.3 Paddle Use", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#53-paddle-use", 660)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                              --+--")
  Th2HandbookHelp_L("@@@                                |")
  Th2HandbookHelp_L("@@@                               <_")
  Th2HandbookHelp_L("@@@                                _>  150KOhm Variable Resistor")
  Th2HandbookHelp_L("@@@                               <")
  Th2HandbookHelp_L("@@@                                |")
  Th2HandbookHelp_L("@@@                      0.04 uF   |")
  Th2HandbookHelp_L("@@@                       +--| |---+")
  Th2HandbookHelp_L("@@@                       |        |")
  Th2HandbookHelp_L("@@@                    ---+--------+---")
  Th2HandbookHelp_L("@@@                    |              |")
  Th2HandbookHelp_L("@@@         |\         |              |")
  Th2HandbookHelp_L("@@@         |  \       |              |")
  Th2HandbookHelp_L("@@@(8) -----|   >O----O| A          Q |------------- (1)  (For 2, 3, 4, 6, or 7,")
  Th2HandbookHelp_L("@@@         |  /       |              |                    a similar circuit")
  Th2HandbookHelp_L("@@@         |/         |              |                    would apply)")
  Th2HandbookHelp_L("@@@                    |              |")
  Th2HandbookHelp_L("@@@                    |              |")
  Th2HandbookHelp_L("@@@         +----------| B            |")
  Th2HandbookHelp_L("@@@         |          |              |")
  Th2HandbookHelp_L("@@@         |          |              | (One-shot trigger IC, LS123 compatible)")
  Th2HandbookHelp_L("@@@         |          |              |")
  Th2HandbookHelp_L("@@@ +5V     |          ----------------")
  Th2HandbookHelp_L("@@@ --+--   |                 O")
  Th2HandbookHelp_L("@@@   |     |                 |")
  Th2HandbookHelp_L("@@@   +-----+-----------------+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                        ____")
  Th2HandbookHelp_L("@@@                        :  :")
  Th2HandbookHelp_L("@@@Input to 8      ________:  :_____________________________________")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                        _________________________________")
  Th2HandbookHelp_L("@@@                        :                               :")
  Th2HandbookHelp_L("@@@Output to 1     ________:                               :________")
  Th2HandbookHelp_L("@@@                        |<------- 10 us to 3 ms ------->|")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("BIOS routines for accessing the paddle are described below.")
  Th2HandbookHelp_Commit("_Figure 5.24  Paddle circuit_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-524-paddle-circuit_", 661)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A ⟵ paddle number (1 to 12)")
  Th2HandbookHelp_L("* **Output**: A ⟵ turning angle (0 to 255)")
  Th2HandbookHelp_L("* **Function**: examines the status of the paddle specified in the A register and returns the result in the A register.")
  Th2HandbookHelp_Commit("GTPDL (00DEH/MAIN) - read paddle information", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#gtpdl-00dehmain---read-paddle-information", 662)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The touch panel, light pen, mouse, and track ball (cat) are accessible using the same BIOS routine. This routine is described below.")
  Th2HandbookHelp_Commit("5.4 Use of Touch Panel, Light Pen, Mouse, and Track Ball", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#54-use-of-touch-panel-light-pen-mouse-and-track-ball", 663)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A ⟵ device ID (0 to 19)")
  Th2HandbookHelp_L("* **Output**: A ⟵ objective information")
  Th2HandbookHelp_L("* **Function**: obtains various information as shown in [[[Table 5.5|||Chapter5a#table-55--gtpad-bios-function]]] according to the value specified in the A register. This is the same as the PAD function of BASIC. " + Chr(34) + "XXX1" + Chr(34) + " in the table means the " + Chr(34) + "XXX" + Chr(34) + " device connected to the universal I/O interface 1; " + Chr(34) + "XXX2" + Chr(34) + " means the one connected to the universal I/O interface #2.")
  Th2HandbookHelp_Commit("GTPAD (00DBH/MAIN) - access to various I/O devices", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#gtpad-00dbhmain---access-to-various-io-devices", 664)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|  Device ID  |  Device specified  |         Information returned        |")
  Th2HandbookHelp_L("@@@--------------+--------------------+-------------------------------------|")
  Th2HandbookHelp_L("@@@|      0      |                    |  0FFH when touching panel surface,  |")
  Th2HandbookHelp_L("@@@|             |                    |  00H when not                       |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|      1      |                    |  X-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|   Touch panel 1    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|      2      |                    |  Y-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|      3      |                    |  0FFH when button is pressed,       |")
  Th2HandbookHelp_L("@@@|             |                    |  00H when not                       |")
  Th2HandbookHelp_L("@@@|-------------+--------------------+-------------------------------------|")
  Th2HandbookHelp_L("@@@|      4      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------|                    |                                     |")
  Th2HandbookHelp_L("@@@|      5      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------|   Touch panel 2    |  Same as above                      |")
  Th2HandbookHelp_L("@@@|      6      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------|                    |                                     |")
  Th2HandbookHelp_L("@@@|      7      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------+--------------------+-------------------------------------|")
  Th2HandbookHelp_L("@@@|      8      |                    |  0FFH: valid data,                  |")
  Th2HandbookHelp_L("@@@|             |                    |  00H: invalid data                  |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|      9      |                    |  X-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|   Light pen        |-------------------------------------|")
  Th2HandbookHelp_L("@@@|     10      |                    |  Y-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|     11      |                    |  0FFH when switch is pressed,       |")
  Th2HandbookHelp_L("@@@|             |                    |  00H when not                       |")
  Th2HandbookHelp_L("@@@|-------------+--------------------+-------------------------------------|")
  Th2HandbookHelp_L("@@@|     12      |                    |  Always 0FFH                        |")
  Th2HandbookHelp_L("@@@|             |                    |  (used to request for input)        |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|     13      |   Mouse 1 or       |  X-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|   track ball 1     |-------------------------------------|")
  Th2HandbookHelp_L("@@@|     14      |                    |  Y-coordinate (0 to 255)            |")
  Th2HandbookHelp_L("@@@|-------------|                    |-------------------------------------|")
  Th2HandbookHelp_L("@@@|     15      |                    |  Always 00H                         |")
  Th2HandbookHelp_L("@@@|             |                    |  (no meaning)                       |")
  Th2HandbookHelp_L("@@@|-------------+--------------------+-------------------------------------|")
  Th2HandbookHelp_L("@@@|     16      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------|                    |                                     |")
  Th2HandbookHelp_L("@@@|     17      |   Mouse 2 or       |                                     |")
  Th2HandbookHelp_L("@@@|-------------|   track ball 2     |  Same as above                      |")
  Th2HandbookHelp_L("@@@|     18      |                    |                                     |")
  Th2HandbookHelp_L("@@@|-------------|                    |                                     |")
  Th2HandbookHelp_L("@@@|     19      |                    |                                     |")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 1:** Though information of the coordinate of the light pen (A = 9, 10) and")
  Th2HandbookHelp_L("@@@    the switch (A = 11) are read at the same time when BIOS is called")
  Th2HandbookHelp_L("@@@    with A = 8, other values are valid only when the result is 0FFH.")
  Th2HandbookHelp_L("@@@    In the case that the result of BIOS which is called with A = 8 is")
  Th2HandbookHelp_L("@@@    00H, the coordinate values and the status of the switch contained")
  Th2HandbookHelp_L("@@@    after that are meaningless.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 2:** Mouse and track ball are automatically distinguished.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 3:** To obtain the coordinate value of the mouse or the track ball, do the")
  Th2HandbookHelp_L("@@@    input request call (A = 12 or A = 16), then execute the call to")
  Th2HandbookHelp_L("@@@    obtain the coordinate value actually. In this case, the interval of")
  Th2HandbookHelp_L("@@@    these two calls must be minimized as possible. Too much interval")
  Th2HandbookHelp_L("@@@    between the input request and the coordinate input causes the")
  Th2HandbookHelp_L("@@@    obtained data to be unreliable.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note 4:** To obtain the status of the trigger button of the mouse or the")
  Th2HandbookHelp_L("@@@    trigger button of the track ball, use [GTTRIG (00D8H/MAIN)](#gttrig-00d8hmain---read-trigger-button), not GTPAD")
  Th2HandbookHelp_L("@@@    routine.")
  Th2HandbookHelp_Commit("_Table 5.5  GTPAD BIOS Function_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_table-55-gtpad-bios-function_", 665)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;  List 5.8   touch pad access")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@BREAKX  EQU     00B7H")
  Th2HandbookHelp_L("@@@GTPAD   EQU     00D8H")
  Th2HandbookHelp_L("@@@WRTVRM  EQU     004DH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----      Note:  Displays " + Chr(34) + "*" + Chr(34) + " at position specified")
  Th2HandbookHelp_L("@@@                                       by touch pad.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PAD:    XOR     A               ;check sense")
  Th2HandbookHelp_L("@@@        CALL    GTPAD")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        JR      NZ,PAD1")
  Th2HandbookHelp_L("@@@        LD      A,3")
  Th2HandbookHelp_L("@@@        CALL    GTPAD           ;break check")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        RET     NZ")
  Th2HandbookHelp_L("@@@        JR      PAD")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PAD1:   LD      A,1             ;get X axis")
  Th2HandbookHelp_L("@@@        CALL    GTPAD")
  Th2HandbookHelp_L("@@@        SRL     A               ;A := A/8")
  Th2HandbookHelp_L("@@@        SRL     A")
  Th2HandbookHelp_L("@@@        SRL     A")
  Th2HandbookHelp_L("@@@        LD      (WORK),A        ;reserve X axis")
  Th2HandbookHelp_L("@@@        LD      A,2             ;get Y axis")
  Th2HandbookHelp_L("@@@        CALL    GTPAD")
  Th2HandbookHelp_L("@@@        LD      L,A             ;HL := Y data (0-255)")
  Th2HandbookHelp_L("@@@        LD      H,0")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        LD      B,0")
  Th2HandbookHelp_L("@@@        ADD     HL,BC           ;HL := HL*3 (HL := 0-767)")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        LD      A,L")
  Th2HandbookHelp_L("@@@        AND     11100000B")
  Th2HandbookHelp_L("@@@        LD      L,A")
  Th2HandbookHelp_L("@@@        LD      A,(WORK)")
  Th2HandbookHelp_L("@@@        ADD     A,L")
  Th2HandbookHelp_L("@@@        LD      L,A")
  Th2HandbookHelp_L("@@@        LD      BC,1800H        ;VRAM start address")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        LD      A,2AH")
  Th2HandbookHelp_L("@@@        CALL    WRTVRM          ;write VRAM")
  Th2HandbookHelp_L("@@@        LD      A,3")
  Th2HandbookHelp_L("@@@        CALL    GTPAD           ;break check")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        RET     NZ")
  Th2HandbookHelp_L("@@@        JR      PAD")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- work area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WORK:   DW      0               ;work")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.8  Touch panel use_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-58-touch-panel-use_", 666)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;  List 5.9   mouse and track ball access")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@GTPAD   EQU     00DBH")
  Th2HandbookHelp_L("@@@WRTVRM  EQU     004DH")
  Th2HandbookHelp_L("@@@RDVRM   EQU     004AH")
  Th2HandbookHelp_L("@@@BREAKX  EQU     00B7H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0D000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----      Note:  Displays " + Chr(34) + "*" + Chr(34) + " at position specified")
  Th2HandbookHelp_L("@@@                                       by mouse or track ball.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TEST:   CALL    VADR            ;Put old data")
  Th2HandbookHelp_L("@@@        LD      A,(WKOLD)")
  Th2HandbookHelp_L("@@@        CALL    WRTVRM")
  Th2HandbookHelp_L("@@@        LD      A,12")
  Th2HandbookHelp_L("@@@        CALL    GTPAD           ;Request mouse/track ball data")
  Th2HandbookHelp_L("@@@        LD      A,13")
  Th2HandbookHelp_L("@@@        CALL    GTPAD           ;Read X val.")
  Th2HandbookHelp_L("@@@        LD      (WKXVAL),A")
  Th2HandbookHelp_L("@@@        LD      A,14")
  Th2HandbookHelp_L("@@@        CALL    GTPAD           ;Read Y val.")
  Th2HandbookHelp_L("@@@        LD      (WKYVAL),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WKX)")
  Th2HandbookHelp_L("@@@        LD      B,A")
  Th2HandbookHelp_L("@@@        LD      A,(WKXVAL)")
  Th2HandbookHelp_L("@@@        ADD     A,B")
  Th2HandbookHelp_L("@@@        CP      245             ;X<0?")
  Th2HandbookHelp_L("@@@        JR      C,TEST01")
  Th2HandbookHelp_L("@@@        XOR     A               ;X=0")
  Th2HandbookHelp_L("@@@        JR      TEST02")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TEST01: CP      32              ;X>31?")
  Th2HandbookHelp_L("@@@        JR      C,TEST02")
  Th2HandbookHelp_L("@@@        LD      A,31")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TEST02: LD      (WKX),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WKY)")
  Th2HandbookHelp_L("@@@        LD      B,A")
  Th2HandbookHelp_L("@@@        LD      A,(WKYVAL)")
  Th2HandbookHelp_L("@@@        ADD     A,B")
  Th2HandbookHelp_L("@@@        CP      245             ;Y<0?")
  Th2HandbookHelp_L("@@@        JR      C,TEST03")
  Th2HandbookHelp_L("@@@        XOR     A               ;Y=0")
  Th2HandbookHelp_L("@@@        JR      TEST04")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TEST03: CP      24              ;Y>23?")
  Th2HandbookHelp_L("@@@        JR      C,TEST04")
  Th2HandbookHelp_L("@@@        LD      A,23")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TEST04: LD      (WKY),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    VADR")
  Th2HandbookHelp_L("@@@        CALL    RDVRM           ;Read old data")
  Th2HandbookHelp_L("@@@        LD      (WKOLD),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    VADR")
  Th2HandbookHelp_L("@@@        LD      A,2AH")
  Th2HandbookHelp_L("@@@        CALL    WRTVRM          ;Put cursor (" + Chr(34) + "*" + Chr(34) + ").")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    BREAKX          ;Break check")
  Th2HandbookHelp_L("@@@        RET     C")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    WAIT")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        JR      TEST")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@VADR:   LD      A,(WKY)         ;Make SCREEN Address:")
  Th2HandbookHelp_L("@@@        LD      H,A             ;  From X,Y axis on WORK AREA")
  Th2HandbookHelp_L("@@@        LD      L,0             ;  To Hl reg.")
  Th2HandbookHelp_L("@@@        SRL     H")
  Th2HandbookHelp_L("@@@        RR      L")
  Th2HandbookHelp_L("@@@        SRL     H")
  Th2HandbookHelp_L("@@@        RR      L")
  Th2HandbookHelp_L("@@@        SRL     H")
  Th2HandbookHelp_L("@@@        RR      L")
  Th2HandbookHelp_L("@@@        LD      A,(WKX)")
  Th2HandbookHelp_L("@@@        ADD     A,L             ;  Y=32+X")
  Th2HandbookHelp_L("@@@        LD      L,A")
  Th2HandbookHelp_L("@@@        LD      BC,1800H        ;  VRAM start address")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT:   LD      A,0             ;WAIT routine")
  Th2HandbookHelp_L("@@@WLP1:   INC     A")
  Th2HandbookHelp_L("@@@        LD      B,(IX+0)")
  Th2HandbookHelp_L("@@@        LD      B,(IX+0)")
  Th2HandbookHelp_L("@@@        LD      B,(IX+0)")
  Th2HandbookHelp_L("@@@        JR      NZ,WLP1")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- data -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WKX:    DB      10              ;X axis")
  Th2HandbookHelp_L("@@@WKY:    DB      10              ;Y axis")
  Th2HandbookHelp_L("@@@WKOLD:  DB      0               ;Character code on (X,Y)")
  Th2HandbookHelp_L("@@@WKXVAL: DB      0               ;X variable")
  Th2HandbookHelp_L("@@@WKYVAL: DB      0               ;Y variable")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.9  Mouse and track ball use_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-59-mouse-and-track-ball-use_", 667)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX2 uses a CLOCK-IC to for its timer function. Since this IC is battery-powered, it remains active even after MSX2 is turned off. MSX2 uses a small amount of RAM inside to set the PASSWORD or to set the screen mode at startup automatically, in addition to the CLOCK functions.")
  Th2HandbookHelp_Commit("6. CLOCK AND BATTERY-POWERED MEMORY", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#6-clock-and-battery-powered-memory", 668)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This IC has the following three functions:")
  Th2HandbookHelp_Commit("6.1 CLOCK-IC Functions", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#61-clock-ic-functions", 669)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- set/read the settings of " + Chr(34) + "year, month, day, day of week, hour, minute, second" + Chr(34))
  Th2HandbookHelp_L("- for the expression of time, 24-hour clock/12-hour clock available")
  Th2HandbookHelp_L("- for months, months of 31 days and of 30 days are distinguished (leap years are also recognised)")
  Th2HandbookHelp_Commit("CLOCK function", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#clock-function", 670)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- when the time for alarm is set, CLOCK generates signals at that time.")
  Th2HandbookHelp_L("- the time for alarm is set as " + Chr(34) + "XXday XXhour XXminute" + Chr(34) + ".")
  Th2HandbookHelp_Commit("Alarm function", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#alarm-function", 671)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- has 26 sets of 4-bit memory, and can be battery-powered.")
  Th2HandbookHelp_L("- MSX2 stores the following data in this memory:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. adjustment value of CRT display width and height")
  Th2HandbookHelp_L("2. initial values of SCREEN, WIDTH, colour")
  Th2HandbookHelp_L("3. BEEP tone and volume")
  Th2HandbookHelp_L("4. title screen colour")
  Th2HandbookHelp_L("5. country code")
  Th2HandbookHelp_L("6. password *")
  Th2HandbookHelp_L("7. BASIC prompt *")
  Th2HandbookHelp_L("8. title caption *")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("\* (one of 6 to 8)")
  Th2HandbookHelp_Commit("Battery-powered memory function", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#battery-powered-memory-function", 672)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The CLOCK-IC has four blocks inside as shown in [[[Figure 5.25|||Chapter5a#figure-525--clock-ic-structure]]]. Each block consists of 13 sets of 4-bit registers, which are specified by addresses from 0 to 12. In addition, it has three 4-bit registers for selecting the block or controlling functions; they are specified by the addresses from 13 to 15.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The registers inside the block (#0 to #12) and the MODE register (#13) can be read from and written to. The TEST register (#14) and RESET register (#15) can only be written to.")
  Th2HandbookHelp_Commit("6.2 Structure of the CLOCK-IC", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#62-structure-of-the-clock-ic", 673)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@       BLOCK 0            BLOCK 1            BLOCK 2            BLOCK 2")
  Th2HandbookHelp_L("@@@       (CLOCK)            (ALARM)            (RAM-1)            (RAM-2)")
  Th2HandbookHelp_L("@@@   ----------------   ----------------   ----------------   ----------------")
  Th2HandbookHelp_L("@@@   | Seconds (the |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@ 0 | 1st decimal  |   |   ________   |   |              |   |              |")
  Th2HandbookHelp_L("@@@   | place)       |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@   |--------------|   |--------------|   |-            -|   |-            -|")
  Th2HandbookHelp_L("@@@   | Seconds (the |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@ 1 | 2nd decimal  |   |   ________   |   |              |   |              |")
  Th2HandbookHelp_L("@@@   | place)       |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@   |--------------|   |--------------|   |-            -|   |-            -|")
  Th2HandbookHelp_L("@@@ . |      .       |   |      .       |   |   Any data   |   |   Any data   |")
  Th2HandbookHelp_L("@@@ . |      .       |   |      .       |   |              |   |              |")
  Th2HandbookHelp_L("@@@ . |      .       |   |      .       |   |              |   |              |")
  Th2HandbookHelp_L("@@@ . |      .       |   |      .       |   |              |   |              |")
  Th2HandbookHelp_L("@@@ . |      .       |   |      .       |   |              |   |              |")
  Th2HandbookHelp_L("@@@   |--------------|   |--------------|   |-            -|   |-            -|")
  Th2HandbookHelp_L("@@@   | Year (the    |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@ 12| 2nd decimal  |   |   ________   |   |              |   |              |")
  Th2HandbookHelp_L("@@@   | place)       |   |              |   |              |   |              |")
  Th2HandbookHelp_L("@@@   ----------------   ----------------   ----------------   ----------------")
  Th2HandbookHelp_L("@@@   :<-- 4 bits -->:   :<-- 4 bits -->:   :<-- 4 bits -->:   :<-- 4 bits -->:")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@   ----------------")
  Th2HandbookHelp_L("@@@13 |     MODE     |")
  Th2HandbookHelp_L("@@@   |--------------| --+")
  Th2HandbookHelp_L("@@@14 |     TEST     |   |")
  Th2HandbookHelp_L("@@@   |--------------|   |-- Write only")
  Th2HandbookHelp_L("@@@15 |     RESET    |   |")
  Th2HandbookHelp_L("@@@   ---------------- --+")
  Th2HandbookHelp_L("@@@   :<-- 4 bits -->:")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.25  Clock IC structure_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-525-clock-ic-structure_", 674)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MODE register has the following 3 functions:")
  Th2HandbookHelp_Commit("6.3 MODE Register Functions", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#63-mode-register-functions", 675)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To read from or write to registers from #0 to #12, select the block to be used and then access the objective address. The 2 low order bits of the MODE register are used to select the block.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Registers from #13 to #15 are accessible whichever block is selected.")
  Th2HandbookHelp_Commit("Selecting block", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#selecting-block", 676)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To switch the alarm input ON/OFF, use bit 2 of the MODE register. Since the standard MSX2 does not support the alarm, modifying this bit causes nothing to happen in general.")
  Th2HandbookHelp_Commit("Alarm output ON/OFF", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#alarm-output-onoff", 677)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("By writing " + Chr(34) + "0" + Chr(34) + " in bit 3 of the MODE register, the count in seconds is stopped (the stages before the seconds are not stopped) and the clock function is terminated. By writing " + Chr(34) + "1" + Chr(34) + " in bit 3, the count is resumed.")
  Th2HandbookHelp_Commit("Terminating CLOCK count", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#terminating-clock-count", 678)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@| TE | AE | M1 : M0 |  MODE register (#13)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@  |    |       |       00: select block 0")
  Th2HandbookHelp_L("@@@  |    |       |       01: select block 1")
  Th2HandbookHelp_L("@@@  |    |       +---->  10: select block 2")
  Th2HandbookHelp_L("@@@  |    |               11: select block 3")
  Th2HandbookHelp_L("@@@  |    |")
  Th2HandbookHelp_L("@@@  |    +------------>  0:  alarm output OFF")
  Th2HandbookHelp_L("@@@  |                    1:  alarm output ON")
  Th2HandbookHelp_L("@@@  |")
  Th2HandbookHelp_L("@@@  +----------------->  0:  CLOCK count stop (in seconds)")
  Th2HandbookHelp_L("@@@                       1:  CLOCK count start")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.26  MODE register functions_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-526-mode-register-functions_", 679)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The TEST register (#14) is used to increment the upper counter quickly and to confirm that date and time carries are done correctly. Setting " + Chr(34) + "1" + Chr(34) + " in each bit of the register, the pulse of 2^14 (=16384)[Hz] is directly set in day, hour, minute, and second counters.")
  Th2HandbookHelp_Commit("6.4 TEST Register functions", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#64-test-register-functions", 680)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@| T3 | T2 | T1 | T0 |  TEST register (#14)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@  |    |    |    |")
  Th2HandbookHelp_L("@@@  |  Hours  |  Seconds ........ the location for the pulse to be placed")
  Th2HandbookHelp_L("@@@ Day      Minutes")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.27  TEST register functions_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-527-test-register-functions_", 681)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The RESET register (#15) has the following functions:")
  Th2HandbookHelp_Commit("6.5 RESET Register Functions", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#65-reset-register-functions", 682)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 0 causes all alarm registers to be reset to 0.")
  Th2HandbookHelp_Commit("Resetting the alarm", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#resetting-the-alarm", 683)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 1 causes the stage before the seconds to be reset. Use this function to set the seconds correctly.")
  Th2HandbookHelp_Commit("Setting the seconds", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#setting-the-seconds", 684)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Setting " + Chr(34) + "1" + Chr(34) + " in bit 2 turns the 16Hz clock pulse output ON, and setting " + Chr(34) + "0" + Chr(34) + " in bit 3 turns the 1Hz clock pulse output ON. Note that both are not supported by the MSX2 standard.")
  Th2HandbookHelp_Commit("Clock pulse ON/OFF", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#clock-pulse-onoff", 685)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  B3   B2   B1   B0")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@| C1 | C16| CR | AR |  RESET register (#15)")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@  |    |    |    |")
  Th2HandbookHelp_L("@@@  |    |    |    +-->  When " + Chr(34) + "1" + Chr(34) + ", all alarm registers are reset")
  Th2HandbookHelp_L("@@@  |    |    +------->  When " + Chr(34) + "1" + Chr(34) + ", fractions smaller than a second are reset")
  Th2HandbookHelp_L("@@@  |    +------------>  When " + Chr(34) + "0" + Chr(34) + ", 16[Hz] clock pulse is ON")
  Th2HandbookHelp_L("@@@  +----------------->  When " + Chr(34) + "0" + Chr(34) + ", 1[Hz] clock pulse is ON")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.28  RESET register function_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-528-reset-register-function_", 686)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Block 0 is used to set the clock. Selecting block 0 in the MODE register and writing data in the objective register causes the date and the time to be set. The current time is acquired by reading the contents of the register. See [[[Figure 5.29|||Chapter5a#figure-529--setting-the-clock-and-alarm]]] for the meaning of the register and its address.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Block 1 is used to set the alarm. Note that the time of the alarm can be set only in days, hours, and minutes. Nothing happens, in general, when the time of the clock meets the time of the alarm.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In the clock, the year is represented by 2 digits (registers #11 and #12). In MSX-BASIC, the 2 low order digits of the year is represented by adding the offset 80 to this value. For example, after setting register #11 to 0 and register #12 to 0, the year would be 80, as " + Chr(34) + "80/XX/XX" + Chr(34) + ", when the date is read by using the GET DATE instruction of BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The day of the week is represented by 0 to 6. This is only a mod 7 counter which is renewed alomg with the date, and the correspondence between the actual day of the week and the number value 0 to 6 is not defined.")
  Th2HandbookHelp_Commit("Setting date and time", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#setting-date-and-time", 687)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                       block 0 : CLOCK")
  Th2HandbookHelp_L("@@@   ---------------------------------------------------------")
  Th2HandbookHelp_L("@@@   |                           |  B3  |  B2  |  B1  |  B0  |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
