  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`NAME " + Chr(34) + "<filename 1>" + Chr(34) + " AS " + Chr(34) + "<filename 2>" + Chr(34) + "`  |  Command  |  Renames the name of a file.")
  Th2HandbookHelp_Commit("--- N ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#n-1", 68)

  Th2HandbookHelp_Begin()
