  Th2HandbookHelp_AddAnchor("Appendix1#calpat-0084h-1", 799)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the address of the sprite attribute table")
  Th2HandbookHelp_L("* **Input**: A for the sprite number")
  Th2HandbookHelp_L("* **Output**: HL for the address")
  Th2HandbookHelp_L("* **Registers**: AF, DE, HL")
  Th2HandbookHelp_Commit("CALATR (0087H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#calatr-0087h-1", 800)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the current sprite size")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: A for the sprite size (in bytes). Only when the size is 16 x 16, the CY flag is set; otherwise the CY flag is reset.")
