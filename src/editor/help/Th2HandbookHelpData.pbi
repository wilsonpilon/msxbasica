  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`PRINT #<filenumber>, [<expression>[{; \  |  ,}<expression>...]]`  |  Statement  |  Sends data to the sequential file.")
  Th2HandbookHelp_L("`PRINT #<filenumber>, USING <form>; <expression>[{; \  |  ,}<expression>...]]`  |  Statement  |  Sends data to the sequential file according to the form.")
