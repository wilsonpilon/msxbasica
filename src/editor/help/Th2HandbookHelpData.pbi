  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("A great deal of functions in MSX BASIC version 2.0 have been added or modified when compared with MSX BASIC version 1.0. They are either the functions that are added or modified with the version-up of VDP (Video Display Processor) or the functions that are added or modified because of the various hardware features such as RAM disk, clock, or memory switch; especially, the alternation of VDP affects, most of the statement for the screen display.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This section picks up these statements and indicates the additions or the modifications. In the following descriptions, " + Chr(34) + "MSX1" + Chr(34) + " means MSX BASIC version 1.0 and " + Chr(34) + "MSX2" + Chr(34) + " for MSX BASIC version 2.0.")
  Th2HandbookHelp_Commit("2. DIFFERENCES IN MSX BASIC VERSION 2.0", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#2-differences-in-msx-basic-version-20", 74)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `SCREEN [, [, [, [, [, ]]]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` and `` have been modified.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` may be specified from 0 to 8. Modes from 0 to 3 are the same as MSX1 and the rest have been added. When specifying a screen mode, in BASIC it is called " + Chr(34) + "SCREEN MODE" + Chr(34) + ", which is somewhat different from " + Chr(34) + "screen mode" + Chr(34) + " which is used by VDP internally. [[[Table 2.1|||Chapter2#table-21--correspondances-of-basic-screen-screen-modes-and-vdp-screen-modes]]] shows these correspondences and meanings. The difference between screen modes 2 and 4 is only in the sprite display functions.")
  Th2HandbookHelp_Commit("2.1 Additions or Modifications to Screen Mode", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#21-additions-or-modifications-to-screen-mode", 75)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|              |             |                   Meaning                    |")
  Th2HandbookHelp_L("@@@|     BASIC    |    VDP      |----------------------------------------------|")
  Th2HandbookHelp_L("@@@|     mode     |    mode     |    Dots or     | Display colours |   Screen  |")
  Th2HandbookHelp_L("@@@|              |             |   characters   | at a time       |   format  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 0 (1) | TEXT 1      |  40 x 24 chars |    2 from 512   | Text      |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 0 (2) | TEXT 2      |  80 x 24 chars |    2 from 512   | Text      |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 1     | GRAPHIC 1   |  32 x 24 chars |   16 from 512   | Text      |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 2     | GRAPHIC 2   | 256 x 192 dots |   16 from 512   | High res. |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 3     | MULTICOLOUR |  64 x  48 dots |   16 from 512   | Low res.  |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 4     | GRAPHIC 3   | 256 x 192 dots |   16 from 512   | High res. |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 5     | GRAPHIC 4   | 256 x 212 dots |   16 from 512   | Bit map   |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 6     | GRAPHIC 5   | 512 x 212 dots |    4 from 512   | Bit map   |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 7     | GRAPHIC 6   | 512 x 212 dots |   16 from 512   | Bit map   |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@|--------------+-------------+----------------+-----------------+-----------|")
  Th2HandbookHelp_L("@@@| SCREEN 8     | GRAPHIC 7   | 256 x 212 dots |   256           | Bit map   |")
  Th2HandbookHelp_L("@@@|              |             |                |                 | graphics  |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Specifying `` enables to set the interlace functions of VDP (see [[[Table 2.2|||Chapter2#table-22--differences-of-display-function-in-the-interlace-mode]]]). In the alternate screen display mode, the display page specified in " + Chr(34) + "SET PAGE" + Chr(34) + " must be odd. In this case the display page and the page of which the number is smaller by one is displayed alternately.")
  Th2HandbookHelp_Commit("_Table 2.1  Correspondances of BASIC screen (SCREEN) modes and VDP screen modes_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-21-correspondances-of-basic-screen-screen-modes-and-vdp-screen-modes_", 76)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|  Interlace mode  |             Display function               |")
  Th2HandbookHelp_L("@@@|------------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@|        0         | Normal non-interlaced display (default)    |")
  Th2HandbookHelp_L("@@@|        1         | Interlaced display                         |")
  Th2HandbookHelp_L("@@@|        2         | Non interlaced, Even/Odd alternate display |")
  Th2HandbookHelp_L("@@@|        3         | Interlaced, Even/Odd alternate display     |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET PAGE , `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement is new. It allows users to set the page to display and the page to read and write data to. This is valid when the screen mode is between 5 and 8, and the value specified depends on the VRAM capacity and the screen mode (see [[[Table 2.3|||Chapter2#table-23--page-values-to-be-specified-depending-on-the-screen-mode-and-the-vram-capacity]]]).")
  Th2HandbookHelp_Commit("_Table 2.2  Differences of display function in the interlace mode_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-22-differences-of-display-function-in-the-interlace-mode_", 77)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------------------------------------------")
  Th2HandbookHelp_L("@@@| Screen mode |  VRAM 64K  |  VRAM 128K  |")
  Th2HandbookHelp_L("@@@|-------------+------------+-------------|")
  Th2HandbookHelp_L("@@@|  SCREEN 5   |   0 to 1   |   0 to 3    |")
  Th2HandbookHelp_L("@@@|  SCREEN 6   |   0 to 1   |   0 to 3    |")
  Th2HandbookHelp_L("@@@|  SCREEN 7   |  Unusable  |   0 to 1    |")
  Th2HandbookHelp_L("@@@|  SCREEN 8   |  Unusable  |   0 to 1    |")
  Th2HandbookHelp_L("@@@------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("See the [VRAM map](Appendix5.md) in the APPENDIX for the page assignment on VRAM.")
  Th2HandbookHelp_Commit("Table 2.3  Page values to be specified depending on the screen mode and the VRAM capacity", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#table-23-page-values-to-be-specified-depending-on-the-screen-mode-and-the-vram-capacity", 78)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `COLOR [[, [, ]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In MSX2, with its colour palette feature, the ranges and meanings of values specifying colours in the screen mode are different (see [[[Table 2.4|||Chapter2#table-24--colour-specifications-for-the-screen-mode]]]). The `` except that of the text display changes when the CLS statement is executed. If the display mode is 0, specification of a `` is ignored.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The " + Chr(34) + "border colour" + Chr(34) + " in screen mode 6 has special meanings. [[[Figure 2.2|||Chapter2#figure-22--bitwise-meanings-for-the-border-colour-on-screen-mode-6]]] shows the bitwise meanings of `` in the mode. In this mode, by changing the flag (bit 4), the colour of vertical lines at odd X-coordinates and the colour of those at even coordinates can be specified differently.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the flag is 0 (the value of border colour is one of the values from 0 to 15), different colours cannot be specified and the border colour is set as the colour of vertical odd lines. When the flag is 1 (the value of border colour is one of the values from 16 to 31), the border colours are set as the colour of vertical odd lines and that of vertical even lines; when these two colours are different, the screen shows a vertically-striped pattern.")
  Th2HandbookHelp_Commit("2.2 Additions or Modifications for the Colour Specification", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#22-additions-or-modifications-for-the-colour-specification", 79)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.2]|||img:figure_2.2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COLOR = (, , , )`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets the colour of the specified palette. See [[[Table 2.4|||Chapter2#table-24--colour-specifications-for-the-screen-mode]]] for the specification of ``. Note that nothing happens and no error occurs wwhen the screen mode is 8, which has no palette feature. Though palette number 0 is ordinally fixed to a transparent colour (that is, border space is seen transparently), it can be dealt in the same way as other palettes by changing the register of VDP:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    VDP(9)=VDP(9) OR &H20        (when dealing as with other palettes)")
  Th2HandbookHelp_L("@@@    VDP(9)=VDP(9) AND &HDF       (when fixing it to a transparent colour)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 2.2  Bitwise meanings for the border colour on screen mode 6_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-22-bitwise-meanings-for-the-border-colour-on-screen-mode-6_", 80)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Screen mode | Colour specification | Range of number |")
  Th2HandbookHelp_L("@@@|-------------+----------------------+-----------------|")
  Th2HandbookHelp_L("@@@|  SCREEN 0   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 1   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 2   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 3   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 4   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 5   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 6   |    Palette number    |     0 to 3      |")
  Th2HandbookHelp_L("@@@|  SCREEN 7   |    Palette number    |     0 to 15     |")
  Th2HandbookHelp_L("@@@|  SCREEN 8   |    Colour number     |     0 to 255    |")
  Th2HandbookHelp_L("@@@--------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Brightness of each colour can be set to one of eight steps from 0 to 7 and combinig them enables to display 512 colours; 8 (red) x 8 (green) x 8 (blue).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COLOR=RESTORE`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement resets the colour palette register according to the contents of the colour palette storage table (see APPENDIX [VRAM MAP](Appendix5.md)). For example, if image data written under unusual colour palette settings is BSAVEd, the original images cannot be reproduced because BLOADing the data does not change the colour palettes. Therefore, the image data should be BSAVEd with the colour palette storage table. To obtain the colours of the original images, BLOAD the data and reset the palettes with the COLOR=RESTORE instruction.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COLOR [=NEW]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement initialises the colour palette to the same state as when the power of the computer is turned on (see [[[Table 2.5|||Chapter2#table-25--initial-colours-of-colour-palettes-and-palette-setting-values]]]). It is a good idea to place this statement at the beginning and the end of the program.")
  Th2HandbookHelp_Commit("_Table 2.4  Colour specifications for the screen mode._", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-24-colour-specifications-for-the-screen-mode_", 81)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Palette |    Colour     | Brightness | Brightness | Brightness |")
  Th2HandbookHelp_L("@@@| number  |               |  of red    |   of blue  |  of green  |")
  Th2HandbookHelp_L("@@@|---------+---------------+------------+------------+------------|")
  Th2HandbookHelp_L("@@@|    0    | transparent   |     0      |     0      |     0      |")
  Th2HandbookHelp_L("@@@|    1    | black         |     0      |     0      |     0      |")
  Th2HandbookHelp_L("@@@|    2    | bright green  |     1      |     1      |     6      |")
  Th2HandbookHelp_L("@@@|    3    | light green   |     3      |     3      |     7      |")
  Th2HandbookHelp_L("@@@|    4    | deep blue     |     1      |     7      |     1      |")
  Th2HandbookHelp_L("@@@|    5    | bright blue   |     2      |     7      |     3      |")
  Th2HandbookHelp_L("@@@|    6    | deep red      |     5      |     1      |     1      |")
  Th2HandbookHelp_L("@@@|    7    | light blue    |     2      |     7      |     6      |")
  Th2HandbookHelp_L("@@@|    8    | bright red    |     7      |     1      |     1      |")
  Th2HandbookHelp_L("@@@|    9    | light red     |     7      |     3      |     3      |")
  Th2HandbookHelp_L("@@@|   10    | bright yellow |     6      |     1      |     6      |")
  Th2HandbookHelp_L("@@@|   11    | pale yellow   |     6      |     3      |     6      |")
  Th2HandbookHelp_L("@@@|   12    | deep green    |     1      |     1      |     4      |")
  Th2HandbookHelp_L("@@@|   13    | purple        |     6      |     5      |     2      |")
  Th2HandbookHelp_L("@@@|   14    | grey          |     5      |     5      |     5      |")
  Th2HandbookHelp_L("@@@|   15    | white         |     7      |     7      |     7      |")
  Th2HandbookHelp_L("@@@------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.5  Initial colours of colour palettes and palette setting values_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-25-initial-colours-of-colour-palettes-and-palette-setting-values_", 82)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `LOCATE [[, [, ]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement specifies the location to display a character in the text display screen.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since an 80-character display feature has been added to the screen mode 0, the X-coordinate value can be specified up to 79.")
  Th2HandbookHelp_Commit("2.3 Additions or Modifications for the Character Display", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#23-additions-or-modifications-for-the-character-display", 83)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `LINE [{(X1,Y1) | STEP(X1,Y1)}] - {(X2,Y2) | STEP(X2,Y2)}[,  [, {B|BF}[, ]]]`")
  Th2HandbookHelp_L("* `PSET {(X,Y) | STEP(X,Y)}[, [, ]]`")
  Th2HandbookHelp_L("* `PRESET {(X,Y) | STEP(X,Y)}[, [, ]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The specifiable coordinate range of these statements varies according to the screen mode (see [[[Table 2.6|||Chapter2#table-26--range-of-coordinates-for-each-screen-mode]]]).")
  Th2HandbookHelp_Commit("2.4 Additions or Modifications for the Graphics Display", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#24-additions-or-modifications-for-the-graphics-display", 84)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@| Screen mode |  X-coordinate  |  Y-coordinate  |")
  Th2HandbookHelp_L("@@@|-------------+----------------+----------------|")
  Th2HandbookHelp_L("@@@|  SCREEN 2   |    0 to 255    |    0 to 191    |")
  Th2HandbookHelp_L("@@@|  SCREEN 3   |    0 to 255    |    0 to 191    |")
  Th2HandbookHelp_L("@@@|  SCREEN 4   |    0 to 255    |    0 to 191    |")
  Th2HandbookHelp_L("@@@|  SCREEN 5   |    0 to 255    |    0 to 211    |")
  Th2HandbookHelp_L("@@@|  SCREEN 6   |    0 to 511    |    0 to 211    |")
  Th2HandbookHelp_L("@@@|  SCREEN 7   |    0 to 511    |    0 to 211    |")
  Th2HandbookHelp_L("@@@|  SCREEN 8   |    0 to 255    |    0 to 211    |")
  Th2HandbookHelp_L("@@@-------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The logical operation feature is new. When `` is specified, a logical operation is done between the specified `` and the original colour, and the colour of its result will be used to draw. Logical operation types are listed in [[[Table 2.7|||Chapter2#table-27--logical-operation]]]. `` is specified by the palette number, except for screen mode 8.")
  Th2HandbookHelp_Commit("_Table 2.6  Range of coordinates for each screen mode_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-26-range-of-coordinates-for-each-screen-mode_", 85)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|    Logical operation    |               Function to draw                  |")
  Th2HandbookHelp_L("@@@|-------------------------+-------------------------------------------------|")
  Th2HandbookHelp_L("@@@| PSET (default) ,TPSET   | Use " + Chr(34) + "specified colour" + Chr(34) + "                          |")
  Th2HandbookHelp_L("@@@| PRESET         ,TPRESET | Use " + Chr(34) + "NOT (specified colour)" + Chr(34) + "                    |")
  Th2HandbookHelp_L("@@@| XOR            ,TXOR    | Use " + Chr(34) + "(background colour) XOR (specified colour)" + Chr(34) + "|")
  Th2HandbookHelp_L("@@@| OR             ,TOR     | Use " + Chr(34) + "(background colour) OR (specified colour)" + Chr(34) + " |")
  Th2HandbookHelp_L("@@@| AND            ,AND     | Use " + Chr(34) + "(background colour) AND (specified colour)" + Chr(34) + "|")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** The list above assumes that `` is (specified colour) and that the original colour of the place to be drawn is (background colour). Specifying a logical operation preceded by " + Chr(34) + "T" + Chr(34) + " causes nothing to be done when `` is transparent (colour 0).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `CIRCLE {(X,Y) | STEP(X,Y)},[, [, [, [, ]]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The coordinate range to be specified depends on the screen mode (see [[[Table 2.6|||Chapter2#table-26--range-of-coordinates-for-each-screen-mode]]]). `` is specified by the palette number, except for screen mode 8.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `PAINT {(X,Y) | STEP(X,Y)}[, [, ]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The coordinate range to be specified depends on the screen mode (see [[[Table 2.6|||Chapter2#table-26--range-of-coordinates-for-each-screen-mode]]]). `` is specified by the palette number, except for screen mode 8. The specification of `` is invalid in screen modes 2 and 4.")
  Th2HandbookHelp_Commit("_Table 2.7  Logical operation_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-27-logical-operation_", 86)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `BASE ()`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This system variable contains the starting address of each table assigned to VRAM. The contents of `` and the screen mode tables correspond as listed in [[[Table 2.8|||Chapter2#table-28--correspondences-between-base-set-values-and-vram-table]]].")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The starting address of the table can be read for each ``, but can be written only when `` is a value from 0 to 19 (that is, from screen mode 0 to screen mode 3).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Note that the table of screen mode 4 changes as you change the table address of screen mode 2.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Address returned for screen mode from 5 to 8 is the offset value from the starting address of the active page.")
  Th2HandbookHelp_Commit("2.5  Additions or modifications for VDP access", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#25-additions-or-modifications-for-vdp-access", 87)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Expression | Screen mode |         Table           |")
  Th2HandbookHelp_L("@@@|------------+-------------+-------------------------|")
  Th2HandbookHelp_L("@@@|     0      |      0      | Pattern name table      |")
  Th2HandbookHelp_L("@@@|     1      |      0      | N/A                     |")
  Th2HandbookHelp_L("@@@|     2      |      0      | Pattern generator table |")
  Th2HandbookHelp_L("@@@|     3      |      0      | N/A                     |")
  Th2HandbookHelp_L("@@@|     4      |      0      | N/A                     |")
  Th2HandbookHelp_L("@@@|     5      |      1      | Pattern name table      |")
  Th2HandbookHelp_L("@@@|     6      |      1      | Colour table            |")
  Th2HandbookHelp_L("@@@|     7      |      1      | Pattern generator table |")
  Th2HandbookHelp_L("@@@|     8      |      1      | Sprite attribute table  |")
  Th2HandbookHelp_L("@@@|     9      |      1      | Sprite generator table  |")
  Th2HandbookHelp_L("@@@|    10      |      2      | Pattern name table      |")
  Th2HandbookHelp_L("@@@|    11      |      2      | Colour table            |")
  Th2HandbookHelp_L("@@@|    12      |      2      | Pattern generator table |")
  Th2HandbookHelp_L("@@@|     .      |      .      |            .            |")
  Th2HandbookHelp_L("@@@      .             .                   .")
  Th2HandbookHelp_L("@@@      .             .                   .")
  Th2HandbookHelp_L("@@@|            |             |                         |")
  Th2HandbookHelp_L("@@@|    43      |      8      | Sprite attribute table  |")
  Th2HandbookHelp_L("@@@|    44      |      8      | Sprite generator table  |")
  Th2HandbookHelp_L("@@@------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `VDP ()`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This allows the value of VDP register to be read and written. `` is slightly different from the actual VDP register number. Their correspondances are listed in [[[Table 2.9|||Chapter2#table-29--correspondances-with-vdp-register]]].")
  Th2HandbookHelp_Commit("_Table 2.8  Correspondences between BASE set values and VRAM table_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-28-correspondences-between-base-set-values-and-vram-table_", 88)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|    n     |  VDP register number   | Access mode |")
  Th2HandbookHelp_L("@@@|----------+------------------------+-------------|")
  Th2HandbookHelp_L("@@@|  0 to 7  | 0 to 7 (same as MSX1)  | Read/write  |")
  Th2HandbookHelp_L("@@@|    8     |   Status register 0    | Read only   |")
  Th2HandbookHelp_L("@@@|  9 to 24 |        8 to 23         | Read/write  |")
  Th2HandbookHelp_L("@@@| 33 to 47 |       32 to 46         | Write only  |")
  Th2HandbookHelp_L("@@@| -1 to -9 | Status register 1 to 9 | Read only   |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `VPEEK ()`")
  Th2HandbookHelp_L("* `VPOKE , `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the screen mode is from 5 to 8, the offset value from the starting address of the active page should be set for ``. Valid range for the `` value is from 0 to 65535 and the valid range for the data value is from 0 to 255.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `BSAVE , , , S`")
  Th2HandbookHelp_L("* `BLOAD  ,S`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("These are statements of DISK BASIC, used to save/load the contents of VRAM to/from disk files. Both can be used in any screen mode, note, however, that only the active pages are valid when the screen mode is from 5 to 8. No cassette tapes can be used. Valid value range of `` is from -32768 to -2, or from 0 to 65534 (&HFFFE).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COPY (X1,Y1) - (X2,Y2)[, ] TO (X3,Y3)[,  [, ]]`")
  Th2HandbookHelp_L("* `COPY (X1,Y1) - (X2,Y2)[, ] TO { | }`")
  Th2HandbookHelp_L("* `COPY { | }[, ] TO (X3,Y3)[, [, ]]`")
  Th2HandbookHelp_L("* `COPY  TO `")
  Th2HandbookHelp_L("* `COPY  TO `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The COPY statements transfer screen data and are valid when the screen mode is from 5 to 8. VRAM, array variables, and disk files can be used with these statements, and data can be transferred among these at will.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(X1,Y1) - (X2,Y2) means that the rectangular area, with a diagonal formed by these two coordinates is to be transferred. `` and `` indicate the page to be transferred from and the page to be transferred to, respectively, and if these pages are omitted, the active pages are assumed. `` indicates the direction for writing the screen data to the screen, and is specified by a number from 0 to 3 (see [[[Figure 2.3|||Chapter2#figure-23--directions-for-writing-the-screen-data]]]).")
  Th2HandbookHelp_Commit("_Table 2.9  Correspondances with VDP register_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-29-correspondances-with-vdp-register_", 89)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.3]|||img:figure_2.3]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` is of the integer type, or single precision real type, or double precision real type. It should be prepared with enough area to get the screen data. Its size can be calculated by [[[Expression 1|||Chapter2#expression-1]]] as shown below. `` is the number of bits to be used to express one dot on the screen. It is 4 when the screen mode is 5 or 7, 2 for mode 6, and 8 for mode 8. Screen data is stored in the format shown in [[[Figure 2.4|||Chapter2#figure-24--screen-data-format]]].")
  Th2HandbookHelp_Commit("_Figure 2.3  Directions for writing the screen data_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-23-directions-for-writing-the-screen-data_", 90)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INT ((<pixel size>*(ABS(X2-X1)+1)*(ABS(Y2-Y1)+1)+7)/8)+4 bytes")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Expression 1_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_expression-1_", 91)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------------------------------------")
  Th2HandbookHelp_L("@@@| horizontal width low-order byte  | 0")
  Th2HandbookHelp_L("@@@|----------------------------------|")
  Th2HandbookHelp_L("@@@| horizontal width high-order byte | 1")
  Th2HandbookHelp_L("@@@|----------------------------------|")
  Th2HandbookHelp_L("@@@| vertical height low-order byte   | 2")
  Th2HandbookHelp_L("@@@|----------------------------------|")
  Th2HandbookHelp_L("@@@| vertical height high-order byte  | 3")
  Th2HandbookHelp_L("@@@|----------------------------------|")
  Th2HandbookHelp_L("@@@|                                  | 4")
  Th2HandbookHelp_L("@@@|                                  | .")
  Th2HandbookHelp_L("@@@|      screen data (*)             | .")
  Th2HandbookHelp_L("@@@|                                  | .")
  Th2HandbookHelp_L("@@@|                                  | n bytes")
  Th2HandbookHelp_L("@@@------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@(*) If the length of data cannot be divided by byte, excess bits are to be 0.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` specifies a logical operation between the data which resides on the destination and the data to be transferred. See [Table 2.7]((#table-27--logical-operation)) for the parameters to specify.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When operations preceded by " + Chr(34) + "T" + Chr(34) + " are specified, the transparent portions of the source will not be transferred.")
  Th2HandbookHelp_Commit("_Figure 2.4  Screen data format_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-24-screen-data-format_", 92)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The sprites used in screen mode 4-8 of MSX2 are called sprite mode 2, which has upgraded a great deal as compared with MSX1. On MSX1, for example, one sprite could treat only one colour, while in this mode of MSX2 different colours can be specified for each horizontal line and so multi-coloured characters can be realised with one sprite. Additionally, it is a good idea to combine two sprites as though they were one sprite to paint each dot with different colours. And, on MSX1, when more than five sprites are arrayed on a horizontal line, the sprites after the fifth one were not displayed, but on MSX2 up to eight sprites can be displayed, so a higher flexibility is offered.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Colours which can be specified for sprites are shown in [[[Table 2.4|||Chapter2#table-24--colour-specifications-for-the-screen-mode]]] (colour statement) except for screen mode 8. The sprite in screen mode 8, not capable of using the palette, uses the colour number for the specification, and only 16 colours can be used (see [[[Table 2.10|||Chapter2#table-210--sprite-colours-in-screen-mode-8]]]).")
  Th2HandbookHelp_Commit("2.7 Additions or Modifications for Sprite", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#27-additions-or-modifications-for-sprite", 93)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| 0: Black        | 1: Deep Blue    | 2: Deep Red     | 3: Deep Purple  |")
  Th2HandbookHelp_L("@@@|-----------------+-----------------+-----------------+-----------------|")
  Th2HandbookHelp_L("@@@| 4: Deep Green   | 5: Turquoise    | 6: Olive        | 7: Grey         |")
  Th2HandbookHelp_L("@@@|-----------------+-----------------+-----------------+-----------------|")
  Th2HandbookHelp_L("@@@| 8: Light Orange | 9: Blue         | 10: Red         | 11: Purple      |")
  Th2HandbookHelp_L("@@@|-----------------+-----------------+-----------------+-----------------|")
  Th2HandbookHelp_L("@@@| 12: Green       | 13: Light Blue  | 14: Yellow      | 15: White       |")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `PUT SPRITE [, {(X,Y) | STEP(X,Y)}[, [, ]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In screen modes 1 through 3, Y-coordinate was 209 for erasing the display of the specified sprite and was 208 for erasing the displays of the specified sprite and all sprites following it, but in screen modes 4 through 8, where the limit of Y-coordinate has been increased to 212 dots, the values to be specified are now 217 and 216, respectively.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COLOR SPRITE$ () = `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement specifies a colour for each horizontal line (see [[[Figure 2.5|||Chapter2#figure-25--relation-of-the-sprite-and-string-expression]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` consists of one to sixteen characters. Bits 0 throgh 3 of the character's ASCII code are used for the colour specification, and bits 4 throgh 7 are used to specify each function of the sprite (see [[[Table 2.11|||Chapter2#table-211--bitwise-meanings-of-string-expression]]]). These specifications are valid only for screen modes 4 through 8.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@COLOR SPRITE$ = CHR$ (colour of the first line) + CHR$ (colour of the second line) + ...... + CHR$ (colour of the eight line)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.10  Sprite colours in screen mode 8_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-210-sprite-colours-in-screen-mode-8_", 94)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.5]|||img:figure_2.5]]]")
  Th2HandbookHelp_Commit("_Figure 2.5  Relation of the sprite and ``_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-25-relation-of-the-sprite-and-string-expression_", 95)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|    b7    | If 1, move the sprite to left by 32 dots.                  |")
  Th2HandbookHelp_L("@@@|----------+------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|          | If 1, move the sprites of the successive planes together.  |")
  Th2HandbookHelp_L("@@@|    b6    | The priority and conflict of sprites are ignored, and when |")
  Th2HandbookHelp_L("@@@|          | sprites are piled up, they are displayed in the colour     |")
  Th2HandbookHelp_L("@@@|          | which is OR-ed with their colour numbers. *                |")
  Th2HandbookHelp_L("@@@|----------+------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|    b5    | If 1, the conflict of sprites are ignored.                 |")
  Th2HandbookHelp_L("@@@|----------+------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|    b4    | Unused.                                                    |")
  Th2HandbookHelp_L("@@@|----------+------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| b0 to b3 | Palette number.                                            |")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* For example, assuming that bit 6 of sprite plane 1 is " + Chr(34) + "0" + Chr(34) + " and bit 6 of sprite plane 2 is " + Chr(34) + "1" + Chr(34) + ", only by moving sprite plane 1, will sprite plane 2 be displayed displayed to be piled at the same location.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COLOR SPRITE () = `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets the whole sprite of the specified plane to the ``, this uses `` for colour specification. The format of the colour specification is the same as shown in [[[Table 2.11|||Chapter2#table-211--bitwise-meanings-of-string-expression]]], but the specification for b7 is disabled. These are valid for screen modes 4 through 8.")
  Th2HandbookHelp_Commit("_Table 2.11  Bitwise meanings of string expression_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-211-bitwise-meanings-of-string-expression_", 96)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `SET VIDEO [[, [, [, [, [, [, ]]]]]]]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement is for the superimposer or the digitiser which are optional, so it can be used only for machines which have these features.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` sets the superimposing mode and can be set to the value listed in [[[Table 2.12|||Chapter2#table-212--input-values-for-set-video-mode]]].")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When `` is 1, the brightness of the television is halved.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When `` is 1, the colour bus of VDP is prepared for input, and, when 0, it is prepared for output.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When `` is 1, " + Chr(34) + "external sync" + Chr(34) + " is selected, and, when 0, " + Chr(34) + "internal sync" + Chr(34) + " is selected.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` specifies whether to mix external signal for output, and values are listed in [[[Table 2.13|||Chapter2#table-213--input-values-for-set-video-voice]]].")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` is used to alternate the input of external video signals. When it is 0, the RGB multiconnector is selected; when it is 1, external video signal connector is selected.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("` specifies AV control terminal output of the RGB multiconnector. When it is 0, the output is OFF; when it is 1, the output is ON.")
  Th2HandbookHelp_Commit("2.8 Additions for Optional Features", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#28-additions-for-optional-features", 97)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------")
  Th2HandbookHelp_L("@@@| Mode | S1 | S2 | TP | Display screen |")
  Th2HandbookHelp_L("@@@|------+----+----+----+----------------|")
  Th2HandbookHelp_L("@@@|  0   | 0  | 0  | 0  | Computer       |")
  Th2HandbookHelp_L("@@@|  1   | 0  | 1  | 1  | Computer       |")
  Th2HandbookHelp_L("@@@|  2   | 0  | 1  | 0  | Superimpose    |")
  Th2HandbookHelp_L("@@@|  3   | 1  | 0  | 0  | Television     |")
  Th2HandbookHelp_L("@@@----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** In the case of mode 0, external sync cannot be used. In other modes the compoalte output of VDP is not available. S1, S0, and TP are the names of flags in the VDP register.")
  Th2HandbookHelp_Commit("_Table 2.12  Input values for SET VIDEO ``._", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-212-input-values-for-set-video-mode_", 98)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------")
  Th2HandbookHelp_L("@@@| Voice | Function for external voice signal |")
  Th2HandbookHelp_L("@@@|-------+------------------------------------|")
  Th2HandbookHelp_L("@@@|   0   | No mixing                          |")
  Th2HandbookHelp_L("@@@|   1   | Right channel mixed                |")
  Th2HandbookHelp_L("@@@|   2   | Left channel mixed                 |")
  Th2HandbookHelp_L("@@@|   3   | Both channels mixed                |")
  Th2HandbookHelp_L("@@@----------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `COPY SCREEN []`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement is used for writing data from the colour bus to VRAM, for example, after digitising. This is valid for screen modes 5 to 8.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In mode 0, one field of signals is digitised and written to the display page; in mode 1, two successive fields (that is, one frame) of signals are written to (display page - 1)th page and the display page, so the display page should be an odd page when the mode is 1. The default mode is 0.")
  Th2HandbookHelp_Commit("_Table 2.13  Input values for SET VIDEO ``_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-213-input-values-for-set-video-voice_", 99)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `GET DATE  [,A]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement is for reading the date from the timer and assigning it to the string variable. The format of date to be read is as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@YY/MM/DD        (YY = lower two digits of year, MM = month, DD = day)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("e.g.)   85/03/23        (March 23, 1985)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When option A is specified, the alarm date is read.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET DATE [, A]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets date to timer. The form of parameter and option is the same as " + Chr(34) + "GET DATE" + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("e.g.) SET DATE " + Chr(34) + "85/03/23" + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `GET TIME [, A]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement is for reading time from the timer and assigning it to a string variable. The form of time to be read is as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HH:MM:SS        (HH = hour, MM = minute, SS = second)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("e.g.) 22:15:00          (22 hours 15 minutes 0 seconds)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When A is specified, the time for the alarm is read.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET TIME [, A]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets the time to the timer. The form of parameter and option is the same as " + Chr(34) + "GET TIME" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("e.g.) SET TIME " + Chr(34) + "22:15:00" + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* The Alarm")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since the alarm feature is optional, the action taken at the specified time depends on the machine (ordinarily nothing happens).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the alarm is to be set in both " + Chr(34) + "SET DATE" + Chr(34) + " and " + Chr(34) + "SET TIME" + Chr(34) + ", " + Chr(34) + "SET TIME" + Chr(34) + " should be done first (when " + Chr(34) + "SET TIME" + Chr(34) + " is done, date of the alarm set by " + Chr(34) + "SET DATE" + Chr(34) + " will be erased).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The minimum setting for alarm is in minutes (setting in seconds is ignored).")
  Th2HandbookHelp_Commit("2.9 Additions for Timer Features", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#29-additions-for-timer-features", 100)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Using " + Chr(34) + "SET" + Chr(34) + " instructions, various settings described below can be stored to the battery-powered RAM in CLOCK-IC. Settings based on these are done automatically at system startup (when the system is powered or reset). " + Chr(34) + "SET TITLE" + Chr(34) + ", " + Chr(34) + "SET PROMPT" + Chr(34) + ", and " + Chr(34) + "SET PASSWORD" + Chr(34) + " use the same RAM, so only the most recent instruction is valid.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET ADJUST (, )`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets the location to display on the screen. The coordinate offset is from -7 to 8.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET BEEP , `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets BEEP sound. `` and `` are from 1 to 4.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Table 2.14|||Chapter2#table-214--input-values-for--of-set-beep]]] shows the correspondance of `` and to the actual sound.")
  Th2HandbookHelp_Commit("2.10 Additions for Memory Switch", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#210-additions-for-memory-switch", 101)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------------------------------------------")
  Th2HandbookHelp_L("@@@| Timbre |            Sound              |")
  Th2HandbookHelp_L("@@@|--------+-------------------------------|")
  Th2HandbookHelp_L("@@@|   1    | High tone beep (same as MSX1) |")
  Th2HandbookHelp_L("@@@|   2    | Low tone beep                 |")
  Th2HandbookHelp_L("@@@|   3    | 2 - tone beep                 |")
  Th2HandbookHelp_L("@@@|   4    | 3 - tone beep                 |")
  Th2HandbookHelp_L("@@@------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET TITLE [, ]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement specifies the title and the colour of the initial screen at system startup. `` is set by a string of up to 6 characters and `` is one of the values on [[[Table 2.15|||Chapter2#table-215--available-colours-in-set-title]]]. When `` is 6 characters, keyboard input is awaited just after the title screen is displayed.")
  Th2HandbookHelp_Commit("_Table 2.14  Input values for  of SET BEEP_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-214-input-values-for-timbre-of-set-beep_", 102)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------")
  Th2HandbookHelp_L("@@@| Color         |   1    |   2    |   3    |   4    |")
  Th2HandbookHelp_L("@@@|---------------+--------+--------+--------+--------|")
  Th2HandbookHelp_L("@@@| Screen color  | Blue   | Green  | Red    | Orange |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET PROMPT `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets the prompt. `` can have up to 6 characters.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET PASSWORD `")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement sets a system password. `` is a string expression up to 255 characters. Once this statement is done, input of the password is requested for invoking the system. When the correct password is given, the system is normally invoked; otherwise, correct password input is requested. When the system is invoked by pressing both graphic key and stop key, no password input is requested (in this case, the password setting has been done by the key cartridge; however, password input is always required for system startup). The password is disabled by specifying a null character in SET TITLE.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `SET SCREEN`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement records the current parameters of the " + Chr(34) + "SCREEN" + Chr(34) + " statement. At the system startup, they are automatically set. Items to be recorded are the following:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Screen number of text mode                      Key click switch")
  Th2HandbookHelp_L("@@@Screen width of text mode                       Printer option")
  Th2HandbookHelp_L("@@@Foreground, background, and border colours      Cassette baud rate")
  Th2HandbookHelp_L("@@@Function key switch                             Display mode")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.15  Available colours in SET TITLE_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-215-available-colours-in-set-title_", 103)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("On MSX1 RAM from 0000H to 7FFFH was used only by DOS. On MSX2, however, this portion can be used as a RAM disk of up to 32K bytes. The format of the file name for RAM disk is described below, where `` is a string which consists of 1 to 8 characters and `` is one which consists of 1 to 3 characters. Note that " + Chr(34) + ";" + Chr(34) + " (colon), " + Chr(34) + "." + Chr(34) + " (period), control characters of character codes 00H-1FH, and graphic symbols consisting of two bytes cannot be used.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MEM: <filename>[.<extension>]")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The following are executable operations for the RAM disk:")
  Th2HandbookHelp_Commit("2.11 Additions for RAM Disk", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#211-additions-for-ram-disk", 104)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    SAVE, LOAD, RUN, MERGE")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When any of the above commands is executed from the program, control returns to the command level.")
  Th2HandbookHelp_Commit("1. Load/save a BASIC program (always saved in ASCII format)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#1-loadsave-a-basic-program-always-saved-in-ascii-format", 105)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    OPEN, CLOSE")
  Th2HandbookHelp_L("@@@    PRINT #, PRINT USING #")
  Th2HandbookHelp_L("@@@    INPUT #, LINE INPUT #, INPUT$")
  Th2HandbookHelp_L("@@@    EOF, LOC, LOF")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The RAM disk does not support the following instructions:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Random file Read/Write")
  Th2HandbookHelp_L("2. BLOAD, BSAVE")
  Th2HandbookHelp_L("3. COPY")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `CALL MEMINI [()]`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement specifies the amount of memory to be used as a RAM disk, initialises the RAM disk, and deletes all files. When the RAM disk is to be used, this statement should always be executed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`` is " + Chr(34) + "the amount of memory to be used as RAM disk minus 1" + Chr(34) + ". By default, the maximum size is allocated for RAM disk. " + Chr(34) + "CALL MEMINI(0)" + Chr(34) + " causes the RAM disk feature to be disabled.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `CALL MFILES`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement displays file names on the RAM disk.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `CALL MKILL (" + Chr(34) + Chr(34) + ")`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement deletes the specified file.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* `CALL MNAME (" + Chr(34) + Chr(34) + " AS " + Chr(34) + Chr(34) + ")`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement renames the specified file.")
  Th2HandbookHelp_Commit("2. Read/write a sequential file", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#2-readwrite-a-sequential-file", 106)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* `PAD ()`")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This function returns status to touch pad (touch panel), light pen, mouse, or track ball.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When `` is 0 to 7, it returns the status to touch pad as on MSX1, and, when `` is 8 to 11, it returns the status to light pen. Since the coordinates and the value of the switch are read when " + Chr(34) + "PAD(8)" + Chr(34) + " is executed, other data should be read after confirming that the value of PAD(8) is -1 (see [[[Table 2.16|||Chapter2#table-216--expression-returning-status-to-light-pen]]]).")
  Th2HandbookHelp_Commit("2.12 Other Additions", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#212-other-additions", 107)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| Expression |                 The value returned                   |")
  Th2HandbookHelp_L("@@@|------------+------------------------------------------------------|")
  Th2HandbookHelp_L("@@@|      8     | -1 when data of light open is valid; otherwise, 0    |")
  Th2HandbookHelp_L("@@@|      9     | X - coordinate of light pen                          |")
  Th2HandbookHelp_L("@@@|     10     | Y - coordinate of light pen                          |")
  Th2HandbookHelp_L("@@@|     11     | -1 when switch of light pen is pressed; otherwise, 0 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This statement returns the status of the mouse or the track ball connected to port 1 when `` is 12 to 15 or connected to port 2 when it is 16 to 19 (see [[[Table 2.17|||Chapter2#table-217--expression-returning-status-to-mouse-or-track-ball]]]). The mouse and track ball are automatically distinguished from each other.")
  Th2HandbookHelp_Commit("_Table 2.16  `` returning status to light pen_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-216-expression-returning-status-to-light-pen_", 108)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@---------------------------------------")
  Th2HandbookHelp_L("@@@| Expression |   The value returned   |")
  Th2HandbookHelp_L("@@@|------------+------------------------|")
  Th2HandbookHelp_L("@@@|   12, 16   | - 1; for input request |")
  Th2HandbookHelp_L("@@@|   13, 17   | X - coordinate         |")
  Th2HandbookHelp_L("@@@|   14, 18   | Y - coordinate         |")
  Th2HandbookHelp_L("@@@|   15, 19   | 0 (unused)             |")
  Th2HandbookHelp_L("@@@---------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Coordinate data is read when PAD(12) or PAD(16) is examined. Coordinate data should be obtained after examining these. The STRIG function is used with the joystick to input the status of the trigger button.")
  Th2HandbookHelp_Commit("_Table 2.17  `` returning status to mouse or track ball_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-217-expression-returning-status-to-mouse-or-track-ball_", 109)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Knowledge of how the BASIC interpreter controls and executes programs is necessary for more advanced use of BASIC. The internal structure of BASIC is discussed next.")
  Th2HandbookHelp_Commit("3. INTERNAL STRUCTURE OF BASIC", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#3-internal-structure-of-basic", 110)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The lowest address of the user's area was different in the MSX1 machine whose amount of RAM was 8K, 16K, 32K, or 64K; in MSX2, it is always 8000H, because MSX2 machines have at least 64K of RAM. It can be obtained from the content of BOTTOM (FC48H).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The highest address of the user's area when no disk drives are connected is F380H; when disk drives are connected (using DISK-BASIC), it depends on the number of disk drives or on the disk capacity. It can be obtained from the content of HIMEM (FC4AH) after reset and before executing CLEAR statement.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Figure 2.6|||Chapter2#figure-26--state-of-memory-for-basic-mode]]] shows the state of memory when MSX is invoked.")
  Th2HandbookHelp_Commit("3.1 User's Area", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#31-users-area", 111)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@0000 --------------------")
  Th2HandbookHelp_L("@@@     |                  |")
  Th2HandbookHelp_L("@@@     |      BASIC       |")
  Th2HandbookHelp_L("@@@     |   Interpreter    |")
  Th2HandbookHelp_L("@@@     |                  |")
  Th2HandbookHelp_L("@@@8000 |------------------|  ⟵ (BOTTOM)             --+")
  Th2HandbookHelp_L("@@@     |                  |                            |")
  Th2HandbookHelp_L("@@@     |    User area     |                   --+      |")
  Th2HandbookHelp_L("@@@     |                  |                     |      |")
  Th2HandbookHelp_L("@@@     |------------------|  ⟵ (HIMEM)         |      |32K")
  Th2HandbookHelp_L("@@@     |  Disk work area  |             --+     |16K   |")
  Th2HandbookHelp_L("@@@F380 |------------------|               | 8K  |      |")
  Th2HandbookHelp_L("@@@     | System work area |               |     |      |")
  Th2HandbookHelp_L("@@@FFFF --------------------             --+   --+    --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** Though the machine has more than 32K bytes of RAM, only 32K bytes are used for BASIC. On MSX2, however, another 32K bytes can be used as a RAM disk by BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When developping a program on MSX2, we recommend you create it at addresses 8000H to DE3FH as if to install a 2DD-2 drive whose highest address of the user's area is the lowest. The work area of the disk can grow even larger, therefore, HIMEM of the application program should be checked to prevent disasters even in the worst situation. The following are ways to prevent this:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Make the work area relocatable")
  Th2HandbookHelp_L("2. Get the work area from BOTTOM")
  Th2HandbookHelp_L("3. Stop after instructing to reduce the number of drives")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("On MSX, even when disks are mounted, they can be cut off by resetting while pressing the SHIFT key. When only one drive is mounted, the normal invocation causes the work area for two drives to be allocated (mainly for 2 drive simulator): in such a case, invoking the works area for only one drive is possible by resetting while pressing the CTRL key. If these steps are taken, more user's area can be allocated.")
  Th2HandbookHelp_Commit("_Figure 2.6  State of memory for BASIC mode_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-26-state-of-memory-for-basic-mode_", 112)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[Figure 2.7|||Chapter2#figure-27--state-of-the-users-area]]] shows how the user's area will be used in BASIC, and [[[Table 2.18|||Chapter2#table-218--work-areas-with-start-and-end-addresses-of-each-area]]] shows the work area with information about where these areas start. This work area is read-only (the initialising routine sets it when reset), so actions when it is changed are not guaranteed.")
  Th2HandbookHelp_Commit("3.2 Detailed View of the User's Area", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#32-detailed-view-of-the-users-area", 113)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BOTTOM -->  ---------------------- The lowest of the user's area")
  Th2HandbookHelp_L("@@@            |                    | (8000H on MSX2)")
  Th2HandbookHelp_L("@@@TXTTAB -->  |--------------------|")
  Th2HandbookHelp_L("@@@            |                 |  |")
  Th2HandbookHelp_L("@@@            |      BASIC      V  |")
  Th2HandbookHelp_L("@@@            |   program area     |")
  Th2HandbookHelp_L("@@@            |                    |")
  Th2HandbookHelp_L("@@@VARTAB -->  |--------------------| Depends on the amount of text")
  Th2HandbookHelp_L("@@@            | Simple variable |  |")
  Th2HandbookHelp_L("@@@            |      area       V  |")
  Th2HandbookHelp_L("@@@ARYTAB -->  |--------------------|")
  Th2HandbookHelp_L("@@@            | Array variable  |  |")
  Th2HandbookHelp_L("@@@            |      area       V  |")
  Th2HandbookHelp_L("@@@STREND -->  |--------------------| Depends on the number of variables")
  Th2HandbookHelp_L("@@@            |                 |  |")
  Th2HandbookHelp_L("@@@            |                 V  |")
  Th2HandbookHelp_L("@@@            |     Free area      |")
  Th2HandbookHelp_L("@@@            |                 ^  |")
  Th2HandbookHelp_L("@@@            |                 |  |")
  Th2HandbookHelp_L("@@@SP     -->  |--------------------| Area pointed by SP register")
  Th2HandbookHelp_L("@@@            | Stack           ^  |")
  Th2HandbookHelp_L("@@@            | area            |  |")
  Th2HandbookHelp_L("@@@STKTOP -->  |--------------------| --+")
  Th2HandbookHelp_L("@@@            | String          ^  |   | Set by 1st parameter of CLEAR")
  Th2HandbookHelp_L("@@@            | area            |  |   |")
  Th2HandbookHelp_L("@@@MEMSIZ -->  |--------------------| --+")
  Th2HandbookHelp_L("@@@            | File            ^  |")
  Th2HandbookHelp_L("@@@            | control block   |  |")
  Th2HandbookHelp_L("@@@HIMEM  -->  |--------------------| Set by 2nd parameter of CLEAR")
  Th2HandbookHelp_L("@@@            |                    |")
  Th2HandbookHelp_L("@@@            | Assembly language  |")
  Th2HandbookHelp_L("@@@            | area               |")
  Th2HandbookHelp_L("@@@            |                    |")
  Th2HandbookHelp_L("@@@            ---------------------- The highest of the user's area")
  Th2HandbookHelp_L("@@@                                   (depends on the presence of disks)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 2.7  State of the user's area_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-27-state-of-the-users-area_", 114)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Area name                  Start address           End address")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@User's area            | [BOTTOM (FC48H)] | ([HIMEM (FC4AH)] when reset) - 1")
  Th2HandbookHelp_L("@@@Program area           | [TXTTAB (F676H)] | [VARTAB (F6C2H)] - 1")
  Th2HandbookHelp_L("@@@Simple variable area   | [VARTAB (F6C2H)] | [ARYTAB (F6C4H)] - 1")
  Th2HandbookHelp_L("@@@Array variable area    | [ARYTAB (F6C4H)] | [STREND (F6C6H)] - 1")
  Th2HandbookHelp_L("@@@Free area              | [STREND (F6C6H)] | [SP register] - 1")
  Th2HandbookHelp_L("@@@Stack area             | [SP register]    | [STKTOP (F674H)] - 1")
  Th2HandbookHelp_L("@@@String area            | [STKTOP (F674H)] | [MEMSIZ (F672H)] - 1")
  Th2HandbookHelp_L("@@@(start of unused area) | [FRETOP (F69BH)] |")
  Th2HandbookHelp_L("@@@File control block     | [MEMSIZ (F672H)] | [HIMEM  (FC4AH)] - 1")
  Th2HandbookHelp_L("@@@Assembly language area | [HIMEM  (FC4AH)] | to the end of the user's area")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Roles of each user's area are described below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* BASIC program area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("A program written in BASIC is stored from the lowest address (8000H on MSX2) of the user's area and its size depends on the amount of the program.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Variable area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The variable area is located just after the BASIC program area. It is secured to store the name and the value of the variables used when executing the program. The variables storage formats are shown in [[[Figure 2.8|||Chapter2#figure-28--storage-format-of-simple-variables]]] (simple variables) and [[[Figure 2.9|||Chapter2#figure-29--storage-format-of-array-variables]]] (array variables). Using array variables without declaring in the DIM statement causes the area to be allocated as an array with ten indexes. However, arrays which are more than four dimensional must be declared.")
  Th2HandbookHelp_Commit("_Table 2.18  Work areas with start and end addresses of each area_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-218-work-areas-with-start-and-end-addresses-of-each-area_", 115)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.8]|||img:figure_2.8]]]")
  Th2HandbookHelp_Commit("_Figure 2.8  Storage format of simple variables_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-28-storage-format-of-simple-variables_", 116)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.9]|||img:figure_2.9]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** variable data format is the same as the storage format of simple variables. The lower of the 2-byte value is stored first, and the higher byte last.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Free area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If the program area or the variable area grows too large or a lot of data is stacked and the free area runs out, an " + Chr(34) + "OUT OF MEMORY" + Chr(34) + " error occurs. The amount of free area can be checked by examining PRINT FRE(0) using the FRE function in BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Stack area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This is the stack area used by BASIC. It is used in order from high-order address when executing GOSUB or FOR.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* String area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This area is used to reserve the contents of string variables and used from high-order address. The space in this area can be specified by the first parameter of the CLEAR statement in BASIC. The default is 200 bytes. Exhausting the space in this area causes a " + Chr(34) + "OUT OF STRING SPACE" + Chr(34) + " error. The amount of unused area can be checked by examining PRINT FRE(" + Chr(34) + Chr(34) + ") using the FRE function in BASIC")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* File control block")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("File information is stored in this area with 10BH (267) bytes allocated for each file. The amount of space for files can be specified by the MAXFILES statement of BASIC. At reset, the area for one file (MAXFILES = 1) is allocated. Another space is always allocated for SAVE and LOAD instructions, so actually area for two files is allocated. [[[Table 2.19|||Chapter2#table-219--file-control-block-fcb-format]]] shows the format of file control block.")
  Th2HandbookHelp_Commit("_Figure 2.9  Storage format of array variables_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-29-storage-format-of-array-variables_", 117)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  Offset    Label                    Meaning")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| + 0   |   FL.MOD   |   Mode of the file opened             |")
  Th2HandbookHelp_L("@@@| + 1   |   FL.FCA   |   Pointer (low) to FCB for BDOS       |")
  Th2HandbookHelp_L("@@@| + 2   |   FL.LCA   |   Pointer (high) to FCB for BDOS      |")
  Th2HandbookHelp_L("@@@| + 3   |   FL.LSA   |   Backup character                    |")
  Th2HandbookHelp_L("@@@| + 4   |   FL.DSK   |   Device number                       |")
  Th2HandbookHelp_L("@@@| + 5   |   FL.SLB   |   Internal use for the interpreter    |")
  Th2HandbookHelp_L("@@@| + 6   |   FL.BPS   |   FL.BUF location                     |")
  Th2HandbookHelp_L("@@@| + 7   |   FL.FLG   |   Flag containing various information |")
  Th2HandbookHelp_L("@@@| + 8   |   FL.OPS   |   Virtual head information            |")
  Th2HandbookHelp_L("@@@| + 9...|   FL.BUF   |   File buffer (256 bytes)             |")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Assembly language area")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Use this area to write programs in assembly language or to operate from memory directly. To do these, this area should be reserved by CLEAR statement.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Work area for disk")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Figure 2.10 shows the work area allocated when a disk is mounted. Note that this area does not exist when no disk is mounted. Labels to the right of this figure shows the address information which resides there.")
  Th2HandbookHelp_Commit("_Table 2.19  File control block (FCB) format_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-219-file-control-block-fcb-format_", 118)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.10]|||img:figure_2.10]]]")
  Th2HandbookHelp_Commit("_Figure 2.10  Work area for disk_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-210-work-area-for-disk_", 119)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Programs are stored in memory as shown in [[[Figure 2.11|||Chapter2#figure-211--text-storage-format]]] and the meaning of its contents are described below.")
  Th2HandbookHelp_Commit("3.3 Storage format of BASIC programs", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#33-storage-format-of-basic-programs", 120)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.11]|||img:figure_2.11]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** Link pointers and line numbers are stored with their low bytes first and high bytes last.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Link pointer")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The text pointer to the next line is given in the form of an absolute address.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Line number")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This stores the line number of the program, normally the values from 0 to 65529 (from 0000H to FFF9H). It is possible to make line numbers of 65530 or more, but LIST command does not list them.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* Text")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The program body is stored here in the intermediate code format. Reserved words (keywords), operators, numeric values are converted to the intermediate codes, and others (such as variable names or string constantes) are stored as character codes. [[[Table 2.20|||Chapter2#table-220--list-of-intermediate-codes]]] lists the intermediate codes and [[[Figure 2.12|||Chapter2#figure-212--numeral-formats-in-text]]] shows the numeric formats in text.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("See the appendix at the end of this book for character codes. Graphic characters are stored in 2 bytes (2 characters) of `" + Chr(34) + "CHR$(1) + (graphic character code + 64)" + Chr(34) + "`, so be careful when defining graphic characters.")
  Th2HandbookHelp_Commit("_Figure 2.11  Text storage format_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-211-text-storage-format_", 121)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------   -------------------   -------------------")
  Th2HandbookHelp_L("@@@| >       |    EE |   | ERR     |    E2 |   | PAINT   |    BF |")
  Th2HandbookHelp_L("@@@| =       |    EF |   | ERROR   |    A6 |   | PDL     | FF A4 |")
  Th2HandbookHelp_L("@@@| <       |    F0 |   | EXP     | FF 8B |   | PEEK    | FF 97 |")
  Th2HandbookHelp_L("@@@| +       |    F1 |   | FIELD   |    B1 |   | PLAY    |    C1 |")
  Th2HandbookHelp_L("@@@| -       |    F2 |   | FILES   |    B7 |   | POINT   |    ED |")
  Th2HandbookHelp_L("@@@| *       |    F3 |   | FIX     | FF A1 |   | POKE    |    98 |")
  Th2HandbookHelp_L("@@@| /       |    F4 |   | FN      |    DE |   | POS     | FF 91 |")
  Th2HandbookHelp_L("@@@| ^       |    F5 |   | FOR     |    82 |   | PRESET  |    C3 |")
  Th2HandbookHelp_L("@@@| \       |    FC |   | FPOS    | FF A7 |   | PRINT   |    91 |")
  Th2HandbookHelp_L("@@@| ABS     | FF 86 |   | FRE     | FF 8F |   | PSET    |    C2 |")
  Th2HandbookHelp_L("@@@| AND     |    F6 |   | GET     |    B2 |   | PUT     |    B3 |")
  Th2HandbookHelp_L("@@@| ASC     | FF 95 |   | GOSUB   |    8D |   | READ    |    87 |")
  Th2HandbookHelp_L("@@@| ATN     | FF 8E |   | GOTO    |    89 |   | REM     | 3A 8F |")
  Th2HandbookHelp_L("@@@| ATTR$   |    E9 |   | HEX$    | FF 9B |   | RENUM   |    AA |")
  Th2HandbookHelp_L("@@@| AUTO    |    A9 |   | IF      |    8B |   | RESTORE |    8C |")
  Th2HandbookHelp_L("@@@| BASE    |    C9 |   | IMP     |    FA |   | RESUME  |    A7 |")
  Th2HandbookHelp_L("@@@| BEEP    |    C0 |   | INKEY$  |    EC |   | RETURN  |    8E |")
  Th2HandbookHelp_L("@@@| BIN$    | FF 9D |   | INP     | FF 90 |   | RIGHT$  | FF 82 |")
  Th2HandbookHelp_L("@@@| BLOAD   |    CF |   | INPUT   |    85 |   | RND     | FF 88 |")
  Th2HandbookHelp_L("@@@| BSAVE   |    D0 |   | INSTR   |    E5 |   | RSET    |    B9 |")
  Th2HandbookHelp_L("@@@| CALL    |    CA |   | INT     | FF 85 |   | RUN     |    8A |")
  Th2HandbookHelp_L("@@@| CDBL    | FF A0 |   | IPL     |    D5 |   | SAVE    |    BA |")
  Th2HandbookHelp_L("@@@| CHR$    | FF 96 |   | KEY     |    CC |   | SCREEN  |    C5 |")
  Th2HandbookHelp_L("@@@| CINT    | FF 9E |   | KILL    |    D4 |   | SET     |    D2 |")
  Th2HandbookHelp_L("@@@| CIRCLE  |    BC |   | LEFT$   | FF 81 |   | SGN     | FF 84 |")
  Th2HandbookHelp_L("@@@| CLEAR   |    92 |   | LEN     | FF 92 |   | SIN     | FF 89 |")
  Th2HandbookHelp_L("@@@| CLOAD   |    9B |   | LET     |    88 |   | SOUND   |    C4 |")
  Th2HandbookHelp_L("@@@| CLOSE   |    B4 |   | LFILES  |    BB |   | SPACE$  | FF 99 |")
  Th2HandbookHelp_L("@@@| CLS     |    9F |   | LINE    |    AF |   | SPC(    |    DF |")
  Th2HandbookHelp_L("@@@| CMD     |    D7 |   | LIST    |    93 |   | SPRITE  |    C7 |")
  Th2HandbookHelp_L("@@@| COLOR   |    BD |   | LLIST   |    9E |   | SQR     | FF 87 |")
  Th2HandbookHelp_L("@@@| CONT    |    99 |   | LOAD    |    B5 |   | STEP    |    DC |")
  Th2HandbookHelp_L("@@@| COPY    |    D6 |   | LOC     | FF AC |   | STICK   | FF A2 |")
  Th2HandbookHelp_L("@@@| COS     | FF 8C |   | LOCATE  |    D8 |   | STOP    |    90 |")
  Th2HandbookHelp_L("@@@| CSAVE   |    9A |   | LOF     | FF AD |   | STR$    | FF 93 |")
  Th2HandbookHelp_L("@@@| CSNG    | FF 9F |   | LOG     | FF 8A |   | STRIG   | FF A3 |")
  Th2HandbookHelp_L("@@@| CSRLIN  |    E8 |   | LPOS    | FF 9C |   | STRING$ |    E3 |")
  Th2HandbookHelp_L("@@@| CVD     | FF AA |   | LPRINT  |    9D |   | SWAP    |    A4 |")
  Th2HandbookHelp_L("@@@| CVI     | FF A8 |   | LSET    |    B8 |   | TAB(    |    DB |")
  Th2HandbookHelp_L("@@@| CVS     | FF A9 |   | MAX     |    CD |   | TAN     | FF 8D |")
  Th2HandbookHelp_L("@@@| DATA    |    84 |   | MERGE   |    B6 |   | THEN    |    DA |")
  Th2HandbookHelp_L("@@@| DEF     |    97 |   | MID$    | FF 83 |   | TIME    |    CB |")
  Th2HandbookHelp_L("@@@| DEFDBL  |    AE |   | MKD$    | FF B0 |   | TO      |    D9 |")
  Th2HandbookHelp_L("@@@| DEFINT  |    AC |   | MKI$    | FF AE |   | TROFF   |    A3 |")
  Th2HandbookHelp_L("@@@| DEFSNG  |    AD |   | MKS$    | FF AF |   | TRON    |    A2 |")
  Th2HandbookHelp_L("@@@| DEFSTR  |    AB |   | MOD     |    FB |   | USING   |    E4 |")
  Th2HandbookHelp_L("@@@| DELETE  |    A8 |   | MOTOR   |    CE |   | USR     |    DD |")
  Th2HandbookHelp_L("@@@| DIM     |    86 |   | NAME    |    D3 |   | VAL     | FF 94 |")
  Th2HandbookHelp_L("@@@| DRAW    |    BE |   | NEW     |    94 |   | VARPTR  |    E7 |")
  Th2HandbookHelp_L("@@@| DSKF    | FF A6 |   | NEXT    |    83 |   | VDP     |    C8 |")
  Th2HandbookHelp_L("@@@| DSKI$   |    EA |   | NOT     |    E0 |   | VPEEK   | FF 98 |")
  Th2HandbookHelp_L("@@@| DSKO$   |    D1 |   | OCT$    | FF 9A |   | VPOKE   |    C6 |")
  Th2HandbookHelp_L("@@@| ELSE    | 3A A1 |   | OFF     |    EB |   | WAIT    |    96 |")
  Th2HandbookHelp_L("@@@| END     |    81 |   | ON      |    95 |   | WIDTH   |    A0 |")
  Th2HandbookHelp_L("@@@| EOF     | FF AB |   | OPEN    |    B0 |   | XOR     |    F8 |")
  Th2HandbookHelp_L("@@@| EQV     |    F9 |   | OR      |    F7 |   -------------------")
  Th2HandbookHelp_L("@@@| ERASE   |    A5 |   | OUT     |    9C |")
  Th2HandbookHelp_L("@@@| ERL     |    E1 |   | PAD     | FF A5 |")
  Th2HandbookHelp_L("@@@-------------------   -------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.20  List of intermediate codes_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-220-list-of-intermediate-codes_", 122)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.12]|||img:figure_2.12]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Numbers called " + Chr(34) + "identification codes" + Chr(34) + " are assigned numeric values to distinguish them from reserved words and variable names, and by referring to them the following values can be recognised.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The high and low bytes of a 2-byte numeric value are stored in reverse. Signed numeric values have only the intermediate codes + or - preceding the identifying codes, numeral values themselves are always stored as positive values. Floating-point notations are almost the same as the descriptions of [Math-Pack](Appendix2.md) (Mathematical Package) in the APPENDIX, note that numerical values are always stored as positive. Binary numbers (&B) do not have identifying codes and are stored as ASCII codes.")
  Th2HandbookHelp_Commit("_Figure 2.12  Numeral formats in text_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-212-numeral-formats-in-text_", 123)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("As described so far, MSX BASIC version 2.0 has powerful features, but, if you wish to save execution time even more or to make full use of MSX2 hardware, you should use assembly language. The following sections show how to call assembly language programs from BASIC and gives the information you will need.")
  Th2HandbookHelp_Commit("4.  LINKING WITH ASSEMBLY LANGUAGE PROGRAMS", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#4-linking-with-assembly-language-programs", 124)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To call the assembly language routine from BASIC, follow the steps described below. The value in parenthesis of the USR function is passed to the assembly language routine as an argument. The argument may be either an expression or a string expression.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Specify the starting address of the assembly language program for the execution, using DEF USR statement.")
  Th2HandbookHelp_L("2. Call the assembly language program by USR function.")
  Th2HandbookHelp_L("3. Execute RET (C9H) when returning from the assembly language routine to BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("e.g.) To call the assembly language program whose starting address is C000H:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    DEFUSR=&HC000")
  Th2HandbookHelp_L("@@@    A=USR(0)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("4.1 USR Function", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#41-usr-function", 125)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When the argument is passed from BASIC to the assembly language program, its type can be checked by examining the contents of register A in the assembly language program (see [[[Table 2.21|||Chapter2#table-221---argument-types-assigned-to-register-a]]]). Since the object value is stored in the form as shown in [[[Figure 2.13|||Chapter2#figure-213--how-values-are-passed-as-arguments]]] according to the argument type, you can get the value according to the format. As an example, [[[List 2.1|||Chapter2#list-21--example-of-the-argument-of-string-type]]] shows a program which receives an argument of the string type.")
  Th2HandbookHelp_Commit("4.2 Data Exchange by the Argument and Return Value of USR Function", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#42-data-exchange-by-the-argument-and-return-value-of-usr-function", 126)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--------------------------------------")
  Th2HandbookHelp_L("@@@|  2  |  2-byte integer type         |")
  Th2HandbookHelp_L("@@@|  3  |  String type                 |")
  Th2HandbookHelp_L("@@@|  4  |  Single precision real type  |")
  Th2HandbookHelp_L("@@@|  8  |  Double precision real type  |")
  Th2HandbookHelp_L("@@@--------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.21   Argument types assigned to register A_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-221-argument-types-assigned-to-register-a_", 127)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.13]|||img:figure_2.13]]]")
  Th2HandbookHelp_Commit("_Figure 2.13  How values are passed as arguments_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-213-how-values-are-passed-as-arguments_", 128)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************************")
  Th2HandbookHelp_L("@@@;  List 2.1    print string with USR function")
  Th2HandbookHelp_L("@@@;              to use, do  DEF USR=&HB000 : A$=USR(" + Chr(34) + "STRING" + Chr(34) + ")")
  Th2HandbookHelp_L("@@@;************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHPUT   EQU     00A2H           ;character output")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@RDARG:  CP      3")
  Th2HandbookHelp_L("@@@        RET     NZ              ;parameter is not string")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        POP     IX              ;IX := string descriptor")
  Th2HandbookHelp_L("@@@        LD      A,(IX+0)        ;get string length")
  Th2HandbookHelp_L("@@@        LD      L,(IX+1)        ;get string pointer (low)")
  Th2HandbookHelp_L("@@@        LD      H,(IX+2)        ;get string pointer (high)")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        RET     Z               ;if length = 0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@RD1:    PUSH    AF")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ;get a characetr")
  Th2HandbookHelp_L("@@@        CALL    CHPUT           ;put a character")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        DEC     A")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        JR      RD1")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("On the other hand, these values passed as arguments can be passed to BASIC as USR function values by changing them in the assembly language program. In this case the type of return value can alse be changed to types other that of the argument from BASIC by changing VALTYP (F663H). Note that the amount of characters for a string cannot be changed.")
  Th2HandbookHelp_Commit("_List 2.1  Example of the argument of string type_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_list-21-example-of-the-argument-of-string-type_", 129)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In MSX the reserved words " + Chr(34) + "CMD" + Chr(34) + " and " + Chr(34) + "IPL" + Chr(34) + " are currently unused and by changing the pointers to these words (FE0DH and FE03H) to jump to your own assembly language routine, new commands can be built. [[[List 2.2|||Chapter2#list-22--making-cmd-command]]] shows a simple example.")
  Th2HandbookHelp_Commit("4.3 Making New Commands", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#43-making-new-commands", 130)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;*****************************************************************")
  Th2HandbookHelp_L("@@@;  List 2.2   make CMD command ( turn on/off the CAPS LOCK )")
  Th2HandbookHelp_L("@@@; to initialize command:                DEF USR=&HB000 : A=USR(0)")
  Th2HandbookHelp_L("@@@; to use command:                       CMD")
  Th2HandbookHelp_L("@@@;*****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHGCAP  EQU     0132H           ;CAPS LAMP on/off")
  Th2HandbookHelp_L("@@@CAPST   EQU     0FCABH          ;CAPS LOCK status")
  Th2HandbookHelp_L("@@@HCMD    EQU     0FE9DH          ;CMD HOOK")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- CMD initialize -----   Note:  Executing this section adds the CMD command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      BC,5            ;NEW HOOK SET")
  Th2HandbookHelp_L("@@@        LD      DE,HCMD")
  Th2HandbookHelp_L("@@@        LD      HL,HDAT")
  Th2HandbookHelp_L("@@@        LDIR")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- new HOOK data -----    Note:  5-byte data to be written into hook (FE0DH)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HDAT:   POP     AF")
  Th2HandbookHelp_L("@@@        JP      CAPKEY")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- executed by CMD -----  Note:  Actual CMD command")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CAPKEY: CALL    CHGCAP")
  Th2HandbookHelp_L("@@@        LD      A,(CAPST)")
  Th2HandbookHelp_L("@@@        CPL")
  Th2HandbookHelp_L("@@@        LD      (CAPST),A")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The first " + Chr(34) + "POP AF" + Chr(34) + " written to the pointer in this case, discards the error handling addresses stacked at " + Chr(34) + "CMD" + Chr(34) + " execution. Without this, the " + Chr(34) + "RET" + Chr(34) + " command would jump to the error handling routine isntead of returning to BASIC. It is a way to use this address for printing errors inside of user routine.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("These pointers are reserved for future expansion, so should not be used with application programs on the market.")
  Th2HandbookHelp_Commit("_List 2.2  Making CMD command_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_list-22-making-cmd-command_", 131)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("For more sophisticated expansions of statements it is useful if arguments can be passed to the CMD command. As the HL register points to the next location after " + Chr(34) + "CMD" + Chr(34) + " in the BASIC text when the assembly language routine is called, it can be done by appreciating the successive string. The following is a list of internal routines, useful for these.")
  Th2HandbookHelp_Commit("4.4 Expansion of CMD command", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#44-expansion-of-cmd-command", 132)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Extract one character from text (see [[[Figure 2.14|||Chapter2#figure-214--inputoutput-state-of-chrgtr]]])")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: HL ⟵ Address pointing to text")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * HL ⟵ Address of the extracted character")
  Th2HandbookHelp_L("  * A  ⟵ Extracted character")
  Th2HandbookHelp_L("  * Z  flag ⟵ ON at the end of line (: or 00H)")
  Th2HandbookHelp_L("  * CY flag ⟵ ON if 0 to 9")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Extract one character from the text at (HL + 1). Spaces are skipped.")
  Th2HandbookHelp_Commit("CHRGTR (4666H/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#chrgtr-4666hmain", 133)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.14]|||img:figure_2.14]]]")
  Th2HandbookHelp_Commit("_Figure 2.14  Input/output state of CHRGTR_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-214-inputoutput-state-of-chrgtr_", 134)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Evaluate an expression in text (see [[[Figure 2.15|||Chapter2#figure-215--inputoutput-state-of-frmevl]]])")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: HL ⟵ Starting address of the expression in text")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * HL ⟵ Address after the expression")
  Th2HandbookHelp_L("  * [VALTYP (F663H)] ⟵ Value 2, 3, 4 or 8 according to the expression")
  Th2HandbookHelp_L("  * [DAC (F7F6H)]    ⟵ Result of the evaluation of the expression")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Evaluate an expression and make output according to its type.")
  Th2HandbookHelp_Commit("FRMEVL (4C64/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#frmevl-4c64main", 135)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.15]|||img:figure_2.15]]]")
  Th2HandbookHelp_Commit("_Figure 2.15  Input/output state of FRMEVL_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-215-inputoutput-state-of-frmevl_", 136)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Evaluate an expression in 2-byte integer type.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: HL ⟵ Starting address of the expression in text")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * HL ⟵ Address after the expression")
  Th2HandbookHelp_L("  * DE ⟵ Result of evaluation of the expression")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Evaluate an expression and make output in integer type (INT). When the result is beyond the range of 2-byte integer type, an " + Chr(34) + "Overflow" + Chr(34) + " error occurs and the system returns to the BASIC command level.")
  Th2HandbookHelp_Commit("FRMQNT (542F/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#frmqnt-542fmain", 137)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Evaluate an expression in 1-byte integer type.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: HL ⟵ Starting address of the expression in text")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * HL ⟵ Next address of expression")
  Th2HandbookHelp_L("  * A, E ⟵ Result of expression evaluation (A and E contains the same value.)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Evaluate an expression and make 1-byte integer output. When the result is beyond the range of 1-byte integer type, an " + Chr(34) + "Illegal function call" + Chr(34) + " error occurs and the execution returns to BASIC command level.")
  Th2HandbookHelp_Commit("GETBYT (521C/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#getbyt-521cmain", 138)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Register a string.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * [VALTYP (F663H)] ⟵ Type (if not string type, an error occurs)")
  Th2HandbookHelp_L("  * [DAC (F7F6H)]    ⟵ Pointer to string descriptor")
  Th2HandbookHelp_L("* **Output**: HL ⟵ Pointer to string descriptor")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Register the result of the string type obtained by FRMEVL and obtain its string descriptor. When evaluating a string, this is generally combined with FRMEVL described above to use as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@CALL    FRMEVL")
  Th2HandbookHelp_L("@@@PUSH    HL")
  Th2HandbookHelp_L("@@@CALL    FRESTR")
  Th2HandbookHelp_L("@@@EX      DE,HL")
  Th2HandbookHelp_L("@@@POP     HL")
  Th2HandbookHelp_L("@@@LD      A,(DE)")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@ .")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("FRESTR (67D0/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#frestr-67d0main", 139)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Obtain the address for the storage of a variable (see [[[Figure 2.16|||Chapter2#figure-216--inputoutput-state-of-ptrget]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * HL ⟵ Starting address of the variable name in text")
  Th2HandbookHelp_L("  * [SUBFLG (F6A5H)] ⟵ 0: Simple variable, other than 0: array variable")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * HL ⟵ Address after the variable name")
  Th2HandbookHelp_L("  * DE ⟵ Address where the contents of the objective variable is stored")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Obtain the address for the storage of a variable (or an array variable). Allocation of the area is also done when the area for the objective variable has not been allocated. When the value of SUBFLG is set to other than 0, the starting address of the array is obtained, other than individual elements of the array.")
  Th2HandbookHelp_Commit("PTRGET (5EA4/MAIN)", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#ptrget-5ea4main", 140)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.16]|||img:figure_2.16]]]")
  Th2HandbookHelp_Commit("_Figure 2.16  Input/output state of PTRGET_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-216-inputoutput-state-of-ptrget_", 141)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Execute a text")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: HL ⟵ Address of the text to be executed")
  Th2HandbookHelp_L("* **Output**:  ----")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Purpose: Execute a text. The state of the text is necessary to be as same as shown in [[[Figure 2.17|||Chapter2#figure-217--memory-setting-for-newstt]]].")
  Th2HandbookHelp_Commit("NEWSTT (4601H/MAIN", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#newstt-4601hmain", 142)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.17]|||img:figure_2.17]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since these internal routines are for BASIC texts, the same error handling as BASIC is done when an error occurs. In this case, by changing H.ERROR (FFB1H), the user can handle the error (the E register contains the error number) (see [[[List 2.3|||Chapter2#list-23--changing-error-handling-routine]]]).")
  Th2HandbookHelp_Commit("_Figure 2.17  Memory setting for NEWSTT_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-217-memory-setting-for-newstt_", 143)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 2.3   Your own error")
  Th2HandbookHelp_L("@@@;             To use,   do DEF USR=&HB000 : A=USR(0)")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@HERR    EQU     0FFB1H          ;error hook")
  Th2HandbookHelp_L("@@@SYNERR  EQU     2               ;syntax error code")
  Th2HandbookHelp_L("@@@CHPUT   EQU     0A2H            ;character output")
  Th2HandbookHelp_L("@@@NEWSTT  EQU     4601H           ;run")
  Th2HandbookHelp_L("@@@READYR  EQU     409BH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@                                Note:")
  Th2HandbookHelp_L("@@@;----- command initialize ----- When this portion is executed, the error handling routine is changed.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      BC,5            ;SET NEW HOOK")
  Th2HandbookHelp_L("@@@        LD      DE,HERR")
  Th2HandbookHelp_L("@@@        LD      HL,HDAT")
  Th2HandbookHelp_L("@@@        LDIR")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HDAT:   JP      ERROR")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@                                Note:")
  Th2HandbookHelp_L("@@@;----- error routine -----      Error handling body")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ERROR:  LD      A,E             ;when in error, E holds error code")
  Th2HandbookHelp_L("@@@        CP      SYNERR          ;syntax error ?")
  Th2HandbookHelp_L("@@@        RET     NZ              ;no")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      HL,DATA1        ;yes")
  Th2HandbookHelp_L("@@@LOOP:   LD      A,(HL)          ;put new error message")
  Th2HandbookHelp_L("@@@        CP      " + Chr(34) + "$" + Chr(34))
  Th2HandbookHelp_L("@@@        JR      Z,EXIT")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        CALL    CHPUT")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        JR      LOOP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@EXIT:   JP      READYR          ;BASIC hot start")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@DATA1:  DEFM    OOHPS!!         ;new error message")
  Th2HandbookHelp_L("@@@        DB      07H,07H,07H," + Chr(34) + "$" + Chr(34))
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 2.3  Changing error handling routine_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_list-23-changing-error-handling-routine_", 144)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The Z80 CPU has INT and NMI interrupt terminals. The MSX, however, uses only INT. The INT terminal gets 60 Hz signals, so timer interrupts are executed 60 times per 1 second. As the interrupt mode of Z80 is set to 1, 38H is called when an interrupt occurs and then the system control jumps to the timer interrupt routine, where various operations such as key input are done.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The timer interrupt routine jumps to hook H.TIMI (FD9FH) in mid course. Using this hook enables the user to add a function to this timer interrupt routine. Thogh there is ordinarily only a RET command, be careful when peripherals such as disks are connected and this hook is already in use. In this case, careless modifications causes peripherals to be disabled, so prearrangement is necessary to make machines to execute that normally. List 2.4 is an example of this handling and the interrupt usage.")
  Th2HandbookHelp_Commit("4.5 Interrupt usage", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#45-interrupt-usage", 145)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;*************************************************************")
  Th2HandbookHelp_L("@@@;   List 2.4   How to use HOOK safety")
  Th2HandbookHelp_L("@@@;              This routine uses TIMER INTERRUPT HOOK")
  Th2HandbookHelp_L("@@@;                                  and turn on/off CAPS LOCK")
  Th2HandbookHelp_L("@@@;              To start, do  DEF USR=&HB000 : A=USR(0)")
  Th2HandbookHelp_L("@@@;              To end,   do  DEF USR=&HB030 : A=USR(0)")
  Th2HandbookHelp_L("@@@;*************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CHGCAP  EQU     0132H           ;CAPS LAMP on/off")
  Th2HandbookHelp_L("@@@CAPST   EQU     0FCABH          ;CAPS LOCK status")
  Th2HandbookHelp_L("@@@TIMI    EQU     0FD9FH          ;timer interrupt hook")
  Th2HandbookHelp_L("@@@JPCODE  EQU     0C3H")
  Th2HandbookHelp_L("@@@TIMER   EQU     020H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- interrupt on ----- Note:  restore the former hook when changing the hook")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INTON:  DI")
  Th2HandbookHelp_L("@@@        LD      HL,TIMI         ;OLD HOOK SAVE")
  Th2HandbookHelp_L("@@@        LD      DE,HKSAVE")
  Th2HandbookHelp_L("@@@        LD      BC,5")
  Th2HandbookHelp_L("@@@        LDIR")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,JPCODE        ;NEW HOOK SET")
  Th2HandbookHelp_L("@@@        LD      (TIMI),A")
  Th2HandbookHelp_L("@@@        LD      HL,INT")
  Th2HandbookHelp_L("@@@        LD      (TIMI+1),HL")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B030H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- interrupt off ----- Note:  restore the reserved hook and exit")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INTOFF: DI")
  Th2HandbookHelp_L("@@@        LD      HL,HKSAVE")
  Th2HandbookHelp_L("@@@        LD      DE,TIMI")
  Th2HandbookHelp_L("@@@        LD      BC,5")
  Th2HandbookHelp_L("@@@        LDIR")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- interrupt routine -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INT:    PUSH    AF")
  Th2HandbookHelp_L("@@@        LD      A,(CAPST)")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        JR      Z,CAPON")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CAPOFF: LD      A,(COUNT1)")
  Th2HandbookHelp_L("@@@        DEC     A")
  Th2HandbookHelp_L("@@@        LD      (COUNT1),A")
  Th2HandbookHelp_L("@@@        JR      NZ,FIN")
  Th2HandbookHelp_L("@@@        LD      A,TIMER")
  Th2HandbookHelp_L("@@@        LD      (COUNT1),A")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        LD      (CAPST),A")
  Th2HandbookHelp_L("@@@        LD      A,0FFH")
  Th2HandbookHelp_L("@@@        CALL    CHGCAP")
  Th2HandbookHelp_L("@@@        JR      FIN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CAPON:  LD      A,(COUNT2)")
  Th2HandbookHelp_L("@@@        DEC     A")
  Th2HandbookHelp_L("@@@        LD      (COUNT2),A")
  Th2HandbookHelp_L("@@@        JR      NZ,FIN")
  Th2HandbookHelp_L("@@@        LD      A,TIMER")
  Th2HandbookHelp_L("@@@        LD      (COUNT2),A")
  Th2HandbookHelp_L("@@@        LD      A,0FFH")
  Th2HandbookHelp_L("@@@        LD      (CAPST),A")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    CHGCAP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@FIN:    POP     AF")
  Th2HandbookHelp_L("@@@        CALL    HKSAVE          ;old HOOK call")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@COUNT1: DEFB    TIMER")
  Th2HandbookHelp_L("@@@COUNT2: DEFB    TIMER")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@HKSAVE: NOP                     ;old HOOK save area")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@        NOP")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 2.4  Correct usage of timer interrupt hook_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_list-24-correct-usage-of-timer-interrupt-hook_", 146)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are some matters, when developing the software for MSX, that should be followed so as to make the software work without any problems on any MSX machines. The following describes these matters and introduces information that will help you develop software.")
  Th2HandbookHelp_Commit("5. NOTES ON SOFTWARE DEVELOPMENT", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#5-notes-on-software-development", 147)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The purpose of BIOS is to separate the hardware and the software and to make the software still valid if the hardware changes. Applications for sale which manage input and output should use BIOS (except for VDP).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("BIOS is called through the jump table which begins at 0000H of MAIN-ROM. Though MSX2 has a jump table on SUB-ROM, it is used for calling the extended functions. The branch destination of the jump table or, the contents of BIOS may be modified for the hardware modification or the extension of the function, so applications should not call them directly. Thogh this book has some examples that call addresses other than the BIOS jump table, you should consider them for information only (see [BIOS list](Appendix1.md) in APPENDIX). Applications can call Math-Pack and internal routines for the extended statements described above. These will not be changed in the future.")
  Th2HandbookHelp_Commit("BIOS", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#bios", 148)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("F380H to FFFFH of MAIN-RAM cannot be used, as it is a work area for BIOS and BASIC interpreter. Free space in the work area cannot be used, because it is reserved for the future use. See [[[3.1 User's area|||Chapter2#31-users-area]]] for the work area of the disk.")
  Th2HandbookHelp_Commit("Work area", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#work-area", 149)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The contents of RAM are unpredictable when the machine is powered and areas other than system work are are not initialised. Applications should initialise the work area. There was once an application which expected the contents of RAM to be 00H and was unusable.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The value of the stack pointer when the INIT routine (see [Section 7 of Chapter 5](Chapter5b.md)) in the ROM cartridge is called is unpredictable and the value when disk interface has been initialised is smaller than when not. For these reasons some programs which did not initialise the stack pointer had unpredictable results. Programs which are invoked by the INIT routine and continue processing (that is, programs which do not need to use peripherals such as disks or BASIC interpreter) should initialise the stack pointer.")
  Th2HandbookHelp_Commit("Initialisation of RAM and stack pointer", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#initialisation-of-ram-and-stack-pointer", 150)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When using extended BIOS calls, a stack should be placed above C000H so that CPU can refer to the work area even if the slot is switched over. For the same reason, FCB of RS-232C should be above 8000H.")
  Th2HandbookHelp_Commit("Work area of extended BIOS", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#work-area-of-extended-bios", 151)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Special attention should be paid for the allocation of the work area of programs which reside in memory with another program at the same time, programs such as the device driver or a subroutine called from BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The INIT routine of the cartridge changes BOTTOM (FC48H), reserves the area between the old BOTTOM and new BOTTOM as its work area, and records the address of the work area to 2-byte area SLTWRK (FD09H) allocated for each slot. For more details, see [Section 7 of Chapter 5](Chapter5b.md).")
  Th2HandbookHelp_Commit("Work area of device drivers, etc.", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#work-area-of-device-drivers-etc", 152)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When using the RS-232C cartridge, change the hook for an interrupt. For example, if another cartridge uses an interrupt hook, the RS-232C cartridge cannot use the same hook. To prevent this, the previous contents of the hook (inter-slot call command for the interrupt handling routine of RS-232C cartridge, in the example above) should be copied to another location, and, when called by the hook, it should be called so that all cartridges intending to use the hook can receive control (see [[[Figure 2.18|||Chapter2#figure-218--initialisation-of-the-hook]]]). For more details, see [Section 7 of Chapter 5](Chapter5b.md).")
  Th2HandbookHelp_Commit("Hook", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#hook", 153)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.18]|||img:figure_2.18]]]")
  Th2HandbookHelp_Commit("_Figure 2.18  Initialisation of the hook_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-218-initialisation-of-the-hook_", 154)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The capacity of VRAM can be found by evaluating bits 1 and 2 of MODE (FAFCH) (see [[[Table 2.22|||Chapter2#table-222--getting-the-information-about-the-vram-capacity]]]).")
  Th2HandbookHelp_Commit("VRAM capacity", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#vram-capacity", 155)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------")
  Th2HandbookHelp_L("@@@|    [FAFCH]    |                |")
  Th2HandbookHelp_L("@@@|---------------|  VRAM Capacity |")
  Th2HandbookHelp_L("@@@| Bit 2 | Bit 1 |                |")
  Th2HandbookHelp_L("@@@|-------+-------+----------------|")
  Th2HandbookHelp_L("@@@|   0   |   0   |   16K (MSX1)   |")
  Th2HandbookHelp_L("@@@|   0   |   1   |   64K (MSX2)   |")
  Th2HandbookHelp_L("@@@|   1   |   0   |  128K (MSX2)   |")
  Th2HandbookHelp_L("@@@----------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 2.22  Getting the information about the VRAM capacity_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_table-222-getting-the-information-about-the-vram-capacity_", 156)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following methods can be used for applications to find out the version number of BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Read the contents of 2DH of MAIN-ROM (00H = version 1.0, 01H = version 2.0, and so on).")
  Th2HandbookHelp_L("2. In version 2.0 or later versions, EXBRSA (FAF8H) contains the slot address of SUB-ROM. When it has none (00H), the version is version 1.0.")
  Th2HandbookHelp_Commit("BASIC version number", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#basic-version-number", 157)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are different kinds of MSX for various countries. The following items are different by country:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- Keyboard arrangement, character set, PRINT USING format")
  Th2HandbookHelp_L("- Timer interrupt frequency")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The version of machine can be found by reading the ID byte information in ROM (see [[[Figure 2.19|||Chapter2#figure-219--contents-of-id-byte]]]) and the correspondence for MSX of each country will be accomplished (see [[[Table 2.23|||Chapter2#table-223--msx-format-for-each-country]]]).")
  Th2HandbookHelp_Commit("International MSX", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#international-msx", 158)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------")
  Th2HandbookHelp_L("@@@| 2BH |   b0  --+")
  Th2HandbookHelp_L("@@@-------         |  character generator")
  Th2HandbookHelp_L("@@@          b1    |")
  Th2HandbookHelp_L("@@@                |  0: Japan     1: United States, etc.")
  Th2HandbookHelp_L("@@@          b2    |  2: USSR")
  Th2HandbookHelp_L("@@@                |")
  Th2HandbookHelp_L("@@@          b3  --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@          b4  --+")
  Th2HandbookHelp_L("@@@                |  date format")
  Th2HandbookHelp_L("@@@          b5    |")
  Th2HandbookHelp_L("@@@                |  0:Y/M/D      1:M/D/Y       2:D/M/Y")
  Th2HandbookHelp_L("@@@          b6  --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@          b7       interrupt period (VSYNC)")
  Th2HandbookHelp_L("@@@                   0:60Hz       1:50Hz")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------")
  Th2HandbookHelp_L("@@@| 2CH |   b0  --+")
  Th2HandbookHelp_L("@@@-------         |  keyboard")
  Th2HandbookHelp_L("@@@          b1    |")
  Th2HandbookHelp_L("@@@                |  0:Japan      1:United States, etc.")
  Th2HandbookHelp_L("@@@          b2    |  2:France     3:United Kingdom")
  Th2HandbookHelp_L("@@@                |  4:Germany    5:USSR          6:Spain")
  Th2HandbookHelp_L("@@@          b3  --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@          b4  --+")
  Th2HandbookHelp_L("@@@                |")
  Th2HandbookHelp_L("@@@          b5    |  information about PRINT USING")
  Th2HandbookHelp_L("@@@                |  or others")
  Th2HandbookHelp_L("@@@          b6    |")
  Th2HandbookHelp_L("@@@                |")
  Th2HandbookHelp_L("@@@          b7  --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 2.19  Contents of ID byte_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-219-contents-of-id-byte_", 159)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|           |              |          |             PRINT USING             |")
  Th2HandbookHelp_L("@@@|           |              |   Date   |-------------------------------------|")
  Th2HandbookHelp_L("@@@|  Country  |    TV set    |          | Initial  | String | Re-   | Curren- |")
  Th2HandbookHelp_L("@@@|           |              |  format  | screen   | length | place | cy      |")
  Th2HandbookHelp_L("@@@|           |              |          | mode     | specif.| char. | symbol  |")
  Th2HandbookHelp_L("@@@|-----------+--------------+----------+----------+--------+-------+---------|")
  Th2HandbookHelp_L("@@@| Japan     | NTSC  (60Hz) | YY/MM/DD | Screen 1 |   &    |  @    |  (yen)  |")
  Th2HandbookHelp_L("@@@| UK        | PAL   (50Hz) | DD/MM/YY | Screen 0 |   \    |  &    | (pound) |")
  Th2HandbookHelp_L("@@@| Internat. | PAL   (50Hz) | MM/DD/YY | Screen 0 |   \    |  &    |$(dollar)|")
  Th2HandbookHelp_L("@@@| US        | NTSC  (60Hz) | MM/DD/YY | Screen 0 |   \    |  &    |$(dollar)|")
