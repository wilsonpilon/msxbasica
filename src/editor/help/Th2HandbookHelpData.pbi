  Th2HandbookHelp_L("* **Function**: reads the PSG register value")
  Th2HandbookHelp_L("* **Input**: A for PSG register number")
  Th2HandbookHelp_L("* **Output**: A for the value which was read")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("RDPSG (0096H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rdpsg-0096h-1", 805)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: tests whether the PLAY statement is being executed as a background task. If not, begins to execute the PLAY statement")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("STRTMS (0099H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#strtms-0099h-1", 806)

