; Auto-gerado por convert_th2handbook.py (descartavel, nao versionado) a
; partir do MSX2 Technical Handbook (ASCII Corporation, 1987), edicao Markdown
; mantida por Konamiman (Nestor Soriano - ja creditado no README pelo Nestor80)
; - github.com/Konamiman/MSX2-Technical-Handbook. Conteudo reproduzido como no
; original; os links internos (~mesma ideia do Livro Vermelho) viram anchor
; "<arquivo>#<slug-github>" (cada link do original e' sempre dentro do MESMO
; arquivo .md, nunca entre capitulos, entao precisa ficar qualificado por
; arquivo pra nao colidir - varios arquivos tem um heading "Index" por exemplo).

Structure Th2HandbookHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList Th2HandbookHelp_Topics.Th2HandbookHelpTopic()
Global NewMap Th2HandbookHelp_AnchorMap.i()
Global Th2HandbookHelp_DataBuilt.b = #False
Global NewList Th2HandbookHelp_Scratch.s()

Procedure Th2HandbookHelp_Begin()
  ClearList(Th2HandbookHelp_Scratch())
EndProcedure

Procedure Th2HandbookHelp_L(Line.s)
  AddElement(Th2HandbookHelp_Scratch())
  Th2HandbookHelp_Scratch() = Line
EndProcedure

Procedure Th2HandbookHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach Th2HandbookHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + Th2HandbookHelp_Scratch()
    First = #False
  Next
  AddElement(Th2HandbookHelp_Topics())
  Th2HandbookHelp_Topics()\Titulo = Titulo
  Th2HandbookHelp_Topics()\Grupo = Grupo
  Th2HandbookHelp_Topics()\Corpo = Body
EndProcedure

Procedure Th2HandbookHelp_AddAnchor(Anchor.s, TopicIdx.i)
  Th2HandbookHelp_AnchorMap(Anchor) = TopicIdx
EndProcedure

Procedure Th2HandbookHelp_BuildData()
  If Th2HandbookHelp_DataBuilt
    ProcedureReturn
  EndIf
  Th2HandbookHelp_DataBuilt = #True

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MSX2 was designed to be fully compatible with the MSX1, but there are many enhanced features in the MSX2. Chapter 1 introduces the enhanced features of the MSX2, and shows block figures and standard tables. This information is conceptual, but will be needed to understand descriptions in volume 2 and later.")
  Th2HandbookHelp_Commit("CHAPTER 1 - MSX SYSTEM OVERVIEW", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#chapter-1---msx-system-overview", 0)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[1. FROM MSX1 TO MSX2|||Chapter1#1-from-msx1-to-msx2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[1.1 What is MSX?|||Chapter1#11-what-is-msx]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[1.2 Environment of the MSX|||Chapter1#12-environment-of-the-msx]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[1.3 Extended Contents of MSX2|||Chapter1#13-extended-contents-of-msx2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2. MSX2 SYSTEM OVERVIEW|||Chapter1#2-msx2-system-overview]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2.1 Hardware overview|||Chapter1#21-hardware-overview]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2.1.1 Address map|||Chapter1#211-address-map]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2.1.2 Interfacing with peripherals|||Chapter1#212-interfacing-with-peripherals]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[2.2 Software Overview|||Chapter1#22-software-overview]]]")
  Th2HandbookHelp_Commit("Index", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#index", 1)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To begin with, let us took back to the original purpose or intention of MSX and then sum up the transition from MSX1 to MSX2.")
  Th2HandbookHelp_Commit("1. FROM MSX1 TO MSX2", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#1-from-msx1-to-msx2", 2)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX was announced as a new 8-bit computer standard in the autumn of 1983. In early days the word " + Chr(34) + "compatibility" + Chr(34) + " was not understood correctly and there were misunderstandings that MSX could execute programs from other computers. Since MSX can execute programs only for MSX, it was said that were was no difference from the PC series (NEC) or FM series (Fujitsu) personal computers, which could only execute programs using their format.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Several years passed before personal computers became popular. In the early days only dedicated enthusiasts bought computers, which were difficult to use, and, needless to say, incompatible. They were satisfied to tinker with the computer and study it. But now computer use has expanded to include several classes of users. In other words, the personal computer is becoming a commodity item such as televisions or radio cassette recorders. Therefore, " + Chr(34) + "compatibility" + Chr(34) + " is coming to be a problem. If each TV station needs a different television set or if each radio cassette recorder needs a different tape, do you suppose they would be popular? Software or programs of the computer as a home electric product must be compatible.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The design team for MSX considered these problems. Since a computer is most powerful when left flexible and easy to expand, a " + Chr(34) + "final" + Chr(34) + " standard format was not practical. There are too many matters to define and hardware is constantly improving. Therefore MSX started with fixing format of the most fundamental harware and software such as DOS and BASIC, and the hardware bus which is the basis for expansion. Since the computer is used by itself and does not interact with other computers, the problem is small. But formats must be fixed if the computer is to be connected to " + Chr(34) + "peripherals" + Chr(34) + " and handle or accumulate various data. Fortunately MSX had the approval of many home appliance electric companies and an MSX format was established early. This allowed the system to be well known so that several manufacturers could make compatible peripherals for the MSX standard.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Some of the useful features included in the MSX system include the use of double precision BCD for normal BASIC arithmetic and the same file format as MS-DOS. The real capabilities of the MSX machine will come to light as it is used across several fields.")
  Th2HandbookHelp_Commit("1.1 What is MSX?", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#11-what-is-msx", 3)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Over one million MSX machines had been sold by December 1985 and are used mainly as game machines or primers by primary and junior high school students. But MSX use has gradually spread to include such uses as communication terminals, Japanese word processing, factory automation, and audio visual control. For improving its capabilities, a disk system and MSX-DOS have been prepared, and languages such as C, FORTH, and LOGO are available. BIOS, which is the collection of input/output routines in BASIC ROM, and BDOS, which resides in the disk interface ROM and has compatibility with CP/M system calls, have both been improved. So an excellent programming environment is now available. Chinese Character input, light pen and mouse input, and the RS-232C interface have been standardised, and stantardisation of other peripherals is proceeding. The keyboard and character set are consistent with international standards, and there are minor variations to satisfy the needs of individual countries.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Several new peripherals have been developed. Standard devices include printers, disk drives, and mice; audio/visual devices include laser drives, VTRs, synthesizer controllers, and video acquisition systems. Factory Automation devices include robot controllers, room temperature controllers, various adaptors for modem and telephone lines, and a health controller combined with a hemadynamometer has been developed. So you can see that the potential uses for MSX computers has really grown.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Many applications other than games are now supplied on disks and are becoming more practical. There are now Japanese word processors capable of clause transformation, data bases which can exchange data with higher-level systems, and CAI and CAD systems.")
  Th2HandbookHelp_Commit("1.2 Environment of the MSX", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#12-environment-of-the-msx", 4)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX2 was announced in May 1985 as a system having upgraded compatibility with MSX. Programs created under the MSX environment can be executed on MSX2 without any modifications, even at the assembly language level. Data and programs stored on cassette tapes or disks can be used without modification. Features added by the MSX2 system are improved screen display, higher resolution, more colours available, and higher graphics speed. A battery-powered clock and RAMDISK feature have also been added. In this manual the name MSX2 refers to the computer made along the MSX2 standard and the name MSX1 refers to the computer made along the previous MSX standard.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("System configuration is shown in Figures [[[1.1|||Chapter1#figure-11--msx2-system-configuration]]] and [[[1.2|||Chapter1#figure-12--msx1-system-configuration]]] and [[[Table 1.1|||Chapter1#table-11-msx2msx1-standard-comparison]]] and indicate the differences between MSX1 and MSX2. The differences are described as follows:")
  Th2HandbookHelp_Commit("1.3 Extended Contents of MSX2", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#13-extended-contents-of-msx2", 5)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                             MSX2              |           MSX1")
  Th2HandbookHelp_L("@@@                -------------------------------+---------------------------")
  Th2HandbookHelp_L("@@@CPU             |    Z80A or equivalent (clock 3.579545 MHz +- 1%)        |")
  Th2HandbookHelp_L("@@@                |------------------------------+--------------------------|")
  Th2HandbookHelp_L("@@@                | 48K (MSX-BASIC version 2.0)  |  32K (MSX-BASIC ver 1.0) |")
  Th2HandbookHelp_L("@@@          ROM   |      MAIN-ROM 32K            |       MAIN-ROM 32K       |")
  Th2HandbookHelp_L("@@@                |      SUB-ROM  16K            |                          |")
  Th2HandbookHelp_L("@@@MEMORY    RAM   | 64K or more                  |  8K or more              |")
  Th2HandbookHelp_L("@@@          VRAM  | 64K or 128K                  |  16K                     |")
  Th2HandbookHelp_L("@@@                |------------------------------+--------------------------|")
  Th2HandbookHelp_L("@@@LSI for VDP     | V-9938 (MSX-VIDEO)           |  TMS9918 or equivalent   |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@CMT             |                 FSK  1200/2400 baud                     |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@PSG             |    8 octaves tri-chord output (AY-3-8910 compatible)    |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@Keyboard        | Alphanumeric                 |  Alphanumeric            |")
  Th2HandbookHelp_L("@@@                | Graphic symbols              |  Graphic symbols         |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@Floppy disk (*) |                Based on MS-DOS format                   |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@Printer         | 8-bit parallel               |  (*)                     |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@ROM cartridge   |                        I/O bus                          |")
  Th2HandbookHelp_L("@@@                |     with slot for game cartridge and expansion bus      |")
  Th2HandbookHelp_L("@@@                |---------------------------------------------------------|")
  Th2HandbookHelp_L("@@@Joystick        |              2               |  1 or 2 (*)              |")
  Th2HandbookHelp_L("@@@                |------------------------------+--------------------------|")
  Th2HandbookHelp_L("@@@CLOCK-IC        | Standard                     |  (*)                     |")
  Th2HandbookHelp_L("@@@                |------------------------------+--------------------------|")
  Th2HandbookHelp_L("@@@RAM disk        | Standard                     |  Different for           |")
  Th2HandbookHelp_L("@@@feature         |                              |  each maker              |")
  Th2HandbookHelp_L("@@@                -----------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                (*) Optional")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 1.1 MSX2/MSX1 standard comparison_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_table-11-msx2msx1-standard-comparison_", 6)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 1.1]|||img:figure_1.1]]]")
  Th2HandbookHelp_Commit("_Figure 1.1  MSX2 system configuration_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_figure-11-msx2-system-configuration_", 7)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 1.2]|||img:figure_1.2]]]")
  Th2HandbookHelp_Commit("_Figure 1.2  MSX1 system configuration_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_figure-12-msx1-system-configuration_", 8)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("BASIC has also been extended from version 1.0 to version 2.0 in order to support a new VDP, backup RAM, CLOCK-IC, and so on. Compatibility with MSX1 is maintained. When using the newly extended screen mode, be careful when specifiyng range, since ranges are slightly different in MSX2.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("MSX2 has three types of memory, ROM, RAM, VRAM, which are described below.")
  Th2HandbookHelp_Commit("MSX-BASIC", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#msx-basic", 9)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Standard ROM size is 48K bytes. The MSX ROM uses only 32K bytes. The extra 16K bytes portion of the MSX2 contains routines supporting the extended features.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The " + Chr(34) + "MAIN-ROM" + Chr(34) + " consists of 32K bytes and contains the BASIC interpreter, and the " + Chr(34) + "extended ROM" + Chr(34) + " or " + Chr(34) + "SUB-ROM" + Chr(34) + " consists of 16K bytes and contains routines for the extended features.")
  Th2HandbookHelp_Commit("ROM", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#rom", 10)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Standard RAM size is 64K bytes, which is large enough so that MSX-DOS can be executed. The RAM size of MSX1 varied from 8K to 64K bytes, so in some cases large programs could not be executed without expanding RAM. MSX2 does not have this problem.")
  Th2HandbookHelp_Commit("RAM", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#ram", 11)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("A minimum of 64K bytes are required for VRAM in order to execute the added features of the screen display. VRAM is thus four times larger than in MSX1, which had only 16 K bytes VRAM. But many machines actually use a VRAM size of 128K bytes, which is eight times larger. Machines with 128K bytes VRAM can display 256 colours at the same time.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("MSX machines which have 64K bytes VRAM but cannot be expanded to 128K bytes are marked " + Chr(34) + "VRAM64K" + Chr(34) + " on their catalogue or packaging.")
  Th2HandbookHelp_Commit("VRAM", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#vram", 12)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MSX series computers use a video display processor (VDP) type LSI chip for controlling the screen output. The VDP used for MSX1 was the TMS9918, but the MSX2 uses the V9938 (MSX-VIDEO), which has upper and full compatibility with the TMS9918 and can execute software for TMS9918 without any modification.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Table 1.2|||Chapter1#table-12--vdp-specifications]]] shows the VDP standard and [[[Table 1.3|||Chapter1#table-13--v9938-screen-mode]]] shows each screen mode. V9938 is an excellent LSI chip with digitising, superimposing, and hardware scrolling features. [Chapter 4](Chapter4a.md) of this manual describes it in detail.")
  Th2HandbookHelp_Commit("VDP", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#vdp", 13)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                                    V9938           |       TMS9918")
  Th2HandbookHelp_L("@@@                        ----------------------------+----------------------")
  Th2HandbookHelp_L("@@@Screen mode             |  10 (see table 1.3)       |          4          |")
  Th2HandbookHelp_L("@@@                        |---------------------------+---------------------|")
  Th2HandbookHelp_L("@@@Number of dots          |  512 x 212 maximum        |                     |")
  Th2HandbookHelp_L("@@@(horizontal x           |  424 dots for vertical    |  256 x 192 maximum  |")
  Th2HandbookHelp_L("@@@vertical)               |  can be achieved by       |                     |")
  Th2HandbookHelp_L("@@@                        |  interlace feature        |                     |")
  Th2HandbookHelp_L("@@@                        |---------------------------+---------------------|")
  Th2HandbookHelp_L("@@@          Number of     |                           |                     |")
  Th2HandbookHelp_L("@@@          colours to    |  512 maximum              |   16 maximum        |")
  Th2HandbookHelp_L("@@@          specify       |                           |                     |")
  Th2HandbookHelp_L("@@@Colour                  |---------------------------+---------------------|")
  Th2HandbookHelp_L("@@@          Number of     |                           |                     |")
  Th2HandbookHelp_L("@@@          colours to    |  256 maximum              |   16 maximum        |")
  Th2HandbookHelp_L("@@@          display at    |                           |                     |")
  Th2HandbookHelp_L("@@@          the same time |                           |                     |")
  Th2HandbookHelp_L("@@@                        |-------------------------------------------------|")
  Th2HandbookHelp_L("@@@Character set           |           alphanumeric + graphic symbols        |")
  Th2HandbookHelp_L("@@@                        |             256 characters  8 x 8 dots          |")
  Th2HandbookHelp_L("@@@                        |-------------------------------------------------|")
  Th2HandbookHelp_L("@@@Sprite colour           |  16 maximum per sprite    |   1 per sprite      |")
  Th2HandbookHelp_L("@@@                        |---------------------------+---------------------|")
  Th2HandbookHelp_L("@@@Palette feature         |  Yes                      |   No                |")
  Th2HandbookHelp_L("@@@                        ---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 1.2  VDP specifications_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_table-12-vdp-specifications_", 14)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Mode            Number of       Dots       Colours      Palette   Sprite")
  Th2HandbookHelp_L("@@@                characters")
  Th2HandbookHelp_L("@@@---------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@* Text 1      |  40 x 24   |           |   2 from 512 |   Yes   |   No")
  Th2HandbookHelp_L("@@@  Text 2      |  80 x 24   |           |   4 from 512 |   Yes   |   No")
  Th2HandbookHelp_L("@@@* Multi-colour|            |  64 x  48 |  16 from 512 |   Yes   |  Mode 1")
  Th2HandbookHelp_L("@@@* Graphic 1   |  32 x 24   |           |  16 from 512 |   Yes   |  Mode 1")
  Th2HandbookHelp_L("@@@* Graphic 2   |            | 256 x 192 |  16 from 512 |   Yes   |  Mode 1")
  Th2HandbookHelp_L("@@@  Graphic 3   |            | 256 x 192 |  16 from 512 |   Yes   |  Mode 2")
  Th2HandbookHelp_L("@@@  Graphic 4   |            | 256 x 212 |  16 from 512 |   Yes   |  Mode 2")
  Th2HandbookHelp_L("@@@  Graphic 5   |            | 512 x 212 |   4 from 512 |   Yes   |  Mode 2")
  Th2HandbookHelp_L("@@@  Graphic 6   |            | 512 x 212 |  16 from 512 |   Yes   |  Mode 2")
  Th2HandbookHelp_L("@@@  Graphic 7   |            | 256 x 212 | 256 from 256 |   No    |  Mode 2")
  Th2HandbookHelp_L("@@@---------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@(*) Feature modes available from TMS9918 (however, palette feature only from V9938).")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 1.3  V9938 screen mode_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_table-13-v9938-screen-mode_", 15)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Battery-powered RAM is connected to the I/O port and is used for storage of setup information and for keeping track of the date and time. Setup information specifies the screen colour and mode at reset. This allows the user to set up the desired environment when the system is booted.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The CLOCK-IC works independently of the main power supply. After being set once new time settings are no longer required.")
  Th2HandbookHelp_Commit("Battery-powered Clock-IC", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#battery-powered-clock-ic", 16)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When using BASIC on MSX1 machines which had 64K bytes RAM, only 32K bytes of RAM were used; the other 32K bytes were unused since the BASIC interpreter occupied the address space. On MSX2 machines this unused RAM can be used as a RAMDISK. For users who do not have a disk drive, this feature is very useful when loading or saving BASIC programs temporarily.")
  Th2HandbookHelp_Commit("RAM Disk Feature", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#ram-disk-feature", 17)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This section gives a simple overview of the MSX2 software and hardware systems. To help you understand the concepts, diagrams which would be useful when developing software, such as [VRAM map](Appendix5.md), the [I/O map](Appendix6.md), and the interface standard, are found in the APPENDIX of this manual.")
  Th2HandbookHelp_Commit("2. MSX2 SYSTEM OVERVIEW", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#2-msx2-system-overview", 18)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("First of all, look at the block diagram in [[[Figure 1.3|||Chapter1#figure-13--msx2-block-diagram]]] to understand the hardware configuration of the MSX2 as a whole.")
  Th2HandbookHelp_Commit("2.1 Hardware overview", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#21-hardware-overview", 19)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 1.3]|||img:figure_1.3]]]")
  Th2HandbookHelp_Commit("_Figure 1.3  MSX2 block diagram_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_figure-13-msx2-block-diagram_", 20)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MSX2 has three kinds of memory: MAIN-ROM, SUB-ROM, and RAM. Each memory resides in an independent 64K address space and is allocated as shown in [[[Figure 1.4|||Chapter1#figure-14--msx2-standard-memory]]] (1) (each 64K space is called a " + Chr(34) + "slot" + Chr(34) + ", which consists of four 16K areas called " + Chr(34) + "pages" + Chr(34) + "). [[[Figures 1.3|||Chapter1#figure-13--msx2-block-diagram]]] (2) and (3) show memory usage when using BASIC and MSX-DOS, respectively.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("For each class of memory, [[[Figure 1.5|||Chapter1#figure-15--main-rom-memory-map]]] shows the memory map of [[[Figure 1.4|||Chapter1#figure-14--msx2-standard-memory]]] (1)(a), [[[Figure 1.6|||Chapter1#figure-16--sub-rom-memory-map]]] for [[[Figure 1.4|||Chapter1#figure-14--msx2-standard-memory]]] (1)(b), and [[[Figure 1.7|||Chapter1#figure-17--main-ram-memory-map]]] for [[[Figure 1.4|||Chapter1#figure-14--msx2-standard-memory]]] (1)(c). There is also a [VRAM map](Appendix5.md) and [I/O map](Appendix6.md) whose standards are defined. They are found in the APPENDIX.")
  Th2HandbookHelp_Commit("Memory map", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#memory-map", 21)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@(1) Physical allocation of standard memories")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@             (a)            (b)            (c)")
  Th2HandbookHelp_L("@@@0000H   -------------  -------------  -------------")
  Th2HandbookHelp_L("@@@Page 0  |    (1)    |  |    (3)    |  |    (4)    |")
  Th2HandbookHelp_L("@@@        | MAIN-ROM  |  |  SUB-ROM  |  |    RAM    |")
  Th2HandbookHelp_L("@@@4000H   | - - - - - |  |-----------|  | - - - - - |")
  Th2HandbookHelp_L("@@@Page 1  |    (2)    |  |   not     |  |    (5)    |")
  Th2HandbookHelp_L("@@@        | MAIN-ROM  |  |   used    |  |    RAM    |")
  Th2HandbookHelp_L("@@@8000H   |-----------|  | - - - - - |  | - - - - - |")
  Th2HandbookHelp_L("@@@Page 2  |   not     |  |   not     |  |    (6)    |")
  Th2HandbookHelp_L("@@@        |   used    |  |   used    |  |    RAM    |")
  Th2HandbookHelp_L("@@@C000H   | - - - - - |  | - - - - - |  | - - - - - |")
  Th2HandbookHelp_L("@@@Page 3  |   not     |  |   not     |  |    (7)    |")
  Th2HandbookHelp_L("@@@        |   used    |  |   used    |  |    RAM    |")
  Th2HandbookHelp_L("@@@        -------------  -------------  -------------")
  Th2HandbookHelp_L("@@@          MAIN-ROM        SUB-ROM        64K-RAM")
