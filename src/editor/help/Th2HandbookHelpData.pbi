  Th2HandbookHelp_L("@@@|  -------  |     |  -------  |---  -------  |  |  #7 |  :::::::  :  #9 :  |")
  Th2HandbookHelp_L("@@@|           -------     |  #3 |        |  #6 |  |     |           |     |  |")
