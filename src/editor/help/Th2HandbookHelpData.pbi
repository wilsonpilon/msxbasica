  Th2HandbookHelp_L("`FIELD [#]<filenumber>, <field width> AS <string variable name>[, <field width> AS <string variable name>...]`  |  Statement  |  Assigns the string variable name to the random input/output buffer.")
  Th2HandbookHelp_L("`FILES [" + Chr(34) + "<filename>" + Chr(34) + "]`  |  Command  |  Displays the name of the file matched with `<filename>` on the screen.")
  Th2HandbookHelp_L("**`** FILES [" + Chr(34) + "<filename>" + Chr(34) + "][,L]`**  |  Command  |  Displays the name of the file matched with `<filename>` on the screen, and also the attributes and the size of the file if " + Chr(34) + "L" + Chr(34) + " is specified.")
  Th2HandbookHelp_Commit("--- F ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#f-1", 62)

  Th2HandbookHelp_Begin()
