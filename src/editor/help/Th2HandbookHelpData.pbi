  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Changes from the original|||Chapter4a#changes-from-the-original]]]")
  Th2HandbookHelp_Commit("Index", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#index", 317)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following features of the MSX-VIDEO give it a better display capabilities than the TMS9918A:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* 512 colours with a 9-bit colour palette")
  Th2HandbookHelp_L("* Max. 512 x 424 dot resolution (when using the interlace)")
  Th2HandbookHelp_L("* Max. 256 colours at the same time")
  Th2HandbookHelp_L("* Full bitmap mode which makes graphic operations easy")
  Th2HandbookHelp_L("* Text display mode of 80 characters per line")
  Th2HandbookHelp_L("* LINE, SEARCH, AREA-MOVE executable by hardware")
  Th2HandbookHelp_L("* Up to 8 sprites on the same horizontal line")
  Th2HandbookHelp_L("* Different colours can be specified for each line in a sprite")
  Th2HandbookHelp_L("* Video signal digitizing feature built-in")
  Th2HandbookHelp_L("* Superimpose feature built-in")
  Th2HandbookHelp_Commit("1.  MSX-VIDEO CONFIGURATION", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#1-msx-video-configuration", 318)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO uses 49 internal registers for its screen operations. These registers are referred to as " + Chr(34) + "VDP registers" + Chr(34) + " in this book. VDP registers are classified by function into three groups as described below. The control register group and status register group can be referred to using VDP(n) system variables from BASIC.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(1) Control register group (R#0 to R#23, R#32 to R#46)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This is a read-only 8-bit register group controlling MSX-VIDEO actions. Registers are expressed using the notation R#n. R#0 to R#23 are used to set the screen mode. R#32 to R#46 are used to execute VDP commands. These VDP commands will be described in detail in [[[section 5|||Chapter4a#5-sprites]]]. Control registers R#24 to R#31 do not exist. The roles of the different control registers are listed in [[[Table 4.1|||Chapter4a#table-41--control-register-list]]].")
  Th2HandbookHelp_Commit("1.1 Registers", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#11-registers", 319)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|      | Corres- |                                                          |")
  Th2HandbookHelp_L("@@@| R#n  | ponding |                        Function                          |")
  Th2HandbookHelp_L("@@@|      | VDP(n)  |                                                          |")
  Th2HandbookHelp_L("@@@|------+---------+----------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| R#0  | VDP(0)  | mode register #0                                         |")
  Th2HandbookHelp_L("@@@| R#1  | VDP(1)  | mode register #1                                         |")
  Th2HandbookHelp_L("@@@| R#2  | VDP(2)  | pattern name table                                       |")
  Th2HandbookHelp_L("@@@| R#3  | VDP(3)  | colour table (LOW)                                       |")
  Th2HandbookHelp_L("@@@| R#4  | VDP(4)  | pattern generator table                                  |")
  Th2HandbookHelp_L("@@@| R#5  | VDP(5)  | sprite attribute table (LOW)                             |")
  Th2HandbookHelp_L("@@@| R#6  | VDP(6)  | sprite pattern generator table                           |")
  Th2HandbookHelp_L("@@@| R#7  | VDP(7)  | border colour/character colour at text mode              |")
  Th2HandbookHelp_L("@@@| R#8  | VDP(9)  | mode register #2                                         |")
  Th2HandbookHelp_L("@@@| R#9  | VDP(10) | mode register #3                                         |")
  Th2HandbookHelp_L("@@@| R#10 | VDP(11) | colour table (HIGH)                                      |")
  Th2HandbookHelp_L("@@@| R#11 | VDP(12) | sprite attribute table (HIGH)                            |")
  Th2HandbookHelp_L("@@@| R#12 | VDP(13) | character colour at text blinks                          |")
  Th2HandbookHelp_L("@@@| R#13 | VDP(14) | blinking period                                          |")
  Th2HandbookHelp_L("@@@| R#14 | VDP(15) | VRAM access address (HIGH)                               |")
  Th2HandbookHelp_L("@@@| R#15 | VDP(16) | indirect specification of S#n                            |")
  Th2HandbookHelp_L("@@@| R#16 | VDP(17) | indirect specification of P#n                            |")
  Th2HandbookHelp_L("@@@| R#17 | VDP(18) | indirect specification of R#n                            |")
  Th2HandbookHelp_L("@@@| R#18 | VDP(19) | screen location adjustment (ADJUST)                      |")
  Th2HandbookHelp_L("@@@| R#19 | VDP(20) | scanning line number when the interrupt occurs           |")
  Th2HandbookHelp_L("@@@| R#20 | VDP(21) | colour burst signal 1                                    |")
  Th2HandbookHelp_L("@@@| R#21 | VDP(22) | colour burst signal 2                                    |")
  Th2HandbookHelp_L("@@@| R#22 | VDP(23) | colour burst signal 3                                    |")
  Th2HandbookHelp_L("@@@| R#23 | VDP(24) | screen hard scroll                                       |")
  Th2HandbookHelp_L("@@@|      |         |                                                          |")
  Th2HandbookHelp_L("@@@| R#32 | VDP(33) | SX: X-coordinate to be transferred (LOW)                 |")
  Th2HandbookHelp_L("@@@| R#33 | VDP(34) | SX: X-coordinate to be transferred (HIGH)                |")
  Th2HandbookHelp_L("@@@| R#34 | VDP(35) | SY: Y-coordinate to be transferred (LOW)                 |")
  Th2HandbookHelp_L("@@@| R#35 | VDP(36) | SY: Y-coordinate to be transferred (HIGH)                |")
  Th2HandbookHelp_L("@@@| R#36 | VDP(37) | DX: X-coordinate to be transferred to (LOW)              |")
  Th2HandbookHelp_L("@@@| R#37 | VDP(38) | DX: X-coordinate to be transferred to (HIGH)             |")
  Th2HandbookHelp_L("@@@| R#38 | VDP(39) | DY: Y-coordinate to be transferred to (LOW)              |")
  Th2HandbookHelp_L("@@@| R#39 | VDP(40) | DY: Y-coordinate to be transferred to (HIGH)             |")
  Th2HandbookHelp_L("@@@| R#40 | VDP(41) | NX: num. of dots to be transferred in X direction (LOW)  |")
  Th2HandbookHelp_L("@@@| R#41 | VDP(42) | NX: num. of dots to be transferred in X direction (HIGH) |")
  Th2HandbookHelp_L("@@@| R#42 | VDP(43) | NY: num. of dots to be transferred in Y direction (LOW)  |")
  Th2HandbookHelp_L("@@@| R#43 | VDP(44) | NY: num. of dots to be transferred in Y direction (HIGH) |")
  Th2HandbookHelp_L("@@@| R#44 | VDP(45) | CLR: for transferring data to CPU                        |")
  Th2HandbookHelp_L("@@@| R#45 | VDP(46) | ARG: bank switching between VRAM and expanded VRAM       |")
  Th2HandbookHelp_L("@@@| R#46 | VDP(47) | CMR: send VDP command                                    |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(2) Status register (S#0 to S#9)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This is a read-only 8-bit register group which reads data from MSX-VIDEO. Registers are expressed using the notation S#n. The functions of the registers are listed in [[[Table 4.2|||Chapter4a#table-42--status-register-list]]].")
  Th2HandbookHelp_Commit("_Table 4.1  Control register list_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_table-41-control-register-list_", 320)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|      | Corres- |                                                          |")
  Th2HandbookHelp_L("@@@| S#n  | ponding |                        Function                          |")
  Th2HandbookHelp_L("@@@|      | VDP(n)  |                                                          |")
  Th2HandbookHelp_L("@@@|------+---------+----------------------------------------------------------|")
  Th2HandbookHelp_L("@@@| S#0  | VDP(8)  | interrupt information                                    |")
  Th2HandbookHelp_L("@@@| S#1  | VDP(-1) | interrupt information                                    |")
  Th2HandbookHelp_L("@@@| S#2  | VDP(-2) | DP command control information/etc.                      |")
  Th2HandbookHelp_L("@@@| S#3  | VDP(-3) | coordinate detected (LOW)                                |")
  Th2HandbookHelp_L("@@@| S#4  | VDP(-4) | coordinate detected (HIGH)                               |")
  Th2HandbookHelp_L("@@@| S#5  | VDP(-5) | coordinate detected (LOW)                                |")
  Th2HandbookHelp_L("@@@| S#6  | VDP(-6) | coordinate detected (HIGH)                               |")
  Th2HandbookHelp_L("@@@| S#7  | VDP(-7) | data obtained by VDP command                             |")
  Th2HandbookHelp_L("@@@| S#8  | VDP(-8) | X-coordinate obtained by search command (LOW)            |")
  Th2HandbookHelp_L("@@@| S#9  | VDP(-9) | X-coordinate obtained by search command (HIGH)           |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(3) Colour palette register group (P#0 to P#15)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("These registers are used to set the colour palette. Registers are expressed using the notation P#n where 'n' is the palette number which represents one of 512 colours. Each palette register has 9 bits allowing three bits to be used for each RGB colour (red, green, and blue).")
  Th2HandbookHelp_Commit("_Table 4.2  Status register list_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_table-42-status-register-list_", 321)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO can be connected with 128K bytes VRAM (Video RAM) and 64K bytes expanded RAM. MSX-VIDEO has a 17-bit counter for accessing this 128K bytes address area. Note that this memory is controlled by MSX-VIDEO and cannot be directly accessed by the CPU.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Expanded RAM memory cannot be directly displayed to the screen as can that of VRAM. However, it can be manipulated the same as VRAM when using the video processor commands. This large work area is very useful when processing screen data. Note that the MSX standard does not include instructions regarding expanded RAM, so taking advantage of this in program design could result in compatibility problems with other MSX machines.")
  Th2HandbookHelp_Commit("1.2 VRAM", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#12-vram", 322)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.1]|||img:figure_4.1]]]")
  Th2HandbookHelp_Commit("_Figure 4.1  VRAM and expanded RAM_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-41-vram-and-expanded-ram_", 323)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO has four I/O ports that send data back and forth the CPU. The functions of these ports are listed in [[[Table 4.3|||Chapter4a#table-43--msx-video-ports]]]. The ports are accessed by the CPU through its I/O addresses in the table below, addresses expressed as n, n' are stored at address locations 6 and 7 in MAIN-ROM. Although n = n' = 98H normally, this can be different on some machines, so port addresses should be obtained from these addresses for reliable results.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("It is generally recommended that BIOS be used for I/O operations for purposes of compatibility. However, the screen display often requires high speed, so these I/O ports are capable of accessing MSX-VIDEO directly.")
  Th2HandbookHelp_Commit("1.3 I/O ports", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#13-io-ports", 324)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|      Port       | Address |               Function                 |")
  Th2HandbookHelp_L("@@@|-----------------+---------+----------------------------------------|")
  Th2HandbookHelp_L("@@@| port #0 (READ)  |    n    | read data from VRAM                    |")
  Th2HandbookHelp_L("@@@| port #0 (WRITE) |    n'   | write data to VRAM                     |")
  Th2HandbookHelp_L("@@@| port #1 (READ)  |  n + 1  | read status register                   |")
  Th2HandbookHelp_L("@@@| port #1 (WRITE) |  n'+ 1  | write to control register              |")
  Th2HandbookHelp_L("@@@| port #2 (WRITE) |  n'+ 2  | write to palette register              |")
  Th2HandbookHelp_L("@@@| port #3 (WRITE) |  n'+ 3  | write to indirectly specified register |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:**")
  Th2HandbookHelp_L("The value of n should be obtained by referring to address 6 in MAIN-ROM")
  Th2HandbookHelp_L("The value of n'should be obtained by referring to address 7 in MAIN-ROM")
  Th2HandbookHelp_Commit("_Table 4.3  MSX-VIDEO ports_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_table-43-msx-video-ports_", 325)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO can be accessed directly through the I/O ports without going through BIOS. This section describes how to do this.")
  Th2HandbookHelp_Commit("2.  ACCESS TO MSX-VIDEO", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#2-access-to-msx-video", 326)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The control registers are write-only registers. As described above, the partial contents of control registers (R#0 to R#23) can be obtained by referring to VDP(n) from BASIC. This only reads the value which has been written in the work area of RAM (F3DFH to F3E6H, FFE7H to FFF6H) used for writing to registers.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("There are three ways, described below, to write data to control registers. Since MSX accesses MSX-VIDEO inside the timer interrupt routine to examine the occurrence of sprite conflicts, note that access procedure will not inhibiting the interrupt when the registers are accessed in the proper way as described below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(1) Direct access_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The first way is to directly specify the data and where it is to be written to. [[[Figure 4.2|||Chapter4a#figure-42--direct-access-to-rn]]] illustrates the procedure. The data is first written to port#1 and then the destination register number is written to port#1 using the five least significant bits. The most significant bit is set to 1 and the second bit is set to 0. Thus the value would be 10XXXXXB in binary notation where XXXXX is the destination register number.")
  Th2HandbookHelp_Commit("2.1.1 Writing data to control registers", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#211-writing-data-to-control-registers", 327)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.2]|||img:figure_4.2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Port#1 is also used to set VRAM addresses and is described in [[[section 2.2|||Chapter4a#22-vram-access-from-the-cpu]]]. The most significant bit of the second byte sent to this port is the address/register flag and determines the operation to take place. When the bit is set to " + Chr(34) + "1" + Chr(34) + ", writing data to a control register as described here will take place.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(2) Indirect Access (non-autoincrement mode)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The second way is to write data to the register specified as the objective register (R#17 contains the objective pointer). To begin with, store the register number to be accessed in R#17 by direct access. The most significant bit is set to 1 and the second bit to 0. Thus the value would be 10XXXXXB in binary notation where XXXXX is the objective register number. After this is done, data can be written to the objective register by sending data to port#3. This method is used for sending data to the same register continuously. An example would be for the execution of VDP commands.")
  Th2HandbookHelp_Commit("_Figure 4.2  Direct access to R#n_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-42-direct-access-to-rn_", 328)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.3]|||img:figure_4.3]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(3) Indirect Access (autoincrement mode)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The third way is to write date to the register indicated by R#17. R#17 is incremented each time data is sent to port#3. To begin with, store the beginning register number to be accessed in R#17 by direct access. The two most significant bits are set to 0. Thus the value would be 00XXXXXB in binary notation where XXXXX is the beginning register number.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since this method allows writing data to continuous control registers effectively, it is useful when several continuous registers are to be changed at once. One example would be when the screen mode is changed.")
  Th2HandbookHelp_Commit("_Figure 4.3  Indirect access to R#n (non-autoincrement mode)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-43-indirect-access-to-rn-non-autoincrement-mode_", 329)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.4]|||img:figure_4.4]]]")
  Th2HandbookHelp_Commit("_Figure 4.4  Indirect access to R#n (autoincrement mode)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-44-indirect-access-to-rn-autoincrement-mode_", 330)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To set data in the MSX-VIDEO palette registers (P#0 to P#15), specify the palette register number in the four lowest significant bits of R#16 (color palette pointer), and then send the data to port#2. Since palette registers have a length of 9 bits, data must be sent twice; red brightness and blue brightness first, then green brightness. Brightness is specified in the lower three bits of a four bit segment. Refer to [[[Figure 4.5|||Chapter4a#figure-45--setting-a-colour-palette-register]]] for details.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After data is sent to port#2 twice, R#16 is automatically incremented. This feature makes it easy to initialize all the palettes.")
  Th2HandbookHelp_Commit("2.1.2 Setting a palette", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#212-setting-a-palette", 331)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.5]|||img:figure_4.5]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(*) Since R#16 is incremented at this point, setting next palette can be done by sending data to port#2 continuously.")
  Th2HandbookHelp_Commit("_Figure 4.5  Setting a colour palette register_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-45-setting-a-colour-palette-register_", 332)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Status registers are read-only registers. Their contents can be read from port#1 by setting the status register number in the least significant four bits of R#15 (status register pointer) as shown in [[[Figure 4.6|||Chapter4a#figure-46--acessing-status-registers]]]. The four most significant bits are set to 0. Thus the value would be 0000XXXXB in binary notation where XXXX is the status register number. Interrupts should be inhibited before the status register is accessed. After the desired task is completed, R#15 should be set to 0 and the interrupts released.")
  Th2HandbookHelp_Commit("2.1.3 Reading status registers", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#213-reading-status-registers", 333)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.6]|||img:figure_4.6]]]")
  Th2HandbookHelp_Commit("_Figure 4.6  Acessing status registers_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-46-acessing-status-registers_", 334)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When a VRAM address is to be accessed from the CPU, follow the procedure described below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(1) Bank switching_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The first 64K bytes of VRAM (00000H to 0FFFFH) and the 64K bytes of expanded RAM both reside at the same address space as viewed by MSX-VIDEO. Bank switching is used so that they can both be online at the same time. Since MSX2 does not to use expanded VRAM, always select the VRAM bank. Bank switching is controlled by bit 6 of R#45.")
  Th2HandbookHelp_Commit("2.2 VRAM Access From the CPU", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#22-vram-access-from-the-cpu", 335)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.7]|||img:figure_4.7]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(2) Setting the VRAM page (three high order bits)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The 17-bit address for accessing the 128K bytes of VRAM is set in the address counter (A16 to A0). R#14 contains the three high order bits (A16 to A14). So this register can be viewed as switching between eight 16K byte pages of VRAM.")
  Th2HandbookHelp_Commit("_Figure 4.7  VRAM/expanded RAM bank switching_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-47-vramexpanded-ram-bank-switching_", 336)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.8]|||img:figure_4.8]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(3) Setting the VRAM address (14 low order bits)_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The 14 low order bits of the address should be sent to port#1 in two bytes. [[[Figure 4.9|||Chapter4a#figure-49--setting-14-low-order-bits]]] shows the details. Make sure that the most significant bit of the second byte sent is set to 0. This sets the address/register flag to address mode. The second most significant bit sets the read/write flag. 1 signifies writing to VRAM and 2 signifies reading from VRAM.")
  Th2HandbookHelp_Commit("_Figure 4.8  Setting the VRAM page (3 high order bits)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-48-setting-the-vram-page-3-high-order-bits_", 337)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.9]|||img:figure_4.9]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(4) Reading/writing VRAM_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the value in the address counter, read or write data through port#0. The read/write flag is set the same time as A13 to A8 of the address counter, as described above.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The address counter is automatically incremented each time a byte of data is read or written to port #0. This feature allows for easy access of continuous memory in VRAM.")
  Th2HandbookHelp_Commit("_Figure 4.9  Setting 14 low order bits_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-49-setting-14-low-order-bits_", 338)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.10]|||img:figure_4.10]]]")
  Th2HandbookHelp_Commit("_Figure 4.10  Access to VRAM through port#0_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-410-access-to-vram-through-port0_", 339)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MSX2 has ten different modes as shown in [[[Table 4.4|||Chapter4a#table-44--screen-modes-listing-of-msx2]]]. Six screen modes marked with **" + Chr(34) + "*" + Chr(34) + "** in the table below (TEXT 2 and GRAPHIC 3 to GRAPHIC 7) have been introduced for the MSX2. The other modes have been improved due to the change from TMS9918A to MSX-VIDEO. Fetures of these ten screen modes and how to use them are described below.")
  Th2HandbookHelp_Commit("3.  SCREEN MODES OF THE MSX2", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#3-screen-modes-of-the-msx2", 340)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|  Mode Name  | SCREEN mode |                 Description                |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@|   TEXT 1    |  SCREEN 0   | 40 characters per line of text, one colour |")
  Th2HandbookHelp_L("@@@|             |  (width=40) | for each character                         |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * TEXT 2    |  SCREEN 0   | 80 characters per line of text,            |")
  Th2HandbookHelp_L("@@@|             |  (width=80) | character blinkable selection              |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| MULTI-COLOR |  SCREEN 3   | pseudo-graphic, one character              |")
  Th2HandbookHelp_L("@@@|             |             | divided into four block                    |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@|   GRAPHIC 1 |  SCREEN 1   | 32 characters per one line of              |")
  Th2HandbookHelp_L("@@@|             |             | text, the COLOURed character available     |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@|   GRAPHIC 2 |  SCREEN 2   | 256 x 192, the colour is                   |")
  Th2HandbookHelp_L("@@@|             |             | specififed for each 8 dots                 |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * GRAPHIC 3 |  SCREEN 4   | GRAPHIC 2 which can use sprite             |")
  Th2HandbookHelp_L("@@@|             |             | mode 2                                     |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * GRAPHIC 4 |  SCREEN 5   | 256 x 212; 16 colours are                  |")
  Th2HandbookHelp_L("@@@|             |             | available for each dot                     |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * GRAPHIC 5 |  SCREEN 6   | 512 x 212; 4 colours are                   |")
  Th2HandbookHelp_L("@@@|             |             | available for each dot                     |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * GRAPHIC 6 |  SCREEN 7   | 512 x 212; 16 colours are                  |")
  Th2HandbookHelp_L("@@@|             |             | available for each dot                     |")
  Th2HandbookHelp_L("@@@|-------------+-------------+--------------------------------------------|")
  Th2HandbookHelp_L("@@@| * GRAPHIC 7 |  SCREEN 8   | 256 x 212; 256 colours are                 |")
  Th2HandbookHelp_L("@@@|             |             | available for each dot                     |")
  Th2HandbookHelp_L("@@@--------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 4.4  Screen modes listing of MSX2_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_table-44-screen-modes-listing-of-msx2_", 341)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("TEXT 1 screen mode has the following features:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               40 (horizontal) x 24 (vertical)                    |")
  Th2HandbookHelp_L("@@@|                       background/character colours can be selected from  |")
  Th2HandbookHelp_L("@@@|                       512 colours                                        |")
  Th2HandbookHelp_L("@@@| character:            256 characters available                           |")
  Th2HandbookHelp_L("@@@|                       character size: 6 (horizontal) x 8 (vertical)      |")
  Th2HandbookHelp_L("@@@| memory requirements:  for character font ... 2048 bytes                  |")
  Th2HandbookHelp_L("@@@|                                              (8 bytes x 256 characters)  |")
  Th2HandbookHelp_L("@@@|                       for display ........... 960 bytes                  |")
  Th2HandbookHelp_L("@@@|                                               (40 characters x 24 lines) |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible with SCREEN 0 (WIDTH 40)                |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.1 TEXT 1 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#31-text-1-mode", 342)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO screen modes are set by using 5 bits of R#0 and R#1. [[[Figure 4.11|||Chapter4a#figure-411--setting-text1-mode]]] shows the details. The 3-bit mask in R#0 is 000B and the 2-bit mask in R#1 is 10B when using the TEXT 1 mode.")
  Th2HandbookHelp_Commit("3.1.1 Setting TEXT 1 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#311-setting-text-1-mode", 343)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.11]|||img:figure_4.11]]]")
  Th2HandbookHelp_Commit("_Figure 4.11  Setting TEXT1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-411-setting-text1-mode_", 344)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The area in which character fonts are stored is called the pattern generator table. This table is located in VRAM, and, although the font is defined by using 8 bytes for each character from the top of the table, the 2 low order bits of each byte representing the right two columns are not displayed on the screen. Thus, the size of one character is 6 x 8 pixels. Each character font set contains 256 different characters numbered from 0 to 255. Use this code to specify which character should be displayed on the screen.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Specify the location of the pattern generator table in R#4. Note that the 6 high order bits of the address (A16 to A11) are specified and the 11 low order bits of the address (A10 to A0) are always 0 (" + Chr(34) + "00000000000B" + Chr(34) + "). So the address in which the pattern generator table can be set always begins at a multiple of 2K bytes from 00000H. This address can be found using the system variable BASE(2) from BASIC. [[[Figure 4.12|||Chapter4a#figure-412--structure-of-the-pattern-generator-table]]] shows the structure of the pattern generator table.")
  Th2HandbookHelp_Commit("Pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-generator-table", 345)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.12]|||img:figure_4.12]]]")
  Th2HandbookHelp_Commit("_Figure 4.12  Structure of the pattern generator table_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-412-structure-of-the-pattern-generator-table_", 346)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The pattern name table stores the characters to be displayed at each position on the screen. One byte of memory is used for each character to be displayed. [[[Figure 4.13|||Chapter4a#figure-413--structure-of-text1-pattern-name-table]]] shows the correspondence between memory location and screen location.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Specify the location of the pattern generator table in R#2. Note that the 7 high order bits of the address (A16 to A10) are specified and that the 10 low order bits of the address (A9 to A0) are always 0 (" + Chr(34) + "0000000000B" + Chr(34) + "). So the address in which the name table can be set always begins at a multiple of 1K bytes from 00000H. This address can be found by using the system variable BASE(0) from BASIC. [[[Figure 4.13|||Chapter4a#figure-413--structure-of-text1-pattern-name-table]]] shows the structure of the pattern generator table.")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table", 347)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.13]|||img:figure_4.13]]]")
  Th2HandbookHelp_Commit("_Figure 4.13  Structure of TEXT1 pattern name table_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-413-structure-of-text1-pattern-name-table_", 348)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The screen colour is specified by R#7. The background colour is the palette specified by the 4 low-order bits of R#7; the 4 high-order bits specify the foreground colour (see [[[Figure 4.14|||Chapter4a#figure-414--colour-specification-in-text-1]]]). A " + Chr(34) + "0" + Chr(34) + " in the font pattern is displayed in the background colour and a " + Chr(34) + "1" + Chr(34) + " is displayed in the foreground colour. Note that in TEXT 1 the border colour of the screen cannot be set and it is the same as the background colour.")
  Th2HandbookHelp_Commit("3.1.3 Specifying screen colour", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#313-specifying-screen-colour", 349)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.14]|||img:figure_4.14]]]")
  Th2HandbookHelp_Commit("_Figure 4.14  Colour specification in TEXT 1_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-414-colour-specification-in-text-1_", 350)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The screen mode TEXT 2 has the following features:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               80 (horizontal) x 24 (vertical) or 26.5 (vertical) |")
  Th2HandbookHelp_L("@@@|                       background colour/character colour can be selected |")
  Th2HandbookHelp_L("@@@|                       from 512 colours                                   |")
  Th2HandbookHelp_L("@@@| character:            256 characters available                           |")
  Th2HandbookHelp_L("@@@|                       character size: 6 (horizontal) x 8 (vertical)      |")
  Th2HandbookHelp_L("@@@|                       each character blinkable                           |")
  Th2HandbookHelp_L("@@@| memory requirements:  24 lines                                           |")
  Th2HandbookHelp_L("@@@|                          for character font ... 2048 bytes               |")
  Th2HandbookHelp_L("@@@|                                               (8 bytes x 256 characters) |")
  Th2HandbookHelp_L("@@@|                          for display .......... 1920 bytes               |")
  Th2HandbookHelp_L("@@@|                                               (80 characters x 24 lines) |")
  Th2HandbookHelp_L("@@@|                          for blinking .........  240 bytes (= 1920 bits) |")
  Th2HandbookHelp_L("@@@|                       26.5 lines                                         |")
  Th2HandbookHelp_L("@@@|                          for character font ... 2048 bytes               |")
  Th2HandbookHelp_L("@@@|                                               (8 bytes x 256 characters) |")
  Th2HandbookHelp_L("@@@|                          for display .......... 2160 bytes               |")
  Th2HandbookHelp_L("@@@|                                               (80 characters x 27 lines) |")
  Th2HandbookHelp_L("@@@|                          for blinking .........  270 bytes (= 2160 bits) |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible with SCREEN 0 (WIDTH 80)                |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.2 TEXT 2 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#32-text-2-mode", 351)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set TEXT2 mode as shown in [[[Figure 4.15|||Chapter4a#figure-415--setting-text2-mode]]].")
  Th2HandbookHelp_Commit("3.2.1 Setting TEXT 2 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#321-setting-text-2-mode", 352)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.15]|||img:figure_4.15]]]")
  Th2HandbookHelp_Commit("_Figure 4.15  Setting TEXT2 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-415-setting-text2-mode_", 353)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("TEXT2 mode can switch the screen to 24 lines or 26.5 lines depending on the value of bit 7 in R#9. Note that, when the screen is set to 26.5 lines, only the upper half of the characters at the bottom of the screen are displayed. This mode is not supported by BASIC.")
  Th2HandbookHelp_Commit("Setting number of lines (24 lines/26.5 lines)", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-number-of-lines-24-lines265-lines", 354)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.16]|||img:figure_4.16]]]")
  Th2HandbookHelp_Commit("_Figure 4.16  Switching number of lines_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-416-switching-number-of-lines_", 355)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The pattern generator table has the same structure and function as the one of TEXT1. See the descriptions for TEXT1.")
  Th2HandbookHelp_Commit("Pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-generator-table-1", 356)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Since the number of characters to be displayed in the screen has been increased to 2160 (80 x 27) characters maximum, the maximum area occupied by the pattern name table is 2160 bytes.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Specify the location of the pattern name table in R#2. The 5 high order bits of the address (A16 to A12) are specified and the 12 low order bits of the address (A11 to A0) are always 0 (" + Chr(34) + "000000000000B" + Chr(34) + "). So the address in which the pattern name table can be set always begins at a multiple of 4K bytes from 00000H.")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table-1", 357)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.17]|||img:figure_4.17]]]")
  Th2HandbookHelp_Commit("_Figure 4.17  Structure of TEXT2 pattern name table_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-417-structure-of-text2-pattern-name-table_", 358)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In TEXT2 mode, it is possible to set the blink attribute for each character. The blink table stores the information of the screen location of the characters blinked. One bit of the blink table corresponds to one character on the screen (that is, on the pattern name table). When the bit is set to " + Chr(34) + "1" + Chr(34) + " blinking is enabled for the corresponding character; when the bit is " + Chr(34) + "0" + Chr(34) + " blinking is disabled.")
  Th2HandbookHelp_Commit("Blink table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#blink-table", 359)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.18]|||img:figure_4.18]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Specify the starting address of the blink table by setting the 8 high order bits (A16 to A9) in R#3 and R#10. The location of the blink table is set by writing the 8 high order bits of the address (A16 to A9) in R#3 and R#10. The 9 low order bits of the address (A8 to A0) are always 0 (" + Chr(34) + "000000000B" + Chr(34) + "). So the address in which the blink table can be set always begins at a multiple of 512 bytes from 00000H.")
  Th2HandbookHelp_Commit("_Figure 4.18  Blink table structure of TEXT2_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-418-blink-table-structure-of-text2_", 360)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The foreground colour is specified by the 4 high order bits of R#7 and the background colour by the 4 low order bits of R#7. Characters with a blink attribute of 1 defined by the blink table alternate between the blink colour and the colour specified in R#12.")
  Th2HandbookHelp_Commit("3.2.3 Screen colour and character blink specification", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#323-screen-colour-and-character-blink-specification", 361)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.19]|||img:figure_4.19]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The blinking rate is set in R#13. The 4 high order bits define the display time in the original colour, and the 4 low order bits define the display time in the blink colour. The period of time is defined in units of 1/6 seconds.")
  Th2HandbookHelp_Commit("_Figure 4.19  Setting screen colour and blink colour_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-419-setting-screen-colour-and-blink-colour_", 362)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.20]|||img:figure_4.20]]]")
  Th2HandbookHelp_Commit("_Figure 4.20  Setting blink rate_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-420-setting-blink-rate_", 363)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '*********************************************************")
  Th2HandbookHelp_L("@@@1010 '  LIST 4.1  BLINK SAMPLE")
  Th2HandbookHelp_L("@@@1020 '*********************************************************")
  Th2HandbookHelp_L("@@@1030 '")
  Th2HandbookHelp_L("@@@1040 SCREEN 0 : WIDTH 80                'TEXT 2 mode")
  Th2HandbookHelp_L("@@@1050 ADR=BASE(1)                        'TAKE COLOR TABLE ADDRESS")
  Th2HandbookHelp_L("@@@1060 '")
  Th2HandbookHelp_L("@@@1070 FOR I=0 TO 2048/8")
  Th2HandbookHelp_L("@@@1080   VPOKE ADR+I,0                    'reset blink mode")
  Th2HandbookHelp_L("@@@1090 NEXT")
  Th2HandbookHelp_L("@@@1100 '")
  Th2HandbookHelp_L("@@@1110 VDP(7) =&HF1                       'text color=15, back color=1")
  Th2HandbookHelp_L("@@@1120 VDP(13)=&H1F                       'text color=1,  back color=15")
  Th2HandbookHelp_L("@@@1130 VDP(14)=&H22                       'set interval and start blink")
  Th2HandbookHelp_L("@@@1140 '")
  Th2HandbookHelp_L("@@@1150 PRINT " + Chr(34) + "Input any character : " + Chr(34) + ";")
  Th2HandbookHelp_L("@@@1160 '")
  Th2HandbookHelp_L("@@@1170 K$=INPUT$(1)")
  Th2HandbookHelp_L("@@@1180 IF K$<CHR$(28) THEN 1230")
  Th2HandbookHelp_L("@@@1190 IF K$>" + Chr(34) + " " + Chr(34) + " THEN GOSUB 1280")
  Th2HandbookHelp_L("@@@1200 PRINT K$;")
  Th2HandbookHelp_L("@@@1210 GOTO 1170")
  Th2HandbookHelp_L("@@@1220 '")
  Th2HandbookHelp_L("@@@1230 VDP(14)=0                          'stop blink")
  Th2HandbookHelp_L("@@@1240 END")
  Th2HandbookHelp_L("@@@1250 '")
  Th2HandbookHelp_L("@@@1260 '----- set blink mode -----")
  Th2HandbookHelp_L("@@@1270 '")
  Th2HandbookHelp_L("@@@1280 X=POS(0) : Y=CSRLIN")
  Th2HandbookHelp_L("@@@1290 A=(Y*80+X)\8")
  Th2HandbookHelp_L("@@@1300 B=X MOD 8")
  Th2HandbookHelp_L("@@@1310 M=VAL(" + Chr(34) + "&B" + Chr(34) + "+MID$(" + Chr(34) + "000000010000000" + Chr(34) + ",8-B,8))")
  Th2HandbookHelp_L("@@@1320 VPOKE ADR+A,VPEEK(ADR+A) XOR M")
  Th2HandbookHelp_L("@@@1330 RETURN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.1  Blink example_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-41-blink-example_", 364)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The MULTI COLOUR mode is described below:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               64 (horizontal) x 48 (vertical) blocks             |")
  Th2HandbookHelp_L("@@@|                       16 colours from 512 colours can be displayed       |")
  Th2HandbookHelp_L("@@@|                       at the same time                                   |")
  Th2HandbookHelp_L("@@@| block:                block size is 4 (horizontal) x 4 (vertical) dots   |")
  Th2HandbookHelp_L("@@@|                       colour can be specified to each block              |")
  Th2HandbookHelp_L("@@@| memory requirements:  for setting colours ........... 2048 bytes         |")
  Th2HandbookHelp_L("@@@|                       for specifying locations ......  768 bytes         |")
  Th2HandbookHelp_L("@@@| sprite:               sprite mode 1                                      |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 3                             |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.3 MULTI COLOUR Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#33-multi-colour-mode", 365)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set MULTI COLOUR mode as shown in [[[Figure 4.21|||Chapter4a#figure-421--setting-multi-colour-mode]]].")
  Th2HandbookHelp_Commit("3.3.1 Setting MULTI COLOUR mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#331-setting-multi-colour-mode", 366)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.21]|||img:figure_4.21]]]")
  Th2HandbookHelp_Commit("_Figure 4.21  Setting MULTI COLOUR mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-421-setting-multi-colour-mode_", 367)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In this mode, patterns are constructed as 2 x 2 blocks and one pattern name corresponds to four patterns. The starting address on this table is specified in R#4. Since only the 6 high order bits (A16 to A11) of the address is specified, the pattern generator table can be located at intervals of 2K bytes from 00000H (see [[[Figure 4.22|||Chapter4a#figure-422--pattern-generator-table-structure-of-multi-colour]]]).")
  Th2HandbookHelp_Commit("Pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-generator-table-2", 368)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.22]|||img:figure_4.22]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(1) This table is in effect when Y is 0, 4, 8, 12, 16, or 20")
  Th2HandbookHelp_L("(2) This table is in effect when Y is 1, 5, 9, 13, 17, or 21")
  Th2HandbookHelp_L("(3) This table is in effect when Y is 2, 8, 10, 14, 18, or 22")
  Th2HandbookHelp_L("(4) This table is in effect when Y is 3, 7, 11, 15, 19, or 23")
  Th2HandbookHelp_Commit("_Figure 4.22  Pattern generator table structure of MULTI COLOUR_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-422-pattern-generator-table-structure-of-multi-colour_", 369)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This is the table for displaying specified patterns at desired locations on the screen. One of four patterns in a pattern name is displayed at its Y-coordinate value. BASIC sets the contents of this table as shown in [[[Figure 4.23|||Chapter4a#figure-423--setting-basic-pattern-name-table]]]. The starting address of the pattern name table is specified by R#2. Since only the 7 high order bits of the address (A16 to A10) are specified, the address at which this table can be set is at increments of 1K bytes from 00000H (see [[[Figure 4.24|||Chapter4a#figure-424--pattern-name-table-structure-of-multi-colour-mode]]]).")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table-2", 370)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.23]|||img:figure_4.23]]]")
  Th2HandbookHelp_Commit("_Figure 4.23  Setting BASIC pattern name table_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-423-setting-basic-pattern-name-table_", 371)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.24]|||img:figure_4.24]]]")
  Th2HandbookHelp_Commit("_Figure 4.24  Pattern name table structure of MULTI COLOUR mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-424-pattern-name-table-structure-of-multi-colour-mode_", 372)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.25|||Chapter4a#figure-425--border-colour-specification]]]).")
  Th2HandbookHelp_Commit("3.3.3 Specifying the screen colour in MULTI COLOUR mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#333-specifying-the-screen-colour-in-multi-colour-mode", 373)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.25]|||img:figure_4.25]]]")
  Th2HandbookHelp_Commit("_Figure 4.25  Border colour specification_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-425-border-colour-specification_", 374)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 1 Mode is the screen mode as shown below:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               32 (horizontal) x 24 (vertical) patterns           |")
  Th2HandbookHelp_L("@@@|                       16 from 512 colours can be displayed               |")
  Th2HandbookHelp_L("@@@|                       at the same time                                   |")
  Th2HandbookHelp_L("@@@| pattern:              256 kinds of patterns are available                |")
  Th2HandbookHelp_L("@@@|                       pattern size is 8 (horizontal) x 8 (vertical) dots |")
  Th2HandbookHelp_L("@@@|                       any Figure can be defined for each pattern         |")
  Th2HandbookHelp_L("@@@|                       different colour for each 8 pattern can be set     |")
  Th2HandbookHelp_L("@@@| memory requirements:  for pattern font .............. 2048 bytes         |")
  Th2HandbookHelp_L("@@@|                       for colour table ..............   32 bytes         |")
  Th2HandbookHelp_L("@@@| sprite:               sprite mode 1                                      |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible with SCREEN 1                           |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.4 GRAPHIC 1 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#34-graphic-1-mode", 375)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 1 mode can be set as shown in [[[Figure 4.26|||Chapter4a#figure-426--setting-graphic-1-mode]]].")
  Th2HandbookHelp_Commit("3.4.1 Setting GRAPHIC 1 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#341-setting-graphic-1-mode", 376)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.26]|||img:figure_4.26]]]")
  Th2HandbookHelp_Commit("_Figure 4.26  Setting GRAPHIC 1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-426-setting-graphic-1-mode_", 377)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In this mode, 256 kinds of patterns, corresponding to codes 0 to 255, can be displayed on the screen. Fonts of each pattern are defined in the pattern generator table (see [[[Figure 4.27|||Chapter4a#figure-427--pattern-generator-table-of-graphic-1-mode]]]). The starting address of the pattern generator table is specified by R#4. Note that only the 6 high order bits of the address (A16 to A11) are specified.")
  Th2HandbookHelp_Commit("Pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-generator-table-3", 378)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.27]|||img:figure_4.27]]]")
  Th2HandbookHelp_Commit("_Figure 4.27  Pattern generator table of GRAPHIC 1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-427-pattern-generator-table-of-graphic-1-mode_", 379)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The colour specification for each of the 8 patterns are done by the colour table. Colours for " + Chr(34) + "0" + Chr(34) + " and " + Chr(34) + "1" + Chr(34) + " of the bit of each pattern can be specified (see [[[Figure 4.28|||Chapter4a#figure-428--colour-table-structure-of-graphic-1-mode]]]). The starting address of the colour table is specified by R#3 and R#10. Note that only the 11 high order bits of the address (A16 to A6) are specified.")
  Th2HandbookHelp_Commit("Colour table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#colour-table", 380)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.28]|||img:figure_4.28]]]")
  Th2HandbookHelp_Commit("_Figure 4.28  Colour table structure of GRAPHIC 1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-428-colour-table-structure-of-graphic-1-mode_", 381)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The size of the pattern name table is 768 bytes and the table corresponds to the pattern on the screen, one by one (see [[[Figure 4.29|||Chapter4a#figure-429--pattern-name-table-structure-of-graphic-1-mode]]]). The starting address of the pattern name table is specified by R#2. Note that only the 7 high order bits of the address (A16 to A10) are specified.")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table-3", 382)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.29]|||img:figure_4.29]]]")
  Th2HandbookHelp_Commit("_Figure 4.29  Pattern name table structure of GRAPHIC 1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-429-pattern-name-table-structure-of-graphic-1-mode_", 383)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.30|||Chapter4a#figure-430--screen-colour-specification-of-graphic-1-mode]]]).")
  Th2HandbookHelp_Commit("3.4.3 Specifying the screen colour", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#343-specifying-the-screen-colour", 384)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.30]|||img:figure_4.30]]]")
  Th2HandbookHelp_Commit("_Figure 4.30  Screen colour specification of GRAPHIC 1 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-430-screen-colour-specification-of-graphic-1-mode_", 385)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 2 and GRAPHIC 3 modes are the screen modes as described below:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               32 (horizontal) x 24 (vertical) patterns           |")
  Th2HandbookHelp_L("@@@|                       16 from 512 colours can be displayed               |")
  Th2HandbookHelp_L("@@@|                       at the same time                                   |")
  Th2HandbookHelp_L("@@@| pattern:              768 kinds of patterns are available                |")
  Th2HandbookHelp_L("@@@|                       pattern size is 8 (horizontal) x 8 (vertical) dots |")
  Th2HandbookHelp_L("@@@|                       any Figure can be defined for each pattern         |")
  Th2HandbookHelp_L("@@@|                       only two colours can be used in horizontal 8 dots  |")
  Th2HandbookHelp_L("@@@| memory requirements:  for pattern font .............. 6144 bytes         |")
  Th2HandbookHelp_L("@@@|                       for colour table .............. 6144 bytes         |")
  Th2HandbookHelp_L("@@@| sprite:               sprite mode 1 for GRAPHIC 2                        |")
  Th2HandbookHelp_L("@@@|                       sprite mode 2 for GRAPHIC 3                        |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 2 for GRAPHIC 2               |")
  Th2HandbookHelp_L("@@@|                       compatible to SCREEN 4 for GRAPHIC 3               |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.5 GRAPHIC 2, GRAPHIC 3 modes", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#35-graphic-2-graphic-3-modes", 386)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 2, and GRAPHIC 3 modes are set as [[[Figure 4.31|||Chapter4a#figure-431--setting-graphic-2-graphic-3-modes]]].")
  Th2HandbookHelp_Commit("3.5.1 Setting GRAPHIC 2, GRAPHIC 3 modes", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#351-setting-graphic-2-graphic-3-modes", 387)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.31]|||img:figure_4.31]]]")
  Th2HandbookHelp_Commit("_Figure 4.31  Setting GRAPHIC 2, GRAPHIC 3 modes_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-431-setting-graphic-2-graphic-3-modes_", 388)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In this mode, there are three pattern generator tables which are compatible with GRAPHIC 1 and 768 patterns can be displayed. It cannot display patterns which are overlapped on the screen, and operating the pattern generator table in this case causes the 256 x 192 dot graphics display to be simulated. The starting address of the pattern generator table is specified by R#4. Note that only 4 bits of the address (A16 to A13) are specdified, so the address which can be set is located at interval steps of 8K bytes from 00000H (see [[[Figure 4.32|||Chapter4a#figure-432--pattern-generator-table-structure-of-graphic-2-graphic-3]]]).")
  Th2HandbookHelp_Commit("Pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-generator-table-4", 389)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.32]|||img:figure_4.32]]]")
  Th2HandbookHelp_Commit("_Figure 4.32  Pattern generator table structure of GRAPHIC 2, GRAPHIC 3_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-432-pattern-generator-table-structure-of-graphic-2-graphic-3_", 390)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The size of the colour table is the same as that of the pattern generator table and colours for " + Chr(34) + "0" + Chr(34) + " and " + Chr(34) + "1" + Chr(34) + " bits of each horizontal line of each pattern can be specified (see [[[Figure 4.33|||Chapter4a#figure-433--colour-table-structure-of-graphic-2-graphic-3-modes]]]). The starting address of the colour table is specified by R#3 and R#10. Note that only the 4 high order bits of the address (A16 to A13) is specified.")
  Th2HandbookHelp_Commit("Colour table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#colour-table-1", 391)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.33]|||img:figure_4.33]]]")
  Th2HandbookHelp_Commit("_Figure 4.33  Colour table structure of GRAPHIC 2, GRAPHIC 3 modes_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-433-colour-table-structure-of-graphic-2-graphic-3-modes_", 392)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The pattern name table is divided into three stages - upper, middle, and lower; each displays the pattern by referring to 256 bytes of the pattern generator (see [[[Figure 4.34|||Chapter4a#figure-434--pattern-name-table-for-graphic-modes-2-and-3]]]). This method enables each of 768 bytes on the pattern name table to display a different pattern font.")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table-4", 393)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.34]|||img:figure_4.34]]]")
  Th2HandbookHelp_Commit("_Figure 4.34  Pattern name table for GRAPHIC modes 2 and 3_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-434-pattern-name-table-for-graphic-modes-2-and-3_", 394)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.35|||Chapter4a#figure-435--screen-colour-specification-of-graphic-2-graphic-3-modes]]]).")
  Th2HandbookHelp_Commit("3.5.3 Screen colour specification", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#353-screen-colour-specification", 395)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.35]|||img:figure_4.35]]]")
  Th2HandbookHelp_Commit("_Figure 4.35  Screen colour specification of GRAPHIC 2, GRAPHIC 3 modes_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-435-screen-colour-specification-of-graphic-2-graphic-3-modes_", 396)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 4 mode is described below:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               256 (horizontal) x 212 (vertical) dots             |")
  Th2HandbookHelp_L("@@@|                       (or, 192 vertical)                                 |")
  Th2HandbookHelp_L("@@@|                       16 colours can be displayed at the same time       |")
  Th2HandbookHelp_L("@@@|                       each of 16 colours can be selected from 512 colours|")
  Th2HandbookHelp_L("@@@| command:              high speed graphic by VDP command available        |")
  Th2HandbookHelp_L("@@@| sprite:               mode 2 sprite function available                   |")
  Th2HandbookHelp_L("@@@| memory requirements:  for 192 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 24K bytes (6000H bytes)    |")
  Th2HandbookHelp_L("@@@|                         (4 bits x 256 x 192)                             |")
  Th2HandbookHelp_L("@@@|                       for 212 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 26.5K bytes (6A00H bytes)  |")
  Th2HandbookHelp_L("@@@|                         (4 bits x 256 x 212)                             |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 5                             |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.6 GRAPHIC 4 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#36-graphic-4-mode", 397)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set GRAPHIC 4 mode as shown in [[[Figure 4.36|||Chapter4a#figure-436--graphic-4-mode-setting]]].")
  Th2HandbookHelp_Commit("3.6.1 Setting GRAPHIC 4 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#361-setting-graphic-4-mode", 398)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.36]|||img:figure_4.36]]]")
  Th2HandbookHelp_Commit("_Figure 4.36  GRAPHIC 4 mode setting_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-436-graphic-4-mode-setting_", 399)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC 4 mode, one byte of the pattern name table corresponds with 2 dots on the screen. The colour information of each dot is represented by 4 bits and 16 colours can be specified (see [[[Figure 4.37|||Chapter4a#figure-437--pattern-name-table-structure-of-graphic-4-mode]]]). The starting address of the pattern name table is specified by R#2. Only the 2 high order bits of the address (A16 to A15) are specified and the 15 low order bits are considered as " + Chr(34) + "0" + Chr(34) + ". Thus, the four addresses at which the pattern name can be set are 00000H, 08000H, 10000H, and 18000H.")
  Th2HandbookHelp_Commit("Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#pattern-name-table-5", 400)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.37]|||img:figure_4.37]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The dot at (X,Y) coordinate on the screen can be accessed by using Expression 4.1. The program of [[[List 4.2|||Chapter4a#list-42--pset-for-graphic-4-mode-written-in-basic]]] illustrates the use of [[[Expression 4.1|||Chapter4a#expression-41--the-expression-for-accessing-the-dot-at-xy-coordinate]]].")
  Th2HandbookHelp_Commit("_Figure 4.37  Pattern name table structure of GRAPHIC 4 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-437-pattern-name-table-structure-of-graphic-4-mode_", 401)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ADR = X/2 + Y * 128 + base address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(The colour of the dot is represented by 4 high order bits in the case that X is even and by 4 low order bits in the case that X is odd.)")
  Th2HandbookHelp_Commit("_Expression 4.1  The expression for accessing the dot at (X,Y) coordinate_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_expression-41-the-expression-for-accessing-the-dot-at-xy-coordinate_", 402)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@100 '*********************************************")
  Th2HandbookHelp_L("@@@110 '  LIST 4.2   dot access of GRAPHIC 4 mode")
  Th2HandbookHelp_L("@@@120 '*********************************************")
  Th2HandbookHelp_L("@@@130 '")
  Th2HandbookHelp_L("@@@140 SCREEN 5")
  Th2HandbookHelp_L("@@@150 BA=0")
  Th2HandbookHelp_L("@@@160 FOR I=0 TO 255")
  Th2HandbookHelp_L("@@@170   X=I:Y=I\2")
  Th2HandbookHelp_L("@@@180   COL=15")
  Th2HandbookHelp_L("@@@190   GOSUB 1000")
  Th2HandbookHelp_L("@@@200 NEXT")
  Th2HandbookHelp_L("@@@210 END")
  Th2HandbookHelp_L("@@@220 '")
  Th2HandbookHelp_L("@@@1000 '****************************************")
  Th2HandbookHelp_L("@@@1010 '  PSET (X,Y),COL")
  Th2HandbookHelp_L("@@@1020 '   COL:color  BA:graphics Base Address")
  Th2HandbookHelp_L("@@@1030 '****************************************")
  Th2HandbookHelp_L("@@@1040 '")
  Th2HandbookHelp_L("@@@1050 ADR=X\2+Y*128+BA")
  Th2HandbookHelp_L("@@@1060 IF X AND 1 THEN BIT=&HF0:C=COL ELSE BIT=&HF:C=COL*16")
  Th2HandbookHelp_L("@@@1070 D=VPEEK(ADR)")
  Th2HandbookHelp_L("@@@1080 D=(D AND BIT) OR C")
  Th2HandbookHelp_L("@@@1090 VPOKE ADR,D")
  Th2HandbookHelp_L("@@@1100 RETURN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.2  PSET for GRAPHIC 4 mode written in BASIC_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-42-pset-for-graphic-4-mode-written-in-basic_", 403)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.38|||Chapter4a#figure-438--screen-colour-specification-in-graphic-4-mode]]]).")
  Th2HandbookHelp_Commit("3.6.3 Screen colour specification", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#363-screen-colour-specification", 404)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.38]|||img:figure_4.38]]]")
  Th2HandbookHelp_Commit("_Figure 4.38  Screen colour specification in GRAPHIC 4 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-438-screen-colour-specification-in-graphic-4-mode_", 405)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 5 mode is described as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               512 (horizontal) x 212 (vertical) dots             |")
  Th2HandbookHelp_L("@@@|                       (or, 192 vertical)                                 |")
  Th2HandbookHelp_L("@@@|                       4 colours can be displayed at the same time        |")
  Th2HandbookHelp_L("@@@|                       each of 4 colours can be selected from 512 colours |")
  Th2HandbookHelp_L("@@@| command:              graphic command by hardware available              |")
  Th2HandbookHelp_L("@@@| sprite:               mode 2 sprite function available                   |")
  Th2HandbookHelp_L("@@@| memory requirements:  for 192 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 24K bytes (6000H bytes)    |")
  Th2HandbookHelp_L("@@@|                         (2 bits x 512 x 192)                             |")
  Th2HandbookHelp_L("@@@|                       for 212 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 26.5K bytes (6A00H bytes)  |")
  Th2HandbookHelp_L("@@@|                         (2 bits x 512 x 212)                             |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 6                             |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.7 GRAPHIC 5 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#37-graphic-5-mode", 406)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set GRAPHIC 5 mode as shown in [[[Figure 4.39|||Chapter4a#figure-439--graphic-5-mode-setting]]].")
  Th2HandbookHelp_Commit("3.7.1 Setting GRAPHIC 5 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#371-setting-graphic-5-mode", 407)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.39]|||img:figure_4.39]]]")
  Th2HandbookHelp_Commit("_Figure 4.39  GRAPHIC 5 mode setting_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-439-graphic-5-mode-setting_", 408)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC 5 mode, one byte of the pattern name table corresponds with 4 dots on the screen. The colour information of each dot is represented by 2 bits and 4 colours can be specified. As with GRAPHIC 4 mode, the pattern name table is set by writing 2 high order bits of the address in R#2. The addresses can be set at either 00000H, 08000H, 10000H, or 18000H (see [[[Figure 4.40|||Chapter4a#figure-440--pattern-name-table-structure-of-graphic-5-mode]]]).")
  Th2HandbookHelp_Commit("3.7.2 Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#372-pattern-name-table", 409)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.40]|||img:figure_4.40]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The dot at (X,Y) coordinate on the screen can be accessed by using Expression 4.2. The program of [[[List 4.3|||Chapter4a#list-43--pset-for-graphic-5-mode-written-in-basic]]] confirms [[[Expression 4.2|||Chapter4a#expression-42--the-expression-for-accessing-the-dot-at-xy-coordinate]]].")
  Th2HandbookHelp_Commit("_Figure 4.40  Pattern name table structure of GRAPHIC 5 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-440-pattern-name-table-structure-of-graphic-5-mode_", 410)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ADR = X/4 + Y * 128 + base address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(The colour of the dot is represented by bit 7 and 6, or 5 and 4, or 3 and 2, or 1 and 0, when X MOD 4 is 0, or 1, or 2, or 3, respectively.)")
  Th2HandbookHelp_Commit("_Expression 4.2  The expression for accessing the dot at (X,Y) coordinate_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_expression-42-the-expression-for-accessing-the-dot-at-xy-coordinate_", 411)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@100 '*********************************************")
  Th2HandbookHelp_L("@@@110 '  LIST 4.3   dot access of GRAPHIC 5 mode")
  Th2HandbookHelp_L("@@@120 '*********************************************")
  Th2HandbookHelp_L("@@@130 '")
  Th2HandbookHelp_L("@@@140 SCREEN 6")
  Th2HandbookHelp_L("@@@150 BA=0")
  Th2HandbookHelp_L("@@@160 FOR I=0 TO 511")
  Th2HandbookHelp_L("@@@170   X=I : Y=I\2")
  Th2HandbookHelp_L("@@@180   COL=3")
  Th2HandbookHelp_L("@@@190   GOSUB 1000")
  Th2HandbookHelp_L("@@@200 NEXT")
  Th2HandbookHelp_L("@@@210 END")
  Th2HandbookHelp_L("@@@220 '")
  Th2HandbookHelp_L("@@@1000 '*******************************************")
  Th2HandbookHelp_L("@@@1010 '  PSET(X,Y)")
  Th2HandbookHelp_L("@@@1020 '   COL:colour  BA:graphic Base Address")
  Th2HandbookHelp_L("@@@1030 '*******************************************")
  Th2HandbookHelp_L("@@@1040 '")
  Th2HandbookHelp_L("@@@1050 ADR=X\4+Y*128+BA")
  Th2HandbookHelp_L("@@@1060 LP=X MOD 4")
  Th2HandbookHelp_L("@@@1070 IF LP=0 THEN BIT=&H3F:C=COL*&H40")
  Th2HandbookHelp_L("@@@1080 IF LP=1 THEN BIT=&HCF:C=COL*&H10")
  Th2HandbookHelp_L("@@@1090 IF LP=2 THEN BIT=&HF3:C=COL*&H4")
  Th2HandbookHelp_L("@@@1100 IF LP=3 THEN BIT=&HFC:C=COL")
  Th2HandbookHelp_L("@@@1110 D=VPEEK(ADR)")
  Th2HandbookHelp_L("@@@1120 D=(D AND BIT) OR C")
  Th2HandbookHelp_L("@@@1130 VPOKE ADR,D")
  Th2HandbookHelp_L("@@@1140 RETURN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.3  PSET for GRAPHIC 5 mode written in BASIC_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-43-pset-for-graphic-5-mode-written-in-basic_", 412)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC 5 mode, hardware tiling is done for the border colour of the screen and sprites. As with the other modes, these colours are specified by 4 bits; 2 high order bits of 4 bits represents the dot colour at even locations, and 2 low order bits for the dot colour at odd locations (see [[[Figure 4.41|||Chapter4a#figure-441--screen-colour-specification-in-graphic-5-mode]]]).")
  Th2HandbookHelp_Commit("3.7.3 Setting the screen colour", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#373-setting-the-screen-colour", 413)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.41]|||img:figure_4.41]]]")
  Th2HandbookHelp_Commit("_Figure 4.41  Screen colour specification in GRAPHIC 5 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-441-screen-colour-specification-in-graphic-5-mode_", 414)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 6 mode is described as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               512 (horizontal) x 212 (vertical) dots              |")
  Th2HandbookHelp_L("@@@|                       (or, 192 vertical)                                  |")
  Th2HandbookHelp_L("@@@|                       16 colours can be displayed at the same time        |")
  Th2HandbookHelp_L("@@@|                       each of 16 colours can be selected from 512 colours |")
  Th2HandbookHelp_L("@@@| command:              graphic command by hardware available               |")
  Th2HandbookHelp_L("@@@| sprite:               mode 2 sprite function available                    |")
  Th2HandbookHelp_L("@@@| memory requirements:  for 192 dots                                        |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 48K bytes (C000H bytes)     |")
  Th2HandbookHelp_L("@@@|                         (4 bits x 512 x 192)                              |")
  Th2HandbookHelp_L("@@@|                       for 212 dots                                        |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 53K bytes (D400H bytes)     |")
  Th2HandbookHelp_L("@@@|                         (4 bits x 512 x 212)                              |")
  Th2HandbookHelp_L("@@@|                       Note that this mode cannot be used at all with      |")
  Th2HandbookHelp_L("@@@|                       64K byte VRAM because of the hardware               |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 7                              |")
  Th2HandbookHelp_L("@@@-----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.8 GRAPHIC 6 Mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#38-graphic-6-mode", 415)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set GRAPHIC 6 mode as shown in [[[Figure 4.42|||Chapter4a#figure-442--graphic-6-mode-setting]]].")
  Th2HandbookHelp_Commit("3.8.1 Setting GRAPHIC 6 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#381-setting-graphic-6-mode", 416)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.42]|||img:figure_4.42]]]")
  Th2HandbookHelp_Commit("_Figure 4.42  GRAPHIC 6 mode setting_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-442-graphic-6-mode-setting_", 417)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC 6 mode, one byte of the pattern name table corresponds with 2 dots on the screen. The colour information of each dot is represented by 4 bits and 16 colours can be specified (see [[[Figure 4.43|||Chapter4a#figure-443--pattern-name-table-structure-of-graphic-6-mode]]]). The starting address of the pattern name table is set by writing the high order bit of the address in R#2. The two addresses at which the pattern name table can be set ae either 00000H or 10000H. The dot at (X,Y) coordinate on the screen can be accessed by using [[[Expression 4.3|||Chapter4a#expression-43--the-expression-for-the-access-to-the-dot-at-xy-coordinate]]]. The program of [[[List 4.4|||Chapter4a#list-44---pset-for-graphic-6-mode-written-in-basic]]] illustrates this.")
  Th2HandbookHelp_Commit("3.8.2 Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#382-pattern-name-table", 418)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.43]|||img:figure_4.43]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The dot at (X,Y) coordinate on the screen can be accessed by using Expression 4.1. The program of [[[List 4.2|||Chapter4a#list-42--pset-for-graphic-4-mode-written-in-basic]]] illustrates the use of [[[Expression 4.1|||Chapter4a#expression-41--the-expression-for-accessing-the-dot-at-xy-coordinate]]].")
  Th2HandbookHelp_Commit("_Figure 4.43  Pattern name table structure of GRAPHIC 6 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-443-pattern-name-table-structure-of-graphic-6-mode_", 419)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ADR = X/2 + Y * 256 + base address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(The colour of the dot is represented by 4 high order bits in the case that X is even and by 4 low order bits in the case that X is odd.)")
  Th2HandbookHelp_Commit("_Expression 4.3  The expression for the access to the dot at (X,Y) coordinate_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_expression-43-the-expression-for-the-access-to-the-dot-at-xy-coordinate_", 420)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@100 '*********************************************")
  Th2HandbookHelp_L("@@@110 '  LIST 4.4   dot access of GRAPHIC 6 mode")
  Th2HandbookHelp_L("@@@120 '*********************************************")
  Th2HandbookHelp_L("@@@130 '")
  Th2HandbookHelp_L("@@@140 SCREEN 7")
  Th2HandbookHelp_L("@@@150 BA=0")
  Th2HandbookHelp_L("@@@160 FOR I=0 TO 511")
  Th2HandbookHelp_L("@@@170   X=I: Y=I\2: COL=15: GOSUB 1000")
  Th2HandbookHelp_L("@@@180 NEXT")
  Th2HandbookHelp_L("@@@190 END")
  Th2HandbookHelp_L("@@@200 '")
  Th2HandbookHelp_L("@@@1000 '*************************************************")
  Th2HandbookHelp_L("@@@1010 '  PSET (X,Y)")
  Th2HandbookHelp_L("@@@1020 '   COL:color  BA:graphic Base Address")
  Th2HandbookHelp_L("@@@1030 '*************************************************")
  Th2HandbookHelp_L("@@@1040 '")
  Th2HandbookHelp_L("@@@1050 ADR=X\2+Y*256+BA")
  Th2HandbookHelp_L("@@@1060 IF X AND 1 THEN BIT=&HF: C=COL ELSE BIT=&HF0: C=COL*16")
  Th2HandbookHelp_L("@@@1070 VPOKE ADR,(VPEEK(ADR) AND BIT) OR COL")
  Th2HandbookHelp_L("@@@1080 RETURN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.4   PSET for GRAPHIC 6 mode written in BASIC_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-44-pset-for-graphic-6-mode-written-in-basic_", 421)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.44|||Chapter4a#figure-444--screen-colour-specification-in-graphic-6-mode]]]).")
  Th2HandbookHelp_Commit("3.8.3 Setting screen colour", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#383-setting-screen-colour", 422)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.44]|||img:figure_4.44]]]")
  Th2HandbookHelp_Commit("_Figure 4.44  Screen colour specification in GRAPHIC 6 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-444-screen-colour-specification-in-graphic-6-mode_", 423)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("GRAPHIC 7 mode is described as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| screen:               256 (horizontal) x 212 (vertical) dots             |")
  Th2HandbookHelp_L("@@@|                       (or, 192 vertical)                                 |")
  Th2HandbookHelp_L("@@@|                       256 colours can be displayed at the same time      |")
  Th2HandbookHelp_L("@@@| command:              graphic command by hardware available              |")
  Th2HandbookHelp_L("@@@| sprite:               mode 2 sprite function available                   |")
  Th2HandbookHelp_L("@@@| memory requirements:  for 192 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 48K bytes (C000H bytes)    |")
  Th2HandbookHelp_L("@@@|                         (8 bits x 256 x 192)                             |")
  Th2HandbookHelp_L("@@@|                       for 212 dots                                       |")
  Th2HandbookHelp_L("@@@|                         bitmap screen ....... 53K bytes (D400H bytes)    |")
  Th2HandbookHelp_L("@@@|                         (8 bits x 256 x 212)                             |")
  Th2HandbookHelp_L("@@@|                       Note that this mode cannot be used with 64K byte   |")
  Th2HandbookHelp_L("@@@|                       VRAM machines, as in the case of GRAPHIC 6         |")
  Th2HandbookHelp_L("@@@| BASIC:                compatible to SCREEN 8                             |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("3.9 GRAPHIC 7 Mode Use", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#39-graphic-7-mode-use", 424)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Set GRAPHIC 7 mode as shown in [[[Figure 4.45|||Chapter4a#figure-445--graphic-4-mode-setting]]].")
  Th2HandbookHelp_Commit("3.9.1 Setting GRAPHIC 7 mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#391-setting-graphic-7-mode", 425)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.45]|||img:figure_4.45]]]")
  Th2HandbookHelp_Commit("_Figure 4.45  GRAPHIC 4 mode setting_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-445-graphic-4-mode-setting_", 426)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Configuration of GRAPHIC 7 mode is the simplest of all modes; one dot on the screen corresponds with one byte in the pattern name table. The value of one byte written in the table represents 256 kinds of colours. The starting address of the pattern name table is set by R#2. The two addresses at which the pattern name table can be set are either 00000H or 10000H (see [[[Figure 4.46|||Chapter4a#figure-446--pattern-name-table-structure-of-graphic-7-mode]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("One byte of data represents the intensity of 3 bits for green, 3 bits for red, and 2 bits for blue, as shown in [[[Figure 4.47|||Chapter4a#figure-447--rgb-brightness-information]]]. The dot at (X,Y) coordinate on the screen can be accessed by using [[[Expression 4.4|||Chapter4a#expression-44-the-expression-for-accessing-to-the-dot-at-xy-coordinate]]].")
  Th2HandbookHelp_Commit("3.9.2 Pattern name table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#392-pattern-name-table", 427)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.46]|||img:figure_4.46]]]")
  Th2HandbookHelp_Commit("_Figure 4.46  Pattern name table structure of GRAPHIC 7 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-446-pattern-name-table-structure-of-graphic-7-mode_", 428)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.47]|||img:figure_4.47]]]")
  Th2HandbookHelp_Commit("_Figure 4.47  RGB brightness information_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-447-rgb-brightness-information_", 429)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ADR = X + Y * 256 + base address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Expression 4.4_ The expression for accessing to the dot at (X,Y) coordinate", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_expression-44_-the-expression-for-accessing-to-the-dot-at-xy-coordinate", 430)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The border colour of the screen can be specified by R#7 (see [[[Figure 4.48|||Chapter4a#figure-448--screen-colour-specification-in-graphic-7-mode]]]).")
  Th2HandbookHelp_Commit("3.9.3 Setting the screen colour", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#393-setting-the-screen-colour", 431)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.48]|||img:figure_4.48]]]")
  Th2HandbookHelp_Commit("_Figure 4.48  Screen colour specification in GRAPHIC 7 mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-448-screen-colour-specification-in-graphic-7-mode_", 432)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Detailed settings for the screen display are available in MSX-VIDEO. These include screen ON/OFF and specification of the display location. These MSX-VIDEO functions are described in this function.")
  Th2HandbookHelp_Commit("4. MISCELLANEOUS FUNCTIONS FOR THE SCREEN DISPLAY", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#4-miscellaneous-functions-for-the-screen-display", 433)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The screen ON/OFF function is controlled by bit 6 of R#1 (see [[[Figure 4.49|||Chapter4a#figure-449--screen-onoff]]]). When set OFF, the entire screen changes to the colour specified by the 4 low order bits of R#7 (8 bits in GRAPHIC 7 mode). Drawing with the VDP commands is faster when the screen is set OFF.")
  Th2HandbookHelp_Commit("Screen ON/OFF", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#screen-onoff", 434)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.49]|||img:figure_4.49]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("BASIC program lines:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@   VDP(1)=VDP(1) AND &B10111111 ⟵ Screen OFF")
  Th2HandbookHelp_L("@@@   VDP(1)=VDP(1) OR  &B01000000 ⟵ Screen ON")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.49  Screen ON/OFF_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-449-screen-onoff_", 435)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("R#18 is used for adjusting the display location on the screen (see [[[Figure 4.50|||Chapter4a#figure-450--adjustment-of-the-screen-display]]]). This corresponds with the " + Chr(34) + "SET ADJUST" + Chr(34) + " instruction of BASIC.")
  Th2HandbookHelp_Commit("Adjustment of the display location on the screen", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#adjustment-of-the-display-location-on-the-screen", 436)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.50]|||img:figure_4.50]]]")
  Th2HandbookHelp_Commit("_Figure 4.50  Adjustment of the screen display_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-450-adjustment-of-the-screen-display_", 437)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The number of dots displayed in the Y direction on the screen can be switched to either 192 dots or 212 dots by setting bit 7 of R#9 to 0 or 1. This function is only valid for five screen modes, TEXT 2, and GRAPHIC 4 to GRAPHIC 7 modes. When 212 dots are set in TEXT 2 mode, the number of text lines is 26.5 (=212/8) and on the 27th line only the upper halves of characters are displayed.")
  Th2HandbookHelp_Commit("Switching the number of pixels in the Y direction", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#switching-the-number-of-pixels-in-the-y-direction", 438)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.51]|||img:figure_4.51]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("BASIC program lines:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@   VDP(10)=VDP(10) AND &B01111111 ⟵ 192 dots")
  Th2HandbookHelp_L("@@@   VDP(10)=VDP(10) OR  &B10000000 ⟵ 212 dots")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.51  Switching the number of dots in the vertical direction_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-451-switching-the-number-of-dots-in-the-vertical-direction_", 439)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC modes 4 to 7, the display pages can be easily switched by setting the starting address of the pattern name table using R#2. In fact, the second parameter of the " + Chr(34) + "SET PAGE" + Chr(34) + " BASIC instruction switches the display page this way.")
  Th2HandbookHelp_Commit("Switching the display page", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#switching-the-display-page", 440)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.52]|||img:figure_4.52]]]")
  Th2HandbookHelp_Commit("_Figure 4.52  Switching pages_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-452-switching-pages_", 441)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In GRAPHIC modes 4 to 7, two pages can be displayed alternately by using the following method. Either page 0 and page 1, or page 2 and page 3 can be displayed alternately.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("To begin the alternate display, select the odd-numbered page (1 or 3) using R#2 and set the screen alternation rate in R#13. The 4 high order bits of R#13 represent the time for displaying the even page and the 4 low order bits represent the time for displaying the odd page. The time is set in 1/6 seconds interval. Setting 0 for both time periods causes only the odd page to be displayed.")
  Th2HandbookHelp_Commit("Automatic alternate screen display", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#automatic-alternate-screen-display", 442)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.53]|||img:figure_4.53]]]")
  Th2HandbookHelp_Commit("_Figure 4.53  Setting the rate of the screen alternation_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-453-setting-the-rate-of-the-screen-alternation_", 443)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The interlaced mode allows an apparent screen resolution in the Y direction of double the normal mode. A resolution of up to 424 dots in the Y direction can be achieved using this mode. This is done by alternating at high speed the normal screen and a screen whose scanning lines are offset vertically by half a line. In MSX-VIDEO the interlaced mode is specified by setting bit 3 of R#9 ro " + Chr(34) + "1" + Chr(34) + ". The two screens are switched 60 times a second.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the odd page is selected in GRAPHIC 4 to GRAPHIC 7 screen modes and the alternate screen display mode is selected, the screen is normally switched at slow rates specified in units of 1/6 seconds. However, combinig this function and the interlaced function can make the number of the vertical dots of the display screen seem double.")
  Th2HandbookHelp_Commit("Setting the interlaced mode", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-the-interlaced-mode", 444)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.54]|||img:figure_4.54]]]")
  Th2HandbookHelp_Commit("_Figure 4.54  Setting the interlaced mode_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-454-setting-the-interlaced-mode_", 445)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '***************************************************")
  Th2HandbookHelp_L("@@@1010 '  [List 4.5](#list-45--interlaced-mode-example)  interlace mode")
  Th2HandbookHelp_L("@@@1020 '***************************************************")
  Th2HandbookHelp_L("@@@1030 '")
  Th2HandbookHelp_L("@@@1040 COLOR 15,0,0 : SCREEN 5,,,,,0     'noninterlace mode")
  Th2HandbookHelp_L("@@@1050 '")
  Th2HandbookHelp_L("@@@1060 SET PAGE 0,0 : CLS")
  Th2HandbookHelp_L("@@@1070 LINE (32,0)-(64,120),15,BF")
  Th2HandbookHelp_L("@@@1080 SET PAGE 1,1 : CLS")
  Th2HandbookHelp_L("@@@1090 LINE (192,91)-(224,211),15,BF")
  Th2HandbookHelp_L("@@@1100 '")
  Th2HandbookHelp_L("@@@1110 VDP(10)=VDP(10) OR &B00001100     'interlace mode!!!")
  Th2HandbookHelp_L("@@@1120 '")
  Th2HandbookHelp_L("@@@1130 FOR I=32 TO 192")
  Th2HandbookHelp_L("@@@1140   SET PAGE 1,0")
  Th2HandbookHelp_L("@@@1150   LINE (I,0)-STEP(0,120),0")
  Th2HandbookHelp_L("@@@1160   LINE (I+33,0)-STEP(0,120),15")
  Th2HandbookHelp_L("@@@1170   SET PAGE 1,1")
  Th2HandbookHelp_L("@@@1180   LINE (256-I,91)-STEP(0,120),0")
  Th2HandbookHelp_L("@@@1190   LINE (221-I,91)-STEP(0,120),15")
  Th2HandbookHelp_L("@@@1200 NEXT I")
  Th2HandbookHelp_L("@@@1210 '")
  Th2HandbookHelp_L("@@@1220 VDP(10)=VDP(10) AND &B11110011    'interlace off")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.5  Interlaced mode example_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-45-interlaced-mode-example_", 446)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("R#23 is used to set the line at which display begins on the screen. Changing this register enables vertical scrolling of the screen. Note that, since the scroll is done every 256 lines, the sprite tables should be moved to another page. [[[List 4.6|||Chapter4a#list-46--vertical-scroll-example]]] shows an example.")
  Th2HandbookHelp_Commit("Vertical scroll of the screen", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#vertical-scroll-of-the-screen", 447)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '**************************************************************")
  Th2HandbookHelp_L("@@@1010 '  List 4.6  Hardware scroll")
  Th2HandbookHelp_L("@@@1020 '**************************************************************")
  Th2HandbookHelp_L("@@@1030 '")
  Th2HandbookHelp_L("@@@1040 SCREEN 5,2: COLOR 15,0,0: CLS")
  Th2HandbookHelp_L("@@@1050 COPY (0,0)-(255,43) TO (0,212),,PSET   'erase (212,0)-(255,255)")
  Th2HandbookHelp_L("@@@1060 '")
  Th2HandbookHelp_L("@@@1070 FOR I=1 TO 8: D(I)=VAL(MID$(" + Chr(34) + "00022220" + Chr(34) + ",I,1))-1: NEXT")
  Th2HandbookHelp_L("@@@1080 '")
  Th2HandbookHelp_L("@@@1090 OPEN " + Chr(34) + "GRP:" + Chr(34) + " AS #1")
  Th2HandbookHelp_L("@@@1100 FOR I=0 TO 3")
  Th2HandbookHelp_L("@@@1110   PRESET (64,I*64): PRINT #1," + Chr(34) + "Hit CURSOR Key" + Chr(34))
  Th2HandbookHelp_L("@@@1120 NEXT")
  Th2HandbookHelp_L("@@@1130 '")
  Th2HandbookHelp_L("@@@1140 J=STICK(0)")
  Th2HandbookHelp_L("@@@1150   P=(P+D(J)) AND &HFF")
  Th2HandbookHelp_L("@@@1160   VDP(24)=P")
  Th2HandbookHelp_L("@@@1170 GOTO 1140")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.6  Vertical scroll example_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_list-46-vertical-scroll-example_", 448)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Among the 16 colour codes, only code 0 can be made as a " + Chr(34) + "transparent" + Chr(34) + " colour (the border colour of the screen can be set transparently), the colour set in palette P#0. Setting bit 5 of R#8 to " + Chr(34) + "1" + Chr(34) + " disables thsi function and the colour code 0 changes to the colour defined by the palette P#0.")
  Th2HandbookHelp_Commit("Specifying the colour code 0 function", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#specifying-the-colour-code-0-function", 449)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.55]|||img:figure_4.55]]]")
  Th2HandbookHelp_Commit("_Figure 4.55  Colour code 0 function_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-455-colour-code-0-function_", 450)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In MSX-VIDEO an interrupt can be generated just after the CRT finishes displaying a specific scanning line. Set in R#19 the number of the scanning line at which the interrupt should be generated, and set bit 4 of R#0 to " + Chr(34) + "1" + Chr(34) + " (see [[[Figure 4.56|||Chapter4a#figure-456--generating-the-scanning-line-interrupt]]]).")
  Th2HandbookHelp_Commit("Generating interrupts by the scanning line location", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#generating-interrupts-by-the-scanning-line-location", 451)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 4.56]|||img:figure_4.56]]]")
  Th2HandbookHelp_Commit("_Figure 4.56  Generating the scanning line interrupt_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-456-generating-the-scanning-line-interrupt_", 452)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sprites are used to display movable character patterns of 8 x 8 or 16 x 16 dots on the screen. This function is especially useful in the programming of games.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The parameters specified are the X and Y coordinates, the character number, and the colour code. The sprite is displayed by writing this data to the preset sprite attribute table.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("There are two modes for MSX2 sprites. Mode 1 is compatible to the TMS9918 used in the MSX1 machines. Mode 2 includes several improved functions and has been implemented on the MSX2. This section summarises the sprite function and describes the two modes.")
  Th2HandbookHelp_Commit("5. SPRITES", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#5-sprites", 453)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Up to 32 sprites can be displayed on one screen at a time.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Sprites have two sizes, 8 x 8 and 16 x 16 dots. Only one size can be displayed on the screen at a time. The size of one dot of the sprite is usually the same as one pixel, but in the case of GRPAHIC5 and 6 modes (for both, the resolution is 512 x 212) the horizontal size is two pixels, that is, the absolute size of the sprite is the same in any mode.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The Sprite mode automatically selected is determined by the screen mode in use. Shown below are the default settings:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Sprite mode 1 selected: ....... GRAPHIC 1       (SCREEN 1)")
  Th2HandbookHelp_L("@@@                                GRAPHIC 2       (SCREEN 2)")
  Th2HandbookHelp_L("@@@                                MULTI colour    (SCREEN 3)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Sprite mode 2 selected: ....... GRAPHIC 3       (SCREEN 4)")
  Th2HandbookHelp_L("@@@                                GRAPHIC 4       (SCREEN 5)")
  Th2HandbookHelp_L("@@@                                GRAPHIC 5       (SCREEN 6)")
  Th2HandbookHelp_L("@@@                                GRAPHIC 6       (SCREEN 7)")
  Th2HandbookHelp_L("@@@                                GRAPHIC 7       (SCREEN 8)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("5.1 Sprite Function", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#51-sprite-function", 454)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sprite mode 1 has the same functions as the sprite mode of MSX1 machines. Thus programs using this mode can also be run on the MSX1.")
  Th2HandbookHelp_Commit("5.2 Sprite mode 1", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#52-sprite-mode-1", 455)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are 32 sprites numbered from 0 to 31. Sprites with the smallest numbers have the highest priority. When sprites are placed on the same horizontal line of the screen, up to 4 sprites are placed in their order priority, and the portions of the 5th sprite or higher which conflict with the existing four sprites on a given line are not displayed.")
  Th2HandbookHelp_Commit("5.2.1 Number of sprites to be displayed", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#521-number-of-sprites-to-be-displayed", 456)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                                       |")
  Th2HandbookHelp_L("@@@|            --------     --------            --------                  |")
  Th2HandbookHelp_L("@@@|  --------  |  #2  |     |  #3  |  --------  |  #5  |                  |")
  Th2HandbookHelp_L("@@@|  |  #1  |  |      |     |      |  |  #4  |  :      :   ::::::::       |")
  Th2HandbookHelp_L("@@@|  |      |  --------     --------  |      |  ::::::::   :  #6  :       |")
  Th2HandbookHelp_L("@@@|  --------                         --------             |      |       |")
  Th2HandbookHelp_L("@@@|                                                        --------       |")
  Th2HandbookHelp_L("@@@|                                                                       |")
  Th2HandbookHelp_L("@@@|                                                                       |")
  Th2HandbookHelp_L("@@@|                                                                       |")
  Th2HandbookHelp_L("@@@-------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.57  Number of sprites to be displayed (sprite mode 1)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-457-number-of-sprites-to-be-displayed-sprite-mode-1_", 457)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following descriptions are settings to display the sprite.")
  Th2HandbookHelp_Commit("5.2.2 Sprite display settings", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#522-sprite-display-settings", 458)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("8 x 8 dots or 16 x 16 dots can be set (see [[[Figure 4.58|||Chapter4a#figure-458--setting-the-size-of-the-sprite]]]). By default, 8 x 8 dots is selected.")
  Th2HandbookHelp_Commit("Setting the size of the sprite", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-the-size-of-the-sprite", 459)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#1     | .  | .  | .  | .  | .  | .  | X  | .  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                                        |    0: 8 x 8 dots")
  Th2HandbookHelp_L("@@@                                        +-->")
  Th2HandbookHelp_L("@@@                                             1: 16 x 16 dots")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  8 x 8 dots                             16 x 16 dots")
  Th2HandbookHelp_L("@@@-------------- -                ------------------------------  -")
  Th2HandbookHelp_L("@@@|            | ^                |                            |  ^")
  Th2HandbookHelp_L("@@@|            | |                |                            |  |")
  Th2HandbookHelp_L("@@@|            | 8 dots           |                            |  |")
  Th2HandbookHelp_L("@@@|            | |                |                            |  |")
  Th2HandbookHelp_L("@@@|            | V                |                            |  |")
  Th2HandbookHelp_L("@@@-------------- -                |                            | 16 dots")
  Th2HandbookHelp_L("@@@|<- 8 dots ->|                  |                            |  |")
  Th2HandbookHelp_L("@@@                                |                            |  |")
  Th2HandbookHelp_L("@@@                                |                            |  |")
  Th2HandbookHelp_L("@@@                                |                            |  |")
  Th2HandbookHelp_L("@@@                                |                            |  V")
  Th2HandbookHelp_L("@@@                                ------------------------------  -")
  Th2HandbookHelp_L("@@@                                |<---    16 x 16 dots    --->|")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.58  Setting the size of the sprite_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-458-setting-the-size-of-the-sprite_", 460)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Figure 4.59 shows how to select whether one dot of the sprite corresponds to one dot of the screen or whether it is expanded double in both the horizontal and vertical directions. By default, the one dot to one dot size is selected.")
  Th2HandbookHelp_Commit("Expanding the sprite", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#expanding-the-sprite", 461)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#1     | .  | .  | .  | .  | .  | .  | .  | X  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                                             |    0: normal mode")
  Th2HandbookHelp_L("@@@                                             +-->")
  Th2HandbookHelp_L("@@@                                                  1: expansion mode (2X)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.59  Expanding the sprite_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-459-expanding-the-sprite_", 462)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sprite patterns are defined in the sprite pattern generator table in VRAM. Up to 256 sprites can be defined in the case of 8 x 8 dots, and up to 64 for 16 x 16 dots. Each pattern is numbered from 0 to 255 and is allocated in VRAM as shown in [[[Figure 4.60|||Chapter4a#figure-460--structure-of-the-sprite-pattern-generator-table-sprite-mode-1]]]. For 16 x 16 dots, four 8 x 8 patterns are used from the top of the table. In this case, using any number of these four patterns causes the same sprite to be specified. R#6 is used to set the address in the sprite pattern generator table as shown in [[[Figure 4.60|||Chapter4a#figure-460--structure-of-the-sprite-pattern-generator-table-sprite-mode-1]]].")
  Th2HandbookHelp_Commit("Setting the sprite pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-the-sprite-pattern-generator-table", 463)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@            VRAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@      |<-- 1 byte  -->|")
  Th2HandbookHelp_L("@@@  -   ----------------- ---+  <--- R#6")
  Th2HandbookHelp_L("@@@  ^   |               |    |       -----------------------------------------")
  Th2HandbookHelp_L("@@@  |   |               |    |       |  0 |  0 | A16| A15| A14| A13| A12| A11|")
  Th2HandbookHelp_L("@@@  |   |               |    |       -----------------------------------------")
  Th2HandbookHelp_L("@@@  8   |               | Pattern")
  Th2HandbookHelp_L("@@@bytes |               |   #0")
  Th2HandbookHelp_L("@@@  |   |               |    |")
  Th2HandbookHelp_L("@@@  |   |               |    |")
  Th2HandbookHelp_L("@@@  V   |               |    |")
  Th2HandbookHelp_L("@@@  -   |---------------| ---+")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |               | Pattern")
  Th2HandbookHelp_L("@@@      |               |   #1")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |               |    |")
  Th2HandbookHelp_L("@@@      |---------------| ---+")
  Th2HandbookHelp_L("@@@      |       .       |")
  Th2HandbookHelp_L("@@@              .")
  Th2HandbookHelp_L("@@@              .")
  Th2HandbookHelp_L("@@@      |               |")
  Th2HandbookHelp_L("@@@      |---------------| Pattern #255")
  Th2HandbookHelp_L("@@@      |               |")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.60  Structure of the sprite pattern generator table (sprite mode 1)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-460-structure-of-the-sprite-pattern-generator-table-sprite-mode-1_", 464)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Each sprite is displayed in one of 32 " + Chr(34) + "sprite planes" + Chr(34) + " exclusively, and the sprite status for each sprite plane is recorded using 4 bytes. The area having the information for each sprite plane is called the sprite attribute table. The starting address in VRAM for this table is set in R#5 and R#11 as shown in [[[Figure 4.61|||Chapter4a#figure-461--structure-of-the-sprite-attribute-table-sprite-mode-1]]].")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The four bytes in the attribute table contain the following information:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Y-coordinate:** specifies Y-coordinate of the sprite. Note that the top line of the screen is not 0 but 255. Setting this value in 208 (D0H) causes sprites after this plane not to be displayed.")
  Th2HandbookHelp_L("* **X-coordinate:** specifies X-coordinate of the sprite.")
  Th2HandbookHelp_L("* **pattern number:** specifies the character in the sprite pattern generator table to be displayed.")
  Th2HandbookHelp_L("* **colour code:** specifies the colour (palette number) of the portion where the bit of the sprite pattern is " + Chr(34) + "1" + Chr(34) + ".                * **EC:** Setting " + Chr(34) + "1" + Chr(34) + " to this bit causes the sprite to be shifted for 32 bits to the left. Using this function enables the dot of the sprite to be displayed one by one from the left edge of the screen.")
  Th2HandbookHelp_Commit("Setting the sprite attribute table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-the-sprite-attribute-table", 465)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@    -   ----------------------------------------- --+  ⟵ (*)")
  Th2HandbookHelp_L("@@@    ^   |    :   Y coordinate (0 to 255)   :    |   |")
  Th2HandbookHelp_L("@@@    |   |----+----+----+----+----+----+----+----|   |")
  Th2HandbookHelp_L("@@@    |   |    :   X coordinate (0 to 255)   :    |   |")
  Th2HandbookHelp_L("@@@4 bytes |----+----+----+----+----+----+----+----| Sprite #0 attribute area")
  Th2HandbookHelp_L("@@@    |   |    :  Pattern number (0 to 255)  :    |   |")
  Th2HandbookHelp_L("@@@    |   |----+----+----+----+----+----+----+----|   |")
  Th2HandbookHelp_L("@@@    V   | EC | 0  | 0  | 0  |    Colour code    |   |")
  Th2HandbookHelp_L("@@@    -   |----+----+----+----+----+----+----+----| --+")
  Th2HandbookHelp_L("@@@        |                                       |   |")
  Th2HandbookHelp_L("@@@        |                                       |   | Sprite #1 attribute area")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        |                                       |   | Sprite #31 attribute area")
  Th2HandbookHelp_L("@@@        |                                       |   |")
  Th2HandbookHelp_L("@@@        ----------------------------------------- --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@(*)  R#5     | A14| A13| A12| A11| A10| 1  | 1  | 1  |")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@     R#11    | 0  | 0  | 0  | 0  | 0  | 0  | A16| A15|")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    -------------------------------------------")
  Th2HandbookHelp_L("@@@    |                                         |")
  Th2HandbookHelp_L("@@@    |    ---------------------------------    |")
  Th2HandbookHelp_L("@@@    |    |                               |    |")
  Th2HandbookHelp_L("@@@    |    |               |            ###|:   |")
  Th2HandbookHelp_L("@@@    |    |               |               |    |")
  Th2HandbookHelp_L("@@@    |    |               |             ##|::  |")
  Th2HandbookHelp_L("@@@    |    |               |               |    |     EC bit = " + Chr(34) + "0" + Chr(34))
  Th2HandbookHelp_L("@@@    |    |               V              #|::: |")
  Th2HandbookHelp_L("@@@    |    |                               |    |")
  Th2HandbookHelp_L("@@@    |    |####                           |    |")
  Th2HandbookHelp_L("@@@    |    |  ^                            |    |")
  Th2HandbookHelp_L("@@@    |    ---+-----------------------------    |")
  Th2HandbookHelp_L("@@@    |       |                                 |")
  Th2HandbookHelp_L("@@@    --------+----------------------------------")
  Th2HandbookHelp_L("@@@            |")
  Th2HandbookHelp_L("@@@The sprite will display from here (X coordinate = 0)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    -------------------------------------------")
  Th2HandbookHelp_L("@@@    |                                         |")
  Th2HandbookHelp_L("@@@    |    ---------------------------------    |")
  Th2HandbookHelp_L("@@@    |    |                               |    |")
  Th2HandbookHelp_L("@@@    | :::|#              |               |    |")
  Th2HandbookHelp_L("@@@    |    |               |               |    |")
  Th2HandbookHelp_L("@@@    |  ::|##             |               |    |")
  Th2HandbookHelp_L("@@@    |    |               |               |    |     EC bit = " + Chr(34) + "1" + Chr(34))
  Th2HandbookHelp_L("@@@    |   :|###            V               |    |")
  Th2HandbookHelp_L("@@@    |    |                               |    |")
  Th2HandbookHelp_L("@@@    |    |####                       ####|    |")
  Th2HandbookHelp_L("@@@    |    |                            ^  |    |")
  Th2HandbookHelp_L("@@@    |    -----------------------------+---    |")
  Th2HandbookHelp_L("@@@    |                                 |       |")
  Th2HandbookHelp_L("@@@    ----------------------------------+--------")
  Th2HandbookHelp_L("@@@                                      |")
  Th2HandbookHelp_L("@@@The sprite will display until here (X coordinate = 255)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.61  Structure of the sprite attribute table (sprite mode 1)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-461-structure-of-the-sprite-attribute-table-sprite-mode-1_", 466)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When two sprites conflict, bit 5 of S#0 becomes " + Chr(34) + "1" + Chr(34) + " to inform of the conflict. A " + Chr(34) + "conflict" + Chr(34) + " means that bits " + Chr(34) + "1" + Chr(34) + " in the sprite pattern whose colour is not " + Chr(34) + "transparent" + Chr(34) + " occupy the same coordinate (see [[[Figure 4.62|||Chapter4a#figure-462--conflict-of-sprites-sprite-mode-1]]])")
  Th2HandbookHelp_Commit("5.2.3 Judging the sprite conflicts", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#523-judging-the-sprite-conflicts", 467)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#0     | .  | .  | X  | .  | .  | .  | .  | .  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                    |    0: Normal")
  Th2HandbookHelp_L("@@@                    +-->")
  Th2HandbookHelp_L("@@@                         1: A sprite conflict exists")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    +-- ---------------------                     ---------------------")
  Th2HandbookHelp_L("@@@    |   | \\\\\\\ |         |                     | \\\\\\\ |         |")
  Th2HandbookHelp_L("@@@    |   | \\\\\\\ |         | <--- Sprite 1 --->  | \\ -----+---------+-----")
  Th2HandbookHelp_L("@@@8 or 16 | \\\\\\\ |         |                     | \\ | xx | // |    |    |")
  Th2HandbookHelp_L("@@@ dots   |---------+---------+----------           |----+----- // |    |    |")
  Th2HandbookHelp_L("@@@    |   |         | /////// |         |           |    | /////// |    |    |")
  Th2HandbookHelp_L("@@@    |   |         | /////// |         |           |    |----------    |    |")
  Th2HandbookHelp_L("@@@    |   |         | /////// |         |           |    |              |    |")
  Th2HandbookHelp_L("@@@    +-- ----------+----------         |           -----+---------------    |")
  Th2HandbookHelp_L("@@@                  |                   | <- Sprite 2 -> |                   |")
