  Th2HandbookHelp_L("@@@;  List 4.22  paint routine using PSET and POINT")
  Th2HandbookHelp_L("@@@;       ENTRY:  X:H, Y:L, BORDER COLOR:D, PAINT COLOR:E")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        EXTRN   PSET")
  Th2HandbookHelp_L("@@@        EXTRN   POINT")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Q.LENGTH        EQU     256*2*2")
  Th2HandbookHelp_L("@@@MAX.Y           EQU     211")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- paint main routine -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PAINT:  CALL    POINT")
  Th2HandbookHelp_L("@@@        CP      D")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        CALL    INIT.Q")
  Th2HandbookHelp_L("@@@        LD      (COL),DE")
  Th2HandbookHelp_L("@@@        CALL    PUT.Q")
  Th2HandbookHelp_L("@@@        LD      A,(COL)")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        XOR     A                       ;logi-OP : PSET")
  Th2HandbookHelp_L("@@@        CALL    PSET")
  Th2HandbookHelp_L("@@@PAINT0: CALL    GET.Q")
  Th2HandbookHelp_L("@@@        RET     C")
  Th2HandbookHelp_L("@@@        INC     H")
  Th2HandbookHelp_L("@@@        CALL    NZ,PAINT.SUB")
  Th2HandbookHelp_L("@@@        DEC     H")
  Th2HandbookHelp_L("@@@        JP      Z,PAINT1")
  Th2HandbookHelp_L("@@@        DEC     H")
  Th2HandbookHelp_L("@@@        CALL    PAINT.SUB")
  Th2HandbookHelp_L("@@@        INC     H")
  Th2HandbookHelp_L("@@@PAINT1: DEC     L")
  Th2HandbookHelp_L("@@@        LD      A,-1")
  Th2HandbookHelp_L("@@@        CP      L")
  Th2HandbookHelp_L("@@@        CALL    NZ,PAINT.SUB")
  Th2HandbookHelp_L("@@@        INC     L")
  Th2HandbookHelp_L("@@@        INC     L")
  Th2HandbookHelp_L("@@@        LD      A,MAX.Y")
  Th2HandbookHelp_L("@@@        CP      L")
  Th2HandbookHelp_L("@@@        CALL    NC,PAINT.SUB")
  Th2HandbookHelp_L("@@@        JP      PAINT0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- check point and pset -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PAINT.SUB:")
  Th2HandbookHelp_L("@@@        CALL    POINT")
  Th2HandbookHelp_L("@@@        LD      D,A")
  Th2HandbookHelp_L("@@@        LD      A,(BORD)")
  Th2HandbookHelp_L("@@@        CP      D")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        LD      A,(COL)")
  Th2HandbookHelp_L("@@@        CP      D")
  Th2HandbookHelp_L("@@@        RET     Z")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    PSET")
  Th2HandbookHelp_L("@@@        CALL    PUT.Q")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- init Q.BUFFER pointer -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INIT.Q:")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        LD      HL,Q.BUF")
  Th2HandbookHelp_L("@@@        LD      (Q.TOP),HL")
  Th2HandbookHelp_L("@@@        LD      (Q.BTM),HL")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- put point to Q.BUF (X:H , Y:L) -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PUT.Q:")
  Th2HandbookHelp_L("@@@        EX      DE,HL")
  Th2HandbookHelp_L("@@@        LD      HL,(Q.TOP)")
  Th2HandbookHelp_L("@@@        LD      BC,Q.BUF+Q.LENGTH+1")
  Th2HandbookHelp_L("@@@        OR      A                       ;clear CARRY")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        SBC     HL,BC")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        JP      C,PUT.Q1")
  Th2HandbookHelp_L("@@@        LD      HL,Q.BUF")
  Th2HandbookHelp_L("@@@PUT.Q1:")
  Th2HandbookHelp_L("@@@        LD      (HL),D")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      (HL),E")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      (Q.TOP),HL")
  Th2HandbookHelp_L("@@@        EX      DE,HL")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- take point data to D, E -----")
  Th2HandbookHelp_L("@@@;      returns:   NC   H:x, L:y")
  Th2HandbookHelp_L("@@@;                 C    buffer empty")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.Q:  LD      HL,(Q.BTM)")
  Th2HandbookHelp_L("@@@        LD      BC,(Q.TOP)")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        SBC     HL,BC")
  Th2HandbookHelp_L("@@@        JP      NZ,GET.Q0")
  Th2HandbookHelp_L("@@@        SCF")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.Q0: LD      HL,(Q.BTM)")
  Th2HandbookHelp_L("@@@        LD      BC,Q.BUF+Q.LENGTH+1")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        SBC     HL,BC")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        JP      C,GET.Q1")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      HL,Q.BUF")
  Th2HandbookHelp_L("@@@GET.Q1: LD      D,(HL)")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      E,(HL)")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      (Q.BTM),HL")
  Th2HandbookHelp_L("@@@        OR      A")
  Th2HandbookHelp_L("@@@        EX      DE,HL")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- work area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@COL     DS      1")
  Th2HandbookHelp_L("@@@BORD    DS      1")
  Th2HandbookHelp_L("@@@Q.TOP   DS      2")
  Th2HandbookHelp_L("@@@Q.BTM   DS      2")
  Th2HandbookHelp_L("@@@Q.BUF   DS      Q.LENGTH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.22  PAINT routine using PSET and POINT_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-422-paint-routine-using-pset-and-point_", 556)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@1000 '***********************************************")
  Th2HandbookHelp_L("@@@1010 ' List 4.23   paint routine using POINT and PSET")
  Th2HandbookHelp_L("@@@1020 ' Position cursor at beginnig of paint area and press the space bar.")
  Th2HandbookHelp_L("@@@1030 '***********************************************")
  Th2HandbookHelp_L("@@@1040 '")
  Th2HandbookHelp_L("@@@1050 SCREEN 5")
  Th2HandbookHelp_L("@@@1060 FOR I=0 TO 50")
  Th2HandbookHelp_L("@@@1070 LINE -(RND(1)*255,RND(1)*211),15")
  Th2HandbookHelp_L("@@@1080 NEXT")
  Th2HandbookHelp_L("@@@1090 I=&HA000 :DEF USR=I")
  Th2HandbookHelp_L("@@@1100 READ A$")
  Th2HandbookHelp_L("@@@1110 IF  A$=" + Chr(34) + "END" + Chr(34) + " THEN 1150")
  Th2HandbookHelp_L("@@@1120   POKE I,VAL(" + Chr(34) + "&H" + Chr(34) + "+A$):I=I+1")
  Th2HandbookHelp_L("@@@1130   READ A$")
  Th2HandbookHelp_L("@@@1140 GOTO 1110")
  Th2HandbookHelp_L("@@@1150 X=128:Y=100:COL=15:PCOL=2")
  Th2HandbookHelp_L("@@@1160 CURS=0")
  Th2HandbookHelp_L("@@@1170 A=STICK(0)")
  Th2HandbookHelp_L("@@@1180 CURS=(CURS+1) AND 1")
  Th2HandbookHelp_L("@@@1190 LINE (X-5,Y)-(X+5,Y),15,,XOR")
  Th2HandbookHelp_L("@@@1200 LINE (X,Y-5)-(X,Y+5),15,,XOR")
  Th2HandbookHelp_L("@@@1210 IF CURS=1 THEN 1310")
  Th2HandbookHelp_L("@@@1220 IF A=1 THEN Y=Y-1")
  Th2HandbookHelp_L("@@@1230 IF A=2 THEN Y=Y-1:X=X+1")
  Th2HandbookHelp_L("@@@1240 IF A=3 THEN X=X+1")
  Th2HandbookHelp_L("@@@1250 IF A=4 THEN X=X+1:Y=Y+1")
  Th2HandbookHelp_L("@@@1260 IF A=5 THEN Y=Y+1")
  Th2HandbookHelp_L("@@@1270 IF A=6 THEN Y=Y+1:X=X-1")
  Th2HandbookHelp_L("@@@1280 IF A=7 THEN X=X-1")
  Th2HandbookHelp_L("@@@1290 IF A=8 THEN X=X-1:Y=Y-1")
  Th2HandbookHelp_L("@@@1300 IF STRIG(0) THEN GOSUB 1320")
  Th2HandbookHelp_L("@@@1310 GOTO 1170")
  Th2HandbookHelp_L("@@@1320 POKE &HA8CA,Y")
  Th2HandbookHelp_L("@@@1330 POKE &HA8CB,X")
  Th2HandbookHelp_L("@@@1340 POKE &HA8CD,COL")
  Th2HandbookHelp_L("@@@1350 POKE &HA8CC,PCOL")
  Th2HandbookHelp_L("@@@1360 A=USR(0)")
  Th2HandbookHelp_L("@@@1370 RETURN")
  Th2HandbookHelp_L("@@@1380 DATA ED,73,00,A8,31,CA,A8,2A,CA,A8,ED,5B,CC,A8,CD,67")
  Th2HandbookHelp_L("@@@1390 DATA A0,ED,7B,00,A8,C9,E5,21,D4,A8,22,D0,A8,22,D2,A8")
  Th2HandbookHelp_L("@@@1400 DATA E1,C9,EB,2A,D0,A8,01,D5,AC,B7,E5,ED,42,E1,DA,34")
  Th2HandbookHelp_L("@@@1410 DATA A0,21,D4,A8,72,23,73,23,22,D0,A8,EB,C9,2A,D2,A8")
  Th2HandbookHelp_L("@@@1420 DATA ED,4B,D0,A8,B7,ED,42,C2,4C,A0,37,C9,2A,D2,A8,01")
  Th2HandbookHelp_L("@@@1430 DATA D5,AC,B7,E5,ED,42,E1,DA,5D,A0,21,D4,A8,56,23,5E")
  Th2HandbookHelp_L("@@@1440 DATA 23,22,D2,A8,B7,EB,C9,CD,B8,A0,BA,C8,CD,16,A0,ED")
  Th2HandbookHelp_L("@@@1450 DATA 53,CE,A8,CD,22,A0,3A,CE,A8,5F,AF,CD,F4,A0,CD,3D")
  Th2HandbookHelp_L("@@@1460 DATA A0,D8,24,C4,A1,A0,25,CA,8F,A0,25,CD,A1,A0,24,2D")
  Th2HandbookHelp_L("@@@1470 DATA 3E,FF,BD,C4,A1,A0,2C,2C,3E,D3,BD,D4,A1,A0,C3,7E")
  Th2HandbookHelp_L("@@@1480 DATA A0,CD,B8,A0,57,3A,CF,A8,BA,C8,3A,CE,A8,BA,C8,5F")
  Th2HandbookHelp_L("@@@1490 DATA AF,CD,F4,A0,CD,22,A0,C9,F3,CD,3A,A1,ED,4B,06,00")
  Th2HandbookHelp_L("@@@1500 DATA 0C,3E,20,ED,79,3E,91,ED,79,0C,0C,AF,ED,61,ED,79")
  Th2HandbookHelp_L("@@@1510 DATA ED,69,ED,79,0D,0D,ED,79,3E,AD,ED,79,3E,40,ED,79")
  Th2HandbookHelp_L("@@@1520 DATA 3E,AE,ED,79,CD,3A,A1,3E,07,CD,2A,A1,F5,AF,CD,2A")
  Th2HandbookHelp_L("@@@1530 DATA A1,F1,FB,C9,F3,F5,CD,3A,A1,ED,4B,06,00,0C,3E,24")
  Th2HandbookHelp_L("@@@1540 DATA ED,79,3E,91,ED,79,C5,0C,0C,AF,ED,61,ED,79,ED,69")
  Th2HandbookHelp_L("@@@1550 DATA ED,79,C1,3E,2C,ED,79,3E,91,ED,79,0C,0C,ED,59,AF")
  Th2HandbookHelp_L("@@@1560 DATA ED,79,1E,50,F1,B3,ED,79,FB,C9,C5,ED,4B,06,00,0C")
  Th2HandbookHelp_L("@@@1570 DATA ED,79,3E,8F,ED,79,ED,78,C1,C9,3E,02,CD,2A,A1,E6")
  Th2HandbookHelp_L("@@@1580 DATA 01,C2,3A,A1,AF,CD,2A,A1,C9")
  Th2HandbookHelp_L("@@@1590 DATA END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.23  Example of using the PAINT routine_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-423-example-of-using-the-paint-routine_", 557)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX-VIDEO performs various screen management duties in addition to executing the specified commands. Sometimes the command execution speed seems to be a bit slow because of this. Thus, by discarding these operations, the speed of the command executions can be made faster. This can be done using the following method.")
  Th2HandbookHelp_Commit("6.6 Speeding Up Commands", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#66-speeding-up-commands", 558)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This method is useful since speedup can be realised while the screen remains displayed. Set " + Chr(34) + "1" + Chr(34) + " to bit 1 of R#8.")
  Th2HandbookHelp_Commit("1. Sprite display inhibition", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#1-sprite-display-inhibition", 559)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This method cannot be used frequently except in the case of initialising the screen, since the screen fades out in this mode. Set " + Chr(34) + "1" + Chr(34) + " to bit 6 of R#1.")
  Th2HandbookHelp_Commit("2. Screen display inhibition", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#2-screen-display-inhibition", 560)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[Table 4.7|||Chapter4b#table-47--register-status-at-command-termination]]] shows the register status at the command termination for each command.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the number of dots to be executed in Y direction assumes N, the values of SY*, DY*, and NYB can be calculated as follows:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    SY*=SY+N, DY*=DY+N .................... when DIY bit is 0")
  Th2HandbookHelp_L("@@@    SY*=SY-N, DY*=DY-N .................... when DIY bit is 1")
  Th2HandbookHelp_L("@@@    NYB=NY-N")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("*Note:* when MAJ bit is 0 in LINE, N = N - 1.")
  Th2HandbookHelp_Commit("6.7 Register Status at Command Termination", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#67-register-status-at-command-termination", 561)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@| command name | SX  | SY  | DX  | DY  | NX  | NY  | CLR |CMR H|CMR L| ARG |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     HMMC     | --- | --- | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     YMMM     | --- |  .  | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     HMMM     | --- |  .  | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     HMMV     | --- | --- | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|     LMMC     | --- | --- | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     LMCM     | --- |  .  | --- | --- | --- |  #  |  .  |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     LMMM     | --- |  .  | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     LMMV     | --- | --- | --- |  .  | --- |  #  | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|     LINE     | --- | --- | --- |  .  | --- | --- | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     SRCH     | --- | --- | --- | --- | --- | --- | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     PSET     | --- | --- | --- | --- | --- | --- | --- |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@|--------------+-----+-----+-----+-----+-----+-----+-----+-----+-----+-----|")
  Th2HandbookHelp_L("@@@|     POINT    | --- | --- | --- | --- | --- | --- |  .  |  0  | --- | --- |")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--- :   no change")
  Th2HandbookHelp_L("@@@ .  :   coordinate (SY*, DY*) and the colour code at the command termination")
  Th2HandbookHelp_L("@@@ #  :   the number of counts (NYB), when the screen edge is fetched")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 4.7  Register status at command termination_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_table-47-register-status-at-command-termination_", 562)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- In [[[Figure 4.72|||Chapter4b#figure-472--coordinate-system-of-vram]]], last " + Chr(34) + "10000H" + Chr(34) + " is corrected to " + Chr(34) + "1FFFFH" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Table 4.6|||Chapter4b#table-46--list-of-logical-operations]]], in TEOR line, " + Chr(34) + "else DC+..." + Chr(34) + " is corrected to " + Chr(34) + "else DC=..." + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.76|||Chapter4b#figure-476--register-settings-of-hmmc-command]]], in R#45 figure, DIX and DIY bits have been placed correctly (they were inverted in the original).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.79|||Chapter4b#figure-479--register-settings-of-ymmm-command]]], in R#42 and R#43 explanation, " + Chr(34) + "NY -> of dots..." + Chr(34) + " has been changed to " + Chr(34) + "NY -> number of dots..." + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[List 4.9|||Chapter4b#list-49--example-of-ymmm-command-execution]]], in the line with the comment " + Chr(34) + "YMMM command" + Chr(34) + ", 11010000 bitfield has been corrected to 11100000.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.84|||Chapter4b#figure-484--action-of-lmmc-command]]], " + Chr(34) + "*" + Chr(34) + " mark removed from the explanation of NX.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.85|||Chapter4b#figure-485--register-settings-of-lmmc-command]]], in R#45 explanation,  " + Chr(34) + "select source memory" + Chr(34) + " text has been corrected to " + Chr(34) + "select destination memory" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[List 4.13|||Chapter4b#list-413--example-of-lmcm-command-execution]]], labels beginning with " + Chr(34) + "LMMC" + Chr(34) + " have been corrected to " + Chr(34) + "LMCM" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[List 4.15|||Chapter4b#list-415--example-of-lmmv-command-execution]]], in the line with the comment " + Chr(34) + "NY" + Chr(34) + ", the " + Chr(34) + "OUT (C),H" + Chr(34) + " instruction has been corrected to " + Chr(34) + "OUT (C),L" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[section 6.5.9|||Chapter4b#659-line-drawing-a-line]]], the explanation of usage of the LINE command was mixed wih other text. It has been corrected.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.94|||Chapter4b#figure-494--actions-of-line-command]]], a line explaining the meaning of R#44 has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.97|||Chapter4b#figure-497--register-settings-of-srch-command]]], BX9 bit has been supressed in S#9 figure.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 4.99|||Chapter4b#figure-499--actions-of-pset-command]]], a line explaining the meaning of R#44 has been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Table 4.7|||Chapter4b#table-47--register-status-at-command-termination]]], " + Chr(34) + "CLR L" + Chr(34) + " has been corrected to " + Chr(34) + "CMR L" + Chr(34) + ".")
  Th2HandbookHelp_Commit("Changes from the original", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#changes-from-the-original", 563)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The basic philosophy of MSX is to have a standard interface, independent of machines or versions, to access peripherals through BIOS. Thus, the user should get to know about using BIOS first. In chapter 5, accessing peripherals using BIOS and the structure used for each peripheral are described.")
  Th2HandbookHelp_Commit("CHAPTER 5 - ACCESS TO PERIPHERALS THROUGH BIOS (Sections 1 to 6)", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#chapter-5---access-to-peripherals-through-bios-sections-1-to-6", 564)

