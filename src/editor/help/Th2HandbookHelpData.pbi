  Th2HandbookHelp_Commit("GRPPRT (008DH) *2", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#grpprt-008dh-2", 802)

  Th2HandbookHelp_Begin()
