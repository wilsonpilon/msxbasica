  Th2HandbookHelp_Commit("SCREEN 7, 8 / GRAPHIC 6, 7", "Appendix 5: VRAM map")
  Th2HandbookHelp_AddAnchor("Appendix5#screen-7-8-graphic-6-7", 1342)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- The original VRAM mapping figures have been converted to simple text tables.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[SCREEN 0 (WIDTH 80)|||Appendix5#screen-0-width-80--text-2]]] map, different end addresses for the blink table are indicated for 24 lines mode and 26.5 lines mode.")
  Th2HandbookHelp_Commit("Changes from the original", "Appendix 5: VRAM map")
  Th2HandbookHelp_AddAnchor("Appendix5#changes-from-the-original", 1343)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **00H to 3FH**: user defined")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **40H to 7FH**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **80H to 87H**: for RS-232C")
  Th2HandbookHelp_L("  * 80H: 8251 data")
  Th2HandbookHelp_L("  * 81H: 8251 status/command")
  Th2HandbookHelp_L("  * 82H: status read/interrupt mask")
  Th2HandbookHelp_L("  * 83H: unused")
  Th2HandbookHelp_L("  * 84H: 8253")
  Th2HandbookHelp_L("  * 85H: 8253")
  Th2HandbookHelp_L("  * 86H: 8253")
  Th2HandbookHelp_L("  * 87H: 8253")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **88H to 8BH**: VDP (9938) I/O port for MSX1 adaptor")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  This is V9938 I/O for MSX1. To access VDP directly, examine 06H and 07H of MAIN-ROM to confirm the port address")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **8CH to 8DH**: for the modem")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **8EH to 8FH**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **90H to 91H**: printer port")
  Th2HandbookHelp_L("  * 90H")
  Th2HandbookHelp_L("@@@* bit 0: strobe output (write)")
  Th2HandbookHelp_L("@@@* bit 1: status input (read)")
  Th2HandbookHelp_L("  * 91H: data to be printed")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **92H to 97H**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **98H to 9BH**: for MSX2 VDP (V9938)")
  Th2HandbookHelp_L("  * 98H: VRAM access")
  Th2HandbookHelp_L("  * 99H: command register access")
  Th2HandbookHelp_L("  * 9AH: palette register access (write only)")
  Th2HandbookHelp_L("  * 9BH: register pointer (write only)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **9CH to 9FH**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **A0H to A3H**: sound generator (AY-3-8910)")
  Th2HandbookHelp_L("  * A0H: address latch")
  Th2HandbookHelp_L("  * A1H: data read")
  Th2HandbookHelp_L("  * A2H: data write")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **A4H to A7H**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **A8H to ABH**: parallel port (8255)")
  Th2HandbookHelp_L("  * A8H: port A")
  Th2HandbookHelp_L("  * A9H: port B")
  Th2HandbookHelp_L("  * AAH: port C")
  Th2HandbookHelp_L("  * ABH: mode set")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **ACH to AFH**: MSX engine (one chip MSX I/O)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **B0H to B3H**: expansion memory (SONY specification) (8255)")
  Th2HandbookHelp_L("  * A8H: port A, address (A0 to A7)")
  Th2HandbookHelp_L("  * A9H: port B, address (A8 to A10, A13 to A15), control R/W")
  Th2HandbookHelp_L("  * AAH: port C, address (A11 to A12), data (D0 - D7)")
  Th2HandbookHelp_L("  * ABH: mode set")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **B4H to B5H**: CLOCK-IC (RP-5C01)")
  Th2HandbookHelp_L("  * B4H: address latch")
  Th2HandbookHelp_L("  * B5H: data")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **B6H to B7H**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **B8H to BBH**: lightpen control (SANYO specification)")
  Th2HandbookHelp_L("  * B8H: read/write")
  Th2HandbookHelp_L("  * B9H: read/write")
  Th2HandbookHelp_L("  * BAH: read/write")
  Th2HandbookHelp_L("  * BBH: write only")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **BCH to BFH**: VHD control (JVC) (8255)")
  Th2HandbookHelp_L("  * BCH: port A")
  Th2HandbookHelp_L("  * BDH: port B")
  Th2HandbookHelp_L("  * BEH: port C")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **C0H to C1H**: MSX-Audio")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **C2H to C7H**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **C8H to CFH**: MSX interface")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **D0H to D7H**: floppy disk controller (FDC)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  The floppy disk controller can be interrupted by an external signal. Interrupt is possible only when the FDC is accessed. Thus, the system can treat different FDC interfaces.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **D8 to D9H**: kanji ROM (TOSHIBA specification)")
  Th2HandbookHelp_L("  * D8H: b5-b0, lower address (write only)")
  Th2HandbookHelp_L("  * D9H")
  Th2HandbookHelp_L("@@@* b5-b0: upper address (write)")
  Th2HandbookHelp_L("@@@* b7-b0: data (read)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **DAH to DBH**: for future kanji expansion")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **DCH to F4H**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **F5H**: system control (write only), setting bit to 1 enables available I/O devices")
  Th2HandbookHelp_L("  * b0: kanji ROM")
  Th2HandbookHelp_L("  * b1: reserved for kanji")
  Th2HandbookHelp_L("  * b2: MSX-AUDIO")
  Th2HandbookHelp_L("  * b3: superimpose")
  Th2HandbookHelp_L("  * b4: MSX interface")
  Th2HandbookHelp_L("  * b5: RS-232C")
  Th2HandbookHelp_L("  * b6: lightpen")
  Th2HandbookHelp_L("  * b7: CLOCK-IC (only on MSX2)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  Bits to void the conflict between internal I/O devices or those connected by cartridge. The bits can disable the internal devices. When BIOS is initialised, internal devices are valid if no external devices are connected. Applications may not write to or read from here.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **F8H**: colour bus I/O")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **F7H**: A/V control")
  Th2HandbookHelp_L("  * b0: audio R - mixing ON (write)")
  Th2HandbookHelp_L("  * b1: audio L - mixing OFF (write)")
  Th2HandbookHelp_L("  * b2: select video input - 21p RGB (write)")
  Th2HandbookHelp_L("  * b3: detect video input - no input (read)")
  Th2HandbookHelp_L("  * b4: AV control - TV (write)")
  Th2HandbookHelp_L("  * b5: Ym control - TV (write)")
  Th2HandbookHelp_L("  * b6: inverse of bit 4 of VDP register 9 (write)")
  Th2HandbookHelp_L("  * b7: inverse of bit 5 of VDP register 9 (write)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **F8H to FBH**: reserved")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **FCH to FFH**: memory mapper")
  Th2HandbookHelp_Commit("APPENDIX 6 - I/O MAP", "Appendix 6: I/O map")
  Th2HandbookHelp_AddAnchor("Appendix6#appendix-6---io-map", 1344)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Code (dec)  |  Code (hex)  |  Function  |  Corresponding  key(s)")
  Th2HandbookHelp_L("---  |  ---  |  ---  |  ---")
  Th2HandbookHelp_L("0  |  00H  |    |  CTRL + @")
  Th2HandbookHelp_L("1  |  01H  |  header at input/output of graphic characters  |  CTRL + A")
  Th2HandbookHelp_L("2  |  02H  |  move cursor to the top of the previous word  |  CTRL + B")
  Th2HandbookHelp_L("3  |  03H  |  end the input-waiting state  |  CTRL + C")
  Th2HandbookHelp_L("4  |  04H  |    |  CTRL + D")
  Th2HandbookHelp_L("5  |  05H  |  delete below cursor  |  CTRL + E")
  Th2HandbookHelp_L("6  |  06H  |  move cursor to the top of the next word  |  CTRL + F")
  Th2HandbookHelp_L("7  |  07H  |  speaker output (same as the BEEP statement)  |  CTRL + G")
  Th2HandbookHelp_L("8  |  08H  |  delete a character before cursor  |  CTRL + H or BS")
  Th2HandbookHelp_L("9  |  09H  |  move to next horizontal tab stop  |  CTRL + I or TAB")
  Th2HandbookHelp_L("10  |  0AH  |  line feed  |  CTRL + J")
  Th2HandbookHelp_L("11  |  0BH  |  home cursor  |  CTRL + K or HOME")
  Th2HandbookHelp_L("12  |  0CH  |  clear screen and home cursor  |  CTRL + L or CLS")
  Th2HandbookHelp_L("13  |  0DH  |  carriage return  |  CTRL + M or RETURN")
  Th2HandbookHelp_L("14  |  0EH  |  move cursor to the end of line  |  CTRL + N")
  Th2HandbookHelp_L("15  |  0FH  |    |  CTRL + O")
  Th2HandbookHelp_L("16  |  10H  |    |  CTRL + P")
  Th2HandbookHelp_L("17  |  11H  |    |  CTRL + Q")
  Th2HandbookHelp_L("18  |  12H  |  insert mode ON/OFF  |  CTRL + R or INS")
  Th2HandbookHelp_L("19  |  13H  |    |  CTRL + S")
  Th2HandbookHelp_L("20  |  14H  |    |  CTRL + T")
  Th2HandbookHelp_L("21  |  15H  |  delete one line from screen  |  CTRL + U")
  Th2HandbookHelp_L("22  |  16H  |    |  CTRL + V")
  Th2HandbookHelp_L("23  |  17H  |    |  CTRL + W")
  Th2HandbookHelp_L("24  |  18H  |    |  CTRL + X or SELECT")
  Th2HandbookHelp_L("25  |  19H  |    |  CTRL + Y")
  Th2HandbookHelp_L("26  |  1AH  |    |  CTRL + Z")
  Th2HandbookHelp_L("27  |  1BH  |    |  CTRL + [ or ESC")
  Th2HandbookHelp_L("28  |  1CH  |  move cursor right  |  CTRL + \ or RIGHT")
  Th2HandbookHelp_L("29  |  1DH  |  move cursor left  |  CTRL + ] or LEFT")
  Th2HandbookHelp_L("30  |  1EH  |  move cursor up  |  CTRL + ^ or UP")
  Th2HandbookHelp_L("31  |  1FH  |  move cursor down  |  CTRL + _ or DOWN")
  Th2HandbookHelp_L("127  |  7FH  |  delete character under cursor  |  DEL")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("# APPENDIX 10 - ESCAPE SEQUENCES")
  Th2HandbookHelp_Commit("APPENDIX 8 - CONTROL CODES", "Appendices 8 and 10: Control codes and escape sequences")
  Th2HandbookHelp_AddAnchor("Appendices8and10#appendix-8---control-codes", 1345)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sequence  |  Function")
  Th2HandbookHelp_L("---  |  ---")
  Th2HandbookHelp_L("\<ESC\> A  |  move cursor up")
  Th2HandbookHelp_L("\<ESC\> B  |  move cursor down")
  Th2HandbookHelp_L("\<ESC\> C  |  move cursor right")
  Th2HandbookHelp_L("\<ESC\> D  |  move cursor left")
  Th2HandbookHelp_L("\<ESC\> H  |  move cursor home")
  Th2HandbookHelp_L("\<ESC\> Y \<Y-coordinate+20H\> \<X-coordinate+20H\>  |  move cursor to (X, Y)")
  Th2HandbookHelp_Commit("Cursor movement", "Appendices 8 and 10: Control codes and escape sequences")
  Th2HandbookHelp_AddAnchor("Appendices8and10#cursor-movement", 1346)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sequence  |  Function")
  Th2HandbookHelp_L("---  |  ---")
  Th2HandbookHelp_L("\<ESC\> j  |  clear screen")
  Th2HandbookHelp_L("\<ESC\> E  |  clear screen")
  Th2HandbookHelp_L("\<ESC\> K  |  delete to end of line")
  Th2HandbookHelp_L("\<ESC\> J  |  delete to end of screen")
  Th2HandbookHelp_L("\<ESC\> L  |  insert one line")
  Th2HandbookHelp_L("\<ESC\> M  |  delete one line")
  Th2HandbookHelp_Commit("Edit, delete", "Appendices 8 and 10: Control codes and escape sequences")
  Th2HandbookHelp_AddAnchor("Appendices8and10#edit-delete", 1347)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sequence  |  Function")
  Th2HandbookHelp_L("---  |  ---")
  Th2HandbookHelp_L("\<ESC\> x4  |  set block cursor")
  Th2HandbookHelp_L("\<ESC\> x5  |  hide cursor")
  Th2HandbookHelp_L("\<ESC\> y4  |  set underline cursor")
  Th2HandbookHelp_L("\<ESC\> y5  |  display cursor")
  Th2HandbookHelp_Commit("Miscellaneous", "Appendices 8 and 10: Control codes and escape sequences")
  Th2HandbookHelp_AddAnchor("Appendices8and10#miscellaneous", 1348)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("  by J.Suzuki 1989")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  this document & samples by Sho Endo")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  translate to english by LASP")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("  this text file typed without changes by Nestor Soriano")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("MSX-BASIC-KUN is an incredible BASIC compiler. It will compile a BASIC program on memory in few seconds and execute it 15 to 100 times faster!! It can compile most of the statements and functions of MSX-BASIC and can handle strings and floating numbers. Once you see it, you'd feel you'd never need to learn the Z-80 machine language. Real time games, C.G., demo programs can be written by the ease of BASIC for machine language speed.")
  Th2HandbookHelp_Commit("MSX-BASIC-KUN (BASIC COMPILER)", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#msx-basic-kun-basic-compiler", 1349)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This compiler is sold in Japan as a cartridge for 4500 yen. You just set it in a slot to use it. Also, you can found this compiler in MSX2+ Sanyo machines, in ROM.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Now you are in BASIC mode as usual, except that two commands are available:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@CALL RUN")
  Th2HandbookHelp_L("@@@CALL TURBO ON/OFF")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L(Chr(34) + "CALL" + Chr(34) + " can be written as " + Chr(34) + "_" + Chr(34) + " (underscore). I will use that from now on.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`_RUN` is the command to compile and execute the entire program on memory. If it finds an error it will stop and yield the message.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`_TURBO ON` is the statement to define the beginning of the turbo block.")
  Th2HandbookHelp_L("`_TURBO OFF` is the end of the block.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The turbo block is the part of the program you want to execute fast. When the entire program contains some uncompilable statements, you can define the block to be compiled using this set.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("EXAMPLE")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 SCREEN 8:DEFINT A-Z")
  Th2HandbookHelp_L("@@@    110 BLOAD" + Chr(34) + "PICTURE" + Chr(34) + ",S")
  Th2HandbookHelp_L("@@@    120 _TURBO ON")
  Th2HandbookHelp_L("@@@    130 FOR X=0 TO 255")
  Th2HandbookHelp_L("@@@    140 LINE(X,0)-(X,211),0")
  Th2HandbookHelp_L("@@@    150 NEXT X")
  Th2HandbookHelp_L("@@@    160 _TURBO OFF")
  Th2HandbookHelp_L("@@@    170 GOTO 170")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This program cannot be `_RUN`, because the `BLOAD` is one of the commands that cannot be compiled. If you `RUN` this, the part lines 130 through 150 will be executed fast.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("As `_RUN" + Chr(34) + "FILE" + Chr(34) + "` is not supported, you have to add `_TURBO ON` and `_TURBO OFF` at the beginning and the end if you want to `RUN" + Chr(34) + "FILE" + Chr(34) + "` and have the effect.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 FOR I=0 TO 999")
  Th2HandbookHelp_L("@@@    110 ...")
  Th2HandbookHelp_L("@@@    .")
  Th2HandbookHelp_L("@@@    .")
  Th2HandbookHelp_L("@@@    .")
  Th2HandbookHelp_L("@@@    890 'END OF THE PROGRAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("So, this can be `_RUN` or add `10 _TURBO ON` and `900 _TURBO OFF` and `RUN" + Chr(34) + "FILE" + Chr(34) + "`.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If you `_RUN` a program containing `_TURBO ON/OFF` it will be an error.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`_TURBO ON/OFF` can not be written in a multi-statement lines.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("`_TURBO ON/OFF` can not be nested. But you may have many closed blocks in a program.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Variables and arrays are handled differently in and outside of the blocks. Once you are out of the block, variables and arrays used in the block are lost. Only, the integer types can be defined as common.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 DEFINT A-Z:DIM C(2),D(2)")
  Th2HandbookHelp_L("@@@    110 A=1:B=2:C(0)=3:D(0)=4")
  Th2HandbookHelp_L("@@@    120 _TURBO ON(A,C())")
  Th2HandbookHelp_L("@@@    130 DIM D(2)")
  Th2HandbookHelp_L("@@@    140 PRINT A,B,C(0),D(0)")
  Th2HandbookHelp_L("@@@    150 A=5:B=6:C(0)=7:D(0)=8")
  Th2HandbookHelp_L("@@@    160 _TURBO OFF")
  Th2HandbookHelp_L("@@@    170 PRINT A,B,C(0),D(0)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    RUN")
  Th2HandbookHelp_L("@@@      1 0 3 0")
  Th2HandbookHelp_L("@@@      5 2 7 4")
  Th2HandbookHelp_L("@@@    Ok")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Floating numbers used by the compiler is a special format 3-byte value. Its accuracy is about 4.5 digits. Double precision is not available.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("An array must be declared by a constant in the beginning.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This compiler works on the BASIC program on the RAM and creates the objects and variables on the left RAM. So there is a limit of the size of the source program about 10K. Big arrays, string variables (each uses 256 byte), `CLEAR ???,&H????` will make the situation tighter as you can imagine. The compiled objects can not be saved as independent programs.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Interrupts available, such as `KEY(1) ON, OFF` etc. But it will decrease the efficiency of the executed object's size & speed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Some statements may not work correctly.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 GOTO 130")
  Th2HandbookHelp_L("@@@    110 A=3/2")
  Th2HandbookHelp_L("@@@    120 END")
  Th2HandbookHelp_L("@@@    130 DEFINT A-Z")
  Th2HandbookHelp_L("@@@    140 GOTO 110")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If you `RUN` this, A is 1. If you `_RUN` this, A is 1.5. `DEF???` will be effective when encountered during the execution in the case of interpreter, while it depends on the order of line number in the other case.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("A little complicated string operation may cause easily a " + Chr(34) + "String formula too complex" + Chr(34) + " error. As this compiler has only one level of stack for it. Break a long string formula into multiple small ones, if so.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If you `_RUN` an endless program, you can not stop it. Make a part to check keyboards.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 GOTO 100 'Reset or power off to stop")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 100")
  Th2HandbookHelp_L("@@@    110 END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("is better.")
  Th2HandbookHelp_Commit("1. Settings & General knowledge", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#1-settings-general-knowledge", 1350)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("List of statements, commands and functions that can not be compiled.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("AUTO, BASE, BLOAD, BSAVE, CALL, CDBL, CINT, CLEAR, CLOAD, CLOAD?, CLOSE, CONT, CSAVE, CSNG, CVD, CVI, CVS, DEFFN, DELETE, DRAW, DSKF, EOF, ERASE, ERL, ERR, ERROR, EQV, FIELD, FILES, FPOS, FRE, GET, IMP, INPUT#, KEY LIST, LFILES, LINEINPUT#, LIST, LLIST, LOAD, LOC, LOF, LPRINT USING, LSET, MAXFILES, MERGE, MOTOR, MKD$, MKI$, MKS$, NAME, NEW, ON ERROR GOTO, ON INTERVAL GOSUB (due to a bug), OPEN, PLAY, PRINT#, PRINT USING, PUT KANJI, RENUM, RESUME, RSET, SAVE, SPC, TAB, TRON, TROFF, WIDTH.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("List of those with limits.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **CIRCLE**: Start, end angles and aspect ratio can't be specified.")
  Th2HandbookHelp_L("* **COPY**: Only graphic COPY is available.")
  Th2HandbookHelp_L("* **DEFDBL**: Same as DEFSNG.")
  Th2HandbookHelp_L("* **DIM**: Must come first in the program or in the turbo block.")
  Th2HandbookHelp_L("* **INPUT**: Can handle only one variable at the time.")
  Th2HandbookHelp_L("* **KEY**: ON KEY GOSUB, KEY(n) ON/OFF only.")
  Th2HandbookHelp_L("* **LOCATE**: x,y must be given in as a set. No cursor switch parameter.")
  Th2HandbookHelp_L("* **NEXT**: Variable names after the NEXT can not be omitted.")
  Th2HandbookHelp_L("* **ON**: ON STOP GOSUB, ON INTERVAL GOSUB not available.")
  Th2HandbookHelp_L("* **PRINT**: Commas work in a different way. No wrapping for digits.")
  Th2HandbookHelp_L("* **PUT**: PUT SPRITE only.")
  Th2HandbookHelp_L("* **RUN**: Variables won't be initialized.")
  Th2HandbookHelp_L("* **SCREEN**: Screen mode and sprite size only.")
  Th2HandbookHelp_L("* **SET**: SET PAGE only.")
  Th2HandbookHelp_L("* **STOP**: Same as END.")
  Th2HandbookHelp_L("* **USR**: Parameter type must be integer only.")
  Th2HandbookHelp_L("* **VARPTR**: File number can not be given as the parameter.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Otherwise there is no significant difference.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In general, I/O commands & functions, and editing commands can not be compiled. Of course they are available in the direct mode, and outside of the turbo block. You can edit, debug and save a program in MSX-BASIC and execute it by _RUN.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If you want to use `PRINT#` to write characters on `GRP:`, use it outside of turbo block. Otherwise study the sample, " + Chr(34) + "PRINT.TRB" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("If you want to use PLAY, use BGM compiler, and get the sound by `USR(n)`.")
  Th2HandbookHelp_Commit("2. Difference from MSX-BASIC interpreter", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#2-difference-from-msx-basic-interpreter", 1351)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("3 special commands are available by starting a remark line with some specific characters.")
  Th2HandbookHelp_Commit("3. New features added", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#3-new-features-added", 1352)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Stands for INLINE. You can write a short machine-language routine.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    100 DEFINT A-Z")
  Th2HandbookHelp_L("@@@    110 K=1")
  Th2HandbookHelp_L("@@@    120 '#I &H2A,K")
  Th2HandbookHelp_L("@@@    130 '#I &HF3,&HCD,@150,&HFB")
  Th2HandbookHelp_L("@@@    140 END")
  Th2HandbookHelp_L("@@@    150 'SUB")
  Th2HandbookHelp_L("@@@    160 RETURN")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("120 means `LD HL,(K); K must be a simple variable of integer type.`")
  Th2HandbookHelp_L("130 means ")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    DI")
  Th2HandbookHelp_L("@@@    CALL @150 ;Be careful, this line won't be RENUMed.")
  Th2HandbookHelp_L("@@@    EI")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("\#I", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#i", 1353)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Stands for CLIP. In the screen modes 5 through 8 (except for `PAINT`, and `CIRCL`E), this will be set clipping on and off.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    10 SCREEN 8")
  Th2HandbookHelp_L("@@@    20 '#C-")
  Th2HandbookHelp_L("@@@    30 LINE(0,0)-(255,255) 'Y CLIPPED")
  Th2HandbookHelp_L("@@@    40 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 40")
  Th2HandbookHelp_L("@@@    50 '#C+")
  Th2HandbookHelp_L("@@@    60 LINE(0,0)-(255,255) 'NOT CLIPPED")
  Th2HandbookHelp_L("@@@    70 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 70")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("#C", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#c", 1354)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Check if NEXT overflows.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    10 FOR I%=0 TO &H7FFF")
  Th2HandbookHelp_L("@@@    20 NEXT I%")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This program will end up in a " + Chr(34) + "Overflow error" + Chr(34) + " in MSX-BASIC. And if _RUN, it will be an endless loop. If #N+ is specififed, it will end normally. This code will decrease the efficiency of the object, too. Better not use unless it's really necessary. To clear, specify #N-.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**NOTE**: In MSX-2+ Sanyo you can found a new command:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    CALL BC")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This command turn on the BASIC COMPILER options.")
  Th2HandbookHelp_Commit("#N", "BASIC KUN compiler")
  Th2HandbookHelp_AddAnchor("KunBASIC#n", 1355)

EndProcedure
