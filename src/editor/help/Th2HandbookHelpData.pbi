  Th2HandbookHelp_Commit("_Figure 4.101  Actions of POINT command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-4101-actions-of-point-command_", 553)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> POINT register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#32    | SX7| SX6| SX5| SX4| SX3| SX2| SX1| SX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SX ---+")
  Th2HandbookHelp_L("@@@R#33    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | SX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#34    | SY7| SY6| SY5| SY4| SY3| SY2| SY1| SY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| SY ---+")
  Th2HandbookHelp_L("@@@R#35    | 0  | 0  | 0  | 0  | 0  | 0  | SY9| SY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    | -- | -- | -- | MXS| -- | -- | -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                          |")
  Th2HandbookHelp_L("@@@                          +-----------> memory selection")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> POINT command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 0  | 1  | 0  | 0  | -- | -- | -- | -- | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#2     | -- | -- | -- | -- | -- | -- | -- | CE | CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                                             when the command ends : 0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    --+")
  Th2HandbookHelp_L("@@@S#7     | 0  | 0  | 0  | 0  | C3 | C2 | C1 | C0 | CL (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                      |")
  Th2HandbookHelp_L("@@@                                                                       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                      |")
  Th2HandbookHelp_L("@@@        | 0  | 0  | 0  | 0  | 0  | 0  | C1 | C0 | CL (GRAPHIC 5)       | colour code data")
  Th2HandbookHelp_L("@@@        -----------------------------------------                      |")
  Th2HandbookHelp_L("@@@                                                                       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                      |")
  Th2HandbookHelp_L("@@@        | C7 | C6 | C5 | C4 | C3 | C2 | C1 | C0 | CL (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                    --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.102  Register settings of POINT command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-4102-register-settings-of-point-command_", 554)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.21   POINT sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L as follows")
  Th2HandbookHelp_L("@@@;                POINT ( x:H, y:L )")
  Th2HandbookHelp_L("@@@;                returns:   A := COLOR CODE")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  POINT")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@POINT:  DI")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,(WRVDP)")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        LD      A,32")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        DEC     C")
  Th2HandbookHelp_L("@@@        DEC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+45")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,01000000B")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+46")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP")
  Th2HandbookHelp_L("@@@        LD      A,7")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        PUSH    AF")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.21  Example of POINT command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-421-example-of-point-command-execution_", 555)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
