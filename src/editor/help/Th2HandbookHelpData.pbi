  Th2HandbookHelp_L("@@@   |  (the 1st decimal place)  |  X      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@12 |  Year                     |                           |")
  Th2HandbookHelp_L("@@@   |  (the 2nd decimal place)  |  X      X      X      X   |")
  Th2HandbookHelp_L("@@@   ---------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
