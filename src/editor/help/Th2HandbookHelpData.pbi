  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`GET[#]<filenumber>[, <record number>]`  |  Statement  |  Reads one record from the random file to the random input/output buffer.")
  Th2HandbookHelp_Commit("--- G ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#g-1", 63)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`INPUT #<filenumber>, <variable name>[, <variable name>...]`  |  Statement  |  Reads data from the file.")
  Th2HandbookHelp_L("`INPUT$ (<the number of characters>[, [#]<filenumber>])`  |  Function  |  Gets the string of the specified length from the file.")
