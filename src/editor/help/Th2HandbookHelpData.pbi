  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("**`* GET DATE <string variable name>[, A]`**  |  Statement  |  Assigns date into a string variable.")
  Th2HandbookHelp_L("**`* GET TIME <string variable name>[, A]`**  |  Statement  |  Assigns time into a string variable.")
  Th2HandbookHelp_L("`GOSUB <linenumber>`  |  Statement  |  Calls the subroutine at `<linenumber>`.")
  Th2HandbookHelp_L("`GOTO <linenumber>`  |  Statement  |  Jumps to `<linenumber>`.")
  Th2HandbookHelp_Commit("--- G ---", "Chapter 2: BASIC")
