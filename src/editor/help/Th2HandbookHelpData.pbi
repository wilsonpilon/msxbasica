  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Note: Four pages (4 to 7) of 64K RAM are not always in the same slot.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 1.4  MSX2 standard memory_", "Chapter 1: MSX system overview")
  Th2HandbookHelp_AddAnchor("Chapter1#_figure-14-msx2-standard-memory_", 22)

