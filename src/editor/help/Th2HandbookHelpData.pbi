  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("First of all, the sentence and function for each instruction of BASIC are listed. Each instruction is listed in the format shown in [[[Figure 2.1|||Chapter2#figure-21--instruction-list-format]]].")
  Th2HandbookHelp_Commit("1. LIST OF INSTRUCTIONS", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#1-list-of-instructions", 31)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[[Ver Figura: Figure 2.1]|||img:figure_2.1]]]")
  Th2HandbookHelp_Commit("_Figure 2.1  Instruction list format_", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#_figure-21-instruction-list-format_", 32)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("If there is an **" + Chr(34) + "*" + Chr(34) + "** followed by a keyword, it indicates that the syntax or function of the instruction has just been modified after version 1.0, or that the instruction has been added to version 2.0.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Descriptions of sentences use the following notational conventions.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* [item] .............. the item is optional")
  Th2HandbookHelp_L("@@@* [, item ... ] ....... more items having the same form may appear")
  Th2HandbookHelp_L("@@@* [item1 | item2] ..... choose item1 or item2")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("And ``, which is used in the sentence, is a string specifying I/O devices or files for input/output in the format listed below. `` for a cassette files is a string consisting of any combination of up to 6 characters. `` for disk or RAM disk is a string, whose form is `" + Chr(34) + " + " + Chr(34) + "`. `` is one of characters from A to H (depending on the number of drives connected).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@" + Chr(34) + "CAS: <filename>" + Chr(34) + " ..... Cassette file")
  Th2HandbookHelp_L("@@@" + Chr(34) + "MEM: <filename>" + Chr(34) + " ..... RAM disk")
  Th2HandbookHelp_L("@@@" + Chr(34) + "CRT:" + Chr(34) + " ................ Text screen")
  Th2HandbookHelp_L("@@@" + Chr(34) + "GRP:" + Chr(34) + " ................ Graphic screen")
  Th2HandbookHelp_L("@@@" + Chr(34) + "LPT:" + Chr(34) + " ................ Printer")
  Th2HandbookHelp_L("@@@" + Chr(34) + "<drive>:<filename>" + Chr(34) + " .. Disk file")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("(a) Syntax of instructions", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#a-syntax-of-instructions", 33)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are four types of instructions:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@* Function ............ Returns a certain value depending on the given parameter(s).")
  Th2HandbookHelp_L("@@@* System variable ..... Variables available from BASIC. Generally, assignment is allowed.")
  Th2HandbookHelp_L("@@@* Statement ........... Takes a certain action.")
  Th2HandbookHelp_L("@@@* Command ............. Gives an instruction to BASIC interpreter itself.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("(b) Instruction type", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#b-instruction-type", 34)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following list gives a brief description of the action for each instruction. More detailed descriptions about instructions which have been modified or added at version 2.0 are given in [[[section 2|||Chapter2#2-differences-in-msx-basic-version-20]]].")
  Th2HandbookHelp_Commit("(c) Function or action of instruction", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#c-function-or-action-of-instruction", 35)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`ABS (<expression>)`  |  Function  |  Returns absolute value of `<expression>`.")
  Th2HandbookHelp_L("`ASC (<string>)`  |  Function  |  Returns the code of the first character of `<string>`.")
  Th2HandbookHelp_L("`ATN (<expression>)`  |  Function  |  Returns arc tangent of `<expression>` in radians.")
  Th2HandbookHelp_L("`AUTO [<linenumber>[, <increment>]]`  |  Command  |  Produces line numbers automatically.")
  Th2HandbookHelp_Commit("--- A ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#a", 36)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("**`* BASE (<expression>)`**  |  System variable  |  Contains the table address of the screen assigned on VRAM.")
  Th2HandbookHelp_L("`BEEP`  |  Statement  |  Produces beep to the audio terminal.")
  Th2HandbookHelp_L("`BIN$ (<expression>)`  |  Function  |  Converts the value of `<expression>` to a string of binary expression, then returns its result.")
  Th2HandbookHelp_L("`BLOAD " + Chr(34) + "<filename>" + Chr(34) + "[,R[,offset]]`  |  Command  |  Loads an assembly language program.")
  Th2HandbookHelp_L("`BSAVE " + Chr(34) + "<filename>" + Chr(34) + ",<start address>,<end address>[,<execution address>]`  |  Command  |  Saves an assembly language program.")
  Th2HandbookHelp_Commit("--- B ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#b", 37)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`CALL <extended statement name>[(<argument>[,<argument>...])]`  |  Statement  |  Calls the extended statements by inserting various cartridges.")
  Th2HandbookHelp_L("**`* CALL MEMINI [(<upper limitation of RAM disk>)]`**  |  Statement  |  Specifies the upper limit of memory for Ram disk.")
  Th2HandbookHelp_L("**`* CALL MFILES`**  |  Statement  |  Lists file names in RAM disk.")
  Th2HandbookHelp_L("**`* CALL MKILL (" + Chr(34) + "<filename>" + Chr(34) + ")`**  |  Statement  |  Deletes a file in RAM disk.")
  Th2HandbookHelp_L("**`* CALL MNAME (" + Chr(34) + "<old filename>" + Chr(34) + " AS " + Chr(34) + "<new filename>" + Chr(34) + ")`**  |  Statement  |  Renames a file in RAM disk.")
  Th2HandbookHelp_L("`CDBL (<expression>)`  |  Function  |  Converts the value of `<expression>` to a double precission real value and returns its result.")
  Th2HandbookHelp_L("`CHR$ (<expression>)     Returns a character which has the code of`  |  Function  |  `<expression>` value.")
  Th2HandbookHelp_L("`CINT (<expression>)`  |  Function  |  Converts the value of `<expression>` to an integer value and returns its result.")
  Th2HandbookHelp_L("**`* CIRCLE {(X,Y) \  |  STEP(X,Y)},<radius>[, <colour>[, <start angle>[, <end angle>[, <proportion>]]]]`**  |  Statement  |  Draws a circle whose center is at (X,Y) and whose size depends on `<radius>`.")
  Th2HandbookHelp_L("`CLEAR [<size of string area>[, <upper limitation of memory>]]`  |  Statement  |  Initialises variables and sets the size of memory area.")
  Th2HandbookHelp_L("`CLOAD [" + Chr(34) + "<filename>" + Chr(34) + "]`  |  Command  |  Loads a program from cassette.")
  Th2HandbookHelp_L("`CLOAD? [" + Chr(34) + "<filename>" + Chr(34) + "]`  |  Command  |  Compares a program on cassette with the one in memory.")
  Th2HandbookHelp_L("`CLOSE [[#]<filenumber>[, [#]<filenumber>...]]`  |  Command  |  Closes a file represented by `<filenumber>`.")
  Th2HandbookHelp_L("`CLS`  |  Statement  |  Clears screen.")
  Th2HandbookHelp_L("**`* COLOR [<foreground colour>[, <background colour>[, <border colour>]]]`**  |  Statement  |  Specifies the colours of each part of the screen.")
  Th2HandbookHelp_L("**`* COLOR [=NEW]`**  |  Statement  |  Initialises the palette.")
  Th2HandbookHelp_L("**`* COLOR = (<palette number>, <red brightness>, <green brightness>, <blue brightness>)`**  |  Statement  |  Sets the palette colour.")
  Th2HandbookHelp_L("**`* COLOR = RESTORE`**  |  Statement  |  Puts the contents of the colour palette storage table into the palette register.")
  Th2HandbookHelp_L("**`* COLOR SPRITE (<sprite plane number>)=<colour>`**  |  Statement  |  Sets the colour to the sprite of `<sprite plane number>` to the specified colour.")
  Th2HandbookHelp_L("**`* COLOR SPRITE$ (<sprite plane number>)=<string expression>`**  |  Statement  |  Sets the colour of each horizontal line of the sprite using `<string expression>`.")
  Th2HandbookHelp_L("`CONT`  |  Command  |  Resumes the execution of the program which has been stopped.")
  Th2HandbookHelp_L("**`* COPY <source> TO <destination>`**  |  Statement  |  Transfers the screen data among the screen, array, and disk file.")
  Th2HandbookHelp_L("**`* COPY SCREEN [<mode>]`**  |  Statement  |  Writes colour bus data into VRAM (optional).")
  Th2HandbookHelp_L("`COS (<expression>)`  |  Function  |  Returns the cosine value of `<expression (in radians)>`.")
  Th2HandbookHelp_L("`CSAVE " + Chr(34) + "<filename>" + Chr(34) + "[, <baud rate>]`  |  Command  |  Saves a program to cassette.")
  Th2HandbookHelp_L("`CSGN (<expression>)`  |  Function  |  Converts the value of `<expression>` to a single precision real value, and returns its result.")
  Th2HandbookHelp_L("`CSRLIN`  |  System variable  |  Contains the vertical screen location of the cursor. No assignment is allowed.")
  Th2HandbookHelp_Commit("--- C ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#c", 38)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`DATA <constant>[, <constant>...]`  |  Statement  |  Prepares data to be read by READ statement.")
  Th2HandbookHelp_L("`DEF FN <name> [(<argument>[, <argument>...])]=<function-definitive expression>`  |  Statement  |  Defines a user-defined function.")
  Th2HandbookHelp_L("`DEFINT <character range>[, <character range>...]`  |  Statement  |  Declares the specified variable(s) as integer type.")
  Th2HandbookHelp_L("`DEFSNG <character range>[, <character range>...]`  |  Statement  |  Declares the specified variable(s) as single precision real type.")
  Th2HandbookHelp_L("`DEFDBL <character range>[, <character range>...]`  |  Statement  |  Declares the specified variable(s) as double precision real type.")
  Th2HandbookHelp_L("`DEFSTR <character range>[, <character range>...]`  |  Statement  |  Declares the specified variable(s) as character type.")
  Th2HandbookHelp_L("`DEF USR [<number>]=<start address>`  |  Statement  |  Defines the starting address for the execution of assembly language routine, called by USR function.")
  Th2HandbookHelp_L("`DELETE {[<start linenumber>-<end linenumber>] \  |  <linenumber> \  |  -<end linenumber>}`  |  Command  |  Deletes the specified portion of the program.")
  Th2HandbookHelp_L("`DIM <variable name> (<maximum subscript value>[, <maximum subscript value>...])`  |  Statement  |  Defines an array variable and allocates it into memory.")
  Th2HandbookHelp_L("`DRAW <string expression>`  |  Statement  |  Draws a line or lines on the screen according to `<string expression (DRAW macro)>`.")
  Th2HandbookHelp_Commit("--- D ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#d", 39)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`END`  |  Statement  |  Ens the program, close all files, and returns to the command level.")
  Th2HandbookHelp_L("`EOF (<filenumber>)`  |  Function  |  Checks if the file is finished and returns -1 if at the end of file.")
  Th2HandbookHelp_L("`ERASE <array variable name>[, <array variable name>...]`  |  Statement  |  Deletes the array variable(s).")
  Th2HandbookHelp_L("`ERL`  |  System variable  |  Contains the error code for the preceding error. No assignment is allowed.")
  Th2HandbookHelp_L("`ERR`  |  System variable  |  Contains the line number of the previous error. No assignment is allowed.")
  Th2HandbookHelp_L("`ERROR <error code>`  |  Statement  |  Puts the program into the error condition.")
  Th2HandbookHelp_L("`EXP (<expression>)`  |  Function  |  Returns the exponent (power) of the natural exponential form of `<expression>`.")
  Th2HandbookHelp_Commit("--- E ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#e", 40)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Format  |  Type  |  Function or action")
  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`FIX (<expression>)`  |  Function  |  Returns the value of `<expression>`, without any decimal fractions.")
  Th2HandbookHelp_L("`FOR <variable name> = <initial value> TO <end value> [STEP <increment>]`  |  Statement  |  Repeats the execution from FOR statement to NEXT statement for the specified times.")
  Th2HandbookHelp_L("`FRE ({<expression> \  |  <string expression>})`  |  Function  |  Returns the size of unused user's area or unused character area.")
  Th2HandbookHelp_Commit("--- F ---", "Chapter 2: BASIC")
