  Th2HandbookHelp_L("* **Function**: tests the status of the keyboard buffer")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: the Z flag is set when the buffer is empty, otherwise the Z flag is reset")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("CHSNS (009CH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chsns-009ch-1", 807)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: one character input (waiting)")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: A for the code of the input character")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("CHGET (009FH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chget-009fh-1", 808)

  Th2HandbookHelp_Begin()
