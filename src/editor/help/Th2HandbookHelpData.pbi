  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.64  Number of sprites to be displayed (sprite mode 2)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-464-number-of-sprites-to-be-displayed-sprite-mode-2_", 472)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Same as sprite mode 1")
  Th2HandbookHelp_Commit("Sprite size", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#sprite-size", 473)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Same as sprite mode 1")
  Th2HandbookHelp_Commit("Expanding sprite", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#expanding-sprite", 474)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In sprite mode 2, the sprite display can be turned ON/OFF by bit 1 of R#8. When this bit is set to 1, no sprites will appear on the screen.")
  Th2HandbookHelp_Commit("Sprite display ON/OFF", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#sprite-display-onoff", 475)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#8     | .  | .  | .  | .  | .  | .  | X  | .  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                                        |    0: Sprite mode on")
  Th2HandbookHelp_L("@@@                                        +-->")
  Th2HandbookHelp_L("@@@                                             1: Sprite mode off")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.65  Sprite display specification_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-465-sprite-display-specification_", 476)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Same as sprite mode 1")
  Th2HandbookHelp_Commit("Setting the pattern generator table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#setting-the-pattern-generator-table", 477)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In sprite mode 2, since different colours can be set for each horizontal line of the sprite, the colour information is stored in a sprite colour table as described below, which is independent of the sprite attribute table. Three kinds of information are stored in the sprite attribute table (see [[[Figure 4.66|||Chapter4a#figure-466--structure-of-the-sprite-attribute-table-sprite-mode-2]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Y-coordinate:** setting this value to 216 (D8H) causes sprites after this sprite plane not to be displayed. Except for this, it is the same as the sprite mode 1.")
  Th2HandbookHelp_L("* **X-coordinate:** same as sprite mode 1.")
  Th2HandbookHelp_L("* **pattern number:** same as sprite mode 1.")
  Th2HandbookHelp_Commit("Sprite attribute table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#sprite-attribute-table", 478)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@    -   ----------------------------------------- --+  ⟵ (*)")
  Th2HandbookHelp_L("@@@    ^   |    :   Y coordinate (0 to 255)   :    |   |")
  Th2HandbookHelp_L("@@@    |   |----+----+----+----+----+----+----+----|   |")
  Th2HandbookHelp_L("@@@    |   |    :   X coordinate (0 to 255)   :    |   |")
  Th2HandbookHelp_L("@@@4 bytes |----+----+----+----+----+----+----+----| Sprite #0 attribute area")
  Th2HandbookHelp_L("@@@    |   |    :  Pattern number (0 to 255)  :    |   |")
  Th2HandbookHelp_L("@@@    |   |----+----+----+----+----+----+----+----|   |")
  Th2HandbookHelp_L("@@@    V   |    :    :    :  unused :    :    :    |   |")
  Th2HandbookHelp_L("@@@    -   |----+----+----+----+----+----+----+----| --+")
  Th2HandbookHelp_L("@@@        |                                       |   |")
  Th2HandbookHelp_L("@@@        |                                       |   | Sprite #1 attribute area")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@                            .                       .")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        |                                       |   | Sprite #31 attribute area")
  Th2HandbookHelp_L("@@@        |                                       |   |")
  Th2HandbookHelp_L("@@@        ----------------------------------------- --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@(*)  R#5     | A14| A13| A12| A11| A10| 1  | 1  | 1  |")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@     R#11    | 0  | 0  | 0  | 0  | 0  | 0  | A16| A15|")
  Th2HandbookHelp_L("@@@             -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.66  Structure of the sprite attribute table (sprite mode 2)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-466-structure-of-the-sprite-attribute-table-sprite-mode-2_", 479)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The colour table is automatically set at the address 512 bytes before the starting address of the sprite attribute table. 16 bytes are allocated for each sprite plane and the following settings are made for each line of the sprite.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **colour code:** colour can be specified for each line.")
  Th2HandbookHelp_L("* **EC:** the same as EC bit of the attribute table of sprite mode one. When " + Chr(34) + "1" + Chr(34) + ", the sprite display location is shifted 32 bits to the left. This also can be specified for each line.")
  Th2HandbookHelp_L("* **CC:** when CC bit is " + Chr(34) + "1" + Chr(34) + ", it can have the same priority as the sprite " + Chr(34) + "that has the higher priority than this sprite and whose CC bit is " + Chr(34) + "0" + Chr(34) + " and that is nearest to this sprite plane" + Chr(34) + ". When sprites having the same priority are overlapped, the colour for which OR (logical or) of both colour codes are displayed. In this case, the overlapping does not cause a conflict (see [[[Figure 4.68|||Chapter4a#figure-468--cc-bit-detection]]]).")
  Th2HandbookHelp_L("* **IC:** (one line of) the sprite with this bit " + Chr(34) + "1" + Chr(34) + " does not conflict with other sprites.")
  Th2HandbookHelp_Commit("Sprite colour table", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#sprite-colour-table", 480)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@      -----------------------------------------            --+ ⟵ starting address of the")
  Th2HandbookHelp_L("@@@   0  | EC | CC | IC | 0  |    Color  code    |  1st line    |    sprite colour table")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@   1  | EC | CC | IC | 0  |    Color  code    |  2nd line    |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@      |                   .                   |              |")
  Th2HandbookHelp_L("@@@                          .                                  |")
  Th2HandbookHelp_L("@@@                          .                                  | Sprite #0 colour table")
  Th2HandbookHelp_L("@@@      |                                       |              |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@  15  | EC | CC | IC | 0  |    Color  code    |  16th line   |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|            --+")
  Th2HandbookHelp_L("@@@      |                   .                   |            .")
  Th2HandbookHelp_L("@@@                          .                                .")
  Th2HandbookHelp_L("@@@                          .                                .")
  Th2HandbookHelp_L("@@@      |                                       |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|            --+")
  Th2HandbookHelp_L("@@@ 496  | EC | CC | IC | 0  |    Color  code    |  1th line    |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@ 497  | EC | CC | IC | 0  |    Color  code    |  2nd line    | Sprite #31 colour table")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@      |                   .                   |              |")
  Th2HandbookHelp_L("@@@                          .                                  |")
  Th2HandbookHelp_L("@@@                          .                                  |")
  Th2HandbookHelp_L("@@@      |                                       |              |")
  Th2HandbookHelp_L("@@@      |----+----+----+----+----+----+----+----|              |")
  Th2HandbookHelp_L("@@@ 511  | EC | CC | IC | 0  |    Color  code    |  16th line   |    starting address of the")
  Th2HandbookHelp_L("@@@      -----------------------------------------            --+ ⟵ sprite attribute table")
  Th2HandbookHelp_L("@@@        |    |    |       |                   |")
  Th2HandbookHelp_L("@@@        |    |    |       +-------------------+")
  Th2HandbookHelp_L("@@@        |    |    |        Specify the colour code (0 to 15)")
  Th2HandbookHelp_L("@@@        |    |    |        for the sprite by each line")
  Th2HandbookHelp_L("@@@        |    |    |                                      1 = no")
  Th2HandbookHelp_L("@@@        |    |    +-------------------> detect conflict: 0 = yed")
  Th2HandbookHelp_L("@@@        |    |")
  Th2HandbookHelp_L("@@@        |    +------------------------> priority: 0 = yes")
  Th2HandbookHelp_L("@@@        |                                         1 = no")
  Th2HandbookHelp_L("@@@        |")
  Th2HandbookHelp_L("@@@        +-----------------------------> 32 dot left shifted display: 1 = yes")
  Th2HandbookHelp_L("@@@                                                                     0 = no")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.67  Structure of the sprite colour table (sprite mode 2)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-467-structure-of-the-sprite-colour-table-sprite-mode-2_", 481)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@     Sprite 1                    Sprite 2             Sprite 1,2 (overlapped)")
  Th2HandbookHelp_L("@@@-------------------         -------------------         -------------------")
  Th2HandbookHelp_L("@@@| ////////// |    |         | \\ |            |         | xx | ///// |    |")
  Th2HandbookHelp_L("@@@| ////////// |    |         | \\ |            |         | xx | ///// |    |")
  Th2HandbookHelp_L("@@@| ////////// |    |         | \\ -------------|         | xx --------+----|")
  Th2HandbookHelp_L("@@@| ////////// |    |         | \\\\\\\\\\\\\\\ |      +--| xxxxxxxxxx | \\ |")
  Th2HandbookHelp_L("@@@| ////////// |    |         | \\\\\\\\\\\\\\\ |      |  | xxxxxxxxxx | \\ |")
  Th2HandbookHelp_L("@@@-------------------         -------------------      V  -------------------")
  Th2HandbookHelp_L("@@@      CC = 0                      CC = 1             Color code = 8 or 4 = 12")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------                      ------                      ------")
  Th2HandbookHelp_L("@@@| // | Color code = 8       | \\ | Color code = 4       | xx | Color code=12")
  Th2HandbookHelp_L("@@@------                      ------                      ------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:**")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Conflicts are not detected when the pattern of the sprite whose CC is " + Chr(34) + "1" + Chr(34) + " is piled on the portion CC=0 of the sprite which has a smaller number and is nearest to it.")
  Th2HandbookHelp_L("2. To display the sprite whose CC is " + Chr(34) + "1" + Chr(34) + ", CC bit of the sprite which has smaller number should be set to 0.")
  Th2HandbookHelp_Commit("_Figure 4.68  CC bit detection_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-468-cc-bit-detection_", 482)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("A " + Chr(34) + "conflict" + Chr(34) + " in sprite mode 2 occurs when the display colour of a sprite is not transparent and " + Chr(34) + "1" + Chr(34) + " bits on the line whose CC bit is 0 overlap each other. When two sprites conflict, bit 5 of S#0 becomes " + Chr(34) + "1" + Chr(34) + " and the conflict can be detected (see [[[Figure 4.69|||Chapter4a#figure-469--conflict-of-the-sprite-sprite-mode-2]]]). In this case, different from the sprite mode 1, the coordinate where the conflict occurred can be detected by S#3 to S#6 as shown in [[[Figure 4.70|||Chapter4a#figure-470--readout-of-the-conflict-coordinate]]]. Note that the coordinate which can be obtained by these registers is not the coordinate where the conflict actually occurred. To get this, use [[[Expression 4.5|||Chapter4a#expression-45--calculating-the-actual-conflict-coordinate]]]. S#3 to S#6 are reset when S#5 is read out.")
  Th2HandbookHelp_Commit("5.3.3 Judging sprite conflicts", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#533-judging-sprite-conflicts", 483)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#0     | .  | .  | X  | .  | .  | .  | .  | .  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                    |    0: normal")
  Th2HandbookHelp_L("@@@                    +-->")
  Th2HandbookHelp_L("@@@                         1: conflict occurred")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ----------------------------")
  Th2HandbookHelp_L("@@@        |                          |")
  Th2HandbookHelp_L("@@@        |  --------------------    |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\\\\\\\\\\ |    |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\\\\\\\\\\ |    |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\ ---------+----+-----------")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\ | \\\\\\ |    |          |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\ | \\\\\\ |    |          |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\ | \\\\\\ |    |          |")
  Th2HandbookHelp_L("@@@        |  | \\\\\\\ | \\\\\\ |    |          |   the attribute of this line")
  Th2HandbookHelp_L("@@@        -  | \\\\\\\ | \ -----+----+--------  -     -------------------------")
  Th2HandbookHelp_L("@@@    +-- |  | \\\\\\\ | \ | xx | // | ///// |  | --> |  | 0| 0|  :  :  :  :  |")
  Th2HandbookHelp_L("@@@    |   -  ----------+---+----- // | ///// |  -     -------------------------")
  Th2HandbookHelp_L("@@@    |   |            |   | /////// | ///// |  |        |     |")
  Th2HandbookHelp_L("@@@    |   -------------+---+---------- ///// |  |        +-----+")
  Th2HandbookHelp_L("@@@    |                |   | /////////////// |  |   CC and IC bits are both " + Chr(34) + "0" + Chr(34))
  Th2HandbookHelp_L("@@@    | the attribute  |   -------------------  |")
  Th2HandbookHelp_L("@@@    | of this line   |                        |")
  Th2HandbookHelp_L("@@@    |                |                        |")
  Th2HandbookHelp_L("@@@    |                --------------------------")
  Th2HandbookHelp_L("@@@    V")
  Th2HandbookHelp_L("@@@-------------------------")
  Th2HandbookHelp_L("@@@|  | 0| 0|  :  :  :  :  |")
  Th2HandbookHelp_L("@@@-------------------------")
  Th2HandbookHelp_L("@@@   |     |")
  Th2HandbookHelp_L("@@@   +-----+")
  Th2HandbookHelp_L("@@@CC and IC bits are both " + Chr(34) + "0" + Chr(34))
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.69  Conflict of the sprite (sprite mode 2)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-469-conflict-of-the-sprite-sprite-mode-2_", 484)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        ----------------------------------------- --+")
  Th2HandbookHelp_L("@@@S#3     | X7 | X6 | X5 | X4 | X3 | X2 | X1 | X0 |   |")
  Th2HandbookHelp_L("@@@        -----------------------------------------   |")
  Th2HandbookHelp_L("@@@                                                    | X-coordinate where the conflict occurred")
