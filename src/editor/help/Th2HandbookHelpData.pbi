  Th2HandbookHelp_L("@@@   |  (the 2nd decimal place)  |  .      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 2 |  Minutes                  |                           |")
  Th2HandbookHelp_L("@@@   |  (the 1st decimal place)  |  X      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 3 |  Minutes                  |                           |")
  Th2HandbookHelp_L("@@@   |  (the 2nd decimal place)  |  .      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
  Th2HandbookHelp_L("@@@ 4 |  Hours                    |                           |")
  Th2HandbookHelp_L("@@@   |  (the 1st decimal place)  |  X      X      X      X   |")
  Th2HandbookHelp_L("@@@   |---------------------------+---------------------------|")
