  Th2HandbookHelp_L("@@@FFFC    |-------------------------|")
  Th2HandbookHelp_L("@@@        |         reserved        |")
  Th2HandbookHelp_L("@@@FFF8    |-------------------------|")
  Th2HandbookHelp_L("@@@FFF7    |  MAIN-ROM slot address  |")
  Th2HandbookHelp_L("@@@        |-------------------------|")
  Th2HandbookHelp_L("@@@        |  register reservation   |")
  Th2HandbookHelp_L("@@@        |      area for new       |")
  Th2HandbookHelp_L("@@@FFE7    |       VDP (9938)        |")
  Th2HandbookHelp_L("@@@        |-------------------------|")
  Th2HandbookHelp_L("@@@        |       program for       |")
  Th2HandbookHelp_L("@@@FFCA    |  expansion BIOS calls   |")
  Th2HandbookHelp_L("@@@        |-------------------------|")
  Th2HandbookHelp_L("@@@        |                         |")
  Th2HandbookHelp_L("@@@        |       hook area         |")
  Th2HandbookHelp_L("@@@FD9A    |                         |")
  Th2HandbookHelp_L("@@@        |-------------------------|")
  Th2HandbookHelp_L("@@@        |                         |")
  Th2HandbookHelp_L("@@@        |    system work area     |")
  Th2HandbookHelp_L("@@@F380    |                         |")
  Th2HandbookHelp_L("@@@        ---------------------------")
