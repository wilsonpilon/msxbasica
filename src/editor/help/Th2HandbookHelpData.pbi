  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-534-contents-of-block-3_", 697)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following BIOS routines are offered to access the clock and the battery-powered memory. Since these routines reside in SUB-ROM, they are called by using the inter-slot call.")
  Th2HandbookHelp_Commit("6.8 Access to the CLOCK-IC", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#68-access-to-the-clock-ic", 698)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: C ⟵ CLOCK-IC address (see [[[Figure 5.35|||Chapter5a#figure-535--clock-ic-register-specification-method]]])")
  Th2HandbookHelp_L("* **Output**: A ⟵ data obtained (only 4 low order bits valid)")
  Th2HandbookHelp_L("* **Function**: reads CLOCK-IC register in the address specified by the C register and stores in the A register. Since the address specification includes the block selection information as shown in [[[Figure 5.35|||Chapter5a#figure-535--clock-ic-register-specification-method]]], it is not necessary to set the MODE register and then read the objective register.")
  Th2HandbookHelp_Commit("REDCLK (015FH/SUB) - read CLOCK-IC data", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#redclk-015fhsub---read-clock-ic-data", 699)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                -----------------------------------------")
  Th2HandbookHelp_L("@@@C register      |  . |  . | M1 : M0 | A3 : A2 : A1 : A0 |")
  Th2HandbookHelp_L("@@@                -----------------------------------------")
  Th2HandbookHelp_L("@@@                          |         |                   |")
  Th2HandbookHelp_L("@@@                          +---------+-------------------+")
  Th2HandbookHelp_L("@@@                          Block to be       Register")
  Th2HandbookHelp_L("@@@                          selected          address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.35  CLOCK-IC register specification method_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-535-clock-ic-register-specification-method_", 700)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * C ⟵ CLOCK-IC address (see Figure 5.35)")
  Th2HandbookHelp_L("  * A ⟵ data to be written (4 low order bits)")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Function**: write the contents of the A register in the CLOCK-IC at the address specified by the C register. The address is specified in the format shown in [[[Figure 5.35|||Chapter5a#figure-535--clock-ic-register-specification-method]]] as REDCLK.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[List 5.10|||Chapter5a#list-510--setting-the-prompt]]] shows an example of this BIOS routine.")
  Th2HandbookHelp_Commit("WRTCLK (01F9H/SUB) - write CLOCK-IC data", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#wrtclk-01f9hsub---write-clock-ic-data", 701)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;  List 5.10  set prompt message")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@WRTCLK: EQU     01F9H")
  Th2HandbookHelp_L("@@@EXTROM: EQU     015FH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        ORG     0B000H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----      ;Note:  Set prompt message for BASIC.")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@START:  LD      C,00110000B     ;address data")
  Th2HandbookHelp_L("@@@        LD      A,2             ;ID := prompt mode")
  Th2HandbookHelp_L("@@@        CALL    WRTRAM          ;write to back-up RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      B,6             ;loop counter")
  Th2HandbookHelp_L("@@@        LD      HL,STRING       ;prompt data")
  Th2HandbookHelp_L("@@@L01:    LD      A,(HL)          ;read string data")
  Th2HandbookHelp_L("@@@        AND     0FH             ;A := hi 4 bit")
  Th2HandbookHelp_L("@@@        INC     C               ;increment address")
  Th2HandbookHelp_L("@@@        CALL    WRTRAM          ;write data to back-up RAM")
  Th2HandbookHelp_L("@@@        LD      A,(HL)")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        AND     0FH")
  Th2HandbookHelp_L("@@@        INC     C               ;increment address")
  Th2HandbookHelp_L("@@@        CALL    WRTRAM          ;write low 4 bits")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        DJNZ    L01")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- write data to back-up RAM -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WRTRAM: PUSH    HL")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      IX,WRTCLK")
  Th2HandbookHelp_L("@@@        CALL    EXTROM          ;use interslot call")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- string data -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@STRING: DB      'Ready?'")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.10  Setting the prompt_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_list-510-setting-the-prompt_", 702)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- In [[[Figure 5.2|||Chapter5a#figure-52--psg-register-structure]]], unused bits are marked as " + Chr(34) + "x" + Chr(34) + ", and inverted signals are marked with " + Chr(34) + "*" + Chr(34) + ", for easiest readability.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- [[[Figure 5.17B|||Chapter5a#figure-517b--msx-european-version-key-matrix]]] was added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[List 5.4|||Chapter5a#list-54--use-of-the-key-scanning-routine]]], the last line before the work area, " + Chr(34) + "JR START" + Chr(34) + ", has been corrected to " + Chr(34) + "JR SCAN" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.18|||Chapter5a#figure-518--keyboard-ring-buffer]]], the addresses for GETPNT y PUTPNT were swapped. They have been corrected.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of BIOS routines [[[PINLIN|||Chapter5a#pinlin-00aehmain---one-line-input]]] and [[[INLIN|||Chapter5a#inlin-00b1hmain---one-line-input-prompt-available]]], " + Chr(34) + "BUF" + Chr(34) + " address has been corrected from F55DH to F55EH.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.22|||Chapter5a#figure-522-a--functions-of-psg-port-a]]] (B), " + Chr(34) + "Arabaic mode display" + Chr(34) + " has been changed to " + Chr(34) + "Arabic or kana mode display" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of BIOS routine [[[GTTRIG|||Chapter5a#gttrig-00d8hmain---read-trigger-button]]], the input needed for reading B buttons has been added in the " + Chr(34) + "Input" + Chr(34) + " field.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Table 5.5|||Chapter5a#table-55--gtpad-bios-function]]], in the Note 4, " + Chr(34) + "the trigger button of the mouse or the trigger button" + Chr(34) + " has been changed to " + Chr(34) + "the trigger button of the mouse or the trigger button of the track ball" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.29|||Chapter5a#figure-529--setting-the-clock-and-alarm]]], " + Chr(34) + "1200 or 2400 hours" + Chr(34) + " indication has been corrected to " + Chr(34) + "12 or 24 hours" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.32|||Chapter5a#figure-532--leap-year-determination]]], " + Chr(34) + "Register 3 #11" + Chr(34) + " indication has been corrected to " + Chr(34) + "Register #11" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.33|||Chapter5a#figure-533--contents-of-block-2]]], " + Chr(34) + "Adjust Y (8 to +7)" + Chr(34) + " has been corrected to " + Chr(34) + "Adjust Y (-8 to +7)" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of BIOS routine [[[WRTCLK|||Chapter5a#wrtclk-01f9hsub---write-clock-ic-data]]], the input needed in the A register has been added in the " + Chr(34) + "Input" + Chr(34) + " field.")
  Th2HandbookHelp_Commit("Changes from the original:", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#changes-from-the-original", 703)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The CPU (Z80) used in the MSX can access an address space of only 64K bytes (0000H to FFFFH). MSX is set up to access an effective space of 1M bytes. This is accomplished by using " + Chr(34) + "slots" + Chr(34) + ", which allocate more than one memory byte or device to the same address.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This chapter introduces the use of the slot and information necessary to connect the cartridge software or the new device to MSX via the slot.")
  Th2HandbookHelp_Commit("7. SLOTS AND CARTRIDGES", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#7-slots-and-cartridges", 704)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[7. SLOTS AND CARTRIDGES|||Chapter5b#7-slots-and-cartridges]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.1 Slots|||Chapter5b#71-slots]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.1.1 Basic slot and expansion slot|||Chapter5b#711-basic-slot-and-expansion-slot]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.1.2 Selecting slots|||Chapter5b#712-selecting-slots]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.2 Inter-slot Calls (calls between slots)|||Chapter5b#72-inter-slot-calls-calls-between-slots]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.2.1 Inter-slot call operation|||Chapter5b#721-inter-slot-call-operation]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.2.2 Inter-slot call use|||Chapter5b#722-inter-slot-call-use]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.2.3 Work area to obtain the slot status|||Chapter5b#723-work-area-to-obtain-the-slot-status]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.3 Developing Cartridge Software|||Chapter5b#73-developing-cartridge-software]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.3.1 Catridge header|||Chapter5b#731-catridge-header]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[7.3.2 notes on the creation of the cartridge software|||Chapter5b#732-notes-on-the-creation-of-the-cartridge-software]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Changes from the original|||Chapter5b#changes-from-the-original]]]")
  Th2HandbookHelp_Commit("Index", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#index", 705)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("A slot is an interface to effectively use a large address space, and to interface any memory or devices connected to the MSX address bus installed via the slot. The BASIC ROM inside the machine or RAM at MSX-DOS mode are not exceptions. The place at which the cartridge software is installed is also one of the slots. The following descriptions introduce how the software and the devices are connected to the slot.")
  Th2HandbookHelp_Commit("7.1 Slots", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#71-slots", 706)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The slot is either a basic slot or a expansion slot. A " + Chr(34) + "basic slot" + Chr(34) + " is a slot directly connected to the CPU address bus, as shown in [[[Figure 5.36|||Chapter5b#figure-536--basic-slot-and-expansion-slot]]]. The standard MSX machine can have up to four basic slots. The basic slot can be expanded up to four slots by connecting a slot expansion box (in some cases, the expansion is already done inside the machine), and is called " + Chr(34) + "expansion slots" + Chr(34) + ". When each of four basic slots is expanded to four expansion slots, the maximum number of slots is 16. If you multiply 16 slots x 64K bytes you will get 1M bytes of accessible address space.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Note that the system itself cannot be started when expansion slot boxes are connected to the expansion slot. So the user should only connect expansion slot boxes to the basic slots. (Though the slot for the standard MSX cartridge is always a basic slot, in some cases the connector for the optional hardware of each machine might be connected to the expansion slot).")
  Th2HandbookHelp_Commit("7.1.1 Basic slot and expansion slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#711-basic-slot-and-expansion-slot", 707)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                                        ---------")
  Th2HandbookHelp_L("@@@                                        |       |")
  Th2HandbookHelp_L("@@@                                        |  CPU  |")
  Th2HandbookHelp_L("@@@                                        |       |")
  Th2HandbookHelp_L("@@@                                        |       |")
  Th2HandbookHelp_L("@@@                                        ---------")
  Th2HandbookHelp_L("@@@                                            |")
  Th2HandbookHelp_L("@@@                                            O")
  Th2HandbookHelp_L("@@@                                             \")
  Th2HandbookHelp_L("@@@                                               \")
  Th2HandbookHelp_L("@@@                                                 \")
  Th2HandbookHelp_L("@@@                                                   \")
  Th2HandbookHelp_L("@@@                    O               O               O               O")
  Th2HandbookHelp_L("@@@                    |               |               |               |")
  Th2HandbookHelp_L("@@@                ---------       ---------       ---------       ---------")
  Th2HandbookHelp_L("@@@                |       |       |       |       |       |       |       |")
  Th2HandbookHelp_L("@@@Basic slot      |       |       |       |       |       |       |       |")
  Th2HandbookHelp_L("@@@                |       |       |       |       |       |       |       |")
  Th2HandbookHelp_L("@@@                |       |       |       |       |       |       |       |")
  Th2HandbookHelp_L("@@@                ---------       ---------       ---------       ---------")
  Th2HandbookHelp_L("@@@                 Slot #0            O            Slot #2         Slot #3")
  Th2HandbookHelp_L("@@@                                  /")
  Th2HandbookHelp_L("@@@                                /")
  Th2HandbookHelp_L("@@@                              /")
  Th2HandbookHelp_L("@@@               O             O             O             O")
  Th2HandbookHelp_L("@@@               |             |             |             |")
  Th2HandbookHelp_L("@@@           ---------     ---------     ---------     ---------")
  Th2HandbookHelp_L("@@@           |       |     |       |     |       |     |       |")
  Th2HandbookHelp_L("@@@Expansion  |       |     |       |     |       |     |       |")
  Th2HandbookHelp_L("@@@slot       |       |     |       |     |       |     |       |")
  Th2HandbookHelp_L("@@@           |       |     |       |     |       |     |       |")
  Th2HandbookHelp_L("@@@           ---------     ---------     ---------     ---------")
  Th2HandbookHelp_L("@@@           Slot #1-0     Slot #1-1     Slot #1-2     Slot #1-3")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Each slot has 64K bytes from 0000H to FFFFH of address space and MSX manages it by dividing it into four " + Chr(34) + "pages" + Chr(34) + " of 16K bytes each. The CPU can select and access any slot for each page, and, as shown in [[[Figure 5.37|||Chapter5b#figure-537--example-of-the-page-selection]]], it is possible to select and combine portions of several slots. Note that a pages with a given page number cannot be assigned to a page with a different page number (that is, page n of each slot is also page n to the CPU).")
  Th2HandbookHelp_Commit("_Figure 5.36  Basic slot and expansion slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-536-basic-slot-and-expansion-slot_", 708)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -------    -------    -------    -------                -------")
  Th2HandbookHelp_L("@@@Page 0  |  A  |    |  E  |    |  I  |    |  M  |  <---------->  |  A  |")
  Th2HandbookHelp_L("@@@        |-----|    |-----|    |-----|    |-----|                |-----|")
  Th2HandbookHelp_L("@@@Page 1  |  B  |    |  F  |    |  J  |    |  N  |  <---------->  |  J  |")
  Th2HandbookHelp_L("@@@        |-----|    |-----|    |-----|    |-----|                |-----|")
  Th2HandbookHelp_L("@@@Page 2  |  C  |    |  G  |    |  K  |    |  O  |  <---------->  |  G  |")
  Th2HandbookHelp_L("@@@        |-----|    |-----|    |-----|    |-----|                |-----|")
  Th2HandbookHelp_L("@@@Page 3  |  D  |    |  H  |    |  L  |    |  P  |  <---------->  |  H  |")
  Th2HandbookHelp_L("@@@        -------    -------    -------    -------                -------")
  Th2HandbookHelp_L("@@@         Slot 0     Slot 1     Slot 2     Slot 3              CPU address")
  Th2HandbookHelp_L("@@@                                                                 space")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.37  Example of the page selection_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-537-example-of-the-page-selection_", 709)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Selecting slots is different for the basic slot than for the expansion slot. For basic slots, it is done through the I/O port at A8H (see [[[Figure 5.38|||Chapter5b#figure-538--selecting-the-basic-slot]]]), and for expansion slots, it is done through the " + Chr(34) + "expansion slot selection register (FFFFH)" + Chr(34) + " of the installed expansion slot (see [[[Figure 5.39|||Chapter5b#figure-539--selecting-the-expansion-slot]]]). It is not recommended to change them directly, so the user should not switch the slots without careful planning. When the program switches the slot of the page in which it resides, the action is not always predictable. To call the program in another slot, use the inter-slot call described in the next section.")
  Th2HandbookHelp_Commit("7.1.2 Selecting slots", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#712-selecting-slots", 710)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@             I/O port (A8H)")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    :    |    :    |    :    |    :    |")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|         |         |         |         |")
  Th2HandbookHelp_L("@@@+---------+---------+---------+---------+")
  Th2HandbookHelp_L("@@@     |         |         |         |")
  Th2HandbookHelp_L("@@@     |         |         |         +---> Basic slot number of page 0 (0 to 3)")
  Th2HandbookHelp_L("@@@     |         |         +-------------> Basic slot number of page 1 (0 to 3)")
  Th2HandbookHelp_L("@@@     |         +-----------------------> Basic slot number of page 2 (0 to 3)")
  Th2HandbookHelp_L("@@@     +---------------------------------> Basic slot number of page 3 (0 to 3)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.38  Selecting the basic slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-538-selecting-the-basic-slot_", 711)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Expansion slot selection (FFFFH in expansion slot)")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    :    |    :    |    :    |    :    |")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|         |         |         |         |")
  Th2HandbookHelp_L("@@@+---------+---------+---------+---------+")
  Th2HandbookHelp_L("@@@     |         |         |         |")
  Th2HandbookHelp_L("@@@     |         |         |         +---> Expn. slot number of page 0 (0 to 3)")
  Th2HandbookHelp_L("@@@     |         |         +-------------> Expn. slot number of page 1 (0 to 3)")
  Th2HandbookHelp_L("@@@     |         +-----------------------> Expn. slot number of page 2 (0 to 3)")
  Th2HandbookHelp_L("@@@     +---------------------------------> Expn. slot number of page 3 (0 to 3)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Note:** to identify the kind of slot, in the case of the expansion slot, the value written is read as the reversed value. The value of this register is the same inside the basic slot.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The slot where MAIN-ROM or RAM is installed and the slot number of the slot for the cartridge depend on the machine. Refer to the appropriate manual to see how slots are used on your MSX. But the MSX standard guarantees the normal operation no matter what is in the slots, so it is not necessary to worry about the slot use, as long as you are following the standard.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In some cases, however, it is required to know the slot number of the specified software. For example, in the previous version, BASIC MAIN-ROM was placed in basic slot #0 or in expansion slot #0-0 when basic slot #0 was expanded. So when MSX1 is upgraded to have the MSX2 functions by installing MSX-VIDEO and BASIC ver 2.0 ROM, the MAIN ROM should be placed somewhere other than slot #0 or slot #0-0. The slot where MSX2 SUB-ROM resides depends on the machine, but the information about the slot where BASIC interpreter ROM resides can be obtained by referring to the work area described below (the slot information can be obtained in the format shown in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]]). When calling BIOS from DOS, examine the slot of MAIN-ROM in this way.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **EXPTBL (FCC1H, 1)** - the slot of MAIN-ROM")
  Th2HandbookHelp_L("* **EXBRSA (FAF8H, 1)** - the slot of SUB-ROM (0 for MSX1)")
  Th2HandbookHelp_Commit("_Figure 5.39  Selecting the expansion slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-539-selecting-the-expansion-slot_", 712)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MSB                                   LSB")
  Th2HandbookHelp_L("@@@   7    6    5    4    3    2    1    0")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    |    :    :    |    :    |    :    |")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    |              |         |         |")
  Th2HandbookHelp_L("@@@+----+--------------+---------+---------+")
  Th2HandbookHelp_L("@@@  |       Unused         |         |")
  Th2HandbookHelp_L("@@@  |                      |         +---> Basic slot number (0 to 3)")
  Th2HandbookHelp_L("@@@  |                      +-------------> Expansion slot number (0 to 3)")
  Th2HandbookHelp_L("@@@  |")
  Th2HandbookHelp_L("@@@  +------------------------------------> " + Chr(34) + "1" + Chr(34) + " if expansion slot")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When a given routine resides over page 1 and page 2 (4000H to BFFFH), the same slot for page 2 as the one for page 1 should be selected when the jump from page 1 to page 2 occurs within this routine. To do this, you need to examine the slot, in page 1, where the program resides and then to switch page 2 to that slot. To obtain information about the slot where the program currently is, execute the program shown in [[[List 5.11|||Chapter5b#list-511--program-to-know-the-current-slot]]].")
  Th2HandbookHelp_Commit("_Figure 5.40  Format for the slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-540-format-for-the-slot_", 713)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;  List 5.11   to know where you are")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;       Suppose your program cartridge is 32K bytes")
  Th2HandbookHelp_L("@@@;       long (4000h..0BFFFH). You set the ID at 4000H")
  Th2HandbookHelp_L("@@@;       and 4001H and the execution start address within")
  Th2HandbookHelp_L("@@@;       page 1 (4000h..7FFFH), MSX passes control")
  Th2HandbookHelp_L("@@@;       to this address so the part which resides in")
  Th2HandbookHelp_L("@@@;       page 2 is not yet enabled at this point. You")
  Th2HandbookHelp_L("@@@;       have to know where you are (in what primary")
  Th2HandbookHelp_L("@@@;       slot, in what secondary slot) and enable the")
  Th2HandbookHelp_L("@@@;       part at page 2. Below is the sample program")
  Th2HandbookHelp_L("@@@;       to do this.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@ENASLT  EQU     0024H           ;enable slot")
  Th2HandbookHelp_L("@@@RSLREG  EQU     0138H           ;read primary slot select register")
  Th2HandbookHelp_L("@@@EXPTBL  EQU     0FCC1H          ;slot is expanded or not")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ENAP2:")
  Th2HandbookHelp_L("@@@        CALL    RSLREG          ;read primary slot #")
  Th2HandbookHelp_L("@@@        RRCA                    ;move it to bit 0,1 of [Acc]")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        AND     00000011B")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        LD      B,0")
  Th2HandbookHelp_L("@@@        LD      HL,EXPTBL       ;see if this slot is expanded or not")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        LD      C,A             ;save primary slot #")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ;See if the slot is expanded or not")
  Th2HandbookHelp_L("@@@        AND     80H")
  Th2HandbookHelp_L("@@@        OR      C               ;set MSB if so")
  Th2HandbookHelp_L("@@@        LD      C,A             ;save it to [C]")
  Th2HandbookHelp_L("@@@        INC     HL              ;Point to SLTTBL entry")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ;Get what is currently output")
  Th2HandbookHelp_L("@@@                                ;to expansion slot register")
  Th2HandbookHelp_L("@@@        AND     00001100B")
  Th2HandbookHelp_L("@@@        OR      C               ;Finally form slot address")
  Th2HandbookHelp_L("@@@        LD      H,80H")
  Th2HandbookHelp_L("@@@        JP      ENASLT          ;enable page 2")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.11  Program to know the current slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_list-511-program-to-know-the-current-slot_", 714)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("As described above, programs reside in different slots, so a program not in the current slot might be needed in some cases. The most common cases are listed below:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(1) calling BIOS in MAIN-ROM from MSX-DOS level")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(2) calling BIOS in SUB-ROM from BASIC level (only the case of MSX2)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("(3) calling BIOS in MAIN-ROM or SUB-ROM from cartridge software")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In doing such calls, to switch slots easily and safely, there is a group of BIOS routines called the inter-slot calls, which can be called from the routine in any slot. This section describes the use of the inter-slot calls.")
  Th2HandbookHelp_Commit("7.2 Inter-slot Calls (calls between slots)", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#72-inter-slot-calls-calls-between-slots", 715)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When calling BIOS in MAIN-ROM from MSX-DOS, the state of slots changes as described below.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Since, in the initial MSX-DOS mode, RAM is selected all over 64K address space, BASIC-ROM cannot be accessible in this state (see [[[Figure 5.41|||Chapter5b#figure-541--inter-slot-call]]]-a).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("2. To call BIOS in ROM, switch page 0 to MAIN-ROM or BASIC to access. Then, call BIOS (see [[[Figure 5.41|||Chapter5b#figure-541--inter-slot-call]]]-b).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("3. Restore the original status after BIOS operations and return to the initial address.")
  Th2HandbookHelp_Commit("7.2.1 Inter-slot call operation", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#721-inter-slot-call-operation", 716)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@a) When using MSX-DOS                     b) When calling BASIC-ROM BIOS")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        MSX-DOS   BASIC-ROM                       MSX-DOS   BASIC-ROM")
  Th2HandbookHelp_L("@@@        -------    -------                        -------    -------")
  Th2HandbookHelp_L("@@@Page 0  | RAM |    | ROM |                Page 0  | RAM |    | ROM | BIOS is")
  Th2HandbookHelp_L("@@@        |-----|    |-----|                        |-----|    |-----| called")
  Th2HandbookHelp_L("@@@Page 1  | RAM |    | ROM |                Page 1  | RAM |    | ROM |")
  Th2HandbookHelp_L("@@@        |-----|    |-----|  <---------->          |-----|    |-----|")
  Th2HandbookHelp_L("@@@Page 2  | RAM |    | ___ |                Page 2  | RAM |    | ___ |")
  Th2HandbookHelp_L("@@@        |-----|    |-----|                        |-----|    |-----|")
  Th2HandbookHelp_L("@@@Page 3  | RAM |    | ___ |                Page 3  | RAM |    | ___ |")
  Th2HandbookHelp_L("@@@        -------    -------                        -------    -------")
  Th2HandbookHelp_L("@@@         Slot 3     Slot 0                         Slot 3     Slot 0")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("This is easily done when the program resides in other than page 0, but there can be some problem when the calling program resides in page 0 which is the same page as BIOS of the called program. Care is needed to prevent the program from disappearing itself and generating unpredictable results when it is switched to page 0. The inter-slot call settles this problem by jumping to page 3 temporarily and then switching slots.")
  Th2HandbookHelp_Commit("_Figure 5.41  Inter-slot call_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-541-inter-slot-call_", 717)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("There are several ways to execute inter-slot calls, as described below. They are included in MAIN-ROM as BIOS calls. Some of them are offered in MSX-DOS, so inter-slot calls can be executed under MSX-DOS.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(1) Inter-slot call routines in BIOS_")
  Th2HandbookHelp_Commit("7.2.2 Inter-slot call use", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#722-inter-slot-call-use", 718)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * A register ⟵ slot specification")
  Th2HandbookHelp_L("  * HL register ⟵ address to be read at")
  Th2HandbookHelp_L("* **Output**: A register ⟵ value which has been read out")
  Th2HandbookHelp_L("* **Use**: AF, BC, DE")
  Th2HandbookHelp_L("* **Function**: reads the value at the specified address of the specified slot and stores it in the A register. The slot specification is done using the A register in the form shown in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]]. At this point, when the objective slot is the basic slot, set " + Chr(34) + "0" + Chr(34) + " to the 6 high order bits and define the slot #0 to #3 using the 2 low order bits. When specifying the expansion slot, specify the basic slot by bit 0 and bit 1 and the expansion slot by bit 2 and bit 3 and set bit 7 to " + Chr(34) + "1" + Chr(34) + ".")
  Th2HandbookHelp_Commit("RDSLT (000CH/MAIN) - read value at specified address of specified slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#rdslt-000chmain---read-value-at-specified-address-of-specified-slot", 719)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * A register ⟵ slot specification (same format as in Figure 5.40)")
  Th2HandbookHelp_L("  * HL register ⟵ address to be written in")
  Th2HandbookHelp_L("  * E register ⟵ data to be written")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Use**: AF, BC, D")
  Th2HandbookHelp_L("* **Function**: writes E register value in the address specified by HL register of the slot specified by the A register (the specification format is the same as in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]]).")
  Th2HandbookHelp_Commit("WRSLT (0014H/MAIN) - write value at specified address of specified slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#wrslt-0014hmain---write-value-at-specified-address-of-specified-slot", 720)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * 8 high order bits of IY register ⟵ slot (same format as in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]])")
  Th2HandbookHelp_L("  * IX register ⟵ address to be called")
  Th2HandbookHelp_L("* **Output**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Use**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Function**: calls the routine at the address specified by IX register of the slot specified by the 8 high order bits of IY register (the specification format is the same as in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]]).")
  Th2HandbookHelp_Commit("CALSLT (001CH/MAIN) - call specified address of specified slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#calslt-001chmain---call-specified-address-of-specified-slot", 721)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * A register ⟵ slot (same format as in [[[Figure 5.40|||Chapter5b#figure-540--format-for-the-slot]]])")
  Th2HandbookHelp_L("  * HL register ⟵ specifies the page to switch the slot by 2 high order bits")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Use**: all")
  Th2HandbookHelp_L("* **Function**: switches the page specified by the 2 high order bits of the HL register to the slot specified by the A register.")
  Th2HandbookHelp_Commit("ENASLT (0024H/MAIN) - swicth slots", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#enaslt-0024hmain---swicth-slots", 722)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: specifies the slot and the address in the inline parameter format")
  Th2HandbookHelp_L("* **Output**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Use**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Function**: calls the specified address of the specified slot, but, different from CALSLT described above, the slot and the address is specified in the inline parameter format, as described below. That is, parameters are passet by one byte (same format as RDSLT) to specify that the slot is placed just after the instruction which calls CALLF and the next two bytes to specify the address are placed. " + Chr(34) + "CALL 0030H" + Chr(34) + " may be replaced by the RST (restart) instruction, " + Chr(34) + "RST 30H" + Chr(34) + ". In this case, the inter-slot call is done in 4 bytes.")
  Th2HandbookHelp_Commit("CALLF (0030H/MAIN) - call specified address of specified slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#callf-0030hmain---call-specified-address-of-specified-slot", 723)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    RST     30H             ;interslot call")
  Th2HandbookHelp_L("@@@    DB      00000000B       ;select slot#0")
  Th2HandbookHelp_L("@@@    DW      006CH           ;call address = 006CH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.42  Example of the inter-slot call execution_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-542-example-of-the-inter-slot-call-execution_", 724)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: ---")
  Th2HandbookHelp_L("* **Output**: A register ⟵ value which has been read")
  Th2HandbookHelp_L("* **Use**: ---")
  Th2HandbookHelp_L("* **Function**: reads the contents of the basic slot selection register and stores it in the A register.")
  Th2HandbookHelp_Commit("RSLREG (0138H/MAIN) - read the basic slot selection register", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#rslreg-0138hmain---read-the-basic-slot-selection-register", 725)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: A register ⟵ value to be written")
  Th2HandbookHelp_L("* **Output**: ---")
  Th2HandbookHelp_L("* **Use**: ---")
  Th2HandbookHelp_L("* **Function**: writes the A register value in the basic slot selection register and selects the slot.")
  Th2HandbookHelp_Commit("WSLREG (013BH/MAIN) - write in the basic slot selection register", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#wslreg-013bhmain---write-in-the-basic-slot-selection-register", 726)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: IX register ⟵ address to be called, PUSH IX (see Appendix 2, SUB-ROM list)")
  Th2HandbookHelp_L("* **Output**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Use**: background register and IX, IY registers are reserved")
  Th2HandbookHelp_L("* **Function**: This is the routine to call BASIC SUB-ROM especially. The slot where SUB-ROM resides is automatically examined. Normally, EXTROM, described below, is used.")
  Th2HandbookHelp_Commit("SUBROM (015CH/MAIN) - call specified address in SUB-ROM", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#subrom-015chmain---call-specified-address-in-sub-rom", 727)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Input**: IX register ⟵ address to be called")
  Th2HandbookHelp_L("* **Output**: depends on the result of the called program")
  Th2HandbookHelp_L("* **Use**: background register and IY register are reserved")
  Th2HandbookHelp_L("* **Function**: This is the routine to call BASIC SUB-ROM. The difference between this and SUB-ROM above is the point whether the IX register value is pushed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("_(2) Inter-slot call in MSX-DOS_")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In MSX-DOS, five kinds of inter-slot calls are offered and their entry addresses are defined at jump vectors of MSX-DOS. These are the same as ones in BIOS, so refer to BIOS above for their functions or use. Note that these routines should not be used when calling routines in SUB-ROM from MSX-DOS.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* RDSLT (000CH) - read value at specified address of specified slot")
  Th2HandbookHelp_L("* WRSLT (0014H) - write value at specified address of specified slot")
  Th2HandbookHelp_L("* CALSLT (001CH) - call specified address of specified slot")
  Th2HandbookHelp_L("* ENASLT (0024H) - make specified slot available")
  Th2HandbookHelp_L("* CALLF (0030H) - call specified address of specified slot")
  Th2HandbookHelp_Commit("EXTROM (015FH/MAIN) - call specified address in SUB-ROM", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#extrom-015fhmain---call-specified-address-in-sub-rom", 728)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;  List 5.12    How to use BIOS from MSX-DOS.")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@CALSLT  EQU     001CH           ;Inter slot call")
  Th2HandbookHelp_L("@@@EXBRSA  EQU     0FAF0H          ;Slot address of BIOS (main) ROM")
  Th2HandbookHelp_L("@@@EXPTBL  EQU     0FCC1H          ;Slot address of extended ROM")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       LD      IY,(EXPTBL-1)   ;Load slot address of the BIOS ROM")
  Th2HandbookHelp_L("@@@;                               ;in high byte of IY")
  Th2HandbookHelp_L("@@@;       LD      IX,address of the BIOS jump table")
  Th2HandbookHelp_L("@@@;       CALL    CALSLT")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;----- Sample program to set text mode -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INITXT  EQU     006CH")
  Th2HandbookHelp_L("@@@LINL40  EQU     0F3AEH")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@TOTEXT: LD      B,40")
  Th2HandbookHelp_L("@@@        LD      A,(EXBRSA)      ;slot address of SUB-ROM")
  Th2HandbookHelp_L("@@@        OR      A               ;0 if MSX1")
  Th2HandbookHelp_L("@@@        JR      Z,TO40")
  Th2HandbookHelp_L("@@@        LD      B,80")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@TO40:   LD      (LINL40),B      ;set width into work area")
  Th2HandbookHelp_L("@@@        LD      IX,INITXT")
  Th2HandbookHelp_L("@@@        LD      IY,(EXPTBL-1)   ;get expanded slot status to IYH")
  Th2HandbookHelp_L("@@@        CALL    CALSLT          ;perform an inter-slot call")
  Th2HandbookHelp_L("@@@        EI                      ;because CALSLT do DI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.12  Calling BIOS from MSX-DOS_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_list-512-calling-bios-from-msx-dos_", 729)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The following addresses involve the slot work area.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **EXBRSA (FAF8H, 1)** - SUB-ROM slot")
  Th2HandbookHelp_Commit("7.2.3 Work area to obtain the slot status", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#723-work-area-to-obtain-the-slot-status", 730)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MSB                                   LSB")
  Th2HandbookHelp_L("@@@   7    6    5    4    3    2    1    0")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    |    :    :    |    :    |    :    |")
  Th2HandbookHelp_L("@@@-----------------------------------------")
  Th2HandbookHelp_L("@@@|    |              |         |         |")
  Th2HandbookHelp_L("@@@+----+--------------+---------+---------+")
  Th2HandbookHelp_L("@@@  |       Unused         |         |")
  Th2HandbookHelp_L("@@@  |                      |         +---> Basic slot number (0 to 3)")
  Th2HandbookHelp_L("@@@  |                      +-------------> Expansion slot number (0 to 3)")
  Th2HandbookHelp_L("@@@  |")
  Th2HandbookHelp_L("@@@  +------------------------------------> " + Chr(34) + "1" + Chr(34) + " if expansion slot")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **EXPTBL (FCC1H, 4)** - whether the basic slot is expanded or not")
  Th2HandbookHelp_Commit("_Figure 5.43  SUB-ROM slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-543-sub-rom-slot_", 731)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         MSB                                   LSB")
  Th2HandbookHelp_L("@@@            7    6    5    4    3    2    1    0")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@[FCC1H]  |    |    :    :    |    :    |    :    |  MAIN-ROM slot")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@[FCC2H]  |    |            Unused                |  Slot #1")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@[FCC3H]  |    |            Unused                |  Slot #2")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@[FCC4H]  |    |            Unused                |  Slot #3")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@           |")
  Th2HandbookHelp_L("@@@           +--> 0: slot is not expanded")
  Th2HandbookHelp_L("@@@                1: slot is expanded")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **SLTTBL (FCC5H, 4)** - preservation area for the expansion slot selection register value")
  Th2HandbookHelp_Commit("_Figure 5.44  Selecting the basic slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-544-selecting-the-basic-slot_", 732)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         MSB                                   LSB")
  Th2HandbookHelp_L("@@@            7    6    5    4    3    2    1    0")
  Th2HandbookHelp_L("@@@         -----------------------------------------  expansion slot selection")
  Th2HandbookHelp_L("@@@[FCC5H]  |    :    |    :    |    :    |    :    |  register value of slot #0")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------  expansion slot selection")
  Th2HandbookHelp_L("@@@[FCC6H]  |    :    |    :    |    :    |    :    |  register value of slot #1")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------  expansion slot selection")
  Th2HandbookHelp_L("@@@[FCC7H]  |    :    |    :    |    :    |    :    |  register value of slot #2")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------  expansion slot selection")
  Th2HandbookHelp_L("@@@[FCC8H]  |    :    |    :    |    :    |    :    |  register value of slot #3")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@         |         |         |         |         |")
  Th2HandbookHelp_L("@@@         +---------+---------+---------+---------+")
  Th2HandbookHelp_L("@@@              |         |         |         |")
  Th2HandbookHelp_L("@@@              |         |         |         +---->  exp. slot num. for page 0")
  Th2HandbookHelp_L("@@@              |         |         +-------------->  exp. slot num. for page 1")
  Th2HandbookHelp_L("@@@              |         +------------------------>  exp. slot num. for page 2")
  Th2HandbookHelp_L("@@@              +---------------------------------->  exp. slot num. for page 3")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **SLTATR (FCC9H, 64)** - test for existance of application in each slot/page")
  Th2HandbookHelp_Commit("_Figure 5.45  Selecting the expansion slot_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-545-selecting-the-expansion-slot_", 733)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@[FCC9H]  |    |    |    |         Unused         |  Slot #0-0, page 0")
  Th2HandbookHelp_L("@@@         |----+----+----+------------------------|")
  Th2HandbookHelp_L("@@@[FCCAH]  |    |    |    |         Unused         |  Slot #0-0, page 1")
  Th2HandbookHelp_L("@@@         |----+----+----+------------------------|")
  Th2HandbookHelp_L("@@@         |    |    |    |                        |")
  Th2HandbookHelp_L("@@@   .       .    .    .")
  Th2HandbookHelp_L("@@@   .       .    .    .")
  Th2HandbookHelp_L("@@@   .       .    .    .")
  Th2HandbookHelp_L("@@@         |    |    |    |                        |")
  Th2HandbookHelp_L("@@@         |----+----+----+------------------------|")
  Th2HandbookHelp_L("@@@[FD08H]  |    |    |    |         Unused         |  Slot #3-3, page 3")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@           |    |    |")
  Th2HandbookHelp_L("@@@           |    |    +-->  Routine to process expanded statements  1:yes 0:no")
  Th2HandbookHelp_L("@@@           |    +------->  Routine to process expansion device     1:yes 0:no")
  Th2HandbookHelp_L("@@@           +------------>  BASIC text                              1:yes 0:no")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The concrete work area for a given slot and page can be obtained with the following expression:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    SLTATR address = FCC9H + 16*basic slot + 4*expansion slot + page")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **SLTWRK (FD09H, 128)** - work area for application")
  Th2HandbookHelp_Commit("_Figure 5.46  Test for existence of application_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-546-test-for-existence-of-application_", 734)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@         -----------------------------------------  Work area for")
  Th2HandbookHelp_L("@@@[FD09H]  |  ...................................  |  slot 0-0 page 0")
  Th2HandbookHelp_L("@@@         |---------------------------------------|")
  Th2HandbookHelp_L("@@@[FD0BH]  |  ...................................  |  Work area for")
  Th2HandbookHelp_L("@@@         |---------------------------------------|  slot 0-0 page 1")
  Th2HandbookHelp_L("@@@         |                                       |")
  Th2HandbookHelp_L("@@@   .     .                                       .")
  Th2HandbookHelp_L("@@@   .     .                                       .")
  Th2HandbookHelp_L("@@@   .     .                                       .")
  Th2HandbookHelp_L("@@@         |                                       |")
  Th2HandbookHelp_L("@@@         |---------------------------------------|  Work area for")
  Th2HandbookHelp_L("@@@[FD87H]  |  ...................................  |  slot 3-3 page 3")
  Th2HandbookHelp_L("@@@         -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The concrete work area for a given slot and page can be obtained with the following expression:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    SLTWRK address = FD09H + 32*basic slot + 8*expansion slot + 2*page")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.47  Work area for application_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-547-work-area-for-application_", 735)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX machines usually have at least one external slot and the hardware to be put there is called a " + Chr(34) + "cartridge" + Chr(34) + ". There are cartridges such as the ROM cartridges for application programs or games, input-output device cartridges for a disk or RS-232 interface, RAM expansion cartridges for expanding RAM, and slot expansion cartridges for expanding slots. These cartridges make the MSX easy to upgrade. BASIC and assembly language programs can also be stored in ROM cartridge easily. This section describes how to develop cartridge software.")
  Th2HandbookHelp_Commit("7.3 Developing Cartridge Software", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#73-developing-cartridge-software", 736)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("MSX cartridges have a 16-bye common header and, when the system is reset, the cartridge is initialised by the information written in this header. For ROM cartridges of BASIC or assembly language programs, they can be automatically started by using the information written in the header. [[[Figure 5.48|||Chapter5b#figure-548--program-cartridge-header]]] shows the cartridge header configuration.")
  Th2HandbookHelp_Commit("7.3.1 Catridge header", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#731-catridge-header", 737)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -------------------   4000H or 8000H")
  Th2HandbookHelp_L("@@@+0000H  |       ID        |")
  Th2HandbookHelp_L("@@@        |-----------------|")
  Th2HandbookHelp_L("@@@+0002H  |      INIT       |")
  Th2HandbookHelp_L("@@@        |-----------------|")
  Th2HandbookHelp_L("@@@+0004H  |    STATEMENT    |")
  Th2HandbookHelp_L("@@@        |-----------------|")
  Th2HandbookHelp_L("@@@+0006H  |     DEVICE      |")
  Th2HandbookHelp_L("@@@        |-----------------|")
  Th2HandbookHelp_L("@@@+0008H  |      TEXT       |")
  Th2HandbookHelp_L("@@@        |-----------------|")
  Th2HandbookHelp_L("@@@+000AH  |                 |")
  Th2HandbookHelp_L("@@@        |                 |")
  Th2HandbookHelp_L("@@@        |    Reserved     |   Note:  Reserved area should")
  Th2HandbookHelp_L("@@@        |                 |          be filled with 00H.")
  Th2HandbookHelp_L("@@@        |                 |")
  Th2HandbookHelp_L("@@@+0010H  -------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.48  Program cartridge header_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-548-program-cartridge-header_", 738)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In the case of ROM cartridges, these two bytes have codes " + Chr(34) + "AB" + Chr(34) + " (41H, 42H). For SUB-ROM cartridges, the ID is " + Chr(34) + "CD" + Chr(34) + ".")
  Th2HandbookHelp_Commit("ID", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#id", 739)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When the cartridge is made to initialise the work area or I/O, these two bytes are the addresses for the initialization routine; otherwise 0000H is assumed. After instructions such as getting the work area in the initialization routine are placed, end with " + Chr(34) + "RET" + Chr(34) + ". All registers except the SP register may be destroyed. For assembly language programs, such as games, which loop within the cartridge, it is possible to execute the object program from here.")
  Th2HandbookHelp_Commit("INIT", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#init", 740)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When the cartridge is made to expand the CALL statement, these two bytes are the address for the statement expansion routine; otherwise 0000H is assumed. If so, the statement expansion routine should reside at 4000H to 7FFFH.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The CALL statement is described in the following format:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    CALL <expression statement name> [(<argument>[, <argument>...])]")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The expression statement name can have up to 15 characters. As an abbreviation for CALL, " + Chr(34) + "_" + Chr(34) + " (underscore) is available.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the BASIC interpreter finds a CALL statement, it puts the expansion statement name in PROCNM (FD89H, 16) in the work area and passes the control to cartridges, whose contents of STATEMENT of the header is other than 0, in the order from the one with the smaller slot number. The HL register points to the text address next to the expansion statement name at this point (see [[[Figure 5.49|||Chapter5b#figure-549--input-output-of-the-operation-routine-of-the-expansion-statement]]]a).")
  Th2HandbookHelp_Commit("STATEMENT", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#statement", 741)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@a)  |  Input setup when the interpreter calls routines to process       |")
  Th2HandbookHelp_L("@@@    |  expanded statements                                              |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CALL ABCDE(0,0,0):A=0                                            |")
  Th2HandbookHelp_L("@@@    |            ^                                                      |")
  Th2HandbookHelp_L("@@@    |            |                                                      |")
  Th2HandbookHelp_L("@@@    |            HL                                                     |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CY flag = 1                               +---- End of the name  |")
  Th2HandbookHelp_L("@@@    |                                            |     of the expanded  |")
  Th2HandbookHelp_L("@@@    |           -------------------------------------  statement        |")
  Th2HandbookHelp_L("@@@    |   PROCNM  |  A  |  B  |  C  |  D  |  E  | 00H |                   |")
  Th2HandbookHelp_L("@@@    |           -------------------------------------                   |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@b)  |  Output setup when the expanded statement was not processed       |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CALL ABCDE(0,0,0):A=0                                            |")
  Th2HandbookHelp_L("@@@    |            ^                                                      |")
  Th2HandbookHelp_L("@@@    |            |                                                      |")
  Th2HandbookHelp_L("@@@    |            HL                                                     |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CY flag = 1                                                      |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@c)  |  Output setup when the expanded statement was processed           |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CALL ABCDE(0,0,0):A=0                                            |")
  Th2HandbookHelp_L("@@@    |                   ^                                               |")
  Th2HandbookHelp_L("@@@    |                   |                                               |")
  Th2HandbookHelp_L("@@@    |                   HL                                              |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CY flag = 0                                                      |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    ---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("To develop the statement expansion routine, recognise the name of the expansion statement written in PROCNM first, then return with setting " + Chr(34) + "1" + Chr(34) + " to the carry flag without modifying the HL register if the statement is not to be handled (see [[[Figure 5.49|||Chapter5b#figure-549--input-output-of-the-operation-routine-of-the-expansion-statement]]]b); otherwise, handle it properly and set the HL register (text pointer) to the next handled statement (where 00H or 3AH is placed usually), then return after setting " + Chr(34) + "0" + Chr(34) + " to the carry flag (see [[[Figure 5.49|||Chapter5b#figure-549--input-output-of-the-operation-routine-of-the-expansion-statement]]]c).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The BASIC interpreter determines the status of the carry flag whether a CALL statement has been executed, and, if not, calls the next cartridge. When all cartridges have not executed the statement (when the carry flag has been " + Chr(34) + "1" + Chr(34) + " all the time), it displays " + Chr(34) + "SYNTAX ERROR" + Chr(34) + ". To test arguments of the statement, it is convenient to use " + Chr(34) + "internal routines for the statement expansion" + Chr(34) + " in [section 4.4 of chapter 2](Chapter2.md#44-expansion-of-cmd-command).")
  Th2HandbookHelp_Commit("_Figure 5.49  Input-output of the operation routine of the expansion statement_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-549-input-output-of-the-operation-routine-of-the-expansion-statement_", 742)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("These two bytes are the addresses of the device expansion routine, when the cartridge does the device expansion (the input-output device expansion); otherwise 0000H is used. When doing the device expansion, the device expansion routine should be in 4000H-7FFFH. One cartridge can have up to 4 devices. The name of the expansion device should be less than 16 characters.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the BASIC interpreter finds an undefined device, it stores that in PROCNM (FD89H, 16) and put FFH in the A register and passes control to the cartridge whose contents is not 0 in the order from the one with the smaller slot number (see [[[Figure 5.50|||Chapter5b#figure-550--input-output-to-the-device-expansion-routine]]]a).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When creating device expansion routines, identify the file descriptor of PROCNM first, and, when it is not for the device to be processed, return with setting 1 to the carry flag (see [[[Figure 5.50|||Chapter5b#figure-550--input-output-to-the-device-expansion-routine]]]b). Otherwise, process it and set the device ID (0-3) in the A register, then return with setting 0 to the carry flag (see [[[Figure 5.50|||Chapter5b#figure-550--input-output-to-the-device-expansion-routine]]]c).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The BASIC interpreter determines by the status of the carry flag whether or not it is processed, and, if not, call the next cartridge. When all cartridges were not processed (that is, when the carry flag was " + Chr(34) + "1" + Chr(34) + " all the time), " + Chr(34) + "Bad file name ERROR" + Chr(34) + " is displayed.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When the actual input-output operations are done, the BASIC interpreter sets the device ID (0-3) in DEVICE (FD99H) and sets the request to the device in the A register (see [[[Table 5.6|||Chapter5b#table-56--requests-to-the-device]]]), then calls the device expansion routine. The device expansion routine should refer to it to handle the request.")
  Th2HandbookHelp_Commit("DEVICE", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#device", 743)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    ---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@a)  |  Input setup when the interpreter calls routines to process       |")
  Th2HandbookHelp_L("@@@    |  the expanded device                                              |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  OPEN " + Chr(34) + "ABC:" + Chr(34) + "...                                                   |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  A register = FFH                                                 |")
  Th2HandbookHelp_L("@@@    |  CY flag = 1                   +---- End of the file descriptor   |")
  Th2HandbookHelp_L("@@@    |                                |                                  |")
  Th2HandbookHelp_L("@@@    |           -------------------------                               |")
  Th2HandbookHelp_L("@@@    |   PROCNM  |  A  |  B  |  C  | 00H |                               |")
  Th2HandbookHelp_L("@@@    |           -------------------------                               |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@b)  |  Output setup when the expanded device was not processed          |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  CY flag = 1                                                      |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@c)  |  Output setup when the expanded device was processed              |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    |  A register = device ID (0 to 3)                                  |")
  Th2HandbookHelp_L("@@@    |  CY flag = 0                                                      |")
  Th2HandbookHelp_L("@@@    |                                                                   |")
  Th2HandbookHelp_L("@@@    ---------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.50  Input-output to the device expansion routine_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-550-input-output-to-the-device-expansion-routine_", 744)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@--------------------------------------")
  Th2HandbookHelp_L("@@@|  Register A  |       Request       |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|       0      |  OPEN               |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|       2      |  CLOSE              |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|       4      |  Random access      |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|       6      |  Sequential output  |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|       8      |  Sequential input   |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|      10      |  LOC function       |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|      12      |  LOF function       |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|      14      |  EOF function       |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|      16      |  FPOS function      |")
  Th2HandbookHelp_L("@@@|--------------+---------------------|")
  Th2HandbookHelp_L("@@@|      18      |  Backup character   |")
  Th2HandbookHelp_L("@@@--------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Table 5.6  Requests to the device_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_table-56-requests-to-the-device_", 745)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("These two bytes are text pointers of the BASIC program, when the BASIC program in the cartridge would be auto-started (executed at reset); otherwise they are 0000H. The size of the program must be under 16K bytes, 8000H to BFFFH.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The BASIC interpreter examines the contents of TEXT of the header after the initialization (INIT) and after the system is started. When they are not 0000H, it begins the execution from the address as BASIC text pointer (see [[[Figure 5.51|||Chapter5b#figure-551--executing-basic-program-cartridge]]]). BASIC programs should be stored in the form of the intermediate code and the beginning of it (the address pointed by TEXT) must be 00H, which indicates the beginning of the program.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The execution speed of the program will be improved when the objective line number of statements such as GOTO is the absolute address of the objective text pointer.")
  Th2HandbookHelp_Commit("TEXT", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#text", 746)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@---------------------")
  Th2HandbookHelp_L("@@@|                   |  8000H")
  Th2HandbookHelp_L("@@@|-------------------|")
  Th2HandbookHelp_L("@@@|       TEXT        |----+")
  Th2HandbookHelp_L("@@@|-------------------|    |")
  Th2HandbookHelp_L("@@@|                   |    |")
  Th2HandbookHelp_L("@@@|                   |    |")
  Th2HandbookHelp_L("@@@|-------------------|<---+")
  Th2HandbookHelp_L("@@@|                   |")
  Th2HandbookHelp_L("@@@|   BASIC program   |  The first byte must be 00H")
  Th2HandbookHelp_L("@@@|                   |")
  Th2HandbookHelp_L("@@@|-------------------|")
  Th2HandbookHelp_L("@@@|                   |")
  Th2HandbookHelp_L("@@@|                   |")
  Th2HandbookHelp_L("@@@|                   |")
  Th2HandbookHelp_L("@@@---------------------  BFFFH")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.51  Executing BASIC program cartridge_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-551-executing-basic-program-cartridge_", 747)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("1. Change the starting address of BASIC text to 8021H.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    POKE &HF676,&H21 : POKE &HF677,&H80 : POKE &H8020,0 : NEW")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("*Note:* these statements must be in one line.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("2. Load the objective BASIC program.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    LOAD " + Chr(34) + "PROGRAM" + Chr(34))
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("3. Create ID.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    AD = &H8000")
  Th2HandbookHelp_L("@@@    FOR I = 0 TO 31    ----+")
  Th2HandbookHelp_L("@@@     POKE AD + I, 0        |  clears ID area")
  Th2HandbookHelp_L("@@@    NEXT I             ----+")
  Th2HandbookHelp_L("@@@    POKE &H8000,ASC(" + Chr(34) + "A" + Chr(34) + ")")
  Th2HandbookHelp_L("@@@    POKE &H8001,ASC(" + Chr(34) + "B" + Chr(34) + ")")
  Th2HandbookHelp_L("@@@    POKE &H8008,&H20")
  Th2HandbookHelp_L("@@@    POKE &H8009,&H80")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("4. Put 8000H to BFFFH in ROM.")
  Th2HandbookHelp_Commit("How to place BASIC programs in ROM", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#how-to-place-basic-programs-in-rom", 748)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("In programs not requiring software from other cartridges (stand-alone software such as games), the portion with the smaller address than the work area used by BIOS (F380H) can be used freely.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("But in programs which are executed by using BASIC interpreter functions, the same area cannot be shared as the work area. To do this, there are three methods:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("1. Place RAM on the cartridge itself (the safest and most reliable method).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("2. When one or two bytes are needed for the work area, use two bytes")
  Th2HandbookHelp_L("@@@corresponding to itself in SLTWRK (FD09H to ...) as the work area.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("3. When more than three bytes are needed for the work area, allocates it")
  Th2HandbookHelp_L("@@@from RAM used by BASIC. To do this, put the contents of BOTTOM (FC48H)")
  Th2HandbookHelp_L("@@@to the area corresponding to SLTWRK (FD09H to ...), and increase the")
  Th2HandbookHelp_L("@@@value of BOTTOM by the needed work area, then allocate it for the")
  Th2HandbookHelp_L("@@@work area (see [Figure 5.52](#figure-552--allocating-the-work-area)).")
  Th2HandbookHelp_Commit("7.3.2 notes on the creation of the cartridge software", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#732-notes-on-the-creation-of-the-cartridge-software", 749)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@8000H   ----------------- <-- (BOTTOM)     ----------------- <-- (SLTWRK)")
  Th2HandbookHelp_L("@@@        |               |                  |   Work area   |")
  Th2HandbookHelp_L("@@@        |               |                  |---------------| <-- (BOTTOM)")
  Th2HandbookHelp_L("@@@        |  User's area  |                  |               |")
  Th2HandbookHelp_L("@@@        |               |       --->       |  User's area  |")
  Th2HandbookHelp_L("@@@        |               |                  |               |")
  Th2HandbookHelp_L("@@@F380H   |---------------|                  |---------------|")
  Th2HandbookHelp_L("@@@        |  System work  |                  |  System work  |")
  Th2HandbookHelp_L("@@@FFFFH   -----------------                  -----------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("See the following list for the reference of (2) and (3).")
  Th2HandbookHelp_Commit("_Figure 5.52  Allocating the work area_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-552-allocating-the-work-area_", 750)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;  List 5.13  subroutines to support slot")
  Th2HandbookHelp_L("@@@;              for ROM in 1 page")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@RSLREG  EQU     0138H")
  Th2HandbookHelp_L("@@@EXPTBL  EQU     0FCC1H")
  Th2HandbookHelp_L("@@@BOTTOM  EQU     0FC48H")
  Th2HandbookHelp_L("@@@HIMEM   EQU     0FC4AH")
  Th2HandbookHelp_L("@@@SLTWRK  EQU     0FD09H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       GTSL1   Get slot number of designated page")
  Th2HandbookHelp_L("@@@;       Entry   None")
  Th2HandbookHelp_L("@@@;       Return  A       Slot address as follows")
  Th2HandbookHelp_L("@@@;       Modify  Flags")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;           FxxxSSPP")
  Th2HandbookHelp_L("@@@;           |   ||||")
  Th2HandbookHelp_L("@@@;           |   ||++-- primary slot # (0-3)")
  Th2HandbookHelp_L("@@@;           |   ++---- secondary slot # (0-3)")
  Th2HandbookHelp_L("@@@;           |          00 if not expanded")
  Th2HandbookHelp_L("@@@;           +--------- 1 if secondary slot # specified")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       This value can later be used as an input parameter")
  Th2HandbookHelp_L("@@@;       for the RDSLT, WRSLT, CALSLT, ENASLT and 'RST 10H'")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  GTSL10")
  Th2HandbookHelp_L("@@@GETSL10:")
  Th2HandbookHelp_L("@@@        PUSH    HL              ;Save registers")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    RSLREG          ;read primary slot #")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        AND     11B             ;[A]=000000PP")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        LD      D,0             ;[DE]=000000PP")
  Th2HandbookHelp_L("@@@        LD      HL,EXPTBL")
  Th2HandbookHelp_L("@@@        ADD     HL,DE           ;[HL]=EXPTBL+000000PP")
  Th2HandbookHelp_L("@@@        LD      E,A             ;[E]=000000PP")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ;A=(EXPTBL+000000PP)")
  Th2HandbookHelp_L("@@@        AND     80H             ;Use only MSB")
  Th2HandbookHelp_L("@@@        JR      Z,GTSL1NOEXP")
  Th2HandbookHelp_L("@@@        OR      E               ;[A]=F00000PP")
  Th2HandbookHelp_L("@@@        LD      E,A             ;save primary slot number")
  Th2HandbookHelp_L("@@@        INC     HL              ;point to SLTTBL entry")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ;get current expansion slot register")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        AND     11B             ;[A] = 000000SS")
  Th2HandbookHelp_L("@@@        RLCA")
  Th2HandbookHelp_L("@@@        RLCA                    ;[A] = 0000SS00")
  Th2HandbookHelp_L("@@@        OR      E               ;[A] = F000SSPP")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@GTSL1END:")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        POP     HL")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@GTSL1NOEXP:")
  Th2HandbookHelp_L("@@@        LD      A,E             ;[A] = 000000PP")
  Th2HandbookHelp_L("@@@        JR      GTSL1END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       ASLW1   Get address of slot work")
  Th2HandbookHelp_L("@@@;       Entry   None")
  Th2HandbookHelp_L("@@@;       Return  HL      address of slot work")
  Th2HandbookHelp_L("@@@;       Modify  None")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  ASLW10")
  Th2HandbookHelp_L("@@@ASLW10:")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        PUSH    AF")
  Th2HandbookHelp_L("@@@        CALL    GETSL10         ;[A] = F000SSPP, SS = 00 if not expanded")
  Th2HandbookHelp_L("@@@        AND     00001111B       ;[A] = 0000SSPP")
  Th2HandbookHelp_L("@@@        LD      L,A             ;[A] = 0000SSPP")
  Th2HandbookHelp_L("@@@        RLCA")
  Th2HandbookHelp_L("@@@        RLCA")
  Th2HandbookHelp_L("@@@        RLCA")
  Th2HandbookHelp_L("@@@        RLCA                    ;[A] = SSPP0000")
  Th2HandbookHelp_L("@@@        AND     00110000B       ;[A] = 00PP0000")
  Th2HandbookHelp_L("@@@        OR      L               ;[A] = 00PPSSPP")
  Th2HandbookHelp_L("@@@        AND     00111100B       ;[A] = 00PPSS00")
  Th2HandbookHelp_L("@@@        OR      01B             ;[A] = 00PPSSBB")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       Now, we have the sequence number for this cartridge")
  Th2HandbookHelp_L("@@@;       as follows.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       00PPSSBB")
  Th2HandbookHelp_L("@@@;         ||||||")
  Th2HandbookHelp_L("@@@;         ||||++-- higher 2 bits of memory address (1)")
  Th2HandbookHelp_L("@@@;         ||++---- seconday slot # (0..3)")
  Th2HandbookHelp_L("@@@;         ++------ primary slot # (0..3)")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        RLCA                    ;*=2")
  Th2HandbookHelp_L("@@@        LD      E,A")
  Th2HandbookHelp_L("@@@        LD      D,0             ;[DE] = 0PPSSBB0")
  Th2HandbookHelp_L("@@@        LD      HL,SLTWRK")
  Th2HandbookHelp_L("@@@        ADD     HL,DE")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       RSLW1   Read slot work")
  Th2HandbookHelp_L("@@@;       Entry   None")
  Th2HandbookHelp_L("@@@;       Return  HL      Content of slot work")
  Th2HandbookHelp_L("@@@;       Modify  None")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  RSLW10")
  Th2HandbookHelp_L("@@@RSLW10:")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        CALL    ASLW10          ;[HL] = address of slot work")
  Th2HandbookHelp_L("@@@        LD      E,(HL)")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      D,(HL)          ;[DE] = (slot work)")
  Th2HandbookHelp_L("@@@        EX      DE,HL           ;[HL] = (slot work)")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       WSLW1   Write slot work")
  Th2HandbookHelp_L("@@@;       Entry   HL      Data to write")
  Th2HandbookHelp_L("@@@;       Return  None")
  Th2HandbookHelp_L("@@@;       Modify  None")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  WSLW10")
  Th2HandbookHelp_L("@@@WSLW10:")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        EX      DE,HL           ;[DE] = data to write")
  Th2HandbookHelp_L("@@@        CALL    ASLW10          ;[HL] = address of slot work")
  Th2HandbookHelp_L("@@@        LD      (HL),E")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      (HL),D")
  Th2HandbookHelp_L("@@@        EX      DE,HL           ;[HL] = data tow write")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@; How to allocate work area for cartridges")
  Th2HandbookHelp_L("@@@; If the work area is greater than 2 bytes, make the SLTWRK point")
  Th2HandbookHelp_L("@@@; to the system variable BOTTOM (0FC48H), then update it by the")
  Th2HandbookHelp_L("@@@; amount of memory required. BOTTOM is set up by the initizalization")
  Th2HandbookHelp_L("@@@; code to point to the bottom of equipped RAM.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;          Ex, if the program is at 4000H..7FFFH.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       WORKB   allocate work area from BOTTOM")
  Th2HandbookHelp_L("@@@;               (my slot work) <- (old BOTTOM)")
  Th2HandbookHelp_L("@@@;       Entry   HL      required memory size")
  Th2HandbookHelp_L("@@@;       Return  HL      start address of my work area = old BOTTOM")
  Th2HandbookHelp_L("@@@;                       0 if cannot allocate")
  Th2HandbookHelp_L("@@@;       Modify  None")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  WORKB0")
  Th2HandbookHelp_L("@@@WORKB0:")
  Th2HandbookHelp_L("@@@        PUSH    DE")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        PUSH    AF")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EX      DE,HL           ;[DE] = Size")
  Th2HandbookHelp_L("@@@        LD      HL,(BOTTOM)     ;Get current RAM bottom")
  Th2HandbookHelp_L("@@@        CALL    WSLW10          ;Save BOTTOM to slot work")
  Th2HandbookHelp_L("@@@        PUSH    HL              ;Save old BOTTOM")
  Th2HandbookHelp_L("@@@        ADD     HL,DE           ;[HL] = (BOTTOM) + SIZE")
  Th2HandbookHelp_L("@@@        LD      A,H             ;Beyond 0DFFFH?")
  Th2HandbookHelp_L("@@@        CP      0E0H")
  Th2HandbookHelp_L("@@@        JR      NC,NOROOM       ;Yes, cannot allocate this much")
  Th2HandbookHelp_L("@@@        LD      (BOTTOM),HL     ;Updtae (BOTTOM)")
  Th2HandbookHelp_L("@@@        POP     HL              ;[HL] = old BOTTOM")
  Th2HandbookHelp_L("@@@WORKBEND:")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        POP     DE")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@;       BOTTOM became greater than 0DFFFH, there is")
  Th2HandbookHelp_L("@@@;       no RAM to be allocated.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@NOROOM:")
  Th2HandbookHelp_L("@@@        LD      HL,0")
  Th2HandbookHelp_L("@@@        CALL    WSLW10          ;Clear slot work")
  Th2HandbookHelp_L("@@@        JR      WORKBEND        ;Return 0 in [HL]")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.13  Example of allocating the work area_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_list-513-example-of-allocating-the-work-area_", 751)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The area called " + Chr(34) + "hook" + Chr(34) + " is used for expanding BASIC functions in FD9AH to FFC9H of the work area used by MSX-BASIC. One hook has five bytes, which are normally " + Chr(34) + "RET" + Chr(34) + ".")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When MSX-BASIC does a certain operation (such as the one in the description about the hook of the work area), it calls this hook from there once. When the hook is " + Chr(34) + "RET" + Chr(34) + ", the control returns immediately; but the function of BASIC can be expanded, when these five bytes were re-written to do the inter-slot call to the program inside the cartridge by the initialization routine (INIT) (see [[[Figure 5.53|||Chapter5b#figure-553--setting-the-hook]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[List 5.14|||Chapter5b#list-514--using-the-hook]]] shows an example of the program that the cartridge uses to hook H.KEYI for the timer interrupt ptocess.")
  Th2HandbookHelp_Commit("Hook", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#hook", 752)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@BASIC internal routine     HOOK -----------------")
  Th2HandbookHelp_L("@@@          .             +-----> |      RET      |")
  Th2HandbookHelp_L("@@@          .             |  +--- |---------------|")
  Th2HandbookHelp_L("@@@          .             |  |    |      RET      |")
  Th2HandbookHelp_L("@@@      CALL HOOK   ------+  |    |---------------|")
  Th2HandbookHelp_L("@@@          .       <--------+    |      RET      |")
  Th2HandbookHelp_L("@@@          .                     |---------------|")
  Th2HandbookHelp_L("@@@          .                     |      RET      |")
  Th2HandbookHelp_L("@@@                                |---------------|")
  Th2HandbookHelp_L("@@@                                |      RET      |")
  Th2HandbookHelp_L("@@@                                -----------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@                                        |")
  Th2HandbookHelp_L("@@@                                        V")
  Th2HandbookHelp_L("@@@                                                  Interslot call")
  Th2HandbookHelp_L("@@@BASIC internal routine     HOOK ----------------- -----> .")
  Th2HandbookHelp_L("@@@          .             +-----> |    RST 30H    |        .")
  Th2HandbookHelp_L("@@@          .             |       |---------------|        .")
  Th2HandbookHelp_L("@@@          .             |       |  Slot number  |  Expanded process")
  Th2HandbookHelp_L("@@@      CALL HOOK   ------+       |---------------|        .")
  Th2HandbookHelp_L("@@@          .       <-----+       |    Branch     |        .")
  Th2HandbookHelp_L("@@@          .             |       |-   address   -|        .")
  Th2HandbookHelp_L("@@@          .             |       |               |        .")
  Th2HandbookHelp_L("@@@                        |       |---------------|        .")
  Th2HandbookHelp_L("@@@                        +------ |      RET      | <---- RET")
  Th2HandbookHelp_L("@@@                                -----------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.53  Setting the hook_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_figure-553-setting-the-hook_", 753)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;  List 5.14  Sample program to use HOOK")
  Th2HandbookHelp_L("@@@;********************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@; Start-up initialize entry")
  Th2HandbookHelp_L("@@@; This program will be called when system initializing.")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@H.KEYI  EQU     0FD9AH          ; interrupt hook")
  Th2HandbookHelp_L("@@@EXPTBL  EQU     0FCC1H          ; slots expanded or not")
  Th2HandbookHelp_L("@@@PSLTRG  EQU     0A8H            ; I/O port address of primary slot register")
  Th2HandbookHelp_L("@@@EXT     MYINT")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INIT:")
  Th2HandbookHelp_L("@@@;       <<< Please insert other initialization routine here, if you need. >>>")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@; Set interrupt entry")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        DI                      ; start of critical region")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@; Get old interrupt entry inter-slot call hook")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      DE,OLDINT       ; get address of old int. hook saved area")
  Th2HandbookHelp_L("@@@        LD      HL,H.KEYI       ; get address of interrupt entry hook")
  Th2HandbookHelp_L("@@@        LD      BC,5            ; lenght of hook is 5 bytes")
  Th2HandbookHelp_L("@@@        LDIR                    ; transfer")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@; Which slot address is this cartridge placed?")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        CALL    GETMSLT         ; get my slot address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@; Set new inter-slot call of interrupt entry")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      (H.KEYI+1),A    ; set slot address")
  Th2HandbookHelp_L("@@@        LD      A,0F7H          ; 'RST 30H' inter-slot call operation code")
  Th2HandbookHelp_L("@@@        LD      (H.KEYI),A      ; set new hook op-code")
  Th2HandbookHelp_L("@@@        LD      HL,INTENT       ; get our interrupt entry point")
  Th2HandbookHelp_L("@@@        LD      (H.KEYI+2),HL   ; set new interrupt entry point")
  Th2HandbookHelp_L("@@@        LD      A,0C9H          ; 'RET' operation code")
  Th2HandbookHelp_L("@@@        LD      (H.KEYI+4),A    ; set operation code of 'RET'")
  Th2HandbookHelp_L("@@@        EI                      ; end of critical region")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;--------------------------------------------------------")
  Th2HandbookHelp_L("@@@; Which slot address is the cartridge placed?")
  Th2HandbookHelp_L("@@@;  Entry: No")
  Th2HandbookHelp_L("@@@;  Action: Compute my slot address")
  Th2HandbookHelp_L("@@@;  Return: A = slot address")
  Th2HandbookHelp_L("@@@;  Modify: Flag")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GTMSLT:")
  Th2HandbookHelp_L("@@@        PUSH    BC              ; save environment")
  Th2HandbookHelp_L("@@@        PUSH    HL")
  Th2HandbookHelp_L("@@@        IN      A,(PSLTRG)      ; read primary slot register")
  Th2HandbookHelp_L("@@@        RRCA                    ; move it to bit 0,1 of A")
  Th2HandbookHelp_L("@@@        RRCA")
  Th2HandbookHelp_L("@@@        AND     00000011B       ; get bit 1,0")
  Th2HandbookHelp_L("@@@        LD      C,A             ; set primary slot No.")
  Th2HandbookHelp_L("@@@        LD      B,0")
  Th2HandbookHelp_L("@@@        LD      HL,EXPTBL       ; see if the slot is expanded or not")
  Th2HandbookHelp_L("@@@        ADD     HL,BC")
  Th2HandbookHelp_L("@@@        OR      (HL)            ; set MSB if so")
  Th2HandbookHelp_L("@@@        LD      C,A")
  Th2HandbookHelp_L("@@@        INC     HL              ; point to SLTTBL entry")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        INC     HL")
  Th2HandbookHelp_L("@@@        LD      A,(HL)          ; get what is currently output to")
  Th2HandbookHelp_L("@@@                                ; expansion slot register")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        AND     00001100B       ; get bits 3,2")
  Th2HandbookHelp_L("@@@        OR      C               ; finally form slot address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        POP     HL              ; restore environment")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET                     ; return to main")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- Interrupt entry -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@INTENT:")
  Th2HandbookHelp_L("@@@        CALL    MYINT           ; call interrupt handler")
  Th2HandbookHelp_L("@@@        JP      OLDINT          ; go to old interrupt handler")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- HOOK save area -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@OLDINT: DS      5")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 5.14  Using the hook_", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#_list-514-using-the-hook_", 754)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When MSX has an internal disk, sometimes the disk interface ROM does the initialisation before the cartridge does, depending on the slot location, and pushes down the stack pointer in the direction of the low order address to allocate the work area. In this case, software not using the disk should set the stack pointer again after the cartridge received control; otherwise, the stack area might be exhausted and a system crash might occur. Remember to initialise the stack pointer at the beginning of the program.")
  Th2HandbookHelp_Commit("Stack pointer initialisation", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#stack-pointer-initialisation", 755)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("When general software in the market is put in the expansion slot or when RAM resides in the expansion slot, sometimes the application program do not work. Since most MSX2 machines use the expansion slot inside, problems may sometime result. Software to be sold in the market should be thoroughly tested in both cases that it is put in the expansion slot and that RAM resides in expansion slot.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Since the expansion slot register is placed in FFFFH, do not use it as if it were RAM. For example, setting the stack in FFFFH using " + Chr(34) + "LD SP, 0" + Chr(34) + " in the program causes machines using the expansion slot to go out of control.")
  Th2HandbookHelp_Commit("Testing the performance of the expansion slot", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#testing-the-performance-of-the-expansion-slot", 756)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Executing the inter-slot call in CALSLT and CALLF destroys the contents of IX, IY, and the background processing register. When returning from this routine, in MSX1 the interrupt is inhibited, but in MSX2 the state before the call is restored.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When using CALSLT or CALLF to execute the inter-slot call, the interrupt is always inhibited when calling the object program (see 2 in the figure below) and when returning to the calling program (see 6 below).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@  Caller                Interslot call            Called")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@LD IY,SLOT                            (3)")
  Th2HandbookHelp_L("@@@                              +-----------------> CALLME:")
  Th2HandbookHelp_L("@@@LD IX,CALLME                  |                    .")
  Th2HandbookHelp_L("@@@                   (1)        |(2)                 .")
  Th2HandbookHelp_L("@@@CALL CALSLT ------------------+                    .")
  Th2HandbookHelp_L("@@@                                      (4)          .")
  Th2HandbookHelp_L("@@@                              +------------------ RET")
  Th2HandbookHelp_L("@@@                   (6)        |(5)")
  Th2HandbookHelp_L("@@@            <-----------------+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("In MSX2, the state of the interrupt is reserved before and after the inter-slot call. That is, 3 in the figure is in the same state as 1, and 6 is in the same state as 4. Note when the called program executes " + Chr(34) + "EI" + Chr(34) + " or " + Chr(34) + "DI" + Chr(34) + ".")
  Th2HandbookHelp_Commit("Notes on CALSLT use", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#notes-on-calslt-use", 757)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("- In description of [[[SUBROM|||Chapter5b#subrom-015chmain---call-specified-address-in-sub-rom]]] routine, comment " + Chr(34) + "see page 352" + Chr(34) + " has been changed to " + Chr(34) + "see appendix 2..." + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In description of SLTATR and SLTWRK [[[work areas|||Chapter5b#723-work-area-to-obtain-the-slot-status]]], expressions for calculate the concrete work area for a given slot and page have been added.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In the first line after beginning of [[[section 7.2.3|||Chapter5b#723-work-area-to-obtain-the-slot-status]]], " + Chr(34) + "The following routines..." + Chr(34) + " has been corrected to " + Chr(34) + "The following addresses..." + Chr(34))
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("- In [[[Figure 5.52|||Chapter5b#figure-552--allocating-the-work-area]]], indication of F380H address was placed in the middle of the user's area. It has been moved to the beginning of system work.")
  Th2HandbookHelp_Commit("Changes from the original", "Chapter 5: Access to peripherals through BIOS (7)")
  Th2HandbookHelp_AddAnchor("Chapter5b#changes-from-the-original", 758)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("This chapter lists the 126 BIOS entries available to the user.")
  Th2HandbookHelp_Commit("APPENDIX 1 - BIOS LISTING", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#appendix-1---bios-listing", 759)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("[[[RSTs|||Appendix1#rsts]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[I/O initialisation|||Appendix1#io-initialisation]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[VDP access|||Appendix1#vdp-access]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[PSG|||Appendix1#psg]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Keyboard, CRT, printer input-output|||Appendix1#keyboard-crt-printer-input-output]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Game I/O access|||Appendix1#game-io-access]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Cassette input-output routine|||Appendix1#cassette-input-output-routine]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Miscellaneous|||Appendix1#miscellaneous]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Entries appended for MSX2|||Appendix1#entries-appended-for-msx2]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[SUB-ROM|||Appendix1#sub-rom]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("[[[Changes from the original|||Appendix1#changes-from-the-original]]]")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("There are two kinds of BIOS routines, the ones in MAIN-ROM and the ones in SUB-ROM. They each have different calling sequences which will be described later. The following is the entry notation.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("**Label name (address)**    \*n*")
  Th2HandbookHelp_L("* **Function**: descriptions and notes about the function")
  Th2HandbookHelp_L("* **Input**: parameters used by call")
  Th2HandbookHelp_L("* **Output**: parameters returned by call")
  Th2HandbookHelp_L("* **Registers**: registers which will be used (original contentes are lost)")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("The value of **\*n** has the following meanings.")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **\*1**: same as MSX1")
  Th2HandbookHelp_L("* **\*2**: call SUB-ROM internally in screen modes 5 to 8")
  Th2HandbookHelp_L("* **\*3**: always call SUB-ROM")
  Th2HandbookHelp_L("* **\*4**: do not call SUB-ROM while screen modes 4 to 8 are changed")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("Routines without **\*n** are appended for MSX2.")
  Th2HandbookHelp_Commit("Index", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#index", 760)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("To call routines in MAIN-ROM, the CALL or RTS instruction is used as an ordinary subroutine call.")
  Th2HandbookHelp_Commit("MAIN-ROM", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#main-rom", 761)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Among the following RSTs, RST 00H to RST 28H are used by the BASIC interpreter. RST 30H is used for inter-slot calls and RST 38H is used for hardware interrupts.")
  Th2HandbookHelp_Commit("RSTs", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rsts", 762)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: tests RAM and sets RAM slot for the system")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHKRAM (0000H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chkram-0000h-1", 763)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: tests whether the character of [HL] is the specified character. If not, it generates SYNTAX ERROR, otherwise it goes to [[[CHRGTR|||Appendix1#chrgtr-0010h-1]]] (0010H).")
  Th2HandbookHelp_L("* **Input**: set the character to be tested in [HL] and the character to be compared next to RST instruction which calls this routine (inline parameter).")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Example:        LD      HL,LETTER")
  Th2HandbookHelp_L("@@@                RST     08H")
  Th2HandbookHelp_L("@@@                DB      " + Chr(34) + "A" + Chr(34))
  Th2HandbookHelp_L("@@@                         .")
  Th2HandbookHelp_L("@@@                         .")
  Th2HandbookHelp_L("@@@                         .")
  Th2HandbookHelp_L("@@@        LETTER: DB      " + Chr(34) + "B" + Chr(34))
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Output**: HL is increased by one and A receives [HL]. When the tested character is numerical, the CY flag is set; the end of the statement (00H or 3AH) causes the Z flag to be set.")
  Th2HandbookHelp_L("* **Registers**: AF, HL")
  Th2HandbookHelp_Commit("SYNCHR (0008H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#synchr-0008h-1", 764)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: selects the slot corresponding to the value of A and reads one byte from the memory of the slot. When this routine is called, the interrupt is inhibited and remains inhibited even after execution ends.")
  Th2HandbookHelp_L("* **Input**: A for the slot number (see format below), HL for the address of memory to be read")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ F000EEPP")
  Th2HandbookHelp_L("@@@ -   ----")
  Th2HandbookHelp_L("@@@ |   ||++-------------- Basic slot number (0 to 3)")
  Th2HandbookHelp_L("@@@ |   ++---------------- Expansion slot number (0 to 3)")
  Th2HandbookHelp_L("@@@ +--------------------- " + Chr(34) + "1" + Chr(34) + " when using expansion slot")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Output**: the value of memory which has been read in A")
  Th2HandbookHelp_L("* **Registers**: AF, BC, DE")
  Th2HandbookHelp_Commit("RDSLT (000CH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rdslt-000ch-1", 765)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: gets a character (or a token) from BASIC text")
  Th2HandbookHelp_L("* **Input**: [HL] for the character to be read")
  Th2HandbookHelp_L("* **Output**: HL is incremented by one and A receives [HL]. When the character is numerical, the CY flag is set; the end of the statement causes the Z flag to be set.")
  Th2HandbookHelp_L("* **Registers**: AF, HL")
  Th2HandbookHelp_Commit("CHRGTR (0010H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chrgtr-0010h-1", 766)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: selects the slot corresponding to the value of A and writes one byte to the memory of the slot. When this routine is called, interrupts are inhibited and remain so even after execution ends.")
  Th2HandbookHelp_L("* **Input**: specifies a slot with A (same as [[[RDSLT|||Appendix1#rdslt-000ch-1]]])")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC, D")
  Th2HandbookHelp_Commit("WRSLT (0014H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrslt-0014h-1", 767)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sends the value to current device")
  Th2HandbookHelp_L("* **Input**: A for the value to be sent")
  Th2HandbookHelp_L("  * sends output to the printer when PTRFLG (F416H) is other than 0")
  Th2HandbookHelp_L("  * sends output to the file specified by PTRFIL (F864H) when PTRFIL is other than 0")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("OUTDO (0018H) *2", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#outdo-0018h-2", 768)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: calls the routine in another slot (inter-slot call)")
  Th2HandbookHelp_L("* **Input**: specify the slot in the 8 high order buts of the IY register (same as [[[RDSLT|||Appendix1#rdslt-000ch-1]]]). IX is for the address to be called.")
  Th2HandbookHelp_L("* **Output**: depends on the calling routine")
  Th2HandbookHelp_L("* **Registers**: depends on the calling routine")
  Th2HandbookHelp_Commit("CALSLT (001CH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#calslt-001ch-1", 769)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: compares the contents of HL and DE")
  Th2HandbookHelp_L("* **Input**: HL, DE")
  Th2HandbookHelp_L("* **Output**: sets the Z flag for HL = DE, CY flag for HL < DE")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("DCOMPR (0020H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#dcompr-0020h-1", 770)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: selects the slot corresponding to the value of A and enables the slot to be used. When this routine is called, interrupts are inhibited and remain so even after execution ends.")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * specify the slot by A (same as [[[RDSLT|||Appendix1#rdslt-000ch-1]]]) ")
  Th2HandbookHelp_L("  * specify the page to switch the slot by 2 high order bits of HL")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("ENASLT (0024H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#enaslt-0024h-1", 771)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: returns the type of DAC (decimal accumulator)")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: S, Z, P/V flags are changed depending on the type of DAC:")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@integer type                    single precision real type")
  Th2HandbookHelp_L("@@@   C = 1                                C = 1")
  Th2HandbookHelp_L("@@@   S = 1 *                              S = 0")
  Th2HandbookHelp_L("@@@   Z = 0                                Z = 0")
  Th2HandbookHelp_L("@@@   P/V = 1                              P/V = 0 *")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@string type                     double precision real type")
  Th2HandbookHelp_L("@@@   C = 1                                C = 0 *")
  Th2HandbookHelp_L("@@@   S = 0                                S = 0")
  Th2HandbookHelp_L("@@@   Z = 1 *                              Z = 0")
  Th2HandbookHelp_L("@@@   P/V = 1                              P/V = 1")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@Types can be recognised by the flag marked by " + Chr(34) + "*" + Chr(34) + ".")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("GETYPR (0028H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#getypr-0028h-1", 772)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: calls the routine in another slot. The following is the calling sequence:")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        RST     30H")
  Th2HandbookHelp_L("@@@        DB      n       ;n is the slot number (same as RDSLT)")
  Th2HandbookHelp_L("@@@        DW      nn      ;nn is the called address")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("* **Input**: In the method described above")
  Th2HandbookHelp_L("* **Output**: depends on the calling routine")
  Th2HandbookHelp_L("* **Registers**: AF, and other registers depending on the calling routine")
  Th2HandbookHelp_Commit("CALLF (0030H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#callf-0030h-1", 773)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: executes the timer interrupt process routine")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("KEYINT (0038H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#keyint-0038h-1", 774)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the device")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INITIO (003BH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#initio-003bh-1", 775)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the contents of function keys")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INIFNK (003EH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#inifnk-003eh-1", 776)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: inhibits the screen display")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC")
  Th2HandbookHelp_Commit("DISSCR (0041H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#disscr-0041h-1", 777)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: displays the screen")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("ENASCR (0044H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#enascr-0044h-1", 778)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes data in the VDP register")
  Th2HandbookHelp_L("* **Input**: C for the register number, B for data; the register number is 0 to 23 and 32 to 46")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC")
  Th2HandbookHelp_Commit("WRTVDP (0047H) *2", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtvdp-0047h-2", 779)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the contents of VRAM. This is for TMS9918, so only the 14 low order bits of the VRAM address are valid. To use all bits, call [[[NRDVRM|||Appendix1#nrdvrm-0174h]]].")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address to be read")
  Th2HandbookHelp_L("* **Output**: A for the value which was read")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("RDVRM (004AH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#rdvrm-004ah-1", 780)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: writes data in VRAM. This is for TMS9918, so only the 14 low order bits of the VRAM address are valid. To use all bits, call [[[NWRVRM|||Appendix1#nwrvrm-0177h]]].")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address, A for data")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("WRTVRM (004DH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#wrtvrm-004dh-1", 781)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets VRAM address to VDP and enables it to be read. This is used to read data from the sequential VRAM area by using the address auto-increment function of VDP. This enables faster readout than using [[[RDVRM|||Appendix1#rdvrm-004ah-1]]] in a loop. This is for TMS9918, so only the 14 low order bits of VRAM address are valid. To use all bits, call [[[NSETRD|||Appendix1#nsetrd-016eh]]].")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("SETRD (0050H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setrd-0050h-1", 782)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sets VRAM address to VDP and enables it to be written. The purpose is the same as [[[SETRD|||Appendix1#setrd-0050h-1]]]. This is for TMS9918, so only the 14 low order bits of VRAM address are valid. To use all bits, call [[[NSETRD|||Appendix1#nsetrd-016eh]]].")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("SETWRT (0053H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#setwrt-0053h-1", 783)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: fills the specified VRAM area with the same data. This is for TMS9918, so only the 14 low order bits of the VRAM address are valid. To use all bits, see [[[BIGFIL|||Appendix1#bigfil-016bh]]].")
  Th2HandbookHelp_L("* **Input**: HL for VRAM address to begin writing, BC for the length of the area to be written, A for data.")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: AF, BC")
  Th2HandbookHelp_Commit("FILVRM (0056H) *4", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#filvrm-0056h-4", 784)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: block transfer from VRAM to memory")
  Th2HandbookHelp_L("* **Input**: HL for source address (VRAM), DE for destination address (memory), BC for the length. All bits of the VRAM address are valid.")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("LDIRMV (0059H) *4", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#ldirmv-0059h-4", 785)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: block transfer from memory to VRAM")
  Th2HandbookHelp_L("* **Input**: HL for source address (memory), DE for destination address (VRAM), BC for the length. All bits of the VRAM address are valid.")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("LDIRVM (005CH) *4", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#ldirvm-005ch-4", 786)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: changes the screen mode. The palette is not initialised. To initialise it, see [[[CHGMDP|||Appendix1#chgmdp-01b5h]]] in SUB-ROM.")
  Th2HandbookHelp_L("* **Input**: A for the screen mode (0 to 8)")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHGMOD (005FH) *3", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chgmod-005fh-3", 787)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: changes the screen colour")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * A for the mode ")
  Th2HandbookHelp_L("  * FORCLR (F3E9H) for foreground color ")
  Th2HandbookHelp_L("  * BAKCLR (F3EAH) for background color")
  Th2HandbookHelp_L("  * BDRCLR (F3EBH) for border colour")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CHGCLR (0062H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chgclr-0062h-1", 788)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: executes NMI (Non-Maskable Interrupt) handling routine")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("NMI (0066H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#nmi-0066h-1", 789)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises all sprites. The sprite pattern is cleared to null, the sprite number to the sprite plane number, the sprite colour to the foregtound colour. The vertical location of the sprite is set to 209 (mode 0 to 3) or 217 (mode 4 to 8).")
  Th2HandbookHelp_L("* **Input**: SCRMOD (FCAFH) for the screen mode")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("CLRSPR (0069H) *3", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#clrspr-0069h-3", 790)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to TEXT1 mode (40 x 24). In this routine, the palette is not initialised. To initialise the palette, call [[[INIPLT|||Appendix1#iniplt-0141h]]] in SUB-ROM after this call.")
  Th2HandbookHelp_L("* **Input**: ")
  Th2HandbookHelp_L("  * TXTNAM (F3B3H) for the pattern name table")
  Th2HandbookHelp_L("  * TXTCGP (F3B7H) for the pattern generator table ")
  Th2HandbookHelp_L("  * LINL40 (F3AEH) for the length of one line")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
  Th2HandbookHelp_Commit("INITXT (006CH) *3", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#initxt-006ch-3", 791)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to GRAPHIC1 mode (32x24). In this routine, the palette is not initialised.")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * T32NAM (F3BDH) for the pattern name table")
  Th2HandbookHelp_L("  * T32COL (F3BFH) for the colour table")
  Th2HandbookHelp_L("  * T32CGP (F3C1H) for the pattern generator table")
  Th2HandbookHelp_L("  * T32ATR (F3C3H) for the sprite attribute table")
  Th2HandbookHelp_L("  * T32PAT (F3C5H) for the sprite generator table")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
