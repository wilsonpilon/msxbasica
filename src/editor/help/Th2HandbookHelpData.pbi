  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 1 |                        Adjust X (-8 to +7)                        |")
  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
