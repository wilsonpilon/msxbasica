  Th2HandbookHelp_L("* **Input**: A for the character code to be displayed")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: none")
  Th2HandbookHelp_Commit("CHPUT (00A2H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#chput-00a2h-1", 809)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: sends one character to the printer")
  Th2HandbookHelp_L("* **Input**: A for the character code to be sent")
  Th2HandbookHelp_L("* **Output**: if failed, the CY flag is set")
  Th2HandbookHelp_L("* **Registers**: F")
  Th2HandbookHelp_Commit("LPTOUT (00A5H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#lptout-00a5h-1", 810)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: tests the printer status")
  Th2HandbookHelp_L("* **Input**: none")
  Th2HandbookHelp_L("* **Output**: ")
  Th2HandbookHelp_L("  * when A is 255 and the Z flag is reset, the printer is READY.")
  Th2HandbookHelp_L("  * when A is 0 and the Z flag is set, the printer is NOT READY.")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("LPTSTT (00A8H) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#lptstt-00a8h-1", 811)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: test for the graphic header and transforms the code")
  Th2HandbookHelp_L("* **Input**: A for the character code")
  Th2HandbookHelp_L("* **Output**:")
  Th2HandbookHelp_L("  * the CY flag is reset to not the graphic header ")
  Th2HandbookHelp_L("  * the CY flag and the Z flag are set to the transformed code is set in A ")
  Th2HandbookHelp_L("  * the CY flag is set and the CY flag is reset to the untransformed code is set in A")
  Th2HandbookHelp_L("* **Registers**: AF")
  Th2HandbookHelp_Commit("CNVCHR (00ABH) *1", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#cnvchr-00abh-1", 812)

