  Th2HandbookHelp_L("---  |  ---  |  ---")
  Th2HandbookHelp_L("`EOF (<filenumber>)`  |  Function  |  Checks if the file has ended and returns -1 if at the end of file.")
  Th2HandbookHelp_Commit("--- E ---", "Chapter 2: BASIC")
  Th2HandbookHelp_AddAnchor("Chapter2#e-1", 61)

  Th2HandbookHelp_Begin()
