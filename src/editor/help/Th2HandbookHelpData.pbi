  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 5 |                         WIDTH value (Hi)                          |")
  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 6 |                         Foreground color                          |")
  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 7 |                         Background color                          |")
  Th2HandbookHelp_L("@@@   |-------------------------------------------------------------------|")
