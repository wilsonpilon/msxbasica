  Th2HandbookHelp_Commit("GTPDL (00DEH) *2", "Appendix 1: BIOS listing")
  Th2HandbookHelp_AddAnchor("Appendix1#gtpdl-00deh-2", 827)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: reads the header block after turning the cassette motor ON.")
