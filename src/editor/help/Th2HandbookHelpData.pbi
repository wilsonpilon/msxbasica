  Th2HandbookHelp_AddAnchor("Appendix1#inigrp-0072h-3", 793)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("* **Function**: initialises the screen to MULTI colour mode. In this routine, the palette is not initialised.")
  Th2HandbookHelp_L("* **Input**:")
  Th2HandbookHelp_L("  * MLTNAM (F3D1H) for the pattern name table ")
  Th2HandbookHelp_L("  * MLTCOL (F3D3H) for the colour table")
  Th2HandbookHelp_L("  * MLTCGP (F3D5H) for the pattern generator table")
  Th2HandbookHelp_L("  * MLTATR (F3D7H) for the sprite attribute table ")
  Th2HandbookHelp_L("  * MLTPAT (F3D9H) for the sprite generator table")
  Th2HandbookHelp_L("* **Output**: none")
  Th2HandbookHelp_L("* **Registers**: all")
