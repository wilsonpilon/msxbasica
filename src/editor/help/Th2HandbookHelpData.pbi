  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> PSET register setup")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#36    | DX7| DX6| DX5| DX4| DX3| DX2| DX1| DX0|")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DX ---+")
  Th2HandbookHelp_L("@@@R#37    | 0  | 0  | 0  | 0  | 0  | 0  | 0  | DX8|       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@                                                        | origin")
  Th2HandbookHelp_L("@@@        -----------------------------------------       |")
  Th2HandbookHelp_L("@@@R#38    | DY7| DY6| DY5| DY4| DY3| DY2| DY1| DY0|       |")
  Th2HandbookHelp_L("@@@        |----+----+----+----+----+----+----+----| DY ---+")
  Th2HandbookHelp_L("@@@R#39    | 0  | 0  | 0  | 0  | 0  | 0  | DY9| DY8|")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@R#44    | 0  | 0  | 0  | 0  | CR3| CR2| CR1| CR0| CLR (GRAPHIC 4,6)     |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | 0  | 0  | 0  | 0  | 0  | 0  | CR1| CR0| CLR (GRAPHIC 5)       | colour code data")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@                                                                        |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                       |")
  Th2HandbookHelp_L("@@@        | CR7| CR6| CR5| CR4| CR3| CR2| CR1| CR0| CLR (GRAPHIC 7)       |")
  Th2HandbookHelp_L("@@@        -----------------------------------------                     --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#45    | 0  | -- | MXD| -- | -- | -- | -- | -- | ARG (Argument register)")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                     |")
  Th2HandbookHelp_L("@@@                     +-----------> memory selection")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@> PSET command execution")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@R#46    | 0  | 1  | 0  | 1  | L03| L02| L01| L00| CMR")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@                            |                   |")
  Th2HandbookHelp_L("@@@                            +-------------------+")
  Th2HandbookHelp_L("@@@                              Logical operation")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.100  Register settings of PSET command_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_figure-4100-register-settings-of-pset-command_", 550)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;  List 4.20   PSET sample")
  Th2HandbookHelp_L("@@@;                to use, set H, L, E, A as follows")
  Th2HandbookHelp_L("@@@;                pset (x:H, y:L), color:E, logi-OP:A")
  Th2HandbookHelp_L("@@@;****************************************************************")
  Th2HandbookHelp_L("@@@;")
  Th2HandbookHelp_L("@@@        PUBLIC  PSET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@RDVDP:  EQU     0006H")
  Th2HandbookHelp_L("@@@WRVDP:  EQU     0007H")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@;----- program start -----")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@PSET:   DI")
  Th2HandbookHelp_L("@@@        PUSH    AF")
  Th2HandbookHelp_L("@@@        CALL    WAIT.VDP")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        LD      A,36")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),H")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        OUT     (C),L")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      A,44")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,80H+17")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),E")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        LD      E,01010000B")
  Th2HandbookHelp_L("@@@        POP     AF")
  Th2HandbookHelp_L("@@@        OR      E")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        EI")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@GET.STATUS:")
  Th2HandbookHelp_L("@@@        PUSH    BC")
  Th2HandbookHelp_L("@@@        LD      BC,(WRVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      A,8FH")
  Th2HandbookHelp_L("@@@        OUT     (C),A")
  Th2HandbookHelp_L("@@@        LD      BC,(RDVDP)")
  Th2HandbookHelp_L("@@@        INC     C")
  Th2HandbookHelp_L("@@@        IN      A,(C)")
  Th2HandbookHelp_L("@@@        POP     BC")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@WAIT.VDP:")
  Th2HandbookHelp_L("@@@        LD      A,2")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        AND     1")
  Th2HandbookHelp_L("@@@        JP      NZ,WAIT.VDP")
  Th2HandbookHelp_L("@@@        XOR     A")
  Th2HandbookHelp_L("@@@        CALL    GET.STATUS")
  Th2HandbookHelp_L("@@@        RET")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        END")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_List 4.20  Example of PSET command execution_", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#_list-420-example-of-pset-command-execution_", 551)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("POINT reads the colour code in any coordinate of VRAM (see [[[Figure 4.101|||Chapter4b#figure-4101--actions-of-point-command]]]).")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("After setting the parameters as shown in [[[Figure 4.102|||Chapter4b#figure-4102--register-settings-of-point-command]]], writing 40H in R#46 causes the command to be executed. While the CE bit of S#2 is " + Chr(34) + "1" + Chr(34) + ", the command is being executed. After the command terminates, the colour code of the specified coordinate is set in S#7. [[[List 4.21|||Chapter4b#list-421--example-of-point-command-execution]]] shows an example of using POINT.")
  Th2HandbookHelp_Commit("6.5.12 POINT (reading a colour code)", "Chapter 4: VDP and display screen (6)")
  Th2HandbookHelp_AddAnchor("Chapter4b#6512-point-reading-a-colour-code", 552)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@              VRAM or expansion RAM")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|              (SX,SY)                            |")
  Th2HandbookHelp_L("@@@|                 x                               |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@|                                                 |")
  Th2HandbookHelp_L("@@@---------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MXD: memory selection                   0 = VRAM, 1 = expansion RAM")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@SX:  origin X-coordinate (0 to 511)")
  Th2HandbookHelp_L("@@@SY:  origin Y-coordinate (0 to 1023)")
