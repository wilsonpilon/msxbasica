  Th2HandbookHelp_L("  * FC6AH to FC6CH (3 * 1 byte): used in ON STOP GOSUB")
  Th2HandbookHelp_L("  * FC6DH to FC6FH (3 * 1 byte): used in ON SPRITE GOSUB")
  Th2HandbookHelp_L("  * FC70H to FC7EH (3 * 5 bytes): used in ON STRIG GOSUB")
  Th2HandbookHelp_L("  * FC7FH to FC81H (3 * 1 byte): used in ON INTERVAL GOSUB")
  Th2HandbookHelp_L("  * FC82H to FC99H: for expansion")
