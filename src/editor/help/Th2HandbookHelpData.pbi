  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 5.17  MSX International version key matrix_", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-517-msx-international-version-key-matrix_", 623)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@MSB                                                                    LSB")
  Th2HandbookHelp_L("@@@        7       6       5       4       3       2       1       0")
  Th2HandbookHelp_L("@@@    -----------------------------------------------------------------")
  Th2HandbookHelp_L("@@@ 0  |   7   |   6   |   5   |   4   |   3   |   2   |   1   |   0   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 1  |   ;   |   ]   |   [   |   \   |   =   |   -   |   9   |   8   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 2  |   B   |   A   | accent|   /   |   .   |   ,   |   `   |   '   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 3  |   J   |   I   |   H   |   G   |   F   |   E   |   D   |   C   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 4  |   R   |   Q   |   P   |   O   |   N   |   M   |   L   |   K   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 5  |   Z   |   Y   |   X   |   W   |   V   |   U   |   T   |   S   |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 6  |   F3  |   F2  |   F1  | CODE  | CAPS  | GRAPH | CTRL  | SHIFT |")
  Th2HandbookHelp_L("@@@    |-------+-------+-------+-------+-------+-------+-------+-------|")
  Th2HandbookHelp_L("@@@ 7  | RETURN| SELECT|   BS  | STOP  |  TAB  |  ESC  |   F5  |   F4  |")
