  Th2HandbookHelp_AddAnchor("Chapter5a#_figure-533-contents-of-block-2_", 695)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Block 3 has three functions, depending on the contents of the ID value (register #0). [[[Figure 5.34|||Chapter5a#figure-534--contents-of-block-3]]] shows the functions.")
  Th2HandbookHelp_Commit("Contents of block 3", "Chapter 5: Access to peripherals through BIOS (1-6)")
  Th2HandbookHelp_AddAnchor("Chapter5a#contents-of-block-3", 696)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ID=0: displays the title (within 6 characters) on the initial screen")
  Th2HandbookHelp_L("@@@   ------------------------------------------------------")
  Th2HandbookHelp_L("@@@ 0 |  0                                                 |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------| --+")
  Th2HandbookHelp_L("@@@ 1 |  Lo 1 --+--- 1st character of the title            |   |")
  Th2HandbookHelp_L("@@@   |         |                                          |   |")
  Th2HandbookHelp_L("@@@ 2 |  Hi 1 --+                                          |   |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|   |")
  Th2HandbookHelp_L("@@@ . |       .                                            |   |")
  Th2HandbookHelp_L("@@@ . |       .                                            |   | 6 characters")
  Th2HandbookHelp_L("@@@ . |       .                                            |   |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|   |")
  Th2HandbookHelp_L("@@@11 |  Lo 6 --+--- 6th character of the title            |   |")
  Th2HandbookHelp_L("@@@   |         |                                          |   |")
  Th2HandbookHelp_L("@@@12 |  Hi 6 --+                                          |   |")
  Th2HandbookHelp_L("@@@   ------------------------------------------------------ --+")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ID=1: sets the password")
  Th2HandbookHelp_L("@@@   ------------------------------------------------------")
  Th2HandbookHelp_L("@@@ 0 |  1                                                 |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 1 |  Usage ID=1                                        |")
  Th2HandbookHelp_L("@@@   |                                                    |")
  Th2HandbookHelp_L("@@@ 2 |  Usage ID=2                                        |")
  Th2HandbookHelp_L("@@@   |                                                    |")
  Th2HandbookHelp_L("@@@ 3 |  Usage ID=3                                        |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 4 |  Password  --+                                     |")
  Th2HandbookHelp_L("@@@   |              |                                     |")
  Th2HandbookHelp_L("@@@ 5 |  Password    |   Password data is stored           |")
  Th2HandbookHelp_L("@@@   |              |-- compressed in 4bits x 4 bits      |")
  Th2HandbookHelp_L("@@@ 6 |  Password    |                                     |")
  Th2HandbookHelp_L("@@@   |              |                                     |")
  Th2HandbookHelp_L("@@@ 7 |  Password  --+                                     |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 8 |  Key cartridge flag                                |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|")
  Th2HandbookHelp_L("@@@ 9 |  Key cartridge value                               |")
  Th2HandbookHelp_L("@@@   |                                                    |")
  Th2HandbookHelp_L("@@@10 |  Key cartridge value                               |")
  Th2HandbookHelp_L("@@@   |                                                    |")
  Th2HandbookHelp_L("@@@11 |  Key cartridge value                               |")
  Th2HandbookHelp_L("@@@   |                                                    |")
  Th2HandbookHelp_L("@@@12 |  Key cartridge value                               |")
  Th2HandbookHelp_L("@@@   ------------------------------------------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@ID=2: sets the prompt on BASIC")
  Th2HandbookHelp_L("@@@   ------------------------------------------------------")
  Th2HandbookHelp_L("@@@ 0 |  2                                                 |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------| --+")
  Th2HandbookHelp_L("@@@ 1 |  Lo 1 --+--- 1st character of the prompt           |   |")
  Th2HandbookHelp_L("@@@   |         |                                          |   |")
  Th2HandbookHelp_L("@@@ 2 |  Hi 1 --+                                          |   |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|   |")
  Th2HandbookHelp_L("@@@ . |       .                                            |   |")
  Th2HandbookHelp_L("@@@ . |       .                                            |   | 6 characters")
  Th2HandbookHelp_L("@@@ . |       .                                            |   |")
  Th2HandbookHelp_L("@@@   |----------------------------------------------------|   |")
  Th2HandbookHelp_L("@@@11 |  Lo 6 --+--- 6th character of the prompt           |   |")
  Th2HandbookHelp_L("@@@   |         |                                          |   |")
  Th2HandbookHelp_L("@@@12 |  Hi 6 --+                                          |   |")
