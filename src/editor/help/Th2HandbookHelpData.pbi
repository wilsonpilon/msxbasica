  Th2HandbookHelp_L("@@@  * 37 (LOW02): Low width representing bit 0")
  Th2HandbookHelp_L("@@@  * 45 (HIGH02): High width representing bit 0")
  Th2HandbookHelp_L("@@@  * 14 (LOW12): Low width representing bit 1")
  Th2HandbookHelp_L("@@@  * 22 (HIGH12): High width representing bit 1")
  Th2HandbookHelp_L("@@@  * HEADLEN * 4/256: High bytes (HEDLEN = 2000) of header bits for short header")
  Th2HandbookHelp_Commit("CS120 (F3FCH, 5*2)", "Appendix 4: Work area listing")
  Th2HandbookHelp_AddAnchor("Appendix4#cs120-f3fch-52", 977)

