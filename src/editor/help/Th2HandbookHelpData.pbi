  Th2HandbookHelp_L("@@@                  |                   |")
  Th2HandbookHelp_L("@@@                  ---------------------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@        These two sprites do not conflict         These two sprites conflict")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@------  ------")
  Th2HandbookHelp_L("@@@| \\ |  | // | --> This pattern bit has one part")
  Th2HandbookHelp_L("@@@------  ------")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("")
  Th2HandbookHelp_L("When more than 5 sprites are placed on the same line, bit 6 of S#0 becomes " + Chr(34) + "1" + Chr(34) + " and the identifying number of the 5th sprite (the portion which cannot be displayed) is set in the 5 low order bits of S#0.")
  Th2HandbookHelp_Commit("_Figure 4.62  Conflict of sprites (sprite mode 1)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-462-conflict-of-sprites-sprite-mode-1_", 468)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@    MSB   7    6    5    4    3    2    1    0    LSB")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@S#0     | .  | X  | .  | X  | X  | X  | X  | X  |")
  Th2HandbookHelp_L("@@@        -----------------------------------------")
  Th2HandbookHelp_L("@@@               |       |                        |")
  Th2HandbookHelp_L("@@@               |       +------------------------+")
  Th2HandbookHelp_L("@@@               |   Identification number of fifth sprite on a single line")
  Th2HandbookHelp_L("@@@               |")
  Th2HandbookHelp_L("@@@               |    0: Normal")
  Th2HandbookHelp_L("@@@               +-->")
  Th2HandbookHelp_L("@@@                    1: More than 4 sprites are occupying a single line")
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_Commit("_Figure 4.63  Judging the conflict (sprite mode 1)_", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#_figure-463-judging-the-conflict-sprite-mode-1_", 469)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("Sprite mode 2 is the newly added mode for MSX-VIDEO. It is not compatible with TMS9918 and cannot be used with MSX1 machines.")
  Th2HandbookHelp_Commit("5.3 Sprite Mode 2", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#53-sprite-mode-2", 470)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("The number of sprites which can be displayed on one screen is also 32, but up to eight sprites can be displayed on a given horizontal line of the screen. The priorities are the same as in mode 1 with the lower numbers having highest priority.")
  Th2HandbookHelp_Commit("5.3.1 Number of sprites to be displayed", "Chapter 4: VDP and display screen (1-5)")
  Th2HandbookHelp_AddAnchor("Chapter4a#531-number-of-sprites-to-be-displayed", 471)

  Th2HandbookHelp_Begin()
  Th2HandbookHelp_L("@@@")
  Th2HandbookHelp_L("@@@----------------------------------------------------------------------------")
  Th2HandbookHelp_L("@@@|                                                                          |")
  Th2HandbookHelp_L("@@@|                                                                          |")
