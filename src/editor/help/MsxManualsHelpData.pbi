  ManualsHelp_L("<A.16 CALL INSTRUCTIONS                                         677")
  ManualsHelp_L("+------------+----------------------------+-------------+------------+-+-+")
  ManualsHelp_L("|MNEMONIC    | INSTRUCTION ACTION         | FLAGS       | OPCODE     | | |")
  ManualsHelp_L("|            |                            |             +--------+---+ | |")
  ManualsHelp_L("|            |                            |S Z H P/v N C|76543210|HEX|B|C|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret         |.pcl<-[.sp];.pch<-[.sp+1]   |• • • •   • •|11001001|C9 |1|3|")
  ManualsHelp_L("|            |.sp<-.sp+2                  |             |        |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret nz      |if z=0 ; .pcl<-[.sp]        |• • • •   • •|11000000|C0 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret z       |if z=1 ; .pcl<-[.sp]        |• • • •   • •|11001000|C8 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret nc      |if c=0 ; .pcl<-[.sp]        |• • • •   • •|11010000|D0 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret c       |if c=1 ; .pcl<-[.sp]        |• • • •   • •|11011000|D8 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret po      |if P/v=0 ; .pcl<-[.sp]      |• • • •   • •|11100000|E0 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret pe      |if P/v=1 ; .pcl<-[.sp]      |• • • •   • •|11101000|E8 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret p       |if s=0 ; .pcl<-[.sp]        |• • • •   • •|11110000|F0 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret m       |if s=1 ; .pcl<-[.sp]        |• • • •   • •|11111000|F8 |1|1|")
  ManualsHelp_L("|            |.pch<-.[.sp+1];.sp<-.sp+2   |             |        |   | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret i       |interrupt return            |• • • •   • •|11101101|ED |2|5|")
  ManualsHelp_L("|            |                            |             |01001101|4D | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ret n       |Non Maskable Interrupt      |• • • •   • •|11101101|ED |2|5|")
  ManualsHelp_L("|            |  return                    |             |01000101|45 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|brk k       |[.sp-2]<-.pcl;[.sp-1]<-.pch |• • • •   • •|11   111|C0 |1|4|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pcl<-k;pch<-0   |             |  k/8   |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
