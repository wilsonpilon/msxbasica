  ManualsHelp_L("  contents:	SUB-ROM slot address")
  ManualsHelp_L("")
  ManualsHelp_L("CHRCNT (FAF9H, 1)")
  ManualsHelp_L("  contents:	character counter in the buffer; used in Roman-kana")
  ManualsHelp_L("		translation (value is 0 <=n <=2)")
  ManualsHelp_L("")
  ManualsHelp_L("ROMA (FAFAH, 2)")
  ManualsHelp_L("  contents:	area to store character in the buffer; used in Roman-kana")
  ManualsHelp_L("		translation (Japan version only)")
  ManualsHelp_L("")
  ManualsHelp_L("MODE (FAFCH, 1)")
  ManualsHelp_L("  contents:	mode switch for VRAM size")
  ManualsHelp_L("")
  ManualsHelp_L("		(0000WVV0)")
  ManualsHelp_L("		     ---")
  ManualsHelp_L("		     |||")
  ManualsHelp_L("		     |++--- 00 = 16K VRAM")
  ManualsHelp_L("		     |	    01 = 64K VRAM")
  ManualsHelp_L("		     |	    11 = 128K VRAM")
  ManualsHelp_L("		     |")
  ManualsHelp_L("		     +----- 1 = mask, 0 = no mask")
  ManualsHelp_L("			    Flags whether to specify VRAM address")
  ManualsHelp_L("			    ANDed with 3FFFH in SCREEN 0 to 3;")
  ManualsHelp_L("			    in SCREEN 4 to 8, never masked")
  ManualsHelp_L("")
  ManualsHelp_L("NORUSE (FAFDH, 1)")
  ManualsHelp_L("  contents:	unused")
  ManualsHelp_L("")
  ManualsHelp_L("XSAVE (FAFEH, 2)")
  ManualsHelp_L("  contents:	[ I OOOOOOO XXXXXXXX ]")
  ManualsHelp_L("")
  ManualsHelp_L("YSAVE (FB00H, 2)")
  ManualsHelp_L("  contents:	[ x OOOOOOO YYYYYYYY ]")
  ManualsHelp_L("")
  ManualsHelp_L("		I = 1 lightpen interrupt request")
  ManualsHelp_L("		OOOOOOO = unsigned offset")
  ManualsHelp_L("		XXXXXXX = X-coordinate")
  ManualsHelp_L("		YYYYYYY = Y-coordinate")
  ManualsHelp_L("")
  ManualsHelp_L("LOGOPR (FB02H, 1)")
  ManualsHelp_L("	contents:	logical operation code")
  ManualsHelp_L("")
