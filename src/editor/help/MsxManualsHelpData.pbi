  ManualsHelp_L("|shl r       |C<-r{7}                     |+ + 0 P   0 +|11001011|CB |2|2|")
  ManualsHelp_L("|shla        |r<-r*2                      |             |00100 r |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shl [.hl]   |C<-[.hl]{7}                 |+ + 0 P   0 +|11001011|CB |2|5|")
  ManualsHelp_L("|shla        |[.hl]<-[.hl]*2              |             |00100110|26 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shl [,ix+d] |C<-[.ix+d]{7}               |+ + 0 P   0 +|11011101|DD |4|7|")
  ManualsHelp_L("|shla        |[.ix+d]<-[.ix+d]*2          |             |11001011|CB | | |")
  ManualsHelp_L("|            |                            |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |                            |             |00100110|26 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shl [,iy+d] |C<-[.iy+d]{7}               |+ + 0 P   0 +|11111101|DD |4|7|")
  ManualsHelp_L("|shla        |[.iy+d]<-[.iy+d]*2          |             |11001011|CB | | |")
  ManualsHelp_L("|            |                            |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |                            |             |00100110|26 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shr r       |C<-r{0}                     |+ + 0 P   0 +|11001011|CB |2|2|")
  ManualsHelp_L("|            |r<-r/2                      |             |00111 r |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shr [.hl]   |C<-[.hl]{0}                 |+ + 0 P   0 +|11001011|CB |2|5|")
  ManualsHelp_L("|            |[.hl]<-[.hl]/2              |             |00111110|3E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shr [,ix+d] |C<-[.ix+d]{0}               |+ + 0 P   0 +|11011101|DD |4|7|")
  ManualsHelp_L("|            |[.ix+d]<-[.ix+d]/2          |             |11001011|CB | | |")
  ManualsHelp_L("|            |                            |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |                            |             |00111110|3E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shr [,iy+d] |C<-[.iy+d]{0}               |+ + 0 P   0 +|11111101|DD |4|7|")
  ManualsHelp_L("|            |[.iy+d]<-[.iy+d]/2          |             |11001011|CB | | |")
  ManualsHelp_L("|            |                            |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |                            |             |00111110|3E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shra r      |tmp<-r{7};C<-r{0}           |+ + 0 P   0 +|11001011|CB |2|2|")
  ManualsHelp_L("|            |r<-r/2;r{7}<-tmp            |             |00101 r |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shra [.hl]  |tmp<-[.hl]{7};C<-[.hl]{0}   |+ + 0 P   0 +|11001011|CB |2|2|")
  ManualsHelp_L("|            |[.hl]<-[.hl]/2;[.hl]{7}<-tmp|             |00101110|2E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shra [.ix+d]|tmp<-[.ix+d]{7}             |+ + 0 P   0 +|11011101|DD |4|7|")
  ManualsHelp_L("|            |C<-[.ix+d]{0}               |             |11001011|CB | | |")
  ManualsHelp_L("|            |[.ix+d]<-[.ix+d]/2          |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |[.ix+d]{7}<-tmp             |             |00101110|2E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|shra [.iy+d]|tmp<-[.iy+d]{7}             |+ + 0 P   0 +|11111101|FD |4|7|")
  ManualsHelp_L("|            |C<-[.iy+d]{0}               |             |11001011|CB | | |")
  ManualsHelp_L("|            |[.iy+d]<-[.iy+d]/2          |             |<- d  ->|   | | |")
  ManualsHelp_L("|            |[.iy+d]{7}<-tmp             |             |00101110|2E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("The shl instruction and the shla instruction are exectly the same and use the ")
  ManualsHelp_L("same operand.")
  ManualsHelp_L("<A.15  BRANCH INSTRUCTIONS                                              675>")
