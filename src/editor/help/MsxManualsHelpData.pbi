  ManualsHelp_L("mouse, etc	 |				       |:::::::::::::::::::::")
  ManualsHelp_L("		 | PPI	 PSG			       |")
  ManualsHelp_L("		 |				       | Extended Cartridge")
  ManualsHelp_L("------------	 |	----------------	       | Slot x 4")
