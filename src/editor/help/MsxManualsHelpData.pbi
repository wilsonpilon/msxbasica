; Auto-gerado por convert_manuals.py (descartavel, nao versionado) a partir de
; help/MANUALS.CHM (RuMSX, Lex Lechz - lexlechz.at). Conteudo reproduzido como no
; original (Windows-1252 -> UTF-8, tags HTML removidas, layout/espacamento
; preservado) - boa parte foi digitada por Nestor Soriano (Konamiman, ja
; credenciado no README pelo Nestor80) a partir dos manuais tecnicos oficiais
; (MSX2 Technical Handbook/ASCII Corporation, MSX-DOS2, Turbo-Basic Compiler).

Structure ManualsHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList ManualsHelp_Topics.ManualsHelpTopic()
Global ManualsHelp_DataBuilt.b = #False
Global NewList ManualsHelp_Scratch.s() ; buffer de linhas do topico sendo montado

; Add() de uma string so (com o corpo inteiro chaveado em '+') estoura o limite
; de 'continuation lines' do pbcompiler pros documentos maiores (MsxDos2.htm
; sozinho passa de 3000 linhas) - Begin/L/Commit monta o corpo linha a linha,
; cada L() sendo sua propria instrucao (sem limite de encadeamento).
Procedure ManualsHelp_Begin()
  ClearList(ManualsHelp_Scratch())
EndProcedure

Procedure ManualsHelp_L(Line.s)
  AddElement(ManualsHelp_Scratch())
  ManualsHelp_Scratch() = Line
EndProcedure

Procedure ManualsHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach ManualsHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + ManualsHelp_Scratch()
    First = #False
  Next
  AddElement(ManualsHelp_Topics())
  ManualsHelp_Topics()\Titulo = Titulo
  ManualsHelp_Topics()\Grupo = Grupo
  ManualsHelp_Topics()\Corpo = Body
EndProcedure

Procedure ManualsHelp_BuildData()
  If ManualsHelp_DataBuilt
    ProcedureReturn
  EndIf
  ManualsHelp_DataBuilt = #True

  ManualsHelp_Begin()
  ManualsHelp_L("                  M S X -- D O S   v e r s i o n  2")
  ManualsHelp_L("                  =================================")
  ManualsHelp_L("")
  ManualsHelp_L("                  The advanced disk operating system")
  ManualsHelp_L("")
  ManualsHelp_L("                         for MSX 2 computers")
  ManualsHelp_L("")
  ManualsHelp_L("            CONTENTS                                   Page")
  ManualsHelp_L("")
  ManualsHelp_L("            1.   Introduction .........................   3")
  ManualsHelp_L("            2.   Editing command lines ................   3")
  ManualsHelp_L("            3.   Notation .............................   6")
  ManualsHelp_L("            4.   Description of Commands ..............  10")
  ManualsHelp_L("            5.   Redirection and Piping ...............  70")
  ManualsHelp_L("            6.   Batch files, AUTOEXEC and REBOOT .....  72")
  ManualsHelp_L("            7.   Environment Items ....................  75")
  ManualsHelp_L("            8.   Errors and Messages ..................  79")
  ManualsHelp_L("            9.   Command Summary ......................  94")
  ManualsHelp_L("           10.   DISK-BASIC 2.0 ....................... 100")
  ManualsHelp_L("")
  ManualsHelp_L("     This  manual  describes  the  user  interface  and commands  provided by ")
  ManualsHelp_L("MSX-DOS 2 version 2.20. ")
  ManualsHelp_L("")
  ManualsHelp_L("1.   INTRODUCTION")
  ManualsHelp_L("=================")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX-DOS 2,  like its  predecessor MSX-DOS  1, is provided in a cartridge ")
  ManualsHelp_L("and  in some  disk files.  The disk files are MSXDOS2.SYS, COMMAND2.COM, help ")
  ManualsHelp_L("files and transient commands.")
  ManualsHelp_L("")
  ManualsHelp_L("     MSXDOS2.SYS  has the ability to load and execute programs in an enhanced ")
  ManualsHelp_L("CP/M-compatible environment.  COMMAND2.COM is  a special  program which, when ")
  ManualsHelp_L("loaded  and executed,  provides the user with many sophisticated commands and ")
  ManualsHelp_L("features generally  compatible with and in many cases better than those found ")
  ManualsHelp_L("in MS-DOS and MSX-DOS 1, such as extended memory management.")
  ManualsHelp_L("")
  ManualsHelp_L("     It  also has the ability to load and execute specially written MSX-DOS 1 ")
  ManualsHelp_L("programs and  most standard  CP/M programs,  and can execute batch files with ")
  ManualsHelp_L("parameter substitution and other features similar to those found in MS-DOS.")
  ManualsHelp_L("")
  ManualsHelp_L("     An  APPEND  facility  is  provided  to  increase  the  ease  of  use  of ")
  ManualsHelp_L("directories with CP/M programs which were not written to handle them.")
  ManualsHelp_L("")
  ManualsHelp_L("     Throughout  the rest  of this  manual the  term MSX-DOS  is used to mean ")
  ManualsHelp_L("MSX-DOS version 2.xx unless otherwise stated.")
  ManualsHelp_L("")
  ManualsHelp_L("2. EDITING COMMAND LINES")
  ManualsHelp_L("========================")
  ManualsHelp_L("")
  ManualsHelp_L("     When typing  in a  command line to MSX-DOS, a simple editing facility is ")
  ManualsHelp_L("available  for  correction  of  mistakes  or the  re-entering and  editing of ")
  ManualsHelp_L("previous commands. ")
  ManualsHelp_L("")
  ManualsHelp_L("     Typing  ordinary  characters  at  the keyboard  cause the  characters to ")
  ManualsHelp_L("appear on  the screen  as would  be expected.  Typing most control characters ")
  ManualsHelp_L("cause  them to be represented by a '^' symbol followed by the control letter. ")
  ManualsHelp_L("Exceptions are  carriage return  (RET or  CTRL-M), back space (BS or CTRL-H), ")
  ManualsHelp_L("tab  (TAB or  CTRL-I), insert  (INS or  CTRL-R), escape (ESC or CTRL-[), home ")
  ManualsHelp_L("(HOME or  CTRL-K), CTRL-C,  CTRL-J, CTRL-N, CTRL-P, CTRL-S, CTRL-U and CTRL-X ")
  ManualsHelp_L("(SELECT). These perform the following functions:")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-C  - this  acts as a 'break' key. A more drastic and preferred ")
  ManualsHelp_L("                    'break' key is CTRL-STOP.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-J  - line  feed;  nothing  happens  if this  was given  in the ")
  ManualsHelp_L("                    command line.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-K  - home cursor (HOME).")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-N  - this  turns  the  printer  off after  being turned  on by ")
  ManualsHelp_L("                    CTRL-P.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-P  - this  turns  the  printer  on.  When  on, all  characters ")
  ManualsHelp_L("                    printed on the screen are also printed on the printer.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-S  - this suspends  all character  output until another key is ")
  ManualsHelp_L("                    pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-U  - this erases the line currently being entered.")
  ManualsHelp_L("")
  ManualsHelp_L("          CTRL-X  - this erases the line currently being entered (SELECT).")
  ManualsHelp_L("")
  ManualsHelp_L("     The line is entered when the 'enter' key is pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("     At any  point whilst typing in a command line, the backspace key (marked ")
  ManualsHelp_L("BS  or BACK  SPACE on  most MSX machines) can be used to delete the character ")
  ManualsHelp_L("immediately to the left of the cursor in the normal way.")
  ManualsHelp_L("")
  ManualsHelp_L("     The cursor left and right keys will move the cursor left and right along ")
  ManualsHelp_L("the  line.  Typing a  character at  this point  will overwrite  the character ")
  ManualsHelp_L("currently underneath the cursor.")
  ManualsHelp_L("")
  ManualsHelp_L("     Pressing the insert key (marked INS on most MSX machines) will toggle to ")
  ManualsHelp_L("'insert mode',  and the cursor will change to an underline cursor to indicate ")
  ManualsHelp_L("this.  Instead of the characters being typed overwriting the characters under ")
  ManualsHelp_L("the cursor,  they will  instead be  inserted before the cursor character, the ")
  ManualsHelp_L("remaining  characters to  the end of the line being moved one position to the ")
  ManualsHelp_L("right.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  delete  key  (marked  DEL  on  most MSX  machines) will  delete the ")
  ManualsHelp_L("character under  the cursor  and move  the remaining characters to the end of ")
  ManualsHelp_L("the line one position to the left.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  home key  (marked 'HOME' on most MSX machines) will move the cursor ")
  ManualsHelp_L("to the start of the line.")
  ManualsHelp_L("")
  ManualsHelp_L("     Pressing ESC, CTRL-U or CTRL-X will clear the line to allow a new one to ")
  ManualsHelp_L("be entered.")
  ManualsHelp_L("")
  ManualsHelp_L("     The command editor also keeps a list of previous commands entered, up to ")
  ManualsHelp_L("a  limit of  256 characters. Pressing the cursor up key will move up the list ")
  ManualsHelp_L("and display the previous command line entered, allowing this old command line ")
  ManualsHelp_L("to be edited and re-entered. Pressing the cursor down key will similarly move ")
  ManualsHelp_L("to the next old command line that was entered.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  previous command  line is changed, then it will be used as the new ")
  ManualsHelp_L("command line and added to the bottom of the list. If it was not changed, then ")
  ManualsHelp_L("it  will not  be added  to the  list and the current command line will be the ")
  ManualsHelp_L("next  one  which  was  originally entered.  This allows  a whole  sequence of ")
  ManualsHelp_L("previous commands to be entered easily.")
  ManualsHelp_L("")
  ManualsHelp_L("     The list of previous commands is in fact circular and moving off the top ")
  ManualsHelp_L("or  bottom will  move to  the last or first command in the list respectively. ")
  ManualsHelp_L("The previous  command can  be called  to be  re-entered or  edited from  this ")
  ManualsHelp_L("command history list.")
  ManualsHelp_L("")
  ManualsHelp_L("     The features  described here are in fact available to many programs that ")
  ManualsHelp_L("MSX-DOS can execute. In any program that does 'line inputs', each line can be ")
  ManualsHelp_L("edited as described above. Previous lines can be recalled for re-entering and ")
  ManualsHelp_L("editing,  although the list of previous lines will of course include previous ")
  ManualsHelp_L("commands.")
  ManualsHelp_L("")
  ManualsHelp_L("3. NOTATION")
  ManualsHelp_L("===========")
  ManualsHelp_L("")
  ManualsHelp_L("     The  syntax  of the  commands available  from MSX-DOS  are described  in ")
  ManualsHelp_L("chapter 4 using the following notation:")
  ManualsHelp_L("")
  ManualsHelp_L("Words in upper case")
  ManualsHelp_L("")
  ManualsHelp_L("     These are  keywords and must be entered as shown in any mixture of upper ")
  ManualsHelp_L("or lower case.")
  ManualsHelp_L("")
  ManualsHelp_L("Items in lower case")
  ManualsHelp_L("")
  ManualsHelp_L("     These are parameters which must be supplied to the command at this point ")
  ManualsHelp_L("in the command line.")
  ManualsHelp_L("")
  ManualsHelp_L("Items in square brackets ('[' and ']')")
  ManualsHelp_L("")
  ManualsHelp_L("     These are optional items. The brackets themselves should not be included ")
  ManualsHelp_L("in the command line.")
  ManualsHelp_L("")
  ManualsHelp_L("Items separated by a vertical bar ('|')")
  ManualsHelp_L("")
  ManualsHelp_L("     This  indicates that only one of the items is required. The vertical bar ")
  ManualsHelp_L("itself should not be included in the command line.")
  ManualsHelp_L("")
  ManualsHelp_L("     The following is a list of items which can appear on a command line:")
  ManualsHelp_L("")
  ManualsHelp_L("d:")
  ManualsHelp_L("")
  ManualsHelp_L("     This indicates that a drive name is required (A:, B: etc.).")
  ManualsHelp_L("")
  ManualsHelp_L("     If d:  is shown  as optional  and is  not specified,  then the currently ")
  ManualsHelp_L("logged-on drive, as indicated by the command prompt, is assumed.")
  ManualsHelp_L("")
  ManualsHelp_L("path")
  ManualsHelp_L("")
  ManualsHelp_L("     This indicates that a directory path is required, the syntax of which is ")
  ManualsHelp_L("similar to  MS-DOS. Each  directory in  the path  is separated by a backslash ")
  ManualsHelp_L("'\'.  A backslash  at the start of the path indicates that the path starts at ")
  ManualsHelp_L("the root  directory, otherwise  the path  starts at  the current directory as ")
  ManualsHelp_L("indicated  by the  CHDIR command.  Frequently a  filename follows  a path, in ")
  ManualsHelp_L("which case the two must be separated by a backslash.")
  ManualsHelp_L("")
  ManualsHelp_L("     Two consecutive  dots '..' signify the immediate parent directory in the ")
  ManualsHelp_L("path.  A  single  dot '.'  signifies the  current directory  in the  path and ")
  ManualsHelp_L("therefore usually has no value in a path specification.")
  ManualsHelp_L("")
  ManualsHelp_L("     On non-English MSX machines, the backslash character '\' may be replaced ")
  ManualsHelp_L("by  some other  character. In  particular, on  Japanese MSX  machines the Yen ")
  ManualsHelp_L("character is used.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  path is  shown as  optional and is not specified, then the current ")
  ManualsHelp_L("directory as indicated by the CHDIR command is assumed.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  syntax of the directory names that make up a path name follows that ")
  ManualsHelp_L("for filenames given below.")
  ManualsHelp_L("")
  ManualsHelp_L("filename")
  ManualsHelp_L("")
  ManualsHelp_L("     This  indicates that the name of a file is required, the syntax of which ")
  ManualsHelp_L("is  similar  to  MS-DOS  and MSX-DOS  1. An  ambiguous filename  is one  that ")
  ManualsHelp_L("contains '*'  and '?'  characters and  may match  more that one file on disk, ")
  ManualsHelp_L("whilst one that does not contain these is an unambiguous filename.")
  ManualsHelp_L("")
  ManualsHelp_L("     A filename has the following syntax:-")
  ManualsHelp_L("")
  ManualsHelp_L("          mainname[.suf]")
  ManualsHelp_L("")
  ManualsHelp_L("     where mainname is a sequence of up to 8 characters and suf is a sequence ")
  ManualsHelp_L("of  up to  3 characters  inclusive. Any  characters beyond  these fields  are ")
  ManualsHelp_L("ignored. A  '*' in the main name or suffix is equivalent to filling from that ")
  ManualsHelp_L("character  position to  the end of the field with '?'. If the suffix is given ")
  ManualsHelp_L("then it  must be separated from the main part of the filename by a single dot ")
  ManualsHelp_L("'.'.")
  ManualsHelp_L("")
  ManualsHelp_L("     The following characters cannot be used in filenames:-")
  ManualsHelp_L("")
  ManualsHelp_L("     Control codes and SPACE (in the range 0 to 20h, and 7FH and FFH)")
  ManualsHelp_L("")
  ManualsHelp_L("     : ; . , = + \ < > ( ) | / " + Chr(34) + " [ ]")
  ManualsHelp_L("")
  ManualsHelp_L("     All  characters  are  converted  to  upper  case  where appropriate  and ")
  ManualsHelp_L("therefore  lower and  upper case  characters have the same meaning. Note that ")
  ManualsHelp_L("extended two-character Japanese characters(SHIFT-JIS code) are allowed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a filename is shown as optional and is not specified, then a filename ")
  ManualsHelp_L("of *.* is assumed.")
  ManualsHelp_L("")
  ManualsHelp_L("filespec")
  ManualsHelp_L("")
  ManualsHelp_L("     This is  used to  identify a file or several files in the same directory ")
  ManualsHelp_L("on a disk. It's syntax is:-")
  ManualsHelp_L("")
  ManualsHelp_L("          [d:][path][filename]")
  ManualsHelp_L("")
  ManualsHelp_L("where at  least one  of the three optional items must be given. Where this is ")
  ManualsHelp_L("used  to specify  existing files, /H may be given to allow hidden files to be ")
  ManualsHelp_L("found.")
  ManualsHelp_L("")
  ManualsHelp_L("     Generally, d:  if not  given defaults  to the currently logged on drive, ")
  ManualsHelp_L("path  if  not  given  defaults  to the  current directory  of that  drive and ")
  ManualsHelp_L("filename if not given defaults to a filename of *.*.")
  ManualsHelp_L("")
  ManualsHelp_L("compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("     This  is used  in many  commands to  specify the files or directories to ")
  ManualsHelp_L("which the command is applied. It's syntax is:-")
  ManualsHelp_L("")
  ManualsHelp_L("          filespec [+ filespec [+ filespec ...]]")
  ManualsHelp_L("")
  ManualsHelp_L("     Thus  several  filespecs  (see  above) can  be given,  separated by  '+' ")
  ManualsHelp_L("symbols, with spaces etc. allowed either side of the +. The effect of this in ")
  ManualsHelp_L("commands is  exactly the  same as  if all  the matched  files could have been ")
  ManualsHelp_L("matched by a single filespec.")
  ManualsHelp_L(" ")
  ManualsHelp_L("     Where a  compound-filespec is  used to specify existing files, /H may be ")
  ManualsHelp_L("given after each filespec (see above), in which case it will take effect only ")
  ManualsHelp_L("for  the files  matched by  that single filespec. If a /H is given before the ")
  ManualsHelp_L("compound-filespec, then it will apply over all the filespecs.")
  ManualsHelp_L("")
  ManualsHelp_L("volname")
  ManualsHelp_L("")
  ManualsHelp_L("     This  indicates  that a  volume name  is required.  A volume  name is  a ")
  ManualsHelp_L("sequence of  up to  11 characters, which can include the characters not valid ")
  ManualsHelp_L("for  filenames with  the exception of control codes and '/', although leading ")
  ManualsHelp_L("spaces will be deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("device")
  ManualsHelp_L("")
  ManualsHelp_L("     This indicates  one of  the five  standard MSX-DOS  devices is required. ")
  ManualsHelp_L("These and their meaning are:")
  ManualsHelp_L("")
  ManualsHelp_L("     CON  - screen/keyboard I/O")
  ManualsHelp_L("     NUL  - 'null' device, does nothing")
  ManualsHelp_L("     AUX  - auxiliary I/O (eg. RS232 serial)")
  ManualsHelp_L("     LST  - printer output")
  ManualsHelp_L("     PRN  - printer output")
  ManualsHelp_L("")
  ManualsHelp_L("     Unlike  on some  other systems, a colon is not required after the device ")
  ManualsHelp_L("name.")
  ManualsHelp_L("")
  ManualsHelp_L("     Device names  can generally  be used wherever filenames can be used. For ")
  ManualsHelp_L("example,  the command  COPY MYFILE PRN will read the file MYFILE and write it ")
  ManualsHelp_L("to the printer.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  using the  CON device  as an input filename, lines can be typed in ")
  ManualsHelp_L("and edited in the same way as command lines (see chapter 2 on Editing Command ")
  ManualsHelp_L("Lines). To  end the operation, control-Z (^Z) must be typed at the start of a ")
  ManualsHelp_L("line.  For example,  a small  text file called MYFILE can be created with the ")
  ManualsHelp_L("command COPY CON MYFILE:")
  ManualsHelp_L("")
  ManualsHelp_L("        A>COPY CON MYFILE")
  ManualsHelp_L("        All work and no play makes Jack a dull boy.")
  ManualsHelp_L("        Can you hear me?")
  ManualsHelp_L("        ^Z")
  ManualsHelp_L("        A>")
  ManualsHelp_L("")
  ManualsHelp_L("Lines of  text can  then be  typed in,  and they  will be written to the file ")
  ManualsHelp_L("MYFILE.  The  command  will then  complete when  a line  containing a  single ")
  ManualsHelp_L("control-Z is entered.")
  ManualsHelp_L("")
  ManualsHelp_L("     If the  NUL device  is written  to by the command COPY CON NUL, then the ")
  ManualsHelp_L("characters  written are  simply ignored.  If read  from, then  an end-of-file ")
  ManualsHelp_L("condition  is  returned  straight  away (which  is equivalent  to typing  the ")
  ManualsHelp_L("control-Z in the example above).")
  ManualsHelp_L("")
  ManualsHelp_L("     For  most commands,  it is  not sensible  to specify  a device  (the CON ")
  ManualsHelp_L("device cannot  be deleted using the ERASE command, for example). The commands ")
  ManualsHelp_L("that  devices are  likely to  be used with are those that read and write data ")
  ManualsHelp_L("from and to files, such as CONCAT, COPY and TYPE.")
  ManualsHelp_L("")
  ManualsHelp_L("number")
  ManualsHelp_L("")
  ManualsHelp_L("     This  indicates that a number is required. This may be in the range 0 to ")
  ManualsHelp_L("255 or 0 to 65535 depending on the command.")
  ManualsHelp_L("")
  ManualsHelp_L("4. COMMANDS")
  ManualsHelp_L("===========")
  ManualsHelp_L("")
  ManualsHelp_L("     This chapter  describes in  detail all  the commands  available from the ")
  ManualsHelp_L("MSX-DOS  CLI.  Each  command  is  described using  the notation  described in ")
  ManualsHelp_L("chapter  3. Where  two or  more parameters are described using this notation, ")
  ManualsHelp_L("they must  be separated  by separators.  Separators consist  of zero  or more ")
  ManualsHelp_L("leading  spaces, a  separator character,  and zero  or more  trailing spaces. ")
  ManualsHelp_L("Valid separator characters are:")
  ManualsHelp_L("")
  ManualsHelp_L("          space tab ; , =")
  ManualsHelp_L("")
  ManualsHelp_L("     Option letters introduced by '/' characters are an exception to this and ")
  ManualsHelp_L("need not be preceded by a separator.")
  ManualsHelp_L("")
  ManualsHelp_L("     A transient  MSX-DOS or  CP/M-80 program  can be  loaded and executed by ")
  ManualsHelp_L("typing  the main  name of  the filename  plus an  optional extension of .COM. ")
  ManualsHelp_L("Batch files  can similarly  be executed  except that  the extension  is .BAT. ")
  ManualsHelp_L("Where  COM and  BAT files exist in the same directory and with the same name, ")
  ManualsHelp_L("the COM  file is  found and executed in preference to the BAT file. The exact ")
  ManualsHelp_L("location  on disk  of the  command can  be specified  by including  its drive ")
  ManualsHelp_L("and/or path with its name.")
  ManualsHelp_L("")
  ManualsHelp_L("     When looking  for a  COM or  BAT file,  the specified  directory of  the ")
  ManualsHelp_L("specified  drive is searched. If not found and a drive or path was given with ")
  ManualsHelp_L("the command, then an 'unrecognized command' error results.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  just the  filename and  optional extension  were given,  the current ")
  ManualsHelp_L("directory is  searched first.  If not  found, then  a list  of directories is ")
  ManualsHelp_L("searched.  This list  can be specified and changed using the PATH command. If ")
  ManualsHelp_L("still not found then an 'unrecognized command' error again results.")
  ManualsHelp_L("")
  ManualsHelp_L("     No CP/M  program will be able to specify directories or path names since ")
  ManualsHelp_L("these  do not  exist in  CP/M, only  the current directory of the appropriate ")
  ManualsHelp_L("drive being  accessible from  these programs.  An APPEND  environment item is ")
  ManualsHelp_L("available  which increases  the usability  of these  programs by  allowing an ")
  ManualsHelp_L("alternative directory  to be  searched by  the program as well as the current ")
  ManualsHelp_L("one (see chapter 7 on Environment Items).")
  ManualsHelp_L("")
  ManualsHelp_L("     Many commands  and programs  perform input or output using the 'standard ")
  ManualsHelp_L("input'  and  'standard  output'. The  standard input  normally refers  to the ")
  ManualsHelp_L("keyboard, and the standard output normally refers to the screen. These can be ")
  ManualsHelp_L("changed, however, to refer to other devices or to disk files for the duration ")
  ManualsHelp_L("of  the command  by including  the redirection  symbols <,  > and  >> on  the ")
  ManualsHelp_L("command line,  followed by  a device or file name. The standard output of one ")
  ManualsHelp_L("command  can  also  be sent  to the  standard input  of the  next command  by ")
  ManualsHelp_L("including  the piping  symbol | on the command line between the two commands. ")
  ManualsHelp_L("See chapter 5 on Redirection and Piping for more details of these facilities.")
  ManualsHelp_L("")
  ManualsHelp_L("     When a transient command is executed, that command may overwrite some of ")
  ManualsHelp_L("the  memory that  COMMAND2.COM was  using. Thus  when the command terminates, ")
  ManualsHelp_L("COMMAND2.COM  may  need  to  re-load itself  from disk  into memory  from the ")
  ManualsHelp_L("COMMAND2.COM file that it was originally loaded from. This file is located by ")
  ManualsHelp_L("looking at  the SHELL  environment item (see chapter 7 on Environment Items), ")
  ManualsHelp_L("or  the root  directory of  the boot drive if it is not found there. If it is ")
  ManualsHelp_L("still not  found, then a prompt is issued. For example, if MSX-DOS was booted ")
  ManualsHelp_L("from drive A:, then the prompt will be:")
  ManualsHelp_L("")
  ManualsHelp_L("          Insert COMMAND2.COM disk in drive A:")
  ManualsHelp_L("          Press any key to continue...")
  ManualsHelp_L("")
  ManualsHelp_L("After  inserting into  drive A:  a disk  containing COMMAND2.COM  in the root ")
  ManualsHelp_L("directory and  pressing a  key, COMMAND2.COM will be re-loaded and the system ")
  ManualsHelp_L("will continue as normal.")
  ManualsHelp_L("")
  ManualsHelp_L("     Although  not a  command as  such, the  currently logged on drive can be ")
  ManualsHelp_L("changed by giving the command:")
  ManualsHelp_L("")
  ManualsHelp_L("     d:")
  ManualsHelp_L("")
  ManualsHelp_L("which  causes the  drive d: to become the current drive. This should be shown ")
  ManualsHelp_L("by the prompt letter.")
  ManualsHelp_L("")
  ManualsHelp_L("     In  the  command examples  that follow,  underlined text  is an  example ")
  ManualsHelp_L("response to  a command,  and the  other text  consists of the example command ")
  ManualsHelp_L("given  by the user. In most examples a single space is shown as the parameter ")
  ManualsHelp_L("separator,  although  other  separator  characters can  be used  as specified ")
  ManualsHelp_L("above.")
  ManualsHelp_L("")
  ManualsHelp_L("ASSIGN")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          ASSIGN [d: [d:]]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Sets up the logical to physical translation of drives.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If no drives are given, then all current drive assignments are cancelled.")
  ManualsHelp_L("")
  ManualsHelp_L("     If only one drive is given, then the physical drive to which this refers ")
  ManualsHelp_L("is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If both  drives are given, then the subsequent access to the first drive ")
  ManualsHelp_L("(logical drive) will be done to the second drive (physical drive) by MSX-DOS.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("ASSIGN")
  ManualsHelp_L("")
  ManualsHelp_L("     Un-assigns all previous drive assignments.")
  ManualsHelp_L("")
  ManualsHelp_L("ASSIGN A: B:")
  ManualsHelp_L("")
  ManualsHelp_L("     Assigns drive A: to drive B:, so that all accesses that previously would ")
  ManualsHelp_L("go to drive A: go instead to drive B:")
  ManualsHelp_L("")
  ManualsHelp_L("ASSIGN A:")
  ManualsHelp_L("A:=B:")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays the drive to which A: is currently assigned, which in this case ")
  ManualsHelp_L("is B:.")
  ManualsHelp_L("")
  ManualsHelp_L("ATDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     ATDIR +|-H  [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Changes the attributes of directories to make them hidden/not hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  compound-filespec specifies the directories whose attributes are to ")
  ManualsHelp_L("be changed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  +H is given, then the selected directories are marked as hidden, and ")
  ManualsHelp_L("will not  be affected  by other  directory commands or shown by a DIR command ")
  ManualsHelp_L("unless  a /H  option is  given with  those commands.  The -H option marks the ")
  ManualsHelp_L("selected directories  as not  hidden, and will not have any effect unless the ")
  ManualsHelp_L("/H option is given.")
  ManualsHelp_L("")
  ManualsHelp_L("     Unlike files, directories cannot be made read only.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  an error  occurs, the erroneous directory name is printed followed ")
  ManualsHelp_L("by an  error message,  and the command will continue with the next directory. ")
  ManualsHelp_L("If  many errors  occur, then the /P option can be used to cause the output to ")
  ManualsHelp_L("pause at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     The DIR  /H command  can be  used to  indicate the current attributes of ")
  ManualsHelp_L("directories.")
  ManualsHelp_L("")
  ManualsHelp_L("  Examples")
  ManualsHelp_L("")
  ManualsHelp_L("  ATDIR +H DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     Marks the directory called DIR1 as hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("     ATDIR -H DIR1/H")
  ManualsHelp_L("     Marks the hidden directory DIR1 as not hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("     ATDIR +H DIR?")
  ManualsHelp_L("")
  ManualsHelp_L("     Marks all directories matching DIR? as hidden (for example DIR1, DIR2 and DIR3).")
  ManualsHelp_L("")
  ManualsHelp_L("ATDIR +H \DIR1+\DIR2")
  ManualsHelp_L("")
  ManualsHelp_L("     Marks the DIR1 directory and the DIR2 directory as hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("ATTRIB")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     ATTRIB +|-R|H [/H] [/P] compound-filespec ")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Changes  the attributes of files to make them hidden/not hidden and read ")
  ManualsHelp_L("only/not read only.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec  specifies the  files whose  attributes are  to be ")
  ManualsHelp_L("changed, and /H allows hidden files to also have their attributes changed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  +H is  given, then the selected files are marked as hidden, and will ")
  ManualsHelp_L("not be  affected by  most commands or be shown by the DIR command unless a /H ")
  ManualsHelp_L("option  is given  with those  commands. -H  marks the  selected files  as not ")
  ManualsHelp_L("hidden, and will not have any effect unless the files are hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("     If +R  is given,  then the  selected files  are marked  as read only. -R ")
  ManualsHelp_L("marks  the selected  files as  not read  only (read/write).  Read only  files ")
  ManualsHelp_L("cannot be written to or changed.")
  ManualsHelp_L("")
  ManualsHelp_L("     When an  error occurs,  the erroneous filename is printed followed by an ")
  ManualsHelp_L("error  message, and  the command  will continue  with the  next file. If many ")
  ManualsHelp_L("errors occur,  then the /P option can be used to cause the output to pause at ")
  ManualsHelp_L("the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     The DIR command can be used to indicate the current attributes of files.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("     ATTRIB +R FILE1")
  ManualsHelp_L("")
  ManualsHelp_L("     The  file FILE1  is marked  as read  only, and  will not subsequently be ")
  ManualsHelp_L("modifiable or deletable.")
  ManualsHelp_L("")
  ManualsHelp_L("     ATTRIB +HB:\DIR1\*.COM")
  ManualsHelp_L("")
  ManualsHelp_L("     Marks all *.COM files in the directory B:DIR1 as hidden, and will not be ")
  ManualsHelp_L("displayed by the DIR command.")
  ManualsHelp_L("")
  ManualsHelp_L("     ATTRIB -R -H \DIR1/H/P")
  ManualsHelp_L("")
  ManualsHelp_L("     All the  files in  DIR1 are  marked as not read only and not hidden. The ")
  ManualsHelp_L("output, if any, will pause at the bottom of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("ATTRIB +R \DIR1 + \DIR2 + FILE1")
  ManualsHelp_L("")
  ManualsHelp_L("     All files in the directories DIR1 and DIR2 and the file FILE1 are marked ")
  ManualsHelp_L("as read only.")
  ManualsHelp_L("")
  ManualsHelp_L("BASIC")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          BASIC [program]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Transfers control to MSX disk BASIC.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     [Program] is the name of a BASIC program on disk.")
  ManualsHelp_L("")
  ManualsHelp_L("     Control is passed to the built-in MSX BASIC, which will load and execute ")
  ManualsHelp_L("the  BASIC program  if specified.  If a RAM disk has been set up, then it can ")
  ManualsHelp_L("still be used from BASIC.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  BASIC  command  CALL  SYSTEM(" + Chr(34) + "command" + Chr(34) + ")  can be  used to  return to ")
  ManualsHelp_L("MSX-DOS,  and the  optional command,  which can  be any command executable on ")
  ManualsHelp_L("MSX-DOS, will  be executed.  If the  command is  not given, then a batch file ")
  ManualsHelp_L("called  REBOOT.BAT will  be searched for and executed if found (see chapter 6 ")
  ManualsHelp_L("on Batch Files).")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("BASIC")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX disk BASIC is entered.")
  ManualsHelp_L("")
  ManualsHelp_L("BASIC MYPROG.BAS")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX disk  BASIC is  entered, and the BASIC program MYPROG.BAS loaded and ")
  ManualsHelp_L("RUN.")
  ManualsHelp_L("")
  ManualsHelp_L("BUFFERS")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     BUFFERS [number]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or changes the number of disk buffers in the system.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If the number is not given, then the number of disk buffers currently in ")
  ManualsHelp_L("the system will be displayed, otherwise the number of buffers will be changed ")
  ManualsHelp_L("to the specified number, the now unused memory being freed for other purposes ")
  ManualsHelp_L("if the  new number  is less  than the previous. If there is not enough memory ")
  ManualsHelp_L("for the specified number of buffers, then as many as possible are created and ")
  ManualsHelp_L("no error is given.")
  ManualsHelp_L("")
  ManualsHelp_L("     Increasing  the number  of disk  buffers may speed up some applications, ")
  ManualsHelp_L("particularly those  that perform random accesses to files. Setting the number ")
  ManualsHelp_L("above  10 is  unlikely to improve performance much, and unnecessarily uses up ")
  ManualsHelp_L("memory.")
  ManualsHelp_L("")
  ManualsHelp_L("     The memory area used for disk buffers is also used for environment items ")
  ManualsHelp_L("and for  opening files.  Thus keeping buffers set to the maximum possible may ")
  ManualsHelp_L("prevent some commands from working, particularly SET, COPY and CONCAT. If any ")
  ManualsHelp_L("of these commands give a 'not enough memory' error then it may help to reduce ")
  ManualsHelp_L("the  number of  buffers. Reducing  them below about three however will impair ")
  ManualsHelp_L("performance considerably.")
  ManualsHelp_L("")
  ManualsHelp_L("     The default number of buffers in the system is 5, which will be adequate ")
  ManualsHelp_L("for most purposes.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("BUFFERS")
  ManualsHelp_L("     BUFFERS=5")
  ManualsHelp_L("")
  ManualsHelp_L("     The current number of disk buffers is printed, which in this case is 5.")
  ManualsHelp_L("")
  ManualsHelp_L("BUFFERS 10")
  ManualsHelp_L("(or BUFFERS=10)")
  ManualsHelp_L("")
  ManualsHelp_L("     The number  of buffers is increased to as many as possible up to a limit ")
  ManualsHelp_L("of 10.")
  ManualsHelp_L("")
  ManualsHelp_L("BUFFERS = 5")
  ManualsHelp_L("(or BUFFERS 5)")
  ManualsHelp_L("")
  ManualsHelp_L("     The number of buffers is reduced again to 5.")
  ManualsHelp_L("")
  ManualsHelp_L("CD")
  ManualsHelp_L("")
  ManualsHelp_L("     See CHDIR")
  ManualsHelp_L("")
  ManualsHelp_L("CHDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     CHDIR [d:] [path]")
  ManualsHelp_L("          or")
  ManualsHelp_L("     CD [d:] [path]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or changes the current directory.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If no path is specified, then the current directory path for the current ")
  ManualsHelp_L("or  specified drive  is printed.  This is  the directory  path from  the root ")
  ManualsHelp_L("directory to the current directory.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  path is  specified, then  the current directory for the current or ")
  ManualsHelp_L("specified drive is changed to the directory specified by the path.")
  ManualsHelp_L("")
  ManualsHelp_L("     Each drive has it's own current directory. This remains at the directory ")
  ManualsHelp_L("specified  by the last CHDIR command for that drive (or at the root directory ")
  ManualsHelp_L("initially) until  another CHDIR command is given or it cannot be found on the ")
  ManualsHelp_L("disk when it is accessed (because the disk has been changed, for example). It ")
  ManualsHelp_L("is then returned to the root directory.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  CD command is an abbreviated form of the CHDIR command provided for ")
  ManualsHelp_L("convenience and MS-DOS compatibility.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note  that  the command  prompt can  be changed  to display  the current ")
  ManualsHelp_L("directory  with  the  command  SET PROMPT  ON (see  chapter 7  on Environment ")
  ManualsHelp_L("Items).")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("CHDIR \DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     The current directory of the current drive is changed to DIR1.")
  ManualsHelp_L("")
  ManualsHelp_L("CHDIR A:DIR2")
  ManualsHelp_L("")
  ManualsHelp_L("     The current directory of drive A: is changed to DIR2.")
  ManualsHelp_L("")
  ManualsHelp_L("CD")
  ManualsHelp_L("     E:\DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     The current  directory of  the current drive is displayed, which in this ")
  ManualsHelp_L("case is DIR1.")
  ManualsHelp_L("")
  ManualsHelp_L("CHDIR A:")
  ManualsHelp_L("     A:\DIR2")
  ManualsHelp_L("")
  ManualsHelp_L("     The current directory for drive A: is displayed, which is also DIR2.")
  ManualsHelp_L("")
  ManualsHelp_L("CHKDSK")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          CHKDSK [d:] [/F]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Checks the integrity of the files on the disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The integrity of the data structures on disk in the specified or current ")
  ManualsHelp_L("drive is checked and lost disk space is checked for. When errors are found on ")
  ManualsHelp_L("the disk, corrective action is taken. If lost clusters are found, a prompt is ")
  ManualsHelp_L("issued allowing  the lost  disk space to be either converted into usable disk ")
  ManualsHelp_L("space  or  into  files.  If  the latter  is chosen,  then files  of the  form ")
  ManualsHelp_L("FILE0000.CHK, FILE0001.CHK etc. will be created.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the /F  option is not given, then CHKDSK will not actually write any ")
  ManualsHelp_L("corrections it  makes to  disk, but will behave as though it has. This allows ")
  ManualsHelp_L("CHKDSK to be executed to see what would be done to the disk if /F was given.")
  ManualsHelp_L("")
  ManualsHelp_L("     Disk  space  can  become  lost  (ie.  lost  clusters created)  when some ")
  ManualsHelp_L("programs  are  aborted.  This applies  particularly to  CP/M programs.  It is ")
  ManualsHelp_L("recommended that CHKDSK is used occasionally on all disks.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note  that this is a transient command, and must therefore be loaded off ")
  ManualsHelp_L("disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("CHKDSK")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk  in the  current drive  is checked.  A 'status  report' will be ")
  ManualsHelp_L("printed. Any errors found will not be written to disk.")
  ManualsHelp_L("")
  ManualsHelp_L("     CHKDSK B:")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk in drive B: is checked. Any errors found will not be written to ")
  ManualsHelp_L("disk.")
  ManualsHelp_L("")
  ManualsHelp_L("CHKDSK/F")
  ManualsHelp_L("    20 lost clusters found in 1 chain")
  ManualsHelp_L("    Convert lost chains to files (Y/N) ?")
  ManualsHelp_L("")
  ManualsHelp_L("     The  disk in  the current  drive was  checked, and  some lost disk space ")
  ManualsHelp_L("found. Since  /F was  given, the  corrections will be written to disk and the ")
  ManualsHelp_L("lost space recovered.")
  ManualsHelp_L("")
  ManualsHelp_L("CLS")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          CLS")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Clears the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("          Simply clears the screen and homes the cursor.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("CLS")
  ManualsHelp_L("")
  ManualsHelp_L("     The screen is cleared, and another command can be typed.")
  ManualsHelp_L("")
  ManualsHelp_L("COMMAND2")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     COMMAND2 [command]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Invokes the command interpreter.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     command is any command that can normally be typed at the prompt (such as ")
  ManualsHelp_L("the commands in this manual).")
  ManualsHelp_L("")
  ManualsHelp_L("     COMMAND2 is  simply the name of the command interpreter on disk, and can ")
  ManualsHelp_L("be  executed as  a normal transient program. In normal use it gets loaded and ")
  ManualsHelp_L("executed once  by MSXDOS2.SYS at the boot time, and this provides the ability ")
  ManualsHelp_L("to perform all the commands in this manual.")
  ManualsHelp_L("")
  ManualsHelp_L("     Advanced users  may, however, wish to invoke another command interpreter ")
  ManualsHelp_L("for  a variety  of reasons.  The second  COMMAND2.COM may,  for example, be a ")
  ManualsHelp_L("later version  and provide  more facilities.  If a  transient program has the ")
  ManualsHelp_L("ability to load and execute programs, as some sophisticated programs do, then ")
  ManualsHelp_L("they  can load  the COMMAND2.COM  program and any MSX-DOS command can then be ")
  ManualsHelp_L("given. When  COMMAND2.COM exits by EXIT command, the original program will be ")
  ManualsHelp_L("returned to.")
  ManualsHelp_L("")
  ManualsHelp_L("     If no command is given as a parameter, then the second COMMAND2.COM will ")
  ManualsHelp_L("simply issue the normal prompt (without executing AUTOEXEC.BAT or REBOOT.BAT) ")
  ManualsHelp_L("and  wait for  commands in the normal way. It will terminate and exit back to ")
  ManualsHelp_L("the original  command interpreter  or program  when the EXIT command is given ")
  ManualsHelp_L("(see  the EXIT command). If an error code is given to this EXIT command, then ")
  ManualsHelp_L("the original  command interpreter or program will receive it and, in the case ")
  ManualsHelp_L("of  COMMAND2.COM and  MSXDOS2.SYS, print  an appropriate  error message  (see ")
  ManualsHelp_L("chapter 8 on Errors).")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  command is  given as  a parameter to COMMAND2.COM however, then it ")
  ManualsHelp_L("will  be executed  as though it had been typed in the normal way. The command ")
  ManualsHelp_L("may be an internal command or an external COM or BAT command. After executing ")
  ManualsHelp_L("the command,  COMMAND2.COM will immediately exit back to the original command ")
  ManualsHelp_L("interpreter or program.")
  ManualsHelp_L("")
  ManualsHelp_L("     In  this way,  invoking a  second COMMAND2.COM  from the  normal command ")
  ManualsHelp_L("interpreter with  a batch  file name as a command can be used to 'nest' batch ")
  ManualsHelp_L("files (see chapter 6 on Batch Files), instead of 'chaining'.")
  ManualsHelp_L("")
  ManualsHelp_L("     When COMMAND2.COM  is executed, it saves the whole environment, and then ")
  ManualsHelp_L("restores  it again  when it  exits. It  only sets  up the default environment ")
  ManualsHelp_L("items however  if they  are not already defined. Thus the second COMMAND2.COM ")
  ManualsHelp_L("inherits  the environment  of the  first. Any  changes made whilst the second ")
  ManualsHelp_L("COMMAND2.COM is  executing will  only last  as long it does, and will be lost ")
  ManualsHelp_L("when it exits.")
  ManualsHelp_L("")
  ManualsHelp_L("     Each  incarnation of  COMMAND2.COM uses  up some  memory which  is freed ")
  ManualsHelp_L("again when  it exits. This depends partly on the number of environment items, ")
  ManualsHelp_L("and is typically about 1.5K.")
  ManualsHelp_L("")
  ManualsHelp_L("     When COMMAND2.COM  executes a  transient program, it may have to re-load ")
  ManualsHelp_L("itself  off disk  since the  program is allowed to use the memory occupied by ")
  ManualsHelp_L("COMMAND2.COM. In  this case, it uses the SHELL environment item to locate the ")
  ManualsHelp_L("file  that it  must use  to load itself (see chapter 7 on Environment Items). ")
  ManualsHelp_L("When first  loaded from  the COMMAND2.COM file on disk, SHELL is set to refer ")
  ManualsHelp_L("to that file.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("COMMAND2")
  ManualsHelp_L("A>")
  ManualsHelp_L("")
  ManualsHelp_L("     Another  copy of COMMAND2 is loaded, and prints it's normal prompt. EXIT ")
  ManualsHelp_L("will exit back to the original prompt.")
  ManualsHelp_L("")
  ManualsHelp_L("COMMAND2 FILE.BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     Normally in  a batch  file. The  file FILE.BAT  is executed, and when it ")
  ManualsHelp_L("ends the current batch file will be resumed with the command after this one.")
  ManualsHelp_L("")
  ManualsHelp_L("CONCAT")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     CONCAT [/H] [/P] [/B] [/V] compound-filespec filespec")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Concatenates (joins together) files.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  compound-filespec  specifies  the  files  that  are  to  be  joined ")
  ManualsHelp_L("together, and /H allows hidden files to be joined.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  second parameter  is a  filespec that  must be  unambiguous and  is ")
  ManualsHelp_L("created before  the source  files are  read. Each  source file  is then read, ")
  ManualsHelp_L("joined onto the end of the previous one and written out to the destination.")
  ManualsHelp_L("")
  ManualsHelp_L("     As each  source file  is read,  it's filename  is printed.  If for  some ")
  ManualsHelp_L("reason  the file  cannot be read (eg. it is the file that has been created as ")
  ManualsHelp_L("the destination)  then the  filename is  followed by an error message and the ")
  ManualsHelp_L("CONCAT operation continues with the next source file. If many files are being ")
  ManualsHelp_L("concatenated, then /P will cause the output to pause at the end of the screen ")
  ManualsHelp_L("until a key is pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("     Normally, the  concatenation is  performed on  ASCII files. Source files ")
  ManualsHelp_L("are  read  up  to  the  first  end-of-file  character (CTRL-Z)  and a  single ")
  ManualsHelp_L("end-of-file  character is appended to the destination after all data has been ")
  ManualsHelp_L("written out.  If, however,  /B (binary mode) is given, then no interpretation ")
  ManualsHelp_L("is given to the data read and no additional data is added.")
  ManualsHelp_L("")
  ManualsHelp_L("     It  is also  possible to give the /B to the destination or to any of the ")
  ManualsHelp_L("filespecs in  the compound-filespec,  and it  will then  refer only  to those ")
  ManualsHelp_L("files. /A may also be given to reverse the effect of /B.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  /V  option  can  be given  to turn  write verification  on for  the ")
  ManualsHelp_L("duration of  the CONCAT  command (see  the VERIFY  command). This will ensure ")
  ManualsHelp_L("that  data is  written correctly to disks if the device driver being used has ")
  ManualsHelp_L("the feature, but will slow the operation down for the verification.")
  ManualsHelp_L("")
  ManualsHelp_L("     If CONCAT  gives a  'Not enough memory' error then probably reducing the ")
  ManualsHelp_L("number  of buffers  (see the  BUFFERS command)  or removing  some environment ")
  ManualsHelp_L("items (see chapter 7 on Environment Items) will free up sufficient memory.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("CONCAT *.DOC ALL.PRN")
  ManualsHelp_L("")
  ManualsHelp_L("     A  new file called ALL.PRN is created, and all files matching *.DOC (for ")
  ManualsHelp_L("example FILE1.DOC,  FILE2.DOC and  FILE3.DOC) are joined together and written ")
  ManualsHelp_L("to  the new  file in the order that they are found on disk. Any existing file ")
  ManualsHelp_L("called ALL.PRN will be overwritten.")
  ManualsHelp_L("")
  ManualsHelp_L("CONCAT /H /P *.DOC ALL.DOC")
  ManualsHelp_L("     FILE1.DOC")
  ManualsHelp_L("     FILE2.DOC")
  ManualsHelp_L("     FILE3.DOC")
  ManualsHelp_L("     ALL.DOC -- Destination file cannot be concatenated")
  ManualsHelp_L("")
  ManualsHelp_L("     A  new file  called ALL.DOC is created, and all files matching *.DOC are ")
  ManualsHelp_L("joined together  and written to the new file in the order that they are found ")
  ManualsHelp_L("on  disk. Since the destination file ALL.DOC also matched the source filename ")
  ManualsHelp_L("*.DOC, the  message is  printed and  it is not included in the concatenation. ")
  ManualsHelp_L("Since  /H was  given, hidden  files are  also concatenated  and, since /P was ")
  ManualsHelp_L("given, the  key input  is waited after each screenful output if the number of ")
  ManualsHelp_L("the lines of the file list is larger than that of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("CONCAT /B  FILE2.DOC + FILE3.DOC + FILE1.DOC  ALL.DOC")
  ManualsHelp_L("")
  ManualsHelp_L("     A  new file  ALL.DOC is  created, and the files FILE2.DOC, FILE3.DOC and ")
  ManualsHelp_L("FILE1.DOC and joined together in that order and written to the new file. They ")
  ManualsHelp_L("are joined together in binary mode. ")
  ManualsHelp_L("")
  ManualsHelp_L("COPY")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     COPY [/A] [/H] [/T] [/V] [/P] [/B] source dest")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Copies data from files or devices to other files or devices.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The definition of the source is:")
  ManualsHelp_L("")
  ManualsHelp_L("     compound-filespec | device")
  ManualsHelp_L("")
  ManualsHelp_L("The compound-filespec  specifies the  files that  are to be copied. It may be ")
  ManualsHelp_L("the device specification. If /H is given then hidden files may be copied.")
  ManualsHelp_L("")
  ManualsHelp_L("     The definition of the dest is:")
  ManualsHelp_L("")
  ManualsHelp_L("     [d:] [path] [filename] | device")
  ManualsHelp_L("")
  ManualsHelp_L("Where d: and path default to the current drive and directory respectively. If ")
  ManualsHelp_L("any part of the filename is ambiguous then the appropriate character from the ")
  ManualsHelp_L("source  filename is substituted, thus allowing the files to be renamed in the ")
  ManualsHelp_L("process. If  the filename  is not  given, then  the entire source filename is ")
  ManualsHelp_L("used. If the dest is an unambiguous directory, then the files are copied into ")
  ManualsHelp_L("that directory with a filename of *.*.")
  ManualsHelp_L("")
  ManualsHelp_L("     COPY  will  read as  many source  files as  possible into  memory before ")
  ManualsHelp_L("writing any  out. When  it can read no more into memory (eg. when it has used ")
  ManualsHelp_L("all  available memory)  it will write out each file in the order that it read ")
  ManualsHelp_L("them. When  it creates  each destination file, it prints the source filename. ")
  ManualsHelp_L("Then  if it  is unable  to create  the destination  file, an error message is ")
  ManualsHelp_L("printed and  the copy operation continues with the next file. /P can be given ")
  ManualsHelp_L("to make the output pause at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     Many reasons exist for COPY to be unable to create the destination, such ")
  ManualsHelp_L("as  a read-only file already existing with the same name. Sometimes COPY will ")
  ManualsHelp_L("refuse to  create the  destination because  the user may have made a mistake. ")
  ManualsHelp_L("For  example, a file cannot be copied onto itself, or several files cannot be ")
  ManualsHelp_L("copied onto one file. A 'Cannot create destination' error may be given if the ")
  ManualsHelp_L("destination of one file would delete a previous source file or a file already ")
  ManualsHelp_L("being used  for something  else (eg.  the currently  executing batch file). A ")
  ManualsHelp_L("'Cannot  overwrite previous  destination file' error results if an attempt is ")
  ManualsHelp_L("made to  copy many  files to  one file.  This usually means that the intended ")
  ManualsHelp_L("destination was a directory, but that the name has been misspelled.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  /A is  specified, then  an ASCII  copy is performed. This means that ")
  ManualsHelp_L("source  files  will  only  be  read  as far  as the  first end-of-file  (EOF) ")
  ManualsHelp_L("character (CTRL-Z)  and then  each destination will have a single end-of-file ")
  ManualsHelp_L("character appended to it.")
  ManualsHelp_L("")
  ManualsHelp_L("     It  is also  possible to  give a  /A to the destination or to any of the ")
  ManualsHelp_L("filespecs in  the compound-filespec separately, in which case it applies only ")
  ManualsHelp_L("to that source or dest specification.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  /B option  can be  given to  copy in binary mode, that is, the file ")
  ManualsHelp_L("being read will be copied as it is and no data will be added.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  /V  option  can  be  given to  turn write  verification on  for the ")
  ManualsHelp_L("duration  of the COPY command (see the VERIFY command). This will ensure that ")
  ManualsHelp_L("data is  written correctly  to disks  if the device driver being used has the ")
  ManualsHelp_L("feature, but will slow the operation down.")
  ManualsHelp_L("")
  ManualsHelp_L("     Normally,  the destination files are given the same date and time as the ")
  ManualsHelp_L("source files.  However, the  /T option  can be given to cause the destination ")
  ManualsHelp_L("files  to have  the current  date and time. The destination files will not be ")
  ManualsHelp_L("hidden or  read-only, regardless  of the  attributes of the source files. The ")
  ManualsHelp_L("ATTRIB command can be used to change these.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  COPY gives  a 'Not  enough memory'  error then probably reducing the ")
  ManualsHelp_L("number of  buffers (see  the BUFFERS  command) or  removing some  environment ")
  ManualsHelp_L("items (see chapter 7 on Environment Items) will free up sufficient work area.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note  that the COPY command is simpler than that in MS-DOS and MSX-DOS 1 ")
  ManualsHelp_L("because it  cannot concatenate  (join together)  files. To  do this, a CONCAT ")
  ManualsHelp_L("command is available (see the CONCAT command).")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("COPY FILE1 B:")
  ManualsHelp_L("")
  ManualsHelp_L("     The file FILE1 is copied from the current directory of the current drive ")
  ManualsHelp_L("to the current directory of drive B:.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY /H  MSXDOS2.SYS + COMMAND2.COM  B:")
  ManualsHelp_L("")
  ManualsHelp_L("     The  two hidden  files MSXDOS2.SYS  and COMMAND2.COM are copied to drive ")
  ManualsHelp_L("B:, thus making it a booting disk.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY A:\DIR1 B:\DIR1 /V")
  ManualsHelp_L("")
  ManualsHelp_L("     All files  in the directory DIR1 from the root of drive A: are copied to ")
  ManualsHelp_L("a  similar directory on drive B: with verify on to ensure that the files were ")
  ManualsHelp_L("written correctly.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY B:")
  ManualsHelp_L("")
  ManualsHelp_L("     All files in the current directory of drive B: are copied to the current ")
  ManualsHelp_L("directory of the current drive.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY /A AUX CON")
  ManualsHelp_L("")
  ManualsHelp_L("     Characters  are read  from the  device AUX  (which may be used for RS232 ")
  ManualsHelp_L("serial for  example) to the device CON, which is the screen. The copy is done ")
  ManualsHelp_L("as  far as  the first  end-of-file character. If /A was not given, then there ")
  ManualsHelp_L("may have  been no  way of  stopping the  COPY operation  without pressing the ")
  ManualsHelp_L("CTRL-STOP key.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY A:*.DOC B:/T")
  ManualsHelp_L("")
  ManualsHelp_L("     All   files  matching   *.DOC  (for  example  FILE1.DOC,  FILE2.DOC  and ")
  ManualsHelp_L("FILE3.DOC) are  copied to the current directory of drive B: and are given the ")
  ManualsHelp_L("current date and time instead of the dates and times of the *.DOC files.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY *.BAT")
  ManualsHelp_L(" AUTOEXEC.BAT -- File cannot be copied onto itself")
  ManualsHelp_L(" REBOOT.BAT -- File cannot be copied onto itself")
  ManualsHelp_L("")
  ManualsHelp_L("     This  command told  COPY to  copy all files matching *.BAT (in this case ")
  ManualsHelp_L("AUTOEXEC.BAT and  REBOOT.BAT) from the current directory of the current drive ")
  ManualsHelp_L("to  the same place, and COPY printed the messages to warn of this. No data in ")
  ManualsHelp_L("this case was actually copied.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY *.BAT DIR2")
  ManualsHelp_L("AUTOEXEC.BAT")
  ManualsHelp_L("REBOOT.BAT -- Cannot overwrite previous destination file")
  ManualsHelp_L("")
  ManualsHelp_L("This  command  told  COPY  to copy  all files  matching *.BAT  (in this  case ")
  ManualsHelp_L("AUTOEXEC.BAT and  REBOOT.BAT) to  a directory called DIR2. DIR2, however, did ")
  ManualsHelp_L("not  exist so  AUTOEXEC.BAT was  copied to  a file  called DIR2,  and then an ")
  ManualsHelp_L("attempt was made to copy REBOOT.BAT also to a file called DIR2. The message was printed as a warning that a ")
  ManualsHelp_L("mistake was  probably made  (in this  case DIR2 not existing). REBOOT.BAT was ")
  ManualsHelp_L("not actually copied anywhere.")
  ManualsHelp_L("")
  ManualsHelp_L("DATE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     DATE [date]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or sets the current date.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If the  date is  given after  the command,  then the date is set to this ")
  ManualsHelp_L("value (for the format see below). If the date is not given after the command, ")
  ManualsHelp_L("then the current day and date is printed and the new date is prompted for and ")
  ManualsHelp_L("input.  If no  input is  given (ie. if the 'enter' key alone is pressed) then ")
  ManualsHelp_L("the current  date is  not altered. Otherwise the input is assumed to be a new ")
  ManualsHelp_L("date,  and is  interpreted as described below. If the date is invalid then an ")
  ManualsHelp_L("error message is displayed and the new date again prompted for and input.")
  ManualsHelp_L("")
  ManualsHelp_L("     The date is expected to consist of up to three numbers, separated by one ")
  ManualsHelp_L("of the following characters:")
  ManualsHelp_L("")
  ManualsHelp_L("     space tab , - . / :")
  ManualsHelp_L("")
  ManualsHelp_L("with  spaces allowed  either side  of the character. Any missing numbers will ")
  ManualsHelp_L("default to  the current  setting. The  year may  either be a full century and ")
  ManualsHelp_L("year, or may be just the year in which case the century defaults to 19 if the ")
  ManualsHelp_L("year is greater than 80 or 20 otherwise. The date and the year specifications ")
  ManualsHelp_L("may be substituted by '-' to be omitted.")
  ManualsHelp_L("")
  ManualsHelp_L("     The format in which the date is printed and input is flexible and can be ")
  ManualsHelp_L("changed. An  environment item  called DATE  is set  up by default to a format ")
  ManualsHelp_L("that is appropriate for the country of origin of the MSX machine (see chapter ")
  ManualsHelp_L("7  on  Environment  Items).  For  example, on  Japanese machines  the default ")
  ManualsHelp_L("setting  is YY-MM-DD.  The command  SET DATE  DD-MM-YY will  change the  date ")
  ManualsHelp_L("format to  the European  format. The format also affects the dates printed by ")
  ManualsHelp_L("the DIR command.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the DATE environment item is defined, then it will be printed by the ")
  ManualsHelp_L("DATE command  to indicate  the format  in which  the date  is required  to be ")
  ManualsHelp_L("input.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("DATE 86-6-18")
  ManualsHelp_L("")
  ManualsHelp_L("     The current date is set to the 18th June 1986.")
  ManualsHelp_L("")
  ManualsHelp_L("DATE")
  ManualsHelp_L("     Current date is Wed 1986-06-18")
  ManualsHelp_L("     Enter new date (yy-mm-dd): - -19")
  ManualsHelp_L("")
  ManualsHelp_L("     No  parameter  was  given, so  the current  date of  18th June  1986 was ")
  ManualsHelp_L("printed and a new date prompted for. In the reply to the prompt, the date was ")
  ManualsHelp_L("updated to the next day by only specifying the 19th. Since the year and month ")
  ManualsHelp_L("were not given, they remained the same.")
  ManualsHelp_L("")
  ManualsHelp_L("SET DATE = DD/MM/YY")
  ManualsHelp_L("")
  ManualsHelp_L("     The date format has been changed to the European format.")
  ManualsHelp_L("")
  ManualsHelp_L("DATE")
  ManualsHelp_L("Current date is Thu 19-06-1986")
  ManualsHelp_L("Enter new date (DD/MM/YY):")
  ManualsHelp_L("")
  ManualsHelp_L("     No  parameter  was  given, so  the current  date of  19th June  1986 was ")
  ManualsHelp_L("printed in the European format, and the prompt printed. The reply is expected ")
  ManualsHelp_L("in the European format.")
  ManualsHelp_L("")
  ManualsHelp_L("     Formats are:")
  ManualsHelp_L("        ISO             YY/MM/DD")
  ManualsHelp_L("        American        MM/DD/YY")
  ManualsHelp_L("        European        DD/MM/YY")
  ManualsHelp_L("")
  ManualsHelp_L("DEL")
  ManualsHelp_L("")
  ManualsHelp_L("     See ERASE.")
  ManualsHelp_L("")
  ManualsHelp_L("DIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     DIR [/H] [/W] [/P] [compound-filespec]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays the names of files on disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  compound-filespec specifies which files are to be listed. If the /H ")
  ManualsHelp_L("option is given, then hidden files will also be listed.")
  ManualsHelp_L("")
  ManualsHelp_L("     In the  DIR command, unlike all other commands, it is permissible to not ")
  ManualsHelp_L("give  the main  filename or  the filename extension, and both will default to ")
  ManualsHelp_L("'*'. Thus  a filename  of 'FRED'  is equivalent to 'FRED.*' and a filename of ")
  ManualsHelp_L("'.COM'  is equivalent  to '*.COM'.  Note that if the '.' at the end of a main ")
  ManualsHelp_L("filename is  given, then the extension is also assumed to have been given, so ")
  ManualsHelp_L("that  the filename  'FRED.' is not equivalent to 'FRED.*', unlike the example ")
  ManualsHelp_L("above.")
  ManualsHelp_L("")
  ManualsHelp_L("     There are  two formats of the listing. If the /W option is given, then a ")
  ManualsHelp_L("'wide'   listing  is   printed,  with  several  filenames  output  per  line. ")
  ManualsHelp_L("Sub-directory names,  file attributes,  and the  date and  time each file was ")
  ManualsHelp_L("created are not displayed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If the  /W option  is not given, then the filenames are printed with one ")
  ManualsHelp_L("filename  per line,  together with the attributes, the file size and the date ")
  ManualsHelp_L("and time  at which  the file was last modified. The attributes are printed as ")
  ManualsHelp_L("an  'r' if  the file is read-only and an 'h' if the file is hidden (and /H is ")
  ManualsHelp_L("given).  If  the  time  of a  file is  zero (ie.  the file  does not  have an ")
  ManualsHelp_L("associated time)  then the  time field  will not be printed. If the date of a ")
  ManualsHelp_L("file  is zero, then neither the date nor the time fields will be printed. The ")
  ManualsHelp_L("formats in which the dates and times are printed can be changed (see the DATE ")
  ManualsHelp_L("and TIME commands).")
  ManualsHelp_L("")
  ManualsHelp_L("     The non-/W  display is designed to fit within a 40 column screen, but if ")
  ManualsHelp_L("fewer columns are available then some fields of the listing will not be shown ")
  ManualsHelp_L("so that the display will always fit on one line. The number of files per line ")
  ManualsHelp_L("that  are printed  when /W  is specified  is also  adjusted according  to the ")
  ManualsHelp_L("screen width. If the width of the display is less than 13 characters however, ")
  ManualsHelp_L("then in both cases the filenames will wrap to the next line.")
  ManualsHelp_L("")
  ManualsHelp_L("     At  the top  of the  list of  files, the volume name of the disk and the ")
  ManualsHelp_L("name of the directory being listed is displayed. At the bottom, the number of ")
  ManualsHelp_L("files  listed,  the total  number of  bytes in  the files  and the  amount of ")
  ManualsHelp_L("remaining disk space is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  the directory  of a  sub-directory is printed, the first two items ")
  ManualsHelp_L("listed will  always be two special sub-directories called '.' and '..'. These ")
  ManualsHelp_L("are  automatically created  when a  new directory is created, and it is these ")
  ManualsHelp_L("that allow  '.' and '..' to be given in path names to signify the current and ")
  ManualsHelp_L("parent  directories respectively (see chapter 3 on Notation for a description ")
  ManualsHelp_L("of paths).")
  ManualsHelp_L("")
  ManualsHelp_L("     When printing  a number of bytes, the number is truncated and printed as ")
  ManualsHelp_L("the number of kilobytes if 1K or greater.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the /P  option is given, then the output will pause at the bottom of ")
  ManualsHelp_L("the screen until a key is pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("DIR")
  ManualsHelp_L("")
  ManualsHelp_L("     All  filenames  and  directory  names in  the current  directory of  the ")
  ManualsHelp_L("current drive will be printed. This might be as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("      Volume in drive A: is MSX-DOS 2")
  ManualsHelp_L("      Directory of A:\ ")
  ManualsHelp_L("")
  ManualsHelp_L("     MSXDOS2  SYS r    4096 86-06-19  2:45p")
  ManualsHelp_L("     COMMAND2 COM r   10496 86-06-19  2:46p")
  ManualsHelp_L("     UTILS           <dir>  86-06-19  2:50p")
  ManualsHelp_L("     HELP            <dir>  86-06-19  2:50p")
  ManualsHelp_L("      14K in 2 files   222K free")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk  thus contains  the two  MSX-DOS system  files MSXDOS2.SYS  and ")
  ManualsHelp_L("COMMAND2.COM, which are read only, and two directories called UTILS and HELP. ")
  ManualsHelp_L("")
  ManualsHelp_L("DIR B:\HELP/W")
  ManualsHelp_L("")
  ManualsHelp_L("     A  'wide' directory  format has  been requested of the HELP directory on ")
  ManualsHelp_L("drive B:. This might be as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("      Volume in drive B: is MSX-DOS 2")
  ManualsHelp_L("      Directory of B:\HELP")
  ManualsHelp_L("")
  ManualsHelp_L("     BUFFERS .HLP    ATTRIB  .HLP    ASSIGN  .HLP")
  ManualsHelp_L("     ATDIR   .HLP    CHDIR   .HLP    CD      .HLP")
  ManualsHelp_L("     SYNTAX  .HLP    ENV     .HLP    BATCH   .HLP")
  ManualsHelp_L("     EDITING .HLP")
  ManualsHelp_L("      25K in 10 files   222K free")
  ManualsHelp_L("")
  ManualsHelp_L("     DIR UTILS + HELP/P")
  ManualsHelp_L("")
  ManualsHelp_L("     This will list all the files in the UTILS directory and all the files in ")
  ManualsHelp_L("the HELP directory, and will pause at the end of every screen full.")
  ManualsHelp_L("")
  ManualsHelp_L("DIR .COM")
  ManualsHelp_L("")
  ManualsHelp_L("     No main  filename was  given, and so defaults to *. Thus this command is ")
  ManualsHelp_L("equivalent to the command DIR *.COM.")
  ManualsHelp_L("")
  ManualsHelp_L("DIR COMMAND2")
  ManualsHelp_L("")
  ManualsHelp_L("     No  extension was  given, so  this defaults  to .*. Thus this command is ")
  ManualsHelp_L("equivalent to the command DIR COMMAND2.*.")
  ManualsHelp_L("")
  ManualsHelp_L("DISKCOPY")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     DISKCOPY [d: [d:]] [/X]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Copies one disk to another.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The first  drive is  the source  drive and  the second  the destination, ")
  ManualsHelp_L("which  defaults to  the current  drive. If no drives are given, then DISKCOPY ")
  ManualsHelp_L("will prompt for both the source and the destination.")
  ManualsHelp_L("")
  ManualsHelp_L("     Before DISKCOPY is used, the destination disk must be formatted with the ")
  ManualsHelp_L("same format as the source disk, and an error will be given if this is not the ")
  ManualsHelp_L("case.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  /X  is given,  then various  messages printed  during the  disk copy ")
  ManualsHelp_L("operation will be suppressed.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note that this is a transient command, and must therefore be loaded from ")
  ManualsHelp_L("disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("     DISKCOPY A: B:")
  ManualsHelp_L("")
  ManualsHelp_L("Insert source disk in drive A:")
  ManualsHelp_L("")
  ManualsHelp_L("Insert target disk in drive B:")
  ManualsHelp_L("")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     The command  was given to copy the disk in drive A: to the disk in drive ")
  ManualsHelp_L("B:,  thus destroying  all existing data on the disk in drive B: The prompt is ")
  ManualsHelp_L("printed first.")
  ManualsHelp_L("")
  ManualsHelp_L("DISKCOPY B:")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk in drive B: is copied to the disk in the current drive.")
  ManualsHelp_L("")
  ManualsHelp_L("DISKCOPY")
  ManualsHelp_L("Enter source drive:")
  ManualsHelp_L("Enter target drive:")
  ManualsHelp_L("")
  ManualsHelp_L("     The DISKCOPY  command was  given with  no parameters,  so the source and ")
  ManualsHelp_L("destination  disks were  prompted for.  The reply  to the prompts consists of ")
  ManualsHelp_L("just a single drive letter.")
  ManualsHelp_L("")
  ManualsHelp_L("ECHO")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     ECHO [text]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Prints text.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The text  is simply  displayed on  the screen. If no text is given, then ")
  ManualsHelp_L("just a blank line is output.")
  ManualsHelp_L("")
  ManualsHelp_L("     This  command should  not be  confused with  the 'echo'  state in  batch ")
  ManualsHelp_L("files, which  is controlled by an environment item called ECHO (see chapter 7 ")
  ManualsHelp_L("on Environment Items).")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("ECHO AUTOEXEC batch file executed")
  ManualsHelp_L("AUTOEXEC batch file executed")
  ManualsHelp_L("")
  ManualsHelp_L("     The  specified text  ('AUTOEXEC batch file executed') was printed on the ")
  ManualsHelp_L("screen.")
  ManualsHelp_L("")
  ManualsHelp_L("ECHO")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters were given, so just a blank line was printed.")
  ManualsHelp_L("")
  ManualsHelp_L("ERA")
  ManualsHelp_L("")
  ManualsHelp_L("     See ERASE.")
  ManualsHelp_L("")
  ManualsHelp_L("ERASE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     ERASE [/H] [/P] compound-filespec")
  ManualsHelp_L("              or")
  ManualsHelp_L("     DEL [/H] [/P] compound-filespec")
  ManualsHelp_L("              or")
  ManualsHelp_L("     ERA [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Deletes one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec  specifies which  files are  to be deleted. The /H ")
  ManualsHelp_L("option allows hidden files to also be deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("     During the delete operation, if a file cannot be deleted for some reason ")
  ManualsHelp_L("(eg. it  is set  to 'read only') then the offending filename is printed along ")
  ManualsHelp_L("with an error message, and the delete operation continues with the next file. ")
  ManualsHelp_L("If  many such errors occur, then the /P option will cause the output to pause ")
  ManualsHelp_L("at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     If the filename is *.*, then the prompt:")
  ManualsHelp_L("")
  ManualsHelp_L("          Erase all files (Y/N) ?")
  ManualsHelp_L("")
  ManualsHelp_L("is printed,  and a  reply is  waited for. If the reply is anything other than ")
  ManualsHelp_L("'Y'  or 'y',  then the  file deletion  does not  take place. This is a safety ")
  ManualsHelp_L("feature designed to prevent accidental loss of all files in a directory.")
  ManualsHelp_L("")
  ManualsHelp_L("     If files  are deleted unintentionally on a disk that was formatted under ")
  ManualsHelp_L("MSX-DOS  2, then  the UNDEL  command may  be used  immediately afterwards  to ")
  ManualsHelp_L("restore them again.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("ERASE FILE1.BAK")
  ManualsHelp_L("")
  ManualsHelp_L("     The file  FILE1.BAK is deleted from the current directory of the current ")
  ManualsHelp_L("drive.")
  ManualsHelp_L("")
  ManualsHelp_L("DEL *.COM/H")
  ManualsHelp_L("")
  ManualsHelp_L("     All files matching *.COM, both hidden and not hidden, are deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("DEL B:\UTIL\*.COM + B:\UTIL\*.BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files matching *.COM or *.BAT are deleted from the directory called ")
  ManualsHelp_L("UTIL on drive B:.")
  ManualsHelp_L("")
  ManualsHelp_L("DEL B:\UTIL")
  ManualsHelp_L("     Erase all files (Y/N) ? ")
  ManualsHelp_L("")
  ManualsHelp_L("     All files in the directory called UTIL on drive B: are deleted. Since so ")
  ManualsHelp_L("many  files  are  being  deleted,  a  prompt is  printed first  to prevent  a ")
  ManualsHelp_L("catastrophe.")
  ManualsHelp_L("")
  ManualsHelp_L("DEL *.BAT")
  ManualsHelp_L("AUTOEXEC.BAT -- Read only file")
  ManualsHelp_L("REBOOT.BAT -- Read only file")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files  matching  *.BAT  are  deleted  except  for  AUTOEXEC.BAT and ")
  ManualsHelp_L("REBOOT.BAT which have been marked as read only.")
  ManualsHelp_L("")
  ManualsHelp_L("EXIT")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          EXIT [number]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Exits COMMAND2.COM to the invoking program.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  number  is  an  error  code  and defaults  to 0,  which in  MSX-DOS ")
  ManualsHelp_L("indicates no error (see chapter 8 on Errors).")
  ManualsHelp_L("")
  ManualsHelp_L("     EXIT exits  the command interpreter (COMMAND2.COM) and returns the error ")
  ManualsHelp_L("code  to the program that originally loaded and executed it (see the COMMAND2 ")
  ManualsHelp_L("command). This  may be  another COMMAND2.COM,  another program  or, normally, ")
  ManualsHelp_L("MSXDOS2.SYS. In the latter case, an appropriate error message will be printed ")
  ManualsHelp_L("and COMMAND2.COM simply reloaded and executed.")
  ManualsHelp_L("")
  ManualsHelp_L("     COMMAND2.COM when loaded saves the current environment (see chapter 7 on ")
  ManualsHelp_L("Environment  Items),  and EXIT  restores it.  Thus, when  EXIT exits  back to ")
  ManualsHelp_L("MSXDOS2.SYS (that is, EXIT is executed at the primary level), the environment ")
  ManualsHelp_L("will be  cleared. COMMAND2.COM  will then  be reloaded  and will  set up  the ")
  ManualsHelp_L("default environment again, providing a method of resetting the environment to ")
  ManualsHelp_L("it's default values.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("EXIT")
  ManualsHelp_L("")
  ManualsHelp_L("     The  command interpreter  is exited.  What happens  next depends on what ")
  ManualsHelp_L("loaded it.")
  ManualsHelp_L("")
  ManualsHelp_L("EXIT 40")
  ManualsHelp_L("*** User error 40")
  ManualsHelp_L("")
  ManualsHelp_L("The command  interpreter is  exited with an error code of 40. Since this does ")
  ManualsHelp_L("not  correspond to an error that is known to the system, the error message is ")
  ManualsHelp_L("printed by  whatever loaded  the command  interpreter in the first place (see ")
  ManualsHelp_L("chapter 8 on Errors).")
  ManualsHelp_L("")
  ManualsHelp_L("FIXDISK")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     FIXDISK [d:] [/S]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Updates a disk to the full MSX-DOS 2 format.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     d:  specifies the  drive on  which FIXDISK  is to  operate. If d: is not ")
  ManualsHelp_L("specified, the current drive will be assumed. /S option causes the disk to be ")
  ManualsHelp_L("updated to full MSX-DOS 2 disk.")
  ManualsHelp_L("")
  ManualsHelp_L("     This command  is mainly used to update MSX-DOS 1 disks to full MSX-DOS 2 ")
  ManualsHelp_L("compatibility,  but may  also be useful for updating other disks of a similar ")
  ManualsHelp_L("format or reparing incorrect boot sector.")
  ManualsHelp_L("")
  ManualsHelp_L("     Although   the  disk   format  used  by  MSX-DOS  1  and  MSX-DOS  2  is ")
  ManualsHelp_L("standardized, MSX-DOS  1 does not use the information stored on certain parts ")
  ManualsHelp_L("of  the disk  (the boot  sector) and  so this  information is not necessarily ")
  ManualsHelp_L("correct on  MSX-DOS 1  disks. This  can cause problems when MSX-DOS 2 is used ")
  ManualsHelp_L("with  these disks.  Additionally, the  MSX-DOS 2 UNDEL command will only work ")
  ManualsHelp_L("with disks that were formatted using MSX-DOS 2 (ie. disks that have a 'volume ")
  ManualsHelp_L("id' in  the boot  sector) and  so will not work with MSX-DOS 1 disks or disks ")
  ManualsHelp_L("formatted on other systems.")
  ManualsHelp_L("")
  ManualsHelp_L("     The FIXDISK  command will  update a  disk so  that it is fully MSX-DOS 2 ")
  ManualsHelp_L("compatible,  and it's  use will allow full use of MSX-DOS 2 disk features. If ")
  ManualsHelp_L("/S option  is specified,  the boot  program will  be updated for MSX-DOS 2 so ")
  ManualsHelp_L("that  the features  of MSX-DOS  2 disk  can fully  work. When a disk has been ")
  ManualsHelp_L("updated in  this way,  however, it may no longer be fully compatible with the ")
  ManualsHelp_L("original  system. For  example, if /S option is specified against the disk of ")
  ManualsHelp_L("the application which uses non-standard boot program, such as some games, the ")
  ManualsHelp_L("application will no longer be booted, although it will still be able to start ")
  ManualsHelp_L("MSX-DOS 1 or MSX-DOS 2.")
  ManualsHelp_L("")
  ManualsHelp_L("     To help  prevent accidental  updates of boot disks from other systems, a ")
  ManualsHelp_L("prompt is issued before updating a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("FIXDISK B: /S")
  ManualsHelp_L("Disk in drive B: will only be able to boot MSX-DOS 2")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     Drive  B: will  be updated  to be  fully MSX-DOS 2 compatible. Since the ")
  ManualsHelp_L("disk may have been a boot disk from another system, a prompt is issued before ")
  ManualsHelp_L("the disk is actually updated.")
  ManualsHelp_L("")
  ManualsHelp_L("FORMAT")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     FORMAT [d:]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Formats (initializes) a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The specified  or current  drive is  formatted, and all data on the disk ")
  ManualsHelp_L("will be destroyed.")
  ManualsHelp_L("")
  ManualsHelp_L("     After giving  a FORMAT  command, an option may be prompted for, allowing ")
  ManualsHelp_L("the  required format  of the  disk (such  as 1DD  or 2DD) to be selected. The ")
  ManualsHelp_L("exact nature of these prompts depends on the manufacturer of the MSX machine, ")
  ManualsHelp_L("so obey the descriptions of the manual of the machine when you want to format ")
  ManualsHelp_L("the disk.")
  ManualsHelp_L("")
  ManualsHelp_L("     After formatting, there will be no files or directories on the disk, and ")
  ManualsHelp_L("the  maximum amount  of disk  space will  be free.  The disk  will not have a ")
  ManualsHelp_L("volume name, but can be given one with the VOL command. To turn the disk into ")
  ManualsHelp_L("a boot  disk so that MSX-DOS can be started up from it, the files MSXDOS2.SYS ")
  ManualsHelp_L("and COMMAND2.COM must be copied onto it with the COPY command.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("FORMAT B:")
  ManualsHelp_L("1 - Single sided")
  ManualsHelp_L("2 - Double sided")
  ManualsHelp_L("? 2")
  ManualsHelp_L("All data on drive B: will be destroyed")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     The  command was given to format the disk in drive B:. In this case, the ")
  ManualsHelp_L("options available  were to  select either  double sided  or single sided, and ")
  ManualsHelp_L("double sided was selected. The standard warning prompt was then printed.")
  ManualsHelp_L("")
  ManualsHelp_L("FORMAT")
  ManualsHelp_L("")
  ManualsHelp_L("     This will format the current drive after the prompts given above.")
  ManualsHelp_L("")
  ManualsHelp_L("HELP")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     HELP [subject]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Provides on-line help for an MSX-DOS feature.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If no parameter is given, then a list of standard subjects on which help ")
  ManualsHelp_L("is  available is printed. This includes all the commands and the major system ")
  ManualsHelp_L("features.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  subject is specified, then help text on this subject is printed on ")
  ManualsHelp_L("the  screen from  a 'help  file'. This  will pause at the end of every screen ")
  ManualsHelp_L("until a key is pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("     Help files have a filename of:")
  ManualsHelp_L("")
  ManualsHelp_L("          subject.HLP")
  ManualsHelp_L("")
  ManualsHelp_L("and are  located by  default on the standard MSX-DOS boot disk in a directory ")
  ManualsHelp_L("called HELP.")
  ManualsHelp_L("")
  ManualsHelp_L("     An environment item called HELP is set up initially to refer to the HELP ")
  ManualsHelp_L("directory  (see chapter 7 on Environment Items). This can be changed with the ")
  ManualsHelp_L("SET command to refer to any other directory or disk if required.")
  ManualsHelp_L("")
  ManualsHelp_L("     Any HELP  subject can  be added  by the  user for  his own use simply by ")
  ManualsHelp_L("adding the appropriate .HLP file in the HELP directory. The help file will be ")
  ManualsHelp_L("displayed very much like the TYPE command would display it.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("HELP")
  ManualsHelp_L("")
  ManualsHelp_L("     A  general help  screen is printed. This lists all the subjects on which ")
  ManualsHelp_L("help  is  available, including  the standard  commands and  main features  of ")
  ManualsHelp_L("MSX-DOS. The user-supplied subjects are not available here.")
  ManualsHelp_L("")
  ManualsHelp_L("HELP XCOPY")
  ManualsHelp_L("")
  ManualsHelp_L("     Help  information  on  the  XCOPY command  is printed.  This includes  a ")
  ManualsHelp_L("description of how to use the command and what options are available.")
  ManualsHelp_L("")
  ManualsHelp_L("HELP ME")
  ManualsHelp_L("*** File for HELP not found")
  ManualsHelp_L("")
  ManualsHelp_L("     This command  caused HELP to look for a file called ME.HLP from which to ")
  ManualsHelp_L("get  the help  text, but  did not  find it  so printed the error message. The ")
  ManualsHelp_L("files containing the help text are normally found in a directory called \HELP ")
  ManualsHelp_L("on the  drive from  which MSX-DOS was booted, and any other help files may be ")
  ManualsHelp_L("added  if required.  If ME.HLP  was added  then HELP ME would print it on the ")
  ManualsHelp_L("screen.")
  ManualsHelp_L("")
  ManualsHelp_L("MD")
  ManualsHelp_L("")
  ManualsHelp_L("     See MKDIR")
  ManualsHelp_L("")
  ManualsHelp_L("MKDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     MKDIR [d:] path")
  ManualsHelp_L("           or")
  ManualsHelp_L("     MD [d:] path")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Creates a new sub-directory.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  last item in the path is the name of the new sub-directory which is ")
  ManualsHelp_L("to be  created on  the current  or specified  drive. Thus if this is the only ")
  ManualsHelp_L("item  in the  path, the new directory is created in the current directory. If ")
  ManualsHelp_L("the new  directory is  to be  hidden, then  it must be separately made hidden ")
  ManualsHelp_L("with the ATDIR command.")
  ManualsHelp_L("")
  ManualsHelp_L("     When a  new directory  is created,  it is  empty except  for two special ")
  ManualsHelp_L("sub-directories  called '.'  and '..'. These are automatically created in the ")
  ManualsHelp_L("directory and  it is  these that allow '.' and '..' to be given in path names ")
  ManualsHelp_L("to  signify the current and parent directories respectively (see chapter 3 on ")
  ManualsHelp_L("Notation for a description of paths).")
  ManualsHelp_L("")
  ManualsHelp_L("     The MD  command is an abbreviated form of the MKDIR command provided for ")
  ManualsHelp_L("convenience and MS-DOS compatibility.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("MKDIR UTIL")
  ManualsHelp_L("")
  ManualsHelp_L("     A  directory called  UTIL is  created in  the current  directory of  the ")
  ManualsHelp_L("current drive.")
  ManualsHelp_L("")
  ManualsHelp_L("MKDIR A:\UTIL\RAM")
  ManualsHelp_L("")
  ManualsHelp_L("     A directory  called RAM  is created  in the  UTIL directory  in the root ")
  ManualsHelp_L("directory of drive A:.")
  ManualsHelp_L("")
  ManualsHelp_L("MODE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     MODE number")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Changes the number of characters/line on the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  number must  be in  the range  1 to 80 inclusive, and the number of ")
  ManualsHelp_L("characters per  line on  the screen  will be  set to this. The screen will be ")
  ManualsHelp_L("cleared and the cursor moved to the top left corner in the process.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("MODE 80")
  ManualsHelp_L("(or MODE=80)")
  ManualsHelp_L("")
  ManualsHelp_L("     The screen is set to 80 column mode and is cleared in the process.")
  ManualsHelp_L("")
  ManualsHelp_L("MODE 25")
  ManualsHelp_L("(or MODE=25)")
  ManualsHelp_L("     The screen is set to 25 columns.")
  ManualsHelp_L("")
  ManualsHelp_L("MOVE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     MOVE [/H] [/P] compound-filespec [path]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Moves files from one place to another on a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  compound-filespec specifies  which files  are to  be moved,  and /H ")
  ManualsHelp_L("allows hidden files to be included in the move.")
  ManualsHelp_L("")
  ManualsHelp_L("     The path specifies the directory to which the files are to be moved, the ")
  ManualsHelp_L("current directory  being used  if this  is not  given. The path must exist on ")
  ManualsHelp_L("each drive referenced by the filespecs in the compound-filespec.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  a  particular file  cannot be  moved into  the specified  or current ")
  ManualsHelp_L("directory (eg.  if a file of the same name already exists) then the offending ")
  ManualsHelp_L("filename  is printed  along with  an error  message, and  the move  operation ")
  ManualsHelp_L("continues with  the next  file. If many errors occur, then the /P option will ")
  ManualsHelp_L("cause the output to pause at the bottom of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("MOVE FILE1 \ ")
  ManualsHelp_L("")
  ManualsHelp_L("     The  file FILE1 is moved from the current directory of the current drive ")
  ManualsHelp_L("to the root directory of the current drive.")
  ManualsHelp_L("")
  ManualsHelp_L("MOVE /H /P E:*.COM \ ")
  ManualsHelp_L("COMMAND2.COM -- File exists")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files matching  *.COM, both  hidden and  not hidden, in the current ")
  ManualsHelp_L("directory of drive E: are moved to the root directory of that drive. The file ")
  ManualsHelp_L("COMMAND2.COM already existed in the root directory, so the error was printed. ")
  ManualsHelp_L("Neither of  the COMMAND2.COM files were moved or altered. If many such errors ")
  ManualsHelp_L("had occurred then a prompt would have been printed after a screen full.")
  ManualsHelp_L("")
  ManualsHelp_L("MOVE \UTIL\*.COM + \UTIL\*.BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files matching  *.COM or  *.BAT in  a directory  called UTIL on the ")
  ManualsHelp_L("current drive are moved to the current directory of that drive.")
  ManualsHelp_L("")
  ManualsHelp_L("MVDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     MVDIR [/H] [/P] compound-filespec [path]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Moves directories from one place to another on a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec  specifies which  directories are to be moved, and ")
  ManualsHelp_L("/H allows hidden directories to be included in the move.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  second parameter specifies the directory into which the directories ")
  ManualsHelp_L("are to  be moved,  the current directory being used if this is not given. The ")
  ManualsHelp_L("path  must exist  on each  drive referenced  by the filespecs in the compound ")
  ManualsHelp_L("filepecs.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  particular directory cannot be moved into the specified or current ")
  ManualsHelp_L("directory  (eg. if  a directory  of the  same name  already exists)  then the ")
  ManualsHelp_L("offending directory name is printed along with an error message, and the move ")
  ManualsHelp_L("operation continues  with the  next directory. If many errors occur, then the ")
  ManualsHelp_L("/P option will cause the output to pause at the bottom of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note  that it  is not  possible to move a directory into one of it's own ")
  ManualsHelp_L("descendant directories,  as this would produce an invalid sub-directory tree. ")
  ManualsHelp_L("An error is given if this is attempted.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("MVDIR COM UTIL")
  ManualsHelp_L("")
  ManualsHelp_L("     A  directory called  COM and  all descendant  directories and  files are ")
  ManualsHelp_L("moved into  a directory  called UTIL,  both directories  being in the current ")
  ManualsHelp_L("directory of the current drive.")
  ManualsHelp_L("")
  ManualsHelp_L("MVDIR \COM + \BAT \UTIL")
  ManualsHelp_L("")
  ManualsHelp_L("     A  directory  called  COM and  a directory  called BAT,  and both  their ")
  ManualsHelp_L("contents, are moved into a directory called UTIL.")
  ManualsHelp_L("")
  ManualsHelp_L("MVDIR E:DIR?/H/P ALL")
  ManualsHelp_L("DIR2 -- Duplicate filename")
  ManualsHelp_L("")
  ManualsHelp_L("     All  directories in  drive E  matching DIR?  (eg. DIR1,  DIR2 and DIR3), ")
  ManualsHelp_L("which may  be hidden,  and the  contents of the directories, are moved into a ")
  ManualsHelp_L("directory  called ALL.  A directory called DIR2 already existed in ALL so the ")
  ManualsHelp_L("error was printed. Neither of the DIR2 directories were affected at all.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     PATH [ [+|-] [d:]path [ [d:]path [ [d:]path ...]] ]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or sets the COM and BAT command search path.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If no  parameters are specified, then the search path currently set will ")
  ManualsHelp_L("be displayed, separated by semi-colons (';').")
  ManualsHelp_L("")
  ManualsHelp_L("     If  + or - is not given, then the search path will be set to the list of ")
  ManualsHelp_L("path names given and any existing search path will be deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("     If -  is given before the list of paths, then each path in the list will ")
  ManualsHelp_L("be  deleted from the currently set search path, and an error will be given if ")
  ManualsHelp_L("any of the given paths do not already exist.")
  ManualsHelp_L("")
  ManualsHelp_L("     If +  is given  before the  list of paths, then each path specified will ")
  ManualsHelp_L("first  be deleted  from the  currently set search path if it exists, and will ")
  ManualsHelp_L("then be  added onto the end. This allows the order of the paths in the search ")
  ManualsHelp_L("path  to be  changed and  allows new  paths to  be appended to the end of the ")
  ManualsHelp_L("current search  path. The  + syntax  can also  be used  to set  a search path ")
  ManualsHelp_L("longer  than can  be given  in one  command, the maximum length of the search ")
  ManualsHelp_L("path being 255 characters and the maximum length of a command 127 characters. ")
  ManualsHelp_L("")
  ManualsHelp_L("     When  searching for  a COM  or BAT file, the paths in the current search ")
  ManualsHelp_L("path will  be used  in order  from left  to right. It is recommended that the ")
  ManualsHelp_L("paths  in the  search path  are specified  as full paths starting at the root ")
  ManualsHelp_L("directory and  with the  drive specified.  If this  is not the case, then the ")
  ManualsHelp_L("meaning  of the  search path could change when the current drive or directory ")
  ManualsHelp_L("is changed.")
  ManualsHelp_L("")
  ManualsHelp_L("     The search  path is  stored as  an environment  item (see  chapter 7  on ")
  ManualsHelp_L("Environment Items), and so can also be accessed with the SET command.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("PATH E:\COM E:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     When a COM or BAT command is next searched for, the directories searched ")
  ManualsHelp_L("will  be the current directory of the current drive, the COM directory in the ")
  ManualsHelp_L("root directory  of drive  E: and  the BAT  directory in the root directory of ")
  ManualsHelp_L("drive E:, in that order.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH")
  ManualsHelp_L("; E:\COM; E:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters were given so the current search path was printed.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH +A:\COM; A:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The  directories A:\COM  and A:\BAT  are added  to the end of the search ")
  ManualsHelp_L("path.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH")
  ManualsHelp_L("; E:\COM; E:\BAT; A:\COM; A:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The new search path is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH -E:\COM, E:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The directories  E:\COM and  E:\BAT are  deleted from the current search ")
  ManualsHelp_L("path.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH")
  ManualsHelp_L(" ; A:\COM; A:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The new search path is again printed.")
  ManualsHelp_L("")
  ManualsHelp_L("PAUSE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     PAUSE [comment]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Prompts and waits for a key press in a batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The comment consists of an arbitrary sequence of characters.")
  ManualsHelp_L("")
  ManualsHelp_L("     The comment,  if given, is printed followed by the prompt 'Press any key ")
  ManualsHelp_L("to  continue... ' on the next line. The system will then wait for a key to be ")
  ManualsHelp_L("pressed and  will echo  the key pressed if it is a printable character. If no ")
  ManualsHelp_L("comment is given as a parameter, then just the prompt will be printed.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  main use  of this  command is  to issue prompts from within a batch ")
  ManualsHelp_L("file.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("PAUSE")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     No comment was given, so just the prompt was printed.")
  ManualsHelp_L("")
  ManualsHelp_L("PAUSE Insert document disk in drive B:")
  ManualsHelp_L("Insert document disk in drive B:")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     The comment  given was  'Insert document  disk in  drive B:' so this was ")
  ManualsHelp_L("printed followed by the prompt.")
  ManualsHelp_L("")
  ManualsHelp_L("RAMDISK")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     RAMDISK [number[K]] [/D]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or sets the RAM disk size.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If  no parameters  are given, then the current RAMDISK size is displayed ")
  ManualsHelp_L("as the number of kilobytes.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  number, if  given, specifies the maximum size for the new RAM disk, ")
  ManualsHelp_L("and is  specified in kilobytes. The range is 0 to 4064. If the number is 0 or ")
  ManualsHelp_L("only  /D is  specified, the  RAM disk  will be  deleted. This  number will be ")
  ManualsHelp_L("rounded up  to the  nearest multiple  of 16K  since the  RAM disk is always a ")
  ManualsHelp_L("multiple  of 16K.  A RAM  disk smaller then the specified maximum size may be ")
  ManualsHelp_L("created if there is not enough free memory for the full size, although a 'not ")
  ManualsHelp_L("enough memory' error will be given if there is no memory at all available for ")
  ManualsHelp_L("the RAM  disk. Note that the number specified is the maximum amount of RAM to ")
  ManualsHelp_L("use  for the  RAM disk,  which is  not the same as the maximum amount of free ")
  ManualsHelp_L("space available  on the  newly-created RAM disk since the system needs to use ")
  ManualsHelp_L("some for FAT or directories.")
  ManualsHelp_L("")
  ManualsHelp_L("     On MSX machines with 128K RAM, the maximum amount of RAM disk is 32K.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  a  RAM  disk already  exists before  a new  one is  created, then  a ")
  ManualsHelp_L("'Destroy  all data  on RAM disk (Y/N)?' prompt is printed to avoid accidental ")
  ManualsHelp_L("loss of  data. /D  can be  given which will automatically delete any existing ")
  ManualsHelp_L("RAM disk first, thus suppressing the prompt.")
  ManualsHelp_L("")
  ManualsHelp_L("     Having created a RAM disk, it can be referred to as drive H:.")
  ManualsHelp_L("")
  ManualsHelp_L("     The RAMDISK command is normally only used in an AUTOEXEC.BAT batch file, ")
  ManualsHelp_L("with a  large number  specified so  that as  large a  RAMDISK as  possible is ")
  ManualsHelp_L("created.  It is  not advisable  to keep  any data  on a RAM disk except for a ")
  ManualsHelp_L("short length of time that is not also kept on a floppy disk, since it will be ")
  ManualsHelp_L("lost if, for example, the power to the computer fails.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("RAMDISK")
  ManualsHelp_L("RAMDISK=160K")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters  were given,  so the current size is printed, in this case ")
  ManualsHelp_L("160K.")
  ManualsHelp_L("")
  ManualsHelp_L("     RAMDISK")
  ManualsHelp_L("*** RAM disk does not exist")
  ManualsHelp_L("")
  ManualsHelp_L("     No  parameters were given but no RAM disk has been created, so the error ")
  ManualsHelp_L("is given.")
  ManualsHelp_L("")
  ManualsHelp_L("RAMDISK = 300")
  ManualsHelp_L("Destroy all data on RAM disk (Y/N)? y")
  ManualsHelp_L("")
  ManualsHelp_L("     A RAM disk already existed, so the prompt was printed. In this case, the ")
  ManualsHelp_L("reply was 'y' so the current RAM disk was deleted and the new one set up with ")
  ManualsHelp_L("a maximum size of 300K.")
  ManualsHelp_L("")
  ManualsHelp_L("RD")
  ManualsHelp_L("")
  ManualsHelp_L("     See RMDIR")
  ManualsHelp_L("")
  ManualsHelp_L("REM")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     REM [comment]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Introduces a comment in a batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  comment  is  simply  ignored, and  the next  command executed.  The ")
  ManualsHelp_L("comment consists  of a sequence of any characters up to the maximum length of ")
  ManualsHelp_L("a command line (127 characters).")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("REM This is my AUTOEXEC batch file")
  ManualsHelp_L("")
  ManualsHelp_L("     This  command, either  in a  batch file or typed in, does nothing at all ")
  ManualsHelp_L("with it's parameters.")
  ManualsHelp_L("")
  ManualsHelp_L("REN")
  ManualsHelp_L("")
  ManualsHelp_L("     See RENAME")
  ManualsHelp_L("")
  ManualsHelp_L("RENAME")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     RENAME [/H] [/P] compound-filespec filename")
  ManualsHelp_L("                    or")
  ManualsHelp_L("     REN [/H] [/P] compound-filespec filename")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Renames one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec specifies the files that are to be renamed, and /H ")
  ManualsHelp_L("allows hidden files to be included in the rename operation.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  second filename  specifies the new name for the files. A '?' in the ")
  ManualsHelp_L("new name  indicates that  the corresponding character from the filename being ")
  ManualsHelp_L("renamed  will be  used, thus  allowing an  ambiguous rename.  Thus '*' in the ")
  ManualsHelp_L("second filename, which is just equivalent to a series of '?'s, indicates that ")
  ManualsHelp_L("the whole of the filename or extension will remain unchanged.")
  ManualsHelp_L("")
  ManualsHelp_L("     If for some reason a particular file cannot be renamed (eg. if a file or ")
  ManualsHelp_L("directory  with the  new name  already exists or they are read-only) then the ")
  ManualsHelp_L("offending filename will be printed along with an error message and the rename ")
  ManualsHelp_L("operation will  continue with  the next  file. If  many errors occur, then /P ")
  ManualsHelp_L("will cause the output to pause at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("RENAME FILE1 FILE2")
  ManualsHelp_L("")
  ManualsHelp_L("     The  file FILE1 in the current directory of the current drive is renamed ")
  ManualsHelp_L("to FILE2.")
  ManualsHelp_L("")
  ManualsHelp_L("REN B:\DIR1\*.DOC/H/P *.OLD")
  ManualsHelp_L("FILE2.DOC -- Duplicate filename")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files  matching  *.DOC  in the  directory called  DIR1 in  the root ")
  ManualsHelp_L("directory of drive B:, including hidden files, are renamed with the same main ")
  ManualsHelp_L("name but  with an  extension of .OLD. The file FILE2.DOC could not be renamed ")
  ManualsHelp_L("because  there was  already a  file called FILE2.OLD in the directory, so the ")
  ManualsHelp_L("error was  printed. Neither  FILE2.DOC nor  FILE2.OLD was  altered at all. If ")
  ManualsHelp_L("many  such errors  had been printed, then a prompt would have been printed at ")
  ManualsHelp_L("the bottom of every screen full, since /P was given.")
  ManualsHelp_L("")
  ManualsHelp_L("     REN DOC + FILE1 *.OLD")
  ManualsHelp_L("")
  ManualsHelp_L("     All files  in the  directory called  DOC and the file FILE1, both in the ")
  ManualsHelp_L("current  directory of  the current  drive, and  renamed with  an extension of ")
  ManualsHelp_L(".OLD.")
  ManualsHelp_L("")
  ManualsHelp_L("RMDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     RMDIR [/H] [/P] compound-filespec")
  ManualsHelp_L("                    or")
  ManualsHelp_L("     RD [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Removes one or more sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec specifies which directories are to be deleted, and ")
  ManualsHelp_L("/H allows hidden directories to be included in the delete operation.")
  ManualsHelp_L("")
  ManualsHelp_L("     In  order to delete a directory, it must contain no other files or other ")
  ManualsHelp_L("directories except  for the special '.' and '..' directories which are always ")
  ManualsHelp_L("contained in a directory. These are put in a new directory when it is created ")
  ManualsHelp_L("and cannot be removed. It is these that allow '.' and '..' to be used in path ")
  ManualsHelp_L("names to specify the current and parent directories respectively (see chapter ")
  ManualsHelp_L("3 on Notation for a description of paths).")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  directory cannot  be deleted for some reason (eg. it is not empty) ")
  ManualsHelp_L("then  the name  of the  offending directory  is printed  along with  an error ")
  ManualsHelp_L("message, and  the delete operation continues with the next directory. If many ")
  ManualsHelp_L("errors occur then /P will cause the output to pause at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("RMDIR DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     The  directory called DIR1 in the current directory of the current drive ")
  ManualsHelp_L("is removed.")
  ManualsHelp_L("")
  ManualsHelp_L("RD B:\COM + B:\BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The directories COM and BAT are removed from the root directory of drive ")
  ManualsHelp_L("B:.")
  ManualsHelp_L("")
  ManualsHelp_L("RD \*.*")
  ManualsHelp_L("UTIL -- Directory not empty")
  ManualsHelp_L("")
  ManualsHelp_L("     An attempt was made to remove all directories from the root directory of ")
  ManualsHelp_L("the current drive, but a directory called UTIL was not empty and so the error ")
  ManualsHelp_L("was printed. UTIL and it's contents are not affected at all.")
  ManualsHelp_L("")
  ManualsHelp_L("RNDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     RNDIR [/H] [/P] compound-filespec filename")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Renames one or more sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The compound-filespec  specifies the directories that are to be renamed, ")
  ManualsHelp_L("and  /H allows hidden directories to be included in the rename operation. The ")
  ManualsHelp_L("contents of the directories remain unchanged.")
  ManualsHelp_L("")
  ManualsHelp_L("     The second filename specifies the new name for the directories. A '?' in ")
  ManualsHelp_L("the  new name indicates that the corresponding character from the name of the ")
  ManualsHelp_L("directory being renamed will be used, thus allowing an ambiguous rename. Thus ")
  ManualsHelp_L("'*' in  the second  filename, which  is just  equivalent to a series of '?'s, ")
  ManualsHelp_L("indicates  that the  whole of the filename or extension of the directory name ")
  ManualsHelp_L("will remain unchanged.")
  ManualsHelp_L("")
  ManualsHelp_L("     If for  some reason  a particular  directory cannot be renamed (eg. if a ")
  ManualsHelp_L("file  or  directory  of  the  new  name  already exists)  then the  offending ")
  ManualsHelp_L("directory  name will  be printed  along with  an error message and the rename ")
  ManualsHelp_L("operation will  continue with  the next directory. If many errors occur, then ")
  ManualsHelp_L("/P will cause the output to pause at the end of the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("RNDIR UTIL COM")
  ManualsHelp_L("")
  ManualsHelp_L("     The  directory called UTIL in the current directory of the current drive ")
  ManualsHelp_L("is renamed COM.")
  ManualsHelp_L("")
  ManualsHelp_L("RNDIR A:\*.*/H/P *.OLD")
  ManualsHelp_L("UTIL -- Duplicate filename")
  ManualsHelp_L("")
  ManualsHelp_L("     All directories,  hidden and  not hidden, in the root directory of drive ")
  ManualsHelp_L("A:  are renamed  with an  extension of  .OLD. The directory UTIL could not be ")
  ManualsHelp_L("renamed because a directory called UTIL.OLD already existed, so the error was ")
  ManualsHelp_L("printed. If  many such errors were printed then /P would cause a prompt to be ")
  ManualsHelp_L("printed at the end of every screen full.")
  ManualsHelp_L("")
  ManualsHelp_L("RNDIR COM + BAT *.OLD")
  ManualsHelp_L("")
  ManualsHelp_L("     The  directories  COM  and  BAT  are  renamed  to  COM.OLD  and  BAT.OLD ")
  ManualsHelp_L("respectively.")
  ManualsHelp_L("")
  ManualsHelp_L("SET")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     SET [name] [separator] [value]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays/sets environment items.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If no parameters are given, then all currently defined environment items ")
  ManualsHelp_L("and their current values are displayed. Initially there are several items set ")
  ManualsHelp_L("up to default values (see chapter 7 on Environment Items).")
  ManualsHelp_L("")
  ManualsHelp_L("     If  just a name is given as the parameter, then the current value of the ")
  ManualsHelp_L("specified environment item is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If the  name is  followed by  a separator, then the separator is ignored ")
  ManualsHelp_L("and  the name  is set  to the following value. If the value is blank (ie. not ")
  ManualsHelp_L("given) then the environment item is deleted from the environment space.")
  ManualsHelp_L("")
  ManualsHelp_L("     The area  of memory  used for  environment items  is also  used for disk ")
  ManualsHelp_L("buffers.  Thus  if  a 'not  enough memory'  error occurs  when using  the SET ")
  ManualsHelp_L("command,  then it  may help  to reduce  the number  of disk  buffers (see the ")
  ManualsHelp_L("BUFFERS command).")
  ManualsHelp_L("")
  ManualsHelp_L("     Chapter  7  contains more  information about  environment items  and the ")
  ManualsHelp_L("items and values that are set up by default.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("     SET")
  ManualsHelp_L("     ECHO=OFF")
  ManualsHelp_L("     PROMPT=OFF")
  ManualsHelp_L("     PATH=;")
  ManualsHelp_L("     TIME=12")
  ManualsHelp_L("     DATE=yy-mm-dd")
  ManualsHelp_L("     HELP=A:\HELP")
  ManualsHelp_L("     SHELL=A:\COMMAND2.COM")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters  were given,  so all  the currently  set environment items ")
  ManualsHelp_L("were printed, in this case typical default values.")
  ManualsHelp_L("")
  ManualsHelp_L("SET HELP=A:\HELP")
  ManualsHelp_L("")
  ManualsHelp_L("     An item called HELP is set to the value A:\HELP.")
  ManualsHelp_L("")
  ManualsHelp_L("SET HELP")
  ManualsHelp_L("A:\HELP")
  ManualsHelp_L("")
  ManualsHelp_L("     The current value of HELP is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("SET HELP=")
  ManualsHelp_L("")
  ManualsHelp_L("     The  item  HELP  is  set  to a  null value,  thus removing  it from  the ")
  ManualsHelp_L("environment item list.")
  ManualsHelp_L("")
  ManualsHelp_L("TIME")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     TIME [time]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or sets the current time.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the time  is given  after the  command, then the time is set to this ")
  ManualsHelp_L("value (for the format see below). If the time is not given after the command, ")
  ManualsHelp_L("then the  current time is printed and the new time is prompted for and input. ")
  ManualsHelp_L("If  no input  is given  (ie. if  the 'enter'  key alone  is pressed) then the ")
  ManualsHelp_L("current time is not altered. Otherwise the input is assumed to be a new time, ")
  ManualsHelp_L("and is  interpreted as  described below. If the time is invalid then an error ")
  ManualsHelp_L("message is displayed and the new time again prompted for and input.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  time is expected to consist of up to four numbers, separated by one ")
  ManualsHelp_L("of the following characters:")
  ManualsHelp_L("")
  ManualsHelp_L("     space tab , - . / :")
  ManualsHelp_L("")
  ManualsHelp_L("with  spaces allowed  either side  of the character. Any missing numbers will ")
  ManualsHelp_L("default to  the current  setting. The first number is the hour, the second is ")
  ManualsHelp_L("the minutes, the third is the seconds and the forth is the centi-seconds. The ")
  ManualsHelp_L("centi-seconds are not printed however since it is not very useful to know the ")
  ManualsHelp_L("current value, or indeed to enter a new one.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  format in which the time is printed is flexible and can be changed. ")
  ManualsHelp_L("An environment  item (see  chapter 7 on Environment Items) called TIME is set ")
  ManualsHelp_L("up  by default  to the  value '12',  which indicates  that the  time will  be ")
  ManualsHelp_L("printed in  12 hour  format with  a following  'a' or  'p' for am and pm. The ")
  ManualsHelp_L("command  SET TIME  24 will  cause the time to be printed in 24 hour mode. The ")
  ManualsHelp_L("time  can  be  input  unambiguously in  either format.  The time  format also ")
  ManualsHelp_L("affects the times printed by the DIR command.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("TIME 16:45  ")
  ManualsHelp_L("")
  ManualsHelp_L("     The current time is set to 4:45 pm.")
  ManualsHelp_L("")
  ManualsHelp_L("TIME")
  ManualsHelp_L("     Current time is 10:45:00a")
  ManualsHelp_L("     Enter new time: ")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters  were given,  so the current time is printed (in this case ")
  ManualsHelp_L("in 12 hour mode) and the new time prompted for.")
  ManualsHelp_L("")
  ManualsHelp_L("TIME 10-50-30-23")
  ManualsHelp_L("")
  ManualsHelp_L("     The time is set to 30.23 seconds after 10:50 am.")
  ManualsHelp_L("")
  ManualsHelp_L("TYPE")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     TYPE [/H] [/P] [/B] compound-filespec | device")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays data from a file or device.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  compound-filespec specifies the files that are to be displayed, and ")
  ManualsHelp_L("/H allows  hidden files  to be  typed. If the compound-filespec is ambiguous, ")
  ManualsHelp_L("then the filename is printed before each one is typed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  /B is  specified, then  data is  read from  each file  and displayed ")
  ManualsHelp_L("without modification  on the  screen, until  the end of file is reached. This ")
  ManualsHelp_L("may  have  strange  effect  on  the  screen  if  the  file  contains  control ")
  ManualsHelp_L("characters.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  /B is  not given,  then TYPE will look for the end-of-file character ")
  ManualsHelp_L("(CTRL-Z) and  stop when  it finds it. Also control characters except carriage ")
  ManualsHelp_L("return,  line feed  and tab  will be  converted into  characters that  can be ")
  ManualsHelp_L("printed, A for ^A, W for ^W, etc.")
  ManualsHelp_L("")
  ManualsHelp_L("     If /P  is given,  then the  output will  pause at  the end of the screen ")
  ManualsHelp_L("until a key is pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("     TYPE FILE1")
  ManualsHelp_L("")
  ManualsHelp_L("     Data  is read  from the  file and printed on the screen, up to the first ")
  ManualsHelp_L("end-of-file character.")
  ManualsHelp_L("")
  ManualsHelp_L("TYPE *.BAT/H/P")
  ManualsHelp_L("")
  ManualsHelp_L("     All batch  files, including  hidden ones,  are read  in and displayed. A ")
  ManualsHelp_L("prompt is printed at the end of every screen full.")
  ManualsHelp_L("")
  ManualsHelp_L("TYPE AUTOEXEC.BAT + REBOOT.BAT")
  ManualsHelp_L("")
  ManualsHelp_L("     The files AUTOEXEC.BAT and REBOOT.BAT are displayed.")
  ManualsHelp_L("")
  ManualsHelp_L("TYPE /B DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files  in  the  directory  DIR1 are  printed on  the screen  and no ")
  ManualsHelp_L("interpretation is put on the data in the files.")
  ManualsHelp_L("")
  ManualsHelp_L("UNDEL")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("          UNDEL [filespec]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("          Recovers a previously deleted file.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  filespec specifies which files are to be undeleted if possible, and ")
  ManualsHelp_L("defaults to *.*.")
  ManualsHelp_L("")
  ManualsHelp_L("     Files can only be undeleted if they have been deleted using MSX-DOS 2 on ")
  ManualsHelp_L("an MSX-DOS  2 formatted  disk and if no disk allocation has taken place since ")
  ManualsHelp_L("the  file was  originally deleted,  which usually  means that they have to be ")
  ManualsHelp_L("undeleted immediately after they have been deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("     Each deleted file and directory reference that is found in the directory ")
  ManualsHelp_L("specified  by the  filespec will  be undeleted if it's name is matched by the ")
  ManualsHelp_L("filename in  the filespec, and if undeletion is possible. UNDEL can therefore ")
  ManualsHelp_L("be  used to restore a directory removed with the 'RD' or 'RMDIR' commands; to ")
  ManualsHelp_L("restore the  contents of  the directory  a further  UNDEL command is required ")
  ManualsHelp_L("specifying the now undeleted directory.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note  that UNDEL  is a  transient command,  and therefore must be loaded ")
  ManualsHelp_L("from disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("UNDEL B:HELP.MAC")
  ManualsHelp_L("")
  ManualsHelp_L("     Attempts to  undelete the  file HELP.MAC  from the  current directory of ")
  ManualsHelp_L("drive B:.")
  ManualsHelp_L("")
  ManualsHelp_L("UNDEL A:\DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     All undeletable files and directories in DIR1 are undeleted.")
  ManualsHelp_L("")
  ManualsHelp_L("VER")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     VER")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays the system's version numbers.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The version  numbers of  the three  main components  of the MSX-DOS disk ")
  ManualsHelp_L("system are displayed. Each version number consists of three digits. The first ")
  ManualsHelp_L("digit  is the main MSX-DOS version number and for MSX-DOS 2 will always be 2. ")
  ManualsHelp_L("The second  digit is  the version  number and will change for future versions ")
  ManualsHelp_L("that have, for example, had extra major features added. The last digit is the ")
  ManualsHelp_L("release number and will change with different releases of the same version of ")
  ManualsHelp_L("the system which have had minor changes, improvements and corrections made.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("VER")
  ManualsHelp_L("MSX-DOS kernel version 2.20")
  ManualsHelp_L("MSXDOS2.SYS version 2.20")
  ManualsHelp_L("COMMAND2.COM version 2.20")
  ManualsHelp_L("Copyright 1988 ASCII Corporation")
  ManualsHelp_L("")
  ManualsHelp_L("     The version numbers of all the components of the MSX-DOS disk system are ")
  ManualsHelp_L("printed out.")
  ManualsHelp_L("")
  ManualsHelp_L("VERIFY")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     VERIFY [ON | OFF]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays/sets the current disk write verify state.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If  no parameters  are given, then the current verify state is displayed ")
  ManualsHelp_L("on the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("     If ON or OFF is given, then the verify state is changed appropriately.")
  ManualsHelp_L("")
  ManualsHelp_L("     The verify  state affects all writes to disk. If OFF, the default state, ")
  ManualsHelp_L("then  data is  simply written.  If ON, then after writing the data it is read ")
  ManualsHelp_L("back and  compared with the original to ensure that it was written correctly. ")
  ManualsHelp_L("The extra overhead of this means that writing is slower when verify is on.")
  ManualsHelp_L("")
  ManualsHelp_L("     This  feature depends  on the device driver, so this will have no effect ")
  ManualsHelp_L("if the driver does not have the feature.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("VERIFY")
  ManualsHelp_L("     VERIFY=OFF")
  ManualsHelp_L("")
  ManualsHelp_L("     No parameters  were given, so the current verify state is printed, which ")
  ManualsHelp_L("in this case is off.")
  ManualsHelp_L("")
  ManualsHelp_L("VERIFY ON")
  ManualsHelp_L("")
  ManualsHelp_L("     Disk write verification is turned on.")
  ManualsHelp_L("")
  ManualsHelp_L("VOL")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     VOL [d:] [volname]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Displays or changes the volume name on a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     If  no parameters  are given, or if only a drive name is given, then the ")
  ManualsHelp_L("volume name of the current or specified drive is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If a  volname is given, then the volume name of the specified or current ")
  ManualsHelp_L("drive is changed to the specified volume name.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("VOL B:")
  ManualsHelp_L("     Volume in drive B: has no name")
  ManualsHelp_L("")
  ManualsHelp_L("     Just a drive was given, so the volume name for the disk in that drive is ")
  ManualsHelp_L("printed. In this case there was no volume name defined.")
  ManualsHelp_L("")
  ManualsHelp_L("VOL B:BACKUP")
  ManualsHelp_L("")
  ManualsHelp_L("     The volume name of the disk in drive B: is changed to BACKUP.")
  ManualsHelp_L("")
  ManualsHelp_L("XCOPY")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     XCOPY [filespec [filespec]] [options]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Copies files and directories from one disk to another.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The options available are:")
  ManualsHelp_L("")
  ManualsHelp_L("     [/A] [/E] [/H] [/M] [/P] [/S] [/T] [/W] [/V]")
  ManualsHelp_L("")
  ManualsHelp_L("     XCOPY  is  an  extended  file  copying  command  (compare with  the COPY ")
  ManualsHelp_L("command)  that can  selectively copy  both files  and directories.  The first ")
  ManualsHelp_L("filespec specifies the source filenames, and if /H is given then hidden files ")
  ManualsHelp_L("will also  be copied.  The second  filespec is the destination filename. Thus ")
  ManualsHelp_L("files can be renamed during the copy (as in the standard COPY command).")
  ManualsHelp_L("")
  ManualsHelp_L("     /T  (Time) will cause the copied files to have the current date and time ")
  ManualsHelp_L("rather than the source file's date and time.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  /A  (Archive)  is  specified,  then  only files  with the  'archive' ")
  ManualsHelp_L("attribute set  are copied. A file has an archive attribute in the same way as ")
  ManualsHelp_L("a  'hidden' attribute  and a 'read only' attribute. It is set whenever a file ")
  ManualsHelp_L("is updated (written to).")
  ManualsHelp_L("")
  ManualsHelp_L("     /M is  similar to /A, but resets the archive bit after copying the file. ")
  ManualsHelp_L("Thus, using this option, files can be regularly copied onto another disk only ")
  ManualsHelp_L("if they have been updated, providing a file backup facility.")
  ManualsHelp_L("")
  ManualsHelp_L("     /S  causes  XCOPY  to copy  directories as  well as  files. Within  each ")
  ManualsHelp_L("directory,  all files  are copied  and then  any matching  files within  each ")
  ManualsHelp_L("directory are  copied, with the directory being created on the destination if ")
  ManualsHelp_L("it does not already exist. Normally, these directories will not be created if ")
  ManualsHelp_L("no files are to be copied into them.")
  ManualsHelp_L("")
  ManualsHelp_L("     /E  can be  given to cause the /S option to create all directories, even ")
  ManualsHelp_L("if they are empty.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  /P  (Pause)  option  will cause  XCOPY to  pause and  prompt before ")
  ManualsHelp_L("copying each file, which allows files to be selectively copied.")
  ManualsHelp_L("")
  ManualsHelp_L("     /W (Wait)  causes XCOPY to pause and prompt before copying any files, so ")
  ManualsHelp_L("that disks can be changed.")
  ManualsHelp_L("")
  ManualsHelp_L("     /V option can be given to turn write verification on for the duration of ")
  ManualsHelp_L("the  XCOPY command  (see the  VERIFY command).  This will ensure that data is ")
  ManualsHelp_L("written correctly  to disks  if the device driver being used has the feature, ")
  ManualsHelp_L("but will slow the operation down.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note that XCOPY is a transient command, and so must be loaded off disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("XCOPY B:\ ")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files in  the root  directory of drive B: are copied to the current ")
  ManualsHelp_L("directory of the current drive. There is no advantage in this case over using ")
  ManualsHelp_L("the standard built-in COPY command.")
  ManualsHelp_L("")
  ManualsHelp_L("XCOPY *.* B: /H/S/M")
  ManualsHelp_L("")
  ManualsHelp_L("     All  files, including  hidden files, are copied to drive B: only if they ")
  ManualsHelp_L("have  been  modified  since  a similar  command was  last given.  The archive ")
  ManualsHelp_L("attributes are  then reset  so that  the files  are marked as unmodified. Not ")
  ManualsHelp_L("only  are  all  the  files  in  the  current  directory  copied,  but  so are ")
  ManualsHelp_L("directories and all their descendant directories and files.")
  ManualsHelp_L("")
  ManualsHelp_L("XDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format")
  ManualsHelp_L("")
  ManualsHelp_L("     XDIR [filespec] [/H]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose")
  ManualsHelp_L("")
  ManualsHelp_L("     Lists all files within directories.")
  ManualsHelp_L("")
  ManualsHelp_L("Use")
  ManualsHelp_L("")
  ManualsHelp_L("     The  filespec specifies  which files  are to  be listed,  and /H  allows ")
  ManualsHelp_L("hidden files to be included.")
  ManualsHelp_L("")
  ManualsHelp_L("     XDIR is  similar to the DIR command, but does not print the files' dates ")
  ManualsHelp_L("and times.")
  ManualsHelp_L("")
  ManualsHelp_L("     After  all files in the specified directory have been listed, then files ")
  ManualsHelp_L("within descendant  directories are  also listed, and are shown indented. This ")
  ManualsHelp_L("allows a DIR of a complete directory tree or disk to be obtained.")
  ManualsHelp_L("")
  ManualsHelp_L("     Note that XDIR is a transient command, and so must be loaded off disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Examples")
  ManualsHelp_L("")
  ManualsHelp_L("XDIR")
  ManualsHelp_L("")
  ManualsHelp_L("     The  directory of  the entire  disk in  or descending  from the  current ")
  ManualsHelp_L("directory of the current drive is printed.")
  ManualsHelp_L("")
  ManualsHelp_L("Volume in drive A: is MSX-DOS 2")
  ManualsHelp_L("X-Directory of A:\ ")
  ManualsHelp_L("")
  ManualsHelp_L("MSXDOS2.SYS     r     4480")
  ManualsHelp_L("COMMAND2.COM    r    14976")
  ManualsHelp_L("AUTOEXEC.BAT            57")
  ManualsHelp_L("REBOOT.BAT              57")
  ManualsHelp_L("")
  ManualsHelp_L("\UTILS")
  ManualsHelp_L("        CHKDSK.COM       7680")
  ManualsHelp_L("        DISKCOPY.COM     7168")
  ManualsHelp_L("        FIXDISK.COM       768")
  ManualsHelp_L("        UNDEL.COM        3968")
  ManualsHelp_L("        XCOPY.COM       10112")
  ManualsHelp_L("        XDIR.COM         7168")
  ManualsHelp_L("        MKSYS.BAT         569")
  ManualsHelp_L("        AUTOEXEC.BAT       47")
  ManualsHelp_L("        REBOOT.BAT         90")
  ManualsHelp_L("\HELP")
  ManualsHelp_L("        ASSIGN.HLP        819")
  ManualsHelp_L("        ATDIR.HLP        1527")
  ManualsHelp_L("        ATTRIB.HLP       1828")
  ManualsHelp_L("        .")
  ManualsHelp_L("        .")
  ManualsHelp_L("        .")
  ManualsHelp_L("292K in 117 files   530K free")
  ManualsHelp_L("")
  ManualsHelp_L("XDIR B:\DIR1")
  ManualsHelp_L("")
  ManualsHelp_L("     All the  files and  directories and  their contents are printed from the ")
  ManualsHelp_L("directory DIR1.")
  ManualsHelp_L("")
  ManualsHelp_L("XDIR \*.COM/H")
  ManualsHelp_L("")
  ManualsHelp_L("     The  names  of  all files,  including hidden  files, matching  *.COM are ")
  ManualsHelp_L("displayed.")
  ManualsHelp_L("")
  ManualsHelp_L("5. Redirection and Piping")
  ManualsHelp_L("=========================")
  ManualsHelp_L("")
  ManualsHelp_L("     COMMAND2.COM  offers the  redirection and  piping features  as described ")
  ManualsHelp_L("below. They  may be bypassed by setting the environment item " + Chr(34) + "REDIR" + Chr(34) + " to " + Chr(34) + "OFF" + Chr(34) + " ")
  ManualsHelp_L("(" + Chr(34) + "SET REDIR=OFF" + Chr(34) + "), so the compatibility to MSX-DOS 1 or CP/M can be achieved.")
  ManualsHelp_L("")
  ManualsHelp_L("Redirection")
  ManualsHelp_L("")
  ManualsHelp_L("     Most  commands, CP/M  programs and  MSX-DOS programs  output text to the ")
  ManualsHelp_L("screen by  writing to  the 'standard  output', and  read from the keyboard by ")
  ManualsHelp_L("reading from the 'standard input'. COMMAND2.COM, however, provides facilities ")
  ManualsHelp_L("for  changing the  standard input and standard output for the duration of the ")
  ManualsHelp_L("command to  refer to  other MSX-DOS  devices or to files on disk by including ")
  ManualsHelp_L("one  or more  of the  redirection symbols  <, >  and >>  on the command line, ")
  ManualsHelp_L("followed by a filename.")
  ManualsHelp_L("")
  ManualsHelp_L("     For example,  the ECHO  command normally just outputs it's parameters to ")
  ManualsHelp_L("the  screen by  writing the characters to the standard output. It can be made ")
  ManualsHelp_L("to output to the printer instead by redirecting it's output, as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("          ECHO text >PRN")
  ManualsHelp_L("")
  ManualsHelp_L("which changes the standard output to refer to the device PRN for the duration ")
  ManualsHelp_L("of the ECHO command. Similarly, the command:")
  ManualsHelp_L("")
  ManualsHelp_L("          ECHO text >file1")
  ManualsHelp_L("")
  ManualsHelp_L("will  cause the specified file (" + Chr(34) + "file1" + Chr(34) + ") to be created, and the output of the ")
  ManualsHelp_L("ECHO command  written to  the file.  To append the output of a command to the ")
  ManualsHelp_L("end  of an  existing file, the >> symbol can be used instead of the > symbol, ")
  ManualsHelp_L("and the file will only be created if it does not already exist.")
  ManualsHelp_L("")
  ManualsHelp_L("     To  change the  standard input, the < symbol is used in a similar manner ")
  ManualsHelp_L("to the  > symbol. In this case, the file must already exist, and must contain ")
  ManualsHelp_L("adequate  input for the command. If the command attempts to read input beyond ")
  ManualsHelp_L("the end of the file, then it will be aborted since it cannot continue.")
  ManualsHelp_L("")
  ManualsHelp_L("     When redirection information is given on the command line, it is used by ")
  ManualsHelp_L("COMMAND2.COM to  set up  the redirection  and then  removed from  the command ")
  ManualsHelp_L("line.  Thus  in  the  examples  above,  the  ECHO command  will not  echo the ")
  ManualsHelp_L("redirection symbols or the filename.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the  input  or  output  of  a  batch file  is redirected,  then that ")
  ManualsHelp_L("redirection  is applied  to all  commands within  the batch  file. Individual ")
  ManualsHelp_L("commands within  the batch  file may still be redirected, however, which will ")
  ManualsHelp_L("override  the batch  file redirection.  See chapter 6 on Batch Files for more ")
  ManualsHelp_L("information on commands in batch files.")
  ManualsHelp_L("")
  ManualsHelp_L("Piping")
  ManualsHelp_L("")
  ManualsHelp_L("     As  well as  redirecting the input and output of a command or program to ")
  ManualsHelp_L("another device  or a  disk file,  it is  possible to  redirect or  'pipe' the ")
  ManualsHelp_L("standard  output of one command into the standard input of another. Typically ")
  ManualsHelp_L("the second  command will  be a  program which reads from it's standard input, ")
  ManualsHelp_L("modifies  the data,  and writes it to it's standard output. Such a program is ")
  ManualsHelp_L("called a  'filter'. For  example, a  filter could be produced which read data ")
  ManualsHelp_L("from  it's standard input, sorted it into alphabetical order, and wrote it to ")
  ManualsHelp_L("it's standard output. Thus the output of the DIR command could be sorted.")
  ManualsHelp_L("")
  ManualsHelp_L("     Piping  is indicated  on the command line by separating the two commands ")
  ManualsHelp_L("by the  | symbol.  The command  to the left of the | symbol will be performed ")
  ManualsHelp_L("first,  and it's  output will  be redirected  to a  temporary file created by ")
  ManualsHelp_L("COMMAND2.COM. Then  the second  command will be performed, with it's standard ")
  ManualsHelp_L("input  redirected from the same temporary file. When the second command ends, ")
  ManualsHelp_L("the temporary file will be deleted. The standard output of the second command ")
  ManualsHelp_L("may of course have been piped into the standard input of a third command, and ")
  ManualsHelp_L("so on.")
  ManualsHelp_L("")
  ManualsHelp_L("     If any input redirection occurs on a command line involving a pipe, then ")
  ManualsHelp_L("the redirection is applied to the first command in the pipe, as all the other ")
  ManualsHelp_L("commands  receive  their  standard  input  from  the standard  output of  the ")
  ManualsHelp_L("previous command  in the pipe. Similarly, if any output redirection occurs on ")
  ManualsHelp_L("a  command line involving a pipe, then the redirection will apply to the last ")
  ManualsHelp_L("command on the command line.")
  ManualsHelp_L("")
  ManualsHelp_L("     It  is not  possible to  use pipes  on either the input or the output of ")
  ManualsHelp_L("batch files directly. It is, however, possible to use piping with batch files ")
  ManualsHelp_L("if they  are executed  with the  COMMAND2 command (see chapter 4) since it is ")
  ManualsHelp_L("then the COMMAND2 command that is being redirected and not the batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("     As mentioned  above, in order to pipe the output of one command into the ")
  ManualsHelp_L("input   of  another,   temporary  files   will  be  created  and  deleted  by ")
  ManualsHelp_L("COMMAND2.COM. The  location of these temporary files is specified by the TEMP ")
  ManualsHelp_L("environment  item  (see  chapter 7  on Environment  Items), and  this may  be ")
  ManualsHelp_L("changed  to refer  to any  drive and  directory (for  example piping  will be ")
  ManualsHelp_L("speeded up  considerably if  TEMP refers  to a  directory on  a RAM disk). By ")
  ManualsHelp_L("default,  TEMP refers  to the  root directory  of the boot disk. The filename ")
  ManualsHelp_L("used  for  the  temporary  file is  created by  COMMAND2.COM, so  TEMP should ")
  ManualsHelp_L("specify just the drive and directory. The filename is of the form:")
  ManualsHelp_L("")
  ManualsHelp_L("          %PIPExxx.$$$")
  ManualsHelp_L("")
  ManualsHelp_L("where xxx  is a  three digit  number chosen  by COMMAND2.COM to avoid clashes ")
  ManualsHelp_L("with any other files in the TEMP directory.")
  ManualsHelp_L("")
  ManualsHelp_L("6. Batch Files")
  ManualsHelp_L("==============")
  ManualsHelp_L("")
  ManualsHelp_L("     When  a command  is given  to MSX-DOS  and it is not one of the internal ")
  ManualsHelp_L("commands, a  file of  that name  is searched  for with an extension of COM or ")
  ManualsHelp_L("BAT.  If not  found in  the current directory then the current search path is ")
  ManualsHelp_L("searched (see  the PATH  command). If  a COM file is found, then it is loaded ")
  ManualsHelp_L("and  executed. If  a BAT  file is found, then MSX-DOS starts execution of the ")
  ManualsHelp_L("batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("     A  batch file is a text file that contains a list of commands, and these ")
  ManualsHelp_L("commands are  read from the file a line at a time and executed as though they ")
  ManualsHelp_L("were  typed at  the keyboard.  Several of the commands described in chapter 4 ")
  ManualsHelp_L("are in fact provided mainly for use in batch files, such as ECHO and PAUSE.")
  ManualsHelp_L("")
  ManualsHelp_L("     As  each  command  is  read,  normally  it is  executed immediately.  An ")
  ManualsHelp_L("environment  item  ECHO exists,  however, that  can be  set to  ON (with  the ")
  ManualsHelp_L("command SET  ECHO ON)  to cause each command line to be printed on the screen ")
  ManualsHelp_L("before it is executed (see chapter 7 for Environment Items). The command line ")
  ManualsHelp_L("is  echoed in  this way  after % parameter substitution (see below) has taken ")
  ManualsHelp_L("place. The command SET ECHO OFF will restore the normal state.")
  ManualsHelp_L("")
  ManualsHelp_L("     In the  command line  that invoked the batch file, parameters may follow ")
  ManualsHelp_L("the  name of  the batch file just like any other command or transient program ")
  ManualsHelp_L("name.  These  parameters  may  be  accessed  anywhere  in  the batch  file by ")
  ManualsHelp_L("specifying %0 to %9. %1 is the first parameter specified in the command line, ")
  ManualsHelp_L("%2 is  the second  and so  on. %0 is the name of the batch file itself. The % ")
  ManualsHelp_L("number  will be  replaced by  the parameter on the original command line, and ")
  ManualsHelp_L("may appear  anywhere on a batch file command line. To actually use a % symbol ")
  ManualsHelp_L("on a command line a double % must be given ('%%') which will then be replaced ")
  ManualsHelp_L("by a single one.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  the  execution  of  any  command  in  a  batch  file  is  terminated ")
  ManualsHelp_L("prematurely  for some  reason (typically  the control-STOP  or control-C  key ")
  ManualsHelp_L("being pressed) then the following prompt is issued:")
  ManualsHelp_L("")
  ManualsHelp_L("          Terminate batch file (Y/N)?")
  ManualsHelp_L("")
  ManualsHelp_L("     If the  response to  this is 'Y', then execution of the whole batch file ")
  ManualsHelp_L("is  stopped. If the response is 'N', then batch file execution continues with ")
  ManualsHelp_L("the next command in the batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("     After  MSX-DOS has executed a command in batch file, it may need to read ")
  ManualsHelp_L("the next  command in  the batch  file off disk. If the correct disk is not in ")
  ManualsHelp_L("the drive when it comes to do this, then a prompt is issued. For example, the ")
  ManualsHelp_L("following  prompt will  be issued  if the  batch file was originally executed ")
  ManualsHelp_L("from drive A::")
  ManualsHelp_L("")
  ManualsHelp_L("          Insert disk for batch file in drive A:")
  ManualsHelp_L("          Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("When  the  correct  disk  has  been inserted  and a  key pressed,  batch file ")
  ManualsHelp_L("execution will continue normally.")
  ManualsHelp_L("")
  ManualsHelp_L("     Below  is a  very simple  batch file,  which just  prints the  first few ")
  ManualsHelp_L("parameters.")
  ManualsHelp_L("")
  ManualsHelp_L("          ECHO Parameter 0 = %0")
  ManualsHelp_L("          ECHO Parameter 1 = %1")
  ManualsHelp_L("          ECHO Parameter 2 = %2")
  ManualsHelp_L("          ECHO Parameter 3 = %3")
  ManualsHelp_L("")
  ManualsHelp_L("     If this is called MYBAT.BAT then the command MYBAT a b c will output")
  ManualsHelp_L("")
  ManualsHelp_L("          Parameter 0 = MYBAT")
  ManualsHelp_L("          Parameter 1 = a")
  ManualsHelp_L("          Parameter 2 = b")
  ManualsHelp_L("          Parameter 3 = c")
  ManualsHelp_L("")
  ManualsHelp_L("     When  MSX-DOS starts  up for the first time, a special batch file called ")
  ManualsHelp_L("AUTOEXEC.BAT is  looked for  and is  executed if  found. This may contain any ")
  ManualsHelp_L("MSX-DOS command, and usually contains once-only initialization commands, such ")
  ManualsHelp_L("as a RAMDISK command to set up a RAM disk. ")
  ManualsHelp_L("")
  ManualsHelp_L("     One  % parameter  is passed  to AUTOEXEC.BAT  as %1. This the drive that ")
  ManualsHelp_L("MSX-DOS booted from and is in the form of a normal drive letter followed by a ")
  ManualsHelp_L("colon.")
  ManualsHelp_L("")
  ManualsHelp_L("     Another special  batch file is REBOOT.BAT. This is executed when MSX-DOS ")
  ManualsHelp_L("is  re-booted after  using DISK-BASIC. As with AUTOEXEC.BAT files, the single ")
  ManualsHelp_L("%1 parameter passed is the drive from which MSX-DOS was re-booted.")
  ManualsHelp_L("")
  ManualsHelp_L("     Usually  some commands  need to be performed whenever MSX-DOS is booted, ")
  ManualsHelp_L("whether for the first time or sometime later, and these are put in the REBOOT ")
  ManualsHelp_L("batch file.  They can then be executed from the AUTOEXEC batch file by ending ")
  ManualsHelp_L("it  with the  command REBOOT %1. An example of a command that might be put in ")
  ManualsHelp_L("the REBOOT  batch file  is the  PATH command  to set up the transient command ")
  ManualsHelp_L("search  path. When  setting up  the search  path using the command, %1 can be ")
  ManualsHelp_L("used to set up the path on whatever drive was booted from.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  a command  in a batch file is the name of another batch file, then ")
  ManualsHelp_L("that second  batch file  is executed in the normal way. When it ends, control ")
  ManualsHelp_L("passes  back to  the interactive  command interpreter,  and not  to the first ")
  ManualsHelp_L("batch file. Batch file commands thus 'chain' together.")
  ManualsHelp_L("")
  ManualsHelp_L("     If it  is desired  to 'nest' batch files ie. to pass control back to the ")
  ManualsHelp_L("first  batch file above, then this can be done with the COMMAND2 command (see ")
  ManualsHelp_L("chapter 4),  passing the name of the second batch file as the parameter. Then ")
  ManualsHelp_L("when  the second  batch file  ends, the  first one will be continued with the ")
  ManualsHelp_L("command after the COMMAND2 command.")
  ManualsHelp_L("")
  ManualsHelp_L("     A typical AUTOEXEC batch file is as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("          ECHO AUTOEXEC executing")
  ManualsHelp_L("          RAMDISK 100")
  ManualsHelp_L("          RAMDISK")
  ManualsHelp_L("               COPY COMMAND2.COM H:\ ")
  ManualsHelp_L("          REBOOT %1")
  ManualsHelp_L("")
  ManualsHelp_L("     A typical REBOOT batch file is as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("          ECHO REBOOT executing")
  ManualsHelp_L("          PATH H:\, %1\UTILS, %1\BATCH")
  ManualsHelp_L("               SET SHELL=H:\COMMAND2.COM")
  ManualsHelp_L("               SET TEMP=H:\ ")
  ManualsHelp_L("          SET PROMPT ON")
  ManualsHelp_L("          H:")
  ManualsHelp_L("")
  ManualsHelp_L("     When the  AUTOEXEC batch file executes, the message " + Chr(34) + "AUTOEXEC executing" + Chr(34) + " ")
  ManualsHelp_L("is  printed, and  then a  RAM disk  is set  up with  a maximum  size of 100K. ")
  ManualsHelp_L("Another RAMDISK command is then given which will print out the actual size of ")
  ManualsHelp_L("RAM disk created. The COPY command then copies COMMAND2.COM onto the RAM disk ")
  ManualsHelp_L("so that  it can  load and  re-load quickly.  Finally the REBOOT batch file is ")
  ManualsHelp_L("executed, with the %1 parameter (the boot drive) passed to it.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  REBOOT batch  file prints a message and then sets a PATH. The first ")
  ManualsHelp_L("item in  the path  refers to  the RAM  disk that  was created by the AUTOEXEC ")
  ManualsHelp_L("batch  file, and  the other items refer to directories on the disk from which ")
  ManualsHelp_L("MSX-DOS was  booted (ie.  %1). The  SHELL environment  item is set up so that ")
  ManualsHelp_L("COMMAND2.COM  can re-load  quickly off the RAM disk, and the TEMP environment ")
  ManualsHelp_L("item is  set up  so that  temporary piping files are created on the RAM disk. ")
  ManualsHelp_L("The  prompt is  set ON so that the current directory is printed as the prompt ")
  ManualsHelp_L("and, finally, the RAM disk is made the default drive.")
  ManualsHelp_L("")
  ManualsHelp_L("7. Environment Items")
  ManualsHelp_L("====================")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX-DOS maintains  a list  of 'environment  items' in  its work area. An ")
  ManualsHelp_L("environment item is a named item that has a value associated with it.")
  ManualsHelp_L("")
  ManualsHelp_L("     An  environment  item  can have  any name  chosen by  the user,  and can ")
  ManualsHelp_L("consist  of the  same characters  that are  valid in  a filename. The maximum ")
  ManualsHelp_L("length  of  an  environment  item name  is 255  characters. MSX-DOS  provides ")
  ManualsHelp_L("several environment items set up by default.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  value  of  an  environment  item is  simply a  string of  arbitrary ")
  ManualsHelp_L("characters  up to  a maximum length of 255. No processing is performed on the ")
  ManualsHelp_L("characters and so the casing of characters is preserved. Any environment item ")
  ManualsHelp_L("that does not exist has a null value (ie. no characters).")
  ManualsHelp_L("")
  ManualsHelp_L("     An environment  item can  be changed or set up by the SET command, which ")
  ManualsHelp_L("can also display currently set environment items.")
  ManualsHelp_L("")
  ManualsHelp_L("     The  environment items  set up  by default and the manner in which their ")
  ManualsHelp_L("value is interpreted are as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("ECHO")
  ManualsHelp_L("")
  ManualsHelp_L("     This controls the echoing of lines read from a batch file (see chapter 6 ")
  ManualsHelp_L("on  Batch   Files).  Any  value  except  'ON'  (lowercase  also  allowed)  is ")
  ManualsHelp_L("interpreted as 'OFF'.")
  ManualsHelp_L("")
  ManualsHelp_L("PROMPT")
  ManualsHelp_L("")
  ManualsHelp_L("     This  controls the  displaying of the prompt at command level. Any value ")
  ManualsHelp_L("except 'ON' is interpreted as 'OFF'.")
  ManualsHelp_L("")
  ManualsHelp_L("     When PROMPT is OFF, as it is by default, then the prompt consists of the ")
  ManualsHelp_L("current drive followed by '>' eg. A>.")
  ManualsHelp_L("")
  ManualsHelp_L("     When PROMPT is ON, then the prompt consists of the current drive and the ")
  ManualsHelp_L("current directory  of that  drive followed by '>' eg. A:\COM>. In order to do ")
  ManualsHelp_L("this, the current drive must be accessed to read the current directory and so ")
  ManualsHelp_L("may take a little longer to appear.")
  ManualsHelp_L("")
  ManualsHelp_L("PATH")
  ManualsHelp_L("")
  ManualsHelp_L("     The current search path by which COMMAND2.COM searches the command given ")
  ManualsHelp_L("is  maintained as  an environment  item PATH,  and it  is this  that the PATH ")
  ManualsHelp_L("command manipulates.")
  ManualsHelp_L("")
  ManualsHelp_L("SHELL")
  ManualsHelp_L("")
  ManualsHelp_L("     The  SHELL  environment  item  indicates where  the command  interpreter ")
  ManualsHelp_L("(COMMAND2.COM) exists,  and is set up by default to where it was loaded from. ")
  ManualsHelp_L("When the command interpreter needs to re-load itself from disk (after running ")
  ManualsHelp_L("a  transient command)  it looks at the SHELL environment item and attempts to ")
  ManualsHelp_L("load itself  from the  file that it specifies. If this gives an error then it ")
  ManualsHelp_L("attempts  to load  itself from  the root  directory of  the drive that it was ")
  ManualsHelp_L("originally loaded from.")
  ManualsHelp_L("")
  ManualsHelp_L("     To cause the command interpreter to re-load itself from another drive or ")
  ManualsHelp_L("directory, COMMAND2.COM can be copied there and SHELL set to refer to it. For ")
  ManualsHelp_L("example, it might be copied to the RAMDISK with the command COPY COMMAND2.COM ")
  ManualsHelp_L("H:\ and then SHELL set with the command SET SHELL=H:\COMMAND2.COM.")
  ManualsHelp_L("")
  ManualsHelp_L("TIME")
  ManualsHelp_L("")
  ManualsHelp_L("     TIME specifies the format the time is displayed by MSX-DOS. If not '24', ")
  ManualsHelp_L("which indicates that it is displayed as a 24-hour time, then '12' is assumed, ")
  ManualsHelp_L("which  indicates that  it is  displayed as  a 12-hour time with an am. or pm. ")
  ManualsHelp_L("indication. The  TIME environment  item does not apply when the time is input ")
  ManualsHelp_L("because it can be input in either format unambiguously.")
  ManualsHelp_L("")
  ManualsHelp_L("DATE")
  ManualsHelp_L("")
  ManualsHelp_L("     DATE specifies the format the date is displayed and input by MSX-DOS. It ")
  ManualsHelp_L("defaults  to  a  format  appropriate for  the country  of origin  of the  MSX ")
  ManualsHelp_L("machine. It  takes the  form of three letters or three letter pairs separated ")
  ManualsHelp_L("by  date/time separators  (see the DATE command). To set the American format, ")
  ManualsHelp_L("for example, the command SET DATE=MM/DD/YY could be given.")
  ManualsHelp_L("")
  ManualsHelp_L("HELP")
  ManualsHelp_L("")
  ManualsHelp_L("     When the  HELP command  is given  the name  of command for which help is ")
  ManualsHelp_L("required,  then it  reads the information displayed from a file on disk. This ")
  ManualsHelp_L("file is  in the directory specified by the HELP environment item. It defaults ")
  ManualsHelp_L("to  a directory  called HELP  in the root directory of the drive that MSX-DOS ")
  ManualsHelp_L("was booted from.")
  ManualsHelp_L("")
  ManualsHelp_L("APPEND")
  ManualsHelp_L("")
  ManualsHelp_L("     APPEND  is  not  actually  defined by  default, but  when set  up is  an ")
  ManualsHelp_L("environment item  that has  a special  meaning to the system. It is used only ")
  ManualsHelp_L("with standard CP/M programs.")
  ManualsHelp_L("")
  ManualsHelp_L("     CP/M programs  do not  know how to use sub-directories because CP/M does ")
  ManualsHelp_L("not  have sub-directories, but instead just has the equivalent of the current ")
  ManualsHelp_L("directory. When  such a  program opens a file, it searches for it only within ")
  ManualsHelp_L("this single directory and thus only has drives and filenames, not paths.")
  ManualsHelp_L("")
  ManualsHelp_L("     When a CP/M program is run under MSX-DOS and attempts to open a file, it ")
  ManualsHelp_L("only  searches for  the filename  in the current directory of the appropriate ")
  ManualsHelp_L("drive. Similarly,  when the user types in a filename to a CP/M program it may ")
  ManualsHelp_L("only  contain a drive and filename, and thus also refers only to files in the ")
  ManualsHelp_L("current directory.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  this search is performed through MSX-DOS, if the file is not found ")
  ManualsHelp_L("in the  current directory,  then the APPEND environment item is looked at. If ")
  ManualsHelp_L("it  is not  set up  then the  file has  not been found. If set up, then it is ")
  ManualsHelp_L("assumed to  be a  path name,  and specifies a single alternative directory in ")
  ManualsHelp_L("which the search for the file continues.")
  ManualsHelp_L("")
  ManualsHelp_L("     This will only be of use if the CP/M program opens a file and then reads ")
  ManualsHelp_L("or writes  to it.  If it  attempts to, for example, delete a file or create a ")
  ManualsHelp_L("file,  then APPEND  will not be used. Indeed, it may have undesirable effects ")
  ManualsHelp_L("and for  this reason it is recommended that APPEND is used normally only in a ")
  ManualsHelp_L("batch  file which  sets it  up, executes the CP/M program, and then unsets it ")
  ManualsHelp_L("again.")
  ManualsHelp_L("")
  ManualsHelp_L("     Typical uses  for APPEND include specifying the directory in which large ")
  ManualsHelp_L("programs  (such as  word processors  and database programs) find 'overlay' or ")
  ManualsHelp_L("messages files,  and specifying  the directory in which compilers, assemblers ")
  ManualsHelp_L("and  linkers find  their source  and working  files. Typical  cases for which ")
  ManualsHelp_L("APPEND is  not suitable  and may  have undesirable  effects include editing a ")
  ManualsHelp_L("file  with a wordprocessor when the file to be edited probably cannot be in a ")
  ManualsHelp_L("directory other than the current one, even if APPEND is set up.")
  ManualsHelp_L("")
  ManualsHelp_L("PROGRAM and PARAMETERS")
  ManualsHelp_L("")
  ManualsHelp_L("     These  special  environment  items  are set  up by  COMMAND2.COM when  a ")
  ManualsHelp_L("transient command  is executed  and removed when it finishes, and should thus ")
  ManualsHelp_L("be avoided for general use.")
  ManualsHelp_L("")
  ManualsHelp_L("TEMP")
  ManualsHelp_L("")
  ManualsHelp_L("     When piping is performed (see chapter 5 on Redirection and Piping) it is ")
  ManualsHelp_L("necessary  for COMMAND2.COM  to create  one or  more temporary files, and the ")
  ManualsHelp_L("TEMP  environment  item  indicates  the drive  and directory  in which  these ")
  ManualsHelp_L("temporary  files  are  to  be  created.  By default,  it refers  to the  root ")
  ManualsHelp_L("directory of  the boot  drive, and typically may be changed to refer to a RAM ")
  ManualsHelp_L("disk since this increases the speed of piping.")
  ManualsHelp_L("")
  ManualsHelp_L("     Although  the standard  MSX-DOS system  only uses  TEMP for  piping, any ")
  ManualsHelp_L("other programs and utilities that need to create temporary files may also use ")
  ManualsHelp_L("the TEMP environment item.")
  ManualsHelp_L("")
  ManualsHelp_L("UPPER")
  ManualsHelp_L("")
  ManualsHelp_L("     UPPER controls  whether the  command line  from 80h  to be passed to the ")
  ManualsHelp_L("transient  program  be  converted  to  uppercase.  Any  value except  'ON' is ")
  ManualsHelp_L("interpreted as 'OFF'.")
  ManualsHelp_L("")
  ManualsHelp_L("     When UPPER is 'OFF' (default), no conversion will be done and the values ")
  ManualsHelp_L("will be passed to the transient program as they are typed.")
  ManualsHelp_L("")
  ManualsHelp_L("     When UPPER is 'ON', each character in the command line will be converted ")
  ManualsHelp_L("to  its  associated  uppercase  character  and then  passed to  the transient ")
  ManualsHelp_L("program. This is compatible to CP/M environment.")
  ManualsHelp_L("")
  ManualsHelp_L("REDIR")
  ManualsHelp_L("")
  ManualsHelp_L("     REDIR  controls  whether  the redirection  or piping  characters in  the ")
  ManualsHelp_L("command  line  be  processed  by  COMMAND2.COM.  Any  value  except  'ON'  is ")
  ManualsHelp_L("interpreted as 'OFF'.")
  ManualsHelp_L("")
  ManualsHelp_L("     When REDIR is 'OFF', the redirection or piping characters will be passed ")
  ManualsHelp_L("to  the transient  program as  they are  typed, and the transient program may ")
  ManualsHelp_L("process them.")
  ManualsHelp_L("")
  ManualsHelp_L("     When REDIR  is 'ON' (default), the redirection or piping characters will ")
  ManualsHelp_L("be  interpreted and  executed by  COMMAND2.COM, so they will not be passed to ")
  ManualsHelp_L("the transient program.")
  ManualsHelp_L("")
  ManualsHelp_L("8. ERRORS AND MESSAGES")
  ManualsHelp_L("======================")
  ManualsHelp_L("")
  ManualsHelp_L("Disk errors")
  ManualsHelp_L("")
  ManualsHelp_L("     Disk errors  occur when  a command  or program is attempting to access a ")
  ManualsHelp_L("disk  and fails  for some reason, such as a disk not being in the drive. When ")
  ManualsHelp_L("this happens,  message and  prompt appears  which allows  the user the either ")
  ManualsHelp_L("retry  the operation which may now work (eg. if a disk has been inserted into ")
  ManualsHelp_L("the drive), to ignore the operation or to abort the entire command.")
  ManualsHelp_L("")
  ManualsHelp_L("     An example disk error message and prompt is as follows, and may be given ")
  ManualsHelp_L("if the disk was taken out whilst drive A: was being accessed:")
  ManualsHelp_L("")
  ManualsHelp_L("          Not ready reading drive A:")
  ManualsHelp_L("          Abort, Retry or Ignore (A/R/I)?")
  ManualsHelp_L("")
  ManualsHelp_L("The  'not ready' part of the message indicates why the disk operation failed, ")
  ManualsHelp_L("and  other  possibilities  exist  (see below).  'reading' indicates  that the ")
  ManualsHelp_L("command was trying to read the disk, and may be replaced by 'writing' if that ")
  ManualsHelp_L("is what it was doing. 'drive A:' is the drive in which the disk was attempted ")
  ManualsHelp_L("to be accessed.")
  ManualsHelp_L("")
  ManualsHelp_L("     The 'Abort,  Retry or  Ignore' part  indicates the possible actions that ")
  ManualsHelp_L("can  be taken by the user, and these are selected by pressing the 'A', 'R' or ")
  ManualsHelp_L("'I' key.")
  ManualsHelp_L("")
  ManualsHelp_L("     If Abort is selected, then the entire command is aborted and the message ")
  ManualsHelp_L("'Disk operation aborted' is printed before another command can be typed.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  Retry  is selected  then the  failed disk  operation will  simply be ")
  ManualsHelp_L("retried  and  may fail  again or  may work,  particularly if  some corrective ")
  ManualsHelp_L("action has been taken such as inserting a missing disk.")
  ManualsHelp_L("")
  ManualsHelp_L("     Ignore causes the failed disk operation to be ignored by the command. In ")
  ManualsHelp_L("many cases,  ignoring an  error may not be recommended and in these cases the ")
  ManualsHelp_L("Ignore  option will not even be displayed, although it may still be selected. ")
  ManualsHelp_L("Doing so  may however cause serious system malfunction and could destroy data ")
  ManualsHelp_L("on  the disk.  Even if the Ignore option is displayed, it should be used with ")
  ManualsHelp_L("extreme caution,  and only  when all else fails. Normally Ignore is only used ")
  ManualsHelp_L("when  the data on a disk has got corrupted and ignoring the disk error offers ")
  ManualsHelp_L("the only possibility of recovering all or part of the data.")
  ManualsHelp_L("")
  ManualsHelp_L("     A few  serious errors  which generally  mean the disk has been corrupted ")
  ManualsHelp_L("beyond possible use are automatically aborted, and just the appropriate error ")
  ManualsHelp_L("message is printed (eg. 'Bad file allocation table').")
  ManualsHelp_L("")
  ManualsHelp_L("     The  possible errors  that can  occur as  disk errors and their meanings ")
  ManualsHelp_L("are, in alphabetical order, as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("Bad file allocation table")
  ManualsHelp_L("")
  ManualsHelp_L("     The  disk contains an invalid file allocation table (FAT). The FAT is an ")
  ManualsHelp_L("area on  disk in  which the  system keeps information to tell it where on the ")
  ManualsHelp_L("disk  the data  in each file is stored. Thus if the FAT is invalid, it cannot ")
  ManualsHelp_L("read any  data at  all. This  message usually  means that  the disk  has been ")
  ManualsHelp_L("corrupted beyond possible use.")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot format this drive")
  ManualsHelp_L("")
  ManualsHelp_L("     An  attempt was  made to  format a disk in a drive that does not support ")
  ManualsHelp_L("disk  formatting.  This  probably  means  that  a  FORMAT  command was  given ")
  ManualsHelp_L("specifying the RAM disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Data error")
  ManualsHelp_L("")
  ManualsHelp_L("     The data  was read  or written  without error, but the CRC check failed. ")
  ManualsHelp_L("This usually means the disk has been corrupted.")
  ManualsHelp_L("")
  ManualsHelp_L("Disk error")
  ManualsHelp_L("")
  ManualsHelp_L("     The data could not be read or written to the disk.")
  ManualsHelp_L("")
  ManualsHelp_L("Incompatible disk")
  ManualsHelp_L("")
  ManualsHelp_L("     An  attempt was made to access 2D or 1D disk or a double sided disk in a ")
  ManualsHelp_L("single sided drive.")
  ManualsHelp_L("")
  ManualsHelp_L("Not a DOS disk")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk  is not  a format  that MSX-DOS can read. For example, although ")
  ManualsHelp_L("MSX-DOS can execute CP/M programs it cannot access CP/M disks.")
  ManualsHelp_L("")
  ManualsHelp_L("Not ready")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk is not in the drive being accessed. The disk should be inserted ")
  ManualsHelp_L("into the drive and 'Retry' selected.")
  ManualsHelp_L("")
  ManualsHelp_L("Sector not found")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX-DOS  tried to  read or  write to a non-existent sector. May indicate ")
  ManualsHelp_L("that the disk has been corrupted.")
  ManualsHelp_L("")
  ManualsHelp_L("Seek error")
  ManualsHelp_L("")
  ManualsHelp_L("     The  requested  track  on  the disk  could not  be found.  Could mean  a ")
  ManualsHelp_L("corrupted disk or faulty disk drive.")
  ManualsHelp_L("")
  ManualsHelp_L("Unformatted disk")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk  has not  been formatted.  Use the  FORMAT command  on the disk ")
  ManualsHelp_L("before accessing it.")
  ManualsHelp_L("")
  ManualsHelp_L("Verify error")
  ManualsHelp_L("")
  ManualsHelp_L("     Only  occurs  when  verify is  on, and  means that  data appeared  to be ")
  ManualsHelp_L("written  to disk successfully but when read back was found to be different to ")
  ManualsHelp_L("that written.")
  ManualsHelp_L("")
  ManualsHelp_L("Write error")
  ManualsHelp_L("")
  ManualsHelp_L("     Data was not written correctly.")
  ManualsHelp_L("")
  ManualsHelp_L("Write protected disk")
  ManualsHelp_L("")
  ManualsHelp_L("     The disk is write protected and an attempt was made to write data to it. ")
  ManualsHelp_L("The disk should be made unprotected and 'Retry' selected.")
  ManualsHelp_L("")
  ManualsHelp_L("Wrong disk and Wrong disk for file")
  ManualsHelp_L("")
  ManualsHelp_L("     MSX-DOS accessed a disk once and subsequently needed to access it again, ")
  ManualsHelp_L("but found  that the  drive contained a different one. The correct disk should ")
  ManualsHelp_L("be inserted and 'Retry' selected.")
  ManualsHelp_L("")
  ManualsHelp_L("Command Errors")
  ManualsHelp_L("")
  ManualsHelp_L("     Command  errors  occur  when  a  command  cannot  perform it's  intended ")
  ManualsHelp_L("function for some reason.")
  ManualsHelp_L("")
  ManualsHelp_L("     If  an  error  occurs in  a command  and it  is unlikely  to be  able to ")
  ManualsHelp_L("continue,  then an appropriate error message is printed, and the next command ")
  ManualsHelp_L("is read at the prompt.")
  ManualsHelp_L("")
  ManualsHelp_L("     An example error message is:")
  ManualsHelp_L("")
  ManualsHelp_L("          *** File not found")
  ManualsHelp_L("")
  ManualsHelp_L("     The three  asterisks *** are printed first to indicate that an error has ")
  ManualsHelp_L("occurred.  The message is then printed, followed by the normal command prompt ")
  ManualsHelp_L("on the next line. The possible errors that can occur are listed below.")
  ManualsHelp_L("")
  ManualsHelp_L("     When  a command  error occurs  in a  specific situation, an 'error type' ")
  ManualsHelp_L("message may  also be  printed. For  example, generally  when a  required file ")
  ManualsHelp_L("cannot  be found  on disk,  the 'File not found' message is printed as in the ")
  ManualsHelp_L("above example.  However, if  the file  required is  a file  specified by  the ")
  ManualsHelp_L("redirection  symbol <  (see chapter  5 on  Redirection and  Piping) then  the ")
  ManualsHelp_L("message printed will be:")
  ManualsHelp_L("")
  ManualsHelp_L("          *** Redirection error: File not found")
  ManualsHelp_L("")
  ManualsHelp_L("     The possible error types are:")
  ManualsHelp_L("")
  ManualsHelp_L("Batch file error:")
  ManualsHelp_L("")
  ManualsHelp_L("     An  error  occurred whilst  attempting to  read from  a batch  file, for ")
  ManualsHelp_L("example a disk error occurred and 'abort' was selected.")
  ManualsHelp_L("")
  ManualsHelp_L("Piping error:")
  ManualsHelp_L("")
  ManualsHelp_L("     The error  occurred during  a piping  operation, probably  in connection ")
  ManualsHelp_L("with  the  temporary  files  that  COMMAND2.COM  creates  (see  chapter  5 on ")
  ManualsHelp_L("Redirection and Piping). For example, the TEMP environment item did not refer ")
  ManualsHelp_L("to a valid drive or directory (see chapter 7 on Environment Items).")
  ManualsHelp_L("")
  ManualsHelp_L("Redirection error:")
  ManualsHelp_L("")
  ManualsHelp_L("     The  error  occurred  during a  redirection operation.  For example,  an ")
  ManualsHelp_L("invalid  filename was specified after a redirection symbol <, > or >>, or the ")
  ManualsHelp_L("specified input file was not found (see chapter 5 on Redirection and Piping).")
  ManualsHelp_L("")
  ManualsHelp_L("Standard input error:")
  ManualsHelp_L("")
  ManualsHelp_L("     An error  occurred on  the standard  input to a command or program after ")
  ManualsHelp_L("redirection  or piping  has been  set up,  for example the standard input has ")
  ManualsHelp_L("been redirected from a file and the end of the file has been reached.")
  ManualsHelp_L("")
  ManualsHelp_L("Standard output error:")
  ManualsHelp_L("")
  ManualsHelp_L("     An error  occurred on  the standard output of a command or program after ")
  ManualsHelp_L("redirection  or piping  has been  set up, for example the standard output has ")
  ManualsHelp_L("been redirected to a file and the disk is full.")
  ManualsHelp_L("")
  ManualsHelp_L("     Many  commands  operate  on files  or directories,  and if  an ambiguous ")
  ManualsHelp_L("filename  is given  then the command operates on several files or directories ")
  ManualsHelp_L("(for example  the RENAME  command or the COPY command). Often an error occurs ")
  ManualsHelp_L("when  it is  trying to perform the command on one of the files, but which may ")
  ManualsHelp_L("be  successful  on one  of the  other files.  In this  case, the  filename is ")
  ManualsHelp_L("printed followed  by the  error message  and the  command then continues. For ")
  ManualsHelp_L("example:")
  ManualsHelp_L("")
  ManualsHelp_L("          COMMAND2.COM -- File cannot be copied onto itself")
  ManualsHelp_L("")
  ManualsHelp_L("     The  possible  command  errors that  can be  given are,  in alphabetical ")
  ManualsHelp_L("order, as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot concatenate destination file")
  ManualsHelp_L("")
  ManualsHelp_L("     This  error  is  given by  CONCAT and  means that  one of  the filenames ")
  ManualsHelp_L("matched by the source file specification is the destination file. This is not ")
  ManualsHelp_L("necessarily wrong but may indicate a mistake in the command.")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot create destination file")
  ManualsHelp_L("")
  ManualsHelp_L("This  is given  by COPY,  and usually means that the destination file for the ")
  ManualsHelp_L("file  it  is copying  would, if  it was  created, overwrite  a file  that was ")
  ManualsHelp_L("already in  use. This is likely to be a previously copied source file but may ")
  ManualsHelp_L("be some other file such as the currently executing batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot overwrite previous destination file")
  ManualsHelp_L("")
  ManualsHelp_L("     This  is given by COPY, and means that the destination file for the file ")
  ManualsHelp_L("it is copying would, if it was created, overwrite the destination file of the ")
  ManualsHelp_L("file  that  was  previously  copied.  This  usually means  that the  intended ")
  ManualsHelp_L("destination was a directory but that it's name was misspelled.")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot transfer above 64K")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Command too long")
  ManualsHelp_L("")
  ManualsHelp_L("     A command  that was  given is  too long. This will not occur when typing ")
  ManualsHelp_L("commands  from the  keyboard, but  may occur  from a  batch file. The maximum ")
  ManualsHelp_L("length of a command is 127 characters after % parameter substitution.")
  ManualsHelp_L("")
  ManualsHelp_L("Ctrl-C pressed")
  ManualsHelp_L("")
  ManualsHelp_L("     The command was interrupted by pressing CTRL-C.")
  ManualsHelp_L("")
  ManualsHelp_L("Ctrl-STOP pressed")
  ManualsHelp_L("")
  ManualsHelp_L("     The command was interrupted by pressing CTRL-STOP.")
  ManualsHelp_L("")
  ManualsHelp_L("Directory exists")
  ManualsHelp_L("")
  ManualsHelp_L("     A command  attempted to  create a new file or directory on disk with the ")
  ManualsHelp_L("same name as an existing directory.")
  ManualsHelp_L("")
  ManualsHelp_L("Directory not empty")
  ManualsHelp_L("")
  ManualsHelp_L("     The  RMDIR (RD)  command tried to remove a directory that contains files ")
  ManualsHelp_L("or other  directories. These  must be  deleted first with the ERASE and RMDIR ")
  ManualsHelp_L("commands since directories must be empty before they can be removed.")
  ManualsHelp_L("")
  ManualsHelp_L("Directory not found")
  ManualsHelp_L("")
  ManualsHelp_L("     A directory command (eg. RNDIR) could not find the specified directory.")
  ManualsHelp_L("")
  ManualsHelp_L("Disk full")
  ManualsHelp_L("")
  ManualsHelp_L("     There  is no more room on the disk and files will have to be deleted and ")
  ManualsHelp_L("the command given again.")
  ManualsHelp_L("")
  ManualsHelp_L("Disk operation aborted")
  ManualsHelp_L("")
  ManualsHelp_L("     A disk  error occurred  and the 'Abort' option was chosen, thus aborting ")
  ManualsHelp_L("the whole command.")
  ManualsHelp_L("")
  ManualsHelp_L("Duplicate filename")
  ManualsHelp_L("")
  ManualsHelp_L("RENAME  (REN) or  RNDIR cannot  perform the  specified rename because the new ")
  ManualsHelp_L("filename is the same as a filename that already exists. Also occurs from MOVE ")
  ManualsHelp_L("or MVDIR  because a filename already exists in the destination directory with ")
  ManualsHelp_L("the same name as the file or directory being moved.")
  ManualsHelp_L("")
  ManualsHelp_L("End of file")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Environment string too long")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Error on standard input")
  ManualsHelp_L("")
  ManualsHelp_L("     This  should not  normally occur  from commands, and means that an error ")
  ManualsHelp_L("occurred while a command was attempting to read from the keyboard.")
  ManualsHelp_L("")
  ManualsHelp_L("Error on standard output")
  ManualsHelp_L("")
  ManualsHelp_L("     This should  not normally  occur from  commands, and means that an error ")
  ManualsHelp_L("occurred while a command was attempting to write to the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("File access violation")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("File allocation error")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("File cannot be copied onto itself")
  ManualsHelp_L("")
  ManualsHelp_L("     The  destination file  when trying  to do a COPY is the same file as the ")
  ManualsHelp_L("source.")
  ManualsHelp_L("")
  ManualsHelp_L("File exists")
  ManualsHelp_L("")
  ManualsHelp_L("     MKDIR (MD) tried to create a new directory but a file with the same name ")
  ManualsHelp_L("already exists in the specified directory.")
  ManualsHelp_L("")
  ManualsHelp_L("File for HELP not found")
  ManualsHelp_L("")
  ManualsHelp_L("     The HELP  command looked  for a file to get the help text from but could ")
  ManualsHelp_L("not  find it.  Help files are usually kept in a directory called \HELP on the ")
  ManualsHelp_L("boot disk.")
  ManualsHelp_L("")
  ManualsHelp_L("File handle not open")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("File is already in use")
  ManualsHelp_L("")
  ManualsHelp_L("     A command  tried to  modify a  file that  is already being used for some ")
  ManualsHelp_L("other purpose, such as the currently executing batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("File not found")
  ManualsHelp_L("")
  ManualsHelp_L("     A command could not find the specified file or files.")
  ManualsHelp_L("")
  ManualsHelp_L("Internal error")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid MSX-DOS call")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid attributes")
  ManualsHelp_L("")
  ManualsHelp_L("     Usually means an invalid +/- attribute was specified in ATTRIB or ATDIR.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid date")
  ManualsHelp_L("")
  ManualsHelp_L("     The date typed into the DATE command is not a valid date or was typed in ")
  ManualsHelp_L("in an invalid format.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid device operation")
  ManualsHelp_L("")
  ManualsHelp_L("     A  command cannot  perform it's  function on  one of the built-in system ")
  ManualsHelp_L("devices eg. a file cannot be renamed CON.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid directory move")
  ManualsHelp_L("")
  ManualsHelp_L("     MVDIR attempted  to move  a directory  into one  of it's  own descendant ")
  ManualsHelp_L("directories, which cannot be done.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid drive")
  ManualsHelp_L("")
  ManualsHelp_L("     A drive that does not exist was specified.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid environment string")
  ManualsHelp_L("")
  ManualsHelp_L("     The  name of an environment item contains invalid characters. Only those ")
  ManualsHelp_L("characters valid in filenames are valid in environment item names.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid file handle")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid filename")
  ManualsHelp_L("")
  ManualsHelp_L("     A  filename   contains  invalid  characters.  This  may  be  a  filename ")
  ManualsHelp_L("explicitly given, or may be the result of attempting to rename a file with an ")
  ManualsHelp_L("ambiguous new name. ")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid number")
  ManualsHelp_L("")
  ManualsHelp_L("     A number given in a command contained non-digit characters.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid option")
  ManualsHelp_L("")
  ManualsHelp_L("     An invalid letter was given after a / on a command line.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid . or .. operation")
  ManualsHelp_L("")
  ManualsHelp_L("     A  command cannot  perform it's  function on  the special  '.' and  '..' ")
  ManualsHelp_L("directories that are present at the start of all sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid parameter")
  ManualsHelp_L("")
  ManualsHelp_L("     The parameter  to a  command is  generally not valid for that command in ")
  ManualsHelp_L("some way.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid pathname")
  ManualsHelp_L("")
  ManualsHelp_L("     A  path specified  on a  command line does not exist or is syntactically ")
  ManualsHelp_L("incorrect.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid process id")
  ManualsHelp_L("")
  ManualsHelp_L("     This should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Invalid time")
  ManualsHelp_L("")
  ManualsHelp_L("     The time typed into the TIME command is not a valid time or was typed in ")
  ManualsHelp_L("in an invalid format.")
  ManualsHelp_L("")
  ManualsHelp_L("Missing parameter")
  ManualsHelp_L("")
  ManualsHelp_L("     A command expected a parameter but did not find one.")
  ManualsHelp_L("")
  ManualsHelp_L("No spare file handles")
  ManualsHelp_L("")
  ManualsHelp_L("     Should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Not enough memory")
  ManualsHelp_L("")
  ManualsHelp_L("     Not enough  memory is  available for  the given  command. For example, a ")
  ManualsHelp_L("large  program to  large to  fit into  memory or  not enough memory for a new ")
  ManualsHelp_L("environment string.")
  ManualsHelp_L("")
  ManualsHelp_L("Not enough memory, system halted")
  ManualsHelp_L("")
  ManualsHelp_L("     This special  error message is printed when MSX-DOS attempts to start up ")
  ManualsHelp_L("and  finds  that  there  is  not enough  memory to  continue. As  the message ")
  ManualsHelp_L("suggests, the computer must then be reset. This should normally occur.")
  ManualsHelp_L("")
  ManualsHelp_L("Pathname too long")
  ManualsHelp_L("")
  ManualsHelp_L("     A  path is too long. Either the length of the pathname given exceeds 100 ")
  ManualsHelp_L("characters, or  the total  length of a path from the root directory to a file ")
  ManualsHelp_L("is more than 63 characters.")
  ManualsHelp_L("")
  ManualsHelp_L("RAM disk already exists")
  ManualsHelp_L("")
  ManualsHelp_L("     Should not normally occur from commands.")
  ManualsHelp_L("")
  ManualsHelp_L("RAM disk does not exist")
  ManualsHelp_L("")
  ManualsHelp_L("     The  RAMDISK command  was used  to display  the current  size of the RAM ")
  ManualsHelp_L("disk, but no RAM disk exists.")
  ManualsHelp_L("")
  ManualsHelp_L("Read only file")
  ManualsHelp_L("")
  ManualsHelp_L("     An attempt  was made  to modify or overwrite a file marked as read only. ")
  ManualsHelp_L("The DIR command shows this, and the ATTRIB command can make it not read only.")
  ManualsHelp_L("")
  ManualsHelp_L("Root directory full")
  ManualsHelp_L("")
  ManualsHelp_L("     The  fixed maximum  number of  files in  the root directory (often 64 or ")
  ManualsHelp_L("112) has been reached. Directories do not have this limitation.")
  ManualsHelp_L("")
  ManualsHelp_L("System file exists")
  ManualsHelp_L("")
  ManualsHelp_L("     An  attempt was  made to  create a  file which would, if it was created, ")
  ManualsHelp_L("overwrite a  file that  is marked as a system file. System files are not used ")
  ManualsHelp_L("in MSX-DOS, and are not shown by the DIR command or accessible from any other ")
  ManualsHelp_L("commands, and so this error should not normally occur with commands.")
  ManualsHelp_L("")
  ManualsHelp_L("Too many parameters")
  ManualsHelp_L("")
  ManualsHelp_L("     All  the parameters a command expected were found on a command line, but ")
  ManualsHelp_L("there were still more parameters left on the end of the line.")
  ManualsHelp_L("")
  ManualsHelp_L("Unrecognized command")
  ManualsHelp_L("")
  ManualsHelp_L("     A given  command was  not an  internal command or an external COM or BAT ")
  ManualsHelp_L("command found along the current search path as set by the PATH command.")
  ManualsHelp_L("")
  ManualsHelp_L("Wrong version of command")
  ManualsHelp_L("")
  ManualsHelp_L("     After executing a program, COMMAND2.COM tried to re-load itself from the ")
  ManualsHelp_L("COMMAND2.COM file on disk, and found it was not the same version. A prompt is ")
  ManualsHelp_L("then printed and COMMAND2.COM will attempt to re-load itself again.")
  ManualsHelp_L("")
  ManualsHelp_L("Wrong version of MSX-DOS, system halted")
  ManualsHelp_L("")
  ManualsHelp_L("     This special error message is printed when MSX-DOS attempts to starts up ")
  ManualsHelp_L("and finds  that some  other part  of the  MSX-DOS system has a version number ")
  ManualsHelp_L("earlier  than required.  As the  message suggests,  the computer must then be ")
  ManualsHelp_L("reset. This should not normally occur.")
  ManualsHelp_L("")
  ManualsHelp_L("     Internally,  errors  are  represented  as  error  numbers.  The  numbers ")
  ManualsHelp_L("corresponding  to the  errors above  start at  255 and  decrease. If an error ")
  ManualsHelp_L("number is received for which there is no message, then it is printed. Numbers ")
  ManualsHelp_L("above 64 are reserved for future version of MSX-DOS and so are called 'system ")
  ManualsHelp_L("errors' and  numbers below  63 can be used by external commercially available ")
  ManualsHelp_L("programs  and are  called 'user  errors'. User  errors below 32 never print a ")
  ManualsHelp_L("message. The  two default  error messages (which will not normally occur from ")
  ManualsHelp_L("commands) are thus:")
  ManualsHelp_L("")
  ManualsHelp_L("System error 64")
  ManualsHelp_L("")
  ManualsHelp_L("     and")
  ManualsHelp_L("")
  ManualsHelp_L("User error 63")
  ManualsHelp_L("")
  ManualsHelp_L("where  the 64  and 63  are example error numbers. The only command which uses ")
  ManualsHelp_L("error numbers is the EXIT command. A list of the actual numbers for the above ")
  ManualsHelp_L("messages is available in the Program Interface specification.")
  ManualsHelp_L("")
  ManualsHelp_L("Prompt Messages")
  ManualsHelp_L("")
  ManualsHelp_L("     There  are  several  situations in  which user  interaction is  required ")
  ManualsHelp_L("before  the system can continue with what it was doing, typically inserting a ")
  ManualsHelp_L("disk. Also  many potentially  dangerous commands require confirmation prompts ")
  ManualsHelp_L("to  be answered  before they  perform their  operation. These  various system ")
  ManualsHelp_L("prompts are given below.")
  ManualsHelp_L("")
  ManualsHelp_L("All data on drive A: will be destroyed")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     This prompt  is given by the FORMAT command, and is issued to reduce the ")
  ManualsHelp_L("risk  of accidentally formatting the wrong disk. To abort the FORMAT command, ")
  ManualsHelp_L("control-STOP or control-C can be pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("Destroy all data on RAM disk (Y/N)? ")
  ManualsHelp_L("")
  ManualsHelp_L("     A RAMDISK command was given to set up a RAM disk, but a RAM disk already ")
  ManualsHelp_L("existed.  If  the  response  to the  prompt is  'Y', then  any files  on this ")
  ManualsHelp_L("existing RAM  disk will  be destroyed.  A response  of 'N' or control-STOP or ")
  ManualsHelp_L("control-C will abort the command.")
  ManualsHelp_L("")
  ManualsHelp_L("Disk in drive A: will only be able to boot MSX-DOS")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     This prompt is given by the FIXDISK command, and is issued to reduce the ")
  ManualsHelp_L("risk  of accidentally  updating a  non-MSX-DOS 2  disk. To  abort the FIXDISK ")
  ManualsHelp_L("command, control-STOP or control-C can be pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("Erase all files (Y/N)? ")
  ManualsHelp_L("")
  ManualsHelp_L("     This  prompt  occurs  when  a DEL  (or ERA  or ERASE)  command is  given ")
  ManualsHelp_L("specifying all  the files in a directory, and is issued to reduce the risk of ")
  ManualsHelp_L("accidentally deleting a lot of files.")
  ManualsHelp_L("")
  ManualsHelp_L("Insert COMMAND2.COM disk in drive A:")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     This  may occur  after running a program, and requires a disk containing ")
  ManualsHelp_L("COMMAND2.COM in  the root  directory to  be present  in the  specified drive. ")
  ManualsHelp_L("After  inserting the disk in the drive (which is the drive from which MSX-DOS ")
  ManualsHelp_L("was  originally  booted)  and  pressing a  key, the  system will  continue as ")
  ManualsHelp_L("normal. If  COMMAND2.COM has been copied somewhere else (eg. a RAM disk) then ")
  ManualsHelp_L("the  SHELL environment  item can  be set up to make COMMAND2.COM re-load from ")
  ManualsHelp_L("there instead (see chapter 7 on Environment Items).")
  ManualsHelp_L("")
  ManualsHelp_L("Insert batch file disk in drive A:")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("     This  may occur during the execution of a batch file, and means that the ")
  ManualsHelp_L("system needed to read the next command from the batch file but found that the ")
  ManualsHelp_L("wrong disk  was in the drive. After inserting the disk in the specified drive ")
  ManualsHelp_L("(which  will be  the drive  from which the batch file was originally started) ")
  ManualsHelp_L("and pressing a key, execution of the batch file will continue as normal.")
  ManualsHelp_L("")
  ManualsHelp_L("Press any key to continue... ")
  ManualsHelp_L("")
  ManualsHelp_L("This prompt  is generally  issued when some user interaction is required, and ")
  ManualsHelp_L("is  normally  printed  after some  other message  which describes  the action ")
  ManualsHelp_L("required.  It is also printed by the PAUSE command. To abort the command that ")
  ManualsHelp_L("issued the prompt, control-STOP or control-C can be pressed.")
  ManualsHelp_L("")
  ManualsHelp_L("Terminate batch file (Y/N)? ")
  ManualsHelp_L("")
  ManualsHelp_L("When MSX-DOS  aborts a  command prematurely (such as when the control-STOP or ")
  ManualsHelp_L("control-C key is pressed) and the command was executing in a batch file, this ")
  ManualsHelp_L("prompt  is issued.  If the  response is  'Y' then the batch file will also be ")
  ManualsHelp_L("aborted. If 'N' is the response  then the  batch file will continue with the command that follows ")
  ManualsHelp_L("the aborted command.")
  ManualsHelp_L("")
  ManualsHelp_L("9. COMMAND SUMMARY")
  ManualsHelp_L("==================")
  ManualsHelp_L("")
  ManualsHelp_L("     The  following  is  a list  of all  the standard  commands available  in ")
  ManualsHelp_L("MSX-DOS, together with their syntax and purpose.")
  ManualsHelp_L("")
  ManualsHelp_L("ASSIGN [d: [d:]]")
  ManualsHelp_L("")
  ManualsHelp_L("          Sets up the logical to physical translation of drives.")
  ManualsHelp_L("")
  ManualsHelp_L("ATDIR +|-H  [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Changes  the  attributes  of  directories  to make  them ")
  ManualsHelp_L("     hidden/not hidden.")
  ManualsHelp_L("")
  ManualsHelp_L("ATTRIB +|- R|H [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Changes  the attributes of files to make them hidden/not ")
  ManualsHelp_L("     hidden and read only/not read only.")
  ManualsHelp_L("")
  ManualsHelp_L("BASIC [program]")
  ManualsHelp_L("")
  ManualsHelp_L("          Transfers control to MSX disk BASIC.")
  ManualsHelp_L("")
  ManualsHelp_L("BUFFERS [number]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or  changes the  number of  disk buffers in the ")
  ManualsHelp_L("     system.")
  ManualsHelp_L("")
  ManualsHelp_L("CD [d:] [path]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or changes the current directory.")
  ManualsHelp_L("")
  ManualsHelp_L("CHDIR [d:] [path]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or changes the current directory.")
  ManualsHelp_L("")
  ManualsHelp_L("CHKDSK [d:] [/F]")
  ManualsHelp_L("")
  ManualsHelp_L("          Checks the integrity of the files on the disk.")
  ManualsHelp_L("")
  ManualsHelp_L("CLS")
  ManualsHelp_L("")
  ManualsHelp_L("          Clears the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("COMMAND2 [command]")
  ManualsHelp_L("")
  ManualsHelp_L("          Invokes the command interpreter.")
  ManualsHelp_L("")
  ManualsHelp_L("CONCAT [/H] [/P] [/B] [/V] compound-filespec  filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Concatenates (joins together) files.")
  ManualsHelp_L("")
  ManualsHelp_L("COPY [/A] [/H] [/T] [/V] [/P] compound-filespec [filespec]")
  ManualsHelp_L("")
  ManualsHelp_L("          Copies  data from  files or  devices to  other files  or ")
  ManualsHelp_L("     devices.")
  ManualsHelp_L("")
  ManualsHelp_L("DATE [date]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or sets the current date.")
  ManualsHelp_L("")
  ManualsHelp_L("DEL  [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Deletes one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("DIR  [/H] [/W] [/P] [compound-filespec]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays the names of files on disk.")
  ManualsHelp_L("")
  ManualsHelp_L("DISKCOPY [d: [d:]] [/X]")
  ManualsHelp_L("")
  ManualsHelp_L("          Copies one disk to another.")
  ManualsHelp_L("")
  ManualsHelp_L("ECHO [text]")
  ManualsHelp_L("")
  ManualsHelp_L("          Prints text in a batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("ERA  [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Deletes one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("ERASE [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Deletes one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("EXIT [number]")
  ManualsHelp_L("")
  ManualsHelp_L("          Exits COMMAND2.COM to the invoking program.")
  ManualsHelp_L("")
  ManualsHelp_L("FIXDISK [d:] [/S]")
  ManualsHelp_L("")
  ManualsHelp_L("          Updates a disk to the full MSX-DOS 2 format.")
  ManualsHelp_L("")
  ManualsHelp_L("FORMAT [d:]")
  ManualsHelp_L("")
  ManualsHelp_L("          Formats (initializes) a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("HELP [subject]")
  ManualsHelp_L("")
  ManualsHelp_L("          Provides on-line help for an MSX-DOS feature.")
  ManualsHelp_L("")
  ManualsHelp_L("MD [d:] path")
  ManualsHelp_L("")
  ManualsHelp_L("          Creates a new sub-directory.")
  ManualsHelp_L("")
  ManualsHelp_L("MKDIR [d:] path")
  ManualsHelp_L("")
  ManualsHelp_L("          Creates a new sub-directory.")
  ManualsHelp_L("")
  ManualsHelp_L("MODE number")
  ManualsHelp_L("")
  ManualsHelp_L("          Changes the number of characters/line on the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("MOVE [/H] [/P] compound-filespec [path]")
  ManualsHelp_L("")
  ManualsHelp_L("          Moves files from one place to another on a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("MVDIR [/H] [/P] compound-filespec [path]")
  ManualsHelp_L("")
  ManualsHelp_L("          Moves directories from one place to another on a disk. ")
  ManualsHelp_L("")
  ManualsHelp_L("PATH [ [+|-] [d:]path [ [d:]path [ [d:]path ...]] ]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or sets the COM and BAT command search path.")
  ManualsHelp_L("")
  ManualsHelp_L("PAUSE [comment]")
  ManualsHelp_L("")
  ManualsHelp_L("          Prompts and waits for a key press in a batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("RAMDISK [number[K]] [/D]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or sets the RAM disk size.")
  ManualsHelp_L("")
  ManualsHelp_L("RD [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Removes one or more sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("REM [comment]")
  ManualsHelp_L("")
  ManualsHelp_L("          Introduces a comment in a batch file.")
  ManualsHelp_L("")
  ManualsHelp_L("REN [/H] [/P] compound-filespec filename")
  ManualsHelp_L("")
  ManualsHelp_L("          Renames one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("RENAME [/H] [/P] compound-filespec filename")
  ManualsHelp_L("")
  ManualsHelp_L("          Renames one or more files.")
  ManualsHelp_L("")
  ManualsHelp_L("RMDIR [/H] [/P] compound-filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Removes one or more sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("RNDIR [/H] [/P] compound-filespec filename")
  ManualsHelp_L("")
  ManualsHelp_L("          Renames one or more sub-directories.")
  ManualsHelp_L("")
  ManualsHelp_L("SET [name] [separator] [value]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or sets environment items.")
  ManualsHelp_L("")
  ManualsHelp_L("TIME [time]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or sets the current time.")
  ManualsHelp_L("")
  ManualsHelp_L("TYPE [/H] [/P] [/B] compound-filespec | device")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays data from a file or device.")
  ManualsHelp_L("")
  ManualsHelp_L("UNDEL filespec")
  ManualsHelp_L("")
  ManualsHelp_L("          Recovers a previously deleted file.")
  ManualsHelp_L("")
  ManualsHelp_L("VER")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays the system's version numbers.")
  ManualsHelp_L("")
  ManualsHelp_L("VERIFY [ON | OFF]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays/sets the current disk write verify state.")
  ManualsHelp_L("")
  ManualsHelp_L("VOL [d:] [volname]")
  ManualsHelp_L("")
  ManualsHelp_L("          Displays or changes the volume name on a disk.")
  ManualsHelp_L("")
  ManualsHelp_L("XCOPY [filespec [filespec]] [/A][/E][/H][/M][/P][/S][/T][/V][/W]")
  ManualsHelp_L("")
  ManualsHelp_L("          Copies files and directories from one disk to another.")
  ManualsHelp_L("")
  ManualsHelp_L("XDIR [filespec] [/H]")
  ManualsHelp_L("")
  ManualsHelp_L("          Lists all files within directories.")
  ManualsHelp_L("")
  ManualsHelp_L("10. DISK-BASIC 2.0")
  ManualsHelp_L("==================")
  ManualsHelp_L("")
  ManualsHelp_L("Overview")
  ManualsHelp_L("")
  ManualsHelp_L("     When  the   system  disk   (the  one   which  contains  MSXDOS2.SYS  and ")
  ManualsHelp_L("COMMAND2.COM)  does not  exist at  the system  startup, or when MSX-DOS BASIC ")
  ManualsHelp_L("command is executed, DISK-BASIC 2.0 will be started.")
  ManualsHelp_L("")
  ManualsHelp_L("     DISK-BASIC  2.0  is  the  extended version  of previous  DISK-BASIC 1.0. ")
  ManualsHelp_L("Instructions to  operate with the RAM disk or the directory has been added or ")
  ManualsHelp_L("extended.")
  ManualsHelp_L("")
  ManualsHelp_L("Description of Commands")
  ManualsHelp_L("")
  ManualsHelp_L("CALL CHDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL CHDIR(" + Chr(34) + "[d:][path]" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Set or display current directory")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL CHDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Description     The function is the same as MSX-DOS CHDIR. See CHDIR.")
  ManualsHelp_L("")
  ManualsHelp_L("CALL CHDRV")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL CHDRV(" + Chr(34) + "[d:]" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Switch default drive")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL CHDRV(" + Chr(34) + "H:" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Description     The  same action  is taken as when the drive name is given at ")
  ManualsHelp_L("                MSX-DOS prompt.")
  ManualsHelp_L("")
  ManualsHelp_L("CALL MKDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL MKDIR(" + Chr(34) + "[d:][path]" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Create new subdirectory")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL MKDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Description     The function is the same as MSX-DOS MKDIR. See MKDIR.")
  ManualsHelp_L("")
  ManualsHelp_L("CALL RMDIR")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL RMDIR(" + Chr(34) + "[d:][path]" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Remove one or more subdirectories")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL RMDIR(" + Chr(34) + "WORK" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Description     The function is the same as MSX-DOS RMDIR. See RMDIR.")
  ManualsHelp_L("")
  ManualsHelp_L("CALL RAMDISK")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL RAMDISK[([number][, variable name])]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Set size of RAM disk or assign it into a variable")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL RAMDISK(32)")
  ManualsHelp_L("                CALL RAMDISK(1000, A)")
  ManualsHelp_L("")
  ManualsHelp_L("Description     The function is the same as MSX-DOS RAMDISK. See RAMDISK.")
  ManualsHelp_L("")
  ManualsHelp_L("CALL SYSTEM")
  ManualsHelp_L("")
  ManualsHelp_L("Format          CALL SYSTEM")
  ManualsHelp_L("                or")
  ManualsHelp_L("                CALL SYSTEM[(" + Chr(34) + "DOS command name" + Chr(34) + ")]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Pass control back to MSX-DOS")
  ManualsHelp_L("")
  ManualsHelp_L("Example         CALL SYSTEM(" + Chr(34) + "WORK" + Chr(34) + ")")
  ManualsHelp_L("")
  ManualsHelp_L("Description     CALL SYSTEM  passes the  control back to MSX-DOS. The command ")
  ManualsHelp_L("                name  may be  given to  specify the  operation to be executed ")
  ManualsHelp_L("                after  the  control returns  to DOS.  If no  command name  is ")
  ManualsHelp_L("                specified,  REBOOT.BAT  in  the  root directory  on the  boot ")
  ManualsHelp_L("                drive, if any, will be executed.")
  ManualsHelp_L("")
  ManualsHelp_L("FILES")
  ManualsHelp_L("")
  ManualsHelp_L("Format          FILES[" + Chr(34) + "filename" + Chr(34) + "][, L]")
  ManualsHelp_L("")
  ManualsHelp_L("Purpose         Display names of files and directories on disk")
  ManualsHelp_L("")
  ManualsHelp_L("Example         FILES" + Chr(34) + "W*.*" + Chr(34))
  ManualsHelp_L("")
  ManualsHelp_L("Description     The function  is the same as MSX-DOS DIR. See DIR. " + Chr(34) + "FILES, L" + Chr(34) + " ")
  ManualsHelp_L("                displays the names in the long format.")
  ManualsHelp_Commit("MSX-DOS 2 - Referencia", "MSX-DOS 2")

  ManualsHelp_Begin()
  ManualsHelp_L("                  M S X -- D O S   v e r s i o n  2")
  ManualsHelp_L("                  =================================")
  ManualsHelp_L("")
  ManualsHelp_L("                  The advanced disk operating system")
  ManualsHelp_L("")
  ManualsHelp_L("                         for MSX 2 computers")
  ManualsHelp_L("")
  ManualsHelp_L("This document is not complete yet:")
  ManualsHelp_L("")
  ManualsHelp_L("1.   INTRODUCTION")
  ManualsHelp_L("This  manual describes the environment which MSX-DOS 2 provides  for")
  ManualsHelp_L("transient programs on MSX 2 computers. It is intended as a guide for")
  ManualsHelp_L("writing  new  programs to run under MSX-DOS 2 and also to assist  in")
  ManualsHelp_L("converting existing CP/M and MSX-DOS 1 programs to take advantage of")
  ManualsHelp_L("the advanced features.")
  ManualsHelp_L("")
  ManualsHelp_L("MSX-DOS  2 provides many enhancements to the standard CP/M and  MSX-")
  ManualsHelp_L("DOS 1 environment, but is largely compatible with existing programs.")
  ManualsHelp_L("The main features include:")
  ManualsHelp_L("")
  ManualsHelp_L("        MS-DOS style tree structured directories")
  ManualsHelp_L("        File handles")
  ManualsHelp_L("        Environment strings")
  ManualsHelp_L("        Proper error handling")
  ManualsHelp_L("")
  ManualsHelp_L("Many extra DOS calls are implemented, and these are accessed via the")
  ManualsHelp_L("DOS entry jump at address 5 (the 'BDOS' jump in CP/M).  The descrip-")
  ManualsHelp_L("tions  of the  individual functions  can be found  in the  " + Chr(34) + "Function")
  ManualsHelp_L("Codes  specification" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("----")
  ManualsHelp_L("")
  ManualsHelp_L("5.   MAPPER SUPPORT ROUTINES")
  ManualsHelp_L("")
  ManualsHelp_L("MSX-DOS  2  contains  routines to provide  support  for  the  memory")
  ManualsHelp_L("mapper.   This  allows MSX application programs or MSX-DOS transient")
  ManualsHelp_L("programs  to  utilize more than the basic  64k  of  memory,  without")
  ManualsHelp_L("conflicting with the RAM disk or any other system software.")
  ManualsHelp_L("")
  ManualsHelp_L("  5.1   MAPPER INITIALISATION")
  ManualsHelp_L("")
  ManualsHelp_L("   When  the  DOS kernel is initialized it checks that there is  the")
  ManualsHelp_L("   memory mapper in the system,  and that there is at least 128k  of")
  ManualsHelp_L("   RAM available.    If the kernel has found at least one slot which")
  ManualsHelp_L("   contains  128k  of  the mapper RAM,  it selects  the  slot  which")
  ManualsHelp_L("   contains the largest amount of RAM (or the slot with the smallest")
  ManualsHelp_L("   slot number, if there are two or more mapper slots which have the")
  ManualsHelp_L("   same amount of RAM) and makes that slot usable as the system RAM.")
  ManualsHelp_L("   When there is not enough memory on the memory mapper,  MSX-DOS  2")
  ManualsHelp_L("   won't start.")
  ManualsHelp_L("")
  ManualsHelp_L("   Next  the  kernel builds up a table of all the 16k  RAM  segments")
  ManualsHelp_L("   available  to  this slot (primary mapper slot).   The first  four")
  ManualsHelp_L("   segments (64k) for the user and the two highest numbered segments")
  ManualsHelp_L("   are allocated to the system,  one for the DOS kernel code and one")
  ManualsHelp_L("   for the DOS kernel workspace.   All other segments (at least two)")
  ManualsHelp_L("   are  marked  as free initially.   Then the kernel builds  up  the")
  ManualsHelp_L("   similar  tables  for  other RAM slots,  if any.    All  of  these")
  ManualsHelp_L("   segments are marked as free initially.")
  ManualsHelp_L("")
  ManualsHelp_L("  5.2   MAPPER VARIABLES AND ROUTINES")
  ManualsHelp_L("")
  ManualsHelp_L("   The mapper support routines use some variables in the DOS  system")
  ManualsHelp_L("   area.  These tables may be referred and used by the user programs")
  ManualsHelp_L("   for the various purposes,  but must not be altered.  The contents")
  ManualsHelp_L("   of the tables are as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("     address                  function")
  ManualsHelp_L("")
  ManualsHelp_L("     +0               Slot address of the mapper slot")
  ManualsHelp_L("     +1               Total  number  of 16k  RAM  segments.  1...255")
  ManualsHelp_L("                      (8...255 for the primary)")
  ManualsHelp_L("     +2               Number of free 16k RAM segments")
  ManualsHelp_L("     +3               Number  of  16k RAM segments allocated to  the")
  ManualsHelp_L("                      system (at least 6 of the primary)")
  ManualsHelp_L("     +4               Number of 16k RAM segments allocated to the user.")
  ManualsHelp_L("     +5...+7          Unused. Always zero.")
  ManualsHelp_L("     +8...            Entries  for other mapper slots.  If there  is")
  ManualsHelp_L("                      none, +8 will be zero.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  program  uses  the  mapper support  code  by  calling  various")
  ManualsHelp_L("   subroutines.   These  are accessed through a jump table which  is")
  ManualsHelp_L("   located in the MSX-DOS system area.    The consists of  the  jump")
  ManualsHelp_L("   table are as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("     address   entry name    function")
  ManualsHelp_L("")
  ManualsHelp_L("     +0H       ALL_SEG     Allocate a 16k segment.")
  ManualsHelp_L("     +3H       FRE_SEG     Free a 16k segment.")
  ManualsHelp_L("     +6H       RD_SEG      Read byte from address A:HL to A.")
  ManualsHelp_L("     +9H       WR_SEG      Write byte from E to address A:HL.")
  ManualsHelp_L("     +CH       CAL_SEG     Inter-segment call.  Address in Iyh:IX")
  ManualsHelp_L("     +FH       CALLS       Inter-segment  call.   Address  in  line")
  ManualsHelp_L("                           after the call instruction.")
  ManualsHelp_L("     +12H      PUT_PH      Put segment into page (HL).")
  ManualsHelp_L("     +15H      GET_PH      Get current segment for page (HL)")
  ManualsHelp_L("     +18H      PUT_P0      Put segment into page 0.")
  ManualsHelp_L("     +1BH      GET_P0      Get current segment for page 0.")
  ManualsHelp_L("     +1EH      PUT_P1      Put segment into page 1.")
  ManualsHelp_L("     +21H      GET_P1      Get current segment for page 1.")
  ManualsHelp_L("     +24H      PUT_P2      Put segment into page 2.")
  ManualsHelp_L("     +27H      GET_P2      Get current segment for page 2.")
  ManualsHelp_L("     +2AH      PUT_P3      Not supported since page-3 must never be")
  ManualsHelp_L("                           changed.  Acts like a " + Chr(34) + "NOP" + Chr(34) + " if called.")
  ManualsHelp_L("     +2DH      GET_P3      Get current segment for page 3.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  program can use the extended BIOS calls for the mapper support")
  ManualsHelp_L("   to obtain these addresses.   The calls are provided because these")
  ManualsHelp_L("   addresses may be changed in the future version,  or to use mapper")
  ManualsHelp_L("   routines other than MSX-DOS mapper support routines.")
  ManualsHelp_L("")
  ManualsHelp_L("   To use the extended BIOS,  the program should test " + Chr(34) + "HOKVLD" + Chr(34) + "  flag")
  ManualsHelp_L("   at FB20h in page-3.   If bit-0 (LSB) is 0,   there is no extended")
  ManualsHelp_L("   BIOS  nor  the mapper support.   Otherwise,  " + Chr(34) + "EXTBIO" + Chr(34) + " entry  (see")
  ManualsHelp_L("   below)  has  been  set  up and it  can  be  called  with  various")
  ManualsHelp_L("   parameters.    Note   that  this  test  is  unnecessary  for  the")
  ManualsHelp_L("   applications  which  are based on MSX-DOS (such  as  the  program")
  ManualsHelp_L("   which  is loaded from the disk),  and the program may proceed  to")
  ManualsHelp_L("   the next step.")
  ManualsHelp_L("")
  ManualsHelp_L("   Next,  the program sets the device number of the selected BIOS in")
  ManualsHelp_L("   register  D,  the  function number in register  E,  and  required")
  ManualsHelp_L("   parameters  in other registers,  and then calls " + Chr(34) + "EXTBIO" + Chr(34) + " at FFCAh")
  ManualsHelp_L("   in page-3.   In this case,  the stack pointer must be in  page-3.")
  ManualsHelp_L("   If  there  is the extended BIOS for the specified device  number,")
  ManualsHelp_L("   the  contents  of  the  registers AF,  BC,  and  HL  are modified")
  ManualsHelp_L("   according  to  the  function;   otherwise,  they  are  preserved.")
  ManualsHelp_L("   Register  DE  is always preserved.   Note that in any  cases  the")
  ManualsHelp_L("   contents of the alternative registers (AF', BC', DE' and HL') and")
  ManualsHelp_L("   the index registers (IX and IY) are corrupted.")
  ManualsHelp_L("")
  ManualsHelp_L("   The functions available in the mapper support extended BIOS are:")
  ManualsHelp_L("")
  ManualsHelp_L("   * Get mapper variable table")
  ManualsHelp_L("")
  ManualsHelp_L("      Parameter:      A = 0")
  ManualsHelp_L("                      D = 4 (device number of mapper support)")
  ManualsHelp_L("                      E = 1")
  ManualsHelp_L("      Result:         A = slot address of primary mapper")
  ManualsHelp_L("                      DE = reserved")
  ManualsHelp_L("                      HL = start address of mapper variable table")
  ManualsHelp_L("")
  ManualsHelp_L("   * Get mapper support routine address")
  ManualsHelp_L("")
  ManualsHelp_L("      Parameter:      A = 0")
  ManualsHelp_L("                      D = 4")
  ManualsHelp_L("                      E = 2")
  ManualsHelp_L("      Result:         A = total number of memory mapper segments")
  ManualsHelp_L("                      B = slot number of primary mapper")
  ManualsHelp_L("                      C = number of free segments in primary mapper")
  ManualsHelp_L("                     DE = reserved")
  ManualsHelp_L("                     HL = start address of jump table")
  ManualsHelp_L("")
  ManualsHelp_L("   In these mapper support extended BIOS, register A is not required")
  ManualsHelp_L("   to be zero.   Note that,  however,  if there is no mapper support")
  ManualsHelp_L("   routine,  the contents of registers will not be modified, and the")
  ManualsHelp_L("   value which is not zero will be returned in A  otherwise.   Thus,")
  ManualsHelp_L("   the  existence of the mapper support routine can be determined by")
  ManualsHelp_L("   setting zero in A at the calling and examining the returned value")
  ManualsHelp_L("   of A.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  slot address of the primary mapper returned by the  extended")
  ManualsHelp_L("   BIOS is the same as the current RAM slot address in page-3,  and,")
  ManualsHelp_L("   in  the ordinary environment (DISK-BASIC and MSX-DOS),  the  same")
  ManualsHelp_L("   RAM slot is also selected in page-2.   In MSX-DOS,  this is  also")
  ManualsHelp_L("   true in page-0 and page-1.")
  ManualsHelp_L("")
  ManualsHelp_L("  5.3   USING MAPPER ROUTINES")
  ManualsHelp_L("")
  ManualsHelp_L("   A  program  can request a 16k RAM segment at any time by  calling")
  ManualsHelp_L("   the " + Chr(34) + "ALL_SEG" + Chr(34) + " routine.  This either returns an error if there are")
  ManualsHelp_L("   no  free segments,  or the segment number of a new segment  which")
  ManualsHelp_L("   the program can use.  A program must not use any segment which it")
  ManualsHelp_L("   has not explicitly allocated,  except for the four segments which")
  ManualsHelp_L("   make up the basic 64k of RAM.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  segment  can  be allocated either as a user segment  or  as  a")
  ManualsHelp_L("   system segment.   User segments will be automatically freed, when")
  ManualsHelp_L("   the program terminates,   whereas system segments are never freed")
  ManualsHelp_L("   unless  the program frees them  explicitly.   Normally,  programs")
  ManualsHelp_L("   should allocate user segments.")
  ManualsHelp_L("")
  ManualsHelp_L("   RAM  segments  can  be  accessed by  the  " + Chr(34) + "RD_SEG" + Chr(34) + "  and  " + Chr(34) + "WR_SEG" + Chr(34))
  ManualsHelp_L("   routines which read and write bytes to specified  segments.   The")
  ManualsHelp_L("   routines  " + Chr(34) + "CAL_SEG" + Chr(34) + "  and " + Chr(34) + "CALLS" + Chr(34) + " allow inter-segment calls to  be")
  ManualsHelp_L("   done in much the same way as inter-slot calls in the current  MSX")
  ManualsHelp_L("   system.")
  ManualsHelp_L("")
  ManualsHelp_L("   Routines are provided to explicitly page a segment in, or to find")
  ManualsHelp_L("   out which segment is in a particular page.  There are routines in")
  ManualsHelp_L("   which  the  page (0...3) is specified by the top two bits  of  an")
  ManualsHelp_L("   address  in  HL  (" + Chr(34) + "PUT_PH" + Chr(34) + " and " + Chr(34) + "GET_PH" + Chr(34) + ").   And  there  are  also")
  ManualsHelp_L("   specific   routines   for  accessing  each  page  (" + Chr(34) + "GET_Pn" + Chr(34) + "   and")
  ManualsHelp_L("   " + Chr(34) + "PUT_Pn" + Chr(34) + ").   These routines are very fast so a program should not")
  ManualsHelp_L("   suffer in performance by using them.")
  ManualsHelp_L("")
  ManualsHelp_L("   Note that page-3 should never be altered since this contains  the")
  ManualsHelp_L("   mapper support routines and all the other system variables.  Also")
  ManualsHelp_L("   great care must be taken if page-0 is altered since this contains")
  ManualsHelp_L("   the interrupt and the slot-switching entry-points.  Pages 1 and 2")
  ManualsHelp_L("   can be altered in any way.")
  ManualsHelp_L("")
  ManualsHelp_L("   None  of  the  mapper  support routines  will  disturb  the  slot")
  ManualsHelp_L("   selection mechanism at all.  For example when " + Chr(34) + "PUT_P1" + Chr(34) + " is called,")
  ManualsHelp_L("   the   specified   RAM  segment  will  only  appear   at   address")
  ManualsHelp_L("   4000h...7FFFh  if  the mapper slot is selected  in  page-1.   The")
  ManualsHelp_L("   " + Chr(34) + "RD_SEG" + Chr(34) + " and " + Chr(34) + "WR_SEG" + Chr(34) + " routines will always access the RAM segment")
  ManualsHelp_L("   regardless  of the current slot selection in the specified  page,")
  ManualsHelp_L("   but the mapper RAM slot must be selected in page-2.")
  ManualsHelp_L("")
  ManualsHelp_L("  5.4   ALLOCATING and FREEING SEGMENTS")
  ManualsHelp_L("")
  ManualsHelp_L("   The  following  two  routines can be called to allocate  or  free")
  ManualsHelp_L("   segments.   All registers apart from AF and BC are preserved.  An")
  ManualsHelp_L("   error  is indicated by the carry flag being set on  return.   The")
  ManualsHelp_L("   slot  selection  and RAM paging may be in any  state  when  these")
  ManualsHelp_L("   routines  are called and both will be preserved.   The stack must")
  ManualsHelp_L("   not  be  in page-0 or page-2 when either of  these  routines  are")
  ManualsHelp_L("   called.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  program  must not use any segment (apart from the  four  which")
  ManualsHelp_L("   make  up the basic 64k) unless it has specifically allocated  it,")
  ManualsHelp_L("   and must not continue to use a segment after it has been freed.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  segment may be allocated either as a user or a system segment.")
  ManualsHelp_L("   The  only difference is that user segments will be  automatically")
  ManualsHelp_L("   freed  when the program terminates whereas system  segments  will")
  ManualsHelp_L("   not  be.   In  general a program should allocate a  user  segment")
  ManualsHelp_L("   unless  it  needs the data in the segment to outlast the  program")
  ManualsHelp_L("   itself.   User  segments  are always allocated  from  the  lowest")
  ManualsHelp_L("   numbered  free  segment  and  system segments  from  the  highest")
  ManualsHelp_L("   numbered one.")
  ManualsHelp_L("")
  ManualsHelp_L("   An error from " + Chr(34) + "allocate segment" + Chr(34) + " usually indicates that there are")
  ManualsHelp_L("   no  free  segments,  although it can also mean  that  an  invalid")
  ManualsHelp_L("   parameter  was passed in register A and B.    An error from " + Chr(34) + "free")
  ManualsHelp_L("   segment" + Chr(34) + "  indicates  that the specified segment number  does  not")
  ManualsHelp_L("   exist or is already free.")
  ManualsHelp_L("")
  ManualsHelp_L("   ALL_SEG - Parameters:   A=0 => allocate user segment")
  ManualsHelp_L("                           A=1 => allocate system segment")
  ManualsHelp_L("                           B=0 => allocate primary mapper")
  ManualsHelp_L("                          B!=0 => allocate")
  ManualsHelp_L("                      FxxxSSPP slot address (primary mapper, if 0)")
  ManualsHelp_L("                      xxx=000 allocate specified slot only")
  ManualsHelp_L("                      xxx=001 try to allocate specified slot and, if")
  ManualsHelp_L("                              it failed, try another slot (if any)")
  ManualsHelp_L("                      xxx=011 try   to  allocate  other  slots  than")
  ManualsHelp_L("                              specified  and,   if  it  failed,  try")
  ManualsHelp_L("                              specified slot")
  ManualsHelp_L("        Results:      Carry set => no free segments")
  ManualsHelp_L("                      Carry clear => segment allocated")
  ManualsHelp_L("                                     A=new segment number")
  ManualsHelp_L("                                     B=slot  address of mapper  slot")
  ManualsHelp_L("                                       (0 if called as B=0)")
  ManualsHelp_L("")
  ManualsHelp_L("   FRE_SEG - Parameters:   A=segment number to free")
  ManualsHelp_L("                           B=0 primary mapper")
  ManualsHelp_L("                          B!=0 mapper other than primary")
  ManualsHelp_L("             Returns:      Carry set => error")
  ManualsHelp_L("                           Carry clear => segment freed OK")
  ManualsHelp_L("")
  ManualsHelp_L("  5.5   INTER-SEGMENT READ AND WRITE")
  ManualsHelp_L("")
  ManualsHelp_L("   The  following  two  routines can be called to read  or  write  a")
  ManualsHelp_L("   single byte from any mapper RAM segment.  The calling sequence is")
  ManualsHelp_L("   very  similar to the inter-slot read and write routines  provided")
  ManualsHelp_L("   by the MSX system ROM.  All registers apart from AF are preserved")
  ManualsHelp_L("   and  no  checking  is done to ensure that the segment  number  is")
  ManualsHelp_L("   valid.")
  ManualsHelp_L("")
  ManualsHelp_L("   The top two bits of the address are ignored and the data will  be")
  ManualsHelp_L("   always  read  or  written via page-2,  since the  segment  number")
  ManualsHelp_L("   specifies  a  16k segment which could appear in any of  the  four")
  ManualsHelp_L("   pages.  The data will be read or written from the correct segment")
  ManualsHelp_L("   regardless  of the current paging or slot selection in page-0  or")
  ManualsHelp_L("   page-1,  but  note that the mapper RAM slot must be  selected  in")
  ManualsHelp_L("   page-2 when either of these routines are called.  This is so that")
  ManualsHelp_L("   the  routines do not have to do any slot-switching and so can  be")
  ManualsHelp_L("   fast.  Also the stack must not be in page-2.  These routines will")
  ManualsHelp_L("   return disabling interrupts.")
  ManualsHelp_L("")
  ManualsHelp_L("   RD_SEG -  Parameters:   A = segment number to read from")
  ManualsHelp_L("                          HL = address within this segment")
  ManualsHelp_L("             Results:      A = value of byte at address")
  ManualsHelp_L("                           All other registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   WR_SEG -  Parameters:   A = segment number to write to")
  ManualsHelp_L("                          HL = address within this segment")
  ManualsHelp_L("             Returns:      A = corrupted")
  ManualsHelp_L("                           All other registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("  5.6   INTER-SEGMENT CALLS")
  ManualsHelp_L("")
  ManualsHelp_L("   Two  routines are provided for doing inter-segment calls.   These")
  ManualsHelp_L("   are  modelled  very closely on the two inter-slot  call  routines")
  ManualsHelp_L("   provided  by the MSX system ROM,  and the specification of  their")
  ManualsHelp_L("   usage is very similar.")
  ManualsHelp_L("")
  ManualsHelp_L("   No check is done that the called segment actually exists so it is")
  ManualsHelp_L("   the  user's responsibility to ensure this.   The  called  segment")
  ManualsHelp_L("   will  be  paged into the specified address page,  but it  is  the")
  ManualsHelp_L("   user's  responsibility to ensure that the mapper slot is  enabled")
  ManualsHelp_L("   in this page, since neither of these routines will alter the slot")
  ManualsHelp_L("   selection at all.   This is to ensure that they can be fast.")
  ManualsHelp_L("")
  ManualsHelp_L("   The routine cannot be used to do an inter-segment call into page-")
  ManualsHelp_L("   3.   If  this  is attempted then the specified address in  page-3")
  ManualsHelp_L("   will be simply called without any paging, since page-3 must never")
  ManualsHelp_L("   be  altered.   Calling  into page-0 must be done with  some  care")
  ManualsHelp_L("   because of the interrupt and other entry point.   Also care  must")
  ManualsHelp_L("   be taken that the stack is not paged out by these calls.")
  ManualsHelp_L("")
  ManualsHelp_L("   These   routines,   unlike  inter-slot  calls,   do  not  disable")
  ManualsHelp_L("   interrupts before passing control to the called routine.  So they")
  ManualsHelp_L("   return  to  the caller in the same state as  before,  unless  the")
  ManualsHelp_L("   interrupt flag was modified by the called routine.")
  ManualsHelp_L("")
  ManualsHelp_L("   Interrupts.")
  ManualsHelp_L("")
  ManualsHelp_L("   Parameters cannot be passed in registers IX, IY, AF', BC', DE' or")
  ManualsHelp_L("   HL'  since  these  are used internally  in  the  routine.   These")
  ManualsHelp_L("   registers  will  be corrupted by the inter-segment call  and  may")
  ManualsHelp_L("   also  be corrupted by the called routine.   All  other  registers")
  ManualsHelp_L("   (AF,  BC,  DE and HL) will be passed intact to the called routine")
  ManualsHelp_L("   and returned from it to the caller.")
  ManualsHelp_L("")
  ManualsHelp_L("   CAL_SEG - Parameters: IY = segment number to be called")
  ManualsHelp_L("                         IX = address to call")
  ManualsHelp_L("                         AF, BC, DE, HL passed to called routine")
  ManualsHelp_L("                         Other registers corrupted")
  ManualsHelp_L("             Results:    AF,  BC,  DE, HL, IX and IY returned from")
  ManualsHelp_L("                         called routine.  All others corrupted.")
  ManualsHelp_L("")
  ManualsHelp_L("   CALLS -   Parameters:  AF, BC, DE, HL passed to called routine")
  ManualsHelp_L("                          Other registers corrupted")
  ManualsHelp_L("             Calling sequence:   CALL  CALLS")
  ManualsHelp_L("                                 DB    SEGMENT")
  ManualsHelp_L("                                 DW    ADDRESS")
  ManualsHelp_L("             Results:     AF,  BC,  DE, HL, IX and IY returned from")
  ManualsHelp_L("                          called routine.  All others corrupted.")
  ManualsHelp_L("")
  ManualsHelp_L("  5.7   DIRECT PAGING ROUTINES")
  ManualsHelp_L("")
  ManualsHelp_L("   The following routines are provided to allow programs to directly")
  ManualsHelp_L("   manipulate  the current paging state without having to access the")
  ManualsHelp_L("   hardware.   Using  these routines ensures compatibility with  any")
  ManualsHelp_L("   changes  to the details of the hardware.   The routines are  very")
  ManualsHelp_L("   fast  and  so using them will not compromise the  performance  of")
  ManualsHelp_L("   programs.")
  ManualsHelp_L("")
  ManualsHelp_L("   Routines  are  provided to directly read or write to any  of  the")
  ManualsHelp_L("   four page registers.   No checking of the validity of the segment")
  ManualsHelp_L("   number is done so this is the user's responsibility.   Note  that")
  ManualsHelp_L("   the  value written in the register is also written in memory and,")
  ManualsHelp_L("   if  the register value is requested,  the value stored in  memory")
  ManualsHelp_L("   will  be returned and the one in the register will never be  read")
  ManualsHelp_L("   directly.   This is done to avoid errors from hardware  conflicts")
  ManualsHelp_L("   when  there are two or more mapper registers in the system.   The")
  ManualsHelp_L("   user  should  always manipulate the memory mapper  through  these")
  ManualsHelp_L("   routines.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  " + Chr(34) + "GET" + Chr(34) + "  routines return values from internal  images  of  the")
  ManualsHelp_L("   registers  without  actually  reading the  registers  themselves.")
  ManualsHelp_L("   This  ensures  that  if a segment is  enabled  by,  for  example,")
  ManualsHelp_L("   " + Chr(34) + "PUT_P1" + Chr(34) + "  then a subsequent " + Chr(34) + "GET_P1" + Chr(34) + " call will return the  actual")
  ManualsHelp_L("   value.  Reading the mapper register may produce a different value")
  ManualsHelp_L("   because  the  top bits of the segment numbers are  generally  not")
  ManualsHelp_L("   recorded.")
  ManualsHelp_L("")
  ManualsHelp_L("   Although  a " + Chr(34) + "PUT_P3" + Chr(34) + " routine is provided,  it is in fact a  dummy")
  ManualsHelp_L("   routine and will not alter the page-3 register.   This is because")
  ManualsHelp_L("   the contents of the page-3 register should never be altered.  The")
  ManualsHelp_L("   " + Chr(34) + "GET_P3" + Chr(34) + "  routine  does behave as expected to allow the  user  to")
  ManualsHelp_L("   determin what segment is in page-3.")
  ManualsHelp_L("")
  ManualsHelp_L("   Another  pair  of routines (" + Chr(34) + "GET_PH" + Chr(34) + " and  " + Chr(34) + "PUT_PH" + Chr(34) + ")  is  provided")
  ManualsHelp_L("   which are identical in function except that the page is specified")
  ManualsHelp_L("   by the top two bits of register H.   This is useful when register")
  ManualsHelp_L("   HL  contains  an  address,  and  these routines  do  not  corrupt")
  ManualsHelp_L("   register HL.  " + Chr(34) + "PUT_PH" + Chr(34) + " will never alter the page-3 register.")
  ManualsHelp_L("")
  ManualsHelp_L("   PUT_Pn -  Parameters:   n = 0,1,2 or 3 to select page")
  ManualsHelp_L("                           A = segment number")
  ManualsHelp_L("             Results:      None")
  ManualsHelp_L("                           All registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   GET_Pn -  Parameters:   n = 0,1,2 or 3 to select page")
  ManualsHelp_L("             Results:      A = segment number")
  ManualsHelp_L("                           All other registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   PUT_PH -  Parameters:   H = high byte of address")
  ManualsHelp_L("                           A = segment number")
  ManualsHelp_L("             Results:      None")
  ManualsHelp_L("                           All registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   GET_PH -  Parameters:   H = high byte of address")
  ManualsHelp_L("             Results:      A = segment number")
  ManualsHelp_L("                           All other registers preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   Before  using  these direct paging routines to alter  the  paging")
  ManualsHelp_L("   state,  a  program  should  first use the  " + Chr(34) + "GET_Pn" + Chr(34) + "  routines  to")
  ManualsHelp_L("   determine the initial four segments for when it needs to  restore")
  ManualsHelp_L("   these.   No  program should assume fixed values for these initial")
  ManualsHelp_L("   segments  since they are likely to change in future  versions  of")
  ManualsHelp_L("   the systems.")
  ManualsHelp_Commit("MSX-DOS 2 - Interface de Programa", "MSX-DOS 2")

  ManualsHelp_Begin()
  ManualsHelp_L("                  M S X -- D O S   v e r s i o n  2")
  ManualsHelp_L("                  =================================")
  ManualsHelp_L("")
  ManualsHelp_L("                  The advanced disk operating system")
  ManualsHelp_L("")
  ManualsHelp_L("                         for MSX 2 computers")
  ManualsHelp_L("")
  ManualsHelp_L("CONTENTS                                       Page")
  ManualsHelp_L("")
  ManualsHelp_L("1.    Introduction ............................  3")
  ManualsHelp_L("2.    List of functions .......................  4")
  ManualsHelp_L("3.    Function By Function Definitions ........  7")
  ManualsHelp_L("   3.1   \ ")
  ManualsHelp_L("   . .    \  Definitions of each function")
  ManualsHelp_L("   . .    /")
  ManualsHelp_L("   3.90  /    ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  manual describes  in detail  the MSX-DOS  function calls provided by ")
  ManualsHelp_L("MSX-DOS version 2.20")
  ManualsHelp_L("")
  ManualsHelp_L("1.   INTRODUCTION")
  ManualsHelp_L("")
  ManualsHelp_L("   This document describes in detail each of the MSX-DOS 2 function calls. It ")
  ManualsHelp_L("should  be read  in conjunction  with the  " + Chr(34) + "Program Interface  specification" + Chr(34) + " ")
  ManualsHelp_L("which describes  system features  such as  file handles,  fileinfo blocks and ")
  ManualsHelp_L("environment strings in general terms.")
  ManualsHelp_L("")
  ManualsHelp_L("   There are  two ways  of doing  MSX-DOS function  calls, reflecting the two ")
  ManualsHelp_L("different  environments (MSX-DOS and disk BASIC) in which the system can run. ")
  ManualsHelp_L("Transient  programs  running  in  the  MSX-DOS  environment  must  access the ")
  ManualsHelp_L("functions with a " + Chr(34) + "CALL 00005h" + Chr(34) + " instruction. Disk BASIC and other MSX programs ")
  ManualsHelp_L("running  in  the disk  BASIC environment  (usually executing  from ROM)  must ")
  ManualsHelp_L("access the system via a " + Chr(34) + "CALL 0F37Dh" + Chr(34) + " instruction.")
  ManualsHelp_L("")
  ManualsHelp_L("   There   are  some   limitations  when   calling  the  system  via  0F37Dh, ")
  ManualsHelp_L("particularly to do with error handling and abort routines. Also no parameters ")
  ManualsHelp_L("may be passed in page-1, unless they are in the master disk ROM (as they will ")
  ManualsHelp_L("be for  disk BASIC)  since the master disk ROM will be paged into page-1 when ")
  ManualsHelp_L("such  a function  call is  made. The individual function descriptions mention ")
  ManualsHelp_L("the differences for particular functions.")
  ManualsHelp_L("")
  ManualsHelp_L("2.   LIST OF FUNCTIONS")
  ManualsHelp_L("")
  ManualsHelp_L("   Below there  is a  complete list  of the  functions calls. " + Chr(34) + "CPM" + Chr(34) + " indicates ")
  ManualsHelp_L("that the function is compatible with the equivalent CP/M 2.2 function, " + Chr(34) + "MSX1" + Chr(34) + " ")
  ManualsHelp_L("indicates  compatibility  with  MSX-DOS  version  1,  and  " + Chr(34) + "NEW" + Chr(34) + " indicates  a ")
  ManualsHelp_L("function  which is  new to  this system. An asterisk (" + Chr(34) + "*" + Chr(34) + ") indicates that the ")
  ManualsHelp_L("function may  be safely  called from  a user disk error routine (see function ")
  ManualsHelp_L("64h and function 70h).")
  ManualsHelp_L("")
  ManualsHelp_L("List of MSX-DOS 2 Function Calls")
  ManualsHelp_L("")
  ManualsHelp_L("CPM MSX1  00h -  Program terminate")
  ManualsHelp_L("     CPM MSX1* 01h -  Console input")
  ManualsHelp_L("     CPM MSX1* 02h -  Console output")
  ManualsHelp_L("     CPM MSX1* 03h -  Auxiliary input")
  ManualsHelp_L("     CPM MSX1* 04h -  Auxiliary output")
  ManualsHelp_L("     CPM MSX1* 05h -  Printer output")
  ManualsHelp_L("     CPM MSX1* 06h -  Direct console I/O")
  ManualsHelp_L("         MSX1* 07h -  Direct console input")
  ManualsHelp_L("         MSX1* 08h -  Console input without echo")
  ManualsHelp_L("     CPM MSX1* 09h -  String output")
  ManualsHelp_L("     CPM MSX1* 0Ah -  Buffered line input")
  ManualsHelp_L("     CPM MSX1* 0Bh -  Console status")
  ManualsHelp_L("")
  ManualsHelp_L("     CPM MSX1* 0Ch -  Return version number")
  ManualsHelp_L("     CPM MSX1  0Dh -  Disk reset")
  ManualsHelp_L("     CPM MSX1  0Eh -  Select disk")
  ManualsHelp_L("")
  ManualsHelp_L("     CPM MSX1  0Fh -  Open file (FCB)")
  ManualsHelp_L("     CPM MSX1  10h -  Close file (FCB)")
  ManualsHelp_L("     CPM MSX1  11h -  Search for first entry (FCB)")
  ManualsHelp_L("     CPM MSX1  12h -  Search for next entry (FCB)")
  ManualsHelp_L("     CPM MSX1  13h -  Delete file (FCB)")
  ManualsHelp_L("     CPM MSX1  14h -  Sequential read (FCB)")
  ManualsHelp_L("     CPM MSX1  15h -  Sequential write FCB)")
  ManualsHelp_L("     CPM MSX1  16h -  Create file (FCB)")
  ManualsHelp_L("     CPM MSX1  17h -  Rename file (FCB)")
  ManualsHelp_L("")
  ManualsHelp_L("     CPM MSX1* 18h -  Get login vector")
  ManualsHelp_L("     CPM MSX1* 19h -  Get current drive")
  ManualsHelp_L("     CPM MSX1  1Ah -  Set disk transfer address")
  ManualsHelp_L("         MSX1  1Bh -  Get allocation information")
  ManualsHelp_L("               1Ch -  Unused")
  ManualsHelp_L("               1Dh -  Unused")
  ManualsHelp_L("               1Eh -  Unused")
  ManualsHelp_L("               1Fh -  Unused")
  ManualsHelp_L("               20h -  Unused")
  ManualsHelp_L("     CPM MSX1  21h -  Random read (FCB)")
  ManualsHelp_L("     CPM MSX1  22h -  Random write(FCB)")
  ManualsHelp_L("     CPM MSX1  23h -  Get file size (FCB)")
  ManualsHelp_L("     CPM MSX1  24h -  Set random record (FCB)")
  ManualsHelp_L("               25h -  Unused")
  ManualsHelp_L("         MSX1  26h -  Random block write (FCB)")
  ManualsHelp_L("         MSX1  27h -  Random block read (FCB)")
  ManualsHelp_L("     CPM MSX1  28h -  Random write with zero fill (FCB)")
  ManualsHelp_L("               29h -  Unused")
  ManualsHelp_L("         MSX1* 2Ah -  Get date")
  ManualsHelp_L("         MSX1* 2Bh -  Set date")
  ManualsHelp_L("         MSX1* 2Ch -  Get time")
  ManualsHelp_L("         MSX1* 2Dh -  Set time")
  ManualsHelp_L("         MSX1* 2Eh -  Set/reset verify flag ")
  ManualsHelp_L("         MSX1* 2Fh -  Absolute sector read")
  ManualsHelp_L("         MSX1* 30h -  Absolute sector write")
  ManualsHelp_L("         NEW*  31h -  Get disk parameters")
  ManualsHelp_L("")
  ManualsHelp_L("            32h - \ ")
  ManualsHelp_L("            . .    \ Unused")
  ManualsHelp_L("            . .    /")
  ManualsHelp_L("            3Fh - /")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     40h -  Find first entry")
  ManualsHelp_L("    NEW     41h -  Find next entry")
  ManualsHelp_L("    NEW     42h -  Find new entry")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     43h -  Open file handle")
  ManualsHelp_L("    NEW     44h -  Create file handle")
  ManualsHelp_L("    NEW     45h -  Close file handle")
  ManualsHelp_L("    NEW     46h -  Ensure file handle")
  ManualsHelp_L("    NEW     47h -  Duplicate file handle")
  ManualsHelp_L("    NEW     48h -  Read from file handle")
  ManualsHelp_L("    NEW     49h -  Write to file handle")
  ManualsHelp_L("    NEW     4Ah -  Move file handle pointer ")
  ManualsHelp_L("    NEW     4Bh -  I/O control for devices")
  ManualsHelp_L("    NEW     4Ch -  Test file handle ")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     4Dh -  Delete file or subdirectory")
  ManualsHelp_L("    NEW     4Eh -  Rename file or subdirectory")
  ManualsHelp_L("    NEW     4Fh -  Move file or subdirectory")
  ManualsHelp_L("    NEW     50h -  Get/set file attributes")
  ManualsHelp_L("    NEW     51h -  Get/set file date and time")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     52h -  Delete file handle")
  ManualsHelp_L("    NEW     53h -  Rename file handle")
  ManualsHelp_L("    NEW     54h -  Move file handle")
  ManualsHelp_L("    NEW     55h -  Get/set file handle attributes")
  ManualsHelp_L("    NEW     56h -  Get/set file handle date and time")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW   * 57h -  Get disk transfer address")
  ManualsHelp_L("    NEW   * 58h -  Get verify flag setting")
  ManualsHelp_L("    NEW     59h -  Get current directory")
  ManualsHelp_L("    NEW     5Ah -  Change current directory ")
  ManualsHelp_L("    NEW     5Bh -  Parse pathname")
  ManualsHelp_L("    NEW     5Ch -  Parse filename")
  ManualsHelp_L("    NEW   * 5Dh -  Check character")
  ManualsHelp_L("    NEW     5Eh -  Get whole path string")
  ManualsHelp_L("    NEW     5Fh -  Flush disk buffers ")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     60h -  Fork a child process")
  ManualsHelp_L("    NEW     61h -  Rejoin parent process")
  ManualsHelp_L("    NEW     62h -  Terminate with error code")
  ManualsHelp_L("    NEW     63h -  Define abort exit routine")
  ManualsHelp_L("    NEW     64h -  Define disk error handler routine")
  ManualsHelp_L("    NEW   * 65h -  Get previous error code")
  ManualsHelp_L("    NEW   * 66h -  Explain error code ")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW     67h -  Format a disk")
  ManualsHelp_L("    NEW     68h -  Create or destroy RAM disk")
  ManualsHelp_L("    NEW     69h -  Allocate sector buffers")
  ManualsHelp_L("    NEW   * 6Ah -  Logical drive assignment")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW   * 6Bh -  Get environment item")
  ManualsHelp_L("    NEW   * 6Ch -  Set environment item")
  ManualsHelp_L("    NEW   * 6Dh -  Find environment item")
  ManualsHelp_L("")
  ManualsHelp_L("    NEW   * 6Eh -  Get/set disk check status")
  ManualsHelp_L("    NEW   * 6Fh -  Get MSX-DOS version number")
  ManualsHelp_L("    NEW   * 70h -  Get/set redirection status")
  ManualsHelp_L("")
  ManualsHelp_L("3.   FUNCTION BY FUNCTION DEFINITIONS")
  ManualsHelp_L("")
  ManualsHelp_L("   Below are detailed descriptions of each of the MSX-DOS functions including ")
  ManualsHelp_L("both the  old and  new ones. The names in brackets after the function numbers ")
  ManualsHelp_L("are   the  public  labels  for  the  function  codes  which  are  defined  in ")
  ManualsHelp_L(Chr(34) + "CODES.MAC" + Chr(34) + ". Programs should use these names whenever possible. ")
  ManualsHelp_L("")
  ManualsHelp_L("   Many of  the functions below 40h return an error flag rather than an error ")
  ManualsHelp_L("code.  If the  error flag  is set  then the  actual error code indicating the ")
  ManualsHelp_L("cause of  the error can be obtained by the " + Chr(34) + "get previous error code" + Chr(34) + " function ")
  ManualsHelp_L("(function  65h).  All  of the  functions above  40h return  an error  code in ")
  ManualsHelp_L("register  A.  The  " + Chr(34) + "Program Interface  Specification" + Chr(34) + " document  describes the ")
  ManualsHelp_L("general  errors  which  can  be  returned  from  many of  the functions.  The ")
  ManualsHelp_L("individual  function specifications  here describe  the main error conditions ")
  ManualsHelp_L("which are specific to particular functions.")
  ManualsHelp_L("   Note that  many of  the function  calls which  modify the information on a ")
  ManualsHelp_L("disk  do  not  automatically  flush  disk  buffers  and  so  the disk  is not ")
  ManualsHelp_L("necessarily  correctly updated  immediately after  the function call is made. ")
  ManualsHelp_L("Such  calls  include  all  types  of  " + Chr(34) + "create" + Chr(34) + ", " + Chr(34) + "write" + Chr(34) + ",  " + Chr(34) + "delete" + Chr(34) + ", " + Chr(34) + "rename" + Chr(34) + ", ")
  ManualsHelp_L(Chr(34) + "change file  attributes" + Chr(34) + " and " + Chr(34) + "change file date and time" + Chr(34) + " function calls. The ")
  ManualsHelp_L("only  functions which  always flush disk buffers are " + Chr(34) + "flush buffers" + Chr(34) + ", " + Chr(34) + "close" + Chr(34) + " ")
  ManualsHelp_L("and  " + Chr(34) + "ensure" + Chr(34) + ".  After  these  operations the  disk will  always be  correctly ")
  ManualsHelp_L("updated.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.1   PROGRAM TERMINATE (00H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 00H (_TERM0)")
  ManualsHelp_L("     Results:       Does not return")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  terminates program  with a zero return code. It is provided ")
  ManualsHelp_L("for  compatibility with MSX-DOS 1 and CP/M, the preferred method of exiting a ")
  ManualsHelp_L("program is  to use  the " + Chr(34) + "terminate  with error  code" + Chr(34) + " function call (function ")
  ManualsHelp_L("62h),  passing  a  zero  error  code  if  that is  what is  desired. See  the ")
  ManualsHelp_L("description   of  that   function  call,  and  also  the  " + Chr(34) + "Program  Interface ")
  ManualsHelp_L("Specification" + Chr(34) + ", for  details of  what happens when a program terminates. This ")
  ManualsHelp_L("function call never returns to the caller.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.2   CONSOLE INPUT (01H)")
  ManualsHelp_L("")
  ManualsHelp_L("    Parameters:    C = 01H (_CONIN)")
  ManualsHelp_L("    Results:     L=A = Character from keyboard")
  ManualsHelp_L("")
  ManualsHelp_L("   A  character will be read from the standard input (file handle 0 - usually ")
  ManualsHelp_L("the keyboard)  and echoed to the standard output (file handle 1 - usually the ")
  ManualsHelp_L("screen).  If no  character is  ready then  this function  will wait  for one. ")
  ManualsHelp_L("Various control  characters, as  specified for  the " + Chr(34) + "console status" + Chr(34) + " function ")
  ManualsHelp_L("(function  0Bh),  will  be  trapped  by  this  function  for  various control ")
  ManualsHelp_L("purposes.  If one  of these  characters is detected then it will be processed ")
  ManualsHelp_L("and this function will wait for another character. Thus these characters will ")
  ManualsHelp_L("never be returned to the user by this function.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.3   CONSOLE OUTPUT (02H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 02H (_CONOUT)")
  ManualsHelp_L("                    E = Character to be output")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   The character passed in register E is written to the standard output (file ")
  ManualsHelp_L("handle 1 - usually the screen). If printer echo is enabled then the character ")
  ManualsHelp_L("is also  written to  the printer.  Various control codes and escape sequences ")
  ManualsHelp_L("are  interpreted as  screen control codes. A list of these is included in the ")
  ManualsHelp_L(Chr(34) + "Program Interface  Specification" + Chr(34) + ", they  are a sub-set of the standard VT-52 ")
  ManualsHelp_L("control codes. TABs will be expanded to every eighth column.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  console input  status check  is done, and if any of the special control ")
  ManualsHelp_L("characters  described  for the  " + Chr(34) + "console status" + Chr(34) + "  function (function  0Bh) is ")
  ManualsHelp_L("found then  it will  be processed  as for  that function. Any other character ")
  ManualsHelp_L("will be saved internally for a later " + Chr(34) + "console input" + Chr(34) + " function call.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.4   AUXILIARY INPUT (03H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 03H (_AUXIN)")
  ManualsHelp_L("     Results:     L=A = Input character")
  ManualsHelp_L("")
  ManualsHelp_L("   A character is read from the auxiliary input device (file handle 3) and if ")
  ManualsHelp_L("no character  is ready  then it will wait for one. The auxiliary input device ")
  ManualsHelp_L("must  have been installed before this function may be used. If no such device ")
  ManualsHelp_L("has been  installed then  this function  will always  return the  end of file ")
  ManualsHelp_L("character (" + Chr(34) + "Ctrl-Z" + Chr(34) + ").")
  ManualsHelp_L("")
  ManualsHelp_L("  3.5   AUXILIARY OUTPUT (04H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 04H (_AUXOUT)")
  ManualsHelp_L("                   E = Character to be output")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   The character passed in register E will be written to the auxiliary output ")
  ManualsHelp_L("device (file  handle 3). The auxiliary output device must have been installed ")
  ManualsHelp_L("before  this function  may be used. If no such device has been installed then ")
  ManualsHelp_L("this function will simply throw the character away.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.6   PRINTER OUTPUT (05H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 05H (_LSTOUT)")
  ManualsHelp_L("                   E = Character to be output")
  ManualsHelp_L("      Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   The character  passed in  register E  will be sent to the standard printer ")
  ManualsHelp_L("device  (file handle  4 -  usually the parallel printer). The same channel is ")
  ManualsHelp_L("used for console output which is echoed to the printer. TABs are not expanded ")
  ManualsHelp_L("by this  function, although they are expanded when screen output is echoed to ")
  ManualsHelp_L("the printer with " + Chr(34) + "Ctrl-P" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("  3.7   DIRECT CONSOLE I/O (06H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 06H (_DIRIO)")
  ManualsHelp_L("                    E = 00H...FEH - character for output")
  ManualsHelp_L("                      = FFH  - requests input")
  ManualsHelp_L("     Results:     A=L = input - 00H - no character ready")
  ManualsHelp_L("                                else input character")
  ManualsHelp_L("                       undefined for output")
  ManualsHelp_L("")
  ManualsHelp_L("   If  E=FFh on  entry then the keyboard will be examined for a characterfrom ")
  ManualsHelp_L("the standard input (file handle 0) and 00h returned if no character is ready. ")
  ManualsHelp_L("If a  character is  ready then  it will be read from the standard input (file ")
  ManualsHelp_L("handle  0) and  returned in register A without being echoed and with no check ")
  ManualsHelp_L("for control characters.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  E<>FFh  on entry  then the  character in  register E  will be  printed ")
  ManualsHelp_L("directly to  the standard  output (file  handle 1)  with no  TAB expansion or ")
  ManualsHelp_L("printer  echo. Also  no console  status check  is done by this function. Note ")
  ManualsHelp_L("that although  this function  does not  expand TABs,  the VT-52 control codes ")
  ManualsHelp_L("include TAB expansion so the effect on the screen is the same.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.8   DIRECT CONSOLE INPUT (07H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 07H (_DIRIN)")
  ManualsHelp_L("     Results:     L=A = Input character")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  is identical  to the  input option  of function 06h, except ")
  ManualsHelp_L("that  if no  character is  ready it  will wait for one. Like function 06h, no ")
  ManualsHelp_L("echo  or  control  characters  checks  will  be  done.  This function  is not ")
  ManualsHelp_L("compatible with CP/M which uses this function number for " + Chr(34) + "get I/O byte" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("  3.9   CONSOLE INPUT WITHOUT ECHO (08H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 08H (_INNOE)")
  ManualsHelp_L("     Results:     L=A = Input character")
  ManualsHelp_L("")
  ManualsHelp_L("   This function is identical to function 01h except that the input character ")
  ManualsHelp_L("will  not be echoed to the standard output. The same control character checks ")
  ManualsHelp_L("will be  done. This  function is  not compatible  with CP/M  which uses  this ")
  ManualsHelp_L("function number for " + Chr(34) + "set I/O byte" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("  3.10   STRING OUTPUT (09H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 09H (_STROUT)")
  ManualsHelp_L("                  DE = Address of string")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   The characters  of the  string pointed  to by  register DE  will be output ")
  ManualsHelp_L("using  the normal  console output  routine (function call 02h). The string is ")
  ManualsHelp_L("terminated by " + Chr(34) + "$" + Chr(34) + " (ASCII 24h).")
  ManualsHelp_L("")
  ManualsHelp_L("  3.11   BUFFERED LINE INPUT (0AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0AH (_BUFIN)")
  ManualsHelp_L("                   DE = Address of an input buffer")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   DE  must point  to a  buffer to  be used for input. The first byte of this ")
  ManualsHelp_L("buffer  must  contain  the  number of  characters which  the buffer  can hold ")
  ManualsHelp_L("(0...255). A  line of input will be read from the standard input device (file ")
  ManualsHelp_L("handle  0 - usually the keyboard) and stored in the buffer. The input will be ")
  ManualsHelp_L("terminated  when  a  CR  is  read  from  the  standard input.  The number  of ")
  ManualsHelp_L("characters entered,  which does  not include the CR itself, will be stored at ")
  ManualsHelp_L("(DE+1).  If there  is room in the buffer then the CR will be stored after the ")
  ManualsHelp_L("last character.")
  ManualsHelp_L("")
  ManualsHelp_L("   When inputting  from the  keyboard (which  will normally  be the  case), a ")
  ManualsHelp_L("simple  line  editor  is provided,  and also  a 256  byte circular  buffer of ")
  ManualsHelp_L("previous  lines which  can be  edited and  re-entered. The  details of  these ")
  ManualsHelp_L("editing  facilities  are described  in the  separate " + Chr(34) + "Command  Specification" + Chr(34) + " ")
  ManualsHelp_L("document, so  they are not included here. When the input buffer becomes full, ")
  ManualsHelp_L("the console bell will be rung for each character typed which cannot be put in ")
  ManualsHelp_L("the  buffer. Each character entered will be echoed to the standard output and ")
  ManualsHelp_L("also to the printer if printer echo is enabled.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.12   CONSOLE STATUS (0BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0BH (_CONST)")
  ManualsHelp_L("     Results:     L=A = 00H if no key was pressed")
  ManualsHelp_L("                      = FFH if a key was pressed")
  ManualsHelp_L("")
  ManualsHelp_L("   A  flag is returned in register A to indicate whether a character is ready ")
  ManualsHelp_L("(that is,  a key  was pressed) for input from the keyboard. If a character is ")
  ManualsHelp_L("ready then it will be read and tested for certain special control characters. ")
  ManualsHelp_L("If it is not one of these then it is stored in an internal single byte buffer ")
  ManualsHelp_L("and   subsequent  call   to  this  function  will  return  " + Chr(34) + "character  ready" + Chr(34) + " ")
  ManualsHelp_L("immediately  without  checking the  keyboard. If  this function  says that  a ")
  ManualsHelp_L("character is ready then the character may be read by function 02h or 08h.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  character is  " + Chr(34) + "Ctrl-C" + Chr(34) + " then  the program will be terminated with a ")
  ManualsHelp_L(Chr(34) + ".CTRLC" + Chr(34) + "  error  via  the  user's  abort routine  if one  is defined.  If the ")
  ManualsHelp_L("character  is  " + Chr(34) + "Ctrl-P" + Chr(34) + "  then printer  echo will  be enabled  and it  will be ")
  ManualsHelp_L("disabled  if it  is " + Chr(34) + "Ctrl-N" + Chr(34) + ".  If the  character is " + Chr(34) + "Ctrl-S" + Chr(34) + " then the routine ")
  ManualsHelp_L("will hang  up waiting for another character to be pressed and then return " + Chr(34) + "no ")
  ManualsHelp_L("character  ready" + Chr(34) + ", thus  providing a  " + Chr(34) + "wait" + Chr(34) + " facility. The character typed to ")
  ManualsHelp_L("continue operation  will be  ignored, except  that of it is " + Chr(34) + "Ctrl-C" + Chr(34) + " then the ")
  ManualsHelp_L("program  will  be  terminated.  These  same input  checks are  also done  for ")
  ManualsHelp_L("functions 01h, 02h, 08h, 09h and 0Ah.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.13   RETURN VERSION NUMBER (0CH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0CH (_CPMVER)")
  ManualsHelp_L("     Results:     L=A = 22H")
  ManualsHelp_L("                 H=B = 00H ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function  simply  returns  the  CP/M version  number which  is being ")
  ManualsHelp_L("emulated. This is always version 2.2 in current systems. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.14   DISK RESET (0DH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0DH (_DSKRST)")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   Any  data which  is waiting in internal buffers is written out to disk. It ")
  ManualsHelp_L("is not  necessary to call this function in order to allow a disk change as is ")
  ManualsHelp_L("the case with CP/M. The disk transfer address is also set back to its default ")
  ManualsHelp_L("value of 80h by this function.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.15   SELECT DISK (0EH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0EH (_SELDSK)")
  ManualsHelp_L("                    E = Drive number.  0=A:  1=B:   etc.")
  ManualsHelp_L("     Results:     L=A = Number of drives (1...8)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function simply selects the specified drive as the default drive. The ")
  ManualsHelp_L("current  drive is  also stored  at address  0004h for CP/M compatibility. The ")
  ManualsHelp_L("number  of  drives available  is returned  in register  A but  this will  not ")
  ManualsHelp_L("include the RAM disk.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.16   OPEN FILE [FCB] (0FH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 0FH (_FOPEN)")
  ManualsHelp_L("                   DE = Pointer to unopened FCB ")
  ManualsHelp_L("     Results:     L=A = 0FFH if file not found")
  ManualsHelp_L("                           =   0  if file is found")
  ManualsHelp_L("")
  ManualsHelp_L("   The unopened  FCB must  contain a  drive which may be zero to indicate the ")
  ManualsHelp_L("current  drive  and  a filename  and extension  which may  be ambiguous.  The ")
  ManualsHelp_L("current directory of the specified drive will be searched for a matching file ")
  ManualsHelp_L("and if found it will be opened. Matching entries which are sub-directories or ")
  ManualsHelp_L("system files will be ignored, and if the filename is ambiguous then the first ")
  ManualsHelp_L("suitable matching entry will be opened.")
  ManualsHelp_L("")
  ManualsHelp_L("   Device  names may  be put in the FCB (without a colon) to allow devices to ")
  ManualsHelp_L("be accessed  as if  they were  actually disk files. The standard device names ")
  ManualsHelp_L("are defined in the " + Chr(34) + "Program Interface Specification" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("   The  low byte  of the extent number is not altered by this function, and a ")
  ManualsHelp_L("file will only be opened if it is big enough to contain the specified extent. ")
  ManualsHelp_L("Normally the  transient program  will set  the extent  number to  zero before ")
  ManualsHelp_L("calling this function. The high byte of the extent number will be set to zero ")
  ManualsHelp_L("to ensure compatibility with CP/M.")
  ManualsHelp_L("")
  ManualsHelp_L("   The filename  and extension in the FCB will be replaced by the actual name ")
  ManualsHelp_L("of  the file  opened from the directory entry. This will normally be the same ")
  ManualsHelp_L("as what was there before but may be different if an ambiguous filename or one ")
  ManualsHelp_L("with lower case letters in was used. ")
  ManualsHelp_L("")
  ManualsHelp_L("   The  record count  will be  set to  the number  of 128 byte records in the ")
  ManualsHelp_L("specified extent, which is calculated from the file size. The file size field ")
  ManualsHelp_L("itself, the  volume-id and  the 8  reserved bytes  will also  be set  up. The ")
  ManualsHelp_L("current record and random record fields will not be altered by this function, ")
  ManualsHelp_L("it  is the  application program's  responsibility to  initialize them  before ")
  ManualsHelp_L("using the read or write functions.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  the file  cannot be  found, then the " + Chr(34) + "APPEND" + Chr(34) + " environment item will be ")
  ManualsHelp_L("examined. If  this is set then it is interpreted as a drive/path string which ")
  ManualsHelp_L("specifies  a second  directory in  which to  look for the file. The specified ")
  ManualsHelp_L("directory will  be searched  for the  file and  if found it will be opened as ")
  ManualsHelp_L("above.  In this  case the  drive byte  of the FCB will be set to the drive on ")
  ManualsHelp_L("which the  file was  found to  ensure correct  accessing of  the file  if the ")
  ManualsHelp_L("original drive byte was zero (default).")
  ManualsHelp_L("")
  ManualsHelp_L("  3.17   CLOSE FILE [FCB] (10H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 10H (_FCLOSE)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH if not successful")
  ManualsHelp_L("                     =   0  if successful")
  ManualsHelp_L("")
  ManualsHelp_L("   The  FCB must  have previously been opened with either an OPEN or a CREATE ")
  ManualsHelp_L("function  call.  If  the  file has  only been  read then  this function  does ")
  ManualsHelp_L("nothing. If  the file  has been  written to  then any  buffered data  will be ")
  ManualsHelp_L("written  to disk  and the directory entry updated appropriately. The file may ")
  ManualsHelp_L("still be  accessed after a close, so the function can be regarded as doing an ")
  ManualsHelp_L(Chr(34) + "ensure" + Chr(34) + " function.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.18   SEARCH FOR FIRST [FCB] (11H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 11H (_SFIRST)")
  ManualsHelp_L("                   DE = Pointer to unopened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH if file not found")
  ManualsHelp_L("                     =   0  if file found.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function searches the current directory of the drive specified in the ")
  ManualsHelp_L("FCB  (default  drive  if  FCB contains  zero) for  a file  which matches  the ")
  ManualsHelp_L("filename and  extension in the FCB. The filename may be ambiguous (containing ")
  ManualsHelp_L(Chr(34) + "?" + Chr(34) + "  characters) in which case the first match will be found. The low byte of ")
  ManualsHelp_L("the extent  field will  be used,  and a  file will only be found if it is big ")
  ManualsHelp_L("enough  to contain  this extent number. Normally the extent field will be set ")
  ManualsHelp_L("to  zero  by  the  program  before  calling  this  function. System  file and ")
  ManualsHelp_L("sub-directory entries will not be found.")
  ManualsHelp_L("")
  ManualsHelp_L("   If a suitable match is found (A=0) then the directory entry will be copied ")
  ManualsHelp_L("to the  DTA address,  preceded by the drive number. This can be used directly ")
  ManualsHelp_L("as an FCB for an OPEN function call if desired. The extent number will be set ")
  ManualsHelp_L("to  the low byte of the extent from the search FCB, and the record count will ")
  ManualsHelp_L("be initialized  appropriately (as  for OPEN).  The attributes  byte from  the ")
  ManualsHelp_L("directory  entry will  be stored  in the  S1 byte  position, since its normal ")
  ManualsHelp_L("position (immediately  after the  filename extension  field) is  used for the ")
  ManualsHelp_L("extent byte.")
  ManualsHelp_L("")
  ManualsHelp_L("   If no match is found (A=0FFh) then the DTA will not be altered. In no case ")
  ManualsHelp_L("will  the FCB  pointed to  by DE  be modified at all. This function remembers ")
  ManualsHelp_L("sufficient information  internally to  allow it to continue the search with a ")
  ManualsHelp_L("SEARCH  FOR NEXT function, so it is not necessary for the FCB to be preserved ")
  ManualsHelp_L("if doing a SEARCH FOR NEXT function.")
  ManualsHelp_L("")
  ManualsHelp_L("   In CP/M,  if the  drive number  is set  to " + Chr(34) + "?" + Chr(34) + "  in this  function then all ")
  ManualsHelp_L("directory  entries, allocated  or free  will be  matched. Also  if the extent ")
  ManualsHelp_L("field is  set to " + Chr(34) + "?" + Chr(34) + " then any extent of a file will be matched. Both of these ")
  ManualsHelp_L("features  are normally  only used  by special purpose CP/M programs which are ")
  ManualsHelp_L("generally  specific  to  the  CP/M filing  system (such  as " + Chr(34) + "STAT" + Chr(34) + ").  Neither ")
  ManualsHelp_L("feature is present in MSX-DOS 1/2.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.19   SEARCH FOR NEXT [FCB] (12H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 12H (_SNEXT)")
  ManualsHelp_L("     Results:     L=A = 0FFH if file not found")
  ManualsHelp_L("                     =   0  if file found.")
  ManualsHelp_L("")
  ManualsHelp_L("   It continues  the search to look for the next match with the filename. The ")
  ManualsHelp_L("results returned from this function are identical to SEARCH FOR FIRST and all ")
  ManualsHelp_L("the  same comments apply. The information used to continue the search is held ")
  ManualsHelp_L("internally within  MSX-DOS and  so the  original FCB  used in  the SEARCH FOR ")
  ManualsHelp_L("FIRST need not still exist.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.20   DELETE FILE [FCB] (13H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 13H (_FDEL)")
  ManualsHelp_L("                  DE = Pointer to unopened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH if no files deleted")
  ManualsHelp_L("                      =   0  if files deleted OK")
  ManualsHelp_L("")
  ManualsHelp_L("   All  files in  the current directory of the disk specified by the FCB, and ")
  ManualsHelp_L("which match  the ambiguous filename in the FCB, are deleted. Sub-directories, ")
  ManualsHelp_L("system  files, hidden files and read only files are not deleted. If any files ")
  ManualsHelp_L("at all are successfully deleted then this function returns with A=0. A return ")
  ManualsHelp_L("with A=FFh indicates that no files were deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.21   SEQUENTIAL READ [FCB] (14H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 14H (_RDSEQ)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 01H if error (end of file)")
  ManualsHelp_L("                      =  0  if read was successful")
  ManualsHelp_L("")
  ManualsHelp_L("   This function reads the next sequential 128 byte record from the file into ")
  ManualsHelp_L("the  current  disk transfer  address. The  record is  defined by  the current ")
  ManualsHelp_L("extent  (high  and  low  bytes) and  the current  record. After  successfully ")
  ManualsHelp_L("reading the  record, this  function increments  the current  record and if it ")
  ManualsHelp_L("reaches  080h, sets  it back  to zero  and increments  the extent number. The ")
  ManualsHelp_L("record count field is also kept updated when necessary.")
  ManualsHelp_L("")
  ManualsHelp_L("   Unlike  CP/M it  is possible  to have  partially filled records, since the ")
  ManualsHelp_L("file size is not necessarily a multiple of 128 bytes. If this occurs then the ")
  ManualsHelp_L("partial record  is padded  out with zeroes when it is copied to the transient ")
  ManualsHelp_L("program's DTA address.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.22   SEQUENTIAL WRITE [FCB] (15H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 15H (_WRSEQ)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 01H if error (disk full)")
  ManualsHelp_L("                     =  0  if write was successful")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  writes the 128 bytes from the current disk transfer address ")
  ManualsHelp_L("to  the file  at the position defined by the current record and extent, which ")
  ManualsHelp_L("are then  incremented appropriately.  The record  count byte  is kept updated ")
  ManualsHelp_L("correctly  if the  file is  extended or if the write moves into a new extent. ")
  ManualsHelp_L("The file size in the FCB is also updated if the file is extended. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.23   CREATE FILE [FCB] (16H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 16H (_FMAKE)")
  ManualsHelp_L("                   DE = Pointer to unopened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH if unsuccessful")
  ManualsHelp_L("                      =   0  if successful   ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function creates a new file in the current directory of the specified ")
  ManualsHelp_L("drive and opens it ready for reading and writing. The drive, filename and low ")
  ManualsHelp_L("byte of the extent number must be set up in the FCB and the filename must not ")
  ManualsHelp_L("be  ambiguous. Checks  will be  done to ensure that invalid filenames are not ")
  ManualsHelp_L("created.")
  ManualsHelp_L("")
  ManualsHelp_L("   If there is already a file of the required name then the action depends on ")
  ManualsHelp_L("the value  of the  extent number byte. Normally this will be zero and in this ")
  ManualsHelp_L("case  the old  file will  be deleted  and a  new one  created. However if the ")
  ManualsHelp_L("extent  number  is non-zero  then the  existing file  will be  opened without ")
  ManualsHelp_L("creating a  new file.  This ensures compatibility with early versions of CP/M ")
  ManualsHelp_L("where each extent had to be explicitly created.")
  ManualsHelp_L("")
  ManualsHelp_L("   In all  cases the  resulting file  will be opened with the required extent ")
  ManualsHelp_L("number exactly as if an OPEN function call had been done.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.24   RENAME FILE [FCB] (17H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 17H (_FREN)")
  ManualsHelp_L("                   DE = Pointer to unopened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH not if successful")
  ManualsHelp_L("                     =   0  if successful ")
  ManualsHelp_L("")
  ManualsHelp_L("   The  unopened FCB  has the  normal drive  and filename,  and also a second ")
  ManualsHelp_L("filename starting  at (DE+17).  Every file  in the  current directory  of the ")
  ManualsHelp_L("specified  drive which  matches the  first filename, is changed to the second ")
  ManualsHelp_L("filename with  " + Chr(34) + "?" + Chr(34) + " characters  in the second filename leaving the appropriate ")
  ManualsHelp_L("character  unchanged.  Checks  are  done  to  prevent  duplicate  or  illegal ")
  ManualsHelp_L("filenames  from being  created. Entries for sub-directories, hidden files and ")
  ManualsHelp_L("system files will not be renamed. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.25   GET LOGIN VECTOR (18H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 18H (_LOGIN)")
  ManualsHelp_L("     Results:      HL = Login vector")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  returns a  bit set in HL for each drive which is available, ")
  ManualsHelp_L("bit-0 of L corresponding to drive " + Chr(34) + "A:" + Chr(34) + ". Up to eight drives (" + Chr(34) + "A:" + Chr(34) + " to " + Chr(34) + "H:" + Chr(34) + ") are ")
  ManualsHelp_L("supported  by the  system currently,  so register  H will  usually be zero on ")
  ManualsHelp_L("return.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.26   GET CURRENT DRIVE (19H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 19H (_CURDRV)")
  ManualsHelp_L("     Results:     L=A = Current drive (0=A: etc)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function just returns the current drive number.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.27   SET DISK TRANSFER ADDRESS (1AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 1AH (_SETDTA)")
  ManualsHelp_L("                   DE = Required Disk Transfer Address")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   This function simply records the address passed in DE as the disk transfer ")
  ManualsHelp_L("address.  This address  will be  used for  all subsequent  FCB read and write ")
  ManualsHelp_L("calls,  for  " + Chr(34) + "search for  first" + Chr(34) + " and  " + Chr(34) + "search for  next" + Chr(34) + " calls  to store  the ")
  ManualsHelp_L("directory entry, and for absolute read and write calls. It is not used by the ")
  ManualsHelp_L("new MSX-DOS  read and  write functions.  The address  is set back to 80h by a ")
  ManualsHelp_L("DISK RESET call.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.28   GET ALLOCATION INFORMATION (1BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 1BH (_ALLOC)")
  ManualsHelp_L("                    E = Drive number (0=current, 1=A: etc)")
  ManualsHelp_L("     Results:       A = Sectors per cluster")
  ManualsHelp_L("                   BC = Sector size (always 512)")
  ManualsHelp_L("                   DE = Total clusters on disk")
  ManualsHelp_L("                   HL = Free clusters on disk")
  ManualsHelp_L("                   IX = Pointer to DPB")
  ManualsHelp_L("                   IY = Pointer to first FAT sector  ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  returns various information about the disk in the specified ")
  ManualsHelp_L("drive.  It is  not compatible  with CP/M  which uses  this function number to ")
  ManualsHelp_L("return the  address of an allocation vector. Note that unlike MSX-DOS 1, only ")
  ManualsHelp_L("the  first sector  of the FAT may be accessed from the address in IY, and the ")
  ManualsHelp_L("data there will only remain valid until the next MSX-DOS call.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.29   RANDOM READ [FCB] (21H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 21H (_RDRND)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 01H if error (end of file)")
  ManualsHelp_L("                           0  if read was successful")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  reads a  128 byte  record from the file to the current disk ")
  ManualsHelp_L("transfer  address. The  file position  is defined  by the  three byte  random ")
  ManualsHelp_L("record number  in the  FCB (bytes  21h...23h). Unlike CP/M all three bytes of ")
  ManualsHelp_L("the  random record  number are  used. A partial record at the end of the file ")
  ManualsHelp_L("will be padded with zeroes before being copied to the user's DTA.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  random  record  number is  not altered  so successive  calls to  this ")
  ManualsHelp_L("function  will read  the same  record unless the transient program alters the ")
  ManualsHelp_L("random record number. A side effect is that the current record and extent are ")
  ManualsHelp_L("set up  to refer  to the  same record as the random record number. This means ")
  ManualsHelp_L("that  sequential reads  (or writes)  can follow  a random read and will start ")
  ManualsHelp_L("from the  same record. The record count byte is also set up correctly for the ")
  ManualsHelp_L("extent.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.30   RANDOM WRITE [FCB] (22H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 22H (_WRRND)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 01H if error (disk full)")
  ManualsHelp_L("                        =  0  if no error ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function writes  a 128  byte record  from the  current disk transfer ")
  ManualsHelp_L("address to  the file,  at the  record position  specified by  the three  byte ")
  ManualsHelp_L("random  record number (bytes 21h...23h). All three bytes of the random record ")
  ManualsHelp_L("number are  used. If  the record  position is  beyond the current end of file ")
  ManualsHelp_L("then un-initialized disk space will be allocated to fill the gap.")
  ManualsHelp_L("")
  ManualsHelp_L("   The random record number field will not be changed, but the current record ")
  ManualsHelp_L("and extent  fields will  be set  up to  refer to  the same record. The record ")
  ManualsHelp_L("count  byte will be adjusted as necessary if the file is being extended or if ")
  ManualsHelp_L("the write goes into a new extent. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.31   GET FILE SIZE [FCB] (23H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 23H (_FSIZE)")
  ManualsHelp_L("                   DE = Pointer to unopened FCB")
  ManualsHelp_L("     Results:     L=A = 0FFH if file not found")
  ManualsHelp_L("                        =   0  if file found OK")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  searches for  the first match with the filename in the FCB, ")
  ManualsHelp_L("exactly the same as OPEN FILE (function 0FH). The size of the located file is ")
  ManualsHelp_L("rounded up to the nearest 128 bytes and the number of records determined. The ")
  ManualsHelp_L("three byte random record field of the FCB is set to the number of records, so ")
  ManualsHelp_L("it is the number of the first record which does not exist. The fourth byte of ")
  ManualsHelp_L("the random record number is not altered.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.32   SET RANDOM RECORD [FCB] (24H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 24H (_SETRND)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   This function simply sets the three byte random record field in the FCB to ")
  ManualsHelp_L("the record  determined by  the current  record and  extent number. The fourth ")
  ManualsHelp_L("byte  of the  random record  number is  not altered.  No check  is done as to ")
  ManualsHelp_L("whether the record actually exists in the file.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.33   RANDOM BLOCK WRITE [FCB] (26H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 26H (_WRBLK)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("                   HL = Number of records to write")
  ManualsHelp_L("     Results:       A = 01H if error ")
  ManualsHelp_L("                      =  0  if no error")
  ManualsHelp_L("")
  ManualsHelp_L("   Data  is written from the current disk transfer address to the position in ")
  ManualsHelp_L("the file  defined by  the random record number. The record size is determined ")
  ManualsHelp_L("by  the record size field in the FCB (bytes 0Eh and 0Fh) which must be set by ")
  ManualsHelp_L("the user  after opening  the file  and before  calling this  function. If the ")
  ManualsHelp_L("record  size is  less than  64 bytes then all four bytes of the random record ")
  ManualsHelp_L("number are used, otherwise only the first three are used.")
  ManualsHelp_L("")
  ManualsHelp_L("   The number  of records to be written is specified by HL, and together with ")
  ManualsHelp_L("the  record size  this determines  the amount of data to be written. An error ")
  ManualsHelp_L("will be returned if the size exceeds 64k, thus limiting the maximum size of a ")
  ManualsHelp_L("transfer.")
  ManualsHelp_L("")
  ManualsHelp_L("   After  writing the  data, the  random record field is adjusted to the next ")
  ManualsHelp_L("record number  in the file (ie. HL is added on to it). The current record and ")
  ManualsHelp_L("extent  fields are not used or altered. The file size field is updated if the ")
  ManualsHelp_L("file has been extended.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  record size  can be any value from 1...0FFFFh. Small record sizes are ")
  ManualsHelp_L("no less  efficient that  large record sizes so if desired the record size can ")
  ManualsHelp_L("be set to one and the record count then becomes a byte count. It is desirable ")
  ManualsHelp_L("to  write as much as possible with one function call since one large transfer ")
  ManualsHelp_L("will be quicker than several small ones.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  the number  of records  to write  (HL) is  zero then  no data  will be ")
  ManualsHelp_L("written, but  the size  of the file will be altered to the value specified by ")
  ManualsHelp_L("the random record field. This may be either longer or shorter than the file's ")
  ManualsHelp_L("current  size  and  disk  space  will  be  allocated  or  freed as  required. ")
  ManualsHelp_L("Additional  disk space  allocated in  this way will not be initialized to any ")
  ManualsHelp_L("particular value.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.34   RANDOM BLOCK READ [FCB] (27H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 27H (_RDBLK)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("                   HL = Number of records to read")
  ManualsHelp_L("     Results:       A = 01H if error (usually caused by end-of-file)")
  ManualsHelp_L("                      =  0  if no error")
  ManualsHelp_L("                   HL = Number of records actually read")
  ManualsHelp_L("")
  ManualsHelp_L("This  function is  the complement of the BLOCK WRITE function described above ")
  ManualsHelp_L("and most of the same comments apply as regards its use. Again if large blocks ")
  ManualsHelp_L("are read then it will be much faster than the normal CP/M operation.")
  ManualsHelp_L("   For example if it is desired to read 20k from a file, it is better to read ")
  ManualsHelp_L("the 20k  with one  function call rather than 20 separate function calls of 1k ")
  ManualsHelp_L("each.  However it  makes no  difference whether  the 20k  read is done with a ")
  ManualsHelp_L("record size  of 1  and a record count of 20k, with a record size of 20k and a ")
  ManualsHelp_L("record count of 1, or any intermediate combination.")
  ManualsHelp_L("")
  ManualsHelp_L("   The number of records actually read is returned in HL. This may be smaller ")
  ManualsHelp_L("than the  number of records requested if the end of the file was encountered. ")
  ManualsHelp_L("In  this case  any partial record will be padded out with zeroes before being ")
  ManualsHelp_L("copied to  the users  DTA. The  random record  field is adjusted to the first ")
  ManualsHelp_L("record not read, ie. the value returned in HL is added on to it.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.35   RANDOM WRITE WITH ZERO FILL [FCB] (28H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 28H (_WRZER)")
  ManualsHelp_L("                   DE = Pointer to opened FCB")
  ManualsHelp_L("     Results:     L=A = 01H if error")
  ManualsHelp_L("                     = 00H if no error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function is  identical to RANDOM WRITE (function 22h) except that if ")
  ManualsHelp_L("the file has to be extended, any extra allocated disk clusters will be filled ")
  ManualsHelp_L("with zeroes before writing the data. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.36   GET DATE (2AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2AH (_GDATE)")
  ManualsHelp_L("     Results:      HL = Year 1980...2079")
  ManualsHelp_L("                   D = Month (1=Jan...12=Dec)")
  ManualsHelp_L("                   E = Date (1...31)")
  ManualsHelp_L("                   A = Day of week (0=Sun...6=Sat)    ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function simply returns the current value of the internal calender in ")
  ManualsHelp_L("the format shown.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.37   SET DATE (2BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2BH (_SDATE)")
  ManualsHelp_L("                   HL = Year 1980...2079")
  ManualsHelp_L("                   D = Month (1=Jan...12=Dec)")
  ManualsHelp_L("                   E = Date (1...31)")
  ManualsHelp_L("     Results:      A = 00H if date was valid")
  ManualsHelp_L("                       FFH if date was invalid")
  ManualsHelp_L("")
  ManualsHelp_L("   The supplied  date is  checked for  validity and if it is valid then it is ")
  ManualsHelp_L("stored  as the  new date.  The validity  checks include full checking for the ")
  ManualsHelp_L("number of  days in each month and leap years. If the date is invalid then the ")
  ManualsHelp_L("current  date will  be left  unaltered. The  date is  stored in the real time ")
  ManualsHelp_L("clock chip so it will be remembered when the machine is turned off.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.38   GET TIME (2CH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2CH (_GTIME)")
  ManualsHelp_L("     Results:       H = Hours (0...23)")
  ManualsHelp_L("                    L = Minutes (0...59)")
  ManualsHelp_L("                    D = Seconds (0...59)")
  ManualsHelp_L("                    E = Centiseconds (always zero)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  returns the current value of the system clock in the format ")
  ManualsHelp_L("shown.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.39   SET TIME (2DH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2DH (_STIME)")
  ManualsHelp_L("                    H = Hours (0...23)")
  ManualsHelp_L("                    L = Minutes (0...59)")
  ManualsHelp_L("                    D = Seconds (0...59)")
  ManualsHelp_L("                    E = Centiseconds (ignored)")
  ManualsHelp_L("     Results:       A = 00H if time was valid")
  ManualsHelp_L("                        FFH if time was invalid")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  sets the internal system clock to the specified time value. ")
  ManualsHelp_L("If  the time  is invalid then register A will be returned as 0FFh to indicate ")
  ManualsHelp_L("an error  and the  current time will be left unaltered. The time is stored in ")
  ManualsHelp_L("the  real time  clock chip and so it will be remembered and kept correct when ")
  ManualsHelp_L("the machine is turned off.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.40   SET/RESET VERIFY FLAG (2EH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2EH (_VERIFY)")
  ManualsHelp_L("                    E =  0 to disable verify")
  ManualsHelp_L("                      <> 0 to enable verify  ")
  ManualsHelp_L("     Results:       None")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  simply enables  or disables  automatic verification  of all ")
  ManualsHelp_L("writes.  It  defaults  to off  when MSX-DOS  is started  up. Enabling  verify ")
  ManualsHelp_L("improves  system reliability  but also slows down write operations. Note that ")
  ManualsHelp_L("this function  depends on  the disk  driver and  the verification will not be ")
  ManualsHelp_L("done if the driver does not support it.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.41   ABSOLUTE SECTOR READ (2FH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 2FH (_RDABS)")
  ManualsHelp_L("                   DE = Sector number")
  ManualsHelp_L("                    L = Drive number (0=A: etc.)")
  ManualsHelp_L("                    H = Number of sectors to read")
  ManualsHelp_L("     Results:       A = Error code (0=> no error)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  reads sectors  directly from  the disk without interpreting ")
  ManualsHelp_L("them  as files.  The disk  must be  a valid  DOS disk in order for the sector ")
  ManualsHelp_L("number to  be translated  into a  physical position  on the disk. The sectors ")
  ManualsHelp_L("will  be read  to the  current disk  transfer address. Any disk error will be ")
  ManualsHelp_L("reported by the system in the usual way.")
  ManualsHelp_L("")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.42   ABSOLUTE SECTOR WRITE (30H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 30H (_WRABS)")
  ManualsHelp_L("                   DE = Sector number")
  ManualsHelp_L("                    L = Drive number (0=A: etc.)")
  ManualsHelp_L("                    H = Number of sectors to write")
  ManualsHelp_L("     Results:       A = Error code")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function writes  sectors directly  to the  disk without interpreting ")
  ManualsHelp_L("them as  files. The  disk must  be a  valid DOS  disk in order for the sector ")
  ManualsHelp_L("number  to be  translated into  a physical  position on the disk. The sectors ")
  ManualsHelp_L("will be  written from  the current disk transfer address. Any disk errors are ")
  ManualsHelp_L("reported by the system in the usual way.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.43   GET DISK PARAMETERS (31H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 31H (_DPARM)")
  ManualsHelp_L("                   DE = Pointer to 32 byte buffer")
  ManualsHelp_L("                    L = Drive number (0=default, 1=A: etc.)")
  ManualsHelp_L("     Results:       A = Error code")
  ManualsHelp_L("                   DE = Preserved")
  ManualsHelp_L("")
  ManualsHelp_L("   This functions  returns a  series of  parameters relating to the format of ")
  ManualsHelp_L("the  disk in  the specified  drive, to the buffer allocated within the user's ")
  ManualsHelp_L("program. It  is useful  for programs  which are  going to  do absolute sector ")
  ManualsHelp_L("reads  and writes,  in order  for them  to be  able to interpret the absolute ")
  ManualsHelp_L("sector numbers. The parameters returned contain some redundant information in ")
  ManualsHelp_L("order to  provide parameters which are most useful to transient programs. The ")
  ManualsHelp_L("format of the returned parameter block is:")
  ManualsHelp_L("")
  ManualsHelp_L("     DE+0      - Physical drive number (1=A: etc)")
  ManualsHelp_L("     DE+1,2    - Sector size (always 512 currently)")
  ManualsHelp_L("     DE+3      - Sectors per cluster (non-zero power of 2)")
  ManualsHelp_L("     DE+4,5    - Number of reserved sectors (usually 1)")
  ManualsHelp_L("     DE+6      - Number of copies of the FAT (usually 2)")
  ManualsHelp_L("     DE+7,8    - Number of root directory entries")
  ManualsHelp_L("     DE+9,10   - Total number of logical sectors")
  ManualsHelp_L("     DE+11     - Media descriptor byte")
  ManualsHelp_L("     DE+12     - Number of sectors per FAT")
  ManualsHelp_L("     DE+13..14 - First root directory sector number")
  ManualsHelp_L("     DE+15..16 - First data sector number")
  ManualsHelp_L("     DE+17..18 - Maximum cluster number")
  ManualsHelp_L("     DE+19     - Dirty disk flag")
  ManualsHelp_L("     DE+20..23 - Volume id. (-1 => no volume id.)")
  ManualsHelp_L("     DE+24..31 - Reserved (currently always zero)  ")
  ManualsHelp_L("")
  ManualsHelp_L("   The dirty  disk flag  indicates whether  in the disk there is a file which ")
  ManualsHelp_L("can  be recovered  by UNDEL  command. It is reset when the file allocation is ")
  ManualsHelp_L("done.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.44   FIND FIRST ENTRY (40H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 40H (_FFIRST) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                        HL = filename ASCIIZ string (only if")
  ManualsHelp_L("                                DE = fileinfo pointer)")
  ManualsHelp_L("                         B = Search attributes")
  ManualsHelp_L("                   IX = Pointer to new fileinfo block")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                 (IX) = Filled in with matching entry ")
  ManualsHelp_L("")
  ManualsHelp_L("   The " + Chr(34) + "drive/path" + Chr(34) + " portion of the string, or the fileinfo block, specifies a ")
  ManualsHelp_L("directory which  is to  be searched.  A " + Chr(34) + ".IATTR" + Chr(34) + "  error will be returned if a ")
  ManualsHelp_L("fileinfo  block which  specifies a  file is passed. The " + Chr(34) + "file" + Chr(34) + " portion of the ")
  ManualsHelp_L("string, or  the filename  ASCIIZ string in HL, determines what filenames will ")
  ManualsHelp_L("be matched. If no match is found then a " + Chr(34) + ".NOFIL" + Chr(34) + " error is returned, otherwise ")
  ManualsHelp_L("the  fileinfo block  pointed to  by IX  is filled  in with the details of the ")
  ManualsHelp_L("matching entry.")
  ManualsHelp_L("")
  ManualsHelp_L("   The filename  may contain  ambiguous filename  characters (" + Chr(34) + "?" + Chr(34) + "  or " + Chr(34) + "*" + Chr(34) + ") in ")
  ManualsHelp_L("which case the first matching entry will be returned. If the filename is null ")
  ManualsHelp_L("(either  the ASCIIZ  string pointed  to by DE is null or ends in a " + Chr(34) + "\" + Chr(34) + " or the ")
  ManualsHelp_L("filename string  pointed to  by HL  is null),  then this function will behave ")
  ManualsHelp_L("exactly as if the filename was " + Chr(34) + "*.*" + Chr(34) + " so any name will match.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  attributes byte  in register  B specifies  what type of entry will be ")
  ManualsHelp_L("matched. If  it is zero then only non-hidden, non-system files will be found. ")
  ManualsHelp_L("If  the directory,  hidden or  system bits in register B are set then entries ")
  ManualsHelp_L("with these  attributes will  be matched  as well  as ordinary files. The read ")
  ManualsHelp_L("only and archive bits of register B are ignored.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  volume name bit of register B is set then the search is exclusive, ")
  ManualsHelp_L("only  the volume  label entry  will be  found. In this case also the fileinfo ")
  ManualsHelp_L("block  and  filename or  the drive/path/file  string are  ignored apart  from ")
  ManualsHelp_L("specifying the drive. This means that the volume name will always be found in ")
  ManualsHelp_L("the root directory if it exists whether or not it matches the filename given.")
  ManualsHelp_L("")
  ManualsHelp_L("   If DE  points to  a fileinfo  block, then  if desired, IX can point to the ")
  ManualsHelp_L("same  fileinfo block.  In this  case when  a match  is found the new fileinfo ")
  ManualsHelp_L("block will overwrite the old one.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.45   FIND NEXT ENTRY (41H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 41H (_FNEXT) ")
  ManualsHelp_L("                        IX = Pointer to fileinfo block from")
  ManualsHelp_L("                             previous find first function. ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                 (IX) = Filled in with next matching entry ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  should only  be used  after a  " + Chr(34) + "find first  entry" + Chr(34) + " function ")
  ManualsHelp_L("call.  It  searches  the  directory  for the  next match  to the  (presumably ")
  ManualsHelp_L("ambiguous)  filename which was given to the " + Chr(34) + "find first entry" + Chr(34) + " function call. ")
  ManualsHelp_L("If there  are no  more matching  entries then  a " + Chr(34) + ".NOFIL" + Chr(34) + "  error is returned, ")
  ManualsHelp_L("otherwise  the fileinfo block is filled in with the information about the new ")
  ManualsHelp_L("matching entry.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.46   FIND NEW ENTRY (42H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 42H (_FNEW) ")
  ManualsHelp_L("                        DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                        HL = filename ASCIIZ string (only if")
  ManualsHelp_L("                                DE = fileinfo pointer)")
  ManualsHelp_L("                         B = b0..b6 = Required attributes")
  ManualsHelp_L("                             b7 = Create new flag")
  ManualsHelp_L("                   IX = Pointer to new fileinfo block")
  ManualsHelp_L("                         containing template filename")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                 (IX) = Filled in with new entry ")
  ManualsHelp_L("")
  ManualsHelp_L("   This function is very similar to the " + Chr(34) + "find first entry" + Chr(34) + " function described ")
  ManualsHelp_L("above. The  parameters in  HL and  DE are  used in  exactly the  same way  to ")
  ManualsHelp_L("specify  a  directory  entry.  However  instead  of  searching  the  selected ")
  ManualsHelp_L("directory  for an entry which matches the specified name, a new entry will be ")
  ManualsHelp_L("created with this name. The fileinfo block pointed to by IX will be filled in ")
  ManualsHelp_L("with information  about the  new entry  just as  if it  had been found with a ")
  ManualsHelp_L(Chr(34) + "find first entry" + Chr(34) + " call.")
  ManualsHelp_L("")
  ManualsHelp_L("   If there  are any  ambiguous characters (" + Chr(34) + "?" + Chr(34) + " or " + Chr(34) + "*" + Chr(34) + ") in the filename, then ")
  ManualsHelp_L("they will be replaced by the appropriate character from a " + Chr(34) + "template filename" + Chr(34) + " ")
  ManualsHelp_L("in  the filename  position of the new fileinfo block pointed to by IX. If the ")
  ManualsHelp_L("result is  still ambiguous,  or otherwise  illegal, then  a " + Chr(34) + ".IFNM" + Chr(34) + "  error is ")
  ManualsHelp_L("returned. This is useful for copy operations which do an automatic rename.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("   Like  " + Chr(34) + "find first entry" + Chr(34) + ", if the filename is null, then it will be treated ")
  ManualsHelp_L("exactly as  if it  was " + Chr(34) + "*.*" + Chr(34) + ".  For this function that means that the template ")
  ManualsHelp_L("filename will be used as the new filename to create.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  " + Chr(34) + ".DRFUL" + Chr(34) + "  error  will  be  returned if  there is  no room  in the  root ")
  ManualsHelp_L("directory, and a " + Chr(34) + ".DKFUL" + Chr(34) + " if a sub-directory must be extended and the disk is ")
  ManualsHelp_L("already full.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  attribute byte  passed in  register B  is the attribute which the new ")
  ManualsHelp_L("entry will be given. If the volume name bit is set then a volume name will be ")
  ManualsHelp_L("created in  the root  directory. If  the directory  bit is set then the entry ")
  ManualsHelp_L("created  will be  for a  sub-directory, otherwise  it will be for a file. The ")
  ManualsHelp_L("system, hidden  and read  only bits may be set for a file, and the hidden bit ")
  ManualsHelp_L("for a sub-directory. A file will always be created with the archive attribute ")
  ManualsHelp_L("bit set.")
  ManualsHelp_L("")
  ManualsHelp_L("   A file  will be  created as  zero length with the current date and time. A ")
  ManualsHelp_L("sub-directory will have a single cluster allocated to it and the " + Chr(34) + "." + Chr(34) + " and " + Chr(34) + ".." + Chr(34) + " ")
  ManualsHelp_L("entries will be initialized appropriately.")
  ManualsHelp_L("")
  ManualsHelp_L("   If there is already an entry with the specified name in the directory then ")
  ManualsHelp_L("the action depends on the " + Chr(34) + "create new" + Chr(34) + " flag (bit-7 of register B) and also on ")
  ManualsHelp_L("the type  of the entry. If the " + Chr(34) + "create new" + Chr(34) + " flag is set then a " + Chr(34) + ".FILEX" + Chr(34) + " error ")
  ManualsHelp_L("will  always be returned. Setting this flag thereforeensures that an existing ")
  ManualsHelp_L("file will not be deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  an entry  already exists and the " + Chr(34) + "create new" + Chr(34) + " flag is not set then the ")
  ManualsHelp_L("type of  the existing  entry is  examined to see whether it can be deleted to ")
  ManualsHelp_L("make  room for the new file. An error will be returned if the entry is a read ")
  ManualsHelp_L("only file  (" + Chr(34) + ".FILRO" + Chr(34) + " error), a system file (" + Chr(34) + ".SYSX" + Chr(34) + " error) or a sub-directory ")
  ManualsHelp_L("(" + Chr(34) + ".DIRX" + Chr(34) + " error) or there is a file handle already open to this file (" + Chr(34) + ".FOPEN" + Chr(34) + " ")
  ManualsHelp_L("error). If we are trying to create a sub-directory then even an ordinary file ")
  ManualsHelp_L("will not be deleted (" + Chr(34) + ".FILEX" + Chr(34) + " error).")
  ManualsHelp_L("")
  ManualsHelp_L("   For  all  of  these  error  codes (" + Chr(34) + ".FILEX" + Chr(34) + ",  " + Chr(34) + ".FILRO" + Chr(34) + ", " + Chr(34) + ".SYSX" + Chr(34) + ",  " + Chr(34) + ".DIRX" + Chr(34) + ", ")
  ManualsHelp_L(Chr(34) + ".FOPEN" + Chr(34) + "),  the  fileinfo  block will  be filed  in with  the details  of the ")
  ManualsHelp_L("already  existing entry  and this fileinfo block may be used exactly as if it ")
  ManualsHelp_L("had been returned from a " + Chr(34) + "find first" + Chr(34) + " function.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.47   OPEN FILE HANDLE (43H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 43H (_OPEN) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                            or fileinfo block pointer")
  ManualsHelp_L("                    A = Open mode. b0 set => no write")
  ManualsHelp_L("                                   b1 set => no read")
  ManualsHelp_L("                                   b2 set => inheritable   ")
  ManualsHelp_L("                                   b3..b7   -  must be clear")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = New file handle  ")
  ManualsHelp_L("")
  ManualsHelp_L("   The  drive/path/file string or the fileinfo block should normally refer to ")
  ManualsHelp_L("a file  rather than  a sub-directory  or volume  name. If it is a volume name ")
  ManualsHelp_L("then a " + Chr(34) + ".IATTR" + Chr(34) + " error will be returned. If it is a sub-directory then " + Chr(34) + ".DIRX" + Chr(34) + " ")
  ManualsHelp_L("error will be returned.")
  ManualsHelp_L("")
  ManualsHelp_L("   Assuming that a file is specified then it will be opened ready for reading ")
  ManualsHelp_L("and/or writing (depending on the open mode in A) and a new file handle for it ")
  ManualsHelp_L("will  be returned in register B. The lowest available file handle number will ")
  ManualsHelp_L("be used and an error will result if there are no spare file handles (" + Chr(34) + ".NHAND" + Chr(34) + " ")
  ManualsHelp_L("error), or insufficient memory (" + Chr(34) + ".NORAM" + Chr(34) + " error).")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  " + Chr(34) + "no read" + Chr(34) + " bit of register A is set then reads from the file handle ")
  ManualsHelp_L("will  be  rejected  and if  the " + Chr(34) + "no  write" + Chr(34) + " bit  is set  then writes  will be ")
  ManualsHelp_L("rejected,  in both  cases with an " + Chr(34) + ".ACCV" + Chr(34) + " error. Writes will also be rejected ")
  ManualsHelp_L("if  the  file is  read only  (" + Chr(34) + ".FILRO" + Chr(34) + " error).  If the  " + Chr(34) + "inheritable" + Chr(34) + " bit  of ")
  ManualsHelp_L("register A  is set  then the  file handle  will be inherited by a new process ")
  ManualsHelp_L("created by the " + Chr(34) + "fork" + Chr(34) + " function call (see function 60h).")
  ManualsHelp_L("")
  ManualsHelp_L("   If a  device file  handle is opened by giving a filename which matches one ")
  ManualsHelp_L("of  the built in devices (for example " + Chr(34) + "CON" + Chr(34) + " or " + Chr(34) + "NUL" + Chr(34) + "), then it will always be ")
  ManualsHelp_L("opened initially in ASCII mode. The IOCTL function (function 4Bh) can be used ")
  ManualsHelp_L("to change  this to  binary mode  but great care must be taken in reading from ")
  ManualsHelp_L("devices in binary mode because there is no end of file condition.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.48   CREATE FILE HANDLE (44H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 44H (_CREATE) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                    A = Open mode. b0 set => no write")
  ManualsHelp_L("                                   b1 set => no read")
  ManualsHelp_L("                                   b2 set => inheritable   ")
  ManualsHelp_L("                                 b3..b7   -  must be clear")
  ManualsHelp_L("                    B = b0..b6 = Required attributes")
  ManualsHelp_L("                            b7 = Create new flag")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = New file handle  ")
  ManualsHelp_L("")
  ManualsHelp_L("   A file  or sub-directory,  as specified  by the  attributes in register B, ")
  ManualsHelp_L("will  be  created  with  the  name  and  in  the  directory specified  by the ")
  ManualsHelp_L("drive/path/file  string. A " + Chr(34) + ".IATTR" + Chr(34) + " error is returned if register B specifies ")
  ManualsHelp_L("a volume name.")
  ManualsHelp_L("")
  ManualsHelp_L("   An error  will be returned if the file or sub-directory cannot be created. ")
  ManualsHelp_L("The  error conditions  in this  case are the same as for the " + Chr(34) + "find new entry" + Chr(34) + " ")
  ManualsHelp_L("function (function  42h) with  the main  error codes being " + Chr(34) + ".FILEX" + Chr(34) + ", " + Chr(34) + ".DIRX" + Chr(34) + ", ")
  ManualsHelp_L(Chr(34) + ".SYSX" + Chr(34) + ",  " + Chr(34) + ".FILRO" + Chr(34) + ",  " + Chr(34) + ".FOPEN" + Chr(34) + ",  " + Chr(34) + ".DRFUL" + Chr(34) + " and  " + Chr(34) + ".DKFUL" + Chr(34) + ". Like  the " + Chr(34) + "find  new" + Chr(34) + " ")
  ManualsHelp_L("function,  if the  " + Chr(34) + "create new" + Chr(34) + "  flag (bit-7  of register  B) is  set then an ")
  ManualsHelp_L("existing file will not be deleted and will always return a " + Chr(34) + ".FILEX" + Chr(34) + " error.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  attributes byte  specifies a sub-directory then the hidden bit may ")
  ManualsHelp_L("also  be set to create a hidden sub-directory. For a file, the hidden, system ")
  ManualsHelp_L("or  read  only  bits  may  be  set  to  create  a  file with  the appropriate ")
  ManualsHelp_L("attributes. An  invalid attributes  bits will  simply be ignored. A file will ")
  ManualsHelp_L("always be created with the archive attribute bit set.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  file  will  automatically  be opened  just as  for the  " + Chr(34) + "open" + Chr(34) + " function ")
  ManualsHelp_L("described above,  and a  file handle  returned in register B. The " + Chr(34) + "open mode" + Chr(34) + " ")
  ManualsHelp_L("parameter  is  interpreted  in the  same way  as for  the " + Chr(34) + "open" + Chr(34) + "  function. A ")
  ManualsHelp_L("sub-directory  will not be opened (because this is meaningless) so register B ")
  ManualsHelp_L("will be returned as 0FFh which can never be a valid file handle.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.49   CLOSE FILE HANDLE (45H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 45H (_CLOSE) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function  releases  the  specified file  handle for  re-use. If  the ")
  ManualsHelp_L("associated file  has been written to then its directory entry will be updated ")
  ManualsHelp_L("with  a new  date and  time, the  archive attributes bit will be set, and any ")
  ManualsHelp_L("buffered data  will be  flushed to  disk. Any  subsequent attempt to use this ")
  ManualsHelp_L("file  handle will return an error. If there are any other copies of this file ")
  ManualsHelp_L("handle, created by " + Chr(34) + "duplicate file handle" + Chr(34) + " or " + Chr(34) + "fork" + Chr(34) + ", then these other copies ")
  ManualsHelp_L("may still be used. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.50   ENSURE FILE HANDLE (46H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 46H (_ENSURE) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   If  the file  associated with the file handle has been written to then its ")
  ManualsHelp_L("directory  entry  will  be  updated with  a new  date and  time, the  archive ")
  ManualsHelp_L("attributes bit  will be  set, and  any buffered data will be flushed to disk. ")
  ManualsHelp_L("The file handle is not released and so it can still be used for accessing the ")
  ManualsHelp_L("file, and the current file pointer setting will not be altered.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.51   DUPLICATE FILE HANDLE (47H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 47H (_DUP) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = New file handle")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function creates  a copy  of the  specified file  handle. The lowest ")
  ManualsHelp_L("available  file  handle  number  will  always  be used  and a  " + Chr(34) + ".NHAND" + Chr(34) + " error ")
  ManualsHelp_L("returned if  there are  none available. The new file handle will refer to the ")
  ManualsHelp_L("same  file as the original and either one may be used. If the file pointer of ")
  ManualsHelp_L("one handle  is moved,  the other  one will also be moved. If either handle is ")
  ManualsHelp_L("closed the other one may still be used.")
  ManualsHelp_L("")
  ManualsHelp_L("   Note that  because duplicate file handles created by this function are not ")
  ManualsHelp_L(Chr(34) + "separately  opened" + Chr(34) + ", they  do not  count as  separate file  handles for  the ")
  ManualsHelp_L("purposes of  generating " + Chr(34) + ".FOPEN" + Chr(34) + " errors. So for example a " + Chr(34) + "DUP" + Chr(34) + "ed file handle ")
  ManualsHelp_L("may  be renamed  (function 53h) or have its attributes changed (function 55h) ")
  ManualsHelp_L("and the  effect will  apply to  both file handles. Note in particular that if ")
  ManualsHelp_L("one  copy of  a " + Chr(34) + "DUP" + Chr(34) + "ed  file handle  is deleted (function 54h) then the file ")
  ManualsHelp_L("really will be deleted and the other file handle, although still open, can no ")
  ManualsHelp_L("longer be  used safely.  If it  is used  (other than being closed, ensured or ")
  ManualsHelp_L("deleted) then an " + Chr(34) + ".FDEL" + Chr(34) + " error will be returned. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.52   READ FROM FILE HANDLE (48H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 48H (_READ) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                   DE = Buffer address")
  ManualsHelp_L("                   HL = Number of bytes to read  ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   HL = Number of bytes actually read")
  ManualsHelp_L("")
  ManualsHelp_L("   The  specified number  of bytes are read from the file at the current file ")
  ManualsHelp_L("pointer position  and copied  to the buffer address specified in register DE. ")
  ManualsHelp_L("The file pointer is then updated to the next sequential byte. A " + Chr(34) + ".ACCV" + Chr(34) + " error ")
  ManualsHelp_L("will  be returned if the file handle was opened with the " + Chr(34) + "no read" + Chr(34) + " access bit ")
  ManualsHelp_L("set.")
  ManualsHelp_L("")
  ManualsHelp_L("   The number of bytes read may be less than the number requested for various ")
  ManualsHelp_L("reasons, and  the number  read will be returned in register HL if there is no ")
  ManualsHelp_L("error.  In general  if less  is read  than requested  then this should not be ")
  ManualsHelp_L("treated as  an error  condition but  another read  should be done to read the ")
  ManualsHelp_L("next portion, until a " + Chr(34) + ".EOF" + Chr(34) + " error is returned. An " + Chr(34) + ".EOF" + Chr(34) + " error will never be ")
  ManualsHelp_L("returned  for a partial read, only for a read which reads zero bytes. Reading ")
  ManualsHelp_L("files in  this way  ensures that device file handles will work correctly (see ")
  ManualsHelp_L("below).")
  ManualsHelp_L("")
  ManualsHelp_L("   For disk  files the number of bytes read will only be less than the number ")
  ManualsHelp_L("requested  if the  end of  the file is reached and in this case the next read ")
  ManualsHelp_L("operation will  read zero bytes and will return an " + Chr(34) + ".EOF" + Chr(34) + " error. When reading ")
  ManualsHelp_L("from a device file handle (for example the standard file handles 0 to 4), the ")
  ManualsHelp_L("behaviour  depends on  the particular device, and on whether it is being read ")
  ManualsHelp_L("in ASCII  or binary  mode (see  function 4Bh below). The " + Chr(34) + "CON" + Chr(34) + " device will be ")
  ManualsHelp_L("described  as an  example because  it is  the most  commonly used device, but ")
  ManualsHelp_L("other devices behave similarly.")
  ManualsHelp_L("")
  ManualsHelp_L("   When reading from the " + Chr(34) + "CON" + Chr(34) + " device in binary mode, characters will be read ")
  ManualsHelp_L("from the keyboard, without any interpretation and without being echoed to the ")
  ManualsHelp_L("screen or  printer. The  exact number  of characters requested will always be ")
  ManualsHelp_L("read and there is no end of file condition. Because of the lack of any end of ")
  ManualsHelp_L("file indication, great care must be taken when reading from devices in binary ")
  ManualsHelp_L("mode.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  read function  call to the " + Chr(34) + "CON" + Chr(34) + " device in ASCII mode (the default mode ")
  ManualsHelp_L("and that  which normally  applies to  the standard  input channel), will only ")
  ManualsHelp_L("read  one line  of input.  The input line will be read from the keyboard with ")
  ManualsHelp_L("the normal  line editing  facilities available to the user, and the character ")
  ManualsHelp_L("typed  will be  echoed to the screen and to the printer if Ctrl-P is enabled. ")
  ManualsHelp_L("Special control  characters " + Chr(34) + "Ctrl-P" + Chr(34) + ", " + Chr(34) + "Ctrl-N" + Chr(34) + ", " + Chr(34) + "Ctrl-S" + Chr(34) + " and " + Chr(34) + "Ctrl-C" + Chr(34) + " will be ")
  ManualsHelp_L("tested  for and  will be  treated exactly  as for the console status function ")
  ManualsHelp_L("0Bh.")
  ManualsHelp_L("")
  ManualsHelp_L("   When  the user types a carriage return the line will be copied to the read ")
  ManualsHelp_L("buffer, terminated  with a  CR-LF sequence  and the read function will return ")
  ManualsHelp_L("with  an appropriate  byte count.  The next  read will start another buffered ")
  ManualsHelp_L("line input  operation. If  the number of bytes requested in the read was less ")
  ManualsHelp_L("than the length of the line input then as many character as requested will be ")
  ManualsHelp_L("returned,  and the  next read  function call will return immediately with the ")
  ManualsHelp_L("next portion of the line until it has all been read.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  user types a line which starts with a " + Chr(34) + "Ctrl-Z" + Chr(34) + " character then this ")
  ManualsHelp_L("will be interpreted as indicating end of file. The line will be discarded and ")
  ManualsHelp_L("the  read function  call will  read zero  bytes and return an " + Chr(34) + ".EOF" + Chr(34) + " error. A ")
  ManualsHelp_L("subsequent read after this will be back to normal and will start another line ")
  ManualsHelp_L("input. The end of file condition is thus not permanent.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.53   WRITE TO FILE HANDLE (49H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 49H (_WRITE) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                   DE = Buffer address")
  ManualsHelp_L("                   HL = Number of bytes to write")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   HL = Number of bytes actually written")
  ManualsHelp_L("")
  ManualsHelp_L("   This function is very similar to the " + Chr(34) + "read" + Chr(34) + " function above (function 48h). ")
  ManualsHelp_L("The number  of bytes  specified will  be written  to the current file pointer ")
  ManualsHelp_L("position  in the file, and the file pointer will be adjusted to point to just ")
  ManualsHelp_L("after the  last byte  written. If  the file  was opened  with the  " + Chr(34) + "no write" + Chr(34) + " ")
  ManualsHelp_L("access bit set then a " + Chr(34) + ".ACCV" + Chr(34) + " error will be returned, and if the file is read ")
  ManualsHelp_L("only then a " + Chr(34) + ".FILRO" + Chr(34) + " error will be returned.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  write goes  beyond the  current end  of file then the file will be ")
  ManualsHelp_L("extended  as necessary.  If the file pointer is already beyond the end of the ")
  ManualsHelp_L("file then  disk space  will be  allocated to  fill the  gap and  will not  be ")
  ManualsHelp_L("initialized.  If there  is insufficient disk space then a " + Chr(34) + ".DKFUL" + Chr(34) + " error will ")
  ManualsHelp_L("be returned  and no  data will be written, even if there was room for some of ")
  ManualsHelp_L("the data.")
  ManualsHelp_L("")
  ManualsHelp_L("   The number of bytes written can usually be ignored since it will either be ")
  ManualsHelp_L("zero  if an  error is returned or it will be equal to the number requested if ")
  ManualsHelp_L("the write  was successful. It is very much more efficient to write files in a ")
  ManualsHelp_L("few  large blocks  rather than many small ones, so programs should always try ")
  ManualsHelp_L("to write in as large blocks as possible.")
  ManualsHelp_L("")
  ManualsHelp_L("   This function sets a " + Chr(34) + "modified" + Chr(34) + " bit for the file handle which ensures that ")
  ManualsHelp_L("when the  file handle  is closed or ensured, either explicitly or implicitly, ")
  ManualsHelp_L("the  directory entry  will be  updated with the new date, time and allocation ")
  ManualsHelp_L("information. Also  the archive bit will be set to indicate that this file has ")
  ManualsHelp_L("been modified since it was last archived.")
  ManualsHelp_L("")
  ManualsHelp_L("   Writing  to device  file handles is not a complicated as reading from them ")
  ManualsHelp_L("because there  are no  end of  file conditions  or line input to worry about. ")
  ManualsHelp_L("There  are some differences between ASCII and binary mode when writing to the ")
  ManualsHelp_L(Chr(34) + "CON" + Chr(34) + " device, in that a console status check is done in ASCII mode only. Also ")
  ManualsHelp_L("printer echo if enabled will only be done in ASCII mode.")
  ManualsHelp_L("")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.54   MOVE FILE HANDLE POINTER (4AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4AH (_SEEK) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                    A = Method code")
  ManualsHelp_L("                DE:HL = Signed offset")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                DE:HL = New file pointer ")
  ManualsHelp_L("")
  ManualsHelp_L("   The file pointer associated with the specified file handle will be altered ")
  ManualsHelp_L("according to  the method  code and offset, and the new pointer value returned ")
  ManualsHelp_L("in DE:HL. The method code specifies where the signed offset is relative to as ")
  ManualsHelp_L("follows:")
  ManualsHelp_L("")
  ManualsHelp_L("     A=0  Relative to the beginning of the file")
  ManualsHelp_L("     A=1  Relative to the current position")
  ManualsHelp_L("     A=2  Relative to the end of the file.")
  ManualsHelp_L("")
  ManualsHelp_L("   Note  that an  offset of  zero with an method code of 1 will simply return ")
  ManualsHelp_L("the current  pointer value,  and with a method code of 2 will return the size ")
  ManualsHelp_L("of  the file.  No end  of file  check is  done so  it is  quite possible (and ")
  ManualsHelp_L("sometimes useful)  to set  the file  pointer beyond  the end  of the file. If ")
  ManualsHelp_L("there  are any  copies of  this file  handle created  by the  " + Chr(34) + "duplicate file ")
  ManualsHelp_L("handle" + Chr(34) + " function  (function 47h)  or the  " + Chr(34) + "fork" + Chr(34) + " function (function 60h) then ")
  ManualsHelp_L("their file pointer will also be changed. ")
  ManualsHelp_L("")
  ManualsHelp_L("   The file  pointer only  has any  real meaning  on disk  files since random ")
  ManualsHelp_L("access is possible. On device files the file pointer is updated appropriately ")
  ManualsHelp_L("when  any read  or write  is done,  and can  be examined  or altered  by this ")
  ManualsHelp_L("function.  However  changing will  have no  effect and  examining it  is very ")
  ManualsHelp_L("unlikely to be useful.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.55   I/O CONTROL FOR DEVICES (4BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4BH (_IOCTL) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                    A = Sub-function code")
  ManualsHelp_L("                        00H => get file handle status")
  ManualsHelp_L("                        01H => set ASCII/binary mode")
  ManualsHelp_L("                        02H => test input ready")
  ManualsHelp_L("                        03H => test output ready")
  ManualsHelp_L("                        04H => find screen size")
  ManualsHelp_L("                   DE = Other parameters")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Other results")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  allows various  aspects of  file handles to be examined and ")
  ManualsHelp_L("altered.  In particular  it can  be used  to determine  whether a file handle ")
  ManualsHelp_L("refers to  a disk file or a device. This is useful for programs which want to ")
  ManualsHelp_L("behave differently for disk files and device I/O.")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  is passed  the file handle in register B and a sub-function ")
  ManualsHelp_L("code  in register  A which specifies one of various different operations. Any ")
  ManualsHelp_L("other  parameters  required  by  the  particular  sub-function are  passed in ")
  ManualsHelp_L("register DE and results are returned in register DE. If the sub-function code ")
  ManualsHelp_L("is invalid then a " + Chr(34) + ".ISBFN" + Chr(34) + " error will be returned.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=0 then the operation is " + Chr(34) + "get file handle status" + Chr(34) + ". This returns a word ")
  ManualsHelp_L("of flags  which give various information about the file handle. The format of ")
  ManualsHelp_L("this  word is  different for  device file  handles and disk file handles, and ")
  ManualsHelp_L("bit-7 specifies which it is. The format of the word is as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("For devices:    DE -     b0  set  => console input device")
  ManualsHelp_L("                         b1  set  => console output device")
  ManualsHelp_L("                     b2..b4  reserved")
  ManualsHelp_L("                         b5  set  => ASCII mode")
  ManualsHelp_L("                             clear=> binary mode")
  ManualsHelp_L("                         b6  set  => end of file")
  ManualsHelp_L("                         b7  always set (=> device)")
  ManualsHelp_L("                    b8..b15  reserved ")
  ManualsHelp_L("")
  ManualsHelp_L("For disk files: DE - b0..b5  drive number (0=A: etc)")
  ManualsHelp_L("                         b6  set  => end of file")
  ManualsHelp_L("                         b7  always clear (=> disk file)")
  ManualsHelp_L("                    b8..b15  reserved ")
  ManualsHelp_L("")
  ManualsHelp_L("   Note  that the end of file flag is the same for devices as for disk files. ")
  ManualsHelp_L("For devices  it will  be set  if the previous attempt to read from the device ")
  ManualsHelp_L("produced  a " + Chr(34) + ".EOF" + Chr(34) + " error and will be cleared by the next read. For disk files ")
  ManualsHelp_L("it is worked out by comparing the file pointer with the file size.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  A=1 then the operation is a " + Chr(34) + "set ASCII/binary mode" + Chr(34) + ". This operation is ")
  ManualsHelp_L("only allowed  for device file handles. An ASCII/binary flag must be passed in ")
  ManualsHelp_L("bit-5  of  register  E  (exactly  where it  is returned  by " + Chr(34) + "get  file handle ")
  ManualsHelp_L("status" + Chr(34) + ").  This is  set for  ASCII mode  and clear for binary mode. All other ")
  ManualsHelp_L("bits of register DE are ignored.")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=2  or 3  then the  operation is  " + Chr(34) + "test input  ready" + Chr(34) + " or  " + Chr(34) + "test output ")
  ManualsHelp_L("ready" + Chr(34) + "  respectively. In both cases a flag is returned in register E which is ")
  ManualsHelp_L("FFh if  the file  handle is  ready for  a character and 00h if not. The exact ")
  ManualsHelp_L("meaning  of " + Chr(34) + "ready  for a character" + Chr(34) + " depends on the device. Disk file handles ")
  ManualsHelp_L("are always  ready for  output, and are always ready for input unless the file ")
  ManualsHelp_L("pointer is at the end of file. The " + Chr(34) + "CON" + Chr(34) + " device checks the keyboard status to ")
  ManualsHelp_L("determine whether it is ready for input or not.")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=4  the the  operation is  " + Chr(34) + "get screen size" + Chr(34) + ". This returns the logical ")
  ManualsHelp_L("screen size for the file handle with the number of rows in register D and the ")
  ManualsHelp_L("number  of columns  in register  E. For  devices with no screen size (such as ")
  ManualsHelp_L("disk  files)  both  D  and  E  will be  zero. Zero  for either  result should ")
  ManualsHelp_L("therefore be interpreted as " + Chr(34) + "unlimited" + Chr(34) + ". For example this function is used by ")
  ManualsHelp_L("the " + Chr(34) + "DIR  /W" + Chr(34) + " command to decide how many files to print per line, and a value ")
  ManualsHelp_L("of zero for register E is defaulted to 80.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.56   TEST FILE HANDLE (4CH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4CH (_HTEST)")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                 or fileinfo block pointer")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = 00H => not the same file")
  ManualsHelp_L("                        FFH => same file")
  ManualsHelp_L("")
  ManualsHelp_L("   This  rather  specialist function  is passed  a file  handle and  either a ")
  ManualsHelp_L("drive/path/file  string  or  a  fileinfo block  which identifies  a file.  It ")
  ManualsHelp_L("determines if  the two  files are  actually the  same file and returns a flag ")
  ManualsHelp_L("indicating  the result.  Note that  if the file handle is for a device rather ")
  ManualsHelp_L("than a disk file then it will always return " + Chr(34) + "B=00h" + Chr(34) + " to indicate " + Chr(34) + "not the same ")
  ManualsHelp_L("file" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("   This function allows the " + Chr(34) + "COPY" + Chr(34) + " command to detect certain error conditions ")
  ManualsHelp_L("such as  copying file  onto themselves  and give  the user  informative error ")
  ManualsHelp_L("messages.  It may  also be useful for other programs which need to do similar ")
  ManualsHelp_L("tests.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.57   DELETE FILE OR SUBDIRECTORY (4DH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4DH (_DELETE) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  deletes the object (file or sub-directory) specified by the ")
  ManualsHelp_L("drive/path/file  string or the fileinfo block. Global filename characters are ")
  ManualsHelp_L("not  allowed  so only  one file  or sub-directory  can be  deleted with  this ")
  ManualsHelp_L("function. A  sub-directory can  only be  deleted if  it is  empty or an error ")
  ManualsHelp_L("(" + Chr(34) + ".DIRNE" + Chr(34) + ") occurs if not). The " + Chr(34) + "." + Chr(34) + " and " + Chr(34) + ".." + Chr(34) + " entries in a sub-directory cannot ")
  ManualsHelp_L("be  deleted (" + Chr(34) + ".DOT" + Chr(34) + "  error) and neither can the root directory. A file cannot ")
  ManualsHelp_L("be deleted  if there  is a  file handle open to it (.FOPEN error) or if it is ")
  ManualsHelp_L("read only (.FILRO error).")
  ManualsHelp_L("")
  ManualsHelp_L("   If  it is  a file  then any  disk space  which was allocated to it will be ")
  ManualsHelp_L("freed. If  the disk  is an MSX-DOS 2 disk then enough information is retained ")
  ManualsHelp_L("on  the disk  to allow the " + Chr(34) + "UNDEL" + Chr(34) + " utility program do undelete the file. This ")
  ManualsHelp_L("information is only retain ed until the next disk space allocation (usually a ")
  ManualsHelp_L("write to  a file) is done on this disk. After making this function call, if a ")
  ManualsHelp_L("fileinfo  block was passed then it must not be used again (other than passing ")
  ManualsHelp_L("it to  a " + Chr(34) + "find  next entry" + Chr(34) + "  function) since  the file  to which it refers no ")
  ManualsHelp_L("longer exists.")
  ManualsHelp_L("")
  ManualsHelp_L("   If a device name such as " + Chr(34) + "CON" + Chr(34) + " is specified then no error will be returned ")
  ManualsHelp_L("but the device will not actually be deleted.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.58   RENAME FILE OR SUBDIRECTORY (4EH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4EH (_RENAME) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                   HL = New filename ASCIIZ string ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  renames the object (file or sub-directory) specified by the ")
  ManualsHelp_L("drive/path/file string or the fileinfo block, with the new name in the string ")
  ManualsHelp_L("pointed  to by HL. The new filename string must not contain a drive letter or ")
  ManualsHelp_L("directory path  (" + Chr(34) + ".IFNM" + Chr(34) + " error if it does). If a device name such as " + Chr(34) + "CON" + Chr(34) + " is ")
  ManualsHelp_L("specified  then no error will be returned but the device will not actually be ")
  ManualsHelp_L("renamed.")
  ManualsHelp_L("")
  ManualsHelp_L("   Global filename  characters are not allowed in the drive/path/file string, ")
  ManualsHelp_L("so  only one  object can be renamed by this function. However global filename ")
  ManualsHelp_L("characters are  allowed in the new filename passed in HL and where they occur ")
  ManualsHelp_L("the  existing filename  character will  be left unaltered. Checks are done to ")
  ManualsHelp_L("avoid creating an illegal filename, for example a file called " + Chr(34) + "XYZ" + Chr(34) + " cannot be ")
  ManualsHelp_L("renamed with  a new filename string of " + Chr(34) + "????A" + Chr(34) + " because the new filename would ")
  ManualsHelp_L("be " + Chr(34) + "XYZ A" + Chr(34) + " which is illegal. In this case a " + Chr(34) + ".IFNM" + Chr(34) + " error will be returned.")
  ManualsHelp_L("")
  ManualsHelp_L("   If there is already an entry with the new filename then an error (" + Chr(34) + ".DUPF" + Chr(34) + ") ")
  ManualsHelp_L("is returned  to avoid  creating duplicate filenames. The " + Chr(34) + "." + Chr(34) + " and " + Chr(34) + ".." + Chr(34) + " entries ")
  ManualsHelp_L("in a sub-directory cannot be renamed (" + Chr(34) + ".IDOT" + Chr(34) + " error) and neither can the root ")
  ManualsHelp_L("directory (it has noname). A file cannot be renamed if there is a file handle ")
  ManualsHelp_L("open to it (" + Chr(34) + ".FOPEN" + Chr(34) + " error) although a read only file can be renamed.")
  ManualsHelp_L("")
  ManualsHelp_L("   Note that  if DE pointed to a fileinfo block, this is not updated with the ")
  ManualsHelp_L("new  name of  the file.  Therefore care  must be  taken in using the fileinfo ")
  ManualsHelp_L("block after making this function call.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.59   MOVE FILE OR SUBDIRECTORY (4FH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 4FH (_MOVE) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                   HL = New path ASCIIZ string ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function moves  the object  (file or sub-directory) specified by the ")
  ManualsHelp_L("drive/path/file string  or the  fileinfo block, to the directory specified by ")
  ManualsHelp_L("the  new path  string pointed to by HL. There must not be a drive name in the ")
  ManualsHelp_L("new path  string. If  a device  name such as " + Chr(34) + "CON" + Chr(34) + " is specified then no error ")
  ManualsHelp_L("will be returned but the device will not actually be moved.")
  ManualsHelp_L("")
  ManualsHelp_L("   Global filename  characters are  not allowed in any of the strings so only ")
  ManualsHelp_L("one object (file or sub-directory) can be moved by this function, although if ")
  ManualsHelp_L("a sub-directory is moved, all its descendants will be moved with it. If there ")
  ManualsHelp_L("is  already an  entry of  the required  name in  the target  directory then a ")
  ManualsHelp_L(Chr(34) + ".DUPF" + Chr(34) + " error  is returned  to prevent  creating duplicate filenames. The " + Chr(34) + "." + Chr(34) + " ")
  ManualsHelp_L("and " + Chr(34) + ".." + Chr(34) + " entries in a sub-directory cannot be moved (" + Chr(34) + ".DOT" + Chr(34) + " error) and also a ")
  ManualsHelp_L("directory  cannot be  moved into  one of  its own descendants (" + Chr(34) + ".DIRE" + Chr(34) + " error) ")
  ManualsHelp_L("since this  would create an isolated loop in the filing system. A file cannot ")
  ManualsHelp_L("be moved if there is a file handle open to it (" + Chr(34) + ".FOPEN" + Chr(34) + " error).")
  ManualsHelp_L("")
  ManualsHelp_L("   Note  that if  a fileinfo  block is  passed to this function, the internal ")
  ManualsHelp_L("information in  the fileinfo block is not updated to reflect the new location ")
  ManualsHelp_L("of the file. This is necessary because otherwise the fileinfo block could not ")
  ManualsHelp_L("be used for a subsequent " + Chr(34) + "find next" + Chr(34) + " function call. However it does mean that ")
  ManualsHelp_L("the fileinfo block no longer refers to the moved file and so must not be used ")
  ManualsHelp_L("for any operations on it such as " + Chr(34) + "rename" + Chr(34) + " or " + Chr(34) + "open" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("  3.60   GET/SET FILE ATTRIBUTES (50H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 50H (_ATTR) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                    A = 0 => get attributes")
  ManualsHelp_L("                        1 => set attributes")
  ManualsHelp_L("                    L = New attributes byte (only if A=1)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    L = Current attributes byte")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  is normally  used to  change the  attributes of  a file  or ")
  ManualsHelp_L("sub-directory.  It can  also be  used to  find out the current attributes but ")
  ManualsHelp_L("this is  more usually  done with  the " + Chr(34) + "find  first entry" + Chr(34) + "  function (function ")
  ManualsHelp_L("40h).  If A=0  then the current attributes byte for the file or sub-directory ")
  ManualsHelp_L("will just be returned in register L.")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=1  then the attributes byte will be set to the new value specified in ")
  ManualsHelp_L("register  L, and this new value will also be returned in register L. Only the ")
  ManualsHelp_L("system, hidden,  read only  and archive  bits may  be altered for a file, and ")
  ManualsHelp_L("only  the hidden  bit for a sub-directory. An " + Chr(34) + ".IATTR" + Chr(34) + " error will be returned ")
  ManualsHelp_L("if an  attempt is made to alter any other attribute bits. If a fileinfo block ")
  ManualsHelp_L("is  passed then  the attributes  byte in  it will not be updated with the new ")
  ManualsHelp_L("setting.")
  ManualsHelp_L("")
  ManualsHelp_L("   Global filename  characters are  not allowed  so only  one object (file or ")
  ManualsHelp_L("sub-directory)  can have  its attributes set by this function. The attributes ")
  ManualsHelp_L("of the  root directory  cannot be  changed because  it does not have any. The ")
  ManualsHelp_L("attributes  of a  file cannot be changed if there is a file handle open to it ")
  ManualsHelp_L("(" + Chr(34) + ".FOPEN" + Chr(34) + "  error).  The  attributes  of the  " + Chr(34) + "." + Chr(34) + " and  " + Chr(34) + ".." + Chr(34) + " directory  entries ")
  ManualsHelp_L("however can  be changed.  If a device name such as " + Chr(34) + "CON" + Chr(34) + " is specified then no ")
  ManualsHelp_L("error  will be  returned but  the device's  attributes will  not actually  be ")
  ManualsHelp_L("changed (since it does not have any).")
  ManualsHelp_L("")
  ManualsHelp_L("  3.61   GET/SET FILE DATE AND TIME (51H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 51H (_FTIME) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("                                or fileinfo block pointer")
  ManualsHelp_L("                    A = 0 => get date and time")
  ManualsHelp_L("                        1 => set date and time ")
  ManualsHelp_L("                   IX = New time value (only if A=1)")
  ManualsHelp_L("                   HL = New date value (only if A=1)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Current file time value")
  ManualsHelp_L("                   HL = Current file date value ")
  ManualsHelp_L("")
  ManualsHelp_L("   If  A=1 then  this function sets the date and time of last modification of ")
  ManualsHelp_L("the file or sub-directory specified by the drive/path/file string or fileinfo ")
  ManualsHelp_L("block. Global  filename characters  are not allowed in any part of the string ")
  ManualsHelp_L("so  only one  file can have its date and time modified by this function. If a ")
  ManualsHelp_L("device name such as " + Chr(34) + "CON" + Chr(34) + " is specified then no error will be returned but the ")
  ManualsHelp_L("device's date and time will not actually be changed.")
  ManualsHelp_L("")
  ManualsHelp_L("   The date  and time  format are exactly as contained in the directory entry ")
  ManualsHelp_L("and  fileinfo blocks  (see the  " + Chr(34) + "Program Interface Specification" + Chr(34) + "). No checks ")
  ManualsHelp_L("are done for sensible dates or times, the values are simply stored. Note that ")
  ManualsHelp_L("if a fileinfo block is passed then the date and time stored in it will not be ")
  ManualsHelp_L("updated by this function.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  A=0 then  the current values are just returned. Note that although the ")
  ManualsHelp_L("time value is passed in IX, it is returned in DE. The date and time of a file ")
  ManualsHelp_L("cannot be altered (although it can be read) if there is a file handle open to ")
  ManualsHelp_L("the file (" + Chr(34) + ".FOPEN" + Chr(34) + " error).")
  ManualsHelp_L("")
  ManualsHelp_L("  3.62   DELETE FILE HANDLE (52H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 52H (_HDELETE) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  deletes the  file handle associated with the specified file ")
  ManualsHelp_L("and  closes the file handle. A file handle cannot be deleted if there are any ")
  ManualsHelp_L("other separately  opened file handles open to the same file (" + Chr(34) + ".FOPEN" + Chr(34) + " error). ")
  ManualsHelp_L("If  there are any duplicates of the file handle (created by a " + Chr(34) + "duplicate file ")
  ManualsHelp_L("handle" + Chr(34) + " or  " + Chr(34) + "fork" + Chr(34) + " function), then these duplicates will be marked as invalid ")
  ManualsHelp_L("and any attempt to use them will produce an " + Chr(34) + ".HDEAD" + Chr(34) + " error.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  error conditions  for this  function are  the same as for the " + Chr(34) + "delete ")
  ManualsHelp_L("file or  sub-directory" + Chr(34) + " function  (function 4Dh). The file handle will always ")
  ManualsHelp_L("be closed, even if there is an error condition such as " + Chr(34) + ".FILRO" + Chr(34) + " or " + Chr(34) + ".FOPEN" + Chr(34) + ".")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.63   RENAME FILE HANDLE (53H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 53H (_HRENAME) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                   HL = New filename ASCIIZ string ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function renames  the file associated with the specified file handle ")
  ManualsHelp_L("with the  new name  in the  string pointed to by HL. Apart from the fact that ")
  ManualsHelp_L("the  file is  specified by  a file  handle rather  than an ASCIIZ string or a ")
  ManualsHelp_L("fileinfo  block,   this  function   is  identical  to  the  " + Chr(34) + "rename  file  or ")
  ManualsHelp_L("subdirectory" + Chr(34) + " function (function 4Eh), and has the same error conditions.")
  ManualsHelp_L("")
  ManualsHelp_L("   A file  handle cannot  be renamed if there are any other separately opened ")
  ManualsHelp_L("file  handles for  this file  (" + Chr(34) + ".FOPEN" + Chr(34) + " error), although it can be renamed if ")
  ManualsHelp_L("there are  copies of  this file  handle, and  in this case the copies will be ")
  ManualsHelp_L("renamed.  Renaming a  file handle will not alter the file pointer but it will ")
  ManualsHelp_L("do an implicit " + Chr(34) + "ensure" + Chr(34) + " operation.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.64   MOVE FILE HANDLE (54H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 54H (_HMOVE) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                   HL = New path ASCIIZ string ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  moves the file associated with the specified file handle to ")
  ManualsHelp_L("the  directory specified  by the new path string pointed to by HL. Apart from ")
  ManualsHelp_L("the fact  that the  file is  specified by a file handle rather than an ASCIIZ ")
  ManualsHelp_L("string  or a  fileinfo block, this function is identical to the " + Chr(34) + "move file or ")
  ManualsHelp_L("subdirectory" + Chr(34) + " function (function 4Fh), and has the same error conditions.")
  ManualsHelp_L("")
  ManualsHelp_L("   A file  handle cannot  be moved  if there  are any other separately opened ")
  ManualsHelp_L("file  handles for  this file  (" + Chr(34) + ".FOPEN" + Chr(34) + " error),  although it  can be moved if ")
  ManualsHelp_L("there are  copies of  this file handle, and in this case the copies will also ")
  ManualsHelp_L("be moved. Moving a file handle will not alter the file pointer but it will do ")
  ManualsHelp_L("an implicit " + Chr(34) + "ensure" + Chr(34) + " operation.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.65   GET/SET FILE HANDLE ATTRIBUTES (55H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 55H (_HATTR) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                    A = 0 => get attributes")
  ManualsHelp_L("                        1 => set attributes")
  ManualsHelp_L("                    L = New attributes byte (only if A=1)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    L = Current attributes byte")
  ManualsHelp_L("")
  ManualsHelp_L("   This function gets or sets the attributes byte of the file associated with ")
  ManualsHelp_L("the specified  file handle. Apart from the fact that the file is specified by ")
  ManualsHelp_L("a file handle rather than an ASCIIZ string or a fileinfo block, this function ")
  ManualsHelp_L("is  identical to  the " + Chr(34) + "get/set  file attributes" + Chr(34) + " function (function 50h), and ")
  ManualsHelp_L("has the same error conditions.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  file handle  cannot have  its attributes  changed (although they can be ")
  ManualsHelp_L("read) if  there are  any other  separately opened  file handles for this file ")
  ManualsHelp_L("(" + Chr(34) + ".FOPEN" + Chr(34) + "  error).  The  file pointer  will not  be altered  but an  implicit ")
  ManualsHelp_L(Chr(34) + "ensure" + Chr(34) + " operation will be done.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.66   GET/SET FILE HANDLE DATE AND TIME (56H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 56H (_HFTIME) ")
  ManualsHelp_L("                    B = File handle")
  ManualsHelp_L("                    A = 0 => get date and time")
  ManualsHelp_L("                        1 => set date and time ")
  ManualsHelp_L("                   IX = New time value (only if A=1)")
  ManualsHelp_L("                   HL = New date value (only if A=1)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Current file time value")
  ManualsHelp_L("                   HL = Current file date value ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function gets  or sets the date and time of the file associated with ")
  ManualsHelp_L("the specified  file handle. Apart from the fact that the file is specified by ")
  ManualsHelp_L("a file handle rather than an ASCIIZ string or a fileinfo block, this function ")
  ManualsHelp_L("is identical to the " + Chr(34) + "get/set file date and time" + Chr(34) + " function (function 51h), and ")
  ManualsHelp_L("has the same error conditions.")
  ManualsHelp_L("")
  ManualsHelp_L("   A  file handle cannot have its date and time changed (although they can be ")
  ManualsHelp_L("read) if  there are  any other  separately opened  file handles for this file ")
  ManualsHelp_L("(" + Chr(34) + ".FOPEN" + Chr(34) + "  error).  The  file pointer  will not  be altered  but an  implicit ")
  ManualsHelp_L(Chr(34) + "ensure" + Chr(34) + " operation will be done.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.67   GET DISK TRANSFER ADDRESS (57H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 57H (_GETDTA) ")
  ManualsHelp_L("     Results:      DE = Current disk transfer address")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function returns  the current disk transfer address. This address is ")
  ManualsHelp_L("only used  for the  " + Chr(34) + "traditional" + Chr(34) + " CP/M  style FCB  functions and the absolute ")
  ManualsHelp_L("sector read and write functions.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.68   GET VERIFY FLAG SETTING (58H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 58H (_GETVFY) ")
  ManualsHelp_L("     Results:       B = 00H => verify disabled")
  ManualsHelp_L("                        FFH => verify enabled")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function simply  returns the  current state of the verify flag which ")
  ManualsHelp_L("can be set with MSX-DOS function 2Eh.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.69   GET CURRENT DIRECTORY (59H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 59H (_GETCD) ")
  ManualsHelp_L("                    B = Drive number (0=current, 1=A: etc)")
  ManualsHelp_L("                   DE = Pointer to 64 byte buffer ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Filled in with current path")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function  simply  gets  an  ASCIIZ  string representing  the current ")
  ManualsHelp_L("directory of the specified drive into the buffer pointed to by DE. The string ")
  ManualsHelp_L("will not  include a drive name or a leading or trailing " + Chr(34) + "\" + Chr(34) + " character, so the ")
  ManualsHelp_L("root directory is represented by a null string. The drive will be accessed to ")
  ManualsHelp_L("make sure that the current directory actually exists on the current disk, and ")
  ManualsHelp_L("if  not then  the current  directory will  be set back to the root and a null ")
  ManualsHelp_L("string returned.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.70   CHANGE CURRENT DIRECTORY (5AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5AH (_CHDIR) ")
  ManualsHelp_L("                   DE = Drive/path/file ASCIIZ string")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   The drive/path/file  string must  specify a  directory rather than a file. ")
  ManualsHelp_L("The  current directory  of the drive will be changed to be this directory. If ")
  ManualsHelp_L("the  specified  directory does  not exist  then the  current setting  will be ")
  ManualsHelp_L("unaltered and a " + Chr(34) + ".NODIR" + Chr(34) + " error returned.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.71   PARSE PATHNAME (5BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5BH (_PARSE) ")
  ManualsHelp_L("                    B = Volume name flag (bit 4)")
  ManualsHelp_L("                        DE = ASCIIZ string for parsing")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Pointer to termination character")
  ManualsHelp_L("                   HL = Pointer to start of last item")
  ManualsHelp_L("                    B = Parse flags")
  ManualsHelp_L("                    C = Logical drive number (1=A: etc)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function is purely a string manipulation function, it will not access ")
  ManualsHelp_L("the disks  at all  and it  will not  modify the  user's string  at all. It is ")
  ManualsHelp_L("intended to help transient programs in parsing command lines.")
  ManualsHelp_L("")
  ManualsHelp_L("   The volume  name flag (bit 4 of register B; it is in the same bit position ")
  ManualsHelp_L("as  the volume  name bit in an attributes byte) determines whether the string ")
  ManualsHelp_L("will be  parsed as  a " + Chr(34) + "drive/path/file" + Chr(34) + "  string (if  the bit is cleared) or a ")
  ManualsHelp_L(Chr(34) + "drive/volume" + Chr(34) + " string (if the bit is set).")
  ManualsHelp_L("")
  ManualsHelp_L("   The pointer  returned in DE will point to the first character which is not ")
  ManualsHelp_L("valid in a pathname string, and may be the null at the end of the string. See ")
  ManualsHelp_L("the " + Chr(34) + "Command Specification" + Chr(34) + " for details of the syntax of pathname strings and ")
  ManualsHelp_L("also for a list of valid characters.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  pointer returned  in HL will point to the first character of the last ")
  ManualsHelp_L("item of  a string  (filename portion). For example, when a string " + Chr(34) + "A:\XYZ\P.Q ")
  ManualsHelp_L("/F" + Chr(34) + " was passed, DE will point to the white space character before " + Chr(34) + "/F" + Chr(34) + " and HL ")
  ManualsHelp_L("will  point to " + Chr(34) + "P" + Chr(34) + ". If the parsed string ends with a character " + Chr(34) + "\" + Chr(34) + " or is null ")
  ManualsHelp_L("(apart from  drive name),  then there  will be no " + Chr(34) + "last item" + Chr(34) + ", thus HL and DE ")
  ManualsHelp_L("will  point to the same character. In this case, some special procedures will ")
  ManualsHelp_L("be needed to all the programs which use this function.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  drive number returned in register C is the logical drive specified in ")
  ManualsHelp_L("the string.  If the  string did not start with a drive letter then register C ")
  ManualsHelp_L("will  contain the  default drive  number, since  the default  drive has  been ")
  ManualsHelp_L("implicitly specified. Register C will never be zero.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  parse flags  returned in  register B  indicate various  useful things ")
  ManualsHelp_L("about the  string. For  a volume  name bits  1, 4,  5, 6 and 7 will always be ")
  ManualsHelp_L("clear. For a filename, bits 3 to 7 relate to the last item on the string (the ")
  ManualsHelp_L(Chr(34) + "filename" + Chr(34) + " component). The bit assignments are as follows: ")
  ManualsHelp_L("")
  ManualsHelp_L("b0 - set if any characters parsed other than drive name")
  ManualsHelp_L("b1 - set if any directory path specified")
  ManualsHelp_L("b2 - set if drive name specified")
  ManualsHelp_L("b3 - set if main filename specified in last item")
  ManualsHelp_L("b4 - set if filename extension specified in last item")
  ManualsHelp_L("b5 - set if last item is ambiguous")
  ManualsHelp_L("b6 - set if last item is " + Chr(34) + "." + Chr(34) + " or " + Chr(34) + ".." + Chr(34))
  ManualsHelp_L("b7 - set if last item is " + Chr(34) + ".." + Chr(34))
  ManualsHelp_L("")
  ManualsHelp_L("  3.72   PARSE FILENAME (5CH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5CH (_PFILE) ")
  ManualsHelp_L("                   DE = ASCIIZ string for parsing")
  ManualsHelp_L("                   HL = Pointer to 11 byte buffer")
  ManualsHelp_L("     Results:       A = Error (always zero)")
  ManualsHelp_L("                   DE = Pointer to termination character")
  ManualsHelp_L("                   HL = Preserved, buffer filled in")
  ManualsHelp_L("                    B = Parse flags")
  ManualsHelp_L("")
  ManualsHelp_L("   This function is purely a string manipulation function, it will not access ")
  ManualsHelp_L("disks at  all and will not modify the string at all. It is intended mainly to ")
  ManualsHelp_L("help  transient programs  in printing  out filenames  in a formatted way. The ")
  ManualsHelp_L("ASCIIZ string will be parsed as a single filename item, and the filename will ")
  ManualsHelp_L("be  stored  in the  user's 11  byte buffer  in expanded  form, with  both the ")
  ManualsHelp_L("filename and the extension padded out with spaces.")
  ManualsHelp_L("")
  ManualsHelp_L("   The parse  flags returned  in register  B are  identical to  those for the ")
  ManualsHelp_L(Chr(34) + "parse  pathname" + Chr(34) + " function  above (function 5Bh), except that bits 0, 1 and 2 ")
  ManualsHelp_L("will always  be clear.  The user's  buffer will  always be filled in, even if ")
  ManualsHelp_L("there  is no  valid filename  in the string, in which case the buffer will be ")
  ManualsHelp_L("filled with spaces. " + Chr(34) + "*" + Chr(34) + " characters will be expanded to the appropriate number ")
  ManualsHelp_L("of " + Chr(34) + "?" + Chr(34) + "s.  If either  the filename  or the filename extension is too long then ")
  ManualsHelp_L("the excess characters will be ignored.")
  ManualsHelp_L("")
  ManualsHelp_L("   The pointer  returned in  register DE will point to the first character in ")
  ManualsHelp_L("the  string which  was not part of the filename, which may be the null at the ")
  ManualsHelp_L("end of  the string.  This character  will never be a valid filename character ")
  ManualsHelp_L("(see the " + Chr(34) + "Command Specification" + Chr(34) + " for details of valid filename characters).")
  ManualsHelp_L("")
  ManualsHelp_L("  3.73   CHECK CHARACTER (5DH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5DH (_CHKCHR) ")
  ManualsHelp_L("                    D = Character flags")
  ManualsHelp_L("                    E = Character to be checked")
  ManualsHelp_L("     Results:       A = 0 (never returns an error)")
  ManualsHelp_L("                    D = Updated character flags")
  ManualsHelp_L("                    E = Checked (upper cased) character")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function allow  language independent  upper casing of characters and ")
  ManualsHelp_L("also helps with handling 16-bit characters and manipulation of filenames. The ")
  ManualsHelp_L("bit assignments in the character flags are as follows:")
  ManualsHelp_L("")
  ManualsHelp_L("   b0   - set to suppress upper casing")
  ManualsHelp_L("   b1   - set if first byte of 16-bit character")
  ManualsHelp_L("   b2   - set if second byte of 16-bit character")
  ManualsHelp_L("   b3   - set => volume name (rather than filename)")
  ManualsHelp_L("   b4   - set => not a valid file/volume name character")
  ManualsHelp_L("b5...b7 - reserved (always clear)")
  ManualsHelp_L("")
  ManualsHelp_L("   Bit 0  is used  to control upper casing. If it is clear then the character ")
  ManualsHelp_L("will be upper cased according to the language setting of the machine. If this ")
  ManualsHelp_L("bit  is  set  then the  returned character  will always  be the  same as  the ")
  ManualsHelp_L("character passed.")
  ManualsHelp_L("")
  ManualsHelp_L("   The two  16-bit character  flags (bits 1 and 2) can both be clear when the ")
  ManualsHelp_L("first  character of  a string  is checked  and the  settings returned  can be ")
  ManualsHelp_L("passed straight  back to  this function  for each  subsequent character. Care ")
  ManualsHelp_L("must  be taken  with these  flags when moving backwards through strings which ")
  ManualsHelp_L("may contain 16-bit characters.")
  ManualsHelp_L("")
  ManualsHelp_L("   Bit  4 is  set on return if the character is one of the set of filename or ")
  ManualsHelp_L("volume name  terminator characters. Bit 3 is simply used to determine whether ")
  ManualsHelp_L("to  test for filename or volume name characters since the sets are different. ")
  ManualsHelp_L("16-bit characters  (either byte)  are never  considered as volume or filename ")
  ManualsHelp_L("terminators.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.74   GET WHOLE PATH STRING (5EH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5EH (_WPATH) ")
  ManualsHelp_L("                        DE = Pointer to 64 byte buffer ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Filled in with whole path string")
  ManualsHelp_L("                   HL = Pointer to start of last item ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function simply copies an ASCIIZ path string from an internal buffer ")
  ManualsHelp_L("into the  user's buffer.  The string  represents the whole path and filename, ")
  ManualsHelp_L("from  the root  directory, of  a file  or sub-directory located by a previous ")
  ManualsHelp_L(Chr(34) + "find first entry" + Chr(34) + " or " + Chr(34) + "find new entry" + Chr(34) + " function. The returned string will not ")
  ManualsHelp_L("include a  drive, or  an initial " + Chr(34) + "\" + Chr(34) + " character. Register HL will point at the ")
  ManualsHelp_L("first  character of  the last  item on  the string, exactly as for the " + Chr(34) + "parse ")
  ManualsHelp_L("path" + Chr(34) + " function (function 5Bh).")
  ManualsHelp_L("")
  ManualsHelp_L("   If a  " + Chr(34) + "find first entry" + Chr(34) + " or " + Chr(34) + "find new entry" + Chr(34) + " function call is done with DE ")
  ManualsHelp_L("pointing to an ASCIIZ string then a subsequent " + Chr(34) + "get whole path" + Chr(34) + " function call ")
  ManualsHelp_L("will  return a string representing the sub-directory or file corresponding to ")
  ManualsHelp_L("the  fileinfo   block  returned   by  the  " + Chr(34) + "find" + Chr(34) + "  function.  If  this  is  a ")
  ManualsHelp_L("sub-directory  then the  fileinfo block  may be passed back in register DE to ")
  ManualsHelp_L("another " + Chr(34) + "find  first entry" + Chr(34) + "  function call,  which will  locate a file within ")
  ManualsHelp_L("this  sub-directory. In  this case  the newly located file will be added onto ")
  ManualsHelp_L("the already  existing whole  path string internally, and so a subsequent " + Chr(34) + "get ")
  ManualsHelp_L("whole  path string" + Chr(34) + " function call will return a correct whole path string for ")
  ManualsHelp_L("the located file.")
  ManualsHelp_L("")
  ManualsHelp_L("   Great care must be taken in using this function because the internal whole ")
  ManualsHelp_L("path  string is modified by many of the function calls, and in many cases can ")
  ManualsHelp_L("be invalid.  The " + Chr(34) + "get  whole path" + Chr(34) + "  function call  should be done immediately ")
  ManualsHelp_L("after  the  " + Chr(34) + "find  first  entry" + Chr(34) + "  or " + Chr(34) + "find  new entry" + Chr(34) + "  function to  which it ")
  ManualsHelp_L("relates.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.75   FLUSH DISK BUFFERS (5FH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 5FH (_FLUSH) ")
  ManualsHelp_L("                    B = Drive number (0=current, FFH=all)")
  ManualsHelp_L("                    D = 00H => Flush only")
  ManualsHelp_L("                      = FFH => Flush and invalidate ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function flushes  any dirty disk buffers for the specified drive, or ")
  ManualsHelp_L("for all drives if B=FFh. If register D is FFh then all buffers for that drive ")
  ManualsHelp_L("will also be invalidated. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.76   FORK TO CHILD PROCESS (60H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 60H (_FORK) ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Process id of parent process")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  informs the  system that  a child  process is  about to  be ")
  ManualsHelp_L("started.  Typically this  is a new program or sub-command being executed. For ")
  ManualsHelp_L("example COMMAND2.COM does a " + Chr(34) + "fork" + Chr(34) + " function call before executing any command ")
  ManualsHelp_L("or transient program.")
  ManualsHelp_L("")
  ManualsHelp_L("A new set of file handles is created, and any current file handles which were ")
  ManualsHelp_L("opened with the " + Chr(34) + "inheritable" + Chr(34) + " access mode bit set (see the " + Chr(34) + "open file handle" + Chr(34) + " ")
  ManualsHelp_L("function -  function 43h),  are copied  into the new set of file handles. Any ")
  ManualsHelp_L("file handles which were  opened with  the " + Chr(34) + "inheritable" + Chr(34) + " bit clear will not be")
  ManualsHelp_L("copied and so will not be  available to the child process.")
  ManualsHelp_L("The standard file handles (00h...05h) are inheritable and so these will be")
  ManualsHelp_L("copied.")
  ManualsHelp_L("")
  ManualsHelp_L("   A new process id is allocated for the child process and the process id. of ")
  ManualsHelp_L("the parent  process is  returned so  that a  later " + Chr(34) + "join" + Chr(34) + "  function call  can ")
  ManualsHelp_L("switch  back to  the parent process. A " + Chr(34) + ".NORAM" + Chr(34) + " error can be produced by this ")
  ManualsHelp_L("function if there is insufficient memory to duplicate the file handles.")
  ManualsHelp_L("")
  ManualsHelp_L("   Because  the child  process now  has a  copy of  the previous file handles ")
  ManualsHelp_L("rather than  the originals,  if one  of them is closed then the original will ")
  ManualsHelp_L("remain  open. So  for example if the child process closes the standard output ")
  ManualsHelp_L("file handle  (file handle number 1) an re-opens it to a new file, then when a ")
  ManualsHelp_L(Chr(34) + "join" + Chr(34) + " function is done to return to the parent process the original standard ")
  ManualsHelp_L("output channel will still be there.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.77   REJOIN PARENT PROCESS (61H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 61H (_JOIN) ")
  ManualsHelp_L("                    B = Process id of parent, or zero")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Primary error code from child")
  ManualsHelp_L("                    C = Secondary error code from child")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  switches back  to the  specified parent process and returns ")
  ManualsHelp_L("the  error code  which the child process terminated with in register B, and a ")
  ManualsHelp_L("secondary error  code from the child in register C. Although the relationship ")
  ManualsHelp_L("between  parent and  childprocesses is strictly one-to-one, this function can ")
  ManualsHelp_L("jump back several levels by giving it a suitable process id. A " + Chr(34) + ".IPROC" + Chr(34) + " error ")
  ManualsHelp_L("will be returned if the process id is invalid.")
  ManualsHelp_L("")
  ManualsHelp_L("   The child  process's set  of file handles are automatically closed and the ")
  ManualsHelp_L("parent  process's set of file handles becomes active again. Also any user RAM ")
  ManualsHelp_L("segments which the child process had allocated will be freed.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the  process id  passed to  this function is zero then a partial system ")
  ManualsHelp_L("re-initialisatin  is done. All file handles are closed and the standard input ")
  ManualsHelp_L("and output handles re-opened and all user segments are freed. This should not ")
  ManualsHelp_L("normally be  done by  a user  program if  it intends to return to the command ")
  ManualsHelp_L("interpreter  since the  command interpreter will not be in a consistent state ")
  ManualsHelp_L("after this.")
  ManualsHelp_L("")
  ManualsHelp_L("   This function takes great care that the freeing of memory and adjusting of ")
  ManualsHelp_L("process id  is done  before actually closing any file handles and thus before ")
  ManualsHelp_L("accessing  the disk. This ensures that if a disk error occurs and is aborted, ")
  ManualsHelp_L("the join  operation will  have been  done successfully. However if a " + Chr(34) + "join 0" + Chr(34) + " ")
  ManualsHelp_L("produces a disk error which is aborted, then the re-initialization of default ")
  ManualsHelp_L("file  handles will not have been done. In this case another " + Chr(34) + "join 0" + Chr(34) + " function ")
  ManualsHelp_L("call should  be done  and this  will not attempt access disk (because all the ")
  ManualsHelp_L("files have been closed) and so will be successful.")
  ManualsHelp_L("")
  ManualsHelp_L("   Note that  if this function call is made via 0F37Dh then registers B and C ")
  ManualsHelp_L("will  not return  the error  codes. This  is because  program termination and ")
  ManualsHelp_L("abort handling  must be  done by the application program. The error code will ")
  ManualsHelp_L("have  been passed  to the abort vector and code there must remember the error ")
  ManualsHelp_L("code if  it needs  to. See the " + Chr(34) + "terminate with error code" + Chr(34) + " function (function ")
  ManualsHelp_L("62h) for the meaning of the primary and secondary error code. ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.78   TERMINATE WITH ERROR CODE (62H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 62H (_TERM) ")
  ManualsHelp_L("                    B = Error code for termination")
  ManualsHelp_L("     Results:       Does not return")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function terminates the program with the specified error code, which ")
  ManualsHelp_L("may be  zero indicating no error. This function call will never return to the ")
  ManualsHelp_L("caller  (unless a  user abort  routine executes  forces it  to - see function ")
  ManualsHelp_L("63h). The operation of this function is different depending on whether it was ")
  ManualsHelp_L("called  from  the  MSX-DOS  environment  via  00005h or  from the  disk BASIC ")
  ManualsHelp_L("environment via 0F37Dh.")
  ManualsHelp_L("")
  ManualsHelp_L("   If called  via 00005h  then if  a user  abort routine  has been defined by ")
  ManualsHelp_L("function  63h it  will be  called with  the specified  error code (and a zero ")
  ManualsHelp_L("secondary error code). Assuming that this routine returns, or if there was no ")
  ManualsHelp_L("user abort  routine defined,  then control  will be  passed back  to whatever ")
  ManualsHelp_L("loaded  the transient program via a jump at location 00000h. This will almost ")
  ManualsHelp_L("always  be  the command  interpreter, but  in some  cases it  may be  another ")
  ManualsHelp_L("transient program.  The error  code will  be remembered by the system and the ")
  ManualsHelp_L("next  " + Chr(34) + "join" + Chr(34) + " function  (function 61h)  which is  done will  return this error ")
  ManualsHelp_L("code. The command interpreter will print an error message for any code in the ")
  ManualsHelp_L("range 20h...FFh, but will not print a message for errors below this.")
  ManualsHelp_L("")
  ManualsHelp_L("   If this function is called from the disk BASIC environment via 0F37Dh then ")
  ManualsHelp_L("control  will be  passed to the abort vector at location " + Chr(34) + "BREAKVECT" + Chr(34) + ". In this ")
  ManualsHelp_L("environment there  is no  separately defined user abort routine and the error ")
  ManualsHelp_L("code  must be  remembered by  the code at " + Chr(34) + "BREAKVECT" + Chr(34) + " because " + Chr(34) + "join" + Chr(34) + " will not ")
  ManualsHelp_L("return the error code.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.79   DEFINE ABORT EXIT ROUTINE (63H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 63H (_DEFAB) ")
  ManualsHelp_L("                   DE = Address of abort exit routine ")
  ManualsHelp_L("                        0000H to un-define routine ")
  ManualsHelp_L("     Results:       A = 0 (never generates errors)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function  is only  available when  called via  location 00005h in the ")
  ManualsHelp_L("MSX-DOS  environment. It  cannot be  called at  location 0F37Dh from the disk ")
  ManualsHelp_L("BASIC environment.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  register DE  is zero  then a  previously defined abort routine will be ")
  ManualsHelp_L("undefined, otherwise  a new  one will  be defined.  The abort routine will be ")
  ManualsHelp_L("called by the system whenever the transient program is about to terminate for ")
  ManualsHelp_L("any  reason other  than a direct jump to location 0000h. Programs written for ")
  ManualsHelp_L("MSX-DOS  2  should  exit  with a  " + Chr(34) + "terminate with  error code" + Chr(34) + "  function call ")
  ManualsHelp_L("(function 061h) rather than a jump to location 0000h.")
  ManualsHelp_L("")
  ManualsHelp_L("   The user  abort routine  will be  entered with the user stack active, with ")
  ManualsHelp_L("IX,  IY and  the alternate  register set as it was when the function call was ")
  ManualsHelp_L("made and  with the  whole TPA  paged in.  The termination  error code will be ")
  ManualsHelp_L("passed to the routine in register A with a secondary error code in register B ")
  ManualsHelp_L("and  if the  routine executes a " + Chr(34) + "RET" + Chr(34) + " then the values returned in registers A ")
  ManualsHelp_L("and  B  will  be  stored as  the error  codes to  be returned  by the  " + Chr(34) + "join" + Chr(34) + " ")
  ManualsHelp_L("function, and  normally printed out by the command interpreter. Alternatively ")
  ManualsHelp_L("the  routine may jump to some warm start code in the transient program rather ")
  ManualsHelp_L("than returning. The system will be in a perfectly stable state able to accept ")
  ManualsHelp_L("any function calls.")
  ManualsHelp_L("")
  ManualsHelp_L("   The primary  error code  passed to  the routine  in register A will be the ")
  ManualsHelp_L("code  which the  program itself  passed to  the " + Chr(34) + "terminate  with error  code" + Chr(34) + " ")
  ManualsHelp_L("function (which  may be  zero) if this is the reason for the termination. The ")
  ManualsHelp_L("routine will also be called if a Ctrl-C or Ctrl-STOP is detected (" + Chr(34) + ".CTRLC" + Chr(34) + " or ")
  ManualsHelp_L(Chr(34) + ".STOP" + Chr(34) + "  error), if  a disk error is aborted (" + Chr(34) + ".ABORT" + Chr(34) + " error), or if an error ")
  ManualsHelp_L("occurred  on  one of  the standard  input or  output channels  being accessed ")
  ManualsHelp_L("through MSX-DOS function calls 01h...0Bh (" + Chr(34) + ".INERR" + Chr(34) + " or " + Chr(34) + ".OUTERR" + Chr(34) + ").")
  ManualsHelp_L("")
  ManualsHelp_L("   The errors " + Chr(34) + ".ABORT" + Chr(34) + ", " + Chr(34) + ".INERR" + Chr(34) + " and " + Chr(34) + ".OUTERR" + Chr(34) + " are generated by the system as ")
  ManualsHelp_L("a  result of  some other  error. For  example a  " + Chr(34) + ".ABORT" + Chr(34) + " can  result from  a ")
  ManualsHelp_L(Chr(34) + ".NRDY" + Chr(34) + " error,  or a  " + Chr(34) + ".INERR" + Chr(34) + " can result from a " + Chr(34) + ".EOF" + Chr(34) + " error. In these cases ")
  ManualsHelp_L("the original error code (" + Chr(34) + ".NRDY" + Chr(34) + " or " + Chr(34) + ".EOF" + Chr(34) + ") is passed to the abort routine in ")
  ManualsHelp_L("register  B as  the secondary  error code.  For all  other errors there is no ")
  ManualsHelp_L("secondary error code and register B will be zero.")
  ManualsHelp_L("")
  ManualsHelp_L("   If the abort routine executes " + Chr(34) + "POP HL : RET" + Chr(34) + " (or equivalent) rather than a ")
  ManualsHelp_L("simple  return,  then  control  will  pass  to  the  instruction  immediately ")
  ManualsHelp_L("following the MSX-DOS call or BIOS call in which the error occurred. This may ")
  ManualsHelp_L("be useful in conjunction with a disk error handler routine (see function 64h) ")
  ManualsHelp_L("to  allow  an option  to abort  the current  MSX-DOS call  when a  disk error ")
  ManualsHelp_L("occurs.")
  ManualsHelp_L("")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.80   DEFINE DISK ERROR HANDLER ROUTINE (64H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 64H (_DEFER) ")
  ManualsHelp_L("                   DE = Address of disk error routine")
  ManualsHelp_L("                        0000H to un-define routine ")
  ManualsHelp_L("     Results:       A = 0 (never generates errors)")
  ManualsHelp_L("")
  ManualsHelp_L("   This function specifies the address of a user routine which will be called ")
  ManualsHelp_L("if a  disk error  occurs. The routine will be entered with the full TPA paged ")
  ManualsHelp_L("in, but with the system stack in page-3 active and none of the registers will ")
  ManualsHelp_L("be preserved from when the MSX-DOS function call was made.")
  ManualsHelp_L("")
  ManualsHelp_L("   The error routine can make MSX-DOS calls but must be very careful to avoid ")
  ManualsHelp_L("recursion. The list of function calls in section 2 of this document indicates ")
  ManualsHelp_L("which function  calls can  be safely  made from  a user  error routine.  This ")
  ManualsHelp_L("routine  is called  with the redirection status being temporarily invalidated ")
  ManualsHelp_L("in case  the standard  I/O channels  have been  redirected. See  the " + Chr(34) + "get/set ")
  ManualsHelp_L("redirection state" + Chr(34) + " function (function 70h) for details of this.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  specification of  parameters and results for the routine itself is as ")
  ManualsHelp_L("below. All  registers including  IX, IY and the alternate register set may be ")
  ManualsHelp_L("destroyed but the paging and stack must be preserved. The routine must return ")
  ManualsHelp_L("to the system, it must not jump away to continue the transient program. If it ")
  ManualsHelp_L("wants to do this then it should return A=1 (" + Chr(34) + "abort" + Chr(34) + ") and a user abort routine ")
  ManualsHelp_L("will then get control and this may do whatever it wants to.")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    A = Error code which caused error")
  ManualsHelp_L("                    B = Physical drive ")
  ManualsHelp_L("                    C = b0 - set if writing")
  ManualsHelp_L("                        b1 - set if ignore not recommended")
  ManualsHelp_L("                        b2 - set if auto-abort suggested")
  ManualsHelp_L("                        b3 - set if sector number is valid ")
  ManualsHelp_L("                   DE = Sector number (if b3 of C is set)")
  ManualsHelp_L("     Results:       A = 0 => Call system error routine")
  ManualsHelp_L("                        1 => Abort")
  ManualsHelp_L("                        2 => Retry")
  ManualsHelp_L("                        3 => Ignore")
  ManualsHelp_L("")
  ManualsHelp_L("  3.81   GET PREVIOUS ERROR CODE (65H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 65H (_ERROR) ")
  ManualsHelp_L("     Results:       A = 0")
  ManualsHelp_L("                    B = Error code from previous function")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function allows  a user  program to  find out  the error  code which ")
  ManualsHelp_L("caused the  previous MSX-DOS  function call  to fail.  It is intended for use ")
  ManualsHelp_L("with the old CP/M compatible functions which do not return an error code. For ")
  ManualsHelp_L("example  if a  " + Chr(34) + "create file  FCB" + Chr(34) + " function  returns A=0FFh thee could be many ")
  ManualsHelp_L("reasons  for  the  failure  and  doing  this  function  call will  return the ")
  ManualsHelp_L("appropriate on, for example " + Chr(34) + ".DRFUL" + Chr(34) + " or " + Chr(34) + ".SYSX" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("  3.82   EXPLAIN ERROR CODE (66H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 66H (_EXPLAIN) ")
  ManualsHelp_L("                    B = Error code to be explained")
  ManualsHelp_L("                   DE = Pointer to 64 byte string buffer")
  ManualsHelp_L("     Results:       A = 0")
  ManualsHelp_L("                    B = 0 or unchanged")
  ManualsHelp_L("                   DE = Filled in with error message ")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function allows  a user  program to get an ASCIIZ explanation string ")
  ManualsHelp_L("for a  particular error  code returned by any of the MSX-DOS functions. If an ")
  ManualsHelp_L("error comes from one of the old functions then " + Chr(34) + "get previous error code" + Chr(34) + " must ")
  ManualsHelp_L("be  called first  to get  the real  error code  and then this function can be ")
  ManualsHelp_L("called to get an explanation string.")
  ManualsHelp_L("")
  ManualsHelp_L("   The " + Chr(34) + "Program Interface Specification" + Chr(34) + " contains a list of all the currently ")
  ManualsHelp_L("defined  error codes  and the messages for them. Foreign language versions of ")
  ManualsHelp_L("the system  will of  course have  different messages.  If the error code does ")
  ManualsHelp_L("have  a built  in explanation  string then  this string  will be returned and ")
  ManualsHelp_L("register B  will be  set to  zero. If  there is  no explanation string then a ")
  ManualsHelp_L("string  of the  form: " + Chr(34) + "System error 194" + Chr(34) + " or " + Chr(34) + "User error 45" + Chr(34) + " will be returned, ")
  ManualsHelp_L("and register  B will  be unchanged.  (System errors  are those  in the  range ")
  ManualsHelp_L("40h...FFh and user errors are 00h...3Fh.) ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.83   FORMAT A DISK (67H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 67H (_FORMAT)")
  ManualsHelp_L("                    B = Drive number (0=>current, 1=>A:)")
  ManualsHelp_L("                    A =    00H    => return choice string")
  ManualsHelp_L("                        01H...09H => format this choice")
  ManualsHelp_L("                        0AH...FDH => illegal")
  ManualsHelp_L("                        FEH, FFH  => new boot sector ")
  ManualsHelp_L("                   HL = Pointer to buffer (if A=1...9)")
  ManualsHelp_L("                   DE = Size of buffer (if A=1...9)  ")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Slot of choice string (only if A=0 on entry)")
  ManualsHelp_L("                   HL = Address of choice string (only if A=0 on entry)")
  ManualsHelp_L("")
  ManualsHelp_L("This function  is used  to format  disks and  is really only provided for the ")
  ManualsHelp_L(Chr(34) + "FORMAT" + Chr(34) + "  command although other programs may use it (with care) if they find ")
  ManualsHelp_L("it useful.  It has  three different  options which  are selected  by the code ")
  ManualsHelp_L("passed in register A.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  A=0  then  registers  B  and  HL  return the  slot number  and address ")
  ManualsHelp_L("respectively  of an ASCIIZ string which specifies the choice of formats which ")
  ManualsHelp_L("is  available.  A " + Chr(34) + ".IFORM" + Chr(34) + "  error will  be returned  if this  disk cannot  be ")
  ManualsHelp_L("formatted (for  example the RAM disk). Normally the string will be read using ")
  ManualsHelp_L("the  " + Chr(34) + "RDSLT" + Chr(34) + " routine  and displayed  on the screen followed by a " + Chr(34) + "? " + Chr(34) + " prompt. ")
  ManualsHelp_L("The user  then specifies a choice " + Chr(34) + "1" + Chr(34) + "..." + Chr(34) + "9" + Chr(34) + " and this choice is passed back to ")
  ManualsHelp_L("the  " + Chr(34) + "format" + Chr(34) + " function,  after a  suitable warning prompt, to actually format ")
  ManualsHelp_L("the disk. If A=0, in some cases zero is returned in HL. This means that there ")
  ManualsHelp_L("is only  one kind of the format and no prompt is required. There is no way of ")
  ManualsHelp_L("knowing  what  disk  format  a  particular  choice  refers to  since this  is ")
  ManualsHelp_L("dependant on the particular disk driver.")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=01h...09h then this is interpreted as a format choice and a disk will ")
  ManualsHelp_L("be formatted  in the  specified drive  with no further prompting. Register HL ")
  ManualsHelp_L("and  DE must specify a buffer area to be used by the disk driver. There is no ")
  ManualsHelp_L("way of  knowing how big this buffer should be so it is best to make it as big ")
  ManualsHelp_L("as  possible. If  the buffer  crosses page boundaries then this function will ")
  ManualsHelp_L("select the largest portion of it which is in one page for passing to the disk ")
  ManualsHelp_L("driver. Many disk drivers do not use this buffer at all.")
  ManualsHelp_L("")
  ManualsHelp_L("   If  A=FFh then  the disk  will not  actually be  formatted, but it will be ")
  ManualsHelp_L("given a  new boot  sector to  make the  disk a  true MSX-DOS  2 disk. This is ")
  ManualsHelp_L("designed  to update  old MSX-DOS 1.0 disks to have a volume id and thus allow ")
  ManualsHelp_L("the full  disk checking and undeletion which MSX-DOS 2 allows. The case A=FEh ")
  ManualsHelp_L("is  the  same  as  A=FFh  except that  only the  disk parameters  are updated ")
  ManualsHelp_L("correctly  and the  volume id does not overwrite the boot program. Also there ")
  ManualsHelp_L("are some  MSX-DOS 1.0  implementations which  put an incorrect boot sector on ")
  ManualsHelp_L("the  disk and  these disks  cannot be  used by MSX-DOS 2 until they have been ")
  ManualsHelp_L("corrected by this function.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  " + Chr(34) + "new  boot  sector" + Chr(34) + "  function  is mainly  intended for  the " + Chr(34) + "FIXDISK" + Chr(34) + " ")
  ManualsHelp_L("utility program, but may be used by other programs if they find it useful. If ")
  ManualsHelp_L("it  is used  then a  " + Chr(34) + "get format  choice" + Chr(34) + " function  call (A=0) should be done ")
  ManualsHelp_L("first and  if this  returns an  error (typically " + Chr(34) + ".IFORM" + Chr(34) + ") then the operation ")
  ManualsHelp_L("should be aborted because this is a drive which does not like to be formatted ")
  ManualsHelp_L("and the disk could be damaged by this function.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.84   CREATE OR DESTROY RAMDISK (68H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 68H (_RAMD) ")
  ManualsHelp_L("                    B =     00H => destroy RAM disk")
  ManualsHelp_L("                        1...FEH => create new RAM disk")
  ManualsHelp_L("                            FFH => return RAM disk size")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = RAM disk size")
  ManualsHelp_L("")
  ManualsHelp_L("   If  register B=0FFh  then this  routine just returns the number of 16k RAM ")
  ManualsHelp_L("segments which  are allocated  to the  RAM disk  currently. A  value of  zero ")
  ManualsHelp_L("indicates  that  there  is no  RAM disk  currently defined.  If B=0  then the ")
  ManualsHelp_L("current  RAM disk  will be destroyed, loosing all data which it contained and ")
  ManualsHelp_L("no error will be returned if there was no RAM disk.")
  ManualsHelp_L("")
  ManualsHelp_L("   Otherwise, if  B is in the range 01h...FEh then this function will attempt ")
  ManualsHelp_L("to  create a  new RAM  disk using  the number  of 16k  segments specified  in ")
  ManualsHelp_L("register  B.  An  error  will  be  returned if  there is  already a  RAM disk ")
  ManualsHelp_L("(" + Chr(34) + ".RAMDX" + Chr(34) + ") or  if there is not even one segment free (" + Chr(34) + ".NORAM" + Chr(34) + "). If there are ")
  ManualsHelp_L("insufficient  free RAM segments to make a RAM disk of the specified size then ")
  ManualsHelp_L("the largest one possible will be created. No error is returned in this case.")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("   In  all cases the size of the RAM disk will be returned in register B as a ")
  ManualsHelp_L("number of segments. Note that some of the RAM is used for the file allocation ")
  ManualsHelp_L("tables and  the root  directory so  the size  of the RAM disk as indicated by ")
  ManualsHelp_L(Chr(34) + "DIR" + Chr(34) + " or " + Chr(34) + "CHKDSK" + Chr(34) + " will be somewhat smaller than the total amount of RAM used. ")
  ManualsHelp_L("The  RAM will  always be  assigned the  drive letter  " + Chr(34) + "H:" + Chr(34) + " regardless  of the ")
  ManualsHelp_L("number of drives in the system.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.85   ALLOCATE SECTOR BUFFERS (69H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 69H (_BUFFER) ")
  ManualsHelp_L("                    B = 0 => return number of buffers")
  ManualsHelp_L("                        else number of buffers required")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Current number of buffers ")
  ManualsHelp_L("")
  ManualsHelp_L("   If  B=0 then this function just returns the number of sector buffers which ")
  ManualsHelp_L("are currently  allocated. If B<>0 then this function will attempt to use this ")
  ManualsHelp_L("number  of sector  buffers (must always be at least 2). If it cannot allocate ")
  ManualsHelp_L("as many as requested then it will allocate as many as possible and return the ")
  ManualsHelp_L("number in  register B  but will  not return  an error.  The number  of sector ")
  ManualsHelp_L("buffers can be reduced as well as increased.")
  ManualsHelp_L("")
  ManualsHelp_L("   The  sector buffers  are allocated in a 16k RAM segment outside the normal ")
  ManualsHelp_L("64k so  the number  of buffers  does not  detract from  the size  of the TPA. ")
  ManualsHelp_L("However  the number of buffers does affect efficiency since with more buffers ")
  ManualsHelp_L("allow more  FAT and directory sectors to be kept resident. The maximum number ")
  ManualsHelp_L("of buffers will be about 20.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.86   LOGICAL DRIVE ASSIGNMENT (6AH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6AH (_ASSIGN) ")
  ManualsHelp_L("                    B = Logical drive number (1=A: etc)")
  ManualsHelp_L("                    D = Physical drive number (1=A: etc)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    D = Physical drive number (1=A: etc)")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function controls the logical to physical drive assignment facility. ")
  ManualsHelp_L("It is  primarily intended for the " + Chr(34) + "ASSIGN" + Chr(34) + " command although user programs may ")
  ManualsHelp_L("want to use it to translate logical drive numbers to physical drive numbers.")
  ManualsHelp_L("")
  ManualsHelp_L("   If both  B and  D are  non-zero then  a new  assignment will be set up. If ")
  ManualsHelp_L("register  B is  non-zero and  register D  is zero then any assignment for the ")
  ManualsHelp_L("logical drive  specified by B will be cancelled. If both register B and D are ")
  ManualsHelp_L("zero  then all  assignments will  be cancelled. If register B is non-zero and ")
  ManualsHelp_L("register D is FFh then the current assignment for the logical drive specified ")
  ManualsHelp_L("by register B will simply be returned in register D.")
  ManualsHelp_L("")
  ManualsHelp_L("   All  drives used  in the  various function calls, including drive names in ")
  ManualsHelp_L("strings  and  drive  numbers  as parameters  to function  calls, are  logical ")
  ManualsHelp_L("drives. However  the drive number passed to disk error routines is a physical ")
  ManualsHelp_L("drive  so  if  " + Chr(34) + "ASSIGN" + Chr(34) + "  has  been  used  these  may  be  different  from the ")
  ManualsHelp_L("corresponding logical drive.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.87   GET ENVIRONMENT ITEM (6BH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6BH (_GENV)")
  ManualsHelp_L("                   HL = ASCIIZ name string")
  ManualsHelp_L("                   DE = Pointer to buffer for value")
  ManualsHelp_L("                    B = Size of buffer")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   DE = Preserved, buffer filled in if A=0")
  ManualsHelp_L("")
  ManualsHelp_L("   This function gets the current value of the environment item whose name is ")
  ManualsHelp_L("passed  in register  HL. A  " + Chr(34) + ".IENV" + Chr(34) + " error  is returned  if the name string is ")
  ManualsHelp_L("invalid. If there is no environment item of that name then a null string will ")
  ManualsHelp_L("be returned  in the  buffer. If  there is an item of that name then its value ")
  ManualsHelp_L("string  will be  copied to  the buffer.  If the  buffer is too small then the ")
  ManualsHelp_L("value string  will be truncated with no terminating null and a " + Chr(34) + ".ELONG" + Chr(34) + " error ")
  ManualsHelp_L("will  be returned. A buffer 255 bytes will always be large enough since value ")
  ManualsHelp_L("strings cannot be longer than this (including the terminating null).")
  ManualsHelp_L(" ")
  ManualsHelp_L("")
  ManualsHelp_L("  3.88   SET ENVIRONMENT ITEM (6CH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6CH (_SENV)")
  ManualsHelp_L("                   HL = ASCIIZ name string")
  ManualsHelp_L("                   DE = ASCIIZ value string")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function sets  a new environment item. If the name string is invalid ")
  ManualsHelp_L("then a " + Chr(34) + ".IENV" + Chr(34) + " error is returned, otherwise the value string is checked and a ")
  ManualsHelp_L(Chr(34) + ".ELONG" + Chr(34) + " error  returned if  it is  longer than 255 characters, or a " + Chr(34) + ".NORAM" + Chr(34) + " ")
  ManualsHelp_L("error  if there  is insufficient memory to store the new item. If all is well ")
  ManualsHelp_L("then any  old item  of this  name is deleted and the new item is added to the ")
  ManualsHelp_L("beginning  of the  environment list.  If the  value string  is null  then the ")
  ManualsHelp_L("environment item will be removed.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.89   FIND ENVIRONMENT ITEM (6DH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6DH (_FENV)")
  ManualsHelp_L("                   DE = Environment item number")
  ManualsHelp_L("                   HL = Pointer to buffer for name string")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                   HL = Preserved, buffer filled in")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function is  used to  find out  what environment items are currently ")
  ManualsHelp_L("set. The  item number  in register DE identifies which item in the list is to ")
  ManualsHelp_L("be  found (the  first item  corresponds to  DE=1). If there is an item number ")
  ManualsHelp_L("<DE> then the name string of this item will be copied into the buffer pointed ")
  ManualsHelp_L("to by  HL. If the buffer is too small then the name will be truncated with no ")
  ManualsHelp_L("terminating null, and a " + Chr(34) + ".ELONG" + Chr(34) + " error returned. A 255 byte buffer will never ")
  ManualsHelp_L("be  too small.  If there  is no  item number  <DE> then a null string will be ")
  ManualsHelp_L("returned, since an item can never have a null name string.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.90   GET/SET DISK CHECK STATUS (6EH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6EH (_DSKCHK)")
  ManualsHelp_L("                    A = 00H => get disk check status")
  ManualsHelp_L("                        01H => set disk check status")
  ManualsHelp_L("                    B = 00H => enable (only if A=01H)")
  ManualsHelp_L("                        FFH => disable (only if A=01H)")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Current disk check setting")
  ManualsHelp_L("")
  ManualsHelp_L("   If A=0  then the  current value  of the disk check variable is returned in ")
  ManualsHelp_L("register  B. If  A=01h then the variable is set to the value in register B. A ")
  ManualsHelp_L("value of 00h means that disk checking is enabled and a non-zero means that it ")
  ManualsHelp_L("is disabled. The default state is enabled.")
  ManualsHelp_L("")
  ManualsHelp_L("   The disk check variable controls whether the system will re-check the boot ")
  ManualsHelp_L("sector of  a disk  to see  whether it  has changed,  each time a file handle, ")
  ManualsHelp_L("fileinfo  block  or  FCB  is  accessed.  If  it is  enabled then  it will  be ")
  ManualsHelp_L("impossible  to accidentally  access the  wrong disk by changing a disk in the ")
  ManualsHelp_L("middle of  an operation,  otherwise this will be possible and may result in a ")
  ManualsHelp_L("corrupted  disk. Depending  on the  type of disk interface, there may be some ")
  ManualsHelp_L("additional overhead  in having  this feature enabled although with many types ")
  ManualsHelp_L("of  disk (those with explicit disk change detection hardware) it will make no ")
  ManualsHelp_L("difference and the additional security is well worth having.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.91   GET MSX-DOS VERSION NUMBER (6FH)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 6FH (_DOSVER)")
  ManualsHelp_L("     Results:       A = Error (always zero)")
  ManualsHelp_L("                   BC = MSX-DOS kernel version")
  ManualsHelp_L("                        DE = MSXDOS2.SYS version number")
  ManualsHelp_L("")
  ManualsHelp_L("   This function allows a program to determine which version of MSX-DOS it is ")
  ManualsHelp_L("running  under. Two  version numbers  are returned, one in BC for the MSX-DOS ")
  ManualsHelp_L("kernel in  ROM and  the other  is DE for the MSXDOS2.SYS system file. Both of ")
  ManualsHelp_L("these  version numbers  are BCD  values with  the major version number in the ")
  ManualsHelp_L("high byte  and the  two digit  version number in the low byte. For example if ")
  ManualsHelp_L("there were a version 2.34 of the system, it would be represented as 0234h.")
  ManualsHelp_L("")
  ManualsHelp_L("   For compatibility  with MSX-DOS 1.0, the following procedure should always ")
  ManualsHelp_L("be followed in using this function. Firstly if there is any error (A<>0) then ")
  ManualsHelp_L("it  is not  MSX-DOS at  all. Next  look at register B. If this is less than 2 ")
  ManualsHelp_L("then the system is earlier than 2.00 and registers C and DE are undefined. If ")
  ManualsHelp_L("register B  is 2 or greater then registers BC and DE can be used as described ")
  ManualsHelp_L("above.  In general  the version  number which  should be  checked (after this ")
  ManualsHelp_L("procedure) is the MSXDOS2.SYS version in register DE.")
  ManualsHelp_L("")
  ManualsHelp_L("  3.92   GET/SET REDIRECTION STATE (70H)")
  ManualsHelp_L("")
  ManualsHelp_L("     Parameters:    C = 70H (_REDIR)")
  ManualsHelp_L("                    A = 00H => get redirection state")
  ManualsHelp_L("                        01H => set redirection state")
  ManualsHelp_L("                    B = New state.   b0 - standard input")
  ManualsHelp_L("                                     b1 - standard output")
  ManualsHelp_L("     Results:       A = Error")
  ManualsHelp_L("                    B = Redirection state before command")
  ManualsHelp_L("                         b0 set => input is redirected")
  ManualsHelp_L("                         b1 set => output is redirected")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function is  provided primarily  for disk  error routines  and other ")
  ManualsHelp_L("character  I/O  which  must  always  go  to  the  console  regardless  of any ")
  ManualsHelp_L("redirection.  When  the CP/M  character functions  (functions 01h...0Bh)  are ")
  ManualsHelp_L("used, they  normally refer  to the  console. However if the standard input or ")
  ManualsHelp_L("output file handles (file handles 0 and 1) have been closed and reopened to a ")
  ManualsHelp_L("disk  file, then  the CP/M character functions will also go to the disk file. ")
  ManualsHelp_L("However certain output such as disk error output must always go to the screen ")
  ManualsHelp_L("regardless.")
  ManualsHelp_L("")
  ManualsHelp_L("   This  function allows  any such redirection to be temporarily cancelled by ")
  ManualsHelp_L("calling this  function with A=1 and B=0. This will ensure that any subsequent ")
  ManualsHelp_L("CP/M  console I/O  will go  to the console, and will also return the previous ")
  ManualsHelp_L("setting so  that this  can be  restored afterwards.  The system is a somewhat ")
  ManualsHelp_L("unstable  state when  the redirection  state has  been altered  like this and ")
  ManualsHelp_L("there are  many function  calls which  will reset the redirection to its real ")
  ManualsHelp_L("state   over-riding  this  function.  In  general  any  function  call  which ")
  ManualsHelp_L("manipulates file  handles, such  as " + Chr(34) + "open" + Chr(34) + ",  " + Chr(34) + "close" + Chr(34) + ", " + Chr(34) + "duplicate" + Chr(34) + "  and so on, ")
  ManualsHelp_L("will  reset the  redirection state.  The effect of this function is therefore ")
  ManualsHelp_L("purely temporary.")
  ManualsHelp_Commit("MSX-DOS 2 - Codigos de Funcao", "MSX-DOS 2")

  ManualsHelp_Begin()
  ManualsHelp_L("Z80")
  ManualsHelp_L("")
  ManualsHelp_L("The Z80 is 8 bit processor running with a frequency of 3.57945 Mhz.")
  ManualsHelp_L("")
  ManualsHelp_L("Details:")
  ManualsHelp_L("")
  ManualsHelp_L("Z80 command set")
  ManualsHelp_L("")
  ManualsHelp_L("Z80 instruction set summary")
  ManualsHelp_L("")
  ManualsHelp_L("Lex Lechz: the following table lists the extensions from the Z80 to the")
  ManualsHelp_L("R800 processor.")
  ManualsHelp_L("These extensions are implemented in RuMSX.")
  ManualsHelp_L("")
  ManualsHelp_L("R800-Processor (16 Bit, 7.15909 Mhz) opcodes")
  ManualsHelp_L("")
  ManualsHelp_L("Please also be careful with illegal instructions. Officially 8 bit access to ")
  ManualsHelp_L("the IX and IY register isn't guaranteed on the Z80. Using the R800 no problems ")
  ManualsHelp_L("will arise. However , the object code of LD IXH,IXL is DD 65 but the assembler ")
  ManualsHelp_L("will probably create DD DD 65. On the Z80 this code will run ok but this is ")
  ManualsHelp_L("not guaranteed that it will work proper on the R800. So be careful with ")
  ManualsHelp_L("illegal instructions.")
  ManualsHelp_L("")
  ManualsHelp_L("R800-Processor (16 Bit, 7.15909 Mhz) opcodes (excerpt)")
  ManualsHelp_L("")
  ManualsHelp_L("Instruction | Operation | C | Z | P/V | S | N | H | Opcode | M-Cycles | T-States")
  ManualsHelp_L("MULUW HL,BC | DEHL <- HL*BC | Chg | Chg | 0 | 0 | NoChg | NoChg | ED C3 | 36 | 36")
  ManualsHelp_L("MULUW HL,SP | DEHL <- HL*SP | Chg | Chg | 0 | 0 | NoChg | NoChg | ED F3 | 36 | 36")
  ManualsHelp_L("MULU A,B | HL <- A*B | Chg | Chg | 0 | 0 | NoChg | NoChg | ED C1 | 14 | 14")
  ManualsHelp_L("MULU A,C | HL <- A*C | Chg | Chg | 0 | 0 | NoChg | NoChg | ED C9 | 14 | 14")
  ManualsHelp_L("MULU A,D | HL <- A*D | Chg | Chg | 0 | 0 | NoChg | NoChg | ED D1 | 14 | 14")
  ManualsHelp_L("MULU A,E | HL <- A*E | Chg | Chg | 0 | 0 | NoChg | NoChg | ED D9 | 14 | 14")
  ManualsHelp_Commit("Z80 - Visao Geral / Extensoes R800", "Z80")

  ManualsHelp_Begin()
  ManualsHelp_L("Z80 Instruction set summary")
  ManualsHelp_L("")
  ManualsHelp_L(" Table A-3. Z80 Mnemonics and Operations in Alphabetical Order")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|Mnemonic    |Operation           |CZPSNH|Len|Tim|Comments              |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|ADC A,r     |A:=A+r+CY           |**V*0*| 1 | 4 | r - A,B,C,D,E,H,L    |")
  ManualsHelp_L("|ADC A,(HL)  |A:=A+(HL)+CY        |      | 1 | 7 |                      |")
  ManualsHelp_L("|ADC A,n     |A:=A+n+CY           |      | 2 | 7 | n - byte (0..FF)     |")
  ManualsHelp_L("|ADC A,(ii+n)|A:=A+(ii+n)+CY      |      | 3 |19 |ii - IX,IY            |")
  ManualsHelp_L("|ADC HL,rr   |HL:=HL+rr+CY        |**V*0x| 2 |15 |rr - BC,DE,HL,SP      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|ADD A,r     |A:=A+r              |**V*0*| 1 | 4 |                      |")
  ManualsHelp_L("|ADD A,(HL)  |A:=A+(HL)           |      | 1 | 7 |                      |")
  ManualsHelp_L("|ADD A,n     |A:=A+n              |      | 2 | 7 |                      |")
  ManualsHelp_L("|ADD A,(ii+n)|A:=A+(ii+n)         |      | 3 |19 |                      |")
  ManualsHelp_L("|ADD HL,rr   |HL:=HL+rr           |*...0x| 1 |11 |                      |")
  ManualsHelp_L("|ADD IX,ry   |IX:=IX+px           |      | 2 |15 |ry - BC,DE,SP,IY      |")
  ManualsHelp_L("|ADD IY,rx   |IY:=IY+py           |      | 2 |15 |rx - BC,DE,SP,IX      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|AND r       |A:=A and r          |0*P*01| 1 | 4 |                      |")
  ManualsHelp_L("|AND (HL)    |A:=A and (HL)       |      | 1 | 7 |                      |")
  ManualsHelp_L("|AND n       |A:=A and n          |      | 2 | 7 |                      |")
  ManualsHelp_L("|AND (ii+n)  |A:=A and (ii+n)     |      | 3 |19 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|BIT b,r     |Z:=not rb           |.*xx01| 2 | 8 | b - bit number (0..7)|")
  ManualsHelp_L("|BIT b,(HL)  |Z:=not (HL)b        |      | 2 |12 |xb - bit b of         |")
  ManualsHelp_L("|BIT b,(ii+n)|Z:=not (ii+n)b      |      | 4 |20 |          location x  |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CALL nn     |PUSH PC;PC:=nn      |......| 3 |17 |nn - word (0..FFFF)   |")
  ManualsHelp_L("|CALL cc,nn  |If cc then CALL nn  |      | 3 |17 |cc - C,NC,Z,NZ,M,P,PE,|")
  ManualsHelp_L("|            |      else continue |      |   |10 |                   PO |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CCF         |CY:=not CY          |*...0x| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CP r        |A-r                 |**V*1*| 1 | 4 |                      |")
  ManualsHelp_L("|CP (HL)     |A-(HL)              |      | 1 | 7 |                      |")
  ManualsHelp_L("|CP n        |A-n                 |      | 2 | 7 |                      |")
  ManualsHelp_L("|CP (ii+n)   |A-(ii+n)            |      | 3 |19 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CPD         |A-(HL);dec HL;dec BC|.***1*| 2 |16 |PV=0 if BC=0,else PV=1|")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CPDR        |Repeat CPD          |.***1*| 2 |21 |                      |")
  ManualsHelp_L("|            | until Z=1 or BC=0  |      |   |16 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CPI         |A-(HL);inc HL;dec BC|.***1*| 2 |16 |PV=0 if BC=0,else PV=1|")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CPIR        |Repeat CPI          |.***1*| 2 |21 |                      |")
  ManualsHelp_L("|            | until Z=1 or BC=0  |      |   |16 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|CPL         |A:=A xor 255        |....11| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|DAA         |Decimal adjust Acc. |**P*.*| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|DEC r       |r:=r-1              |.*V*1*| 1 | 4 |                      |")
  ManualsHelp_L("|DEC (HL)    |(HL):=(HL)-1        |      | 1 |11 |                      |")
  ManualsHelp_L("|DEC (ii+n)  |(ii+n):=(ii+n)-1    |      | 3 |23 |                      |")
  ManualsHelp_L("|DEC rr      |rr:=rr-1            |......| 1 | 6 |                      |")
  ManualsHelp_L("|DEC ii      |ii:=ii-1            |      | 2 |10 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|DI          |IFF:=0              |......| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|DJNZ e      |dec B;if B 0 JR e   |......| 2 |13 | e - relative address |")
  ManualsHelp_L("|            |     if B=0 continue|      |   | 8 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|EI          |IFF:=1              |......| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|EX AF,AF'   |AF<->AF'            |......| 1 | 4 |                      |")
  ManualsHelp_L("|EX DE,HL    |DE<->HL             |      | 1 | 4 |                      |")
  ManualsHelp_L("|EX (SP),HL  |(SP)<->HL           |      | 1 | 4 |                      |")
  ManualsHelp_L("|EX (SP),ii  |(SP)<->ii           |      | 2 |23 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|EXX         |BC<->BC';DE<->DE';  |......| 1 | 4 |                      |")
  ManualsHelp_L("|            |HL<->HL'            |      |   |   |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|HALT        |Halt CPU            |......| 1 | 4 |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|IM 1        |Interrupt mode 1    |......| 2 | 8 |                      |")
  ManualsHelp_L("|IM 2        |Interrupt mode 2    |      |   |   |                      |")
  ManualsHelp_L("|IM 3        |Interrupt mode 3    |      |   |   |                      |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|IN A,(n)    |A:=port(n)          |......| 2 |11 |                      |")
  ManualsHelp_L("|IN r,(C)    |r:=port(C)          |.*P*0*| 2 |12 |                      |")
  ManualsHelp_L("|IN ?,(C)    |only set flags as   |.*P*0*| 2 |12 |can't be entered as a |")
  ManualsHelp_L("|            |   as IN r,(C) does |      |   |   |command;code is ED 70 |")
  ManualsHelp_L("+------------+--------------------+------+---+---+----------------------+")
  ManualsHelp_L("|INC r       |r:=r+1              |.*V*0*| 1 | 4 |                      |")
  ManualsHelp_L("|INC (HL)    |(HL):=(HL)+1        |      | 1 |11 |                      |")
