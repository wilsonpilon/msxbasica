  ManualsHelp_L("  contents:	FB07H +0:  RST 30H (0F7H)")
  ManualsHelp_L("		FB07H +1:  byte data")
  ManualsHelp_L("		FB07H +2:  (Low)")
  ManualsHelp_L("		FB07H +3:  (High)")
  ManualsHelp_L("		FB07H +4:  RET (0C9H)")
  ManualsHelp_L("")
  ManualsHelp_L("OLDSTT (FB0CH, 5)")
  ManualsHelp_L("  contents:	FB0CH +0:  RST 30H (0F7H)")
  ManualsHelp_L("		FB0CH +1:  byte data")
  ManualsHelp_L("		FB0CH +2:  (Low)")
  ManualsHelp_L("		FB0CH +3:  (High)")
  ManualsHelp_L("		FB0CH +4:  RET (0C9H)")
  ManualsHelp_L("")
  ManualsHelp_L("OLDINT (FB12H, 5)")
  ManualsHelp_L("  contents:	FB12H +0:  RST 30H (0F7H)")
  ManualsHelp_L("		FB12H +1:  byte data")
  ManualsHelp_L("		FB12H +2:  (Low)")
  ManualsHelp_L("		FB12H +3:  (High)")
  ManualsHelp_L("		FB12H +4:  RET (0C9H)")
