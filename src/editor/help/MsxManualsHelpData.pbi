  ManualsHelp_L("    Bits indicated by an " + Chr(34) + "." + Chr(34) + " are always 0 and cannot be modified.")
  ManualsHelp_L("")
  ManualsHelp_L("* Selecting 12-hour clock/24-hour clock")
  ManualsHelp_L("")
  ManualsHelp_L("Two clocks can be selected; one is a 24-hour clock which represents one ")
  ManualsHelp_L("o'clock in the afternoon as 13 o'clock, and the other is a 12-hour clock ")
  ManualsHelp_L("which represents it as 1 p.m. Register #10 is used to select between them. As ")
  ManualsHelp_L("shown in Figure 5.30, the 12-hour clock is selected when B0 is " + Chr(34) + "0" + Chr(34) + " and the ")
  ManualsHelp_L("24-hour clock when B0 is " + Chr(34) + "1" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.30	Selecting 12-hour clock/24-hour clock")
  ManualsHelp_L("")
  ManualsHelp_L("  B3   B2   B1	 B0")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("|  . |	. |  . | B0 |  Register #10 (block 1)")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("		 |")
  ManualsHelp_L("		 +-->  0: 12-hour clock")
  ManualsHelp_L("		       1: 24-hour clock")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.31	Morning/afternoon flag for 12-hour clock")
  ManualsHelp_L("")
  ManualsHelp_L("  B3   B2   B1	 B0")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("|  . |	. | B1 |  X |  register #5 (block 0)")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("	    |")
  ManualsHelp_L("	    +------->  0: before noon")
  ManualsHelp_L("		       1: after noon")
  ManualsHelp_L("")
  ManualsHelp_L("* Leap year counter")
  ManualsHelp_L("")
  ManualsHelp_L("Register #11 of block 1 is a mod 4 counter which is renewed along with the ")
  ManualsHelp_L("count of the year. When the 2 low order bits of this register are 00H, that ")
  ManualsHelp_L("is considered as a leap year and 29 days are counted in February.")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.32	Leap year determination")
  ManualsHelp_L("")
  ManualsHelp_L("  B3   B2   B1	 B0")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("|  . |	. | B1 | B0 |  Register #11 (block 1)")
  ManualsHelp_L("---------------------")
  ManualsHelp_L("	    |	 |")
  ManualsHelp_L("	    +----+-->  Both bits 0 represents leap year.")
  ManualsHelp_L("")
  ManualsHelp_L("6.7 Contents of the Battery-powered Memory")
  ManualsHelp_L("")
  ManualsHelp_L("Blocks 2 and 3 of the CLOCK-IC are used as the battery-powered 4-bit x 13 ")
  ManualsHelp_L("memory blocks. MSX2 uses this area as shown below.")
  ManualsHelp_L("")
  ManualsHelp_L("* Contents of block 2")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.33	Contents of block 2")
  ManualsHelp_L("")
  ManualsHelp_L("   |	   B3	    |	    B2	     |	     B1       |       B0       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 0 |				     ID 			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 1 |			    Adjust X (-8 to +7) 		       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 2 |			    Adjust Y (-8 to +7) 		       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 3 |   __________   |	__________   | Interlace mode |  Screen mode   |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 4 |			     WIDTH value (Lo)			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 5 |			     WIDTH value (Hi)			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 6 |			     Foreground color			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 7 |			     Background color			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 8 |			       Border color			       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L(" 9 | Cassette speed |  Printer mode  |	 Key click    |   Key ON/OFF   |")
  ManualsHelp_L("   |---------------------------------+---------------------------------|")
  ManualsHelp_L("10 |		BEEP tone	     |		 BEEP volume	       |")
  ManualsHelp_L("   |---------------------------------+---------------------------------|")
  ManualsHelp_L("11 |   __________   |	__________   |		 Title colour	       |")
  ManualsHelp_L("   |-------------------------------------------------------------------|")
  ManualsHelp_L("12 |				Native code			       |")
  ManualsHelp_L("   ---------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("* Contents of block 3")
  ManualsHelp_L("")
  ManualsHelp_L("Block 3 has three functions, depending on the contents of the ID value ")
  ManualsHelp_L("(register #0). Figure 5.34 shows the functions.")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.34	Contents of block 3")
  ManualsHelp_L("")
  ManualsHelp_L("ID=0: displays the title (within 6 characters) on the initial screen")
  ManualsHelp_L("   ------------------------------------------------------")
  ManualsHelp_L(" 0 |  0 						|")
  ManualsHelp_L("   |----------------------------------------------------| --+")
  ManualsHelp_L(" 1 |  Lo 1 --+--- 1st character of the title		|   |")
  ManualsHelp_L("   |	     |						|   |")
  ManualsHelp_L(" 2 |  Hi 1 --+						|   |")
  ManualsHelp_L("   |----------------------------------------------------|   |")
  ManualsHelp_L(" . |	   .						|   |")
  ManualsHelp_L(" . |	   .						|   | 6 characters")
  ManualsHelp_L(" . |	   .						|   |")
  ManualsHelp_L("   |----------------------------------------------------|   |")
  ManualsHelp_L("11 |  Lo 6 --+--- 6th character of the title		|   |")
  ManualsHelp_L("   |	     |						|   |")
  ManualsHelp_L("12 |  Hi 6 --+						|   |")
  ManualsHelp_L("   ------------------------------------------------------ --+")
  ManualsHelp_L("")
  ManualsHelp_L("ID=1: sets the password")
  ManualsHelp_L("   ------------------------------------------------------")
  ManualsHelp_L(" 0 |  1 						|")
  ManualsHelp_L("   |----------------------------------------------------|")
  ManualsHelp_L(" 1 |  Usage ID=1					|")
  ManualsHelp_L("   |							|")
  ManualsHelp_L(" 2 |  Usage ID=2					|")
  ManualsHelp_L("   |							|")
  ManualsHelp_L(" 3 |  Usage ID=3					|")
  ManualsHelp_L("   |----------------------------------------------------|")
  ManualsHelp_L(" 4 |  Password	--+					|")
  ManualsHelp_L("   |		  |					|")
  ManualsHelp_L(" 5 |  Password	  |   Password data is stored		|")
  ManualsHelp_L("   |		  |-- compressed in 4bits x 4 bits	|")
  ManualsHelp_L(" 6 |  Password	  |					|")
  ManualsHelp_L("   |		  |					|")
  ManualsHelp_L(" 7 |  Password	--+					|")
  ManualsHelp_L("   |----------------------------------------------------|")
  ManualsHelp_L(" 8 |  Key cartridge flag				|")
  ManualsHelp_L("   |----------------------------------------------------|")
  ManualsHelp_L(" 9 |  Key cartridge value				|")
  ManualsHelp_L("   |							|")
  ManualsHelp_L("10 |  Key cartridge value				|")
  ManualsHelp_L("   |							|")
  ManualsHelp_L("11 |  Key cartridge value				|")
  ManualsHelp_L("   |							|")
  ManualsHelp_L("12 |  Key cartridge value				|")
  ManualsHelp_L("   ------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("ID=2: sets the prompt on BASIC")
  ManualsHelp_L("   ------------------------------------------------------")
  ManualsHelp_L(" 0 |  2 						|")
  ManualsHelp_L("   |----------------------------------------------------| --+")
  ManualsHelp_L(" 1 |  Lo 1 --+--- 1st character of the prompt		|   |")
  ManualsHelp_L("   |	     |						|   |")
  ManualsHelp_L(" 2 |  Hi 1 --+						|   |")
  ManualsHelp_L("   |----------------------------------------------------|   |")
  ManualsHelp_L(" . |	   .						|   |")
  ManualsHelp_L(" . |	   .						|   | 6 characters")
  ManualsHelp_L(" . |	   .						|   |")
  ManualsHelp_L("   |----------------------------------------------------|   |")
  ManualsHelp_L("11 |  Lo 6 --+--- 6th character of the prompt		|   |")
  ManualsHelp_L("   |	     |						|   |")
  ManualsHelp_L("12 |  Hi 6 --+						|   |")
  ManualsHelp_L("   ------------------------------------------------------ --+")
  ManualsHelp_L("")
  ManualsHelp_L("6.8 Access to the CLOCK-IC")
  ManualsHelp_L("")
  ManualsHelp_L("The following BIOS routines are offered to access the clock and the ")
  ManualsHelp_L("battery-powered memory. Since these routines reside in SUB-ROM, they are ")
  ManualsHelp_L("called by using the inter-slot call.")
  ManualsHelp_L("")
  ManualsHelp_L("* REDCLK (015FH/SUB) .................. read CLOCK-IC data")
  ManualsHelp_L("")
  ManualsHelp_L("Input:		C <-- CLOCK-IC address (see Figure 5.35)")
  ManualsHelp_L("Output: 	A <-- data obtained (only 4 low order bits valid)")
  ManualsHelp_L("Function:	reads CLOCK-IC register in the address specified by the")
  ManualsHelp_L("		C register and stores in the A register. Since the address")
  ManualsHelp_L("		specification includes the block selection information as")
  ManualsHelp_L("		shown in Figure 5.35, it is not necessary to set the MODE")
  ManualsHelp_L("		register and then read the objective register.")
  ManualsHelp_L("")
  ManualsHelp_L("   Figure 5.35	CLOCK-IC register specification method")
  ManualsHelp_L("")
  ManualsHelp_L("		-----------------------------------------")
  ManualsHelp_L("C register	|  . |	. | M1 : M0 | A3 : A2 : A1 : A0 |")
  ManualsHelp_L("		-----------------------------------------")
  ManualsHelp_L("			  |	    |			|")
  ManualsHelp_L("			  +---------+-------------------+")
  ManualsHelp_L("			  Block to be	    Register")
  ManualsHelp_L("			  selected	    address")
  ManualsHelp_L("")
  ManualsHelp_L("* WRTCLK (01F9H/SUB) .................. write CLOCK-IC data")
  ManualsHelp_L("")
  ManualsHelp_L("Input:		C <-- CLOCK-IC address (see Figure 5.35)")
  ManualsHelp_L("		A <-- data to be written (4 low order bits)")
  ManualsHelp_L("Output: 	---")
  ManualsHelp_L("Function:	write the contents of the A register in the CLOCK-IC at the")
  ManualsHelp_L("		address specified by the C register. The address is specified")
  ManualsHelp_L("		in the format shown in Figure 5.35 as REDCLK.")
  ManualsHelp_L("")
  ManualsHelp_L("List 5.10 shows an example of this BIOS routine.")
  ManualsHelp_L("")
  ManualsHelp_L("List 5.10  Setting the prompt")
  ManualsHelp_L("=================================================================")
  ManualsHelp_L("")
  ManualsHelp_L(";************************************************")
  ManualsHelp_L(";")
  ManualsHelp_L(";  List 5.10  set prompt message")
  ManualsHelp_L(";")
  ManualsHelp_L(";************************************************")
  ManualsHelp_L(";")
  ManualsHelp_L("WRTCLK: EQU	01F9H")
  ManualsHelp_L("EXTROM: EQU	015FH")
  ManualsHelp_L("")
  ManualsHelp_L("	ORG	0B000H")
  ManualsHelp_L("")
  ManualsHelp_L(";----- program start -----	;Note:	Set prompt message for BASIC.")
  ManualsHelp_L("")
  ManualsHelp_L("START:	LD	C,00110000B	;address data")
  ManualsHelp_L("	LD	A,2		;ID := prompt mode")
  ManualsHelp_L("	CALL	WRTRAM		;write to back-up RAM")
  ManualsHelp_L("")
  ManualsHelp_L("	LD	B,6		;loop counter")
  ManualsHelp_L("	LD	HL,STRING	;prompt data")
  ManualsHelp_L("L01:	LD	A,(HL)		;read string data")
  ManualsHelp_L("	AND	0FH		;A := hi 4 bit")
  ManualsHelp_L("	INC	C		;increment address")
  ManualsHelp_L("	CALL	WRTRAM		;write data to back-up RAM")
  ManualsHelp_L("	LD	A,(HL)")
  ManualsHelp_L("	RRCA")
  ManualsHelp_L("	RRCA")
  ManualsHelp_L("	RRCA")
  ManualsHelp_L("	RRCA")
  ManualsHelp_L("	AND	0FH")
  ManualsHelp_L("	INC	C		;increment address")
  ManualsHelp_L("	CALL	WRTRAM		;write low 4 bits")
  ManualsHelp_L("	INC	HL")
  ManualsHelp_L("	DJNZ	L01")
  ManualsHelp_L("	RET")
  ManualsHelp_L("")
  ManualsHelp_L(";----- write data to back-up RAM -----")
  ManualsHelp_L("")
  ManualsHelp_L("WRTRAM: PUSH	HL")
  ManualsHelp_L("	PUSH	BC")
  ManualsHelp_L("	LD	IX,WRTCLK")
  ManualsHelp_L("	CALL	EXTROM		;use interslot call")
  ManualsHelp_L("	POP	BC")
  ManualsHelp_L("	POP	HL")
  ManualsHelp_L("	RET")
  ManualsHelp_L("")
  ManualsHelp_L(";----- string data -----")
  ManualsHelp_L("")
  ManualsHelp_L("STRING: DB	'Ready?'")
  ManualsHelp_L("")
  ManualsHelp_L("	END")
  ManualsHelp_L("")
  ManualsHelp_L("=================================================================")
  ManualsHelp_Commit("5. Acesso a Perifericos via BIOS (partes 1 a 6)", "MSX2 Technical Handbook")

  ManualsHelp_Begin()
