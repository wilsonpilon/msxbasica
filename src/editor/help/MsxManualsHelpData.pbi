  ManualsHelp_L("H.EVAL (FF70H)")
  ManualsHelp_L("  meaning:	BINTRP")
  ManualsHelp_L("")
  ManualsHelp_L("H.OKNO (FF75H)")
  ManualsHelp_L("  meaning:	BINTRP")
  ManualsHelp_L("")
  ManualsHelp_L("H.FING (FF7AH)")
  ManualsHelp_L("  meaning:	BINTRP")
  ManualsHelp_L("")
  ManualsHelp_L("H.ISMI (FF7FH)")
  ManualsHelp_L("  meaning:	BINTRP ISMID$ (MID$ or not)")
  ManualsHelp_L("")
  ManualsHelp_L("H.WIDT (FF84H)")
  ManualsHelp_L("  meaning:	BINTRP WIDTHS (WIDTH)")
  ManualsHelp_L("")
  ManualsHelp_L("H.LIST (FF89H)")
  ManualsHelp_L("  meaning:	BINTRP LIST")
  ManualsHelp_L("")
  ManualsHelp_L("H.BUFL (FF8EH)")
  ManualsHelp_L("  meaning:	BINTRP BUFLIN (buffer line)")
  ManualsHelp_L("")
  ManualsHelp_L("H.FRQI (FF93H)")
  ManualsHelp_L("  meaning:	BINTRP FRQINT")
  ManualsHelp_L("")
  ManualsHelp_L("H.SCNE (FF98H)")
  ManualsHelp_L("  meaning:	BINTRP")
  ManualsHelp_L("")
  ManualsHelp_L("H.FRET (FF9DH)")
  ManualsHelp_L("  meaning:	BINTRP FRETMP")
  ManualsHelp_L("")
  ManualsHelp_L("H.PTRG (FFA2H)")
  ManualsHelp_L("  meaning:	BIPTRG PTRGET (get pointer)")
  ManualsHelp_L("  purpose:	uses variable other than default value")
  ManualsHelp_L("")
  ManualsHelp_L("H.PHYD (FFA7H)")
  ManualsHelp_L("  meaning:	MSXIO PHYDIO (physical disk input-output)")
  ManualsHelp_L("  purpose:	connects disk device")
  ManualsHelp_L("")
  ManualsHelp_L("H.FORM (FFACH)")
  ManualsHelp_L("  meaning:	MSXIO FORMAT (format disk)")
  ManualsHelp_L("  purpose:	connects disk device")
  ManualsHelp_L("")
  ManualsHelp_L("H.ERRO (FFB1H)")
  ManualsHelp_L("  meaning:	BINTRP ERROR")
  ManualsHelp_L("  purpose:	error handling for application program")
  ManualsHelp_L("")
  ManualsHelp_L("H.LPTO (FFB6H)")
  ManualsHelp_L("  meaning:	MSXIO LPTOUT (printer output)")
  ManualsHelp_L("  purpose:	uses printer other than default value")
  ManualsHelp_L("")
  ManualsHelp_L("H.LPTS (FFBBH)")
  ManualsHelp_L("  meaning:	MSXIO LPTSTT (printer status)")
  ManualsHelp_L("  purpose:	uses printer other than default value")
  ManualsHelp_L("")
  ManualsHelp_L("H.SCRE (FFC0H)")
  ManualsHelp_L("  meaning:	MSXSTS SCREEN statement entry")
  ManualsHelp_L("  purpose:	expands SCREEN statement")
  ManualsHelp_L("")
  ManualsHelp_L("H.PLAY (FFC5H)")
  ManualsHelp_L("  meaning:	MSXSTS PLAY statement entry")
  ManualsHelp_L("  purpose:	expands PLAY statement")
  ManualsHelp_L("")
  ManualsHelp_L("* For expanded BIOS")
  ManualsHelp_L("")
  ManualsHelp_L("FCALL (FFCAH)")
  ManualsHelp_L("  contents:	hook used by expanded BIOS")
  ManualsHelp_L("")
  ManualsHelp_L("DISINT (FFCFH)")
  ManualsHelp_L("  contents:	used by DOS")
  ManualsHelp_L("")
  ManualsHelp_L("ENAINT (FFD4H)")
  ManualsHelp_L("  contents:	used by DOS")
  ManualsHelp_L("")
