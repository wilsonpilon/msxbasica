  ManualsHelp_L("")
  ManualsHelp_L("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-")
  ManualsHelp_L("")
  ManualsHelp_L("APPENDIX 6 - I/O MAP")
  ManualsHelp_L("")
  ManualsHelp_L("00H to 3FH	user defined")
  ManualsHelp_L("")
  ManualsHelp_L("40H to 7FH	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("80H to 87H	for RS-232C")
  ManualsHelp_L("      80H	8251 data")
  ManualsHelp_L("      81H	8251 status/command")
  ManualsHelp_L("      82H	status read/interrupt mask")
  ManualsHelp_L("      83H	unused")
  ManualsHelp_L("      84H	8253")
  ManualsHelp_L("      85H	8253")
  ManualsHelp_L("      86H	8253")
  ManualsHelp_L("      87H	8253")
  ManualsHelp_L("")
  ManualsHelp_L("88H to 8BH	VDP (9938) I/O port for MSX1 adaptor")
  ManualsHelp_L("		This is V9938 I/O for MSX1. To access VDP directly,")
  ManualsHelp_L("		examine 06H and 07H of MAIN-ROM to confirm the port")
  ManualsHelp_L("		address")
  ManualsHelp_L("")
  ManualsHelp_L("8CH to 8DH	for the modem")
  ManualsHelp_L("")
  ManualsHelp_L("8EH to 8FH	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("90H to 91H	printer port")
  ManualsHelp_L("      90H	bit 0: strobe output (write)")
  ManualsHelp_L("		bit 1: status input (read)")
  ManualsHelp_L("      91H	data to be printed")
  ManualsHelp_L("")
  ManualsHelp_L("92H to 97H	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("98H to 9BH	for MSX2 VDP (V9938)")
  ManualsHelp_L("      98H	VRAM access")
  ManualsHelp_L("      99H	command register access")
  ManualsHelp_L("      9AH	palette register access (write only)")
  ManualsHelp_L("      9BH	register pointer (write only)")
  ManualsHelp_L("")
  ManualsHelp_L("9CH to 9FH	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("A0H to A3H	sound generator (AY-3-8910)")
  ManualsHelp_L("      A0H	address latch")
  ManualsHelp_L("      A1H	data read")
  ManualsHelp_L("      A2H	data write")
  ManualsHelp_L("")
  ManualsHelp_L("A4H to A7H	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("A8H to ABH	parallel port (8255)")
  ManualsHelp_L("      A8H	port A")
  ManualsHelp_L("      A9H	port B")
  ManualsHelp_L("      AAH	port C")
  ManualsHelp_L("      ABH	mode set")
  ManualsHelp_L("")
  ManualsHelp_L("ACH to AFH	MSX engine (one chip MSX I/O)")
  ManualsHelp_L("")
  ManualsHelp_L("B0H to B3H	expansion memory (SONY specification) (8255)")
  ManualsHelp_L("      A8H	port A, address (A0 to A7)")
  ManualsHelp_L("      A9H	port B, address (A8 to A10, A13 to A15), control R/" + Chr(34))
  ManualsHelp_L("      AAH	port C, address (A11 to A12), data (D0 - D7)")
  ManualsHelp_L("      ABH	mode set")
  ManualsHelp_L("")
  ManualsHelp_L("B4H to B5H	CLOCK-IC (RP-5C01)")
  ManualsHelp_L("      B4H	address latch")
  ManualsHelp_L("      B5H	data")
  ManualsHelp_L("")
  ManualsHelp_L("B6H to B7H	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("B8H to BBH	lightpen control (SANYO specification)")
  ManualsHelp_L("      B8H	read/write")
  ManualsHelp_L("      B9H	read/write")
  ManualsHelp_L("      BAH	read/write")
  ManualsHelp_L("      BBH	write only")
  ManualsHelp_L("")
  ManualsHelp_L("BCH to BFH	VHD control (JVC) (8255)")
  ManualsHelp_L("      BCH	port A")
  ManualsHelp_L("      BDH	port B")
  ManualsHelp_L("      BEH	port C")
  ManualsHelp_L("")
  ManualsHelp_L("C0H to C1H	MSX-Audio")
  ManualsHelp_L("")
  ManualsHelp_L("C2H to C7H	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("C8H to CFH	MSX interface")
  ManualsHelp_L("")
  ManualsHelp_L("D0H to D7H	floppy disk controller (FDC)")
  ManualsHelp_L("		The floppy disk controller can be interrupted by an")
  ManualsHelp_L("		external signal. Interrupt is possible only when the")
  ManualsHelp_L("		FDC is accessed. Thus, the system can treat different")
  ManualsHelp_L("		FDC interfaces.")
  ManualsHelp_L("")
  ManualsHelp_L("D8 to D9H	kanji ROM (TOSHIBA specification)")
  ManualsHelp_L("     D8H	b5-b0		lower address (write only)")
  ManualsHelp_L("     D9H	b5-b0		upper address (write)")
  ManualsHelp_L("		b7-b0		data (read)")
  ManualsHelp_L("")
  ManualsHelp_L("DAH to DBH	for future kanji expansion")
  ManualsHelp_L("")
  ManualsHelp_L("DCH to F4H	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("F5H		system control (write only)")
  ManualsHelp_L("		setting bit to 1 enables available I/O devices")
  ManualsHelp_L("	b0	kanji ROM")
  ManualsHelp_L("	b1	reserved for kanji")
  ManualsHelp_L("	b2	MSX-AUDIO")
  ManualsHelp_L("	b3	superimpose")
  ManualsHelp_L("	b4	MSX interface")
  ManualsHelp_L("	b5	RS-232C")
  ManualsHelp_L("	b6	lightpen")
  ManualsHelp_L("	b7	CLOCK-IC (only on MSX2)")
  ManualsHelp_L("		Bits to void the conflict between internal I/O")
  ManualsHelp_L("		devices or those connected by cartridge. The bits")
  ManualsHelp_L("		can disable the internal devices. When BIOS is initialised,")
  ManualsHelp_L("		internal devices are valid if no external devices are")
  ManualsHelp_L("		connected. Applications may not write to or read from here.")
  ManualsHelp_L("")
  ManualsHelp_L("F8H		colour bus I/O")
  ManualsHelp_L("")
  ManualsHelp_L("F7H		A/V control")
  ManualsHelp_L("	b0	audio R 		mixing ON (write)")
  ManualsHelp_L("	b1	audio L 		mixing OFF (write)")
  ManualsHelp_L("	b2	select video input	21p RGB (write)")
  ManualsHelp_L("	b3	detect video input	no input (read)")
  ManualsHelp_L("	b4	AV control		TV (write)")
  ManualsHelp_L("	b5	Ym control		TV (write)")
  ManualsHelp_L("	b6	inverse of bit 4 of VDP register 9 (write)")
  ManualsHelp_L("	b7	inverse of bit 5 of VDP register 9 (write)")
  ManualsHelp_L("")
  ManualsHelp_L("F8H to FBH	reserved")
  ManualsHelp_L("")
  ManualsHelp_L("FCH to FFH	memory mapper")
  ManualsHelp_L("")
  ManualsHelp_L("=============================================================================")
  ManualsHelp_L("")
  ManualsHelp_L("Changes from the original in APPENDIX 8:")
  ManualsHelp_L("")
  ManualsHelp_L("none")
  ManualsHelp_L("")
  ManualsHelp_L("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-")
  ManualsHelp_L("")
  ManualsHelp_L("APPENDIX 8 - CONTROL CODES")
  ManualsHelp_L("")
  ManualsHelp_L("-------------------------------------------------------------------------")
  ManualsHelp_L("| Code | Code | 				  |    Corresponding	|")
  ManualsHelp_L("| (dec)| (hex)| 	    Function		  |	   key(s)	|")
  ManualsHelp_L("|------+------+-----------------------------------+---------------------|")
  ManualsHelp_L("|   0  |  00H | 				  | CTRL + @		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   1  |  01H | header at input/output of graphic | CTRL + A		|")
  ManualsHelp_L("|      |      | characters			  |			|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   2  |  02H | move cursor to the top of the	  | CTRL + B		|")
  ManualsHelp_L("|      |      | previous word			  |			|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   3  |  03H | end the input-waiting state	  | CTRL + C		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   4  |  04H | 				  | CTRL + D		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   5  |  05H | delete below cursor		  | CTRL + E		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   6  |  06H | move cursor to the top of the	  | CTRL + F		|")
  ManualsHelp_L("|      |      | next word			  |			|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   7  |  07H | speaker output			  | CTRL + G		|")
  ManualsHelp_L("|      |      | (same as the BEEP statement)	  |			|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   8  |  08H | delete a character before cursor  | CTRL + H or BS	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|   9  |  09H | move to next horizontal tab stop  | CTRL + I or TAB	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  10  |  0AH | line feed			  | CTRL + J		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  11  |  0BH | home cursor			  | CTRL + K or HOME	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  12  |  0CH | clear screen and home cursor	  | CTRL + L or CLS	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  13  |  0DH | carriage return 		  | CTRL + M or RETURN	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  14  |  0EH | move cursor to the end of line	  | CTRL + N		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  15  |  0FH | 				  | CTRL + O		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  16  |  10H | 				  | CTRL + P		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  17  |  11H | 				  | CTRL + Q		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  18  |  12H | insert mode ON/OFF		  | CTRL + R or INS	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  19  |  13H | 				  | CTRL + S		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  20  |  14H | 				  | CTRL + T		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  21  |  15H | delete one line from screen	  | CTRL + U		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  22  |  16H | 				  | CTRL + V		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  23  |  17H | 				  | CTRL + W		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  24  |  18H | 				  | CTRL + X or SELECT	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  25  |  19H | 				  | CTRL + Y		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  26  |  1AH | 				  | CTRL + Z		|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  27  |  1BH | 				  | CTRL + [ or ESC	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  28  |  1CH | move cursor right		  | CTRL + \ or RIGHT	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  29  |  1DH | move cursor left		  | CTRL + ] or LEFT	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  30  |  1EH | move cursor up			  | CTRL + ^ or UP	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("|  31  |  1FH | move cursor down		  | CTRL + _ or DOWN	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("| 127  |  7FH | delete character under cursor	  |		DEL	|")
  ManualsHelp_L("|      |      | 				  |			|")
  ManualsHelp_L("-------------------------------------------------------------------------")
  ManualsHelp_L("")
