  ManualsHelp_L("NOTELX (+16, 1)")
  ManualsHelp_L("  contents:	area to set tone length")
  ManualsHelp_L("")
  ManualsHelp_L("TEMPOX (+17, 1)")
  ManualsHelp_L("  contents:	area to set tempo")
  ManualsHelp_L("")
  ManualsHelp_L("VOLUMX (+18, 1)")
  ManualsHelp_L("  contents:	area to set volume")
  ManualsHelp_L("")
  ManualsHelp_L("ENVLPX (+19, 14)")
  ManualsHelp_L("  contents:	area to set enveloppe wave form")
  ManualsHelp_L("")
  ManualsHelp_L("MCLSTX (+33, 3)")
  ManualsHelp_L("  contents:	reservation area of stack")
  ManualsHelp_L("")
  ManualsHelp_L("MCLSEX (+36, 1)")
  ManualsHelp_L("  contents:	initialisation stack")
  ManualsHelp_L("")
  ManualsHelp_L("VCBSIZ (+37, 1)")
  ManualsHelp_L("  contents:	static buffer size")
  ManualsHelp_L("")
  ManualsHelp_L("* Voice static data area")
  ManualsHelp_L("")
  ManualsHelp_L("VCBA (FB41H, 37)")
  ManualsHelp_L("  contents:	static data for voice 0")
  ManualsHelp_L("")
  ManualsHelp_L("VCBB (FB66H, 37)")
  ManualsHelp_L("  contents:	static data for voice 1")
  ManualsHelp_L("")
  ManualsHelp_L("VCBC (FB8BH, 37)")
  ManualsHelp_L("  contents:	static data for voice 2")
  ManualsHelp_L("")
  ManualsHelp_L("* Data area")
  ManualsHelp_L("")
  ManualsHelp_L("ENSTOP (FBB0H, 1)")
  ManualsHelp_L("  contents:	flag to enable warm start by [SHIFT+Ctrl+Kana key]")
  ManualsHelp_L("		(0 = disable, otherwise enable)")
  ManualsHelp_L("")
  ManualsHelp_L("BASROM (FBB1H, 1)")
  ManualsHelp_L("  contents:	indicates BASIC text location (0 = on RAM, otherwise in ROM)")
  ManualsHelp_L("")
  ManualsHelp_L("LINTTB (FBB2H, 24)")
  ManualsHelp_L("  contents:	line terminal table; area to keep information about")
  ManualsHelp_L("		each line of text screen")
  ManualsHelp_L("")
  ManualsHelp_L("FSTPOS (FBCAH, 2)")
  ManualsHelp_L("  contents:	first character location of line from INLIN (00B1H) of BIOS")
  ManualsHelp_L("")
  ManualsHelp_L("CODSAV (FBCCH, 1)")
  ManualsHelp_L("  contents:	area to reserve the character where the cursor is stacked")
  ManualsHelp_L("")
  ManualsHelp_L("FNKSW1 (FBCDH, 1)")
  ManualsHelp_L("  contents:	indicates which function key is displayed at KEY ON")
  ManualsHelp_L("		(1 = F1 to F5 is displayed, 0 = F6 to F10 is displayed)")
  ManualsHelp_L("")
  ManualsHelp_L("FNKFLG (FBCEH, 10)")
  ManualsHelp_L("  contents:	area to allow, inhibit, or stop the execution of the line")
  ManualsHelp_L("		defined in ON KEY GOSUB statement, or to reserve it for each")
  ManualsHelp_L("		function key; set by KEY(n)ON/OFF/STOP statement")
  ManualsHelp_L("		(0 = KEY(n)OFF/STOP, 1= KEY(n)ON)")
  ManualsHelp_L("")
  ManualsHelp_L("ONGSBF (FBD8H, 1)")
  ManualsHelp_L("  contents:	flag to indicate whether event waiting in TRPTBL (FC4CH)")
  ManualsHelp_L("		occurred")
  ManualsHelp_L("")
  ManualsHelp_L("CLIKFL (FBD9H, 1)")
  ManualsHelp_L("  contents:	key click flag")
  ManualsHelp_L("")
  ManualsHelp_L("OLDKEY (FBDAH, 11)")
  ManualsHelp_L("  contents:	key matrix status (old)")
  ManualsHelp_L("")
  ManualsHelp_L("NEWKEY (FBE5H, 11)")
  ManualsHelp_L("  contents:	key matrix status (new)")
  ManualsHelp_L("")
  ManualsHelp_L("KEYBUF (FBF0H, 40)")
  ManualsHelp_L("  contents:	key code buffer")
  ManualsHelp_L("")
  ManualsHelp_L("LINWRK (FC18H, 40)")
  ManualsHelp_L("  contents:	temporary reservation location used by screen handler")
  ManualsHelp_L("")
  ManualsHelp_L("PATWRK (FC40H, 8)")
  ManualsHelp_L("  contents:	temporary reservation location used by pattern converter")
  ManualsHelp_L("")
  ManualsHelp_L("BOTTOM (FC48H, 2)")
  ManualsHelp_L("  contents:	installed RAM starting (low) address; ordinarily 8000H")
  ManualsHelp_L("		in MSX2")
  ManualsHelp_L("")
  ManualsHelp_L("HIMEM (FC4AH, 2)")
  ManualsHelp_L("  contents:	highest address of available memory; set by <memory upper")
  ManualsHelp_L("		limit> of CLEAR statement")
  ManualsHelp_L("")
  ManualsHelp_L("TRAPTBL (FC4CH, 78)")
  ManualsHelp_L("  contents:	trap table used to handle interrupt; one table consists of")
  ManualsHelp_L("		three bytes, where first byte indicates ON/OFF/STOP status")
  ManualsHelp_L("		and the rest indicate the text address to be jumped to")
  ManualsHelp_L("")
  ManualsHelp_L("		FC4CH to FC69H (3 * 10 bytes)	used in ON KEY GOSUB")
  ManualsHelp_L("		FC6AH to FC6CH (3 * 1 byte)	used in ON STOP GOSUB")
  ManualsHelp_L("		FC6DH to FC6FH (3 * 1 byte)	used in ON SPRITE GOSUB")
  ManualsHelp_L("		FC70H to FC7EH (3 * 5 bytes)	used in ON STRIG GOSUB")
  ManualsHelp_L("		FC7FH to FC81H (3 * 1 byte)	used in ON INTERVAL GOSUB")
  ManualsHelp_L("		FC82H to FC99H			for expansion")
  ManualsHelp_L("")
  ManualsHelp_L("RTYCNT (FC9AH, 1)")
  ManualsHelp_L("  contents:	used internally by BASIC")
  ManualsHelp_L("")
  ManualsHelp_L("INTFLG (FC9BH, 1)")
  ManualsHelp_L("  contents:	if Ctrl+STOP is pressed, setting 03H here causes a stop")
  ManualsHelp_L("")
  ManualsHelp_L("PADY (FC9CH, 1)")
  ManualsHelp_L("  contents:	Y-coordinate of the paddle)")
  ManualsHelp_L("")
  ManualsHelp_L("PADX (FC9DH, 1)")
  ManualsHelp_L("  contents:	X-coordinate of the paddle)")
  ManualsHelp_L("")
  ManualsHelp_L("JIFFY (FC9EH, 2)")
  ManualsHelp_L("  contents:	used internally by PLAY statement")
  ManualsHelp_L("")
  ManualsHelp_L("INTVAL (FCA0H, 2)")
  ManualsHelp_L("  contents:	interval period; set by ON INTERVAL GOSUB statement")
  ManualsHelp_L("")
  ManualsHelp_L("INTCNT (FCA2H, 2)")
  ManualsHelp_L("  contents:	counter for interval")
  ManualsHelp_L("")
  ManualsHelp_L("LOWLIM (FCA4H, 1)")
  ManualsHelp_L("  contents:	used during reading from cassette tape")
  ManualsHelp_L("")
  ManualsHelp_L("WINWID (FCA5H, 1)")
  ManualsHelp_L("  contents:	used during reading from cassette tape")
  ManualsHelp_L("")
  ManualsHelp_L("GRPHED (FCA6H, 1)")
  ManualsHelp_L("  contents:	flag to send graphic character (1 = graphic character,")
  ManualsHelp_L("		0 = normal character)")
  ManualsHelp_L("")
  ManualsHelp_L("ESCCNT (FCA7H, 1)")
  ManualsHelp_L("  contents:	area to count from escape code")
  ManualsHelp_L("")
  ManualsHelp_L("INSFLG (FCA8H, 1)")
