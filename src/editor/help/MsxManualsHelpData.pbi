  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|cmp         |.a-[.hl];.hl<-.hl+1         |+ + + +   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|  .a,[.hl++]|.bc<-.bc-1                  |  *2  *1     |10100001|A1 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|cmp         |.a-[.hl];.hl<-.hl-1         |+ + + +   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|  .a,[.hl--]|.bc<-.bc-1                  |  *2  *1     |10101001|A9 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|cmpm        |repeat;.a-[.hl];.hl<-.hl+1  |+ + + +   1 •|11101101|ED |2|5|")
  ManualsHelp_L("|   .a,[hl++]|.bc<-.bc-1;until .bc=0      |  *2  *1     |10110001|B1 | | |")
  ManualsHelp_L("|            |  or .a=[.hl]               |             |        |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|cmpm        |repeat;.a-[.hl];.hl<-.hl-1  |+ + + +   1 •|11101101|ED |2|5|")
  ManualsHelp_L("|   .a,[hl--]|.bc<-.bc-1;until .bc=0      |  *2  *1     |10111001|B9 | | |")
  ManualsHelp_L("|            |  or .a=[.hl]               |             |        |   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L(" *1 when bc-1=0 it will be set to 0 else it will be set to 1")
  ManualsHelp_L(" *2 when .a=[.hl] it will be set to 1 else it will be set to 0")
