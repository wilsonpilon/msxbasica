  ManualsHelp_L("		 |			|  | |	| |  | | |  | |  | |  | |  |:")
  ManualsHelp_L("Joystick x 2 --> | RAM 64K		|  | |	| |  | | |  | |  | |  | |  |:")
  ManualsHelp_L("		 |			|  | |	| |  | | |  | |  | |  | |  |:")
  ManualsHelp_L("Trackball,	 | VDP(V9938) VRAM 128K ---- ---- ---- +:---- ---- ---- ----:")
  ManualsHelp_L("mouse, etc	 |				       |:::::::::::::::::::::")
  ManualsHelp_L("		 | PPI	 PSG			       |")
