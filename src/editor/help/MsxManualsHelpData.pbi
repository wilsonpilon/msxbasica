  ManualsHelp_L("A.16 CALL INSTRUCTIONS")
  ManualsHelp_L("")
  ManualsHelp_L("+------------+----------------------------+-------------+------------+-+-+")
  ManualsHelp_L("|MNEMONIC    | INSTRUCTION ACTION         | FLAGS       | OPCODE     | | |")
  ManualsHelp_L("|            |                            |             +--------+---+ | |")
  ManualsHelp_L("|            |                            |S Z H P/v N C|76543210|HEX|B|C|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call nn     |[.sp-2]<-.spl;[.sp-1]<-.sph |• • • •   • •|11001101|CD |3|5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call nz,nn  |if z=0                      |• • • •   • •|11000100|C4 |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call z,nn   |if z=1                      |• • • •   • •|11001100|CC |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call nc,nn  |if c=0                      |• • • •   • •|11010100|D4 |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call c,nn   |if c=1                      |• • • •   • •|11011100|DC |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call po,nn  |if P/v=0                    |• • • •   • •|11100100|E4 |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call pe,nn  |if P/v=1                    |• • • •   • •|11101100|EC |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call p,nn   |if s=0                      |• • • •   • •|11110100|F4 |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|call m,nn   |if s=1                      |• • • •   • •|11111100|FC |3|3|")
  ManualsHelp_L("|            |[.sp-2]<-.pcl;[.sp-1]<-.pch |             |<-nnl ->|   | |5|")
  ManualsHelp_L("|            |.sp<-.sp-2;.pc<-nn          |             |<-nnh ->|   | | |")
