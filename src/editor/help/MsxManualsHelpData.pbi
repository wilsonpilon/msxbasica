  ManualsHelp_L("A.17      INOUT/OUTPUT INSTRUCTIONS")
  ManualsHelp_L("+------------+----------------------------+-------------+------------+-+-+")
  ManualsHelp_L("|MNEMONIC    | INSTRUCTION ACTION         | FLAGS       | OPCODE     | | |")
  ManualsHelp_L("|            |                            |             +--------+---+ | |")
  ManualsHelp_L("|            |                            |S Z H P/v N C|76543210|HEX|B|C|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|in .a,[n]   |.a<-[n]                     |• • • •   • •|11011011|DB |2|3|")
  ManualsHelp_L("|            |                            |             |<- n  ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|in r,[.c]   |r<-[.c]                     |+ + 0 P   0 •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01 r 000|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|in .f,[.c]  |.f<-[.c]                    |+ + 0 P   0 •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01110000|70 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|in          |[.hl]<-[.c];.b<-.b-1        |? + ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.hl++],[.c]|.hl<-.hl+1                  |  *1         |10100010|A2 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|in          |[.hl]<-[.c];.b<-.b-1        |? + ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.hl--],[.c]|.hl<-.hl-1                  |  *1         |10101010|AA | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|inm         |repeat;[.hl]<-[.c];.b<-.b-1 |? 1 ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.hl++],[.c]|.hl<-.hl+1;until .b=0       |             |10110010|B2 | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|inm         |repeat;[.hl]<-[.c];.b<-.b-1 |? 1 ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.hl--],[.c]|.hl<-.hl-1;until .b=0       |             |10111010|BA | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|out [n],.a  |[n]<-.a                     |• • • •   • •|11010011|D3 |2|3|")
  ManualsHelp_L("|            |                            |             |<- n  ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|out [.c],r  |[.c]<-r                     |• • • •   • •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01 r 001|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|out         |[.c]<-[.hl];.b<-.b-1        |? + ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.c],[.hl++]|.hl<-.hl+1                  |  *1         |10100011|A3 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|out         |[.c]<-[.hl];.b<-.b-1        |? + ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.c],[.hl--]|.hl<-.hl-1                  |  *1         |10101011|AB | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|outm        |repeat;[.c]<-[.hl];.b<-.b-1 |? 1 ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.c],[.hl++]|.hl<-.hl+1;until .b=0       |             |10110011|B3 | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|outm        |repeat;[.c]<-[.hl];.b<-.b-1 |? 1 ? ?   1 •|11101101|ED |2|4|")
  ManualsHelp_L("|[.c],[.hl--]|.hl<-.hl-1;until .b=0       |             |10111011|BB | |3|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("*1 als .b-1=0 it is set to 1 else it is 0")
  ManualsHelp_L("dependent of the external port which the .c register of in.f,[.c] desginates,")
  ManualsHelp_L("flags will be changed. It doesn't matter where the external port is.(???)")
  ManualsHelp_L("<A.18 CPU CONTROL INSTRUCTIONS                                          679>")
  ManualsHelp_L("")
  ManualsHelp_L("A.18  CPU CONTROL INSTRUCTIONS")
  ManualsHelp_L("+------------+----------------------------+-------------+------------+-+-+")
  ManualsHelp_L("|MNEMONIC    | INSTRUCTION ACTION         | FLAGS       | OPCODE     | | |")
  ManualsHelp_L("|            |                            |             +--------+---+ | |")
  ManualsHelp_L("|            |                            |S Z H P/v N C|76543210|HEX|B|C|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|adj .a      |adjust to decimal           |+ + + P   • +|00100111|27 |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|not .a      |.a<-NOT .a                  |• • 1 •   1 •|00101111|2F |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|neg .a      |.a<-NOT .a+1                |+ + + V   1 +|11101101|ED |2|2|")
  ManualsHelp_L("|            |                            |             |01000100|44 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|not c       |C<-NOT C                    |• • ? •   0 +|00111111|3F |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|set c       |C<-1                        |• • 0 •   0 1|00110111|37 |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|nop         |NO operation                |• • • •   • •|00000000|00 |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|halt        |HALT                        |• • • •   • •|01110110|76 |1|2|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|di          |IFF<-0                      |• • • •   • •|11110011|F3 |1|2|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|ei          |IFF<-1                      |• • • •   • •|11111011|FB |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|im 0        |interrupt mode 0            |• • • •   • •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01000110|46 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|im 1        |interrupt mode 1            |• • • •   • •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01010110|56 | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|im 2        |interrupt mode 2            |• • • •   • •|11101101|ED |2|3|")
  ManualsHelp_L("|            |                            |             |01011110|5E | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("<680                                                                    >")
  ManualsHelp_L("<681                                                                    >")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("                                B")
  ManualsHelp_L("                       R800 MULTIPLICATION MACRO")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("B.1 MULTIPLICATION INSTRUCTIONS OF THE R800")
  ManualsHelp_L("  The following multiplication instructions are available.")
  ManualsHelp_L("")
  ManualsHelp_L("B.1.1   8 bit MULTIPLICATIONS")
  ManualsHelp_L("  Two of the same kind 8 bit registers are filled and the result appears in ")
  ManualsHelp_L("register HL. The multiplication is performed with an instruction.")
  ManualsHelp_L("The instruction are shown below.")
  ManualsHelp_L("----------------------------------------------------------------------------")
  ManualsHelp_L("operation     instruction          clock cycles")
  ManualsHelp_L("----------------------------------------------------------------------------")
  ManualsHelp_L("HL<-A*B         ED C1                   14")
  ManualsHelp_L("HL<-A*C         ED C9                   14")
  ManualsHelp_L("HL<-A*D         ED D1                   14")
  ManualsHelp_L("HL<-A*E         ED D9                   14")
  ManualsHelp_L("---------------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("B.1.2    16 bit MULTIPLICATIONS")
  ManualsHelp_L("  Two of the same kind 16 bit registers are filled and the result appears in")
  ManualsHelp_L("registers DE:HL. The multiplication is performed with an instruction.")
  ManualsHelp_L("The instruction are shown below.")
  ManualsHelp_L("----------------------------------------------------------------------------")
  ManualsHelp_L("operation     instruction          clock cycles")
  ManualsHelp_L("----------------------------------------------------------------------------")
  ManualsHelp_L("DE:HL<-HL*BC    ED C3                   36")
  ManualsHelp_L("DE:HL<-HL*SP    ED F3                   36")
  ManualsHelp_L("----------------------------------------------------------------------------")
  ManualsHelp_L("<682                                    APPENDIX A R800 INSTRCUCTION CHART>")
  ManualsHelp_L("")
  ManualsHelp_L("B.2      MULTIPLICATION MACRO FOR M80")
  ManualsHelp_L("")
  ManualsHelp_L("When using multiplications in M80, this macro can be used.")
  ManualsHelp_L("")
  ManualsHelp_L("         mult8  macro  reg")
  ManualsHelp_L("                ifidn <reg>,<b>")
  ManualsHelp_L("                defb 0edh,0c1h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<B>")
  ManualsHelp_L("                defb 0edh,0c1h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<c>")
  ManualsHelp_L("                defb 0edh,0c9h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<C>")
  ManualsHelp_L("                defb 0edh,0c9h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<d>")
  ManualsHelp_L("                defb 0edh,0d1h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<D>")
  ManualsHelp_L("                defb 0edh,0d1h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<e>")
  ManualsHelp_L("                defb 0edh,0d9h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<E>")
  ManualsHelp_L("                defb 0edh,0d9h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                if1")
  ManualsHelp_L("                .printx *MULT8: illegal argument*")
  ManualsHelp_L("                defb 00h,00h")
  ManualsHelp_L("                err")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endif")
  ManualsHelp_L("                endm")
  ManualsHelp_L("")
  ManualsHelp_L("         mult16 macro  reg")
  ManualsHelp_L("                ifidn <reg>,<bc>")
  ManualsHelp_L("                defb   0edh, 0c3h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<BC>")
  ManualsHelp_L("                defb   0edh,0c3h")
  ManualsHelp_L("                else")
  ManualsHelp_L("<B.2 MULTIPLICATION MACRO FOR M80                                       683>")
  ManualsHelp_L("                ifidn <reg>,<sp>")
  ManualsHelp_L("                defb   0edh, 0f3h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                ifidn <reg>,<SP>")
  ManualsHelp_L("                defb   0edh,0f3h")
  ManualsHelp_L("                else")
  ManualsHelp_L("                if1")
  ManualsHelp_L("                .printx *MULT16: illegal argument*")
  ManualsHelp_L("                defb    00h, 00h")
  ManualsHelp_L("                err")
  ManualsHelp_L("                end if")
  ManualsHelp_L("                end if")
  ManualsHelp_L("                end if")
  ManualsHelp_L("                end if")
  ManualsHelp_L("                end if")
  ManualsHelp_L("                endm")
  ManualsHelp_L("<684                                                                    >")
  ManualsHelp_L("<                                                                    685>")
  ManualsHelp_Commit("R800 - Instrucoes", "R800")

  ManualsHelp_Begin()
  ManualsHelp_L("picture 1.2  execution-comparison of the MSX Turbo R and MSX2+")
  ManualsHelp_L("-----------------------------------------------------------------------------")
  ManualsHelp_L(" INSTRUCTION    MSX2+(in u.sec) MSX Turbo R(in u.sec)   FACTOR")
  ManualsHelp_L("-----------------------------------------------------------------------------")
  ManualsHelp_L("LD     r,s      1.40            0.14                    x 10.0")
  ManualsHelp_L("LD     r,(HL)   2.23            0.42                    x 5.3")
  ManualsHelp_L("LD     r,(IX+n) 5.87            0.70                    x 8.4")
  ManualsHelp_L("PUSH   qq       3.35            0.56                    x 6.0")
  ManualsHelp_L("LDIR   (BC<>0)  6.43            0.98                    x 6.6")
  ManualsHelp_L("ADD    A,r      1.40            0.14                    x 10.0")
  ManualsHelp_L("INC    r        1.40            0.14                    x 10.0")
  ManualsHelp_L("ADD    HL,ss    3.35            0.14                    x 24.0")
  ManualsHelp_L("INC    ss       1.96            0.14                    x 14.0")
  ManualsHelp_L("JP              3.07            0.42                    x 7.3")
  ManualsHelp_L("JR              3.63            0.42                    x 8.7")
  ManualsHelp_L("DJNZ   (B<>0)   3.91            0.42                    x 9.3")
  ManualsHelp_L("CALL            5.03            0.84                    x 6.0")
  ManualsHelp_L("RET             3.07            0.56                    x 5.5")
  ManualsHelp_L("MULTU  A,r      160             1.96                    x 82")
  ManualsHelp_L("MULTUW HL,rr    361             5.03                    x 71")
  ManualsHelp_L("-----------------------------------------------------------------------------")
  ManualsHelp_Commit("R800 - Especifico MSX", "R800")

  ManualsHelp_Begin()
  ManualsHelp_L("MSX-BASIC-KUN (BASIC COMPILER)")
  ManualsHelp_L("")
  ManualsHelp_L("	by J.Suzuki 1989")
  ManualsHelp_L("	this document & samples by Sho Endo")
  ManualsHelp_L("	translate to english by LASP")
  ManualsHelp_L("	this text file typed without changes by Nestor Soriano")
  ManualsHelp_L("")
  ManualsHelp_L("MSX-BASIC-KUN is an incredible BASIC compiler. It will compile a BASIC ")
  ManualsHelp_L("program on memory in few seconds and execute it 15 to 100 times faster!! It ")
  ManualsHelp_L("can compile most of the statements and functions of MSX-BASIC and can handle ")
  ManualsHelp_L("strings and floating numbers. Once you see it, you'd feel you'd never need to ")
  ManualsHelp_L("learn the Z-80 machine language. Real time games, C.G., demo programs can be ")
  ManualsHelp_L("written by the ease of BASIC for machine language speed.")
  ManualsHelp_L("")
  ManualsHelp_L("*** USAGE ***")
  ManualsHelp_L("")
  ManualsHelp_L("1. Settings & General knowledge")
  ManualsHelp_L("")
  ManualsHelp_L("This compiler is sold in Japan as a cartridge for 4500 yen. You just set it ")
  ManualsHelp_L("in a slot to use it. Also, you can found this compiler in MSX2+ Sanyo ")
  ManualsHelp_L("machines, in ROM.")
  ManualsHelp_L("")
  ManualsHelp_L("Now you are in BASIC mode as usual, except that two commands are available:")
  ManualsHelp_L("")
  ManualsHelp_L("CALL RUN")
  ManualsHelp_L("CALL TURBO ON/OFF")
  ManualsHelp_L("")
  ManualsHelp_L(Chr(34) + "CALL" + Chr(34) + " can be written as " + Chr(34) + "_" + Chr(34) + " (underscore). I will ise that from now on.")
  ManualsHelp_L("")
  ManualsHelp_L("_RUN is the command to compile and execute the entire program on memory. If ")
  ManualsHelp_L("it finds an error it will stop and yield the message.")
  ManualsHelp_L("")
  ManualsHelp_L("_TURBO ON is the statement to define the beginning of the turbo block.")
  ManualsHelp_L("_TURBO OFF is the end of the block.")
  ManualsHelp_L("")
  ManualsHelp_L("The turbo block is the part of the program you want to execute fast. When the ")
  ManualsHelp_L("entire program contains some uncompilable statements, you can define the ")
  ManualsHelp_L("block to be compiled using this set.")
  ManualsHelp_L("")
  ManualsHelp_L("	EXAMPLE")
  ManualsHelp_L("")
  ManualsHelp_L("	100 SCREEN 8:DEFINT A-Z")
  ManualsHelp_L("	110 BLOAD" + Chr(34) + "PICTURE" + Chr(34) + ",S")
  ManualsHelp_L("	120 _TURBO ON")
  ManualsHelp_L("	130 FOR X=0 TO 255")
  ManualsHelp_L("	140 LINE(X,0)-(X,211),0")
  ManualsHelp_L("	150 NEXT X")
  ManualsHelp_L("	160 _TURBO OFF")
  ManualsHelp_L("	170 GOTO 170")
  ManualsHelp_L("")
  ManualsHelp_L("This program cannot be " + Chr(34) + "_RUN" + Chr(34) + ", because the " + Chr(34) + "BLOAD" + Chr(34) + " is one of the commands ")
  ManualsHelp_L("that cannot be compiled. If you " + Chr(34) + "RUN" + Chr(34) + " this, the part lines 130 through 150 ")
  ManualsHelp_L("will be executed fast.")
  ManualsHelp_L("")
  ManualsHelp_L("As '_RUN" + Chr(34) + "FILE" + Chr(34) + "' is not supported, you have to add _TURBO ON and _TURBO OFF at ")
  ManualsHelp_L("the beginning and the end if you want to RUN" + Chr(34) + "FILE" + Chr(34) + " and have the effect.")
  ManualsHelp_L("")
  ManualsHelp_L("	100 FOR I=0 TO 999")
  ManualsHelp_L("	110 ...")
  ManualsHelp_L("	 .")
  ManualsHelp_L("	 .")
  ManualsHelp_L("	 .")
  ManualsHelp_L("	890 'END OF THE PROGRAM")
  ManualsHelp_L("")
  ManualsHelp_L("So, this can be _RUN or add 10 _TURBO ON and 900 _TURBO OFF and RUN" + Chr(34) + "FILE" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("If you _RUN a program containing " + Chr(34) + "_TURBO ON/OFF" + Chr(34) + " it will be an error.")
  ManualsHelp_L("")
  ManualsHelp_L("_TURBO ON/OFF can not be written in a multi-statement lines.")
  ManualsHelp_L("")
  ManualsHelp_L("_TURBO ON/OFF can not be nested. But you may have many closed blocks in a ")
  ManualsHelp_L("program.")
  ManualsHelp_L("")
  ManualsHelp_L("Variables and arrays are handled differently in and outside of the blocks. ")
  ManualsHelp_L("Once you are out of the block, variables and arrays used in the block are ")
  ManualsHelp_L("lost. Only, the integer types can be defined as common.")
  ManualsHelp_L("")
  ManualsHelp_L("	100 DEFINT A-Z:DIM C(2),D(2)")
  ManualsHelp_L("	110 A=1:B=2:C(0)=3:D(0)=4")
  ManualsHelp_L("	120 _TURBO ON(A,C())")
  ManualsHelp_L("	130 DIM D(2)")
  ManualsHelp_L("	140 PRINT A,B,C(0),D(0)")
  ManualsHelp_L("	150 A=5:B=6:C(0)=7:D(0)=8")
  ManualsHelp_L("	160 _TURBO OFF")
  ManualsHelp_L("	170 PRINT A,B,C(0),D(0)")
  ManualsHelp_L("")
  ManualsHelp_L("	RUN")
  ManualsHelp_L("	 1 0 3 0")
  ManualsHelp_L("	 5 2 7 4")
  ManualsHelp_L("	Ok")
  ManualsHelp_L("")
  ManualsHelp_L("Floating numbers used by the compiler is a special format 3-byte value. It's ")
  ManualsHelp_L("accuracy is about 4.5 digits. Double precision is not available.")
  ManualsHelp_L("")
  ManualsHelp_L("An array must be declared by a constant in the beginning.")
  ManualsHelp_L("")
  ManualsHelp_L("This compiler works on the BASIC program on the RAM and creates the objects ")
  ManualsHelp_L("and variables on the left RAM. So there is a limit of the size of the source ")
  ManualsHelp_L("program about 10K. Big arrays, string variables (each uses 256 byte), CLEAR ")
  ManualsHelp_L("???,&H???? will make the situation tighter as you can imagine. The compiled ")
  ManualsHelp_L("objects can not be saved as independent programs.")
  ManualsHelp_L("")
  ManualsHelp_L("Interrupts available, such as KEY(1) ON, OFF etc. But it will decrease the ")
  ManualsHelp_L("efficiency of the executed object's size & speed.")
  ManualsHelp_L("")
  ManualsHelp_L("Some statements may not work correctly.")
  ManualsHelp_L("")
  ManualsHelp_L("	100 GOTO 130")
  ManualsHelp_L("	110 A=3/2")
  ManualsHelp_L("	120 END")
  ManualsHelp_L("	130 DEFINT A-Z")
  ManualsHelp_L("	140 GOTO 110")
  ManualsHelp_L("")
  ManualsHelp_L("If you RUN this, A is 1. If you _RUN this, A is 1.5. DEF??? will be effective ")
  ManualsHelp_L("when encountered during the execution in the case of interpreter, while it ")
  ManualsHelp_L("depends on the order of line number in the other case.")
  ManualsHelp_L("")
  ManualsHelp_L("A little complicated string operation may cause easily a " + Chr(34) + "String formula too ")
  ManualsHelp_L("complex" + Chr(34) + " error. As this compiler has only one level of stack for it. Break a ")
  ManualsHelp_L("long string formula into multiple small ones, if so.")
  ManualsHelp_L("")
  ManualsHelp_L("If you _RUN an endless program, you can not stop it. Make a part to check ")
  ManualsHelp_L("keyboards.")
  ManualsHelp_L("")
  ManualsHelp_L("	100 GOTO 100 'Reset or power off to stop")
  ManualsHelp_L("")
  ManualsHelp_L("	100 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 100")
  ManualsHelp_L("	110 END")
  ManualsHelp_L("	is better.")
  ManualsHelp_L("")
  ManualsHelp_L("2. Difference from MSX-BASIC interpreter")
  ManualsHelp_L("")
  ManualsHelp_L("List of statements, commands and functions that can not be compiled.")
  ManualsHelp_L("")
  ManualsHelp_L("AUTO, BASE, BLOAD, BSAVE, CALL, CDBL, CINT, CLEAR, CLOAD, CLOAD?, CLOSE, ")
  ManualsHelp_L("CONT, CSAVE, CSNG, CVD, CVI, CVS, DEFFN, DELETE, DRAW, DSKF, EOF, ERASE, ERL, ")
  ManualsHelp_L("ERR, ERROR, EQV, FIELD, FILES, FPOS, FRE, GET, IMP, INPUT#, KEY LIST, LFILES, ")
  ManualsHelp_L("LINEINPUT#, LIST, LLIST, LOAD, LOC, LOF, LPRINT USING, LSET, MAXFILES, MERGE, ")
  ManualsHelp_L("MOTOR, MKD$, MKI$, MKS$, NAME, NEW, ON ERROR GOTO, ON INTERVAL GOSUB (due to ")
  ManualsHelp_L("a bug), OPEN, PLAY, PRINT#, PRINT USING, PUT KANJI, RENUM, RESUME, RSET, ")
  ManualsHelp_L("SAVE, SPC, TAB, TRON, TROFF, WIDTH.")
  ManualsHelp_L("")
  ManualsHelp_L("List of those with limits.")
  ManualsHelp_L("")
  ManualsHelp_L("CIRCLE: Start, end angles and aspect ratio can't be specified.")
  ManualsHelp_L("COPY: Only graphic COPY is available.")
  ManualsHelp_L("DEFDBL: Same as DEFSNG.")
  ManualsHelp_L("DIM: Must come first in the program or in the turbo block.")
  ManualsHelp_L("INPUT: Can handle only one variable at the time.")
  ManualsHelp_L("KEY: ON KEY GOSUB, KEY(n) ON/OFF only.")
  ManualsHelp_L("LOCATE: x,y must be given in as a set. No cursor switch parameter.")
  ManualsHelp_L("NEXT: Variable names after the NEXT can not be omitted.")
  ManualsHelp_L("ON: ON STOP GOSUB, ON INTERVAL GOSUB not available.")
  ManualsHelp_L("PRINT: Commas work in a different way. No wrapping for digits.")
  ManualsHelp_L("PUT: PUT SPRITE only.")
  ManualsHelp_L("RUN: Variables won't be initialized.")
  ManualsHelp_L("SCREEN: Screen mode and sprite size only.")
  ManualsHelp_L("SET: SET PAGE only.")
  ManualsHelp_L("STOP: Same as END.")
  ManualsHelp_L("USR: Parameter type must be integer only.")
  ManualsHelp_L("VARPTR: File number can not be given as the parameter.")
  ManualsHelp_L("")
  ManualsHelp_L("Otherwise there is no significant difference.")
  ManualsHelp_L("")
  ManualsHelp_L("In general, I/O commands & functions, and editing commands can not be ")
  ManualsHelp_L("compiled. Of course they are available in the direct mode, and outside of the ")
  ManualsHelp_L("turbo block. You can edit, debug and save a program in MSX-BASIC and execute ")
  ManualsHelp_L("it by _RUN.")
  ManualsHelp_L("")
  ManualsHelp_L("If you want to use PRINT# to write characters on GRP:, use it outside of ")
  ManualsHelp_L("turbo block. Otherwise study the sample, " + Chr(34) + "PRINT.TRB" + Chr(34) + ".")
  ManualsHelp_L("")
  ManualsHelp_L("If you want to use PLAY, use BGM compiler, and get the sound by USR(n).")
  ManualsHelp_L("")
  ManualsHelp_L("3. New features added")
  ManualsHelp_L("")
  ManualsHelp_L("3 special commands are available by starting a remark line with some specific ")
  ManualsHelp_L("characters.")
  ManualsHelp_L("")
  ManualsHelp_L("#I")
  ManualsHelp_L("Stands for INLINE. You can write a short machine-language routine.")
  ManualsHelp_L("")
  ManualsHelp_L("	100 DEFINT A-Z")
  ManualsHelp_L("	110 K=1")
  ManualsHelp_L("	120 '#I &H2A,K")
  ManualsHelp_L("	130 '#I &HF3,&HCD,@150,&HFB")
  ManualsHelp_L("	140 END")
  ManualsHelp_L("	150 'SUB")
  ManualsHelp_L("	160 RETURN")
  ManualsHelp_L("")
  ManualsHelp_L("120 means LD HL,(K); K must be a simple variable of integer type.")
  ManualsHelp_L("130 means DI")
  ManualsHelp_L("	  CALL @150 ;Be careful, this line won't be RENUMed.")
  ManualsHelp_L("	  EI")
  ManualsHelp_L("")
  ManualsHelp_L("#C")
  ManualsHelp_L("Stands for CLIP. In the screen modes 5 through 8 (except for PAINT, and ")
  ManualsHelp_L("CIRCLE), this will be set clipping on and off.")
  ManualsHelp_L("")
  ManualsHelp_L("	10 SCREEN 8")
  ManualsHelp_L("	20 '#C-")
  ManualsHelp_L("	30 LINE(0,0)-(255,255) 'Y CLIPPED")
  ManualsHelp_L("	40 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 40")
  ManualsHelp_L("	50 '#C+")
  ManualsHelp_L("	60 LINE(0,0)-(255,255) 'NOT CLIPPED")
  ManualsHelp_L("	70 IF INKEY$=" + Chr(34) + Chr(34) + " THEN 70")
  ManualsHelp_L("")
  ManualsHelp_L("#N")
  ManualsHelp_L("Check if NEXT overflows.")
  ManualsHelp_L("")
  ManualsHelp_L("	10 FOR I%=0 TO &H7FFF")
  ManualsHelp_L("	20 NEXT I%")
  ManualsHelp_L("")
  ManualsHelp_L("This program will end up in a " + Chr(34) + "Overflow error" + Chr(34) + " in MSX-BASIC. And if _RUN, it ")
  ManualsHelp_L("will be an endless loop. If #N+ is specififed, it will end normally. This ")
  ManualsHelp_L("code will decrease the efficiency of the object, too. Better not use unless ")
  ManualsHelp_L("it's really necessary. To clear, specify #N-.")
  ManualsHelp_L("")
  ManualsHelp_L("NOTE: In MSX-2+ Sanyo you can found a new command:")
  ManualsHelp_L("")
  ManualsHelp_L("CALL BC")
  ManualsHelp_L("")
  ManualsHelp_L("This command turn on the BASIC COMPILER options.")
  ManualsHelp_Commit("Turbo-Basic Compiler", "Turbo-Basic Compiler")

  ManualsHelp_Begin()
  ManualsHelp_L("             ORIGINAL PANA AMUSEMENT CARTRIDGE FOR MSX2 COMPUTER's ")
  ManualsHelp_L("                                 page # of 48")
  ManualsHelp_L("")
  ManualsHelp_L("HOMESOFT - HOME SOFTWARE BENELUX bv")
  ManualsHelp_L("kuppersweg 63065")
  ManualsHelp_L("2031 EB Haarlem/Holland")
  ManualsHelp_L("")
  ManualsHelp_L("Telefoon (023) 311 241")
  ManualsHelp_L("Telefax  (023) 318 488")
  ManualsHelp_L("Databank (023) 319 517")
  ManualsHelp_L("")
  ManualsHelp_L(" Foreword: ")
  ManualsHelp_L("")
  ManualsHelp_L("Welcome!  Thank you  for bying our FM Pana Amusement Cartridge.  The  FM ")
  ManualsHelp_L("Pana Amusement Cartridge is an FM sound adaptor with S-ram (static) that ")
  ManualsHelp_L("can  be  used with either MSX2 computers that have 32K of Ram  or  more. ")
  ManualsHelp_L("Please read this manual before")
  ManualsHelp_L("")
  ManualsHelp_L("Keep this manual near and refer to it when necessary.")
  ManualsHelp_L("")
  ManualsHelp_L("S-Ram mark for games")
  ManualsHelp_L("")
  ManualsHelp_L("MSX music mark")
  ManualsHelp_L("")
  ManualsHelp_L("MSX is a registrated trademark of ASCII Inc.")
  ManualsHelp_L("")
  ManualsHelp_L("  ")
  ManualsHelp_L("")
  ManualsHelp_L(" Some of the things that we can do with the Cartridge")
  ManualsHelp_L("")
  ManualsHelp_L(" S-RAM (-> page 7) ")
  ManualsHelp_L("")
  ManualsHelp_L("When  used with games that have the S-RAM mark,  the data from the  game ")
  ManualsHelp_L(" may be saved to the S-RAM in the cartridge and the game may be continued ")
  ManualsHelp_L(" at a later time.")
  ManualsHelp_L("")
  ManualsHelp_L(" FM-sound (-> page 9) ")
  ManualsHelp_L("")
  ManualsHelp_L("When  used  with  games  that have the Music  mark  you  can  experience ")
  ManualsHelp_L(" exciting sounds and stimulating music.")
  ManualsHelp_L("")
  ManualsHelp_L(" FM- sound extended BASIC (-> page 34) ")
  ManualsHelp_L("")
  ManualsHelp_L("You can make use of the FM sound functions with Basic")
  ManualsHelp_L("")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("The  FM  Pana Amusement Cartridge consist of so many letters it  may  be ")
  ManualsHelp_L(" hard  to remember.  So for convinience sake,  we will refer to it as the ")
  ManualsHelp_L(" FMPAC  from  now on.  We will also refer to  the  S-RAM  PAC,  mentioned ")
  ManualsHelp_L(" earlier, and the FMPAC as just")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("  Contents                                                Page")
  ManualsHelp_L("")
  ManualsHelp_L("Be careful of these points!                                 4")
  ManualsHelp_L("")
  ManualsHelp_L("Some difficult terms                                        5")
  ManualsHelp_L("")
  ManualsHelp_L("Installing and removing the FMPAC                           6")
  ManualsHelp_L("")
  ManualsHelp_L("Using the PAC's with games                                  7")
  ManualsHelp_L("      Use with games taht are S-RAM compatible              7")
  ManualsHelp_L("      USE with games that have the music mark               9")
  ManualsHelp_L("")
  ManualsHelp_L("Built in software (PAC commander)                           10")
  ManualsHelp_L("      The magical (PAC commander)                           10")
  ManualsHelp_L("      Starting and ending the PAC commander                 11")
  ManualsHelp_L("      Using the PAC commander                               13")
  ManualsHelp_L("      Checking the slotnumber                               15")
  ManualsHelp_L("      Spell 1: (Clear)                                      16")
  ManualsHelp_L("      Spell 2: (Copy)                                       18")
  ManualsHelp_L("      Spell 3: (Change)                                     26")
  ManualsHelp_L("      Spell 4: (Delete file)                                27")
  ManualsHelp_L("      Spell 5: (Slot)                                       29")
  ManualsHelp_L("      Spell 6: (BGM)                                        30")
  ManualsHelp_L("")
  ManualsHelp_L("      What to do when you see error messages                31")
  ManualsHelp_L("")
  ManualsHelp_L("FM-sound extended BASIC (MSX-MUSIC)                         34")
  ManualsHelp_L("         (MSX-MUSIC) commands                               35")
  ManualsHelp_L("         Sample programs                                    41")
  ManualsHelp_L("         MML table                                          42")
  ManualsHelp_L("         Sound data table                                   44")
  ManualsHelp_L("         Temper table                                       45")
  ManualsHelp_L("")
  ManualsHelp_L("Specifications                                              46")
  ManualsHelp_L("")
  ManualsHelp_L("Trouble shooting                                            47")
  ManualsHelp_L("")
  ManualsHelp_L("General Care                                                48")
  ManualsHelp_L("")
  ManualsHelp_L("  Be careful of theese points! ")
  ManualsHelp_L("")
  ManualsHelp_L("The FMPAC has it's weaknesses.")
  ManualsHelp_L("")
  ManualsHelp_L("Avoid the following to keep your FMPAC:  Healthy.Ps")
  ManualsHelp_L("")
  ManualsHelp_L("Keep the FMPAC out of direct sunlight")
  ManualsHelp_L("")
  ManualsHelp_L("Do not spill liquids in the FMPAC")
  ManualsHelp_L("")
  ManualsHelp_L("Do not drop or apply shock to the FMPAC")
  ManualsHelp_L("")
  ManualsHelp_L("Do not remove the screews or open the case")
  ManualsHelp_L("")
  ManualsHelp_L("If the FMPAC does not seem to be working proberley, refer to page 47")
  ManualsHelp_L("")
  ManualsHelp_L("  Some difficult terms. ")
  ManualsHelp_L("")
  ManualsHelp_L("You  know  that your FMPAC is for use with MSX computers.  When you  are ")
  ManualsHelp_L(" reading  this  manual.  You may come across some difficult  words  about ")
  ManualsHelp_L(" computers or special terms.  We will explain the Important words here so ")
  ManualsHelp_L(" take  note  and  remember them")
  ManualsHelp_L("")
  ManualsHelp_L(" Data ")
  ManualsHelp_L("")
  ManualsHelp_L("Information. For example: if you save a game in the middle of plays, the ")
  ManualsHelp_L(" stage number and the level will become information.")
  ManualsHelp_L("")
  ManualsHelp_L(" S-RAM ")
  ManualsHelp_L("")
  ManualsHelp_L("Something that will preserve game data for later use.  It is like a memo ")
  ManualsHelp_L(" pad.")
  ManualsHelp_L("")
  ManualsHelp_L(" File ")
  ManualsHelp_L("")
  ManualsHelp_L("What you call data when it is read or copied from a floppy disk.  A file ")
  ManualsHelp_L(" will always have a name.")
  ManualsHelp_L("")
  ManualsHelp_L(" Floppy Disk ")
  ManualsHelp_L("")
  ManualsHelp_L("Something used to write instructions or files from a computer.  It works ")
  ManualsHelp_L(" something like a casette drive.")
  ManualsHelp_L("")
  ManualsHelp_L(" Save ")
  ManualsHelp_L("")
  ManualsHelp_L("This is what you call the writing data to the S-RAM or Floppy Disk")
  ManualsHelp_L("")
  ManualsHelp_L(" Load ")
  ManualsHelp_L("")
  ManualsHelp_L("This is what you call the reading data (file)")
  ManualsHelp_L("")
  ManualsHelp_L("  Installing and removing the FMPAC  ")
  ManualsHelp_L("")
  ManualsHelp_L("The  FMPAC is inserted into the MSX slot.  The slot that can be used may ")
  ManualsHelp_L(" be different for each game so refer to the game's manual")
  ManualsHelp_L("")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("When inserting and removing a cartridge into the slot,  be sure that the ")
  ManualsHelp_L(" power of the computer is turned OFF!!!")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L(" Installation ")
  ManualsHelp_L("")
  ManualsHelp_L("Refer to the computeres manual and check how to insert Cartridges.")
  ManualsHelp_L("")
  ManualsHelp_L(" Removal ")
  ManualsHelp_L("")
  ManualsHelp_L("Hold the computer dowm with one hand and remove with the other.")
  ManualsHelp_L("")
  ManualsHelp_L("  Using the PAC's with games ")
  ManualsHelp_L("")
  ManualsHelp_L("Use the games that are S-RAM compatible")
  ManualsHelp_L("")
  ManualsHelp_L("If you use this cartridge with games that have the S-RAM compatible mark ")
  ManualsHelp_L(" on them, you will be able to save data into the FMPAC")
  ManualsHelp_L("")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("Different  games you use may have different ways of using the  S-RAM  so ")
  ManualsHelp_L(" you should read the game manual for details.")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("Data  that is saved in the middle of a game is stored in the portion  of ")
  ManualsHelp_L(" the  FMPAC that is called the S-RAM.  The S-RAM id divided into 8  small ")
  ManualsHelp_L(" rooms (segments) and each game uses a seperate room. The room to be used ")
  ManualsHelp_L(" by the game is explained in th")
  ManualsHelp_L("")
  ManualsHelp_L(" Example: ")
  ManualsHelp_L("")
  ManualsHelp_L("Pana Amusemnet Cartridge")
  ManualsHelp_L("1 2 3 4 5 6 7 8")
  ManualsHelp_L("")
  ManualsHelp_L("The number that is shown in inverse white on black,  is the room that is ")
  ManualsHelp_L(" used by that game.")
  ManualsHelp_L("")
  ManualsHelp_L("If you save a game into a room that has been used before,  the data that ")
  ManualsHelp_L(" was there before will be replaced with the new data.")
  ManualsHelp_L("")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("When  using  the FMPAC with 2 games or more read the following  page  to ")
  ManualsHelp_L(" make sure that you don't erase data from the other games.")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("")
  ManualsHelp_L("  Using the FMPAC with games ")
  ManualsHelp_L("")
  ManualsHelp_L("When using the FMPAC with 2 or more games")
  ManualsHelp_L("")
  ManualsHelp_L("One  FMPAC can save up to 8 data but games tahat use rooms which overlap ")
  ManualsHelp_L(" with each other cannot be used together.")
  ManualsHelp_L("For  example  game A uses room 2 for it's data and another game  B  uses ")
  ManualsHelp_L(" room 4 and 5 to save its data then since rooms 2 4 and 5 are used theese ")
  ManualsHelp_L(" games  can use the same FMPAC and another game C must use rooms 1 and  2 ")
  ManualsHelp_L(" the data in room 2 from game A")
  ManualsHelp_L("")
  ManualsHelp_L("  Use with games that have the music mark ")
  ManualsHelp_L("")
  ManualsHelp_L("Using  the  FMPAC with games having the MSX-MUSIC mark will  have  great ")
  ManualsHelp_L(" sounds and exiting music!!")
  ManualsHelp_L("")
  ManualsHelp_L("When  you  play games on your computer,  you notice that the games  have ")
  ManualsHelp_L(" neat  sounds  and music.  Theese sounds are made by the build  in  sound ")
  ManualsHelp_L(" functions in your computer called PSG sounds. The FM sound function that ")
  ManualsHelp_L(" are  in  your  FMPAC sounds mo")
  ManualsHelp_L("")
  ManualsHelp_L("If  the volume of the PSG sounds and the FMPAC sounds do not  match  up, ")
  ManualsHelp_L(" use the volume control switch on the FMPAC to adjust the volume.")
  ManualsHelp_L("")
  ManualsHelp_L("Move the switch to the left to lower the FM sound volume")
  ManualsHelp_L("")
  ManualsHelp_L("Move the switch to the right to increase the FM volume")
  ManualsHelp_L("")
  ManualsHelp_L("Volume selection switch")
  ManualsHelp_L("")
  ManualsHelp_L("Turn  off  the switch before adjusting,  Set the volume switch where  it ")
  ManualsHelp_L(" clicks into place.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) ")
  ManualsHelp_L("")
  ManualsHelp_L("The magical PAC commander")
  ManualsHelp_L("")
  ManualsHelp_L("the PAC commander has 6 spells that it can use")
  ManualsHelp_L("")
  ManualsHelp_L("Clear     This is used to erase data saved with the FMPAC or other PAC's")
  ManualsHelp_L("Copy      This is used to copy data to another PAC or to a Floppy disk")
  ManualsHelp_L("          You can use it to also do the opposite, to copy data from a")
  ManualsHelp_L("          Floppy disk to a PAC")
  ManualsHelp_L("Change    This is used to switch data on two different PAC's")
  ManualsHelp_L("Delete    File is used to erase a file data saved onto a floppy disk")
  ManualsHelp_L("          from a PAC")
  ManualsHelp_L("Slot      This is used to check which slot the FMPAC has been installed ")
  ManualsHelp_L("          into")
  ManualsHelp_L("BGM       This is used to change or stop the background music that is")
  ManualsHelp_L("          playing when using the PAC commander.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) ")
  ManualsHelp_L("")
  ManualsHelp_L("Starting the commander")
  ManualsHelp_L("")
  ManualsHelp_L("1. Make sure the power of the computer is turned off")
  ManualsHelp_L("")
  ManualsHelp_L("2. Insert the FMPAC into a slot")
  ManualsHelp_L("")
  ManualsHelp_L("If  you  are going to be using 2 PAC's to copy or  change,  Insert  both ")
  ManualsHelp_L(" PAC's first.")
  ManualsHelp_L("")
  ManualsHelp_L(" Don't insert cartridges other tham FMPAC's or PAC's !! ")
  ManualsHelp_L("")
  ManualsHelp_L("3. Turn ON the power on the computer")
  ManualsHelp_L("")
  ManualsHelp_L("When  the  power  is  turned on and the  build  in  software  screen  is ")
  ManualsHelp_L(" displayed start up BASIC")
  ManualsHelp_L("")
  ManualsHelp_L("4.  When  the  Initial BASIC screen is showm enter the following at  the ")
  ManualsHelp_L("     keyboard.     CALL FMPAC    and press enter")
  ManualsHelp_L("")
  ManualsHelp_L(" BASIC Initial screen ")
  ManualsHelp_L("")
  ManualsHelp_L("5. this screen tells you that the PAC commander is active.")
  ManualsHelp_L("")
  ManualsHelp_L("When  using the PAC commander,  do not use the pause key or the  control ")
  ManualsHelp_L(" key functions.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) ")
  ManualsHelp_L("")
  ManualsHelp_L("Ending the PAC commander")
  ManualsHelp_L("")
  ManualsHelp_L("To end the PAC commander use the following steps")
  ManualsHelp_L("")
  ManualsHelp_L("1.  Make  sure  the  screen is the same as the bottom  pictures  in  the ")
  ManualsHelp_L(" previous page (The Menu Screen)")
  ManualsHelp_L("")
  ManualsHelp_L("If there is a message displayed on the screen, press wither the space or ")
  ManualsHelp_L(" the ESC key to erase the message.")
  ManualsHelp_L("")
  ManualsHelp_L("2. Turn off the power on the computer.")
  ManualsHelp_L("")
  ManualsHelp_L("If  you are not going to use the FMPAC right away,  remove it  from  the ")
  ManualsHelp_L(" slot.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) ")
  ManualsHelp_L("")
  ManualsHelp_L("Using the PAC commander")
  ManualsHelp_L("")
  ManualsHelp_L("The PAC commander is very simple to use. All you have to do is press the ")
  ManualsHelp_L(" keys described below to cast it's spells.")
  ManualsHelp_L("")
  ManualsHelp_L(" Keys for the PAC commander ")
  ManualsHelp_L("")
  ManualsHelp_L("(^) (v) (cursor keys)    Used to choose which spell to cast")
  ManualsHelp_L("                         and what to cast the spell on.")
  ManualsHelp_L("(Space bar)              Used to tell the PAC commander to carry out")
  ManualsHelp_L("                         your orders.")
  ManualsHelp_L("(ESC)                    Used to tall the PAC commander that you")
  ManualsHelp_L("                         have made a mistake and you want to")
  ManualsHelp_L("                         cancel your order.")
  ManualsHelp_L("")
  ManualsHelp_L(" BASIC use ")
  ManualsHelp_L("")
  ManualsHelp_L("Cursor on")
  ManualsHelp_L("")
  ManualsHelp_L("CLEAR")
  ManualsHelp_L("COPY")
  ManualsHelp_L("CHANGE")
  ManualsHelp_L("DELETE FILE")
  ManualsHelp_L("SLOT")
  ManualsHelp_L("BGM")
  ManualsHelp_L("")
  ManualsHelp_L("Lets  say that what is shown above is the PAC commander screen.  We will ")
  ManualsHelp_L(" call this the spell screen.  Use the cursor keys to move the green color ")
  ManualsHelp_L(" bar  up  and  down to choose which spell you wish  to  cast.  Press  the ")
  ManualsHelp_L(" Spacebar when the cursor is at")
  ManualsHelp_L("")
  ManualsHelp_L(" Build in software (PAC commander)")
  ManualsHelp_L("")
  ManualsHelp_L("The sub-menu and messages")
  ManualsHelp_L("")
  ManualsHelp_L("According to what spell you choose sometimes the spell will not be  cast ")
  ManualsHelp_L(" imediatley,  but  another  sub-menu  like 1 and 2 will be shown  on  the ")
  ManualsHelp_L(" screen.")
  ManualsHelp_L("")
  ManualsHelp_L("1.   PAC -> PAC")
  ManualsHelp_L("     PAC -> FLOPPY")
  ManualsHelp_L("     FLOPPY -> PAC")
  ManualsHelp_L("")
  ManualsHelp_L("2.   YES")
  ManualsHelp_L("     NO")
  ManualsHelp_L("")
  ManualsHelp_L("Like the spell menu,  the items on the sub-menu is selected by using the ")
  ManualsHelp_L(" cirsor  keys  and  pressing the Spacebar will  carry  out  your  choice. ")
  ManualsHelp_L(" Pressing the ESC key will clear the sub-menu screen")
  ManualsHelp_L("")
  ManualsHelp_L("3.  this spell requires another PAC")
  ManualsHelp_L("    is what MSX said")
  ManualsHelp_L("")
  ManualsHelp_L("3 is called a message. The messages are shown while thr spells are being ")
  ManualsHelp_L(" cast and messages will be erased when you press the spacebar and the ESC ")
  ManualsHelp_L(" key.")
  ManualsHelp_L("")
  ManualsHelp_L("Messages give you important information so make sure to read them!")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) ")
  ManualsHelp_L("")
  ManualsHelp_L("Checking the slot number")
  ManualsHelp_L("")
  ManualsHelp_L("When  using  the PAC commander.  MSX will tell you that the FMPAC is  in ")
  ManualsHelp_L(" slot  1  or  slot  2.  But sometimes the slot being  used  will  not  be ")
  ManualsHelp_L(" compatible  with  the  computer being used.  When first  using  the  PAC ")
  ManualsHelp_L(" commander, use the spell as sh")
  ManualsHelp_L("")
  ManualsHelp_L("Now lets explain the 6 spells")
  ManualsHelp_L("")
  ManualsHelp_L("It's in slot 2 but something's not right")
  ManualsHelp_L("")
  ManualsHelp_L("The PAC is in slot 1 ??")
  ManualsHelp_L("")
  ManualsHelp_L("whats wrong ??")
  ManualsHelp_L("")
  ManualsHelp_L("is your computer allright.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Clear ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 1 (CLEAR)")
  ManualsHelp_L("")
  ManualsHelp_L("The  clear spell is a terrible spell that clears all data that has  been ")
  ManualsHelp_L(" saved in the PAC. Use this spell carefully.")
  ManualsHelp_L("")
  ManualsHelp_L("1. Set the cursor to CLEAR on the spell menu and press the spacebar")
  ManualsHelp_L("2. the following 2 menu's will appear on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("The passwords and data in slot 2    YES")
  ManualsHelp_L("will be erased. Are you sure        NO")
  ManualsHelp_L("")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("The number 1 will change according to what slot the PAC is in.")
  ManualsHelp_L("")
  ManualsHelp_L("if there is more than 1 PAC installed the following will be shown")
  ManualsHelp_L("")
  ManualsHelp_L("Which PAC to clear.")
  ManualsHelp_L("")
  ManualsHelp_L("FMPAC    1")
  ManualsHelp_L("PAC      2")
  ManualsHelp_L("")
  ManualsHelp_L("Move the cirsor to the one you want to clear.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Clear ")
  ManualsHelp_L("")
  ManualsHelp_L("3   Make  sure you have choosen the right slot and PAC  then  press  the ")
  ManualsHelp_L("     Spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("If  the PAC is not correct,  press either the ESC key or move the cirsor ")
  ManualsHelp_L(" to NO and press the Spacebar.")
  ManualsHelp_L("")
  ManualsHelp_L("4.  The following message will be shown on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("MSX has cast the CLEAR spell    CL-CL-CL-Clear")
  ManualsHelp_L("")
  ManualsHelp_L("5    Press  the  spacebar and the message will be erased  and  you  will ")
  ManualsHelp_L(" return to the spell menu.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 2  (COPY)")
  ManualsHelp_L("")
  ManualsHelp_L("The copy spell is used to copy data from PAC to PAC and from a PAC and a ")
  ManualsHelp_L(" floppy  sik.  Copy means to make the same set of data in another  place. ")
  ManualsHelp_L(" This spell can also erase data so be carefull when using it.")
  ManualsHelp_L("")
  ManualsHelp_L("First choose the type of copy you want to do.")
  ManualsHelp_L("")
  ManualsHelp_L("You will choose what kind of copy you want to do from a submenu but what ")
  ManualsHelp_L(" happens after that will depends on what you choose.")
  ManualsHelp_L("")
  ManualsHelp_L("1.  Move the cursor on the spell menu to copy and press the spacebar")
  ManualsHelp_L("2.  the followint submenu will be shown on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("PAC -> PAC         From PAC to PAC   ")
  ManualsHelp_L("PAC -> FLOPPY      From a PAC to a floppy disk")
  ManualsHelp_L("FLOPPY -> PAC      From a floppy disk to a PAC")
  ManualsHelp_L("")
  ManualsHelp_L("3. Make your selection by using the cursor keys and press the space bar.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("Be  carefull on theese following points when using either PAC ->  FLOPPY ")
  ManualsHelp_L(" spell or FLOPPY -> PAC")
  ManualsHelp_L("If you have more that one PAC installed the computer will ask you  which ")
  ManualsHelp_L(" PAC  to copy from or which PAC to copy to.  Make your selection with the ")
  ManualsHelp_L(" cursor keys and press the spacebar.  Otherwise, it will be just the same ")
  ManualsHelp_L(" as when you have only one PAC ")
  ManualsHelp_L("")
  ManualsHelp_L("If you Choose PAC -> PAC you wont be able to use thsi spell if you  have ")
  ManualsHelp_L(" only 1 PAC")
  ManualsHelp_L("")
  ManualsHelp_L("1  When you choose thsi type of copy the following message will be shown ")
  ManualsHelp_L(" choose which PAC to copy from and press the spacebar.")
  ManualsHelp_L("")
  ManualsHelp_L("FMPAC    1     Pac in slot 1")
  ManualsHelp_L("PAC      2     Pac in slot 2")
  ManualsHelp_L("")
  ManualsHelp_L("2   The PAC to copy will be shown and check to see if it's correct  then ")
  ManualsHelp_L(" press spacebar.")
  ManualsHelp_L("")
  ManualsHelp_L("If  you  have  3 or more PAC's installed use the cursor keys  to  select ")
  ManualsHelp_L(" whick PAC to copy to.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("3  The following message will be showm on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("The password and data in 1 will be erased")
  ManualsHelp_L("are you sure says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("if you are sure press the spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("if you have choosen the wrong PAC to copy to press either the ESC key or ")
  ManualsHelp_L(" move the cursor to no and press the spacebar. Start over from number 2")
  ManualsHelp_L("")
  ManualsHelp_L("4  The following message screen will be shown on the screen telling  you ")
  ManualsHelp_L(" the copying has ended. Press the spacebar to erase the message.")
  ManualsHelp_L("")
  ManualsHelp_L("MSX casts the COPY spell")
  ManualsHelp_L("C-c-c-c-Copy")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("You cannot use this copy spell unless you have a floppy disk drive")
  ManualsHelp_L("")
  ManualsHelp_L("1  Insert a formatted (initialized disk into the disk drive")
  ManualsHelp_L("   you  cannot use a brand new floppy disk as it is.  Read the  computer ")
  ManualsHelp_L("    manual or the disk drive manual to learn how to format a disk.")
  ManualsHelp_L("   if you have more than 1 drive connected, insert the disk into drive A")
  ManualsHelp_L("")
  ManualsHelp_L("2   Move  the  cursor  to PAC -> Floppy  and  press  the  spacebar.  The ")
  ManualsHelp_L("     following message will appear on the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("Copy to file :________  <- input characters")
  ManualsHelp_L("")
  ManualsHelp_L("This  message is asking you to give a name to the data,  you must give a ")
  ManualsHelp_L(" name to the data whenever you save data to a floppy disk.  The data that ")
  ManualsHelp_L(" you  named  is called a file.  If the data does not have  any  name  the ")
  ManualsHelp_L(" computer will not be able to t")
  ManualsHelp_L("")
  ManualsHelp_L("3  Press the letter keys and give the data a name. The letters you press ")
  ManualsHelp_L(" will  appear  on  the screen.  Your name for the data can have up  to  8 ")
  ManualsHelp_L(" letters. You can use all the capital letters an numbers.")
  ManualsHelp_L("If you make a mistake press BS backspace key and enter the letter again.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("4  When you have named the file press the spacebar the following message ")
  ManualsHelp_L(" will be shown on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("MSX has cast the Copy spell")
  ManualsHelp_L("C-c-c-c-Copy")
  ManualsHelp_L("")
  ManualsHelp_L("when the copying has ended the message will disappear")
  ManualsHelp_L("")
  ManualsHelp_L("If  you have copied files onto the disk beforem the names of  the  files ")
  ManualsHelp_L(" will be shown on the screen during step 2")
  ManualsHelp_L("")
  ManualsHelp_L("GAME001   1988-10-21  17:30")
  ManualsHelp_L("MYGAME    1988-10-22  19:12")
  ManualsHelp_L("LASTGAME  1988-10-22  22:02")
  ManualsHelp_L("")
  ManualsHelp_L("FILE NAME DATE COPIED TIME COPIED")
  ManualsHelp_L("")
  ManualsHelp_L("The date and time og the file copied is taken from the computer.  If the ")
  ManualsHelp_L(" date  and  time set on the computer is wrong the date will set  to  that ")
  ManualsHelp_L(" woring  time and date.  Read the computer manual to fing out how to  set ")
  ManualsHelp_L(" the data and time.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("If  the file that you are going to save has the same name as a  previous ")
  ManualsHelp_L(" saved file the earlier file will be lost.  This is called writing over a ")
  ManualsHelp_L(" file. When there are many files on the disk it is easy to make a mistake ")
  ManualsHelp_L(" and write over an old file.  B")
  ManualsHelp_L("")
  ManualsHelp_L("Writing over files")
  ManualsHelp_L("")
  ManualsHelp_L("1  In step 3 on page 21 pressing the corsor keys will make the cursor to ")
  ManualsHelp_L(" appear  on the file list.  Move the cirsor to the file that you wish  to ")
  ManualsHelp_L(" write over and press the spacebar.")
  ManualsHelp_L("")
  ManualsHelp_L("2  The message shown below will appear on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("File name")
  ManualsHelp_L("xxxxxxxxxx write over this file")
  ManualsHelp_L("MSX asks")
  ManualsHelp_L("")
  ManualsHelp_L("3   Check  to  see if the file to write over is correct then  press  the ")
  ManualsHelp_L("     spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("If  the file is not correct press either the ESC key or move the  cursor ")
  ManualsHelp_L(" to  no  and  press the spacebar and start over from step  1  and  simply ")
  ManualsHelp_L(" follow the steps above.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("FLOPPY -> PAC copy")
  ManualsHelp_L("")
  ManualsHelp_L("You cannot use this type of copy unless you have a disk drive.")
  ManualsHelp_L("")
  ManualsHelp_L("1  Place the disk that you wish to copy from into the drive")
  ManualsHelp_L("   if you have more than 1 drive place it in drive A")
  ManualsHelp_L("")
  ManualsHelp_L("2  Moce the cirsor to FLOPPY -> PAC and press the spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("3   The  list og files on the disk will be shown on the screen  and  the ")
  ManualsHelp_L("     name of the file that the cursor is currentley at will be displayed")
  ManualsHelp_L("")
  ManualsHelp_L("GAME001     1988-09-01    18:05")
  ManualsHelp_L("GAME002     1988-09-10    17:10")
  ManualsHelp_L("GAME003     1988-09-05    22.20")
  ManualsHelp_L("")
  ManualsHelp_L("CURSOR      FILE TO COPY FROM GAME001   <- Character cursor.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Copy ")
  ManualsHelp_L("")
  ManualsHelp_L("4  Move the cirsor to the file you want to copy and press the spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("5  the following message will be shown on the screen The slot the PAC is ")
  ManualsHelp_L("    in")
  ManualsHelp_L("")
  ManualsHelp_L("The password and data in 1 will be erased")
  ManualsHelp_L("are you sure asks MSX")
  ManualsHelp_L("")
  ManualsHelp_L("6  If the PAC to copy to is correct press the spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("If you have the worng PAC selected, press either the ESC key or move the ")
  ManualsHelp_L(" cursor to NO and press spacebar and start over")
  ManualsHelp_L("")
  ManualsHelp_L("7  The following message will be shown")
  ManualsHelp_L("")
  ManualsHelp_L("MSX has cast the Copy spell")
  ManualsHelp_L("C-c-c-c-Copy")
  ManualsHelp_L("")
  ManualsHelp_L("When  the  copying  has ended the message will be erased  and  you  will ")
  ManualsHelp_L(" return to the spell menu")
  ManualsHelp_L("")
  ManualsHelp_L("The list of files is the same as PAC -> FLOPPY  look at page 22 for  the ")
  ManualsHelp_L(" explanation.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Change ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 3 (CHANGE)")
  ManualsHelp_L("")
  ManualsHelp_L("Change  is a powerfull spell that will exchange (swap) the contents of 2 ")
  ManualsHelp_L(" pac's in less than a moment.  If you use this spell carelessly you  will ")
  ManualsHelp_L(" loose  track  of what data is in which PAC so be carefull,  if you  have ")
  ManualsHelp_L(" many  PAC's it's a good idea n")
  ManualsHelp_L("")
  ManualsHelp_L("This Spel can be used only if you have 2 PAC's inserted in the slots  if ")
  ManualsHelp_L(" you  have only 1 PAC installed,  turn OFF the power of the computer  and ")
  ManualsHelp_L(" then insert the other PAC.")
  ManualsHelp_L("")
  ManualsHelp_L("1  Move the cursor on the spell menu to Change and press the spacebar")
  ManualsHelp_L("")
  ManualsHelp_L("2  The following message will be shown on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("MSX casts the change spell")
  ManualsHelp_L("CH-ch-ch-Change")
  ManualsHelp_L("")
  ManualsHelp_L("3   Press  the spacebar to clear the message  You have just changed  the ")
  ManualsHelp_L("     data")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Delete file ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 4 (DELETE FILE)")
  ManualsHelp_L("")
  ManualsHelp_L("The delete file spell is used to erase files on a floppy disk.  Use thsi ")
  ManualsHelp_L(" to remove unvanted files on a disk.  Make sure you don't erase the wrong ")
  ManualsHelp_L(" file.")
  ManualsHelp_L("")
  ManualsHelp_L("This spell cannot be used unless you have a disk drive.")
  ManualsHelp_L("")
  ManualsHelp_L("1  Insert the disk with the unvanted files into the disk drive")
  ManualsHelp_L("   if you have more than 1 drive insert the disk in drive A")
  ManualsHelp_L("")
  ManualsHelp_L("2   Move  the  cursor to Delete file on the spell  menu  and  press  the ")
  ManualsHelp_L("     spacebar.  The files that have been copyed onto the disk before will ")
  ManualsHelp_L("     be  listed  on the screen.  Move the cursor to the file you want  to ")
  ManualsHelp_L("     erase and press spacebar.")
  ManualsHelp_L("")
  ManualsHelp_L("3   The following message will be shown on the screen")
  ManualsHelp_L("")
  ManualsHelp_L("FILE name")
  ManualsHelp_L("")
  ManualsHelp_L("xxxxxxxx delete this file")
  ManualsHelp_L("asks MSX")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Delete file ")
  ManualsHelp_L("")
  ManualsHelp_L("4   Make sure the file shown in the message shows the correct  file  and ")
  ManualsHelp_L(" press  the  spacebar.  The file you have choosen will be erased and  the ")
  ManualsHelp_L(" following message will be displayed")
  ManualsHelp_L("")
  ManualsHelp_L("MSX has cast the DELETE file spell")
  ManualsHelp_L("DE-de-de-Delete")
  ManualsHelp_L("")
  ManualsHelp_L("If  you change your mind about the file to delete press the ESC  key  to ")
  ManualsHelp_L(" cancel  or  move the cursor to NO and press the spacebar and start  over ")
  ManualsHelp_L(" from step 2")
  ManualsHelp_L("")
  ManualsHelp_L("check to see if you have the right file name.")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / Slot ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 5 (SLOT)")
  ManualsHelp_L("")
  ManualsHelp_L("This  spell  is used to find out what slot a PAC is in.  It is  used  to ")
  ManualsHelp_L(" check  to see if the slot of the PAC commander matches the slot  of  the ")
  ManualsHelp_L(" computer.")
  ManualsHelp_L("")
  ManualsHelp_L("This  spell  can be used only if 1 PAC is installed.  If you have  other ")
  ManualsHelp_L(" PAC's installed, turn off the power and remove the ther PAC's")
  ManualsHelp_L("")
  ManualsHelp_L("1   Move the cirsor to slot on the spell menu and  press  spacebar.  The ")
  ManualsHelp_L("     following message will be displayed on the screen.")
  ManualsHelp_L("")
  ManualsHelp_L("MSX has cast thew slot spell. PAC is in slot 1  write this down")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("2  After you have written down the slot number press either the spacebar ")
  ManualsHelp_L(" or the ESC key to clear the message.")
  ManualsHelp_L("")
  ManualsHelp_L("This  number  may be different from the slot number on the  computer  so ")
  ManualsHelp_L(" write the number down or paste the number next to the slot for reference ")
  ManualsHelp_L(" when using the FMPAC")
  ManualsHelp_L("")
  ManualsHelp_L("The PAC commander will use this number so note this down")
  ManualsHelp_L("")
  ManualsHelp_L("  Build in software (PAC commander) / BGM ")
  ManualsHelp_L("")
  ManualsHelp_L("Spell 6 (BGM)")
  ManualsHelp_L("")
  ManualsHelp_L("This spell is used to change or stop the BGM = Back ground music playing ")
  ManualsHelp_L(" when using the PAC commander")
  ManualsHelp_L("")
  ManualsHelp_L("1   Move  the  cursor to BGM on the spell and press  the  spacebar.  The ")
  ManualsHelp_L("     following sub-menu will be shown")
  ManualsHelp_L("")
  ManualsHelp_L("SAMPLE 1")
  ManualsHelp_L("SAMPLE 2")
  ManualsHelp_L("SAMPLE 3")
  ManualsHelp_L("SAMPLE 4")
  ManualsHelp_L("SAMPLE 5")
  ManualsHelp_L("STOP")
  ManualsHelp_L("")
  ManualsHelp_L("2    Move  the cursor to the song that you want to hear  and  press  the ")
  ManualsHelp_L(" spacebar. The spell will be cast immediatley")
  ManualsHelp_L("")
  ManualsHelp_L("If the power switch is turned OFF the music selection will automatically ")
  ManualsHelp_L(" be set to music 1")
  ManualsHelp_L("Use the volume control on the television to adjust the music volume.")
  ManualsHelp_L("")
  ManualsHelp_L("  What to do when you see error messages ")
  ManualsHelp_L("")
  ManualsHelp_L("While  using  the  PAC commander,  you may see  the  following  messages ")
  ManualsHelp_L(" printed  in  yellow.  These are called error messages and they tell  you ")
  ManualsHelp_L(" that something is wrong with your selections.  If any of theese messages ")
  ManualsHelp_L(" should appear try one of thr f")
  ManualsHelp_L("")
  ManualsHelp_L("If the trouble occeur with the drive name, format or write protect check ")
  ManualsHelp_L(" with the either the computer or the disk drive manual.")
  ManualsHelp_L("")
  ManualsHelp_L("Oh-oh the disk is write protected")
  ManualsHelp_L("try again")
  ManualsHelp_L("")
  ManualsHelp_L("The write protect tab on the floppy disk is set to the protect position.")
  ManualsHelp_L("Remove the disk from the drive and set the tab to non protected position ")
  ManualsHelp_L(" so that the hole in the disk cannot be seen.")
  ManualsHelp_L("")
  ManualsHelp_L("There is no disk in the drive")
  ManualsHelp_L("try again")
  ManualsHelp_L("")
  ManualsHelp_L("You must have the disk in drive A .   It will not work even if the  disk ")
  ManualsHelp_L(" is placed in drive B or C.")
  ManualsHelp_L("")
  ManualsHelp_L("The  disk  in the drive may not be formatted.   You must format  a  disk ")
  ManualsHelp_L(" before using it.")
  ManualsHelp_L("")
  ManualsHelp_L("Cannot find the file")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("The  file  name  could be wrong.  Check the file name with the  list  of ")
  ManualsHelp_L(" files.")
  ManualsHelp_L("")
  ManualsHelp_L("  When error messages appear ")
  ManualsHelp_L("")
  ManualsHelp_L("This disk cannot be used with MSX computers")
  ManualsHelp_L("try again")
  ManualsHelp_L("")
  ManualsHelp_L("This disk is broken")
  ManualsHelp_L("try again")
  ManualsHelp_L("")
  ManualsHelp_L("Have you put in a disk from a different computer by mistake??.  The disk ")
  ManualsHelp_L(" to use must be formatted initialized on your type of computer.  If  thsi ")
  ManualsHelp_L(" message appear even if you have done so, then that disk may be broken so ")
  ManualsHelp_L(" try another disk.")
  ManualsHelp_L("")
  ManualsHelp_L("This spell requires another floppy or PAC to work")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("Turn  off the power and connect the disk drive or insert another PAC and ")
  ManualsHelp_L(" try again.")
  ManualsHelp_L("")
  ManualsHelp_L("This spell requires a floppy")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("Turn  oof  the power on the computer and attach the disk drive  and  try ")
  ManualsHelp_L(" again.")
  ManualsHelp_L("")
  ManualsHelp_L("  When error messages appear ")
  ManualsHelp_L("")
  ManualsHelp_L("This spell requires another PAC")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("Turn off the power and insert another PAC and try again")
  ManualsHelp_L("")
  ManualsHelp_L("There are 2 PAC installed,  turn OFF the power,  remove one of the PAC's ")
  ManualsHelp_L(" and try again")
  ManualsHelp_L("")
  ManualsHelp_L("Turn off the power and leave 1 FMPAC installed and try again")
  ManualsHelp_L("")
  ManualsHelp_L("Not enough room on the disk ")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("The disk has become full. Deletesome unvanted files or use another disk.")
  ManualsHelp_L("")
  ManualsHelp_L("The file type seems strange ")
  ManualsHelp_L("says MSX")
  ManualsHelp_L("")
  ManualsHelp_L("Files that have been saved by other means cannot be used.  Always  files ")
  ManualsHelp_L(" that have been saved using the PAC format copy.")
  ManualsHelp_L("")
  ManualsHelp_L("Not enough memory")
  ManualsHelp_L("")
  ManualsHelp_L("The FMPAC requires at least 32K ram to work (data area)")
  ManualsHelp_L("If  this message occurs even if you have over 32Kof memeory,  disconnect ")
  ManualsHelp_L(" any thing that you have attached to the computer (disk drives etc.)  and ")
  ManualsHelp_L(" try again.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC ")
  ManualsHelp_L("")
  ManualsHelp_L("The  FM sound extended BASIC,  MSX-MUSIC is made so that you can use the ")
  ManualsHelp_L(" FM sounds in the FMPAC with your program an commands. Using MSX-MUSIC to ")
  ManualsHelp_L(" produce  sounds will allow you to create beautiful sounds  not  possible ")
  ManualsHelp_L(" with the PSG.")
  ManualsHelp_L("")
  ManualsHelp_L("If  you have never composed music using BASIC before,  reading the BASIC ")
  ManualsHelp_L(" manual  on  the play command will give you a understanding  on  creating ")
  ManualsHelp_L(" music.")
  ManualsHelp_L("")
  ManualsHelp_L("There  is  a semilar extension of BASIC call MSX-AUDIO but  they  are  a ")
  ManualsHelp_L(" little different so take care not to mix them up.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC ")
  ManualsHelp_L("")
  ManualsHelp_L("MSX-MUSIC commands")
  ManualsHelp_L("")
  ManualsHelp_L("Reading the instructions")
  ManualsHelp_L("")
  ManualsHelp_L("The commands will be explained as the example below.")
  ManualsHelp_L("")
  ManualsHelp_L("Example:")
  ManualsHelp_L("")
  ManualsHelp_L("Command: MUSIC ------ command name")
  ManualsHelp_L("")
  ManualsHelp_L("Operation ( what the command does)")
  ManualsHelp_L("")
  ManualsHelp_L("Format: ( how the command is used")
  ManualsHelp_L("        CALL MUSIC [(<MODE>[, ...])]")
  ManualsHelp_L("")
  ManualsHelp_L("Sample  (example)")
  ManualsHelp_L("")
  ManualsHelp_L("Notes   (notes on the command)")
  ManualsHelp_L("")
  ManualsHelp_L("In  the  format  of the command,  the following symbols  are  used.  The ")
  ManualsHelp_L(" symbols are not to be entered but mean the following.")
  ManualsHelp_L("")
  ManualsHelp_L("[ ] --- characters and symbols within the bracket are optional")
  ManualsHelp_L("< > --- characters within theese must be entered in thsi position")
  ManualsHelp_L(Chr(34) + "..." + Chr(34) + " - characters that are repeated.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC ")
  ManualsHelp_L("")
  ManualsHelp_L(" Command:   MUSIC ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation: Starts up MSX-MUSIX and determines how the channels are to be ")
  ManualsHelp_L("            divided and used. This command us used first.")
  ManualsHelp_L("")
  ManualsHelp_L("Format:    CALL MUSIC [(<MODE>[,0[,<n1>[,<n2>[,......[,<n9>]]]]]]]]]])]")
  ManualsHelp_L("")
  ManualsHelp_L("Modes may be 1 or 2")
  ManualsHelp_L("1 selects rhythm")
  ManualsHelp_L("The total number when adding n1-n9 must be 9 or less in mode 0")
  ManualsHelp_L("and 6 or less in mode 1 (n1-n2 specifies the number of channels used.")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:   CALL MUSIC")
  ManualsHelp_L("          3  channels are given different melodies to play and  3  other ")
  ManualsHelp_L("           channels are prepeared to play rhythm")
  ManualsHelp_L("          [same as CALL MUSIC(1,0,1,1,1)] ")
  ManualsHelp_L("")
  ManualsHelp_L("          CALL MUSIC (0,0,1,1,1,1,1,1,1)")
  ManualsHelp_L("          9 channels are set to play different melodies ando no channels")
  ManualsHelp_L("          are set for rhuthm.")
  ManualsHelp_L("")
  ManualsHelp_L("Note:     n1-n9 are allocated to MML1-MML9 for the PLAY statement.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC   ")
  ManualsHelp_L("")
  ManualsHelp_L(" Command BGM ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation   Specifies to allow other commands to be executed while music ")
  ManualsHelp_L("             is playing")
  ManualsHelp_L("")
  ManualsHelp_L("Format:     CALL BGM(n)  n is 0 or 1 or variable of those values")
  ManualsHelp_L("                         default for MUSIC is 1")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:     CALL BGM(0)  no other command can be executed while")
  ManualsHelp_L("                         music is playing.")
  ManualsHelp_L("")
  ManualsHelp_L("            CALL BGM(1)  commands can be executed while music")
  ManualsHelp_L("                         is playing.")
  ManualsHelp_L("")
  ManualsHelp_L(" Command PITCH ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation   This sets the pitch of the sounds to be played with the FM")
  ManualsHelp_L("            sounds. All sounds will be adjusted to this pitch.")
  ManualsHelp_L("")
  ManualsHelp_L("Format:     CALL PITCH(n) n can be from 410 to 459 (or a variable)")
  ManualsHelp_L("                          the default value is 440 (standard A)")
  ManualsHelp_L("")
  ManualsHelp_L("sample:      CALL PITCH(450) Sets the pitch of the sound to be played at ")
  ManualsHelp_L("                              450Hz")
  ManualsHelp_L("                                ")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC   ")
  ManualsHelp_L("")
  ManualsHelp_L(" Command PLAY ")
  ManualsHelp_L("")
  ManualsHelp_L("Operations:  Music will be played according to the MML settings")
  ManualsHelp_L("")
  ManualsHelp_L("Format:      Play [#<MODE>,]<MML 1>[,....[,<MML n>[,<MMLm>[,<MMLp1>...[,")
  ManualsHelp_L("             <MMLp3>]]]]]]]]]]]]")
  ManualsHelp_L("             <MODE> can be 0,2,3")
  ManualsHelp_L("             <MML1> through <MMLn> are FM sound MML's")
  ManualsHelp_L("             <MML> numbers are the same as the values for CALL MUSIC")
  ManualsHelp_L("             <MML m> is for the rhythm MML")
  ManualsHelp_L("             <MML p1> through <MML p3> are for the PSG MML")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:      Play #2, " + Chr(34) + "CD" + Chr(34) + ", " + Chr(34) + "EF" + Chr(34) + ", " + Chr(34) + "GA" + Chr(34))
  ManualsHelp_L("")
  ManualsHelp_L("Notes:  If <MODE> is set to 0 or not set, PSG will be played")
  ManualsHelp_L("        only MML p1-3 can be used")
  ManualsHelp_L("        if <MODE> is set to either 2 or 3 both FM and PSG can be used")
  ManualsHelp_L("        MML 1-2 are set according to the MUSIC command as notes from ")
  ManualsHelp_L("        the  starting  order.  However if a mode that does not  use  the ")
  ManualsHelp_L("         rhythm  channels  is  specified,  the rhythm  channels  must  be ")
  ManualsHelp_L("         omitted.")
  ManualsHelp_L("")
  ManualsHelp_L("Function:     PLAY")
  ManualsHelp_L("")
  ManualsHelp_L("Operation:    This  detimes  if  music is being played and  returns  the ")
  ManualsHelp_L("               result as a value.")
  ManualsHelp_L("")
  ManualsHelp_L("Format:       CALL PLAY (n,x)    n is the channel to check")
  ManualsHelp_L("                                 x is the name of the variable to")
  ManualsHelp_L("                                   store the value in.")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:       CALL PLAY(0,A):PRINT A")
  ManualsHelp_L("")
  ManualsHelp_L("              When n=0 if any channels are playing, the value -1")
  ManualsHelp_L("              will be stored in A and 0 if no channels are playing.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC   ")
  ManualsHelp_L("")
  ManualsHelp_L(" Command STOPM ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation:   Stop play of BGM")
  ManualsHelp_L("")
  ManualsHelp_L("Format:      CALL STOPM")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:      CALL STOPM")
  ManualsHelp_L("")
  ManualsHelp_L(" Command TEMPER (temperament)  ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation    This sets the rhythm for the FM sound")
  ManualsHelp_L("")
  ManualsHelp_L("Format:      CALL TEMPER (n)   n can be from 0 to 21 or a variable")
  ManualsHelp_L("                               default value is 9")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:      CALL TEMPER (0)")
  ManualsHelp_L("")
  ManualsHelp_L("Notes:       for a list of rhythms that can be set and their vlaues, see ")
  ManualsHelp_L("              page 45 " + Chr(34) + "Table of Rhythms.")
  ManualsHelp_L("")
  ManualsHelp_L(" Command TRANSPOSE ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation:   Will tranpose in units of half tones 1/100 units")
  ManualsHelp_L("")
  ManualsHelp_L("Format:      CALL TRANSPOSE (n)   ")
  ManualsHelp_L("             n can have values from -12799 to 12799 or a variable")
  ManualsHelp_L("               However, some voices have a limited setting even")
  ManualsHelp_L("               through within the +-12799 range")
  ManualsHelp_L("               Default setting is 0")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:      CALL TRANSPOSE (100)  tranposes a half tone.")
  ManualsHelp_L("")
  ManualsHelp_L("  FM sound extended BASIC ")
  ManualsHelp_L("")
  ManualsHelp_L("         MSX-MUSIC   ")
  ManualsHelp_L("                                 ")
  ManualsHelp_L("")
  ManualsHelp_L(" Command VOICE ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation:    Stes  what  instrument <Voice> is to be played by  the  FM ")
  ManualsHelp_L("               sound channels.  However,  values without * mark and array ")
  ManualsHelp_L("               values  (refer  to  page  44 are limited to  2  when  used ")
  ManualsHelp_L("               together.")
  ManualsHelp_L("")
  ManualsHelp_L("Format:       CALL VOICE ([@n1], [@n2], .... [@n9]")
  ManualsHelp_L("              n1-n9 can be values from 0-63 (voice nr) or variables")
  ManualsHelp_L("")
  ManualsHelp_L("              default setting is @0")
  ManualsHelp_L("")
  ManualsHelp_L("Note:         The   voice number canbe selected from the table  on  page ")
  ManualsHelp_L("               44's Table of voices numbers.")
  ManualsHelp_L("")
  ManualsHelp_L(" Command VOICE COPY ")
  ManualsHelp_L("")
  ManualsHelp_L("Operation:    This   command  copies the voice data to number 63  or  an ")
  ManualsHelp_L("               array variable.")
  ManualsHelp_L("")
  ManualsHelp_L("Format:       CALL VOICE COPY (@n1, -n2)")
  ManualsHelp_L("              n1 can be voices from 0-63 that have no * mark or array")
  ManualsHelp_L("              variables.")
  ManualsHelp_L("              n2 can be 63 or an array variable name.")
  ManualsHelp_L("")
  ManualsHelp_L("Sample:       DIM A%(16)")
  ManualsHelp_L("              CALL VOICE COPY (@7,A%)")
  ManualsHelp_L("              pipe organ 1 is copied to array variable A.")
  ManualsHelp_L("")
  ManualsHelp_L("Note:         choose the voice from the table on page 44.")
  ManualsHelp_L("")
  ManualsHelp_L("  Sample Program ")
  ManualsHelp_L("")
  ManualsHelp_L("Here is an example using the MSX-MUSIC. The first 8 measures of the song ")
  ManualsHelp_L(" Flower  is shown below.  Refer to thsi song and the MML table and  enter ")
  ManualsHelp_L(" your favorite song to be played with FM sounds.")
  ManualsHelp_L("")
  ManualsHelp_L(" MML Table ")
  ManualsHelp_L("")
  ManualsHelp_L("This  is a table of the MML (music macro language) that can be used with ")
  ManualsHelp_L(" the PLAY command.")
  ManualsHelp_L("")
  ManualsHelp_L("Music MML")
  ManualsHelp_L("")
  ManualsHelp_L(" Statement  Meaning                      Range       Default Value *1 ")
  ManualsHelp_L("")
  ManualsHelp_L("Mn         Envelope cycle setting *2    1>=n<=65535 m255")
  ManualsHelp_L("Sn         Envelope shape *2            0<=n<=15    S0")
  ManualsHelp_L("Vn         Volume                       0<=n<=15    V8")
  ManualsHelp_L("Ln         Lenght                       1<=n<=64    L4 ")
  ManualsHelp_L("Qn         Division of sound lenght     1<=n<=8     Q8")
  ManualsHelp_L("On         Octave                       1<=n<=8     O4")
  ManualsHelp_L(">          Raise 1 Octave                  -        -")
  ManualsHelp_L("<          Lower 1 Octave                  -        -")
  ManualsHelp_L("Tn         Tempo setting                32<=n<=255  T120")
  ManualsHelp_L("Nn         Plays Note raised to n       0<=n<=96    -")
  ManualsHelp_L("Rn         Rest setting                 1<=n<=64    R4")
  ManualsHelp_L("A-G        Note                         -           -")
  ManualsHelp_L("+, #       Sharp (raise half tone)      -           -")
  ManualsHelp_L("-          Flat (Lower half tone)       -           -")
  ManualsHelp_L("(period).  Lengthen note or rest by 1.5 -           -")
  ManualsHelp_L("XA$        Plays MML stored in string   -           -")
  ManualsHelp_L("           variable A$ *3")
  ManualsHelp_L("=x;        sets parameter to x          *4          -")
  ManualsHelp_L("&          Tie                          -           -")
  ManualsHelp_L("{}n        will generate even notes of  1<=n<=64    value set")
  ManualsHelp_L("           n for the number within                  with Ln")
  ManualsHelp_L("           the {}     ")
  ManualsHelp_L("@n         changes the voice set to n   0<=<=63     -")
  ManualsHelp_L("@Vn        sets detail change in volume 0<=n<=127   -")
  ManualsHelp_L("@Nn        maintain lenght set by n     1<=n<=64    value set")
  ManualsHelp_L("                                                    with Ln")
  ManualsHelp_L("")
  ManualsHelp_L("*1 Initial value set when CALL MUSIC is used")
  ManualsHelp_L("*2 For PSG only")
  ManualsHelp_L("*3 Adding MML after [XA$;] will result in error")
  ManualsHelp_L("*4 The   value range is dertimined by the preceeding MML but  it  cannot ")
  ManualsHelp_L("    exceed the value 32767")
  ManualsHelp_L("")
  ManualsHelp_L("  RHYTHM MML ")
  ManualsHelp_L("")
  ManualsHelp_L("There  are  5  different  voice  that  are  available  for  the   rhythm ")
  ManualsHelp_L(" (percussion)  MML and up to 3 voices may be played  simultaneously.  For ")
  ManualsHelp_L(" this reason the rhythm MML first lines up the instruments that are to be ")
  ManualsHelp_L(" played  simultaneously and the")
  ManualsHelp_L("")
  ManualsHelp_L(" Statement     Meaning                         Range     Default ")
  ManualsHelp_L("")
  ManualsHelp_L("B             Bass drum                       -         -")
  ManualsHelp_L("S             Snare drum                      -         -")
  ManualsHelp_L("W             Tom tom                         -         -")
  ManualsHelp_L("C             Cymbals                         -         -")
  ManualsHelp_L("H             Hi Hat                          -         -")
  ManualsHelp_L("n (number)    previous notes are played and")
  ManualsHelp_L("              n th note are rested            1<=n<=64  -")
  ManualsHelp_L("Vn            Volume                          0<=n<=15  8")
  ManualsHelp_L("!             Accents preceeding note                   -")
  ManualsHelp_L("@An           Sets volume for voices that     0<=n<=15  -")
  ManualsHelp_L("              are accented.")
  ManualsHelp_L("")
  ManualsHelp_L("[Tn], [@Vn], [Rn], [XA$;], [=x;], [.(period)] is the same as music MML")
  ManualsHelp_L("")
  ManualsHelp_L("example:      PLAY#2," + Chr(34) + Chr(34) + "," + Chr(34) + Chr(34) + "," + Chr(34) + Chr(34) + "," + Chr(34) + "BSH8H8H8S!H!8H8" + Chr(34))
  ManualsHelp_L("")
  ManualsHelp_L("Bass, snare,hihat and wait an 8th note")
  ManualsHelp_L("Hi hat and wait an 8th note")
  ManualsHelp_L("snare, hi hat plays accented and waits an 8th note")
  ManualsHelp_L("Hi hat and wait an 8Th note")
  ManualsHelp_L("")
  ManualsHelp_L("  VOICE DATA TABLE ")
  ManualsHelp_L("")
  ManualsHelp_L("This is a list of the voices available for use with Voice command or the ")
  ManualsHelp_L(" MML @ statement.")
  ManualsHelp_L("")
  ManualsHelp_L("Voice No.  Name               Voice no.  Name")
  ManualsHelp_L("")
  ManualsHelp_L("0 *        Piano 1            32         Piano 3")
  ManualsHelp_L("1          Piano 2            33 *       Wood Bass")
  ManualsHelp_L("2 *        Violin             34         Santule 2")
  ManualsHelp_L("3 *        Flute 1            35         Brass")
  ManualsHelp_L("4 *        Clarinet           36         Flute 2")
  ManualsHelp_L("5 *        Oboe               37         Clavicord 2")
  ManualsHelp_L("6 *        Trumpet            38         Clavicord 3")
  ManualsHelp_L("7          Pipe Organ         39         Koto 2")
  ManualsHelp_L("8          Xylophone          40         Pipe Organ 2")
  ManualsHelp_L("9 *        Organ              41         P0hdsPLA")
  ManualsHelp_L("10 *       Guitar             42         P0hdsPRA")
  ManualsHelp_L("11         Santule 1          43         Church Organ L")
  ManualsHelp_L("12 *       Electric bass      44         Church Organ R")
  ManualsHelp_L("13         Clavicord 1        45         Synth Violin ")
  ManualsHelp_L("14 *       Hapsicord          46         Synth Organ")
  ManualsHelp_L("15         Hapsicord          47         Synth Brass")
  ManualsHelp_L("16 *       Vibraphone         48 *       Horn")
  ManualsHelp_L("17         Koto 1             49         Shamisen")
  ManualsHelp_L("18         Taiko              50         Magical")
  ManualsHelp_L("19         Engine 1           51         Fuwawa")
  ManualsHelp_L("20         UFO                52         Wonderflat")
  ManualsHelp_L("21         Synth Bell         53         Hard Rock")
  ManualsHelp_L("22         Chime              54         Machine")
  ManualsHelp_L("23 *       Synth Bass         55         Machine V")
  ManualsHelp_L("24 *       Synthesizer        56         Comic")
  ManualsHelp_L("25         Synth drum         57         SE comic")
  ManualsHelp_L("26         Synth rhythm       58         SE laser")
  ManualsHelp_L("27         Harmo drum         59         SE noise")
  ManualsHelp_L("28         Cow Bell           60         SE star 1")
  ManualsHelp_L("29         Hi Hat             61         SE star 2")
  ManualsHelp_L("30         Snare drum         62         Engine 2")
  ManualsHelp_L("32         Bass drum          63         no sound         ")
  ManualsHelp_L("")
  ManualsHelp_L("*  The name of the voice are given for reference only and they  may  not ")
  ManualsHelp_L(" sound the same as the real instruments")
  ManualsHelp_L("")
  ManualsHelp_L("*   Are sounds that are build in the FM sound chip and sounds without an ")
  ManualsHelp_L(" * indicates sounds generated by software.")
  ManualsHelp_L("")
  ManualsHelp_L("  RHYTHM TABLE ")
  ManualsHelp_L("")
  ManualsHelp_L("Table of Rhythm usable with the TEMPER statement")
  ManualsHelp_L("")
  ManualsHelp_L("No.     Rhythm")
  ManualsHelp_L("")
  ManualsHelp_L("0       Pythograph")
  ManualsHelp_L("1       Mintone")
  ManualsHelp_L("2       Welkmeyster")
  ManualsHelp_L("3       Welkmeyster (adjusted)")
  ManualsHelp_L("4       Welkmeyster (seperate)")
  ManualsHelp_L("5       Kilanbuger")
  ManualsHelp_L("6       Kilanbuger  (adjusted)")
  ManualsHelp_L("7       Velotte Young")
  ManualsHelp_L("8       Lamour")
  ManualsHelp_L("9       Perfect Rhythm (default)")
  ManualsHelp_L("10      Pure Rhythm  c major    (a minor)")
  ManualsHelp_L("11      Pure Rhythm  cis major  (b minor)")
  ManualsHelp_L("12      Pure Rhythm  d major    (h minor)")
  ManualsHelp_L("13      Pure Rhythm  es major   (c minor)")
  ManualsHelp_L("14      Pure Rhythm  e major    (cis minor)")
  ManualsHelp_L("15      Pure Rhythm  f major    (d minor)")
  ManualsHelp_L("16      Pure Rhythm  fis major  (es minor)")
  ManualsHelp_L("17      Pure Rhythm  g major    (e minor)")
  ManualsHelp_L("18      Pure Rhythm  gis major  (f minor)")
  ManualsHelp_L("19      Pure Rhythm  a major    (fis minor)")
  ManualsHelp_L("20      Pure Rhythm  b minor    (g minor)")
  ManualsHelp_L("21      Pure Rhythm  h minor    (gis minor)")
  ManualsHelp_L("")
  ManualsHelp_L("  Specifications ")
  ManualsHelp_L("")
  ManualsHelp_L("Item:          Description")
  ManualsHelp_L("")
  ManualsHelp_L("Machine:       MSX, MSX2 personal Computers")
  ManualsHelp_L("               32K byte of Ram")
  ManualsHelp_L("")
  ManualsHelp_L("Conditions:    Temperature 10'C-35'C ")
  ManualsHelp_L("        ")
  ManualsHelp_L("Humidity:      20%-80% without condensation")
  ManualsHelp_L("")
  ManualsHelp_L("Battery life:  5 years approx")
  ManualsHelp_L("")
  ManualsHelp_L("Dimensions:    210 X 1008 X 17  mm")
  ManualsHelp_L("")
  ManualsHelp_L("Weight: (g)    140 (g) approx")
  ManualsHelp_L("")
  ManualsHelp_L("FM sound:      2 operator FM sound generation")
  ManualsHelp_L("")
  ManualsHelp_L("S-RAM:         MSX game specific 8 segment S-RAM")
  ManualsHelp_L("               RAM capicity 8Kbytes (64K bit)")
  ManualsHelp_L("               back up battery function to preserve data")
  ManualsHelp_L("")
  ManualsHelp_L("BUILD in SOFT: Clear")
  ManualsHelp_L("               Copy")
  ManualsHelp_L("               PAC->PAC, PAC->FLOPPY, FLOPPY->PAC")
  ManualsHelp_L("               Delete file")
  ManualsHelp_L("               Slot")
  ManualsHelp_L("               BGM")
  ManualsHelp_L("               5 Sample Songs  stop")
  ManualsHelp_L("")
  ManualsHelp_L("  Trouble Shooting ")
  ManualsHelp_L("")
  ManualsHelp_L("Check out theese items once more. If it doesn't work again then take the ")
  ManualsHelp_L(" FMPAC  to  the  store that it was purchased from and ask the  clerk  for ")
  ManualsHelp_L(" advice.")
  ManualsHelp_L("")
  ManualsHelp_L("Is the FMPAC plugged into the Slot firmly?")
  ManualsHelp_L("")
  ManualsHelp_L("Is it in the correct Slot?")
  ManualsHelp_L("")
  ManualsHelp_L("Try another slot and try again")
  ManualsHelp_L("")
  ManualsHelp_L("Are you following the instructions??")
  ManualsHelp_L("")
  ManualsHelp_L("Turn OFF the computer and remove the FMPAC then try again from the start")
  ManualsHelp_L("")
  ManualsHelp_L(" If the data are destroyed or Changed ")
  ManualsHelp_L("")
  ManualsHelp_L("The content of the FMPAC S-RAM operates with the build in  battery.  The ")
  ManualsHelp_L(" expected  battery  life time is 5 yesrs but something may go wrong  with ")
  ManualsHelp_L(" the battery.  If data is lost or seems to be strange,  consult the store ")
  ManualsHelp_L(" that you purchased the FMPAC f")
  ManualsHelp_L("")
  ManualsHelp_L("  General Care ")
  ManualsHelp_L("")
  ManualsHelp_L("If the FMPAC should become soiled, clean it in the following manner:")
  ManualsHelp_L("")
  ManualsHelp_L("Wipe the case gentley with a soft cloth,  if a rough cloth is used or it ")
  ManualsHelp_L(" is wiped roughly you will damage the case.")
  ManualsHelp_L("")
  ManualsHelp_L("If the case i heavely soiled,  use a little dishwashing liquid,  If  the ")
  ManualsHelp_L(" case  does  not  become  clean by gentley wiping,  use  a  tiny  bit  of ")
  ManualsHelp_L(" dishwashing liquid on a soft cloth an wipe the case clean with it.")
  ManualsHelp_L("Always  wipe the liquid off with a soft cotton cloth after cleaning with ")
  ManualsHelp_L(" dishwashing liquid.")
  ManualsHelp_L("")
