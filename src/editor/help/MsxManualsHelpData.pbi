  ManualsHelp_L("Changes from the original in APPENDIX 5:")
  ManualsHelp_L("")
  ManualsHelp_L("- The original VRAM mapping figures have been converted to simple text ")
  ManualsHelp_L("tables.")
  ManualsHelp_L("")
  ManualsHelp_L("- In SCREEN 0 (WIDTH 80) map, different end addresses for the blink table are ")
  ManualsHelp_L("indicated for 24 lines mode and 26.5 lines mode.")
  ManualsHelp_L("")
  ManualsHelp_L("-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-")
  ManualsHelp_L("")
  ManualsHelp_L("APPENDIX 5 - VRAM MAP")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 0 (WIDTH 40) / TEXT 1")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 03BFH	-->	Pattern name table")
  ManualsHelp_L("0400H - 042FH	-->	Palette table")
  ManualsHelp_L("0800H - 0FFFH	-->	Pattern generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 0 (WIDTH 80) / TEXT 2")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 077FH	-->	Pattern name table")
  ManualsHelp_L("0800H - 08EFH	-->	Blink table (24 lines mode)")
  ManualsHelp_L("	090DH			    (26.5 lines mode)")
  ManualsHelp_L("0F00H - 0F2FH	-->	Palette table")
  ManualsHelp_L("1000H - 17FFH	-->	Pattern generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 1 / GRAPHIC 1")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 07FFH	-->	Pattern generator table")
  ManualsHelp_L("1800H - 1AFFH	-->	Pattern name table")
  ManualsHelp_L("1B00H - 1B7FH	-->	Sprite attribute table")
  ManualsHelp_L("2000H - 201FH	-->	Colour table")
  ManualsHelp_L("2020H - 204FH	-->	Palette table")
  ManualsHelp_L("3800H - 3FFFH	-->	Sprite generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 2 / GRAPHIC 2")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 07FFH	-->	Pattern generator table 1")
  ManualsHelp_L("0800H - 0FFFH	-->	Pattern generator table 2")
  ManualsHelp_L("1000H - 17FFH	-->	Pattern generator table 3")
  ManualsHelp_L("1800H - 18FFH	-->	Pattern name table 1")
  ManualsHelp_L("1900H - 19FFH	-->	Pattern name table 2")
  ManualsHelp_L("1A00H - 1AFFH	-->	Pattern name table 3")
  ManualsHelp_L("1B00H - 1B7FH	-->	Sprite attribute table")
  ManualsHelp_L("1B80H - 1BAFH	-->	Palette table")
  ManualsHelp_L("2000H - 27FFH	-->	Colour table 1")
  ManualsHelp_L("2800H - 2FFFH	-->	Colour table 2")
  ManualsHelp_L("3000H - 37FFH	-->	Colour table 3")
  ManualsHelp_L("3800H - 3FFFH	-->	Sprite generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 3 / MULTI COLOUR")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 07FFH	-->	Pattern generator table")
  ManualsHelp_L("0800H - 0AFFH	-->	Pattern name table")
  ManualsHelp_L("1B00H - 1B7FH	-->	Sprite attribute table")
  ManualsHelp_L("2020H - 204FH	-->	Palette table")
  ManualsHelp_L("3800H - 3FFFH	-->	Sprite generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 4 / GRAPHIC 3")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 07FFH	-->	Pattern generator table 1")
  ManualsHelp_L("0800H - 0FFFH	-->	Pattern generator table 2")
  ManualsHelp_L("1000H - 17FFH	-->	Pattern generator table 3")
  ManualsHelp_L("1800H - 18FFH	-->	Pattern name table 1")
  ManualsHelp_L("1900H - 19FFH	-->	Pattern name table 2")
  ManualsHelp_L("1A00H - 1AFFH	-->	Pattern name table 3")
  ManualsHelp_L("1B80H - 1BAFH	-->	Palette table")
  ManualsHelp_L("1C00H - 1DFFH	-->	Sprite colour table")
  ManualsHelp_L("1E00H - 1E7FH	-->	Sprite attribute table")
  ManualsHelp_L("2000H - 27FFH	-->	Colour table 1")
  ManualsHelp_L("2800H - 2FFFH	-->	Colour table 2")
  ManualsHelp_L("3000H - 37FFH	-->	Colour table 3")
  ManualsHelp_L("3800H - 3FFFH	-->	Sprite generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 5, 6 / GRAPHIC 4, 5")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - 5FFFH	-->	Pattern name table (192 lines)")
  ManualsHelp_L("	69FFH				   (212 lines)")
  ManualsHelp_L("7400H - 75FFH	-->	Sprite colour table")
  ManualsHelp_L("7600H - 767FH	-->	Sprite attribute table")
  ManualsHelp_L("7680H - 76AFH	-->	Palette table")
  ManualsHelp_L("7A00H - 7FFFH	-->	Sprite generator table")
  ManualsHelp_L("")
  ManualsHelp_L("* SCREEN 7, 8 / GRAPHIC 6, 7")
  ManualsHelp_L("")
  ManualsHelp_L("0000H - BFFFH	-->	Pattern name table (192 lines)")
  ManualsHelp_L("	D3FFH				   (212 lines)")
  ManualsHelp_L("F000H - F7FFH	-->	Sprite generator table")
  ManualsHelp_L("F800H - F9FFH	-->	Sprite colour table")
  ManualsHelp_L("FA00H - FA7FH	-->	Sprite attribute table")
  ManualsHelp_L("FA80H - FAAFH	-->	Palette table")
