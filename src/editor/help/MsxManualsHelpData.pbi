  ManualsHelp_Begin()
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("                          A")
  ManualsHelp_L("                R800 INSTRUCTION CHARTS")
  ManualsHelp_L("------------------------------------------------------------------------")
  ManualsHelp_L("In these charts instructions of the R800, grouped in kind of instructions ")
  ManualsHelp_L("are collected. Of the mnemonics in these charts the name of the instruction, ")
  ManualsHelp_L("usage of this instruction are smplified showed.")
  ManualsHelp_L("In the column of the usage of an instruction when there is an <- symbol The ")
  ManualsHelp_L("details of the left side are shown on the rightside")
  ManualsHelp_L("The KAKKO (??) means the details of the memory by the shown belonging ")
  ManualsHelp_L("register. (???)")
  ManualsHelp_L("For example if there is :")
  ManualsHelp_L("")
  ManualsHelp_L("    r <- [.hl]")
  ManualsHelp_L("")
  ManualsHelp_L("the details of the memory of the shown HL register is is going to 8 bit (???)")
  ManualsHelp_L("The in/out-put instructions [n] and [.c] are the equivalence of the in/out-put ")
  ManualsHelp_L("ports.")
  ManualsHelp_L("In the flag column the flags used are shown. OPcode column the machinecode of ")
  ManualsHelp_L("every different instruction is written down in HEX and BIN format.")
  ManualsHelp_L("The B stands for the length of the code in bytes, the C stands for the length ")
  ManualsHelp_L("of the code in clock cycles.The shown mnemonics that have changed for the R800 ")
  ManualsHelp_L("can't be guaranteed to work properly on the Z80 because they are not the same ")
  ManualsHelp_L("as the z80 instructions. (??)")
  ManualsHelp_L("<660                                         APPENDIX A R800 INSTRUCTION CHART>")
  ManualsHelp_L("")
  ManualsHelp_L("remarks")
  ManualsHelp_L("")
  ManualsHelp_L("  +-------+---------------------------------------------------------------+")
  ManualsHelp_L("  |.a{7}  |The highest bit of register .a                                 |")
  ManualsHelp_L("  |.{4..7}|Bit 4-7 of register .a                                         |")
  ManualsHelp_L("  |;      |Punctuation of the usage                                       |")
  ManualsHelp_L("  |.de:.hl|.de is the upper 16bit and .hl is the lower 16 bit and 32 bit  |")
  ManualsHelp_L("  |       |                                                               |")
  ManualsHelp_L("  |       |  formed.                                                      |")
  ManualsHelp_L("  |[.ix+d]|adres is formed when the 8bit of d is added to .ix             |")
  ManualsHelp_L("  |C      |carry flag                                                     |")
  ManualsHelp_L("  |Z      |zero flag                                                      |")
  ManualsHelp_L("  |P/v    |parity overflow                                                |")
  ManualsHelp_L("  |S      |sign flag                                                      |")
  ManualsHelp_L("  |N      |substraction flag                                              |")
  ManualsHelp_L("  |H      |half clear flag                                                |")
  ManualsHelp_L("  |•      |flag don't change                                              |")
  ManualsHelp_L("  |+      |flag changed in commando used                                  |")
  ManualsHelp_L("  |0      |flag is set to 0                                               |")
  ManualsHelp_L("  |1      |flag is set to 1                                               |")
  ManualsHelp_L("  |?      |becomes uncertain                                              |")
  ManualsHelp_L("  |V      |uses the overflow flag                                         |")
  ManualsHelp_L("  |P      |uses the parity flag                                           |")
  ManualsHelp_L("  |i(iff) |value of the interrupt flipflop is attained                    |")
  ManualsHelp_L("  |r,r'   |8 bit register, .a,.b,.c,.d,.e,.h,.l                           |")
  ManualsHelp_L("  |u,u'   |8 bit register, .a,.b,.c,.d,.e,.ixh,.ixl                       |")
  ManualsHelp_L("  |v,v'   |8 bit register, .a,.b,.c,.d,.e,.iyh,.iyl                       |")
  ManualsHelp_L("  |p      |8 bit register, .ixh,.ixl                                      |")
  ManualsHelp_L("  |q      |8 bit register, .iyh,.iyl                                      |")
  ManualsHelp_L("  |ss     |16 bit register,.bc,.de,.hl,.sp                                |")
  ManualsHelp_L("  |pp     |16 bit register,.bc,.de,.ix,.sp                                |")
  ManualsHelp_L("  |rr     |16 bit register,.bc,.de,.iy,.sp                                |")
  ManualsHelp_L("  |qq     |16 bit register,.bc,.de,.hl,.af                                |")
  ManualsHelp_L("  |e      |8 bit value of short branch   (+127~128)                       |")
  ManualsHelp_L("  |k      |adres of the brk comando, 00h,08h,10h,18h,20h,28h,30h,38h      |")
  ManualsHelp_L("  |nn     |direct value of 16 bit, positive adres                         |")
  ManualsHelp_L("  |n      |direct value of 8 bit                                          |")
  ManualsHelp_L("  |b      |value shown number of bits for the bits of the mathematical    |")
  ManualsHelp_L("  |       |  operation??                                                  |")
  ManualsHelp_L("  |NOT    |bit rotation (??)                                              |")
  ManualsHelp_L("  |\/     |taking the OR of the bits                                      |")
  ManualsHelp_L("  |\-/    |taking the XOR of the bits                                     |")
  ManualsHelp_L("  |/\     |taking the AND of the bits                                     |")
  ManualsHelp_L("  |tmp    |temporary value   (??)                                         |")
  ManualsHelp_L("  |B      |number of bytes of the instruction                             |")
  ManualsHelp_L("  |C      |number of clock cycles of the instruction                      |")
  ManualsHelp_L("  +-------+---------------------------------------------------------------+")
  ManualsHelp_L("???")
