  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|bp nn       |if s=0                      |• • • •   • •|11110010|F2 |3|3|")
  ManualsHelp_L("|            |.pc<-nn                     |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|bm nn       |if s=1                      |• • • •   • •|11111010|FA |3|3|")
  ManualsHelp_L("|            |                            |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|br [.hl]    |.pc<-.hl                    |• • • •   • •|11101001|E9 |1|1|")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|br [.ix]    |.pc<-.ix                    |• • • •   • •|11011101|DD |2|2|")
