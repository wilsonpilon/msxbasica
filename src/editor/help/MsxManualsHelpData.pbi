  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|bnc nn      |if c=0                      |• • • •   • •|11010010|D2 |3|3|")
  ManualsHelp_L("|            |.pc<-nn                     |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
