  ManualsHelp_L("		+1: GET offset")
  ManualsHelp_L("		+2: backup character")
  ManualsHelp_L("		+3: queue length")
  ManualsHelp_L("		+4: queue address")
  ManualsHelp_L("		+5: queue address")
