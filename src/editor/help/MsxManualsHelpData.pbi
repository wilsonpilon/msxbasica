  ManualsHelp_L("     |	|   |  -------------------------------")
  ManualsHelp_L("     |	| S |  ----------------")
  ManualsHelp_L("     |	|   |--| MAIN RAM 64K |")
  ManualsHelp_L("     |	| L |  ----------------")
  ManualsHelp_L("     |	|   |  :::::::::::::::::  :::::::::::::::::")
  ManualsHelp_L("     |	| O |::: MEMORY MAPPER :::: RAM 64K to 4M :")
  ManualsHelp_L("     |	|   |  :::::::::::::::::  :::::::::::::::::")
  ManualsHelp_L("     |	| T |  :::::::::::::")
  ManualsHelp_L("     |	|   |::: CARTRIDGE :  I/O Cartridge (Disk, RS-232C)")
  ManualsHelp_L("     |	|   |  :::::::::::::  RAM Cartridge")
