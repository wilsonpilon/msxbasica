  ManualsHelp_L("  contents:	used internally by RS-232C routine")
  ManualsHelp_L("")
  ManualsHelp_L("RSFCB (FB04H, 2)")
  ManualsHelp_L("  contents:	FB04H + 0:  LOW address of RS-232C")
  ManualsHelp_L("		FB04H + 1:  HIGH address of RS-232C")
  ManualsHelp_L("")
