  ManualsHelp_L("|bc nn       |if c=1                      |• • • •   • •|11011010|DA |3|3|")
  ManualsHelp_L("|            |.pc<-nn                     |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|bpo nn      |if P/v=0                    |• • • •   • •|11100010|E2 |3|3|")
  ManualsHelp_L("|            |.pc<-nn                     |             |<-nnl ->|   | | |")
  ManualsHelp_L("|            |                            |             |<-nnh ->|   | | |")
  ManualsHelp_L("+------------+----------------------------+-------------+--------+---+-+-+")
  ManualsHelp_L("|bpe nn      |if P/v=1                    |• • • •   • •|11101010|EA |3|3|")
