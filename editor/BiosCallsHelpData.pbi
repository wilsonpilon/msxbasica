  BiosCallsHelp_L("")
  BiosCallsHelp_L(Chr(34) + "HD#" + Chr(34) + " (in ASCII) indicates that the ROM is an SCSI controller.")
  BiosCallsHelp_Commit("SCSI BIOS ROM ID", "Disk-ROM")

