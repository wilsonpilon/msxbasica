  BiosCallsHelp_L("4074: jp     $40b3")
  BiosCallsHelp_L("4077: jp     $40b6")
  BiosCallsHelp_L("407A: jp     $40b9")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-->")
  BiosCallsHelp_Commit("407AH", "Hangul-ROM")

