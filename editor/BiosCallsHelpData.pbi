  BiosCallsHelp_L("FB18 DATCNT  Hook")
  BiosCallsHelp_L("FB1B ERRORS")
  BiosCallsHelp_L("FB1C FLAGS")
  BiosCallsHelp_L("FB1D ESTBLS")
  BiosCallsHelp_L("FB1E COMMSK")
  BiosCallsHelp_L("FB1F LSTCOM")
