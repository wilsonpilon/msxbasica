  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0141H INIPLT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Initializes the color-palette with standardized values. A copy of these colors is also kept in VRAM memory.")
  BiosCallsHelp_L("Palettenumber | Color | Red | Green | Blue")
  BiosCallsHelp_L("0 (0H) | transparent | 0 | 0 | 0")
  BiosCallsHelp_L("1 (1H) | black | 0 | 0 | 0")
  BiosCallsHelp_L("2 (2H) | green | 1 | 6 | 1")
  BiosCallsHelp_L("3 (3H) | lightgreen | 3 | 7 | 3")
  BiosCallsHelp_L("4 (4H) | darkblue | 1 | 1 | 7")
  BiosCallsHelp_L("5 (5H) | lightblue | 2 | 3 | 7")
  BiosCallsHelp_L("6 (6H) | darkred | 5 | 1 | 1")
  BiosCallsHelp_L("7 (7H) | cyan | 2 | 6 | 7")
  BiosCallsHelp_L("8 (8H) | red | 7 | 1 | 1")
  BiosCallsHelp_L("9 (9H) | lightred | 7 | 3 | 3")
  BiosCallsHelp_L("10 (AH) | darkyellow | 6 | 6 | 1")
  BiosCallsHelp_L("11 (BH) | lightyellow | 6 | 6 | 4")
  BiosCallsHelp_L("12 (CH) | darkgreen | 1 | 4 | 1")
  BiosCallsHelp_L("13 (DH) | magenta | 6 | 2 | 5")
  BiosCallsHelp_L("14 (EH) | gray | 5 | 5 | 5")
  BiosCallsHelp_L("15 (FH) | white | 7 | 7 | 7")
  BiosCallsHelp_L("The VRAM address where those 32 data-bytes are stored depends on the current screen-mode: see RSTPLT (0145H)")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI ?")
  BiosCallsHelp_Commit("INIPLT", "SubROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0145H RSTPLT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Restores palette-colors by using values, which are stored in VRAM. Their location depends on the current screen-mode:")
  BiosCallsHelp_L("Screen 0 (40 chars) | 0400H-041FH")
  BiosCallsHelp_L("Screen 0 (80 chars) | 0F00H-0F1FH")
  BiosCallsHelp_L("Screen 1 | 2020H-203FH")
  BiosCallsHelp_L("Screen 2 | 2020H-203FH")
  BiosCallsHelp_L("Screen 3 | 2020H-203FH")
  BiosCallsHelp_L("Screen 4 | 2020H-203FH")
  BiosCallsHelp_L("Screen 5 | 7680H-769FH")
  BiosCallsHelp_L("Screen 6 | 7680H-769FH")
  BiosCallsHelp_L("Screen 7 | FA80H-FA9FH")
  BiosCallsHelp_L("Screen 8 | FA80H-FA9FH")
  BiosCallsHelp_L("The palette requires 2 bytes for each color. The parts for R/G/B (Red, Green, Blue) have to be in range from 0 to 7 and are defined as following:")
  BiosCallsHelp_L("Byte 0: | 0 R R R 0 B B B")
  BiosCallsHelp_L("Byte 1: | 0 0 0 0 0 G G G")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI ?")
  BiosCallsHelp_Commit("RSTPLT", "SubROM")

