  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FB20 LSTMOD, HOKVLD")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If bit-0 (LSB) is 0, there is no extended BIOS nor the mapper support. Otherwise,")
  BiosCallsHelp_L(Chr(34) + "EXTBIO" + Chr(34) + " entry (see below) has been set up and it can be called with various parameters.")
  BiosCallsHelp_L("Note that this test is unnecessary for the applications which are based on MSX-DOS (such as")
  BiosCallsHelp_L("the program which is loaded from the disk), and the program may proceed to the next step.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("                Data area used by MSX-DOS")
  BiosCallsHelp_L("FB21-FB28 DRVINF: DEFS 8")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2 bytes entry per DiskROM:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("00: number of drives handled by this DiskROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("01: slot ID of this DiskROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("for each of all 4 possible disk-ROMs.")
  BiosCallsHelp_Commit("FB20", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FB29-FB34: DEFS 12")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Table with slot ID and start-adress of the interrupt-routines for all 4 possible disk-ROMs.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("00: slot ID of this DiskROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("01+02: adress of the interrupt-routine")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("                  music")
  BiosCallsHelp_L("FB35 PRSCNT")
  BiosCallsHelp_L("FB36 SAVSP")
  BiosCallsHelp_L("FB38 VOICEN")
  BiosCallsHelp_L("FB39 SAVVOL")
  BiosCallsHelp_L("FB3B MCLLEN")
  BiosCallsHelp_L("FB3C MCLPTR")
  BiosCallsHelp_L("FB3E QUEUEN")
  BiosCallsHelp_L("FB3F MUSICF")
  BiosCallsHelp_L("FB40 PLYCNT")
  BiosCallsHelp_L("FB41 VCBA")
  BiosCallsHelp_L("FB66 VCBB")
  BiosCallsHelp_L("FB8B VCBC")
  BiosCallsHelp_Commit("FB29", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBB0 ENSTOP   <>0 if warm start enabled")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable determines whether the interrupt handler will")
  BiosCallsHelp_L("execute a warm start to the Interpreter upon detecting the keys")
  BiosCallsHelp_L("CODE, GRPH, CTRL and SHIFT depressed together: 00H=disable,")
  BiosCallsHelp_L("NZ=enable.")
  BiosCallsHelp_Commit("ENSTOP", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBB1 BASROM   <>0 if basic is in rom")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable determines whether the ISCNTC and INLIN standard")
  BiosCallsHelp_L("routines will respond to the CTRL-STOP key: 00H=enable,")
  BiosCallsHelp_L("NZ=disable. It is used to prevent termination of a BASIC ROM")
  BiosCallsHelp_L("located duringthe power-up ROM search.")
  BiosCallsHelp_Commit("BASROM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBB2 LINTTB: DEFS 24   ;line terminator table")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Each of these twenty-four variables is normally non-zero but is")
  BiosCallsHelp_L("zeroed if the contents of the corresponding screen-row have")
  BiosCallsHelp_L("overflowed to the next row. They are maintained by the BIOS")
  BiosCallsHelp_L("but only actually used by the INLIN standard routine (the")
  BiosCallsHelp_L("screen editor) to discriminate between logical and physical")
  BiosCallsHelp_L("lines.")
  BiosCallsHelp_Commit("FBB2", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBCA FSTPOS: DEFW 0000H   ;first position for inlin")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used to hold the cursor coordinates upon entry")
  BiosCallsHelp_L("to the INLIN standard routine. Its function is to restrict the")
  BiosCallsHelp_L("extent of backtracking performed when the text is collected")
  BiosCallsHelp_L("from the screen at termination.")
  BiosCallsHelp_Commit("FBCA", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBCC CURSAV,CODSAV   code save area for cursor")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used to hold the screen character replaced by")
  BiosCallsHelp_L("the text cursor.")
  BiosCallsHelp_Commit("FBCC", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBCD FNKSWI: DB   00H   ;indicate which func key is displayed")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used by the CHSNS standard routine to")
  BiosCallsHelp_L("determine whether the shifted or unshifted function keys")
  BiosCallsHelp_L("are currently displayed: 00H=shifted, 01H=unshifted.")
  BiosCallsHelp_Commit("FBCD", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBCE FNKFLG: DEFS 10   ;fkey which have subroutine")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Each of these ten variables is normally zero but is set to 01H")
  BiosCallsHelp_L("if the associated function key has been turned on by a " + Chr(34) + "KEY(n)")
  BiosCallsHelp_L("ON" + Chr(34) + " statement. They are used by the interrupt handler to")
  BiosCallsHelp_L("determine whether, in program mode only, it should return a")
  BiosCallsHelp_L("character string or update the associated entry in TRPTBL.")
  BiosCallsHelp_Commit("FBCE", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBD8 ONGSBF   global event flag")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is normally zero, but is incremented by the")
  BiosCallsHelp_L("interrupt handler whenever a device has achieved the conditions")
  BiosCallsHelp_L("necessary to generate a program interrupt. It is used by the")
  BiosCallsHelp_L("Runloop to determine whether any program interrupts are pending")
  BiosCallsHelp_L("without having to search TRPTBL.")
  BiosCallsHelp_Commit("ONGSBF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBD9 CLIKFL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used internally by the interrupt handler to")
  BiosCallsHelp_L("prevent spurious key clicks when returning multiple characters")
  BiosCallsHelp_L("from a single key depression such as a function key.")
  BiosCallsHelp_Commit("CLIKFL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBDA OLDKEY: DEFS 11")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer is used by the interrupt handler to hold the")
  BiosCallsHelp_L("previous state of the keyboard matrix, each byte contains one")
  BiosCallsHelp_L("row of keys starting with row 0.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: bits of pressed keys are 0, where bits of released keys are 1.")
  BiosCallsHelp_Commit("FBDA", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBE5 NEWKEY: DEFS 11")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer is used by the interrupt handler to hold the")
  BiosCallsHelp_L("current state of the keyboard matrix. The key transitions are")
  BiosCallsHelp_L("detected by comparison with the contents of OLDKEY after which")
  BiosCallsHelp_L("OLDKEY is updated with the current state.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: bits of pressed keys are 0, where bits of released keys are 1.")
  BiosCallsHelp_Commit("FBE5", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FBF0 KEYBUF: DEFS 40   ;key code buffer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer contains the decoded keyboard characters produced")
  BiosCallsHelp_L("by the interrupt handler. Note that the buffer is organized as")
  BiosCallsHelp_L("a circular queue driven by GETPNT and PUTPNT and consequently")
  BiosCallsHelp_L("has no fixed starting point.")
  BiosCallsHelp_Commit("FBF0", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC18 BUFEND            ;end of key buffer")
  BiosCallsHelp_L("FC18 LINWRK: DEFS 40")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer is used by the BIOS to hold a complete line of")
  BiosCallsHelp_L("screen characters.")
  BiosCallsHelp_Commit("BUFEND", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC40 PATWRK: DEFS 8")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer is used by the BIOS to hold an 8x8 pixel pattern.")
  BiosCallsHelp_Commit("FC40", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC48 BOTTOM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the lowest RAM location")
  BiosCallsHelp_L("used by the Interpreter. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter unaltered.")
  BiosCallsHelp_Commit("BOTTOM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC4A HIMEM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the byte following the")
  BiosCallsHelp_L("highest RAM location used by the interpreter. Its value is")
  BiosCallsHelp_L("set at power-up and thereafter only altered by the " + Chr(34) + "CLEAR" + Chr(34))
  BiosCallsHelp_L("statement.")
  BiosCallsHelp_Commit("HIMEM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC4C TRPTBL  DEFS 3     ;KEY 1")
  BiosCallsHelp_L("FC4F         DEFS 3     ;KEY 2")
  BiosCallsHelp_L("FC52         DEFS 3     ;KEY 3")
  BiosCallsHelp_L("FC55         DEFS 3     ;KEY 4")
  BiosCallsHelp_L("FC58         DEFS 3     ;KEY 5")
  BiosCallsHelp_L("FC5B         DEFS 3     ;KEY 6")
  BiosCallsHelp_L("FC5E         DEFS 3     ;KEY 7")
  BiosCallsHelp_L("FC61         DEFS 3     ;KEY 8")
  BiosCallsHelp_L("FC64         DEFS 3     ;KEY 9")
  BiosCallsHelp_L("FC67         DEFS 3     ;KEY 10")
  BiosCallsHelp_L("FC6A         DEFS 3     ;STOP")
  BiosCallsHelp_L("FC6D         DEFS 3     ;SPRITE")
  BiosCallsHelp_L("FC70         DEFS 3     ;STRIG 0")
  BiosCallsHelp_L("FC73         DEFS 3     ;STRIG 1")
  BiosCallsHelp_L("FC76         DEFS 3     ;STRIG 2")
  BiosCallsHelp_L("FC79         DEFS 3     ;STRIG 3")
  BiosCallsHelp_L("FC7C         DEFS 3     ;STRIG 4")
  BiosCallsHelp_L("FC7F         DEFS 3     ;INTERVAL")
  BiosCallsHelp_L("FC82         DEFS 3     ;unused")
  BiosCallsHelp_L("FC85         DEFS 3     ;unused")
  BiosCallsHelp_L("FC88         DEFS 3     ;unused")
  BiosCallsHelp_L("FC8B         DEFS 3     ;unused")
  BiosCallsHelp_L("FC8E         DEFS 3     ;unused")
  BiosCallsHelp_L("FC91         DEFS 3     ;unused")
  BiosCallsHelp_L("FC94         DEFS 3     ;unused")
  BiosCallsHelp_L("FC97         DEFS 3     ;unused")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These twenty-six the byte variables hold the current state of")
  BiosCallsHelp_L("the interrupt generating devices. The first byte of each entry")
  BiosCallsHelp_L("contains the device status (bit 0=On, bit 1=Stop, bit 2=Event")
  BiosCallsHelp_L("active) and is updated by the interrupt handler, the Runloop")
  BiosCallsHelp_L("interrupt processor and the " + Chr(34) + "DEVICE ON/OFF/STOP" + Chr(34) + " and " + Chr(34) + "RETURN" + Chr(34))
  BiosCallsHelp_L("statement handlers. The remaining two bytes of each entry are")
  BiosCallsHelp_L("set by the " + Chr(34) + "ON DEVICE GOSUB" + Chr(34) + " statement handler and contain the")
  BiosCallsHelp_L("address of the program line to execute upon a program")
  BiosCallsHelp_L("interrupt.")
  BiosCallsHelp_Commit("TRPTBL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC9A RTYCNT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is unused by the current MSX ROM.")
  BiosCallsHelp_Commit("RTYCNT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FC9B INTFLG")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is normally zero but set to 03H or 04H if the")
  BiosCallsHelp_L("CTRL-STOP or STOP key are detected by the interrupt handler.")
  BiosCallsHelp_Commit("INTFLG", "RAM-variables")

