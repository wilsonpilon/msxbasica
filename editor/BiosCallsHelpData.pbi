  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F341         Slot-Id of RAM in page 0")
  BiosCallsHelp_L("F342         Slot-Id of RAM in page 1")
  BiosCallsHelp_L("F343         Slot-Id of RAM in page 2")
  BiosCallsHelp_L("F344         Slot-Id of RAM in page 3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("For every page: slot-Id of RAM. Is only valid if a DiskROM is present and active.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: In case of active Disk-Basic 2 or MSX-DOS 2 this refers always to a memory-mapper.")
  BiosCallsHelp_L("If Disk-Basic 2 or MSX-DOS 2 is not active a RAM-expansion in a prior slot (before the")
  BiosCallsHelp_L("memory-mapper) may take precedence, so that it's not used - even if a mapper is available")
  BiosCallsHelp_L("in a slot with higher Slot-Id.")
  BiosCallsHelp_Commit("F341", "RAM-variables")

