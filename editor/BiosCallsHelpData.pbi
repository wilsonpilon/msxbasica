  BiosCallsHelp_L("B = # of blocks to write")
  BiosCallsHelp_L("C D E = 21 bit logical block #")
  BiosCallsHelp_L("HL = transfer address")
  BiosCallsHelp_L("Exit: | A = SCSI STATUS")
  BiosCallsHelp_L("D = Target Status")
  BiosCallsHelp_L("E = Message")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, IX, IY, HL")
  BiosCallsHelp_L("Note: | See ANSI 8.2.5")
  BiosCallsHelp_Commit("WrLogBlk", "Disk-ROM")

  BiosCallsHelp_Begin()
