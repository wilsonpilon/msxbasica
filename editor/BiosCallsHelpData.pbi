  BiosCallsHelp_L("Output: After execution of 1st ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("02H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("After execution of 2nd ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("02H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("After execution of zen_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Lot number within a candidate block")
  BiosCallsHelp_L("to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("02H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("ji_block (4AH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 4AH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If A is 0, it means there")
  BiosCallsHelp_L("is no suitable block group.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If A is other than 0 then it's a number")
  BiosCallsHelp_L("of candidates.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This sends a group of candidate block")
  BiosCallsHelp_L("to next level, by retracting length of header bunsetsu, regarding")
  BiosCallsHelp_L("sense of terms in different way and other means, and remakes group")
  BiosCallsHelp_L("of candidate blocks. You must read with henkan1 to set the data")
  BiosCallsHelp_L("before you call this function. Acquire the result through ji_koho")
  BiosCallsHelp_L("or other means.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: After execution of 1st ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("08H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Execute ji_block, then execute a 2nd")
  BiosCallsHelp_L("ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("08H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("zen_block (4BH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 4BH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Output: If A is 0, it means")
  BiosCallsHelp_L("there is no suitable block group.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If A is other than 0 then it's a number")
  BiosCallsHelp_L("of candidates.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This sends a group of candidate back")
  BiosCallsHelp_L("to prior level, and remakes group of candidate blocks. You must")
  BiosCallsHelp_L("read with henkan1 to set the data before you call this function.")
  BiosCallsHelp_L("You are not requested to call ji_block before execution of this")
  BiosCallsHelp_L("function, however.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: After execution of 1st ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("08H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Execute ji_block, then execute a 2nd")
  BiosCallsHelp_L("ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("08H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Then execute zen_block, then execute")
  BiosCallsHelp_L("ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("08H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("kakutei1 (4CH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 4CH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Lot number within a candidate block")
  BiosCallsHelp_L("to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of conversion result container")
  BiosCallsHelp_L("buffer to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Conversion result will be")
  BiosCallsHelp_L("contained in the buffer stated by BC.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This finalizes (" + Chr(34) + "kakutei" + Chr(34) + ")")
  BiosCallsHelp_L("the candidate specified by E register, as the result of conversion.")
  BiosCallsHelp_L("Result enters into address stated by BC. You must read with henkan1")
  BiosCallsHelp_L("to set the data before you call this function. You are not requested")
  BiosCallsHelp_L("to call ji_block or similar functions before execution of this")
  BiosCallsHelp_L("function.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: Lot number within a candidate")
  BiosCallsHelp_L("block to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: 0AH+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("kakutei2 (4DH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 4DH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Lot number within a candidate block")
  BiosCallsHelp_L("to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of conversion result container")
  BiosCallsHelp_L("buffer to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Pronounced length of header")
  BiosCallsHelp_L("bunsetsu (byte length)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Conversion result will be contained")
  BiosCallsHelp_L("in the buffer stated by BC.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This finalizes (" + Chr(34) + "kakutei" + Chr(34) + ")")
  BiosCallsHelp_L("the candidate specified by E register. Pronounced length of the")
  BiosCallsHelp_L("finalized header bunsetsu enters A, while conversion result enters")
  BiosCallsHelp_L("into address stated by BC. A " + Chr(34) + "pronounced length" + Chr(34) + " is")
  BiosCallsHelp_L("a length of conversion result when it is read in all kanas (no")
  BiosCallsHelp_L("kanjis). You must read with henkan1 to set the data before you")
  BiosCallsHelp_L("call this function. You are not requested to call ji_block or")
  BiosCallsHelp_L("similar functions before execution of this function.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: Lot number within a candidate")
  BiosCallsHelp_L("block to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Pronounced length of header bunsetsu")
  BiosCallsHelp_L("(08H) to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("0AH+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("close_dic (4EH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Users are not expected to call this")
  BiosCallsHelp_L("function.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("touroku (4FH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 4FH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of pronunciation buffer to")
  BiosCallsHelp_L("DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of term registration buffer")
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If A=0, it means registration")
  BiosCallsHelp_L("was successful.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=1 means registration failed, because")
  BiosCallsHelp_L("there was no empty space.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=2 means registration failed, because")
  BiosCallsHelp_L("there were too many homonyms.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=4 means registration failed because")
  BiosCallsHelp_L("pronunciation data was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=8 means registration failed because")
  BiosCallsHelp_L("term data was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=16 means registration failed because")
  BiosCallsHelp_L("grammar (sense) was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This registers (" + Chr(34) + "touroku" + Chr(34) + ")")
  BiosCallsHelp_L("a term into the user dictionary.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Formats for pronunciation data and")
  BiosCallsHelp_L("term data are as follows.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("[number of characters]+" + Chr(34) + "[pronunciation")
  BiosCallsHelp_L("data (zenkaku katakanas, max. 64 bytes)]" + Chr(34) + " to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("[number of characters]+" + Chr(34) + "[term")
  BiosCallsHelp_L("data (zenkaku characters, max. 64 bytes)]" + Chr(34) + "+[sense code]" + Chr(34))
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Pronunciation data should be in zenkaku")
  BiosCallsHelp_L("katakanas, 2 bytes or more, 64 bytes or less (which means between")
  BiosCallsHelp_L("1 to 32 characters long), and should not include characters " + Chr(34) + Chr(34) + ",")
  BiosCallsHelp_L(Chr(34) + Chr(34) + ",")
  BiosCallsHelp_L(Chr(34) + Chr(34) + ",")
  BiosCallsHelp_L(Chr(34) + Chr(34) + ",")
  BiosCallsHelp_L(Chr(34) + Chr(34) + " or " + Chr(34) + Chr(34) + ".")
  BiosCallsHelp_L("Term data should be in SHIFT-JIS codes, with characters restriction")
  BiosCallsHelp_L("between 2 to 64 bytes, like pronunciation data. You can register")
  BiosCallsHelp_L("up to 255 homonyms (there are quite many homonyms in Japanese")
  BiosCallsHelp_L("language, which are spelled with different kanjis). Choose a sense")
  BiosCallsHelp_L("out of following 5.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("1 for nouns (like natto (fermented")
  BiosCallsHelp_L("beans)), 2 for surnames (like Tokugawa), 3 for first names (like")
  BiosCallsHelp_L("Mitsukuni), 4 for location names (like Mito, a city which houses")
  BiosCallsHelp_L("both natto and Mitsukuni Tokugawa;), and 5 for verbs which require")
  BiosCallsHelp_L(Chr(34) + "suru" + Chr(34) + " suffix (like shipansuru (" + Chr(34) + "to judge" + Chr(34) + ")")
  BiosCallsHelp_L("or kagakusuru (" + Chr(34) + "let scientific mind work" + Chr(34) + "))")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If your MSX-JE does not support term")
  BiosCallsHelp_L("registration (VJE-80 from ASCII for example), then this function")
  BiosCallsHelp_L("returns FFH to A.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: You registered term " + Chr(34) + Chr(34) + ",")
  BiosCallsHelp_L("which is pronounced " + Chr(34) + Chr(34))
  BiosCallsHelp_L("and has a sense of surname.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 0AH+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34) + "+02H")
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: 0 to A (successful registration)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("sakujo (50H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 50H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of pronunciation buffer to")
  BiosCallsHelp_L("DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of term registration buffer")
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If A=0, it means deletion")
  BiosCallsHelp_L("was successful.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=1 means deletion failed because")
  BiosCallsHelp_L("it was not found in dictionary.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=2 means deletion failed because")
  BiosCallsHelp_L("pronunciation data was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=8 means deletion failed because")
  BiosCallsHelp_L("term data was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=16 means deletion failed because")
  BiosCallsHelp_L("sense was improper.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This deletes (" + Chr(34) + "sakujo" + Chr(34) + ")")
  BiosCallsHelp_L("a term from the user dictionary. Formats of data are same as touroku.")
  BiosCallsHelp_L("If your MSX-JE does not support this function, then it returns")
  BiosCallsHelp_L("FFH to A.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These so far are function calls defined")
  BiosCallsHelp_L("to MSX-JE. Normally, these functions are enough, but since VJE-80A")
  BiosCallsHelp_L("defines several other function calls as expansion, so we describe")
  BiosCallsHelp_L("them too.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("henkan2 (58H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 58H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of zenkaku katakana string")
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Number of candidates to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Execution is exactly identical to")
  BiosCallsHelp_L("henkan1. VJE-80 returns presence/absence of candidates (1: at")
  BiosCallsHelp_L("least one candidates is available).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("number of candidates (59H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 59H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Number of candidates for current")
  BiosCallsHelp_L("candidate block")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This returns number of candidates")
  BiosCallsHelp_L("available for candidate block currently under conversion.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("henkan3 (5AH)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 5AH to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Number of candidates for header")
  BiosCallsHelp_L("bunsetsu of proceeding bunsetsu")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This repeats the conversion over the")
  BiosCallsHelp_L("part which was regarded as proceeding bunsetsu.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("After execution of 1st ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Execute henkan3, then execute ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("02H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("hiragana (60H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 60H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Candidate buffer to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Proceeding bunsetsu buffer to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: A=0 means successful completion.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=FFH means operation quitted abnormally")
  BiosCallsHelp_L("(error).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This converts the header bunsetsu")
  BiosCallsHelp_L("which was most lately converted into zenkaku hiragana string of")
  BiosCallsHelp_L("equivalent pronunciation. You must acquire candidates through")
  BiosCallsHelp_L("functions like ji_koho or zen_koho before using this function.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Example: Suppose you tried to convert")
  BiosCallsHelp_L("an input " + Chr(34) + Chr(34))
  BiosCallsHelp_L("using henkan1 prior.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("After execution of 1st ji_koho")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("04H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Then execute hiragana")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("06H+" + Chr(34) + Chr(34))
  BiosCallsHelp_L("to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("katakana (61H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 61H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Candidate buffer to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Proceeding bunsetsu buffer to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: A=0 means successful completion.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A=FFH means operation quitted abnormally")
  BiosCallsHelp_L("(error).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This converts the header bunsetsu")
  BiosCallsHelp_L("which was most lately converted into zenkaku katakana string of")
  BiosCallsHelp_L("equivalent pronunciation. You must acquire candidates through")
  BiosCallsHelp_L("functions like ji_koho or zen_koho before using this function.")
  BiosCallsHelp_L("All others are same with hiragana function")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Descriptions of expanded function")
  BiosCallsHelp_L("calls ends here. Note, these expanded function calls return FFH")
  BiosCallsHelp_L("to A if your MSX-JE does not support them. For instance, since")
  BiosCallsHelp_L("hiragana and katakana functions are not supported by VJE-80, so")
  BiosCallsHelp_L("they will return FFH to A if you execute them on VJE-80.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("For your notice, if in future the")
  BiosCallsHelp_L("functions not defined yet will be added, they will be assigned")
  BiosCallsHelp_L("to functions 62H and later, by youngest order.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Chapter 4 Virtual Terminal Interface")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("We described about basic usage of")
  BiosCallsHelp_L("MSX-JE, but they are for use of word processor software and like")
  BiosCallsHelp_L("when they want to convert kanjis. They are still too much a workload")
  BiosCallsHelp_L("when a simple user want use a little bit of MSX-JE functions in")
  BiosCallsHelp_L("their programs. Therefore, MSX-JE supports a facility called virtual")
  BiosCallsHelp_L("terminal interface, which allows you to use MSX-JE functions with")
  BiosCallsHelp_L("relative ease. In this, a virtual terminal do all kanji conversion")
  BiosCallsHelp_L("processes, and what program should do is to display character")
  BiosCallsHelp_L("strings which the virtual terminal return. When virtual terminal")
  BiosCallsHelp_L("is used, work flow is as follows.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("1) When a program wants to input Japanese,")
  BiosCallsHelp_L("it opens a window in a screen, and call virtual terminal.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2) User looks at it (the window in")
  BiosCallsHelp_L("this case), and input, say, YUUGURE.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("3) Virtual terminal converts that")
  BiosCallsHelp_L("to ,")
  BiosCallsHelp_L("and returns the converted one to program.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("4) The program displays ")
  BiosCallsHelp_L("on the window it opened, and gives the responsibility of execution")
  BiosCallsHelp_L("back to virtual terminal.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5) User looks at ,")
  BiosCallsHelp_L("and press conversion key.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("6) Virtual terminal, knowing that")
  BiosCallsHelp_L("conversion key was pressed, converts ")
  BiosCallsHelp_L("to ,")
  BiosCallsHelp_L("and returns it to the program.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("7) Program displays ")
  BiosCallsHelp_L("in window, and gives the execution responsibility back to virtual")
  BiosCallsHelp_L("terminal.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("8) User looks at it, and press finalizing")
  BiosCallsHelp_L("key.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("9) Virtual terminal, knowing that")
  BiosCallsHelp_L("finalizing key was pressed, returns the notion that result was")
  BiosCallsHelp_L("finalized as ")
  BiosCallsHelp_L("to the program.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("10) ")
  BiosCallsHelp_L("is input.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Kanji BASIC supported by MSX2+ and")
  BiosCallsHelp_L("later does this way, so if you cannot understand above, try booting")
  BiosCallsHelp_L("kanji BASIC or so and convert kanjis. A program (BASIC interpreter")
  BiosCallsHelp_L("in this case) calls virtual terminal when CTRT+SPACE are pressed,")
  BiosCallsHelp_L("then window opens in lowest line, and tells you that MSX entered")
  BiosCallsHelp_L("kanji conversion mode. When you input the characters, virtual")
  BiosCallsHelp_L("terminal converts, while program (BASIC interpreter) displays")
  BiosCallsHelp_L("them in the window. If you press finalizing key (RETURN), then")
  BiosCallsHelp_L("character string present in window then are assumed as your input.")
  BiosCallsHelp_L("Finally, when you press CTRL+SPACE, program quits out of kanji")
  BiosCallsHelp_L("input mode.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If you try to use MSX-JE functions")
  BiosCallsHelp_L("directly, then your program should process everything including")
  BiosCallsHelp_L("whether conversion or finalizing keys are pressed or not. On the")
  BiosCallsHelp_L("other hand, if you use virtual terminal, if you make a window")
  BiosCallsHelp_L("and call the terminal, then what you should do is to display ongoing")
  BiosCallsHelp_L("processes and final result, so kanji input will cost you far less.")
  BiosCallsHelp_L("As a price to pay, window size has restriction, and keys to finalize")
  BiosCallsHelp_L("or to convert are fixed, since virtual terminal processes such")
  BiosCallsHelp_L("steps.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("I recommend you to use MSX-JE when")
  BiosCallsHelp_L("you make your own word processor, and virtual terminal in cases")
  BiosCallsHelp_L("you want to prompt some kanji input in your modem software or")
  BiosCallsHelp_L("so.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5.4.2 How to Boot Virtual Terminal")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Boot process for virtual terminal")
  BiosCallsHelp_L("is exactly same with that for MSX-JE. Call address FFCAH to check")
  BiosCallsHelp_L("interslot call address for MSX-JE (virtual terminal), call function")
  BiosCallsHelp_L("1 (see 5.3.2, MSX-JE Function Calls) to check necessary size of")
  BiosCallsHelp_L("work area, and call function 2 to boot MSX-JE (virtual terminal).")
  BiosCallsHelp_L("When you have finished using virtual terminal facility, call function")
  BiosCallsHelp_L("3 to quit virtual terminal.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5.4.3 Character Strings Outputted")
  BiosCallsHelp_L("by Virtual Terminal")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("As explained in 5.4.1,")
  BiosCallsHelp_L("a virtual terminal does not display character strings it converted,")
  BiosCallsHelp_L("but prefers to return them to the program and let it to display")
  BiosCallsHelp_L("them. This is, to allow program to choose position of the window,")
  BiosCallsHelp_L("and to enable use of virtual terminal in any screen mode. You")
  BiosCallsHelp_L("can use virtual terminal in interlaced screen 6 or in screen 2")
  BiosCallsHelp_L("because of this feature. While window is mostly located on lowest")
  BiosCallsHelp_L("line, but you are free to locate it, say, in middle of the screen.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Character string data are in a little")
  BiosCallsHelp_L("strange format, for occasions like when a virtual terminal wants")
  BiosCallsHelp_L("cursor to vanish. The format is called STB format. Programs are")
  BiosCallsHelp_L("supposed to display character strings of STB format to the window.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Format of STB")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("1: SHIFT-JIS character string")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Displays a character on cursor position,")
  BiosCallsHelp_L("and cursor advances. Hankaku western and katakanas are possible.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2: NULL (0)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("End of text.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("3: ^L (12)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Wipes away the window. Cursor returns")
  BiosCallsHelp_L("to top of the screen.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("4: ^E (5)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Wipes away all characters later than")
  BiosCallsHelp_L("the cursor.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5: ^H (8)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A character before the cursor is deleted,")
  BiosCallsHelp_L("and cursor moves back one space.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("6: ^R (18)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reverse the characters by length stated")
  BiosCallsHelp_L("by next 1 byte, from cursor position.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("7: ^Z (26)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Upper 4 bits of next 1 byte becomes")
  BiosCallsHelp_L("color of the character, while lower 4 bits are selected background")
  BiosCallsHelp_L("color.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("8: ^X (24)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Move the cursor. Next 1 byte is X-axis.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("9: ^Y (25)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Move the cursor. Next 1 byte is Y-axis.")
  BiosCallsHelp_L("(optional)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("10: ^W (23)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Open the window specified by next")
  BiosCallsHelp_L("1 byte. (optional)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("11: Any value between 0 to 15 and")
  BiosCallsHelp_L("is not mentioned above will be skipped. Any value between 16 to")
  BiosCallsHelp_L("31 and is not mentioned above will be skipped, and 1 byte next")
  BiosCallsHelp_L("to it will be skipped too.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Any positions of characters should")
  BiosCallsHelp_L("be specified by units of hankaku (1-byte). Be noted though, that")
  BiosCallsHelp_L("when you specify X-axis of a cursor, 1 is the initiating value,")
  BiosCallsHelp_L("and 0 means cursor will not be displayed.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Size of a window supported by virtual")
  BiosCallsHelp_L("terminal is 1 line * 28 characters (14 zenkaku characters), but")
  BiosCallsHelp_L("a program can use windows of other sizes. Function call 9 which")
  BiosCallsHelp_L("will be explained later is used in such cases. If you are going")
  BiosCallsHelp_L("to use default 1 line * 28 characters window, then you have no")
  BiosCallsHelp_L("need to support ^Y or ^W.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If you open a window, the graphic")
  BiosCallsHelp_L("there will be wiped out, of course. If you do not want graphic")
  BiosCallsHelp_L("to be gone, then you must let program to reserve such contents.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A virtual terminal assumes that information")
  BiosCallsHelp_L("like contents of windows or cursor position are kept when it is")
  BiosCallsHelp_L("working, so make sure you do not harm such information. For instance,")
  BiosCallsHelp_L("when you add one character on end of a character string, virtual")
  BiosCallsHelp_L("terminal only returns one character long STB.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5.4.4 Virtual Terminal Function")
  BiosCallsHelp_L("Calls")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Virtual terminal functions can be")
  BiosCallsHelp_L("called by same procedure you follow to use MSX-JE normally.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Interslot-call the address you acquired")
  BiosCallsHelp_L("by calling address FFCAH. Function 05H, 08H, 09H and 0AH are optional;")
  BiosCallsHelp_L("some MSX-JEs lack them.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("clear (Function 04H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 04H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: None")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This clears buffer for kanji conversion.")
  BiosCallsHelp_L("Use this when you want to clear inputted text so far.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("set TTB (05H; optional. Some MSX-JEs")
  BiosCallsHelp_L("lack this function)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 05H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of text data you want to re-convert")
  BiosCallsHelp_L("to DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of TTB to BC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If A=0, it means re-conversion")
  BiosCallsHelp_L("is possible.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("FFH means re-conversion is impossible.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Use this when you want to convert")
  BiosCallsHelp_L("a specific character string. If your MSX-JE does not support this")
  BiosCallsHelp_L("function (like VJE-80A), it returns FFH to A.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("dispatch (06H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 06H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Status to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of STB to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This dispatches processor resource")
  BiosCallsHelp_L("from application to virtual terminal. Or, simply said, it starts")
  BiosCallsHelp_L("kanji conversion. A virtual terminal sets the parameters and temporarily")
  BiosCallsHelp_L("gives away execution responsibility to program in cases like when")
  BiosCallsHelp_L("it displays characters in window. The program then displays STB")
  BiosCallsHelp_L("the virtual terminal returned on window, looks at statuses, and")
  BiosCallsHelp_L("decide what program has to do afterward. STB is within BW.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Meaning of statuses are as follows.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bit 0: if 1, then program displays")
  BiosCallsHelp_L("STB.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bit 1: if 1, then program can get")
  BiosCallsHelp_L("conversion result.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bit 2: If 1, it means conversion at")
  BiosCallsHelp_L("virtual terminal is completed.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Meaning for each statuses;")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("000 Virtual terminal ignored key inputs,")
  BiosCallsHelp_L("or no key inputs occured")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("001 In middle of inputs, or in middle")
  BiosCallsHelp_L("of conversion")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("010 Partially finalized")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("011 Partially finalized")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("100 Conversion was interrupted and")
  BiosCallsHelp_L("quitted")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("101 Conversion was interrupted and")
  BiosCallsHelp_L("quitted")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("110 Wholly finalized")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("111 Wholly finalized")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("You must let your program to look")
  BiosCallsHelp_L("at 3 bits independently. For instance, if all 3 bits are standing,")
  BiosCallsHelp_L("then your program firstly should display STB, acquire the result")
  BiosCallsHelp_L("of conversion using function 07H, and quit dispatch function.")
  BiosCallsHelp_L("You can easily see that programs should repeat displaying to screen")
  BiosCallsHelp_L("and calling function 06H infinitely until bit 2 stands.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("get_result (07H)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 07H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Header address of acquired")
  BiosCallsHelp_L("conversion result to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This returns result of conversion.")
  BiosCallsHelp_L("The result will be returned in SHIFT-JIS format which ends with")
  BiosCallsHelp_L("00H.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("get_TTB (08H; optional. Some MSX-JEs")
  BiosCallsHelp_L("lack this function)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 07H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Address of TTB to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This gets the pronunciation data of")
  BiosCallsHelp_L("the text you acquired using get_result. The result will be returned")
  BiosCallsHelp_L("in TTB format. If your MSX-JE does not support this function (like")
  BiosCallsHelp_L("VJE-80A), it returns pointer to 0 to HL.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("* translator's note: " + Chr(34) + "TTB format" + Chr(34))
  BiosCallsHelp_L("might be misspelled " + Chr(34) + "STB format" + Chr(34) + ". ")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Inquire_window_size (09H; optional.")
  BiosCallsHelp_L("Some MSX-JEs lack this function)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 07H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Maximum length of tail format to E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Maximum height of window format to")
  BiosCallsHelp_L("B")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Maximum length of window format to")
  BiosCallsHelp_L("C")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: Window specification data")
  BiosCallsHelp_L("to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Window used by a virtual terminal")
  BiosCallsHelp_L("is 1 line * 28 characters (14 zenkaku characters) at default,")
  BiosCallsHelp_L("but you can use this function when you want to use windows of")
  BiosCallsHelp_L("other sizes. Enter size of window that your program can handle,")
  BiosCallsHelp_L("and call. You have no need to call this if you are going to use")
  BiosCallsHelp_L("a window of default size.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A window specification data is an")
  BiosCallsHelp_L("array of several window specification items, and ends with 0.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("3 bytes in one window specification")
  BiosCallsHelp_L("item is as follows.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("1st byte: Window type")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2nd byte: Window length")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("3rd byte: Window height")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("About window type, if you want to")
  BiosCallsHelp_L("let the input goes back to left tip of next line when it reaches")
  BiosCallsHelp_L("the rightmost tip of the screen, choose 2 (a window of this type")
  BiosCallsHelp_L("is called tail format), and if you do not want the input to back")
  BiosCallsHelp_L("to left, then choose 1 (a window of this type is called independent")
  BiosCallsHelp_L("format). Default window is of independent format.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If your virtual terminal is not supporting")
  BiosCallsHelp_L("the window of specified size and format, then it returns header")
  BiosCallsHelp_L("address of next data. In another word, it specified the default")
  BiosCallsHelp_L("window back again. [01H+1CH+01H+00H]")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("There is no guarantee that every virtual")
  BiosCallsHelp_L("terminals support the window of the size you want to use, so you")
  BiosCallsHelp_L("are not recommended to use this function in normal situations.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("conflict_detect (0AH; optional. Some")
  BiosCallsHelp_L("MSX-JEs lack this function)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: 07H to A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Address of BW to HL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If A is 0, then conflict is")
  BiosCallsHelp_L("not detected.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If A is FFH, it means conflict is")
  BiosCallsHelp_L("detected.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is used to transfer control responsibility")
  BiosCallsHelp_L("to virtual terminal, when you prefer to let the terminal to pick")
  BiosCallsHelp_L("up key input that program is supposed to pick up. This function")
  BiosCallsHelp_L("is for purpose of avoiding conflicts between keys which program")
  BiosCallsHelp_L("uses, and keys which virtual terminal uses. I do not expect much")
  BiosCallsHelp_L("use of this in normal occasions. ;)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The explanations for virtual terminal")
  BiosCallsHelp_L("function calls end here.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5.4.5 Specified Control Keys for")
  BiosCallsHelp_L("Virtual Terminal")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Virtual terminal processes")
  BiosCallsHelp_L("key inputs by itself. Therefore, if your program and virtual terminal")
  BiosCallsHelp_L("try assign same key for their functions, then program ends up")
  BiosCallsHelp_L("to hangup (a sort of malfunction).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("For instance, suppose you made the")
  BiosCallsHelp_L("program so it will transfer control responsibility to terminal")
  BiosCallsHelp_L("if you press SPACE key. At the same time, if a virtual terminal")
  BiosCallsHelp_L("assumed it will return the execution to program by pressing SPACE,")
  BiosCallsHelp_L("then if you press SPACE key then execution will keep bouncing")
  BiosCallsHelp_L("back and forth like badminton match;), never to return, leaving")
  BiosCallsHelp_L("a stroke SPACE of key buffer. To prevent these kind of things to")
  BiosCallsHelp_L("happen, there are several fixed agreements about keys that a virtual")
  BiosCallsHelp_L("terminal and application programs should take out of buffer.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("For virtual terminal;")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Keys that interrupt conversion without")
  BiosCallsHelp_L("removing contents of key buffer: F6 to F10 or CTRL+STOP")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Keys that interrupt conversion and")
  BiosCallsHelp_L("remove contents of key buffer: ESC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Keys that always remove contents of")
  BiosCallsHelp_L("key buffer: F1 to F5, SPACE or any character keys including graphic")
  BiosCallsHelp_L("characters")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("For application programs;")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Keys that always take out contents")
  BiosCallsHelp_L("of key buffer: F6 to F10, CTRL+STOP or any character keys including")
  BiosCallsHelp_L("graphic characters")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Keys that initiate conversion and")
  BiosCallsHelp_L("do not take out contents of key buffer: F1 to F5, SPACE or any")
  BiosCallsHelp_L("character keys including graphic characters")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A program needs to check these keys")
  BiosCallsHelp_L("during the period between the time it called _clear_ function")
  BiosCallsHelp_L("and the time it calls _dispatch_. Virtual terminal will do the")
  BiosCallsHelp_L("processes later then.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("By the way, you must check the first")
  BiosCallsHelp_L("character in key buffer without taking it out of key buffer if")
  BiosCallsHelp_L("you do not want to transgress this rule. For this purpose, use")
  BiosCallsHelp_L("following method.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Firstly, use the CHSNS (009CH) bios")
  BiosCallsHelp_L("to check whether there is any content in key buffer.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If it is not empty, you can find the")
  BiosCallsHelp_L("next key code to be taken out, in an address specified by 2 bytes")
  BiosCallsHelp_L("from address F3FAH.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Also, since an MSX cannot check whether")
  BiosCallsHelp_L("its function keys are pressed, virtual terminal sets following")
  BiosCallsHelp_L("codes to function keys to recognize function key strokes. These")
  BiosCallsHelp_L("values are set at the time you call _clear_ function. If you do")
  BiosCallsHelp_L("not want original contents to be gone, let your program to reserve")
  BiosCallsHelp_L("initial contents of function keys.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F1: 01H+31H, F2: 01H+32H, F3: 01H+33H,")
  BiosCallsHelp_L("F4: 01H+34H, F5: 01H+35H")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Moreover, if you set following values")
  BiosCallsHelp_L("to F6 to F10m then a virtual terminal processes then as F6 to")
  BiosCallsHelp_L("F10. Inputs of other values are regarded as input of equivalent")
  BiosCallsHelp_L("character strings, and will be processed so.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F6: FFH+36H, F7: FFH+37H, F8: FFH+38H,")
  BiosCallsHelp_L("F9: FFH+39H, F10: FFH+3AH")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("5.4.7 Keys Assigned by Virtual")
  BiosCallsHelp_L("Terminal ")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("[F1] | Switch input mode (romaji / western characters)")
  BiosCallsHelp_L("[F2] | Hiragana conversion")
  BiosCallsHelp_L("[F3] | Katakana conversion")
  BiosCallsHelp_L("[F4] | Convert to hankaku")
  BiosCallsHelp_L("[F5] | Convert using JIS code")
  BiosCallsHelp_L("[CTRL]+[F5] | Finalize all")
  BiosCallsHelp_L("[BS] | Step back and delete (backspace)")
  BiosCallsHelp_L("[DEL] | Delete a character on cursor position")
  BiosCallsHelp_L("[ESC] | Quit editing (keystrokes do not remain in buffer)")
  BiosCallsHelp_L("[RETURN] | Finalize partially (same as CTRL+F5 during edit)")
  BiosCallsHelp_L("[UP] | Start conversion (same as SPACE)")
  BiosCallsHelp_L("[DOWN] | Start conversion (same as SPACE)")
  BiosCallsHelp_L("[RIGHT] | Move cursor to right")
  BiosCallsHelp_L("[SHIFT]+[RIGHT] | Move cursor to rightmost")
  BiosCallsHelp_L("[LEFT] | Move cursor to left")
  BiosCallsHelp_L("[SHIFT]+[LEFT] | Move cursor to leftmost")
  BiosCallsHelp_L("[SPACE] | Start conversion")
  BiosCallsHelp_L("[SHIFT]+[SPACE] | Input zenkaku space (which is different with 1-byte space)")
  BiosCallsHelp_L("[CTRL]+[STOP] | Quit editing (keystrokes remain in buffer)")
  BiosCallsHelp_L("[F6] to [F10] | Quit editing (keystrokes remain in buffer)")
  BiosCallsHelp_L(" ")
  BiosCallsHelp_L("If there are any character strings")
  BiosCallsHelp_L("in buffer, and they are not keys mentioned above, such keystrokes")
  BiosCallsHelp_L("will be ignored and removed out of buffer. Even in such cases,")
  BiosCallsHelp_L("virtual terminal return the execution responsibility to your program")
  BiosCallsHelp_L("anyway (status is 000B in such state). It returns execution responsibility")
  BiosCallsHelp_L("when there is not key input at all, too. This is to enable your")
  BiosCallsHelp_L("program to process other jobs simultaneously with Japanese inputs.")
  BiosCallsHelp_L("If you do not need simultaneous tasktaking, then call _dispatch_")
  BiosCallsHelp_L("as is. If keys 00H to 1FH are pressed when there is no character")
  BiosCallsHelp_L("string during editing, then conversion quits while still leaving")
  BiosCallsHelp_L("such inputs in buffer. (status will be 100B)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If you press SPACE when there is no")
  BiosCallsHelp_L("character string during editing, then virtual terminal finalizes")
  BiosCallsHelp_L("(generates) zenkaku space, and returns execution responsibility")
  BiosCallsHelp_L("to program.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The characters you can add to editing")
  BiosCallsHelp_L("character strings are limited to western characters and hiraganas.")
  BiosCallsHelp_L("Katakanas will be processed as equivalent hiraganas.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("During conversion")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("[F1] to [F5] | Same as editing")
  BiosCallsHelp_L("[CTRL]+[F5] | Finalize all (finalizes the domain up to cursor position)")
  BiosCallsHelp_L("[ESC] | Quit conversion (keystrokes do not remain in buffer)")
  BiosCallsHelp_L("[RETURN] | Finalize partially (finalizes header bunsetsu)")
  BiosCallsHelp_L("[UP] | Move to prior block")
  BiosCallsHelp_L("[DOWN] | Move to proceeding block")
  BiosCallsHelp_L("[RIGHT] | Quit conversion")
  BiosCallsHelp_L("[LEFT] | Quit conversion")
  BiosCallsHelp_L("[SPACE] | Next candidate")
  BiosCallsHelp_L("[SHIFT]+[SPACE] | Prior candidate")
  BiosCallsHelp_L("[CTRL]+[STOP] | Quit editing (keystrokes remain in buffer)")
  BiosCallsHelp_L("[F6] to [F10] | Quit editing (keystrokes remain in buffer)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Key buffers will be cleared when " + Chr(34) + "move")
  BiosCallsHelp_L("to prior block" + Chr(34) + " and " + Chr(34) + "move to proceeding block" + Chr(34))
  BiosCallsHelp_L("were selected.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The characters up to one position")
  BiosCallsHelp_L("before the cursor will be subject to conversion and finalizing.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Be noted that key assignment described")
  BiosCallsHelp_L("here are, for ASCII VJE-80 and 80A only. As long as you keep rules")
  BiosCallsHelp_L("noted in  5, they should not be exactly this way. Therefore, some")
  BiosCallsHelp_L("function keys might differ with ASCII's assignment on MSX-JEs")
  BiosCallsHelp_L("of other machines. For example, " + Chr(34) + "next candidate" + Chr(34) + " is")
  BiosCallsHelp_L("[GRAPH] instead of [SHIFT]+[SPACE] in case of Sony machines. Accordingly,")
  BiosCallsHelp_L("[F2] converts to katakanasm and [F3] converts to hankakus. There")
  BiosCallsHelp_L("are several more differences.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Chapter 5 Cautions upon Using MSX-JE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Difference between MSX-JE and VJE-80")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("It seems too many people are confusing")
  BiosCallsHelp_L("MSX-JE and VJE-80, so I explain that, MSX-JE is a name of standard")
  BiosCallsHelp_L("when MSX performs Japanese input, while VJE-80 is a name of " + Chr(34) + "a")
  BiosCallsHelp_L("Japanese front end which satisfies MSX-JE standard" + Chr(34) + ". ")
  BiosCallsHelp_L("")
  BiosCallsHelp_L(Chr(34) + "MSX-WRITE II" + Chr(34) + " released")
  BiosCallsHelp_L("by ASCII has a backup option for its internal S-RAM dictionary.")
  BiosCallsHelp_L("I thought it was a useful option, but specification book did not")
  BiosCallsHelp_L("state any explanations about this option. It seems, implementation")
  BiosCallsHelp_L("of this option was possible simply because MSX-WRITEII has word")
  BiosCallsHelp_L("processor software and S-RAM stuffed in a same cartridge. You")
  BiosCallsHelp_L("can see this vividly, when you insert a Sony MSX-JE cartridge")
  BiosCallsHelp_L("and this MSX-WRITE II, MSX-WRITE II boots as word processor software,")
  BiosCallsHelp_L("while Sony's MSX-JE happens to boot. ;) If you perform S-RAM backup")
  BiosCallsHelp_L("here, what is backed up is not Sony's, but MSX-WRITE II's internal")
  BiosCallsHelp_L("SRAM. I was bit disappointed, since I expected functions like")
  BiosCallsHelp_L("dictionary backups and summary of current dictionary were available.")
  BiosCallsHelp_L("Because you cannot remember all the terms you have registered,")
  BiosCallsHelp_L("can you?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("A least necessary size of work area")
  BiosCallsHelp_L("a MSX-JE requests to boot never exceeds 2560 bytes. Therefore,")
  BiosCallsHelp_L("if your software has limitations on memories, then it's recommended")
  BiosCallsHelp_L("to allocate 2560 bytes of domain for MSX-JE when the software")
  BiosCallsHelp_L("boots.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("About character colors a STB specifies.")
  BiosCallsHelp_L("STB select character colors using ^Z. This option is supported")
  BiosCallsHelp_L("as follows.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Alignment of character string Character/background")
  BiosCallsHelp_L("color")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Editing character string 1FH")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Character string subject to conversion")
  BiosCallsHelp_L("F5H")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Proceeding bunsetsu 1FH")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bunsetsu that is not converted yet")
  BiosCallsHelp_L("1FH")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If software which have customized")
  BiosCallsHelp_L("palettes, or software which runs on SCREEN6 displays the MSX-JE")
  BiosCallsHelp_L("windows in these colors as they are, the outlook will be strange,")
  BiosCallsHelp_L("so you better let such software do some clever configuration about")
  BiosCallsHelp_L("these settings and display using color you think suitable.")
  BiosCallsHelp_Commit("MSX-JE", "MSX-JE")

EndProcedure
