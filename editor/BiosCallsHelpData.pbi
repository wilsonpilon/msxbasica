  BiosCallsHelp_L("F6C2 VARTAB  Pointer to start of variable space")
  BiosCallsHelp_L("F6C4 ARYTAB  Pointer to begging of array table")
  BiosCallsHelp_L("F6C6 STREND  End of storage in use")
  BiosCallsHelp_L("F6C8 DATPTR  DATA pointer")
  BiosCallsHelp_L("F6CA DEFTBL  Default valtype for each letter")
