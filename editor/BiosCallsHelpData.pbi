  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the command table to be used")
  BiosCallsHelp_L("by the macro language parser. The " + Chr(34) + "DRAW" + Chr(34) + " table is at 5D83H and the")
  BiosCallsHelp_L(Chr(34) + "PLAY" + Chr(34) + " table at 752EH.")
  BiosCallsHelp_Commit(".DATA AREA FOR CIRCLE STATEMENT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F958 MCLFLG  play / draw")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is zero if the macro language parser is being used")
  BiosCallsHelp_L("by the " + Chr(34) + "DRAW" + Chr(34) + " statement handler and non-zero if it is used by " + Chr(34) + "PLAY" + Chr(34) + ".")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("                 for play")
  BiosCallsHelp_L("F959 QUETAB: DEFB 00H   ;AQ Put position")
  BiosCallsHelp_L("F95A         DEFB 00H   ;AQ Get position")
  BiosCallsHelp_L("F95B         DEFB 00H   ;AQ Putback flag")
  BiosCallsHelp_L("F95C         DEFB 7FH   ;AQ Size")
  BiosCallsHelp_L("F95D         DEFW F975H ;AQ Address")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F95F         DEFB 00H   ;BQ Put position")
  BiosCallsHelp_L("F960         DEFB 00H   ;BQ Get position")
  BiosCallsHelp_L("F961         DEFB 00H   ;BQ Putback flag")
  BiosCallsHelp_L("F962         DEFB 7FH   ;BQ Size")
  BiosCallsHelp_L("F963         DEFW F9F5H ;BQ Address")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F965         DEFB 00H   ;CQ Put position")
  BiosCallsHelp_L("F966         DEFB 00H   ;CQ Get position")
  BiosCallsHelp_L("F967         DEFB 00H   ;CQ Putback flag")
  BiosCallsHelp_L("F968         DEFB 7FH   ;CQ Size")
  BiosCallsHelp_L("F969         DEFW FA75H ;CQ Address")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F96B         DEFB 00H   ;RQ Put position")
  BiosCallsHelp_L("F96C         DEFB 00H   ;RQ Get position")
  BiosCallsHelp_L("F96D         DEFB 00H   ;RQ Putback flag")
  BiosCallsHelp_L("F96E         DEFB 00H   ;RQ Size")
  BiosCallsHelp_L("F96F         DEFW 0000H ;RQ Address")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These twenty-four variables form the control blocks for the three music-queues")
  BiosCallsHelp_L("(VOICAQ, VOICBQ and VOICCQ) and the RS232 queue.")
  BiosCallsHelp_L("The three music control blocks are initialized by the GICINI standard routine and")
  BiosCallsHelp_L("thereafter maintained by the interrupt handler and the PUTQ standard routine.")
  BiosCallsHelp_L("The RS232 control block is unused in the current MSX ROM.")
  BiosCallsHelp_Commit("MCLFLG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F971 QUEBAK: DEFB 00H   ;AQ Putback character")
  BiosCallsHelp_L("             DEFB 00H   ;BQ Putback character")
  BiosCallsHelp_L("             DEFB 00H   ;CQ Putback character")
  BiosCallsHelp_L("             DEFB 00H   ;RQ Putback character")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These four variables are used to hold any unwanted character returned to the")
  BiosCallsHelp_L("associated queue. Althrough the putback facility is implemented in the MSX")
  BiosCallsHelp_L("ROM it is currently unused.")
  BiosCallsHelp_Commit("F971", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F975 VOICAQ: DEFS 128")
  BiosCallsHelp_L("F9F5 VOICBQ: DEFS 128")
  BiosCallsHelp_L("FA75 VOICCQ: DEFS 128")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These buffers contain the three music queues.")
  BiosCallsHelp_Commit("F975", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAF5 RS2IQ:  DEFS 64")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("MSX1 only: RS232 queue. It's unused and redefined since MSX2.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("                   FOR MSX 2 ONLY")
  BiosCallsHelp_L("FAF5 DPPAGE  Display page number")
  BiosCallsHelp_L("FAF6 ACPAGE  active page number")
  BiosCallsHelp_L("FAF7 AVCSAV  Reserves AV control port")
  BiosCallsHelp_Commit("FAF5", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAF8 EXBRSA  SUB-ROM slot address")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Slot-ID of the SubROM.")
  BiosCallsHelp_Commit("EXBRSA", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAF9 CHRCNT  Character counter in the buffer;")
  BiosCallsHelp_L("             used in Roman-Kana translation")
  BiosCallsHelp_L("FAFA ROMA    Area to store character (Japan version only)")
  BiosCallsHelp_Commit("used in Roman-Kana translation", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAFC MODE    The mode switch for romaji-kana conversion, and VRAM size.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 7: 0-hiragana, 1-katakana (romaji-kana conversion)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 6: Presence of level 2 kanji rom: 0-yes, 1-no (2+)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 5: 0-screen 10, 1-screen 11 (2+)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 4: Clipping: 0-doesn't, 1- does (2+)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 3: Masks the SCREEN 0-3 VRAM addresses: 0-doesn't, 1-does")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 2,1: VRAM capacity: 0,0-16K 0,1-64K 1,1-128K")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 0: Romaji-kana conversion: 0-doesn't, 1-does")
  BiosCallsHelp_Commit("MODE", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAFD NORUSE  Used by kanji driver")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 7: 1-graphic and text mixture mode")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 6: 1-Vertically scross the screen by pushing SHIFT+cursor key")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 5,4: Used internally in the kanji driver")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 3-0: VDP logical operation.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Notes from Takamichi Suzukawa:")
  BiosCallsHelp_L("The romaji-kana conversion is available both under ank (1-byte) and kanji")
  BiosCallsHelp_L("mode. This input mode is activated/activated by pushing certain key")
  BiosCallsHelp_L("combination. Under romaji-kana conversion mode, you push pronunciations (two")
  BiosCallsHelp_L("or three key strokes) sequentially, then you get one kana. e.g. push " + Chr(34) + "s" + Chr(34) + " and")
  BiosCallsHelp_L(Chr(34) + "e" + Chr(34) + ", you get " + Chr(34) + "se" + Chr(34) + ", though in non romaji-kana conversion mode, you push " + Chr(34) + "P" + Chr(34))
  BiosCallsHelp_L("key to get " + Chr(34) + "se" + Chr(34) + " kana.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("You might think this mode is much slower than non conversion mode, but")
  BiosCallsHelp_L("actually, 70% Japanese PC (Windows, Macintosh, Linux...) users rely on")
  BiosCallsHelp_L("romaji-kana conversion, because under non conversion mode, you have to push")
  BiosCallsHelp_L(Chr(34) + "kana" + Chr(34) + " " + Chr(34) + "numerals" + Chr(34) + " " + Chr(34) + "latin" + Chr(34) + "... keys quite frequently. You probably know a lot")
  BiosCallsHelp_L("of Japanese keyboard keys have four characters written on each. ;)")
  BiosCallsHelp_Commit("NORUSE", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FAFE XSAVE   [10000000 XXXXXXXX]")
  BiosCallsHelp_L("FB00 YSAVE   [*0000000 YYYYYYYY] *-light pen interrupt request")
  BiosCallsHelp_L("FB02 LOGOPR  Logical operation code")
  BiosCallsHelp_L("                Data area used by RS-232C or disk drive")
  BiosCallsHelp_L("FB03 RSTMP")
  BiosCallsHelp_L("FB03 TOCNT")
  BiosCallsHelp_L("FB04 RSFCB")
  BiosCallsHelp_L("FB06 RSIQLN")
  BiosCallsHelp_L("FB07 MEXBIH  Hook")
  BiosCallsHelp_L("FB0C OLDSTT  Hook")
  BiosCallsHelp_L("FB12 OLDINT  Hook")
  BiosCallsHelp_Commit("Data area used by RS-232C or disk drive", "RAM-variables")

  BiosCallsHelp_Begin()
