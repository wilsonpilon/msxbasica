  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0141H SNSMAT Read row of keyboard matrix")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to read a complete row of the keyboard matrix. PPI port C is read in then written back with the row number occupying the four keyboard row select bits. PPI port B is then read into register A to return the eight column inputs. The four miscellaneous control outputs of PPI port C are unaffected by this routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | A=Keyboard row number")
  BiosCallsHelp_L("Exit: | A=Column data of keyboard row")
  BiosCallsHelp_L("Modifies: | AF, C, EI")
  BiosCallsHelp_Commit("SNSMAT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0144H PHYDIO Read/write disk sector(s)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine for use by Disk BASIC. If not present the routine returns without action.")
  BiosCallsHelp_L("Otherwise it reads a logical sector from disk or writes a logical sector to disk.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is the prefered method to read/write sectors, because all installed Disk-ROMs are")
  BiosCallsHelp_L("considered by this routine! The MSX-Standard supports up to 4 Disk-ROMs with a maximum")
  BiosCallsHelp_L("of 8 drive-letters (A:-H:). This routine is very similar to the PHYDIO (4010H) routine in the")
  BiosCallsHelp_L("Disk-ROM, so more information about it's parameters")
  BiosCallsHelp_L("and return-values can be found there!")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | F = CARRY = 1 to write, CARRY = 0 to read")
  BiosCallsHelp_L("A = drive number (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("B = number of sectors")
  BiosCallsHelp_L("C = media descriptor")
  BiosCallsHelp_L("DE = logical sector number (0 based)")
  BiosCallsHelp_L("HL = transfer address (sector buffer)")
  BiosCallsHelp_L("Exit: | CARRY = 0 on success")
  BiosCallsHelp_L("CARRY if error")
  BiosCallsHelp_L("A = errorcode (if error)")
  BiosCallsHelp_L("B = number of sectors transfered")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("PHYDIO", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0147H FORMAT Format disk")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine for use by Disk BASIC. If not present the routine returns without action.")
  BiosCallsHelp_L("Otherwise it formats a floppy disk.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If more than one floppy drive is present the routine prompts for the drive")
  BiosCallsHelp_L("to be formatted. If the drive supports multiple disk-formats also the requested")
  BiosCallsHelp_L("format has to be selected. In all cases the user must confirm the " + Chr(34) + "Strike a key when ready" + Chr(34))
  BiosCallsHelp_L("prompt to finally format the drive.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is the prefered method to format drives, because all installed Disk-ROMs are")
  BiosCallsHelp_L("considered by this routine! The MSX-Standard supports up to 4 Disk-ROMs with a maximum")
  BiosCallsHelp_L("of 8 drive-letters (A:-H:). In contrast to the DSKFMT (401CH) routine of the Disk-ROM")
  BiosCallsHelp_L("this routine does not support pre-selection of drive-letters, disk-formats or work-areas.")
  BiosCallsHelp_L("This routine is very similar to the DSKFMT routine in the")
  BiosCallsHelp_L("Disk-ROM, so more information about it's parameters")
  BiosCallsHelp_L("and return-values can be found there!")
  BiosCallsHelp_L("Note: harddisks do not support formatting, but may implement different functionality")
  BiosCallsHelp_L("in this routine (e.g. enable/disable write-protection, e.g. in HSH or NOVAXIS SCSI ROMs).")
  BiosCallsHelp_L("Entry: | none?")
  BiosCallsHelp_L("Exit: | F = CARRY if error")
  BiosCallsHelp_L("A = errorcode (if error)")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("FORMAT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("014AH ISFLIO Check for file I/O")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to check whether the BASIC Interpreter is")
  BiosCallsHelp_L("currently directing its input or output via an I/O buffer.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is determined by examining PTRFIL. It is normally zero")
  BiosCallsHelp_L("but will contain a buffer FCB (File Control Block) address")
  BiosCallsHelp_L("while statements such as " + Chr(34) + "PRINT#1" + Chr(34) + ", " + Chr(34) + "INPUT#1" + Chr(34) + ", etc. are")
  BiosCallsHelp_L("being executed by the Interpreter.")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | Flag NZ if file I/O active")
  BiosCallsHelp_L("Modifies: | AF")
  BiosCallsHelp_Commit("ISFLIO", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("014DH OUTDLP Formatted output to line printer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to output a character to the printer. If the character is")
  BiosCallsHelp_L("a TAB code (09H) spaces are issued to the OUTDLP standard routine until LPTPOS")
  BiosCallsHelp_L("(F415H) is a multiple of eight (0, 8, 16, etc.). If the character is a CR code")
  BiosCallsHelp_L("(0DH) LPTPOS is zeroed, if it is any other control code LPTPOS is unaffected,")
  BiosCallsHelp_L("if it is a displayable character LPTPOS is incremented.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If NTMSXP (F417H) is zero, meaning an MSX-specific printer is connected,")
  BiosCallsHelp_L("the character is passed directly to the printer. Assuming a normal printer")
  BiosCallsHelp_L("is connected the CNVCHR standard routine is used to check for graphic characters.")
  BiosCallsHelp_L("If the character is a header code (01H) the routine terminates with no action.")
  BiosCallsHelp_L("If it is a converted character it is replaced by a space, all other characters")
  BiosCallsHelp_L("are passed to the printer.")
  BiosCallsHelp_L("Entry: | A = character to output")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI")
  BiosCallsHelp_Commit("OUTDLP", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0150H GETVCP Get music voice pointer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to return the address of byte 2 in the specified")
  BiosCallsHelp_L("voice buffer (VCBA, VCBB or VCBC).")
  BiosCallsHelp_L("Entry: | L = voice number (0, 1, 2)")
  BiosCallsHelp_L("Exit: | HL = address in voice buffer")
  BiosCallsHelp_L("Modifies: | AF, HL")
  BiosCallsHelp_Commit("GETVCP", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0153H GETVC2 Get music voice pointer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to return the address of any byte in the voice buffer")
  BiosCallsHelp_L("(VCBA, BCBB or VCBC) specified by the voice number in VOICEN (FB38H).")
  BiosCallsHelp_L("Entry: | L = byte number (0 to 36)")
  BiosCallsHelp_L("Exit: | HL = address in voice buffer")
  BiosCallsHelp_L("Modifies: | AF, HL")
  BiosCallsHelp_Commit("GETVC2", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0156H KILBUF Clear keyboard buffer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to clear the forty character type-ahead keyboard buffer")
  BiosCallsHelp_L("KEYBUF.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("There are two pointers into this buffer, PUTPNT where the interrupt handler")
  BiosCallsHelp_L("places characters and GETPNT where application programs fetch them from.")
  BiosCallsHelp_L("As the number of characters in the buffer is indicated by the difference")
  BiosCallsHelp_L("between these two pointers KEYBUF is emptied simply by making them both")
  BiosCallsHelp_L("equal.")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | HL")
  BiosCallsHelp_Commit("KILBUF", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0159H CALBAS Call to BASIC from any slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to call a routine in the BASIC Interpreter")
  BiosCallsHelp_L("from any slot. Usually this will be from machine code programs")
  BiosCallsHelp_L("running in an extension ROM in page 1 (4000H-7FFFH).")
  BiosCallsHelp_L("Entry: | IX = address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF', BC', DE', HL', IY, DI")
  BiosCallsHelp_Commit("CALBAS", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("015CH SUBROM Call specified address in SUB-ROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is the routine to call BASIC SUB-ROM especially. The")
  BiosCallsHelp_L("slot where SUB-ROM resides is automatically examined.")
  BiosCallsHelp_L("Normally, EXTROM, described below, is used.")
  BiosCallsHelp_L("Entry: | IX = address to be called")
  BiosCallsHelp_L("Exit: | depends on the result of the called program")
  BiosCallsHelp_L("Modifies: | background register and IX, IY registers are reserved")
  BiosCallsHelp_Commit("SUBROM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("015FH EXTROM Call specified address in SUB-ROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This is the routine to call BASIC SUB-ROM. The difference")
  BiosCallsHelp_L("between this and SUB-ROM above is the point whether the")
  BiosCallsHelp_L("IX register value is pushed.")
  BiosCallsHelp_L("Entry: | IX = address to be called")
  BiosCallsHelp_L("Exit: | depends on the result of the called program")
  BiosCallsHelp_L("Modifies: | background register and IX, IY registers are reserved")
  BiosCallsHelp_Commit("EXTROM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0162H CHKSLZ")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Search slots for SUB-ROM")
  BiosCallsHelp_Commit("CHKSLZ", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0165H CHKNEW")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Tests screen mode")
  BiosCallsHelp_Commit("CHKNEW", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0168H EOL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Deletes to the end of the line")
  BiosCallsHelp_Commit("EOL", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("016BH BIGFIL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Same function as FILVRM (total VRAM can be reached).")
  BiosCallsHelp_Commit("BIGFIL", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("016EH NSETRD")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Same function as SETRD.(with full 16 bits VRAM-address)")
  BiosCallsHelp_Commit("NSETRD", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0171H NSTWRT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Same function as SETWRT.(with full 16 bits VRAM-address)")
  BiosCallsHelp_Commit("NSTWRT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0174H NRDVRM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reads VRAM like in RDVRM.(with full 16 bits VRAM-address)")
  BiosCallsHelp_Commit("NRDVRM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0177H NWRVRM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Writes to VRAM like in WRTVRM.(with full 16 bits VRAM-address)")
  BiosCallsHelp_Commit("NWRVRM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("017AH RDRES Read Reset-state")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Determine if MSX was restarted by software-reset (JP 0000H) or by hardware-reset.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("System reserved")
  BiosCallsHelp_L("Entry: | ?")
  BiosCallsHelp_L("Exit: | A = if bit7 is 0: hardware-reset, if bit7 is 1: software-reset")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: Software-Reset")
  BiosCallsHelp_Commit("RDRES", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("017DH WRRES Write Reset-state")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Specify if MSX is restarted by software-reset (JP 0000H) or by hardware-reset.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("System reserved")
  BiosCallsHelp_L("Entry: | A = if bit7 is 0: hardware-reset, if bit7 is 1: software-reset")
  BiosCallsHelp_L("Exit: | ?")
  BiosCallsHelp_L("Modifies: | A")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: Software-Reset")
  BiosCallsHelp_Commit("WRRES", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0180H CHGCPU Change CPU")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Changes the CPU mode.")
  BiosCallsHelp_L("Entry: | A register")
  BiosCallsHelp_L("       b7 b6 b5 b4 b3 b2 b1 b0")
  BiosCallsHelp_L("        L  0  0  0  0  0  M  M")
  BiosCallsHelp_L("        |                 |  |")
  BiosCallsHelp_L("        --->LED            ------> CPU MODE")
  BiosCallsHelp_L("-mode")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("  mode     meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("  00       Z80 mode")
  BiosCallsHelp_L("  01       R800 ROM MODE")
  BiosCallsHelp_L("  10       R800 DRAM")
  BiosCallsHelp_L("  11       system exclusive")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("-LED")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" LED       meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("  0        LED will not change")
  BiosCallsHelp_L("  1        LED will change")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | none")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Explanation: Depending on the value of the A register the CPU mode will change. If bit 7 is set to 1, the LED that displays the status of the CPU will change along with it. If bit 7 is set to 0, it will not change.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Besides the R register none of the registers will have been changed.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: The change of the CPU will only change settings in the S1990 system controller. Therefore, after you change to the Z80 or the R800 ROM MODE and if you write into the memory segments that are normally used in the R800 DRAM MODE for the system software, and after that you try to change the CPU MODE to R800 DRAM MODE the computer will crash.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The transfer of the systemsoftware will only be done during the systemboot.")
  BiosCallsHelp_Commit("CHGCPU", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0183H GETCPU Get CPU")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Check in what CPU mode the system currently is.")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | A")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("value  meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" 0      Z80 MODE")
  BiosCallsHelp_L(" 1      R800 ROM MODE")
  BiosCallsHelp_L(" 2      R800 DRAM MODE")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("Modifies: | F")
  BiosCallsHelp_Commit("GETCPU", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0186H PCMPLY play PCM sound")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Replay PCM data")
  BiosCallsHelp_L("Entry: | A")
  BiosCallsHelp_L("    b7 b6 b5 b4 b3 b2 b1 b0")
  BiosCallsHelp_L("     R  0  0  0  0  0  S  S")
  BiosCallsHelp_L("     |                 |  |")
  BiosCallsHelp_L("     |                  ----->sampling rate")
  BiosCallsHelp_L("      -------> VRAM/MAIN RAM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-sampling rate")
  BiosCallsHelp_L("Settings for the sampling rate")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("value   sampling rate (Khz)")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" 00       15.75")
  BiosCallsHelp_L(" 01        7.875")
  BiosCallsHelp_L(" 10        5.25")
  BiosCallsHelp_L(" 11        3.9375")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-memmory")
  BiosCallsHelp_L("Selects the memmory where the data to be replayed is located.")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("memmory    meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" 0         mainram")
  BiosCallsHelp_L(" 1         VRAM")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("HL    address to the PCM data.")
  BiosCallsHelp_L("      When the VRAM is selected also the E register is used")
  BiosCallsHelp_L("      to create together with HL a 3 byte address. The E")
  BiosCallsHelp_L("      register contains the highest position.")
  BiosCallsHelp_L("BC    length of the PCM data.")
  BiosCallsHelp_L("      When the VRAM is selected also the D register is used")
  BiosCallsHelp_L("      to create together with BC a 3 byte address. The D")
  BiosCallsHelp_L("      register contains the highest position.")
  BiosCallsHelp_L("Exit: | Carry flag")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("value     meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" 0         normal end")
  BiosCallsHelp_L(" 1         unnormal end")
  BiosCallsHelp_L("              A = reason for unnormal end")
  BiosCallsHelp_L("                 1 = error in setting of the samplingfrequency")
  BiosCallsHelp_L("                 2 = the STOP key has been pressed")
  BiosCallsHelp_L("              HL = the address when the interruption occurred")
  BiosCallsHelp_L("                   When using the VRAM, the E register")
  BiosCallsHelp_L("                   will contain the highest address position.")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("Modifies: | all")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: When running in the Z80 MODE, this routine will switch to the R800 ROM mode automatically but it will return to the Z80 MODE when the routine is finished. While replaying the PCM data, no interrupts can be generated. When STOP is pressed, the replaying will be interrupted. In this BIOS, the program that executes the replaying of samples is located in page 1 (04000h-07fffh). So when you place sample")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("data in the MAIN RAM you must place then above 08000H.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Function: Plays PCM. A new command supplied to turboR. Use bit 7 of A register to specify whether the PCM data is in RAM or in VRAM. Among sampling frequencies, 15.75 kHz is valid only when CPU is in R800 DRAM mode. If 15.75 kHz is chosen in other CPU mode, it is treated as an error. Note D and E registers are useful only when PCM data is in VRAM.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: If bit7 of A is 0, it means data is in main RAM; 1 means that data is in VRAM. Bits 6 to 2 are 0. If bits 1 and 0 are, 0 and 0, then frequency is 15.75 kHz; 0 and 1 means 7.875 kHz, 1 and 0 means 5.25 kHz, and 1 and 1 means 3.9375 kHz.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Use registers EHL to specify starting address of PCM data being played")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Use DBC to specify length of data (number of bytes)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If Cy reset occurs, it means PCM playing quitted normally.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If set, it means playing quitted abnormally. Moreover;")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Register A tells the cause of abnormality. If A is 0, it means you specified wrong frequency. If A is 1, it means CTRL+STOP halt occurred.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("And EHL would contain address of which halt occurred there.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: PCM")
  BiosCallsHelp_Commit("PCMPLY", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0189H PCMREC record PCM sound")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Record PCM data")
  BiosCallsHelp_L("Entry: | A")
  BiosCallsHelp_L("b7 b6 b5 b4 b3 b2 b1 b0")
  BiosCallsHelp_L(" R  T  T  T  T  C  S  S")
  BiosCallsHelp_L(" |  |  |  |  |  |  |  |")
  BiosCallsHelp_L(" |   --------   |   --------> sampling rate")
  BiosCallsHelp_L(" |      |       --------> reduction")
  BiosCallsHelp_L(" |      -----------> trigger level")
  BiosCallsHelp_L(" --------------> VRAM/mainram")
  BiosCallsHelp_L("              ")
  BiosCallsHelp_L("  -sampling rate")
  BiosCallsHelp_L("  Settings for the sampling rate")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("  value   sampling rate (Khz)")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("   00       15.75")
  BiosCallsHelp_L("   01        7.875")
  BiosCallsHelp_L("   10        5.25")
  BiosCallsHelp_L("   11        3.9375")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  -reduction")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("  value   meaning")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("    0      no reduction")
  BiosCallsHelp_L("    1      reduction")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  -trigger level")
  BiosCallsHelp_L("  This designates the level sound needed to start sampling")
  BiosCallsHelp_L("              ")
  BiosCallsHelp_L("  -memmory")
  BiosCallsHelp_L("  Selects the memmory where the data to be replayed is located.")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("  memmory    meaning")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("   0         mainram")
  BiosCallsHelp_L("   1         VRAM")
  BiosCallsHelp_L("  ----------------------------------------------------")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  HL    address to the PCM data.")
  BiosCallsHelp_L("        When the VRAM is selected also the E register is used")
  BiosCallsHelp_L("        to create together with HL a 3 byte address. The E")
  BiosCallsHelp_L("        register contains the highest position.")
  BiosCallsHelp_L("  BC    length of the PCM data.")
  BiosCallsHelp_L("        When the VRAM is selected also the D register is used")
  BiosCallsHelp_L("        to create together with BC a 3 byte address. The D")
  BiosCallsHelp_L("        register contains the highest position.")
  BiosCallsHelp_L("Exit: | clear flag")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("value     meaning")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L(" 0         normal end")
  BiosCallsHelp_L(" 1         unnormal end")
  BiosCallsHelp_L("              A = reason for unnormal end")
  BiosCallsHelp_L("                 1 = error in setting of the samplingfrequency")
  BiosCallsHelp_L("                 2 = the STOP key has been pressed")
  BiosCallsHelp_L("              HL = the address when the interruption occurred")
  BiosCallsHelp_L("                   When using the VRAM, the E register")
  BiosCallsHelp_L("                   will contain the highest address position.")
  BiosCallsHelp_L("----------------------------------------------------")
  BiosCallsHelp_L("Modifies: | all")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note: When running in the Z80 MODE, this routine will switch to the R800 ROM mode automatically but it will return to the Z80 MODE when the routine is finished. When running in the Z80 MODE or the R800 ROM MODE, a 'error in setting of sample frequency' error will occur when you try to sample with a frequency of 15.75 kHz. While recording the PCM data, no interrupts can be generated. When STOP is pressed, the recording will be interrupted. When recording in the MAIN RAM, please note the start address (see PCMPLAY-note).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reduction: Replay data is always regarded as reduced data. When recording you can determine whether to reduce the PCM data or not. But, when the sound data is equivalent to 0, the value that is recorded will become 1 (to prevent problems when replaying.)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Function: Records PCM. A new command supplied to turboR. A " + Chr(34) + "trigger level" + Chr(34) + " is a volume of noise that causes a recording to start when MSX hears a sound louder than the level. If the level is 0, then recording begins immediately after execution of this command. If bit 2 is set to 1, then recorded data will be compressed.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Input: If bit7 of A is 0, then data will be saved to RAM; if 1, then data will be saved to VRAM. Use bits 6 to 3 to specify trigger level. If bit2 is 0, then data compression is disabled. If 1, then data will be compressed. Use bits 1 and 0 to specify frequency, and their usage is identical with PCMPLY.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Output: If Cy reset occurs, it means recording quitted normally.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If set, it means recording has failed. Moreover;")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Register A tells the cause of abnormality. If A is 0, it means you specified wrong frequency. If A is 1, it means CTRL+STOP halt occurred.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: PCM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The following entrypoints do not necessarily match the MSX-standard,")
  BiosCallsHelp_L("but are used by several programs:")
  BiosCallsHelp_Commit("PCMREC", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("6637H ? Request memory for a return-string")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine checks if there is enough memory for a string, which has to be")
  BiosCallsHelp_L("returned from the calling function. The string-length (register A) is checked")
  BiosCallsHelp_L("(at 668EH) and probably terminated with an " + Chr(34) + "Out of string space" + Chr(34) + " error.")
  BiosCallsHelp_L("Length and memory-address for the string are putted into DSCTMP (F698H).")
  BiosCallsHelp_L("String data can be written to that adress. The result-string can be returned")
  BiosCallsHelp_L("by calling 6654H.")
  BiosCallsHelp_L("Entry: | A = string length")
  BiosCallsHelp_L("Exit: | ?")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("6637H", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("6654H ? Return a result-string")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by string-functions to create a result-descriptor.")
  BiosCallsHelp_L("The descriptor is copied from DSCTMP (F698H) to the next available location")
  BiosCallsHelp_L("in TEMPST (F67AH) and it's address is stored in DAC (F7F6H). If TEMPST")
  BiosCallsHelp_L("is full a " + Chr(34) + "String formula too complex" + Chr(34) + " error is generated, otherwise TEMPPT")
  BiosCallsHelp_L("(F678H) is increased by 3 and the routine ends.")
  BiosCallsHelp_Commit("6654H", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("668EH ? Subroutine: check if enough string-memory is available")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This subroutine checks if there is enough memory for a string which length is specified")
  BiosCallsHelp_L("in register A. After termination of this routine the DE-register points to the memory")
  BiosCallsHelp_L("adress, available for the string.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The string-length is first substracted from the actually available memory FRETOP (F69BH).")
  BiosCallsHelp_L("The result is compared with STKTOP (F674H). STKTOP contains the lowest available address")
  BiosCallsHelp_L("for string-memory. After updating FRETOP and if enough memory is available the routine")
  BiosCallsHelp_L("ends here. If there is not enough memory available a garbage collection (66B6H) is performed")
  BiosCallsHelp_L("and availabe memory is checked again. If there is still not enough memory available")
  BiosCallsHelp_L("a " + Chr(34) + "Out of string space" + Chr(34) + " error is generated.")
  BiosCallsHelp_L("Entry: | A = string length")
  BiosCallsHelp_L("Exit: | DE = available memory-adress")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("668EH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("66B6H ? Garbage collection")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine performs the garbage collection, which removes unused")
  BiosCallsHelp_L("strings from memory. Valid strings are moved to remove " + Chr(34) + "holes" + Chr(34) + " from")
  BiosCallsHelp_L("the memory. This generates additional memory for new strings.")
  BiosCallsHelp_L("This routine is automatically invoked if there is no more string-memory")
  BiosCallsHelp_L("available.")
  BiosCallsHelp_Commit("66B6H", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F24F")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the " + Chr(34) + "Insert disk for drive" + Chr(34) + " routine.")
  BiosCallsHelp_L("AF has the drive character (41h = " + Chr(34) + "A" + Chr(34) + ").")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F24F", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F252")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F252", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F255")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the fix-filename routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F255", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F258")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Is called by various routines. It is possible to adapt the F2DC, for example under Basic")
  BiosCallsHelp_L("to see subdirectoies in the FILES-statement. It's also possible to open (always).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F258", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F25B")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the DIRENT increase routine. Plane hereafter the new DIRENT is stored (now in [AF]).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F25B", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F25E")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the routine which will load the following directory-sector.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F25E", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F261")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the fix-filename routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F261", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F264")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Called by the OPEN routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F264", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F267")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Default: C9 C9 C9 (3* ret)")
  BiosCallsHelp_Commit("F267", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F26A")
