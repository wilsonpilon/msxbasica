  BiosCallsHelp_L("        .WARK FOR USER FUNCTION PARAMETER")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F6E4 PRMSTK  Previous definition block on stack")
  BiosCallsHelp_L("F6E6 PRMLEN  Number of bytes of objective table")
  BiosCallsHelp_L("F6E8 PARM1   Objective prameter definition table")
  BiosCallsHelp_L("F74C PRMPRV  Pointer to previous parameter block")
  BiosCallsHelp_L("F74E PRMLN2  Size of parameter block")
  BiosCallsHelp_L("F750 PARM2   For parameter storage")
