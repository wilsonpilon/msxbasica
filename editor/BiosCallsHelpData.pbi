  BiosCallsHelp_L("Main work-area")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .SUBROUTINES FOR READ/WRITE CALLS OF THE INTER-SLOT")
  BiosCallsHelp_L(";")
  BiosCallsHelp_Commit("ROMBDOS", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F380 RDPRIM  Read from basic slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by the RDSLT standard routine to switch Primary Slots and read a byte")
  BiosCallsHelp_L("from memory. The new Primary Slot Register setting is supplied in register A, the old setting")
  BiosCallsHelp_L("in register D and the byte read returned in register E.")
  BiosCallsHelp_Commit("RDPRIM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F385 WRPRIM  Write to basic slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by the WRSLT standard routine to switch Primary Slots and write a byte")
  BiosCallsHelp_L("to memory. The new Primary Slot Register setting is supplied in register A, the old setting")
  BiosCallsHelp_L("in register D and the byte to write in register E.")
  BiosCallsHelp_Commit("WRPRIM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F38C CLPRIM  Call basic slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by the CALSLT standard routine to switch Primary Slots and call an address.")
  BiosCallsHelp_L("The new Primary Slot Register setting is supplied in register A, the old setting on the Z80")
  BiosCallsHelp_L("stack and the address to call in register pair IX.")
  BiosCallsHelp_Commit("CLPRIM", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F39A USRTAB  USR function starting addresses")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These ten variables contain the " + Chr(34) + "USR" + Chr(34) + " function addresses. Their values are set to the interpreter")
  BiosCallsHelp_L(Chr(34) + "Illegal function call" + Chr(34) + " error generator at power-up and thereafter only altered by the " + Chr(34) + "DEFUSR" + Chr(34))
  BiosCallsHelp_L("statement.")
  BiosCallsHelp_Commit("USRTAB", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3AE LINL40  Screen width per line in SCREEN 0")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the 40x24 Text Mode screen width. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter only altered by the " + Chr(34) + "WIDTH" + Chr(34) + " statement.")
  BiosCallsHelp_Commit("LINL40", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3AF LINL32  Screen width per line in SCREEN 1")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the 32x24 Text Mode screen width. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter only altered by the " + Chr(34) + "WIDTH" + Chr(34) + " statement.")
  BiosCallsHelp_Commit("LINL32", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3B0 LINLEN  Current screen width per line")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current text mode screen width. Its value is set from LINL40 or")
  BiosCallsHelp_L("LINL32 whenever the VDP is initialized to text mode via the INITXT or INIT32 standard routines.")
  BiosCallsHelp_Commit("LINLEN", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3B1 CRTCNT  Number of lines of current screen")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the number of rows on the screen. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter unaltered.")
  BiosCallsHelp_Commit("CRTCNT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3B2 CLMLST  Horizontal location in the case that items")
  BiosCallsHelp_L("             are divided by commas in PRINT statement")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the minimum number of columns that must still be available on a line")
  BiosCallsHelp_L("for a data item to be " + Chr(34) + "PRINT" + Chr(34) + "ed, if less space is available a CR,LF is issued first.")
  BiosCallsHelp_L("Its value is set at power-up and thereafter only altered by the " + Chr(34) + "WIDTH" + Chr(34) + " and " + Chr(34) + "SCREEN" + Chr(34) + " statements.	")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .WORK FOR INITIALIZATION")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-SCREEN 0")
  BiosCallsHelp_L("F3B3 TXTNAM  Pattern name tabte")
  BiosCallsHelp_L("F3B5 TXTCOL  Color table")
  BiosCallsHelp_L("F3B7 TXTCGP  Pattern ganarator table")
  BiosCallsHelp_L("F3B9 TXTATR  Unused")
  BiosCallsHelp_L("F3BB TXTPAT  Unused")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the 40x24 Text Mode VDP base addresses. Their values are set at")
  BiosCallsHelp_L("power-up and thereafter only altered by the " + Chr(34) + "BASE" + Chr(34) + " statement.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-SCREEN 1")
  BiosCallsHelp_L("F3BD T32NAM  Pattern name tabte")
  BiosCallsHelp_L("F3BF T32COL  Color table")
  BiosCallsHelp_L("F3C1 T32CGP  Pattern ganarator table")
  BiosCallsHelp_L("F3C3 T32ATR  Sprite attribute table")
  BiosCallsHelp_L("F3C5 T32PAT  Sprite generator table")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the 32x24 Text Mode VDP base addresses. Their values are set at")
  BiosCallsHelp_L("power-up and thereafter only altered by the " + Chr(34) + "BASE" + Chr(34) + " statement.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-SCREEN 2")
  BiosCallsHelp_L("F3C7 GRPNAM  Pattern name tabte")
  BiosCallsHelp_L("F3C9 GRPCOL  Color table")
  BiosCallsHelp_L("F3CB GRPCGP  Pattern ganarator table")
  BiosCallsHelp_L("F3CD GRPATR  Sprite attribute table")
  BiosCallsHelp_L("F3CF GRPPAT  Sprite generator table")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the Graphics Mode VDP base addresses. Their values are set at")
  BiosCallsHelp_L("power-up and thereafter only altered by the " + Chr(34) + "BASE" + Chr(34) + " statement.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-SCREEN 3")
  BiosCallsHelp_L("F3D1 MLTNAM  Pattern name tabte")
  BiosCallsHelp_L("F3D3 MLTCOL  Color table")
  BiosCallsHelp_L("F3D5 MLTCGP  Pattern ganarator table")
  BiosCallsHelp_L("F3D7 MLTATR  Sprite attribute table")
  BiosCallsHelp_L("F3D9 MLTPAT  Sprite generator table")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the Multicolour Mode VDP base addresses. Their values are set at")
  BiosCallsHelp_L("power-up and thereafter only altered by the " + Chr(34) + "BASE" + Chr(34) + " statement.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L(";")
  BiosCallsHelp_Commit("CLMLST", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3DB CLIKSW  Key click switch")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable controls the interrupt handler key click: 00H=Off, NZ=On.")
  BiosCallsHelp_L("Its value is set at power-up and thereafter only altered by the " + Chr(34) + "SCREEN" + Chr(34) + " statement.")
  BiosCallsHelp_Commit("CLIKSW", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3DC CSRY    Y-coordinate of cursor")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the row coordinate (from 1 to CTRCNT) of the text mode cursor.")
  BiosCallsHelp_Commit("CSRY", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3DD CSRX    X-coordinate of cursor")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the column coordinate (from 1 to LINLEN) of the text mode cursor.")
  BiosCallsHelp_L("Note that the BIOS cursor coordinates for the home position are 1,1 whatever the screen width.")
  BiosCallsHelp_Commit("CSRX", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3DE CNSDFG  Function key display switch")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current state of the function key display: 00H=Off, NZ=On.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .AREA TO SAVE VDP REGISTERS")
  BiosCallsHelp_Commit("CNSDFG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3DF RG0SAV: DEFB 00H")
  BiosCallsHelp_L("F3E0 RG1SAV: DEFB F0H")
  BiosCallsHelp_L("F3E1 RG2SAV: DEFB 00H")
  BiosCallsHelp_L("F3E2 RG3SAV: DEFB 00H")
  BiosCallsHelp_L("F3E3 RG4SAV: DEFB 01H")
  BiosCallsHelp_L("F3E4 RG5SAV: DEFB 00H")
  BiosCallsHelp_L("F3E5 RG6SAV: DEFB 00H")
  BiosCallsHelp_L("F3E6 RG7SAV: DEFB F4H")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These eight variables mimic the state of the eight write-only VDP Mode")
  BiosCallsHelp_L("Registers. These values shown are for 40x24 Text Mode.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Copies of registers 0-7 are located at RG8SAV (FFFE7H), registers 25-27 at RG25SA (FFFAH).")
  BiosCallsHelp_Commit("F3DF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3E7 STATFL  Stores VDP status (MSX- VDP status register 0)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is continously updated by the interrupt handler with")
  BiosCallsHelp_L("the contents of the VDP Status Register.")
  BiosCallsHelp_Commit("STATFL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3E8 TRGFLG  Stores trigger button status of joystick")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is continously updated by the interrupt handler with")
  BiosCallsHelp_L("the state of the four joystick trigger inputs and the space key.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("7 6 5 4 3 2 1 0")
  BiosCallsHelp_L("| | | |       +-- Space bar, trig(0) (0 = pressed)")
  BiosCallsHelp_L("| | | +---------- Stick 1, Trigger 1 (0 = pressed)")
  BiosCallsHelp_L("| | +------------ Stick 1, Trigger 2 (0 = pressed)")
  BiosCallsHelp_L("| +-------------- Stick 2, Trigger 1 (0 = pressed)")
  BiosCallsHelp_L("+---------------- Stick 2, Trigger 2 (0 = pressed)")
  BiosCallsHelp_Commit("TRGFLG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3E9 FORCLR  Foreground colour")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current foreground color. Its value is set at power-up")
  BiosCallsHelp_L("and thereafter only alterd by the " + Chr(34) + "COLOR" + Chr(34) + " statement. The foreground color is used")
  BiosCallsHelp_L("by the CLRSPR standard routine to set the sprite color and the CHGCLR standard")
  BiosCallsHelp_L("routine to set the 1 pixel color in the text modes. It also functions as the")
  BiosCallsHelp_L("graphics ink color as it is copied to ATRBYT by the GRPPRT standard routine and")
  BiosCallsHelp_L("used throughout the interpreter as the default value for any optional color operand.")
  BiosCallsHelp_Commit("FORCLR", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3EA BAKCLR  Background colour")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current background color. Its value is set at power-up")
  BiosCallsHelp_L("and thereafter only alterd by the " + Chr(34) + "COLOR" + Chr(34) + " statement. The background color is used")
  BiosCallsHelp_L("by the CLS standard routine to clear the screen in the graphics modes and by the")
  BiosCallsHelp_L("CHGCLR standard routine to set the 0 pixel color in the text modes.")
  BiosCallsHelp_Commit("BAKCLR", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3EB BDRCLR  Border colour")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current border color. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter only altered by the CHGCLR standard routine in 32x24 Text Mode, Graphics")
  BiosCallsHelp_L("Mode and Multicolor Mode to set the border color.")
  BiosCallsHelp_Commit("BDRCLR", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3EC MAXUPD  JMP 0000 (used by CIRCLE statement)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The address bytes are filled in by the " + Chr(34) + "LINE" + Chr(34) + " statement handler for form a Z80 JP")
  BiosCallsHelp_L("to the RIGHTC, LEFTC, UPC or DOWNC standard routines.")
  BiosCallsHelp_Commit("MAXUPD", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3EF MINUPD  JMP 0000 (used by CIRCLE statement)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The address bytes are filled in by the " + Chr(34) + "LINE" + Chr(34) + " statement handler for form a Z80 JP")
  BiosCallsHelp_L("to the RIGHTC, LEFTC, UPC or DOWNC standard routines.")
  BiosCallsHelp_Commit("MINUPD", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3F2 ATRBYT  Color code in csing graphic")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the graphics ink color used by the SETC and NSETCX")
  BiosCallsHelp_L("standard routines.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .WORK AREA FOR PLAY STATEMENT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F3F3 QUEUES: DEFW F959H  Points to queue table at the execution of PLAY st.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the control blocks for")
  BiosCallsHelp_L("the three music queues. Its value is set at power-up and")
  BiosCallsHelp_L("thereafter unaltered.")
  BiosCallsHelp_Commit("ATRBYT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3F5 FRCNEW  DB 255")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains a flag to distinguish the two statements")
  BiosCallsHelp_L("in the " + Chr(34) + "CLOAD/CLOAD?" + Chr(34) + " statement handler: 00H=CLOAD, FFH=CLOAD?.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .WORK AREA FOR KEY INPUT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F3F6 SCNCNT  Interval for the key scan")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used as a counter by the interrupt handler to")
  BiosCallsHelp_L("control the rate at which keyboard scans are performed.")
  BiosCallsHelp_Commit("FRCNEW", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3F7 REPCNT  Delay until the auto-repeat of the key begins")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used as a counter by the interrupt handler to")
  BiosCallsHelp_L("control the key repeat rate.")
  BiosCallsHelp_Commit("REPCNT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3F8 PUTPNT  DW KEYBUF  points to adress to write in the key buffer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the put position in")
  BiosCallsHelp_L("KEYBUF.")
  BiosCallsHelp_Commit("PUTPNT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F3FA GETPNT  DW KEYBUF  points to adress to read from the key buffer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the address of the get position in")
  BiosCallsHelp_L("KEYBUF.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .PARAMETERS FOR CASSETTE")
  BiosCallsHelp_L("F3FC CS1200   Reading parameters")
  BiosCallsHelp_L("     DB LOW01,HIGH01,LOW11,HIGH11,HEDLEN*2/256 ; FOR 1200 BAUD")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the 1200 baud cassette parameters.")
  BiosCallsHelp_L("Their values are set at power-up and thereafter unaltered.")
  BiosCallsHelp_Commit("GETPNT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F401 CS2400")
  BiosCallsHelp_L("     DB LOW02,HIGH02,LOW12,HIGH22,HEDLEN*2/256 ; FOR 2400 BAUD")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the 2400 baud cassette parameters.")
  BiosCallsHelp_L("Their values are set at power-up and thereafter unaltered.")
  BiosCallsHelp_Commit("CS2400", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F406 LOW")
  BiosCallsHelp_L("     DB LOW01,HIGH01    Width of LOW & HIGH wich represents bit 0")
  BiosCallsHelp_L("F408 HIGH")
  BiosCallsHelp_L("     DB LOW11,HIGH11    Width of LOW & HIGH wich represents bit 1")
  BiosCallsHelp_L("F40A HEADER")
  BiosCallsHelp_L("     DB HEDLEN*2/256    Header bit for the short header")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five variables contain the current cassette parameters.")
  BiosCallsHelp_L("Their values are set to 1200 baud at power-up and theirafter")
  BiosCallsHelp_L("only altered by the " + Chr(34) + "CSAVE" + Chr(34) + " and " + Chr(34) + "SCREEN" + Chr(34) + " statements.")
  BiosCallsHelp_Commit("LOW", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F40B ASPCT1  256/aspect ratio")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the reciprocal of the default " + Chr(34) + "CIRCLE" + Chr(34))
  BiosCallsHelp_L("aspect ratio multiplied by 256. Its value is set at power-up")
  BiosCallsHelp_L("and thereafter unaltered.")
  BiosCallsHelp_Commit("ASPCT1", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F40D ASPCT2  256*aspect ratio")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the default " + Chr(34) + "CIRCLE" + Chr(34))
  BiosCallsHelp_L(" ")
  BiosCallsHelp_L("aspect ratio")
  BiosCallsHelp_L("multiplied by 256. Its value is set at power-up and thereafter")
  BiosCallsHelp_L("unaltered. The aspect ratio is present in two forms so that the")
  BiosCallsHelp_L(Chr(34) + "CIRCLE" + Chr(34) + " statement handler can select the appropiate one")
  BiosCallsHelp_L("immediately rather than needing to examine and possibly")
  BiosCallsHelp_L("reciprocate it as is the case with an operand in the program")
  BiosCallsHelp_L("text.")
  BiosCallsHelp_Commit("ASPCT2", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F40F ENDPGM,ENDPRG  DB " + Chr(34) + ":" + Chr(34) + " Dummy program end for RESUME NEXT st.")
  BiosCallsHelp_L("F410                DB 00H")
  BiosCallsHelp_L("F411                DB 00H")
  BiosCallsHelp_L("F412                DB 00H")
  BiosCallsHelp_L("F413                DB 00H")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These five bytes form a dummy program line. Their values are")
  BiosCallsHelp_L("set at power-up and thereafter unaltered. The line exists in")
  BiosCallsHelp_L("case an error occurs in the Interpreter Mainloop before any")
  BiosCallsHelp_L("tokenised text is available in KBUF. If an " + Chr(34) + "ON ERROR GOTO" + Chr(34) + " is")
  BiosCallsHelp_L("active at this time then it provides some text for the " + Chr(34) + "RESUME" + Chr(34))
  BiosCallsHelp_L("statement to terminate on.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        .WORK USED BY BASIC INTERNALLY")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("F414 ERRFLG  Error number")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used by the Interpreter error handler to save")
  BiosCallsHelp_L("the error number.")
  BiosCallsHelp_Commit("F40F", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F415 LPTPOS  Position of printer head")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used by the " + Chr(34) + "LPRINT" + Chr(34) + " statement handler to hold")
  BiosCallsHelp_L("the current position of the printer head.")
  BiosCallsHelp_Commit("LPTPOS", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F416 PRTFLG  Flag whether to send to printer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable determines whether the OUTDO standard routine")
  BiosCallsHelp_L("directs its output to the screen or printer: 00H=Screen,")
  BiosCallsHelp_L("01H=Printer.")
  BiosCallsHelp_Commit("PRTFLG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F417 NTMSXP  =0 If MSX printer")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable determines whether the OUTDO standard routine")
  BiosCallsHelp_L("will replace headered graphics characters directed to the")
  BiosCallsHelp_L("printer with spaces: 00H=Graphics, NZ=Spaces. Its value is set")
  BiosCallsHelp_L("at power-up and thereafter only altered by the " + Chr(34) + "SCREEN" + Chr(34))
  BiosCallsHelp_L("statement.")
  BiosCallsHelp_Commit("NTMSXP", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F418 RAWPRT  DB 00H  <>0 If printing is in 'RAW MODE'")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable determines whether the OUTDO standard routine")
  BiosCallsHelp_L("will modify control and headered graphics characters directed")
  BiosCallsHelp_L("to the printer: 00H=Modify, NZ=RAW. Its value is set at power-up")
  BiosCallsHelp_L("and thereafter unaltered.")
  BiosCallsHelp_Commit("RAWPRT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F419 VLZADR  DW 0000H  ADDRESS OF CHARACTER REPLACED BY VAL")
  BiosCallsHelp_L("F41B VLZDAT  DB 00H    CHARACTER REPLACED WITH 0 BY VAL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These variables contain the address and value of any character")
  BiosCallsHelp_L("temporarily removed by the " + Chr(34) + "VAL" + Chr(34) + " function.")
  BiosCallsHelp_Commit("VLZADR", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F41C CURLIN  Current execution line number of BASIC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable contains the current interpreter line number. A")
  BiosCallsHelp_L("value of FFFFH denotes direct mode.")
  BiosCallsHelp_Commit("CURLIN", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F41E KBFMIN  DB " + Chr(34) + ":" + Chr(34))
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This byte provides a dummy prefix to the tokenized text contained")
  BiosCallsHelp_L("in KBUF. Its function is similar to that of ENDPRG")
  BiosCallsHelp_L("but is used for the situation where an error occurs within a")
  BiosCallsHelp_L("direct statement.")
  BiosCallsHelp_Commit("KBFMIN", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F41F KBUF: DEFS 318  Crunch buffer;translated into intermediate")
  BiosCallsHelp_L("                     language from BUF")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer contain the tokenised for of the input line")
  BiosCallsHelp_L("collected by the Interpreter Mainloop. When a direct statement")
  BiosCallsHelp_L("is executed the contents of this buffer form the program text.")
  BiosCallsHelp_Commit("F41F", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F55D BUFMIN: DB " + Chr(34) + "," + Chr(34) + "  used in INPUT st.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This byte provides a dummy prefix to the text contained in BUF.")
  BiosCallsHelp_L("It is used to synchonize the " + Chr(34) + "INPUT" + Chr(34) + " statement handler as it")
  BiosCallsHelp_L("starts to analyse the input text.")
  BiosCallsHelp_Commit("F55D", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F55E BUF: DEFS 258  Buffer to store characters typed( in ASCII code)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer contains the text collected from the console by the")
  BiosCallsHelp_L("INLIN standard routine.")
  BiosCallsHelp_Commit("F55E", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F660 ENDBUF  Prevent overflow of BUF")
  BiosCallsHelp_Commit("ENDBUF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F661 TTYPOS  Virtual cursor location internally retained by BASIC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used by the " + Chr(34) + "PRINT" + Chr(34) + " statement handler to hold")
  BiosCallsHelp_L("the current screen position (Teletype!).")
  BiosCallsHelp_Commit("TTYPOS", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F662 DIMFLG  ARRAY FLAG")
  BiosCallsHelp_L("F663 VALTYP  Type indicator")
  BiosCallsHelp_L("F664 OPRTYP  Store operator number in the extended momentarily before")
  BiosCallsHelp_L("             operator application")
  BiosCallsHelp_L("F664 DORES   Indicates whether stored word can be crunched")
  BiosCallsHelp_L("F665 DONUM   flag for crunch")
  BiosCallsHelp_L("F666 CONTXT  Text address used by CNRGET")
  BiosCallsHelp_L("F668 CONSAV  Store token of constant after calling CHRGET")
  BiosCallsHelp_L("F669 CONTYP  Type of stored constant")
  BiosCallsHelp_L("F66A CONLO   Valu of stored constant")
  BiosCallsHelp_L("F672 MEMSIZ  HIGHEST LOCATION IN MEMORY USED BY BASIC")
  BiosCallsHelp_L("F674 STKTOP  TOP LOCATION TO BE USED FOR THE STACK")
  BiosCallsHelp_L("F676 TXTTAB  Starting address of BASIC text area")
  BiosCallsHelp_L("F678 TEMPPT  Starting address of unused area of")
  BiosCallsHelp_L("             temporary descriptor")
  BiosCallsHelp_L("F67A TEMPST  Temporary descriptors")
  BiosCallsHelp_L("F698 DSCTMP  String descriptor wich is the result of string fun.")
  BiosCallsHelp_L("F69B FRETOP  Starting address of unused area of string area")
  BiosCallsHelp_L("F69D TEMP3   Used for garbage collection or by USR function")
  BiosCallsHelp_L("F69F TEMP8   Used for garbage collection")
  BiosCallsHelp_L("F6A1 ENDFOR  Next address of FOR st.")
  BiosCallsHelp_L("F6A3 DATLIN  Line number of DATA st.read by READ st.")
  BiosCallsHelp_L("F6A5 SUBFLG  Flag for array for USR fun.")
  BiosCallsHelp_L("F6A6 USFLG")
  BiosCallsHelp_L("F6A6 FLGINP  Flag for INPUT or READ")
  BiosCallsHelp_L("F6A7 TEMP    Location for temporary reservation for st.code")
  BiosCallsHelp_L("F6A9 PTRFLG  =0 IF NO LINE NUMBER CONVERTED TO POINTERS")
  BiosCallsHelp_L("F6AA AUTFLG  AUTO MODE FLAG")
  BiosCallsHelp_Commit("DIMFLG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F6AB AUTLIN  Current line number for auto")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Current line number of the AUTO Basic-Statement.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Disk-ROM: largest used sector size (128, 256, 512 or 1024 bytes)")
  BiosCallsHelp_Commit("AUTLIN", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F6AD AUTINC  Increment for auto")
  BiosCallsHelp_L("F6AF SAVTXT  Text pointer for resume")
  BiosCallsHelp_L("F6B1 SAVSTK  Save stack when error occurs")
  BiosCallsHelp_L("F6B3 ERRLIN  Line where last error")
  BiosCallsHelp_L("F6B5 DOT     CURRENT LINE for edit & list")
