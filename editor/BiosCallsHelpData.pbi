  BiosCallsHelp_Commit("DRWANG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCBE RUNBNF  doing bload bsave or not")
  BiosCallsHelp_Commit("RUNBNF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCBF SAVENT  start address for bsave")
  BiosCallsHelp_Commit("SAVENT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCC1 EXPTBL  flag for expanded slot")
  BiosCallsHelp_L("FCC1         DB 00H     ; Primary slot 0")
  BiosCallsHelp_L("FCC2         DB 00H     ; Primary slot 1")
  BiosCallsHelp_L("FCC3         DB 00H     ; Primary slot 2")
  BiosCallsHelp_L("FCC4         DB 00H     ; Primary slot 3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Each of these four variables is normally zero but is set to 80H during the power-up")
  BiosCallsHelp_L("RAM search if the associated Primary Slot is found to be expanded.")
  BiosCallsHelp_Commit("EXPTBL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCC5 SLTTBL  current expanded slot reg")
  BiosCallsHelp_L("FCC5         DB 00H     ; Primary slot 0")
  BiosCallsHelp_L("FCC6         DB 00H     ; Primary slot 1")
  BiosCallsHelp_L("FCC7         DB 00H     ; Primary slot 2")
  BiosCallsHelp_L("FCC8         DB 00H     ; Primary slot 3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These four variables duplicate the contents of the four possible Secondary Slot Registers.")
  BiosCallsHelp_L("The contents of each variable should only be regarded as valid if EXPTBL shows the")
  BiosCallsHelp_L("associated Primary Slot to be expanded.")
  BiosCallsHelp_Commit("SLTTBL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCC9 SLTATR: DEFS 4     ; PS0,SS0")
  BiosCallsHelp_L("             DEFS 4     ; PS0,SS1")
  BiosCallsHelp_L("             DEFS 4     ; PS0,SS2")
  BiosCallsHelp_L("             DEFS 4     ; PS0,SS3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("             DEFS 4     ; PS1,SS0")
  BiosCallsHelp_L("             DEFS 4     ; PS1,SS1")
  BiosCallsHelp_L("             DEFS 4     ; PS1,SS2")
  BiosCallsHelp_L("             DEFS 4     ; PS1,SS3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("             DEFS 4     ; PS2,SS0")
  BiosCallsHelp_L("             DEFS 4     ; PS2,SS1")
  BiosCallsHelp_L("             DEFS 4     ; PS2,SS2")
  BiosCallsHelp_L("             DEFS 4     ; PS2,SS3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("             DEFS 4     ; PS3,SS0")
  BiosCallsHelp_L("             DEFS 4     ; PS3,SS1")
  BiosCallsHelp_L("             DEFS 4     ; PS3,SS2")
  BiosCallsHelp_L("             DEFS 4     ; PS3,SS3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These 64 variables contain the attributes of any extension ROMs found during the power-up ROM search.")
  BiosCallsHelp_L("The extension characteristics of each 16KB ROM are encoded into a single byte so four bytes are")
  BiosCallsHelp_L("required for each possible slot. The encoding is:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 7 set = BASIC program")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 6 set = Device handler")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("  Bit 5 set = Statement handler")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note that the entries for page 0 (0000H to 3FFFH) and page 3 (C000H to FFFFH) will always be zero")
  BiosCallsHelp_L("as only page 1 (4000H to 7FFFH) and page 2 (8000H to BFFFH) are actually examined. The MSX convention")
  BiosCallsHelp_L("is that machine code extension ROMs are placed in page 1 and BASIC program ROMs in page 2.")
  BiosCallsHelp_Commit("FCC9", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FD09 SLTWRK: DEFS 128")
  BiosCallsHelp_L("FD09         DEFW 0, 0, 0, 0   ;PS0, SS0")
  BiosCallsHelp_L("FD11         DEFW 0, 0, 0, 0   ;PS0, SS1")
  BiosCallsHelp_L("FD19         DEFW 0, 0, 0, 0   ;PS0, SS2")
  BiosCallsHelp_L("FD21         DEFW 0, 0, 0, 0   ;PS0, SS3")
  BiosCallsHelp_L("FD29         DEFW 0, 0, 0, 0   ;PS1, SS0")
  BiosCallsHelp_L("FD31         DEFW 0, 0, 0, 0   ;PS1, SS1")
  BiosCallsHelp_L("FD39         DEFW 0, 0, 0, 0   ;PS1, SS2")
  BiosCallsHelp_L("FD41         DEFW 0, 0, 0, 0   ;PS1, SS3")
  BiosCallsHelp_L("FD49         DEFW 0, 0, 0, 0   ;PS2, SS0")
  BiosCallsHelp_L("FD51         DEFW 0, 0, 0, 0   ;PS2, SS1")
  BiosCallsHelp_L("FD59         DEFW 0, 0, 0, 0   ;PS2, SS2")
  BiosCallsHelp_L("FD61         DEFW 0, 0, 0, 0   ;PS2, SS3")
  BiosCallsHelp_L("FD69         DEFW 0, 0, 0, 0   ;PS3, SS0")
  BiosCallsHelp_L("FD71         DEFW 0, 0, 0, 0   ;PS3, SS1")
  BiosCallsHelp_L("FD79         DEFW 0, 0, 0, 0   ;PS3, SS2")
  BiosCallsHelp_L("FD81         DEFW 0, 0, 0, 0   ;PS3, SS3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer provides two bytes of logical workspace for each of")
  BiosCallsHelp_L("the sixty-four possible extension ROMs.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Exceptions: on Korean MSX computers the following bytes are reserved:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("FD0D         DEFS 1            ;SlotID of ROM with characters for SCREEN 9")
  BiosCallsHelp_L("                               ;(located in 4000-7FFF)")
  BiosCallsHelp_L("FD0E         DEFS 1            ;SlotID of Hangul ROM")
  BiosCallsHelp_L("                               ;(located in 4000-7FFF on MSX1, in 4000-BFFF on MSX2)")
  BiosCallsHelp_L("FD10         DEFS 1            ;?")
  BiosCallsHelp_Commit("FD09", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FD89 PROCNM: DEFS 16  name of expanded statement")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This buffer is used to hold a device or statement name for")
  BiosCallsHelp_L("examination by an extension ROM.")
  BiosCallsHelp_Commit("FD89", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FD99 DEVICE  device ID for cartrige 0-3")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This variable is used to pass the device code, from 0 to 3, to an")
  BiosCallsHelp_L("extension ROM.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("THE USE OF HOOKS")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Hooks provide a way to intercept the BASIC interpreter or operating system at certain points,enabling additional,or alternative,processing to be carried out.To expand on the last sentence it i s easiest to use an to be carried out.To expand on the last sentence it iseasiest to use an example.Consider for example the BIOS call CHPUT(see section 2.3).This routine is used to print text on the screen.Here is a disassembly of the first few instructions of CHPUT :")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        PUSH    HL      SAVE ALL THE REGISTERS USED")
  BiosCallsHelp_L("        PUSH    DE")
  BiosCallsHelp_L("        PUSH    BC")
  BiosCallsHelp_L("        PUSH    AF")
  BiosCallsHelp_L("        CALL    FDA4    CALL THE HOOK HCHPU")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("First of all registers HL,BC,DE and AF are pushed on to the stack.Then memory address FDA4 is called.Normally,the contents of FDA4 and the following 4 bytes,is a Z80 RET instruction,immediately passing control to the instruction following the CALL.However,FDA4 is in RAM,so its contents can be altered.Let the 3 bytes,starting at FDA4 be changed,so that control is passed to another subroutine at D000,i.e.")
  BiosCallsHelp_Commit("DEVICE", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDA4    C3 00 D0        JP      D000")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Also let the code at D000 be as shown below :")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("        POP     HL      GET RID OF THE FIRST ITEM ON THE")
  BiosCallsHelp_L("                        STACK(i.e.RETURN TO HOOK ADDRESS)")
  BiosCallsHelp_L("        POP     AF      RESTORE THE REGISTERS")
  BiosCallsHelp_L("        POP     BC")
  BiosCallsHelp_L("        POP     DE")
  BiosCallsHelp_L("        POP     HL")
  BiosCallsHelp_L("        RET             EXIT BIOS CALL CHPUT.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Now the item on the top of the stack is 3 more than the address from which FDA4 was called,i.e.the return address to CHPUT.Therefore,if this is removed from the stack,this will restore the stack to the state it was in immediately before calling FDA4.Also,if the next four items are popped as shown above,the stack will be as it was on entering CHPUT,so the RET instruction will exit the subroutine CHPUT.Consequently the character which was to be printed will not be!")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This example demonstrates how the operating system can be intercepted.The five bytes,starting at address FDA4,are know as a hook.Similar " + Chr(34) + "hook" + Chr(34) + " exist at many other points in the operating system and BASIC interpreter,and a list of them,in alphabetical order,is contained in the following pages.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("-----------------------------------------------------------------")
  BiosCallsHelp_L("+       No RET on hook")
  BiosCallsHelp_L("+/c     No RET on hook if network is present")
  BiosCallsHelp_L("+/sc    Hook doesn't change for sc 8")
  BiosCallsHelp_L("-----------------------------------------------------------------")
  BiosCallsHelp_L("+/c     FD9A+   HKEYI   0C4A  Interrupt handler")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This hook is invoked on every(!) interrupt, regardless which device")
  BiosCallsHelp_L("has triggered it. The hook-routine is responsible to determine")
  BiosCallsHelp_L("which event (scanline-interrupt, ...) has occured.")
  BiosCallsHelp_Commit("C3", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FD9F+   HTIMI   0C53  Interrupt handler")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This hook is invoked on VDP-interrupts, after the screen has been")
  BiosCallsHelp_L("refreshed (50 or 60 times per second, depending on the refresh")
  BiosCallsHelp_L("frequency).")
  BiosCallsHelp_Commit("FD9F", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDA4+/scHCHPU   08C0  CHPUT standard routine (A-character;SAVE ALL)")
  BiosCallsHelp_L("        FDA9+/scHDSPC   09E6  Display cursor    (no param.)")
  BiosCallsHelp_L("        FDAE+/scHERAC   0A33  Errase cursor     (no param.)")
  BiosCallsHelp_L("        FDB3+/scHDSPF   0B2B  DSPFNK std routine(no param.)")
  BiosCallsHelp_L("        FDB8+/scHERAF   0B15  ERAFNK std routine(no param.)")
  BiosCallsHelp_L("        FDBD    HTOTE   0842  TOTEXT std routine")
  BiosCallsHelp_Commit("FDA4", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDC2+   HCHGE   10CE  CHGET  std routine")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Not verified: this hook procedure is invoked from CHGET before")
  BiosCallsHelp_L("the CHSNS routine(s) are executed and check if characters are arrived.")
  BiosCallsHelp_Commit("FDC2", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDC7+   HINIP   071E  Copy character set to VDP")
  BiosCallsHelp_Commit("FDC7", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDCC    HKEYC   1025  Keyboard decoder")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Not verified: This hook procedure is invoked to determine which")
  BiosCallsHelp_L("group of keys the key number supplied in register A belongs to.")
  BiosCallsHelp_L("This hook is called for every input of the keyboard-matrix to be")
  BiosCallsHelp_L("recognized (even if the key does not generate a character, or it")
  BiosCallsHelp_L("generates multiple characters).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Commonly defined groups are: " + Chr(34) + "Home" + Chr(34) + ", " + Chr(34) + "Stop" + Chr(34) + ", " + Chr(34) + "Shift, Ctrl, Graph, Code/Kana,")
  BiosCallsHelp_L("Esc, Tab, Bs, CR, Del, Cursor" + Chr(34) + ", " + Chr(34) + "Caps" + Chr(34) + ", " + Chr(34) + "rows 0 to 5" + Chr(34) + " and " + Chr(34) + "F1 to F5" + Chr(34) + ".")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The key code is available in register A. The mapping table")
  BiosCallsHelp_L("(next higher key number, internal offset for jump into group-handler)")
  BiosCallsHelp_L("is available in HL.")
  BiosCallsHelp_Commit("HKEYC", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDD1    HKYEA   0F10  Keyboard decoder")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Not verified: this hook is called by the keyboard decoder")
  BiosCallsHelp_L("to enable pre-processing of the keys:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("SHIFT, CTRL, GRAPH, CODE (Kana?), ESC,")
  BiosCallsHelp_L("TAB, BS, CR, SEL, SPACE, INS, DEL, CURSOR.")
  BiosCallsHelp_L("The key code is available in register A.")
  BiosCallsHelp_L("In contrast to HKEYC this hook is called for the given keys only!")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This hook is invoked to processes key numbers")
  BiosCallsHelp_L("30H to 57H apart from the CAP, F1 to F5, STOP and HOME keys.")
  BiosCallsHelp_Commit("HKYEA", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FDD6    HNMI    1398  NMI std routine")
  BiosCallsHelp_L("        FDDB    HPINL   23BF  PINLIN std routine")
  BiosCallsHelp_L("        FDE0    HQINL   23CC  QINLIN std routine")
  BiosCallsHelp_L("        FDE5    HINLI   23D5  INLIN std routine")
  BiosCallsHelp_L("        FDEA    HONGO   7810  " + Chr(34) + "ON DEVICE GOSUB" + Chr(34))
  BiosCallsHelp_L("        FDEF+   HDSKO   7C16  " + Chr(34) + "DSKO$" + Chr(34))
  BiosCallsHelp_L("        FDF4    HSETS   7C1B  " + Chr(34) + "SET" + Chr(34))
  BiosCallsHelp_L("        FDF9+   HNAME   7C20  " + Chr(34) + "NAME" + Chr(34))
  BiosCallsHelp_L("        FDFE+   HKILL   7C25  " + Chr(34) + "KILL" + Chr(34))
  BiosCallsHelp_L("        FE03    HIPL    7C2A  " + Chr(34) + "IPL" + Chr(34))
