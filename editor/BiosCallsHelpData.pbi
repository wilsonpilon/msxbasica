  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFCA    FCALL   or EXTBIO: extended BIOS call")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("To use the extended BIOS, the program should test " + Chr(34) + "HOKVLD" + Chr(34) + " flag at FB20h in page-3.")
  BiosCallsHelp_L("If bit-0 (LSB) is 0, there is no extended BIOS nor the mapper support. Otherwise,")
  BiosCallsHelp_L(Chr(34) + "EXTBIO" + Chr(34) + " entry has been set up and it can be called with various parameters.")
  BiosCallsHelp_L("Note that this test is unnecessary for the applications which are based on MSX-DOS (such as")
  BiosCallsHelp_L("the program which is loaded from the disk), and the program may proceed to the next step.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Next, the program sets the device number of the extended BIOS in register D, the function number")
  BiosCallsHelp_L("in register E, and required parameters in other registers, and then calls " + Chr(34) + "EXTBIO" + Chr(34) + " at FFCAh in page-3.")
  BiosCallsHelp_L("In this case, the stack pointer must be in page-3.")
  BiosCallsHelp_L("If there is the extended BIOS for the specified device number, the contents of the registers")
  BiosCallsHelp_L("AF, BC and HL are modified according to the function; otherwise, they are preserved.")
  BiosCallsHelp_L("Register DE is always preserved. Note that in any cases the contents of the alternative")
  BiosCallsHelp_L("registers (AF', BC', DE' and HL') and the index registers (IX and IY) are corrupted.")
  BiosCallsHelp_Commit("FCALL", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFCF    HBGFD,DISKON   before physical operation with disk controller")
  BiosCallsHelp_L("        FFD4    HENFD          after physical operation with disk controller")
  BiosCallsHelp_Commit("FFCF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFE7 RG8SAV: DEFB 00H  ;Copy of VDP-register  8  (Basic:  9)")
  BiosCallsHelp_L("FFE8 RG9SAV: DEFB 00H  ;Copy of VDP-register  9  (Basic: 10)")
  BiosCallsHelp_L("FFE9 RG10SA: DEFB 00H  ;Copy of VDP-register 10  (Basic: 11)")
  BiosCallsHelp_L("FFEA RG11SA: DEFB 00H  ;Copy of VDP-register 11  (Basic: 12)")
  BiosCallsHelp_L("FFEB RG12SA: DEFB 00H  ;Copy of VDP-register 12  (Basic: 13)")
  BiosCallsHelp_L("FFEC RG13SA: DEFB 00H  ;Copy of VDP-register 13  (Basic: 14)")
  BiosCallsHelp_L("FFED RG14SA: DEFB 00H  ;Copy of VDP-register 14  (Basic: 15)")
  BiosCallsHelp_L("FFEE RG15SA: DEFB 00H  ;Copy of VDP-register 15  (Basic: 16)")
  BiosCallsHelp_L("FFEF RG16SA: DEFB 00H  ;Copy of VDP-register 16  (Basic: 17)")
  BiosCallsHelp_L("FFF0 RG17SA: DEFB 00H  ;Copy of VDP-register 17  (Basic: 18)")
  BiosCallsHelp_L("FFF1 RG18SA: DEFB 00H  ;Copy of VDP-register 18  (Basic: 19)")
  BiosCallsHelp_L("FFF2 RG19SA: DEFB 00H  ;Copy of VDP-register 19  (Basic: 20)")
  BiosCallsHelp_L("FFF3 RG20SA: DEFB 00H  ;Copy of VDP-register 20  (Basic: 21)")
  BiosCallsHelp_L("FFF4 RG21SA: DEFB 00H  ;Copy of VDP-register 21  (Basic: 22)")
  BiosCallsHelp_L("FFF5 RG22SA: DEFB 00H  ;Copy of VDP-register 22  (Basic: 23)")
  BiosCallsHelp_L("FFF6 RG23SA: DEFB 00H  ;Copy of VDP-register 23  (Basic: 24)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The above Bytes contain a copy of the write-only VDP-registers 8 to 23 (since MSX2).")
  BiosCallsHelp_L("Copies of registers 0-7 are located at RG0SAV (F3DFH), registers 25-27 at RG25SAV (FFFAH).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Caution: because the statusregister VDP(8) is only valid for Basic the register-numbers are shifted.")
  BiosCallsHelp_Commit("FFE7", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFF7 ROMSLT  Slot-ID of the Main-ROM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Slot-ID of the MainROM.")
  BiosCallsHelp_Commit("ROMSLT", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFF8: DW ????H  ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("??? (#17A6, GT rom)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte on &HFFF8 may contain a copy of the optional A/V-Controller byte")
  BiosCallsHelp_L("(see also I/O-port &HF8).")
  BiosCallsHelp_Commit("FFF8", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFFA RG25SA: DEFB 00H  ;Copy of VDP-register 25  (Basic: 26)")
  BiosCallsHelp_L("FFFB RG26SA: DEFB 00H  ;Copy of VDP-register 26  (Basic: 27)")
  BiosCallsHelp_L("FFFC RG27SA: DEFB 00H  ;Copy of VDP-register 27  (Basic: 28)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The above Bytes contain a copy of the write-only VDP-registers 25 to 27 (since MSX2+).")
  BiosCallsHelp_L("Copies of registers 0-7 are located at RG0SAV (F3DFH), registers 8-23 at RG8SAV (FFE7H).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Caution: because the statusregister VDP(8) is only valid for Basic the register-numbers are shifted.")
  BiosCallsHelp_Commit("FFFA", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFFD ?: DW ????")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("These 16bits are used for saving the stack-pointer while switching the CPU")
  BiosCallsHelp_L("between Z80 and R800, which is performed by the CHGCPU routine.")
  BiosCallsHelp_Commit("FFFD", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FFFF ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This byte controls the Slot-Expander of the currently active primary slot. Because each primary slot contains it's own slot-expander page 3 (C000H-FFFFH) should be changed first, by using WSLREG (013BH). Now the secondary-slot register can be changed and -if necessary- page 3 can be restored to the original primary slot.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Important: if a slot-expander is present the read value is the binary complement of the correct value. If writing to this register the correct value must be used!")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Source: information on this page are collected from the " + Chr(34) + "The MSX Red Book" + Chr(34))
  BiosCallsHelp_L("and various web-sites.")
  BiosCallsHelp_Commit("FFFF", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0 | Text | 40x24, 80x24 | no sprites")
  BiosCallsHelp_L("1 | Text | 32x24 | 4 sprites per line")
  BiosCallsHelp_L("2 | Graphics | 256x192x16 | 4 sprites per line")
  BiosCallsHelp_L("3 | Multicolor | 64x48x16 | 4 sprites per line")
  BiosCallsHelp_L("4 | Graphics | 256x192x16 | 8 sprites per line")
  BiosCallsHelp_L("5 | Graphics | 256x212x16 | 8 sprites per line")
  BiosCallsHelp_L("6 | Graphics | 512x212x4 | 8 sprites per line")
  BiosCallsHelp_L("7 | Graphics | 512x212x16 | 8 sprites per line")
  BiosCallsHelp_L("8 | Graphics | 256x212x256 | 8 sprites per line")
  BiosCallsHelp_L("9 | Text | 80x24 | no sprites")
  BiosCallsHelp_L("10 | Graphics | 256x212xALot16 | 8 sprites per line")
  BiosCallsHelp_L("11 | Graphics | 256x212xALot256 | 8 sprites per line")
  BiosCallsHelp_L("12 | Graphics | 256x212x19268 | 8 sprites per line")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Notes:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Screens 4-8 are available on MSX2 computers only!")
  BiosCallsHelp_L("Screen 9 is available on Korean MSX2 computers only!")
  BiosCallsHelp_L("Screen 10 and 12 are identical, but uses different color-ranges in BIOS-calls: Screen 10 from 0 to 15, Screen 11 from 0 to 255. Screen 12 can display up to 19268 colors simultaneously, Screens 10 and 11 are using a color-subset, the remaining bits can be used to define a own 16color-palette...")
  BiosCallsHelp_Commit("Screen-modes", "RAM-variables")

  BiosCallsHelp_Begin()
