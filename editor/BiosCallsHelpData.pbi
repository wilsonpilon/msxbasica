  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FEDA    HSTKE   62F0  Reset stack")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This hook can be set during power-up. If set the hook is invoked after the system (all ROM-extensions, ...) are fully initialized.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This hook is usually set by cartridge-ROM initialisation routines,")
  BiosCallsHelp_L("if the cartridge-ROM may also need to access the Disk-ROM")
  BiosCallsHelp_L("(which would be initialized later in many cases).")
  BiosCallsHelp_Commit("HSTKE", "RAM-variables")

