  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0069H PAINT")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by the Basic-Interpreter to execute the PAINT-statement. It fills the surrounded areaof the graphic-screen (modes 5-8) with the specified color.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This function is usually not applicable for machinecode-programs.")
  BiosCallsHelp_L("Entry: | HL = Basic-pointer")
  BiosCallsHelp_L("Exit: | HL = new pointer")
  BiosCallsHelp_L("Modifies: | all")
  BiosCallsHelp_Commit("PAINT", "SubROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0069H PSET")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This routine is used by the Basic-Interpreter to execute the PSET-statement. It places a pixel of the specified color on the graphic-screen (mode 5-8).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This function is usually not applicable for machinecode-programs.")
  BiosCallsHelp_L("Entry: | HL = Basic-pointer")
  BiosCallsHelp_L("Exit: | HL = new pointer")
  BiosCallsHelp_L("Modifies: | all")
  BiosCallsHelp_Commit("PSET", "SubROM")

