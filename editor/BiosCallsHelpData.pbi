  BiosCallsHelp_Commit("GRPACX", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCB9 GRPACY")
  BiosCallsHelp_Commit("GRPACY", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCBB DRWFLG")
  BiosCallsHelp_Commit("DRWFLG", "RAM-variables")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("FCBC DRWSCL")
  BiosCallsHelp_Commit("DRWSCL", "RAM-variables")

