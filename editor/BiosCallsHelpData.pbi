  BiosCallsHelp_Begin()
  BiosCallsHelp_L("F355 DPBLST  List of DRIVE PARAMETERS BLOCK")
  BiosCallsHelp_L("F355         adress of DPB for drive A:")
  BiosCallsHelp_L("F357         adress of DPB for drive B:")
  BiosCallsHelp_L("F359         adress of DPB for drive C:")
  BiosCallsHelp_L("F35B         adress of DPB for drive D:")
  BiosCallsHelp_L("F35D         adress of DPB for drive E:")
  BiosCallsHelp_L("F35F         adress of DPB for drive F:")
  BiosCallsHelp_L("F361         adress of DPB for drive G:")
  BiosCallsHelp_L("F363         adress of DPB for drive H:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Adresses of drive parameters block for drive A: to H:.")
  BiosCallsHelp_L("Every of the drive parameter blocks has the following layout:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("             +00    DRIVE    Drive (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("             +01    ID       Media ID byte (0F8h/0F9h)")
  BiosCallsHelp_L("             +02/03 SECSIZ   Sector size (200h = 512 byte)")
  BiosCallsHelp_L("             +04    DIRMSK   (Directory entries in 1 sector)-1 = (SECSIZ/32)-1")
  BiosCallsHelp_L("             +05    DIRSHFT  Number of 1-bits in DIRMSK")
  BiosCallsHelp_L("             +06    CLUSMSK  (Number of sectors per cluster)-1")
  BiosCallsHelp_L("             +07    CLUSSHFT (Number of 1-bits in CLUSMSK)+1")
  BiosCallsHelp_L("             +08/09 FIRFAT   First sector of the FAT")
  BiosCallsHelp_L("             +0A    FATCNT   Number of FATs")
  BiosCallsHelp_L("             +0B    MAXENT   Maximum number of directory entries")
  BiosCallsHelp_L("             +0C/0D FIRREC   First sector of the data-area")
  BiosCallsHelp_L("             +0E/0F MAXCLUS  Maximum number of clusters")
  BiosCallsHelp_L("             +10    FATSIZ   Number of sectors per FAT")
  BiosCallsHelp_L("             +11    FIRDIR   First sector of the directory")
  BiosCallsHelp_L("             +12    FATADR   Address of the FAT rise in RAM")
  BiosCallsHelp_Commit("DPBLST", "RAM-variables")

