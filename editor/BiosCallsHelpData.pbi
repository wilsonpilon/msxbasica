  BiosCallsHelp_Begin()
  BiosCallsHelp_L("01BDH KNJPRT Print Kanji character")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Prints a Kanji character onto the graphic screen (5-8). On international MSX-computers this routine does nothing.")
  BiosCallsHelp_L("Entry: | BC = JIS kanji code (first standard on MSX2, first and second standard on MSX2+)")
  BiosCallsHelp_L("A = display mode")
  BiosCallsHelp_L("	  ")
  BiosCallsHelp_L("	  The display mode has following meanings in the same way with the PUT KANJI command of BASIC.")
  BiosCallsHelp_L("	  0	Displays by 16x16 dots")
  BiosCallsHelp_L("	  1	Displays even numbered dots")
  BiosCallsHelp_L("	  2	Displays odd numbered dots")
  BiosCallsHelp_L("[GRPACX(FCB7H)] X coordinate")
  BiosCallsHelp_L("[GRPACY(FCB9H)] Y coordinate")
  BiosCallsHelp_L("Exit: | ?")
  BiosCallsHelp_L("Modifies: | AF")
  BiosCallsHelp_Commit("KNJPRT", "SubROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("01F5H REDCLK read Clock-IC data")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reads CLOCK-IC register in the address specified by the")
  BiosCallsHelp_L("C register and stores in the A register. Since the address")
  BiosCallsHelp_L("specification includes the block selection information as")
  BiosCallsHelp_L("described in the RTC description, it is not necessary to set the MODE")
  BiosCallsHelp_L("register and then read the objective register.")
  BiosCallsHelp_L("Entry: | C")
  BiosCallsHelp_L("address ( . . b5 b4 b3 b2 b1 b0")
  BiosCallsHelp_L("              |-+-| |---------|")
  BiosCallsHelp_L("                |     register")
  BiosCallsHelp_L("                |")
  BiosCallsHelp_L("                +---> block")
  BiosCallsHelp_L("Exit: | A=data (only 4 lower bits valid)")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: Clockchip (RTC)")
  BiosCallsHelp_Commit("REDCLK", "SubROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("01F9H WRTCLK write Clock-IC data")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("write the contents of the A register in the CLOCK-IC at the")
  BiosCallsHelp_L("address specified by the C register. The address is specified")
  BiosCallsHelp_L("in the format explained in the RTC documentation as REDCLK.")
  BiosCallsHelp_L("Entry: | C=address")
  BiosCallsHelp_L("Exit: | A=data")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Refer to: Clockchip (RTC)")
  BiosCallsHelp_Commit("WRTCLK", "SubROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4010H PHYDIO Physical Disk-I/O")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reads/writes sectors to disk.")
  BiosCallsHelp_L("Entry: | F = CARRY is write")
  BiosCallsHelp_L("A = Drive number (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("B = number of sectors to read/write")
  BiosCallsHelp_L("C = media-descriptor")
  BiosCallsHelp_L("DE = logical sector number (0 based)")
  BiosCallsHelp_L("HL = transfer address")
  BiosCallsHelp_L("Exit: | F = CARRY if error")
  BiosCallsHelp_L("A = errorcode (if error)")
  BiosCallsHelp_L("B = number of sectors transfered (always)")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("PHYDIO", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4013H DSKCHG Check for Disk-Change")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Checks if the disk was changed.")
  BiosCallsHelp_L("If the disk has been changed or may have been changed (unknown)")
  BiosCallsHelp_L("read the boot sector or the FAT sector for disk media descriptor")
  BiosCallsHelp_L("and transfer a new DPB as with GETDPB.")
  BiosCallsHelp_L("Entry: | A = Drive number (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("B = media-descriptor")
  BiosCallsHelp_L("C = media-descriptor")
  BiosCallsHelp_L("HL = Base address of DPB")
  BiosCallsHelp_L("Exit: | F = CARRY if error")
  BiosCallsHelp_L("A = errorcode (if error)")
  BiosCallsHelp_L("B = on success: 1=unchanged, 0=unknown, -1=changed")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("DSKCHG", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4016H GETDPB Get disk-parameter-block")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Gets the disk-format.")
  BiosCallsHelp_L("Entry: | A = Drive number (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("B = 1st byte of FAT (media descriptor)")
  BiosCallsHelp_L("C = media-descriptor")
  BiosCallsHelp_L("HL = Base address of DPB")
  BiosCallsHelp_L("Exit: | [HL+1] ... [HL+18] = DPB for specified drive")
  BiosCallsHelp_L("DPB consists of:")
  BiosCallsHelp_L("MEDIA    0     1   Media type (F8..FF)")
  BiosCallsHelp_L("SECSIZ   1     2   Sector size (must be 2^n)")
  BiosCallsHelp_L("DIRMSK   3     1   (SECSIZE/32)-1")
  BiosCallsHelp_L("DIRSHFT  4     1   Number of one bits in DIRMSK")
  BiosCallsHelp_L("CLUSMSK  5     1   (Sectors per cluster)-1")
  BiosCallsHelp_L("CLUSSHFT 6     1   (Number of one bits in CLUSMSK)+1")
  BiosCallsHelp_L("FIRFAT   7     2   Logical sector number of first FAT")
  BiosCallsHelp_L("FATCNT   8     1   Number of FATs")
  BiosCallsHelp_L("MAXENT   A     1   Number of directory entries")
  BiosCallsHelp_L("                   (max. 254)")
  BiosCallsHelp_L("FIRREC   B     2   Logical sector number of first data")
  BiosCallsHelp_L("MAXCLUS  D     2   Number of clusters")
  BiosCallsHelp_L("                   (not including reserved, FAT and")
  BiosCallsHelp_L("                   directory sectors)+1")
  BiosCallsHelp_L("FATSIZ   F     1   Number of sectors used")
  BiosCallsHelp_L("FIRDIR   10    2   FAT logical sector number of start")
  BiosCallsHelp_L("                   of directory")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("GETDPB", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4019H CHOICE ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | HL = Address of zero terminated character string with the text")
  BiosCallsHelp_L("      with choices for a DSKFMT.")
  BiosCallsHelp_L("      If there is no choice (only 1 format supported) return [HL]=0")
  BiosCallsHelp_L("IDE: this function may not be supported by all ROMs.")
  BiosCallsHelp_Commit("CHOICE", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("401CH DSKFMT Format disk")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("It formats the disk in a specified drive.")
  BiosCallsHelp_L("Entry: | A = Specified choice (1-9). See CHOICE")
  BiosCallsHelp_L("D = Drive number (0=A:, 1=B:, ...)")
  BiosCallsHelp_L("HL = Begin address of work area")
  BiosCallsHelp_L("BC = Length of work area")
  BiosCallsHelp_L("Exit: | F = CARRY if error")
  BiosCallsHelp_L("A = errorcode (if error)")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_L("IDE: this function may not be supported by all ROMs.")
  BiosCallsHelp_Commit("DSKFMT", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("401FH DRVOFF Drives-off")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Stop all drives served by this disk rom.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("This function can be used safely. Though, before calling it, you should check ")
  BiosCallsHelp_L("if the disk rom serves a floppy drive or a hard drive. You should not call ")
  BiosCallsHelp_L("this function for hard drives. Some hard drive interfaces actually turn of ")
  BiosCallsHelp_L("the hard drive when this function is called and will never turn the hard ")
  BiosCallsHelp_L("drive on again.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_Commit("DRVOFF", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4022H ? Jump to BASIC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("SCSI: this function may not be supported by all ROMs")
  BiosCallsHelp_L("(e.g. NOVAXIS simply returns from this call where HSH-SCSI")
  BiosCallsHelp_L("supports it).")
  BiosCallsHelp_Commit("4022H", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4025H ? Format routine (with questions)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("IDE+SCSI: this function may not be supported by all ROMs")
  BiosCallsHelp_L("(e.g. NOVAXIS simply returns from this call where HSH-SCSI")
  BiosCallsHelp_L("supports it).")
  BiosCallsHelp_Commit("4025H", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("4029H ? Stop drive(s)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Stop all drives served by all disk roms.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("You should never use this function, for the following two reasons:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("1) It can stop hard drives of people that have a disk rom that can turn of ")
  BiosCallsHelp_L("the hard drive.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2) The DOS2 ROM of the MSX turbo R contains a small bug in the call to the ")
  BiosCallsHelp_L("CPU switching routine, which can cause the MSX turbo R to crash.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("SCSI: this function may not be supported by all ROMs")
  BiosCallsHelp_L("(e.g. NOVAXIS simply returns from this call where HSH-SCSI")
  BiosCallsHelp_L("supports it).")
  BiosCallsHelp_Commit("4029H", "Disk-ROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("402DH ? Where Am I (calculates slot number of DOS2)")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | A = slot number")
  BiosCallsHelp_L("Modifies: | ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("SCSI specific")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The following functions are at least valid on NOVAXIS and HSH SCSI controllers:")
  BiosCallsHelp_Commit("402DH", "Disk-ROM")

  BiosCallsHelp_Begin()
