  BiosCallsHelp_L("")
  BiosCallsHelp_L("These 2 bytes are used to identify the Subrom: 43H and 44H (" + Chr(34) + "CD" + Chr(34) + ").")
  BiosCallsHelp_Commit("0000H", "SubROM")

