; Auto-gerado por convert_msxbios.py (descartavel, nao versionado) a partir de
; help/MSXBIOS.CHM (RuMSX, Lex Lechz - lexlechz.at), secao "BIOS Topics": rotinas
; nomeadas de cada area de ROM/RAM do MSX (MainROM/SubROM/Disk-ROM/etc.), uma por
; topico quando o HTML original listava endereco+nome (a maioria); paginas sem esse
; padrao viram um topico unico. Conteudo reproduzido como no original.

Structure BiosCallsHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList BiosCallsHelp_Topics.BiosCallsHelpTopic()
Global BiosCallsHelp_DataBuilt.b = #False
Global NewList BiosCallsHelp_Scratch.s()

Procedure BiosCallsHelp_Begin()
  ClearList(BiosCallsHelp_Scratch())
EndProcedure

Procedure BiosCallsHelp_L(Line.s)
  AddElement(BiosCallsHelp_Scratch())
  BiosCallsHelp_Scratch() = Line
EndProcedure

Procedure BiosCallsHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach BiosCallsHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + BiosCallsHelp_Scratch()
    First = #False
  Next
  AddElement(BiosCallsHelp_Topics())
  BiosCallsHelp_Topics()\Titulo = Titulo
  BiosCallsHelp_Topics()\Grupo = Grupo
  BiosCallsHelp_Topics()\Corpo = Body
EndProcedure

Procedure BiosCallsHelp_BuildData()
  If BiosCallsHelp_DataBuilt
    ProcedureReturn
  EndIf
  BiosCallsHelp_DataBuilt = #True

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0000H CHKRAM Power-up, check RAM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to perform memory initialisation at power-up. It non-destructively tests for RAM in pages 2 and 3 in all sixteen possible slots then sets the primary and secondary slot registers to switch in the largest area found. The entire workspare area (F380H to FF9CH) is zeroed and EXPTBL and SLTTBL filled in to map any extension interfaces in existence. Interrupt mode 1 i set and control transfers to the ramainder of the power-up initialisation routine (7C76H).")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, HL, SP")
  BiosCallsHelp_Commit("CHKRAM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0004H CGTABL")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("2 Bytes, adress of ROM character set")
  BiosCallsHelp_Commit("CGTABL", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0006H VDP.DR")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("One byte, VDP data port-number (read port)")
  BiosCallsHelp_Commit("VDP.DR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0007H VDP.DW")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("One byte, VDP data port-number (write port)")
  BiosCallsHelp_Commit("VDP.DW", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0008H SYNCHR Check BASIC program character")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to check the current program text character, whose address is supplied in register pair HL, agains a reference character. The reference character is supplied as single byte immediately following the CALL or RST instruction, for example:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("    RST    8")
  BiosCallsHelp_L("    DEFB    " + Chr(34) + "," + Chr(34))
  BiosCallsHelp_L("")
  BiosCallsHelp_L("If the character does not match a " + Chr(34) + "Syntax error" + Chr(34) + " is generated, otherwise control transfers to the CHRGTR standard routine to fetch the next program character.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | HL=points to the character to check")
  BiosCallsHelp_L("Exit: | A=Next program character")
  BiosCallsHelp_L("Modifies: | AF, HL")
  BiosCallsHelp_Commit("SYNCHR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("000CH RDSLT  Read RAM in any slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to read a single byte from memory in any slot. The slot identifier is composed of a primary slot number and a flag:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("    7       6       5       4       3       2       1       0")
  BiosCallsHelp_L("+-------+-------+-------+-------+-------+-------+-------+-------+")
  BiosCallsHelp_L("| Flag  |   0   |   0   |   0   |    SSLOT #    |    PSLOT #    |")
  BiosCallsHelp_L("+-------+-------+-------+-------+-------+-------+-------+-------+")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The flag is normally 0 but must be 1 if the secondary slot number is included in the Slot ID. The memory address and Slot ID are first processed to yield a set of bit masks to apply to the relevant slot register. If a secondary slot number is specified then the secondary slot register is first modified to select the relevant page from the secondary slot. The primary slot is then switched in to the Z80 address space, the byte read and the primary slot restored to it's original setting via the RDPRIM routine in the workspace area. Finally, if a secondary slot number is included in the Slot ID, the original secondary slot register setting is restored.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Note that, unless it is the slot containing the workspace area, any attempt to access page 3 (C000H to FFFFH) will cause the system to crash as RDPRIM will switch itself out. Note also that interrupts are left disabled by all the memory switching routines.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | A=Slot ID")
  BiosCallsHelp_L("HL=Address")
  BiosCallsHelp_L("Exit: | A=Byte read")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, DI")
  BiosCallsHelp_Commit("RDSLT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0010H CHRGTR Get next BASIC program character")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to fetch the next character from the program text. Register pair HL is incremented and the character placed in register A. If it's a space, TAB code (09H) or LF code (0AH) is skipped over. If it's a statement separator (3AH) or end of line character (00H) the routine terminates with flag Z, NC. If it is a digit from " + Chr(34) + "0" + Chr(34) + " to " + Chr(34) + "9" + Chr(34) + " the routine terminates with flag NZ,C. If it is any other character apart from the nueric prefix tokens the routine terminates with flag NZ, NC. If the character is one of the numeric prefix tokens then it is placed in CONSAV and the operand copied to CONLO. The code is placed in CONTYP and the address of the trailing program character in CONTXT.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | HL=Points to current program character")
  BiosCallsHelp_L("Exit: | A=Next program character")
  BiosCallsHelp_L("Modifies: | AF, HL")
  BiosCallsHelp_Commit("CHRGTR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0014H WRSLT  Write to RAM in any slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to write a single byte to memory in anyslot. Ist operation is fundamentally the same as that of the RDSLT standard routine except that the workspace area routine WRPRIM is used rather than RDPRIM.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | A=Slot ID")
  BiosCallsHelp_L("HL=Address")
  BiosCallsHelp_L("E=Byte to write")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, D, DI")
  BiosCallsHelp_Commit("WRSLT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0018H OUTDO  Output to current device")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine used by the BASIC Interpreter to output a character to the current device. The ISFLIO standard routine is first used to check whether output is currently directed to anI/O buffer, if so control transfers to the sequential output driver via the CALBAS standard routine. If PRTFLG is zero control transfers to the CHPUT standard routine to output the character to the screen. Assuming the printer is active RAWPRT is checked. If this is non-zero the character is passed directly to the printer, otherwise the control drops into the OUTDLP standard routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | A=Character to output")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI")
  BiosCallsHelp_Commit("OUTDO", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("001CH CALSLT Call routine in any slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to call an address in any slot. Ist operation is fundamentally the same as that of the RDSLT standard routine except that the workspace area routine CLPRIM is used rather than RDPRIM. Note that CALBAS and CALLF are just specialised entry points to this standard routine which offer a reduction in the amount of code required.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | IY (HighByte) =Slot ID")
  BiosCallsHelp_L("IX=Address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF', BC', DE', HL', DI")
  BiosCallsHelp_Commit("CALSLT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0020H DCOMPR Compare register pairs HL and DE")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine used by the BASIC Interpreter to check the relative values of register pairs HL and DE.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | HL")
  BiosCallsHelp_L("DE")
  BiosCallsHelp_L("Exit: | Flag NC, if HL>DE")
  BiosCallsHelp_L("Flag Z, if DL=DE")
  BiosCallsHelp_L("Flag C, if HL<DE")
  BiosCallsHelp_L("Modifies: | AF")
  BiosCallsHelp_Commit("DCOMPR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0024H ENASLT Enable any slot permanently")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to switch in a page permanently from any slot. Unlike RDSLT, WRSLT and CALSLT standard routines the primary slot switching is performed directly and not by a workspace area routine. Consequently addresses in page 0 (0000H to 3FFFH) will cause an immediate system crash.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | A=Slot ID")
  BiosCallsHelp_L("HL=Address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, DI")
  BiosCallsHelp_Commit("ENASLT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0028H GETYPR Get BASIC operand type")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to return the type of the current operand, determined by VALTYP as follows:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Integer | A=FFH | Flag M,NZ,C")
  BiosCallsHelp_L("String | A=00H | Flag P,Z,C")
  BiosCallsHelp_L("Single precision | A=01H | Flag P,NZ,C")
  BiosCallsHelp_L("Double precision | A=05H | Flag P,NZ,NC")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | AF=Type")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF")
  BiosCallsHelp_Commit("GETYPR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("002BH ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte 0 with version-information.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("7 6 5 4 3 2 1 0")
  BiosCallsHelp_L("| | | | +-+-+-+-- Character set")
  BiosCallsHelp_L("| | | |           0 = Japanese, 1 = International, 2=Korean")
  BiosCallsHelp_L("| +-+-+---------- Date format")
  BiosCallsHelp_L("|                 0 = Y-M-D, 1 = M-D-Y, 2 = D-M-Y")
  BiosCallsHelp_L("+---------------- Default interrupt frequency")
  BiosCallsHelp_L("                  0 = 60Hz, 1 = 50Hz")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bits 0-3 contain the character set. Possible values have the follwing meanings:")
  BiosCallsHelp_L("0000 | (&H0) | Japanese")
  BiosCallsHelp_L("0001 | (&H1) | International")
  BiosCallsHelp_L("0010 | (&H2) | Korean")
  BiosCallsHelp_L("&H3 to &HF are reserved")
  BiosCallsHelp_Commit("002BH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("002CH ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte 1 with version-information.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("7 6 5 4 3 2 1 0")
  BiosCallsHelp_L("| | | | +-+-+-+-- Keyboard type")
  BiosCallsHelp_L("| | | |           0 = Japanese, 1 = International")
  BiosCallsHelp_L("| | | |           2 = French (AZERTY), 3 = UK, 4 = German (DIN), ...")
  BiosCallsHelp_L("+-+-+-+---------- Basic version")
  BiosCallsHelp_L("                  0 = Japanese, 1 = International")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bits 0-3 contain the keyboard-type. Possible values have the follwing meanings:")
  BiosCallsHelp_L("0000 | (&H0) | Japanese")
  BiosCallsHelp_L("0001 | (&H1) | International (QUERY/other)")
  BiosCallsHelp_L("0010 | (&H2) | French (AZERTY)")
  BiosCallsHelp_L("0011 | (&H3) | American")
  BiosCallsHelp_L("0100 | (&H4) | German (DIN)")
  BiosCallsHelp_L("0101 | (&H5) | Korean")
  BiosCallsHelp_L("0110 | (&H6) | Danish")
  BiosCallsHelp_L("0111 | (&H7) | Norwegian")
  BiosCallsHelp_L("1000 | (&H8) | Swedish")
  BiosCallsHelp_L("1001 | (&H9) | Spanish / Argentinian")
  BiosCallsHelp_L("1010 | (&HA) | Russian")
  BiosCallsHelp_L("&HB to &HF are reserved")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bits 4-7 are indicating the MSX-Basic version. Please note that")
  BiosCallsHelp_L("a specific version has impact to the behavior of various statements")
  BiosCallsHelp_L("(e.g. USING-clause within the PRINT statement).")
  BiosCallsHelp_Commit("002CH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("002DH ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte 2 with version information. This byte specifies the MSX version:")
  BiosCallsHelp_L("00 | MSX")
  BiosCallsHelp_L("01 | MSX 2")
  BiosCallsHelp_L("02 | MSX 2+")
  BiosCallsHelp_L("03 | MSX Turbo-R")
  BiosCallsHelp_Commit("002DH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("002EH ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte 3 with version-information.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Bit 0: if 1 then MSX-MIDI is present internally (MSX turbo R only)")
  BiosCallsHelp_Commit("002EH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("002FH ?")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Byte 4 with version-information.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Reserved")
  BiosCallsHelp_Commit("002FH", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0030H CALLF  Call routine in any slot")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to call an address in any slot. The Slot ID and address are supplied as inline parameters rather than its registers to fit inside a hook, for example:")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("    RST    30H")
  BiosCallsHelp_L("    DEFB    Slot ID")
  BiosCallsHelp_L("    DEFW    Address")
  BiosCallsHelp_L("    RET")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("The Slot ID is first collected and placed into the high byte of register pair IY. The address is then placed in register pair IX and control drops into the CALSLT standard routine.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF', BC', DE', HL', IX, IY, DI")
  BiosCallsHelp_Commit("CALLF", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0038H KEYINT Interrupt handler, keyboard scan")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to process Z80 interrupts, these are generated by VDP once every 20ms on a UK machine. The VDP status register is first read and bit 7 checked to ensure that this is a frame rate interrupt, if not routine terminates with no action.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI")
  BiosCallsHelp_Commit("KEYINT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("003BH INITIO Initialize I/O devices")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to initialise the PSG and the Centronics status port. PSG register 7 is first set to 80H making PSG port B=Output and PSG port A=Input. PSG register 15 is set to CFH to initialise the joystick connector control hardware. PSG register 14 is then read and the keyboard mode bit placed in KANAMD, this has no relevance for UK machines.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Finally a value of FFH is output to the Centronics status port (I/O port 90H) to set the STROBE signal high. Control then drops into GICINI standard routine to complete initialisation.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, E, EI")
  BiosCallsHelp_Commit("INITIO", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("003EH INIFK  Initialize function key strings")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to initialise the ten function key strings to their power-up values. The one hundred and sixty bytes of data are copied to the FNKSTR buffer in the workspace area.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | BC, DE, HL")
  BiosCallsHelp_Commit("INIFK", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0041H DISSCR Disable screen")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to disable screen. This simply involves resetting bit 6 of VDP mode register 1.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, EI")
  BiosCallsHelp_Commit("DISSCR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0044H ENASCR Enable screen")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to enable screen. This simply involves setting bit 6 of VDP mode register 1.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Entry: | none")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, EI")
  BiosCallsHelp_Commit("ENASCR", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0047H WRTVDP Write to any VDP register")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to write a data byte to any VDP mode register.")
  BiosCallsHelp_L("Entry: | B = data to write")
  BiosCallsHelp_L("C = VDP-register number")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, B, EI")
  BiosCallsHelp_Commit("WRTVDP", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("004AH RDVRM  Read byte from VRAM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to read a single byte from the VDP VRAM.")
  BiosCallsHelp_L("Entry: | HL = address to read")
  BiosCallsHelp_L("Exit: | A = read value")
  BiosCallsHelp_L("Modifies: | AF, EI")
  BiosCallsHelp_Commit("RDVRM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("004DH WRTVRM Write byte to VRAM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to write a single byte to the VDP VRAM.")
  BiosCallsHelp_L("Entry: | HL = address to write")
  BiosCallsHelp_L("A = byte to write")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | EI")
  BiosCallsHelp_Commit("WRTVRM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0050H SETRD  Set up VDP for read")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to set up the VDP for subsequent reads from VRAM")
  BiosCallsHelp_L("via the data port.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("MSX1: addresses greater than 3FFFH will wrap around past zero as")
  BiosCallsHelp_L("the most 2 significant bits of the address are ignored.")
  BiosCallsHelp_L("Entry: | HL = read address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, EI")
  BiosCallsHelp_Commit("SETRD", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0053H SETWRT Set up VDP for write")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to set up the VDP for subsequent writes to VRAM")
  BiosCallsHelp_L("via the data port.")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("MSX1: addresses greater than 3FFFH will wrap around past zero as")
  BiosCallsHelp_L("the most 2 significant bits of the address are ignored.")
  BiosCallsHelp_L("Entry: | HL = write address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, EI")
  BiosCallsHelp_Commit("SETWRT", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0056H FILVRM Fill block of VRAM with data byte")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to fill a block of the VDP VRAM with a single data byte.")
  BiosCallsHelp_L("Entry: | A = data byte")
  BiosCallsHelp_L("BC = length")
  BiosCallsHelp_L("HL = write address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, EI")
  BiosCallsHelp_Commit("FILVRM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0059H LDIRMV Copy block of memory from VRAM")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to copy a block from VRAM into memory.")
  BiosCallsHelp_L("Entry: | BC = length")
  BiosCallsHelp_L("DE = start RAM address")
  BiosCallsHelp_L("HL = start VRAM address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, EI")
  BiosCallsHelp_Commit("LDIRMV", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("005CH LDIRVM Copy block to VRAM from memory")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to copy a block from memory into VRAM.")
  BiosCallsHelp_L("Entry: | BC = length")
  BiosCallsHelp_L("DE = start VRAM address")
  BiosCallsHelp_L("HL = start RAM address")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, HL, EI")
  BiosCallsHelp_Commit("LDIRVM", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("005FH CHGMOD Change VDP mode")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to set a new screen mode.")
  BiosCallsHelp_L("Entry: | A = requested screen-mode")
  BiosCallsHelp_L("Exit: | none")
  BiosCallsHelp_L("Modifies: | AF, BC, DE, HL, EI")
  BiosCallsHelp_Commit("CHGMOD", "MainROM")

  BiosCallsHelp_Begin()
  BiosCallsHelp_L("0062H CHGCLR Change VDP colors")
  BiosCallsHelp_L("")
  BiosCallsHelp_L("Standard routine to set the VDP colors.")
  BiosCallsHelp_L("Entry: | foreground color in FORCLR (F3E9)")
  BiosCallsHelp_L("background color in BAKCLR (F3EA)")
  BiosCallsHelp_L("borderground color in BDRCLR (F3EB)")
