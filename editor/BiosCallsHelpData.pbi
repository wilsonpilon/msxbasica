  BiosCallsHelp_L("F944 CSAVEM  reservation area of ADVGRP")
  BiosCallsHelp_L("F945 CXOFF   X offset from center")
  BiosCallsHelp_L("F947 CYOFF   Y offset from center")
  BiosCallsHelp_L("         .DATA AREA FOR PAINT STATEMENT")
