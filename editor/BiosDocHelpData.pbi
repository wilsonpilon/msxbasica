  BiosDocHelp_L("This table lists all control-sequences, known for MSX-printers. This should give an overview, but must not be fully available on all MSX-printers. Control-sequences are typically preceded by ESC (CHR$(27), 1BH). A " + Chr(34) + "n" + Chr(34) + " within the code represents any ASCII-digit from 0-9.")
  BiosDocHelp_L("")
  BiosDocHelp_L("Symbol | Code | Name")
