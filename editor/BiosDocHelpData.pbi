; Auto-gerado por convert_msxbios.py (descartavel, nao versionado) a partir de
; help/MSXBIOS.CHM (RuMSX, Lex Lechz - lexlechz.at), secao "Documentation & Concepts".
; Conteudo reproduzido como no original.

Structure BiosDocHelpTopic
  Titulo.s
  Grupo.s
  Corpo.s
EndStructure

Global NewList BiosDocHelp_Topics.BiosDocHelpTopic()
Global BiosDocHelp_DataBuilt.b = #False
Global NewList BiosDocHelp_Scratch.s()

Procedure BiosDocHelp_Begin()
  ClearList(BiosDocHelp_Scratch())
EndProcedure

Procedure BiosDocHelp_L(Line.s)
  AddElement(BiosDocHelp_Scratch())
  BiosDocHelp_Scratch() = Line
EndProcedure

Procedure BiosDocHelp_Commit(Titulo.s, Grupo.s)
  Protected Body.s = "", First.b = #True
  ForEach BiosDocHelp_Scratch()
    If Not First : Body + #CRLF$ : EndIf
    Body + BiosDocHelp_Scratch()
    First = #False
  Next
  AddElement(BiosDocHelp_Topics())
  BiosDocHelp_Topics()\Titulo = Titulo
  BiosDocHelp_Topics()\Grupo = Grupo
  BiosDocHelp_Topics()\Corpo = Body
EndProcedure

Procedure BiosDocHelp_BuildData()
  If BiosDocHelp_DataBuilt
    ProcedureReturn
  EndIf
  BiosDocHelp_DataBuilt = #True

  BiosDocHelp_Begin()
  BiosDocHelp_L("Documentation about ESC sequences specific to MSX- and Epson 9-pin printers (to print graphics and control other printer properties):")
