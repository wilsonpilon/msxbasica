# Copia local do toolchain Basic Dignified Suite - referencia de comportamento
# a ser portada nativamente (ver docs/SPEC.md), nao dependencia de runtime.
# Baixavel via Configurar -> Basic Dignified... -> "Baixar Basic Dignified Suite..."
# (nome do diretorio default e "badig", mas o .zip/clone do GitHub tambem pode
# cair como "basic-dignified" dependendo de como foi baixado manualmente -
# a documentacao usada por Ajuda -> Basic Dignified... foi lida de uma copia
# baixada assim, ver editor/BasicDignifiedHelpData.pbi).
/badig/
/basic-dignified/

# Copia local do Nestor80 (Konamiman) - referencia de comportamento (fonte C#
# do N80/LK80, compativel M80/L80) a ser portada nativamente para o assembler
# Z80 (modulo 2, ver docs/SPEC.md), nao dependencia de runtime.
/nestor80/

# Copia local do Graphos IV (Python) - referencia de leitura dos formatos
# nativos do Graphos III (.ALF/.LAY/.SCR/.SHP), incluindo os viewers
# alphabetV.py/layoutV.py/screenV.py/shapeV_2.py e as fontes Pascal originais
# de CyberKnight (readers/*.pas, g3viewer.doc) - especificacao de formato a
# portar nativamente pro modulo 14 (Graphos III), nao dependencia de runtime.
/graphos-IV/

# Cache local de fontes (nao faz parte do projeto) - exceto Source Code Pro,
# que e sincronizada com o GitHub (fonte usada/testada pelo editor).
/fonts/*
!/fonts/Source_Code_Pro.zip

# Copia local do SEE (Sound Effect Editor, Fuzzy Logic 1991/95) - shareware,
# nao dominio publico (uso comercial exige pagamento aos autores, ver
# see/SEE3HELP.TXT) - referencia de leitura do formato .SEE/driver de replay
# (see/SEE3PLAY.ASC) a portar nativamente pro futuro tracker de SFX
# compativel (ver docs/SPEC.md modulo 23, editor/SeeTrackerHelpData.pbi),
# nao dependencia de runtime nem material pra distribuir com o repositorio.
/see/

# Copia local de sc2/ (projeto Go pessoal do usuario, sc2msx, reescrita do
# SuperCalc 2) - a pasta sc2/msx/ carrega software original de terceiros
# (SuperCalc 2 MSX: SC2*.COM/.OVL, PDFs de manuais com copyright, dumps de
# disquete supercalc2*.dsk) - referencia de leitura/engenharia reversa do
# formato .CAL (ver docs/reference/supercalc2-cal-format.md, modulo 17 do
# SPEC.md), nao dependencia de runtime nem material pra distribuir com o
# repositorio.
/sc2/

# Caminho do JOE
/joewin/

#Caminho do MSXBAS2ROM
/msxbas2rom/

# Copia local do asMSX (github.com/Fubukimaru/asMSX) - Z80 cross-assembler pra
# MSX, terceiro assembler suportado (alem do nativo Z80Asm.pbi e do N80/
# Nestor80) - referencia pra extrair Ajuda -> asMSX... (asmsx/doc/asmsx.md),
# nao dependencia de runtime nem material pra distribuir com o repositorio.
# Baixavel via Configurar -> asMSX... -> "Baixar versao mais recente".
/asmsx/

# Caminho local do pbcompiler.exe, gravado por build.ps1 (-Compiler/-C)
/build.config.json

# Caminho local do pbcompiler (Linux), gravado por build.sh (-C/--compiler) -
# arquivo separado do build.config.json do Windows de proposito, pra nao um
# script pisar na config do outro.
/build.config.linux.json

# Pacote de distribuicao gerado por build.ps1 -D/--distribute (artefato de
# build, nao fonte).
/distribute/

# Pacote de distribuicao gerado por build.sh -D/--distribute (Linux).
/distribute-linux/

# Executavel Linux gerado por build.sh (equivalente ao editor/PaleoBasic.exe
# do Windows, sem extensao).
/editor/PaleoBasic

# Preferencias locais persistidas pelo proprio editor (Configurar -> ...),
# especificas de cada maquina/usuario.
/editor/editor_settings.json
/editor/badig_settings.json
/editor/hexeditor_templates.json

# Configuracao do Mamute Assembler (Configurar -> Mamute Assembler...) -
# guarda caminhos de arquivo (BIOS/BASIC/etc.) especificos da maquina do
# usuario, igual as outras acima.
/editor/mamute_settings.json
