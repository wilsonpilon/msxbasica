# Copia local do toolchain Basic Dignified Suite - referencia de comportamento
# a ser portada nativamente (ver docs/SPEC.md), nao dependencia de runtime.
# Baixavel via Configurar -> Basic Dignified... -> "Baixar Basic Dignified Suite..."
/badig/

# Copia local do Nestor80 (Konamiman) - referencia de comportamento (fonte C#
# do N80/LK80, compativel M80/L80) a ser portada nativamente para o assembler
# Z80 (modulo 2, ver docs/SPEC.md), nao dependencia de runtime.
/nestor80/

# Copia local do Graphos IV (Python) - referencia de leitura dos formatos
# nativos do Graphos III (.ALF/.LAY/.SCR/.SHP), incluindo os viewers
# alphabetV.py/layoutV.py/screenV.py/shapeV_2.py e as fontes Pascal originais
# de CyberKnight (readers/*.pas, g3viewer.doc) - especificacao de formato a
# portar nativamente pro modulo 14 (Graphos III), nao dependencia de runtime.
/graphos-IV/

# Cache local de fontes (nao faz parte do projeto) - exceto Source Code Pro,
# que e sincronizada com o GitHub (fonte usada/testada pelo editor).
/fonts/*
!/fonts/Source_Code_Pro.zip

# Caminho do JOE
/joewin/

# Caminho local do pbcompiler.exe, gravado por build.ps1 (-Compiler/-C)
/build.config.json

# Preferencias locais persistidas pelo proprio editor (Configurar -> ...),
# especificas de cada maquina/usuario.
/editor/editor_settings.json
/editor/badig_settings.json
